 555.48, "e": 555.76, "t": "Hm."}, {"s": 555.76, "e": 556.96, "t": "Ik denk dat het beter voor me geweest"}, {"s": 556.96, "e": 558.72, "t": "als ik Havel Ver had gedaan."}, {"s": 558.72, "e": 561.84, "t": "Ik had beter mijn best kunnen doen."}, {"s": 561.84, "e": 563.56, "t": "Waar? Op school?"}, {"s": 563.56, "e": 564.6, "t": "Op werk?"}, {"s": 564.6, "e": 567.48, "t": "Ja, misschien in een baan zoeken."}, {"s": 567.48, "e": 569.76, "t": "Met terugwerkende kracht had ik liever"}, {"s": 569.76, "e": 571.64, "t": "een iets"}, {"s": 571.64, "e": 575.04, "t": "eh een studie kunnen doen die wat meer"}, {"s": 575.04, "e": 577.56, "t": "zoda aan de dijk zet voor mensen."}, {"s": 577.56, "e": 579.96, "t": "Ik ben eh psycholoog en onderzoeker."}, {"s": 579.96, "e": 581.64, "t": "Hm hm. En ik had graag iets bijvoorbeeld"}, {"s": 581.64, "e": 583.64, "t": "als arts eh kunnen doen omdat je dan"}, {"s": 583.64, "e": 585.16, "t": "iets meer kan betekenen voor de mensen"}, {"s": 585.16, "e": 587.36, "t": "dan alleen maar boekjes eh schrijven."}, {"s": 587.36, "e": 588.4, "t": "Hm."}, {"s": 588.4, "e": 589.84, "t": "Maar had u ook als psycholoog kunnen"}, {"s": 589.84, "e": 591.16, "t": "werken?"}, {"s": 591.16, "e": 594.4, "t": "Ik werk als eh psycholoog onderzoeker."}, {"s": 594.4, "e": 596.16, "t": "Ik had als psycholoog kunnen werken,"}, {"s": 596.16, "e": 598.4, "t": "maar niet als"}, {"s": 598.4, "e": 600.36, "t": "mensen psycholoog zou ik zeggen. Dat had"}, {"s": 600.36, "e": 602.04, "t": "ook wel gekund, maar daar heb ik niet"}, {"s": 602.04, "e": 602.76, "t": "voor gekozen."}, {"s": 602.76, "e": 603.72, "t": "Ander pad gekozen."}, {"s": 603.72, "e": 607.4, "t": "Ik heb een ander pad gekozen."}, {"s": 617.68, "e": 620.2, "t": "Ik zou willen kunnen."}, {"s": 620.2, "e": 622.0, "t": "Ik zou willen kunnen vliegen."}, {"s": 622.0, "e": 622.44, "t": "Hm."}, {"s": 622.44, "e": 623.84, "t": "Dat lijkt me wel gaaf."}, {"s": 623.84, "e": 624.8, "t": "Dat zou leuk zijn."}, {"s": 624.8, "e": 625.52, "t": "Ja."}, {"s": 625.52, "e": 626.96, "t": "Waar zou je heen vliegen?"}, {"s": 626.96, "e": 628.52, "t": "Oh, ik denk naar Amerika."}, {"s": 628.52, "e": 631.6, "t": "Ik zou willen kunnen voetballen."}, {"s": 631.6, "e": 633.6, "t": "Ooit geprobeerd?"}, {"s": 633.6, "e": 636.36, "t": "Ja, vaak wel. Ja,"}, {"s": 636.36, "e": 638.56, "t": "ik zou willen kunnen zingen. Dat lijkt"}, {"s": 638.56, "e": 641.6, "t": "me gewoon echt iets heel vets. Ehm ja,"}, {"s": 641.6, "e": 643.6, "t": "ik kan er heel erg van genieten ook als"}, {"s": 643.6, "e": 645.36, "t": "mensen kunnen zingen. Ik zou willen"}, {"s": 645.36, "e": 646.36, "t": "kunnen vliegen."}, {"s": 646.36, "e": 651.08, "t": "Veel meer door Europa reizen en mensen"}, {"s": 651.08, "e": 653.84, "t": "willen andere eh culturen leren leren"}, {"s": 653.84, "e": 654.48, "t": "kennen."}, {"s": 654.48, "e": 656.92, "t": "Ik zou willen kunnen vliegen. Dat wou ik"}, {"s": 656.92, "e": 659.76, "t": "ook zeggen. Nou, dan zou ik zou willen"}, {"s": 659.76, "e": 661.88, "t": "kunnen ik zou onder water willen kunnen"}, {"s": 661.88, "e": 663.72, "t": "ademen. Oeh, is niet een hele moeie zin."}, {"s": 663.72, "e": 664.83, "t": "Oh, goeie."}, {"s": 666.44, "e": 667.84, "t": "Maar het zou wel leuk zijn om dat te"}, {"s": 667.84, "e": 668.2, "t": "kunnen."}, {"s": 668.2, "e": 669.96, "t": "Het zou heel leuk zijn om dat te kunnen."}, {"s": 669.96, "e": 671.88, "t": "Ik zou beter gitaar willen kunnen spelen"}, {"s": 671.88, "e": 674.24, "t": "dan ik nu doe. Hm hm."}, {"s": 674.24, "e": 676.48, "t": "Ehm ik heb wel altijd een beetje blijven"}, {"s": 676.48, "e": 678.68, "t": "spelen, maar als ik echt discipline had"}, {"s": 678.68, "e": 680.24, "t": "gehad, dan had ik er meer mee kunnen"}, {"s": 680.24, "e": 682.76, "t": "doen dan nu het geval is. En het is"}, {"s": 682.76, "e": 684.48, "t": "zonde, want het is een goede hobby om te"}, {"s": 684.48, "e": 685.24, "t": "doen."}, {"s": 685.24, "e": 686.56, "t": "Wat zou ik willen kunnen?"}, {"s": 686.56, "e": 687.92, "t": "Vliegen?"}, {"s": 687.92, "e": 689.56, "t": "Nee, vliegen lijkt me niet per se heel"}, {"s": 689.56, "e": 691.92, "t": "leuk. Eigenlijk wel een beetje eng. Hm."}, {"s": 691.92, "e": 695.2, "t": "Ik zou wel willen kunnen snel willen"}, {"s": 695.2, "e": 696.52, "t": "kunnen breien."}, {"s": 696.52, "e": 697.12, "t": "Hm."}, {"s": 697.12, "e": 698.96, "t": "Ja, dat zou ik wel willen kunnen."}, {"s": 698.96, "e": 700.12, "t": "Ik zou eigenlijk ook wel willen kunnen"}, {"s": 700.12, "e": 701.56, "t": "vliegen"}, {"s": 701.56, "e": 702.84, "t": "en slapen."}, {"s": 702.84, "e": 705.04, "t": "En slapen. Ja. Ja, beter."}, {"s": 705.04, "e": 706.12, "t": "Ooit kan ik"}, {"s": 706.12, "e": 709.04, "t": "Ooit kan ik"}, {"s": 709.04, "e": 712.04, "t": "Ja, ooit kan ik zingen in dit geval. Ik"}, {"s": 712.04, "e": 712.92, "t": "ga het gewoon oefenen."}, {"s": 712.92, "e": 713.44, "t": "Nee. Ja."}, {"s": 713.44, "e": 713.88, "t": "Ja."}, {"s": 713.88, "e": 715.32, "t": "Heb je al concrete plannen?"}, {"s": 715.32, "e": 715.96, "t": "Nee."}, {"s": 715.96, "e": 717.68, "t": "Nee. Maar ooit ooit."}, {"s": 717.68, "e": 718.72, "t": "Ooit. Het is de droom."}, {"s": 718.72, "e": 719.0, "t": "Ja."}, {"s": 719.0, "e": 722.48, "t": "Ja. Ooit kan ik ehm"}, {"s": 722.48, "e": 725.76, "t": "Nederlandse praten ehm"}, {"s": 725.76, "e": 729.44, "t": "tijdens mijn werk en en mijn leven."}, {"s": 729.44, "e": 732.96, "t": "Ooit kan ik in mijn eigen huis wonen."}, {"s": 732.96, "e": 734.12, "t": "Waar woon je nu?"}, {"s": 734.12, "e": 736.08, "t": "Eh ik woon nu in een eh ja, een"}, {"s": 736.08, "e": 737.0, "t": "studentkamer."}, {"s": 737.0, "e": 737.68, "t": "Hm hm."}, {"s": 737.68, "e": 738.84, "t": "Ja."}, {"s": 738.84, "e": 740.68, "t": "En dan een appartement of een huis? Wat"}, {"s": 740.68, "e": 741.48, "t": "zou je willen?"}, {"s": 741.48, "e": 743.32, "t": "Eh het liefst een huis met een tuin."}, {"s": 743.32, "e": 745.16, "t": 