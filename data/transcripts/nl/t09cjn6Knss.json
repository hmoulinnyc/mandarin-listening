[{"s": 0.96, "e": 5.8, "t": "Hoi, ik ben Novelle."}, {"s": 5.8, "e": 10.96, "t": "Novelle is mijn naam."}, {"s": 10.96, "e": 15.8, "t": "Dit is een banaan."}, {"s": 15.8, "e": 20.0, "t": "Dit is een banaan."}, {"s": 20.0, "e": 26.04, "t": "Deze banaan is geel."}, {"s": 26.04, "e": 33.08, "t": "De kleur van deze banaan is geel."}, {"s": 33.08, "e": 41.2, "t": "Kan kan ik deze banaan eten?"}, {"s": 41.4, "e": 47.68, "t": "Kan ik deze banaan eten?"}, {"s": 48.68, "e": 55.56, "t": "Ja, ik kan deze banaan eten."}, {"s": 55.56, "e": 57.72, "t": "Hm."}, {"s": 57.72, "e": 64.76, "t": "Dit dit is een appel."}, {"s": 65.2, "e": 68.4, "t": "Deze appel"}, {"s": 68.4, "e": 74.08, "t": "is rood en groen."}, {"s": 74.08, "e": 80.72, "t": "Deze appel heeft twee kleuren."}, {"s": 80.72, "e": 88.2, "t": "De kleuren van deze appel zijn rood en"}, {"s": 88.2, "e": 91.04, "t": "groen."}, {"s": 91.04, "e": 97.28, "t": "Kan ik deze deze appel eten?"}, {"s": 97.28, "e": 104.76, "t": "Hm. Kan ik deze appel eten?"}, {"s": 106.76, "e": 113.04, "t": "Ja, ik kan deze appel eten."}, {"s": 113.04, "e": 116.68, "t": "Hm, heel lekker."}, {"s": 116.68, "e": 121.88, "t": "Dit is een pen."}, {"s": 123.16, "e": 125.84, "t": "Deze pen"}, {"s": 125.84, "e": 129.32, "t": "is oranje."}, {"s": 129.48, "e": 136.76, "t": "De kleur van deze pen is oranje."}, {"s": 136.76, "e": 143.92, "t": "De kleur van deze pen is oranje."}, {"s": 143.92, "e": 150.0, "t": "Kan ik deze pen eten?"}, {"s": 150.04, "e": 155.84, "t": "Kan ik deze pen eten?"}, {"s": 155.92, "e": 163.04, "t": "Nee, ik kan niet deze pen eten."}, {"s": 163.04, "e": 166.04, "t": "Ik schrijf"}, {"s": 166.04, "e": 172.12, "t": "met deze pen. Ik eet"}, {"s": 172.12, "e": 176.6, "t": "deze pen niet."}, {"s": 176.6, "e": 179.24, "t": "Dit"}, {"s": 179.24, "e": 183.52, "t": "is een boek."}, {"s": 186.2, "e": 189.24, "t": "Dit boek heeft"}, {"s": 189.24, "e": 191.68, "t": "heel veel"}, {"s": 191.68, "e": 193.36, "t": "verschillende"}, {"s": 193.36, "e": 195.88, "t": "kleuren."}, {"s": 195.88, "e": 199.56, "t": "Dit boek is blauw"}, {"s": 199.56, "e": 207.08, "t": "en groen en rood en geel."}, {"s": 207.08, "e": 208.96, "t": "Vier"}, {"s": 208.96, "e": 210.8, "t": "verschillende"}, {"s": 210.8, "e": 213.28, "t": "kleuren."}, {"s": 213.28, "e": 218.88, "t": "De kleuren van dit boek zijn blauw"}, {"s": 218.88, "e": 221.32, "t": "en groen"}, {"s": 221.32, "e": 229.12, "t": "en rood en geel. Het heeft vier kleuren."}, {"s": 229.12, "e": 231.88, "t": "Kan ik"}, {"s": 231.88, "e": 236.52, "t": "dit boek eten?"}, {"s": 236.52, "e": 241.0, "t": "Kan ik dit boek"}, {"s": 241.0, "e": 243.2, "t": "eten?"}, {"s": 243.2, "e": 250.44, "t": "Nee, ik kan niet dit boek eten."}, {"s": 250.44, "e": 254.28, "t": "Ik kan dit boek"}, {"s": 254.28, "e": 257.28, "t": "lezen."}, {"s": 260.92, "e": 264.28, "t": "Een heel interessant"}, {"s": 264.28, "e": 266.84, "t": "en leuk"}, {"s": 266.84, "e": 268.16, "t": "boek."}, {"s": 268.16, "e": 271.76, "t": "Een boek"}, {"s": 271.76, "e": 276.88, "t": "kan ik niet eten."}, {"s": 276.88, "e": 282.6, "t": "Ik kan een boek lezen."}, {"s": 283.76, "e": 287.56, "t": "Oké, tot de volgende"}, {"s": 287.56, "e": 289.96, "t": "video."}, {"s": 289.96, "e": 293.4, "t": "Doei. S"}]