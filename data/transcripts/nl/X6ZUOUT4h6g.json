[{"s": 0.12, "e": 3.56, "t": "Hoi allemaal, ik ben Noella en welkom"}, {"s": 3.56, "e": 8.12, "t": "terug bij de Nederlandse video's. Dit is"}, {"s": 8.12, "e": 12.0, "t": "deel 2 van Pushput Razu."}, {"s": 12.0, "e": 15.96, "t": "Ik heb deel é hierzo"}, {"s": 15.96, "e": 18.48, "t": "of hierzo"}, {"s": 18.48, "e": 21.88, "t": "en we springen er gelijk in. Ik hoor"}, {"s": 21.88, "e": 24.72, "t": "heel graag hoe je het spel vond. Laat"}, {"s": 24.72, "e": 27.04, "t": "het me weten beneden. Laten we verder"}, {"s": 27.04, "e": 31.0, "t": "gaan. Het IJsland."}, {"s": 33.48, "e": 37.28, "t": "Hè, daar zit een touw in."}, {"s": 37.28, "e": 39.56, "t": "Dat kan ons nog van pas komen. Ik zal"}, {"s": 39.56, "e": 41.48, "t": "het wel mogen lenen."}, {"s": 41.48, "e": 45.76, "t": "Ja, proberen. Oké, verder."}, {"s": 45.76, "e": 50.32, "t": "Kleurand is wel heel erg koud."}, {"s": 50.32, "e": 53.2, "t": "Kijk eens naar al die sneeuw hier. Het"}, {"s": 53.2, "e": 55.88, "t": "ziet er wel gevaarlijk uit. We zouden"}, {"s": 55.88, "e": 57.84, "t": "ons beter stilhouden Pep. Anders"}, {"s": 57.84, "e": 61.68, "t": "veroorzaken we een lawine."}, {"s": 64.0, "e": 67.72, "t": "Dat was op een nippertje."}, {"s": 70.28, "e": 73.4, "t": "Oh nee."}, {"s": 73.48, "e": 76.24, "t": "Ah lieve help. We werden bijna"}, {"s": 76.24, "e": 79.24, "t": "meegesleur door die lawine."}, {"s": 79.24, "e": 81.72, "t": "Hoe komen we hier nu door?"}, {"s": 81.72, "e": 83.68, "t": "Jeetje,"}, {"s": 83.68, "e": 85.8, "t": "er was een lawine"}, {"s": 85.8, "e": 89.44, "t": "dat en toen kwam al de sneeuw zo van de"}, {"s": 89.44, "e": 92.16, "t": "berg naar beneden. Dus nu kunnen we niet"}, {"s": 92.16, "e": 94.2, "t": "verder."}, {"s": 94.2, "e": 98.92, "t": "Maar we hebben net een schep gepakt."}, {"s": 98.92, "e": 102.68, "t": "Misschien werkt dit."}, {"s": 109.44, "e": 111.44, "t": "Joepie. Heel goed,"}, {"s": 111.44, "e": 113.64, "t": "nu kan ik blijven rijden."}, {"s": 113.64, "e": 116.64, "t": "Kijk. En nu is er een tunnel waar we"}, {"s": 116.64, "e": 119.52, "t": "doorheen kunnen rijden. Hoe dit niet in"}, {"s": 119.52, "e": 121.96, "t": "elkaar valt,"}, {"s": 121.96, "e": 127.36, "t": "goede vraag, maar fijn. Oké."}, {"s": 127.36, "e": 131.36, "t": "Oh, kijk eens wie dit is."}, {"s": 131.36, "e": 133.88, "t": "Ik heb het koud en ik kan geen krokkel"}, {"s": 133.88, "e": 136.44, "t": "verhoren."}, {"s": 136.44, "e": 138.52, "t": "Iemand heeft het heel koud en is aan het"}, {"s": 138.52, "e": 141.0, "t": "bibberen. Zo,"}, {"s": 141.0, "e": 141.8, "t": "wist het."}, {"s": 141.8, "e": 143.28, "t": "Ben jij kleine Benny?"}, {"s": 143.28, "e": 146.12, "t": "Dat ben ik. En ik heb het zo koud dat ik"}, {"s": 146.12, "e": 149.0, "t": "geen kronkel kan bewegen. Ik heb iets"}, {"s": 149.0, "e": 152.32, "t": "warms nodig. Kan jij mij helpen, klein"}, {"s": 152.32, "e": 155.08, "t": "autootje? Mijn naam is Poetpet en ik zal"}, {"s": 155.08, "e": 160.16, "t": "mijn best doen. Dankjewel Poetpet."}, {"s": 161.64, "e": 165.24, "t": "Benny de slang is koudbloedig dus dat"}, {"s": 165.24, "e": 168.08, "t": "betekent dat hij dezelfde temperatuur"}, {"s": 168.08, "e": 171.88, "t": "als zijn omgeving krijgt. Dus hij is nu"}, {"s": 171.88, "e": 174.96, "t": "op een hele koude plek en hij heeft het"}, {"s": 174.96, "e": 176.88, "t": "heel koud en kan niet bewegen."}, {"s": 176.88, "e": 179.6, "t": "Ik ben stijf bevroren."}, {"s": 179.6, "e": 181.68, "t": "Hij is bevroren."}, {"s": 181.68, "e": 183.76, "t": "Maar volgens mij hebben we hier warme"}, {"s": 183.76, "e": 188.16, "t": "chocolademelk. Misschien is dat lekker."}, {"s": 188.16, "e": 191.28, "t": "Kijk eens hier."}, {"s": 191.28, "e": 194.6, "t": "Warme chocolademelk."}, {"s": 194.6, "e": 198.72, "t": "Poetpreten. Zo. Poetpen. Zo."}, {"s": 198.72, "e": 203.0, "t": "Dankjewel. Poetel"}, {"s": 204.2, "e": 207.8, "t": "me veel beter."}, {"s": 209.28, "e": 211.96, "t": "Ik ga naar huis naar mijn mama."}, {"s": 211.96, "e": 213.48, "t": "Dag."}, {"s": 213.48, "e": 217.04, "t": "Dag kleine Benny."}, {"s": 217.32, "e": 218.96, "t": "Ik moet nog vier diertjes redden voor de"}, {"s": 218.96, "e": 221.4, "t": "dierentuin open kan."}, {"s": 221.4, "e": 224.2, "t": "Het tweede babydier"}, {"s": 224.2, "e": 226.4, "t": "is gevonden"}, {"s": 226.4, "e": 228.44, "t": "en nu heb ik heel erg trek in warme"}, {"s": 228.44, "e": 231.4, "t": "chocolademelk."}, {"s": 233.64, "e": 236.8, "t": "Allemaal pinguïs. Kijk. Oh,"}, {"s": 236.8, "e": 240.16, "t": "kom ik daar?"}, {"s": 241.32, "e": 243.0, "t": "Kijk eens de nelpaard."}, {"s": 243.0, "e": 244.44, "t": "Een voeten bevriezen."}, {"s": 244.44, "e": 247.2, "t": "Pardon? Ben jij Zanziibar?"}, {"s": 247.2, "e": 248.12, "t": "Ja."}, {"s": 248.12, "e": 250.24, "t": "Het ziet er naar uit dat jij vast zit op"}, {"s": 250.24, "e": 251.44, "t": "die ijschot."}, {"s": 251.44, "e": 253.16, "t": "Wel en wat dan nog?"}, {"s": 253.16, "e": 254.88, "t": "Ik zou hier natuurlijk vanaf kunnen"}, {"s": 254.88, "e": 257.88, "t": "helpen. Zou je dat kunnen? Ik bedoel,"}, {"s": 257.88, "e": 259.88, "t": "zou je dat echt kunnen?"}, {"s": 259.88, "e": 262.6, "t": "Natuurlijk. Ik zou alleen een oplossing"}, {"s": 262.6, "e": 265.16, "t": "willen vinden."}, {"s": 265.16, "e": 269.6, "t": "Oké, we moeten deze puzzel oplossen."}, {"s": 269.6, "e": 273.4, "t": "Volgens mij moeten we alle ijsblokken"}, {"s": 273.4, "e": 277.76, "t": "in de juiste volgorde volgorde"}, {"s": 277.76, "e": 280.56, "t": "hier plaatsen."}, {"s": 280.56, "e": 285.24, "t": "Ik denk dat de weg was en haar huis kon."}, {"s": 285.24, "e": 288.16, "t": "Snap ik."}, {"s": 288.6, "e": 291.0, "t": "Ehm de pinguïs gaan ons helpen volgens"}, {"s": 291.0, "e": 291.92, "t": "mij. Kijk,"}, {"s": 291.92, "e": 294.32, "t": "als ik al die ijstukken samenbreng, kan"}, {"s": 294.32, "e": 298.44, "t": "ik misschien een bad maken."}, {"s": 307.32, "e": 310.92, "t": "Een pinguïmin moet zijn adem inhouden"}, {"s": 310.92, "e": 313.64, "t": "en dan duikt hij onder water om de"}, {"s": 313.64, "e": 317.08, "t": "ijsblokken te verplaatsen."}, {"s": 317.08, "e": 319.68, "t": "Oké, we hebben nu een punt. Hier is dan"}, {"s": 319.68, "e": 322.68, "t": "deze."}, {"s": 326.52, "e": 329.52, "t": "Zo."}, {"s": 330.08, "e": 335.72, "t": "En nu is het rond dan deze."}, {"s": 342.36, "e": 345.12, "t": "En nu is het recht. Dus deze als"}, {"s": 345.12, "e": 348.12, "t": "laatste."}, {"s": 352.08, "e": 355.76, "t": "Kom Zanziar. Wees maar niet bang."}, {"s": 355.76, "e": 359.12, "t": "Bang? Huh? Ik ben niet bang. Huh? Ik ben"}, {"s": 359.12, "e": 363.76, "t": "niet bang. Ik maak paps vier."}, {"s": 367.12, "e": 370.36, "t": "Oh. Oh."}, {"s": 372.48, "e": 375.32, "t": "Woe!"}, {"s": 375.32, "e": 377.52, "t": "Da is het mal dank Poetpet. Nu kan ik"}, {"s": 377.52, "e": 379.44, "t": "vast naar Haas naar paps."}, {"s": 379.44, "e": 383.68, "t": "Graag gedaan. Leuke dag nog."}, {"s": 383.68, "e": 385.64, "t": "Ik moet nog drie diertjes redden voor de"}, {"s": 385.64, "e": 388.28, "t": "dierentuin open kan."}, {"s": 388.28, "e": 391.24, "t": "Graag gedaan. Leuke dag nog."}, {"s": 391.24, "e": 394.16, "t": "Kan ik hierheen?"}, {"s": 394.16, "e": 396.88, "t": "Oh oh"}, {"s": 396.88, "e": 400.36, "t": "mensen lief. Waar is onze zo?"}, {"s": 400.36, "e": 403.32, "t": "Dit zijn de ouders van Zoë de zeehond"}, {"s": 403.32, "e": 403.96, "t": "denk ik."}, {"s": 403.96, "e": 406.4, "t": "Zijn jullie de ouders van Zoë zeehond?"}, {"s": 406.4, "e": 409.4, "t": "Dat zijn wij. Ik ben Simon zeehond en"}, {"s": 409.4, "e": 411.36, "t": "dit is mijn man Robbie."}, {"s": 411.36, "e": 414.08, "t": "Oh bij mij stoppelbaard. Heb je mijn"}, {"s": 414.08, "e": 415.48, "t": "klein meiske gevonden?"}, {"s": 415.48, "e": 417.4, "t": "Ja, dat heb ik. Ze zit vast aan de"}, {"s": 417.4, "e": 419.44, "t": "andere kant van de sluis. Maar ik zal er"}, {"s": 419.44, "e": 420.6, "t": "wel iets op vinden."}, {"s": 420.6, "e": 422.96, "t": "Ik hoop dat je vlug wat vindt. We missen"}, {"s": 422.96, "e": 424.4, "t": "onze kleine Zoe."}, {"s": 424.4, "e": 426.16, "t": "Dat doen we zeker. Helemaal tot aan ons"}, {"s": 426.16, "e": 428.44, "t": "vinnen."}, {"s": 428.44, "e": 431.44, "t": "Zoë."}, {"s": 431.64, "e": 435.2, "t": "We moeten op zoek naar de moersleutel."}, {"s": 435.2, "e": 437.84, "t": "Moersleutel."}, {"s": 437.84, "e": 442.8, "t": "Oké. Denk ik dan. Naar de jungle."}, {"s": 444.28, "e": 447.6, "t": "Door de tunnel."}, {"s": 455.32, "e": 458.12, "t": "Oh hallo."}, {"s": 458.12, "e": 460.24, "t": "Oké,"}, {"s": 460.24, "e": 465.4, "t": "laten we proberen er niet in te vallen."}, {"s": 465.6, "e": 469.04, "t": "Dat lijkt veilig."}, {"s": 470.36, "e": 473.8, "t": "Dat was fijn."}, {"s": 473.8, "e": 476.96, "t": "Het was veilig genoeg."}, {"s": 476.96, "e": 478.96, "t": "Oh, kijk,"}, {"s": 478.96, "e": 481.76, "t": "er zit daar een gereedschapskist in."}, {"s": 481.76, "e": 484.96, "t": "Een gereedschapskist?"}, {"s": 485.2, "e": 487.76, "t": "Ik denk niet dat Stoppel het erg zou"}, {"s": 487.76, "e": 490.44, "t": "vinden als ik deze even leen. Je weet"}, {"s": 490.44, "e": 494.76, "t": "maar nooit of ze van pas komen."}, {"s": 494.88, "e": 498.28, "t": "Wat handig. Die hebben we denk ik nodig"}, {"s": 498.28, "e": 501.92, "t": "voor de muurs. Hallo."}, {"s": 501.92, "e": 504.88, "t": "Voor de moersleutel."}, {"s": 504.88, "e": 507.96, "t": "Hm. Links of rechts? Kijk, de aapjes"}, {"s": 507.96, "e": 510.72, "t": "hebben"}, {"s": 510.72, "e": 514.28, "t": "een beret op."}, {"s": 514.48, "e": 514.8, "t": "Oh, kijk."}, {"s": 514.8, "e": 518.16, "t": "Het moet koud en eenzaam geweest zijn in"}, {"s": 518.16, "e": 520.8, "t": "Kleumland."}, {"s": 520.8, "e": 525.72, "t": "Het moet koud en eenzaam geweest zijn."}, {"s": 525.72, "e": 529.16, "t": "Dat denk ik ook."}, {"s": 530.92, "e": 534.36, "t": "Wauw. Hoe kan ik nu op die rivier varen?"}, {"s": 534.36, "e": 536.72, "t": "Ik kan niet zwemmen."}, {"s": 536.72, "e": 538.72, "t": "Woodpunt kan niet zwemmen, dus we moeten"}, {"s": 538.72, "e": 540.64, "t": "kunnen drijven."}, {"s": 540.64, "e": 543.88, "t": "En hier is hout."}, {"s": 543.88, "e": 547.88, "t": "En deze kunnen we toevoegen"}, {"s": 548.64, "e": 550.0, "t": "om een vlot te bouwen."}, {"s": 550.0, "e": 552.52, "t": "Vlot is hersteld. Nu kunnen Peppa en ik"}, {"s": 552.52, "e": 555.16, "t": "veilig de rivier opvaren."}, {"s": 555.16, "e": 557.28, "t": "Het vlot is hersteld. Het is"}, {"s": 557.28, "e": 559.8, "t": "gerepareerd."}, {"s": 559.8, "e": 564.24, "t": "Oh jeetje, dit is leuk."}, {"s": 564.24, "e": 567.84, "t": "Nu gaan we varen."}, {"s": 570.28, "e": 572.36, "t": "Een motor."}, {"s": 572.36, "e": 575.72, "t": "Ah, kijk, ze zijn weer samen."}, {"s": 575.72, "e": 579.6, "t": "Oh, hier is de waterval."}, {"s": 579.72, "e": 583.44, "t": "Misschien eerst hierheen."}, {"s": 586.52, "e": 589.04, "t": "Ah, kijk een luiaard. Nog eens genoeg."}, {"s": 589.04, "e": 592.32, "t": "Ik wil naar de huis."}, {"s": 592.32, "e": 595.12, "t": "Hallo daar beneden."}, {"s": 595.12, "e": 597.6, "t": "Hallo daarboven. Ben jij Kenia? Het"}, {"s": 597.6, "e": 601.2, "t": "leven belpje. Dat ben ik."}, {"s": 601.2, "e": 603.72, "t": "Kan je me helpen? Ik zit hier vast op"}, {"s": 603.72, "e": 604.96, "t": "deze rots."}, {"s": 604.96, "e": 607.08, "t": "Kan je springen?"}, {"s": 607.08, "e": 609.96, "t": "Niet in het water? Ik kan niet zwemmen."}, {"s": 609.96, "e": 610.48, "t": "Oh,"}, {"s": 610.48, "e": 612.2, "t": "dan zullen we een andere manier moeten"}, {"s": 612.2, "e": 613.72, "t": "vinden om je te helpen."}, {"s": 613.72, "e": 617.4, "t": "Tot zal ik liever hebben."}, {"s": 617.4, "e": 620.12, "t": "Oké, dus Kenia kan niet zwemmen, dus die"}, {"s": 620.12, "e": 623.16, "t": "wil niet springen in het water."}, {"s": 623.16, "e": 625.68, "t": "Misschien dat we hierboven"}, {"s": 625.68, "e": 629.24, "t": "een manier kunnen vinden om te helpen."}, {"s": 629.24, "e": 632.64, "t": "Kunnen we hierheen?"}, {"s": 634.8, "e": 637.88, "t": "Panorama. Misschien kunnen we daarheen."}, {"s": 637.88, "e": 641.2, "t": "Volgens mij kunnen we ook hierheen."}, {"s": 641.2, "e": 644.76, "t": "Eerst hier kijken."}, {"s": 646.88, "e": 649.08, "t": "Ah, kijk. We kunnen hier doorheen"}, {"s": 649.08, "e": 652.08, "t": "kijken."}, {"s": 652.68, "e": 656.08, "t": "Hier is het zeehondje."}, {"s": 656.36, "e": 660.04, "t": "Misschien dat dit werkt, want dit is de"}, {"s": 660.04, "e": 663.52, "t": "waterval volgens mij."}, {"s": 663.52, "e": 667.44, "t": "Misschien lukt het hiermee."}, {"s": 669.6, "e": 670.44, "t": "Ja,"}, {"s": 670.44, "e": 673.84, "t": "ik heb het."}, {"s": 675.36, "e": 677.84, "t": "Oh,"}, {"s": 677.84, "e": 678.8, "t": "ze viel bijna."}, {"s": 678.8, "e": 683.84, "t": "Het is gelukt. Zeker weten."}, {"s": 685.28, "e": 688.36, "t": "Bedankt om me te redden. Zeg, wat was je"}, {"s": 688.36, "e": 689.6, "t": "naam ook alweer?"}, {"s": 689.6, "e": 692.36, "t": "Poet Poet. Bedankt Poet Poet. Graag"}, {"s": 692.36, "e": 695.92, "t": "gedaan. Tot ziens, Kenia."}, {"s": 695.92, "e": 697.84, "t": "Er zitten nog twee diertjes te wachten"}, {"s": 697.84, "e": 699.88, "t": "op mijn hulp."}, {"s": 699.88, "e": 703.28, "t": "Oké, we moeten nog twee diertjes vinden."}, {"s": 703.28, "e": 708.92, "t": "Kenia, het leeuwen welpje is geholpen."}, {"s": 708.92, "e": 711.0, "t": "Oké, naar rechts deze keer."}, {"s": 711.0, "e": 715.32, "t": "Wat is het daar? Donker."}, {"s": 718.28, "e": 721.76, "t": "Oh, kijk, hier is de giraf. Ben jij"}, {"s": 721.76, "e": 725.72, "t": "massai? Ja, dat ben ik. Zeg, jouw mam is"}, {"s": 725.72, "e": 728.32, "t": "heel erg bezorgd om jou. Daar heeft ze"}, {"s": 728.32, "e": 731.16, "t": "alle reden toe. Dat verwondert me niet."}, {"s": 731.16, "e": 733.28, "t": "Ik zit hier vast, want de ophaalbrug wil"}, {"s": 733.28, "e": 736.08, "t": "niet meer naar beneden. Er staat een"}, {"s": 736.08, "e": 738.32, "t": "zachtige rots in de weg en hij is veel"}, {"s": 738.32, "e": 741.4, "t": "te zwaar voor mij alleen. Ik geloof mijn"}, {"s": 741.4, "e": 744.56, "t": "ogen niet. Wel, misschien kan ik je"}, {"s": 744.56, "e": 747.4, "t": "helpen. Och, als je dat zou kunnen, dan"}, {"s": 747.4, "e": 749.68, "t": "ben ik het gelukkigste girafje van de"}, {"s": 749.68, "e": 751.16, "t": "wereld."}, {"s": 751.16, "e": 754.8, "t": "Ik mis mijn mammie."}, {"s": 754.8, "e": 758.28, "t": "Kunnen we dit samen wegduwen misschien?"}, {"s": 758.28, "e": 762.0, "t": "Want die zei dat in zijn eentje dus"}, {"s": 762.0, "e": 765.68, "t": "alleen hij het niet om kon duwen. Maar"}, {"s": 765.68, "e": 767.64, "t": "misschien met zijn tweeën, misschien"}, {"s": 767.64, "e": 769.0, "t": "samen kunnen ze dat wel."}, {"s": 769.0, "e": 771.84, "t": "Kan die oude ophoudbrug nu niet dicht?"}, {"s": 771.84, "e": 776.12, "t": "Oké, maar zij maak ik kraag om te duwen."}, {"s": 776.12, "e": 776.2, "t": "Ze"}, {"s": 776.2, "e": 779.84, "t": "gaan samen duwen."}, {"s": 784.96, "e": 787.32, "t": "Ah, gelukt. Oh,"}, {"s": 787.32, "e": 789.96, "t": "dat was nog eens leuk. Nu moet ik alleen"}, {"s": 789.96, "e": 793.28, "t": "nog de opbouwbrug sluiten."}, {"s": 793.28, "e": 796.84, "t": "Oké, dus de rots is weg en nu moet de"}, {"s": 796.84, "e": 800.8, "t": "ophalb brug naar beneden. Dus we moeten"}, {"s": 800.8, "e": 803.36, "t": "aan deze kant komen."}, {"s": 803.36, "e": 806.92, "t": "Daar ga ik naar zoeken."}, {"s": 807.76, "e": 811.16, "t": "Naar het vlot."}, {"s": 812.68, "e": 816.68, "t": "Oké. En terug."}, {"s": 817.16, "e": 820.36, "t": "En nog meer terug."}, {"s": 822.0, "e": 826.2, "t": "Ik ben benieuwd wat hier is."}, {"s": 829.32, "e": 832.52, "t": "Oh, die kant denk ik."}, {"s": 832.52, "e": 835.52, "t": "Wow."}, {"s": 842.32, "e": 845.32, "t": "Jeppie."}, {"s": 850.44, "e": 853.68, "t": "Volgens mij is er nog een andere route."}, {"s": 853.68, "e": 857.0, "t": "Even kijken."}, {"s": 859.24, "e": 861.84, "t": "W"}, {"s": 861.84, "e": 865.04, "t": "naar links."}, {"s": 865.12, "e": 868.12, "t": "W"}, {"s": 870.16, "e": 872.92, "t": "Oh daar daarheen."}, {"s": 872.92, "e": 878.68, "t": "Wow. Wauw. Wow. Wow wow wow."}, {"s": 887.56, "e": 892.12, "t": "Oké, wacht de andere"}, {"s": 892.96, "e": 896.24, "t": "naar links"}, {"s": 897.0, "e": 898.68, "t": "en dan straks moeten we naar rechts denk"}, {"s": 898.68, "e": 900.96, "t": "ik."}, {"s": 900.96, "e": 903.96, "t": "eten."}, {"s": 908.56, "e": 912.48, "t": "Oh, we kunnen hier ook nog naar links."}, {"s": 912.92, "e": 917.12, "t": "Ik weet ik weet niet eens waarom waarom"}, {"s": 917.12, "e": 919.16, "t": "dit het doel is, maar ik ben heel"}, {"s": 919.16, "e": 922.04, "t": "benieuwd, dus ik wil het gewoon"}, {"s": 922.04, "e": 925.04, "t": "proberen."}, {"s": 927.64, "e": 931.04, "t": "Kijk dus links"}, {"s": 932.48, "e": 935.2, "t": "de hele hoge watervalang"}, {"s": 935.2, "e": 941.6, "t": "en dan rechts en dan ook links."}, {"s": 941.6, "e": 947.8, "t": "Links links links links links. Hier. Oh."}, {"s": 948.88, "e": 952.04, "t": "En dan"}, {"s": 954.88, "e": 957.64, "t": "niks."}, {"s": 957.64, "e": 960.4, "t": "Joehoe."}, {"s": 960.4, "e": 963.4, "t": "Oké."}, {"s": 963.88, "e": 967.44, "t": "Eh beetje teleurstellend,"}, {"s": 967.44, "e": 971.8, "t": "maar nu weet ik het in ieder geval."}, {"s": 971.88, "e": 975.36, "t": "En we gaan verder."}, {"s": 977.16, "e": 981.16, "t": "Weer terug naar het land."}, {"s": 985.92, "e": 990.04, "t": "Ik heb je gemist, mama."}, {"s": 992.84, "e": 995.44, "t": "Nu naar rechts"}, {"s": 995.44, "e": 998.92, "t": "over het pad. Kijk,"}, {"s": 998.92, "e": 1002.6, "t": "nu kan deze omlaag."}, {"s": 1005.64, "e": 1008.56, "t": "Het is je gelukt, Poetpoet. Ik ben zo"}, {"s": 1008.56, "e": 1011.4, "t": "opgewonden. 1000maal bedankt om te"}, {"s": 1011.4, "e": 1014.2, "t": "helpen Poetpet. Nu kan ik naar mijn"}, {"s": 1014.2, "e": 1016.2, "t": "mammie."}, {"s": 1016.2, "e": 1018.68, "t": "Voorzichtig zijn als je naar huis gaat."}, {"s": 1018.68, "e": 1022.04, "t": "Dat zal ik zeker doen."}, {"s": 1022.04, "e": 1023.8, "t": "Ik moet nog één diertje redden voor de"}, {"s": 1023.8, "e": 1025.72, "t": "dierentuin open kan."}, {"s": 1025.72, "e": 1028.88, "t": "Oh ja, we moeten nog naar de zeehond."}, {"s": 1028.88, "e": 1032.92, "t": "Oké, we gaan naar de zeehond."}, {"s": 1042.2, "e": 1046.48, "t": "Naar grasland. Weer verder."}, {"s": 1049.08, "e": 1051.12, "t": "Naar links"}, {"s": 1051.12, "e": 1054.8, "t": "langs alle dieren."}, {"s": 1055.56, "e": 1058.12, "t": "Ik heb je gemist, mama. En ik heb jou"}, {"s": 1058.12, "e": 1062.76, "t": "ook gemist, mijn lie."}, {"s": 1062.96, "e": 1067.36, "t": "Moeder en kind zijn weer samen."}, {"s": 1068.56, "e": 1073.36, "t": "Oké, laten we het proberen."}, {"s": 1074.72, "e": 1078.24, "t": "We hebben een driehoek nodig."}, {"s": 1078.24, "e": 1080.4, "t": "Dit is een driehoek."}, {"s": 1080.4, "e": 1083.48, "t": "Dit is een zandloper, denk ik. Een"}, {"s": 1083.48, "e": 1085.6, "t": "zandloper."}, {"s": 1085.6, "e": 1088.36, "t": "Dit is ovaal."}, {"s": 1088.36, "e": 1092.68, "t": "Dit is een vijfhoek. Een vijfhoek."}, {"s": 1092.68, "e": 1095.08, "t": "Een vierkant."}, {"s": 1095.08, "e": 1097.16, "t": "Vierkant."}, {"s": 1097.16, "e": 1098.88, "t": "Een"}, {"s": 1098.88, "e": 1102.04, "t": "Er is een naam voor."}, {"s": 1102.04, "e": 1104.6, "t": "Dat weet ik niet. In wiskunde gebruikten"}, {"s": 1104.6, "e": 1107.72, "t": "we daar altijd een naam voor."}, {"s": 1107.72, "e": 1109.84, "t": "En"}, {"s": 1109.84, "e": 1115.2, "t": "een ster denk ik. ster. Zo,"}, {"s": 1115.2, "e": 1117.36, "t": "maar we hebben sowieso de driehoek nodig"}, {"s": 1117.36, "e": 1122.8, "t": "deze keer. Kijk, driehoek."}, {"s": 1122.8, "e": 1126.08, "t": "Het past."}, {"s": 1128.24, "e": 1132.96, "t": "Hou je klaar. Zo hè, je gaat zwemmen."}, {"s": 1133.48, "e": 1135.16, "t": "Wow."}, {"s": 1135.16, "e": 1137.4, "t": "Ik spet en ik spat en ik word helemaal"}, {"s": 1137.4, "e": 1140.36, "t": "nat. Dit is leuk. Haasje naar huis. Zo"}, {"s": 1140.36, "e": 1144.16, "t": "weze hond. En veel geluk."}, {"s": 1144.16, "e": 1146.56, "t": "Zo, nu kan ze terugzwemmen."}, {"s": 1146.56, "e": 1148.24, "t": "Ik heb alle verdwijne diertjes"}, {"s": 1148.24, "e": 1150.24, "t": "teruggevonden. Ik zou niet beter aan"}, {"s": 1150.24, "e": 1152.4, "t": "Stef Stoppel vertellen."}, {"s": 1152.4, "e": 1154.48, "t": "Hy Stef Stoppel, je hebt alle verdwijnen"}, {"s": 1154.48, "e": 1156.88, "t": "babydiiertjes gered."}, {"s": 1156.88, "e": 1158.4, "t": "Scheterend."}, {"s": 1158.4, "e": 1161.08, "t": "Je hebt een dierentuin gered, Potput. Ik"}, {"s": 1161.08, "e": 1166.04, "t": "kan u niet genoeg bedanken. Volg me."}, {"s": 1166.04, "e": 1167.44, "t": "We hebben de dierentuin gered."}, {"s": 1167.44, "e": 1170.24, "t": "Vrienden, welkom op de opening van de"}, {"s": 1170.24, "e": 1172.8, "t": "dierentuin van autostad. Vandaag heb ik"}, {"s": 1172.8, "e": 1176.16, "t": "een speciaal iemand met mij meegebracht"}, {"s": 1176.16, "e": 1178.16, "t": "en zonder hem hadden we de dierentuin"}, {"s": 1178.16, "e": 1181.28, "t": "nooit kunnen openen."}, {"s": 1181.28, "e": 1184.04, "t": "Deze speciale oppassersbatch"}, {"s": 1184.04, "e": 1186.68, "t": "overhandigen we aan Petput voor zijn"}, {"s": 1186.68, "e": 1189.24, "t": "moed en inzet."}, {"s": 1189.24, "e": 1190.84, "t": "Zijn moet en inzet"}, {"s": 1190.84, "e": 1195.6, "t": "alstublieft voor uw uitstekende hulp."}, {"s": 1195.6, "e": 1198.0, "t": "Dankjewel Stafstoppel. Ik deel me"}, {"s": 1198.0, "e": 1200.48, "t": "plezier."}, {"s": 1200.48, "e": 1202.68, "t": "Wat denkt er vanet? Kunen nu deze"}, {"s": 1202.68, "e": 1205.32, "t": "dierentuin plechtig openen en dit lint"}, {"s": 1205.32, "e": 1206.2, "t": "door knippen?"}, {"s": 1206.2, "e": 1209.84, "t": "Dat wil ik zeker."}, {"s": 1215.96, "e": 1218.12, "t": "Amuseer u in dierentuin Poetpet. Het"}, {"s": 1218.12, "e": 1220.68, "t": "wordt een reuzendag vandaag."}, {"s": 1220.68, "e": 1222.36, "t": "Ja,"}, {"s": 1222.36, "e": 1226.56, "t": "dat is het zekerste stoppel."}, {"s": 1235.6, "e": 1239.0, "t": "Kijk een vlinder"}, {"s": 1239.4, "e": 1242.4, "t": "einde."}, {"s": 1242.4, "e": 1245.04, "t": "Ah, kijk allemaal foto's die ik niet"}, {"s": 1245.04, "e": 1247.36, "t": "gemaakt heb, want ik heb de camera niet"}, {"s": 1247.36, "e": 1250.36, "t": "gebruikt."}, {"s": 1251.4, "e": 1254.92, "t": "Kijk met de muis."}, {"s": 1254.92, "e": 1260.16, "t": "medaille poep laat de medaille zien aan"}, {"s": 1260.16, "e": 1263.16, "t": "meneerini"}, {"s": 1265.36, "e": 1268.64, "t": "denk ik."}, {"s": 1269.44, "e": 1272.08, "t": "Oh, een niet gefocuste foto van de"}, {"s": 1272.08, "e": 1276.72, "t": "zeehonden, want dat gebeurt ook."}, {"s": 1276.72, "e": 1279.44, "t": "Goed moet met Kenia"}, {"s": 1279.44, "e": 1283.8, "t": "en met Bobby en Zoé"}, {"s": 1283.8, "e": 1287.4, "t": "en Champo. Jumbo is een beetje zwaar."}, {"s": 1287.4, "e": 1289.08, "t": "Kijk,"}, {"s": 1289.08, "e": 1292.8, "t": "poet poets heeft moeite"}, {"s": 1292.8, "e": 1295.84, "t": "en poet poet op voor je dingen. Lekker"}, {"s": 1295.84, "e": 1298.84, "t": "zwingen."}, {"s": 1299.44, "e": 1300.96, "t": "Met zoveel leuke dingen."}, {"s": 1300.96, "e": 1302.0, "t": "We dansen spring"}, {"s": 1302.0, "e": 1304.44, "t": "en met alle pings."}, {"s": 1304.44, "e": 1306.16, "t": "Welkom in de"}, {"s": 1306.16, "e": 1309.4, "t": "Dit is een ander spel. Dit is een beer"}, {"s": 1309.4, "e": 1312.4, "t": "van een ander spel"}, {"s": 1312.4, "e": 1314.52, "t": "met Stefel."}, {"s": 1314.52, "e": 1315.4, "t": "Zo zo zo."}, {"s": 1315.4, "e": 1317.36, "t": "Nou met jumbo en"}, {"s": 1317.36, "e": 1319.32, "t": "er staan hier ook veel plakken. Je bent"}, {"s": 1319.32, "e": 1320.6, "t": "hier olifanten."}, {"s": 1320.6, "e": 1323.2, "t": "Deze"}, {"s": 1323.2, "e": 1324.84, "t": "de leeuwen zijn hier klanten."}, {"s": 1324.84, "e": 1327.6, "t": "Die weten wel en grel is hier ook een"}, {"s": 1327.6, "e": 1328.32, "t": "vak."}, {"s": 1328.32, "e": 1331.16, "t": "Welkom in reinig nu je voor en dan kan"}, {"s": 1331.16, "e": 1334.04, "t": "je zeker dat je niet meer wil spelen nog"}, {"s": 1334.04, "e": 1337.04, "t": "meer"}, {"s": 1337.4, "e": 1340.44, "t": "nou lieve allemaal dat was het voor"}, {"s": 1340.44, "e": 1343.16, "t": "Putet Putrez."}, {"s": 1343.16, "e": 1345.76, "t": "Ik hoop dat je het leuk vond en wat hebt"}, {"s": 1345.76, "e": 1347.28, "t": "geleerd."}, {"s": 1347.28, "e": 1350.0, "t": "En ik vond het ook weer heel leuk om te"}, {"s": 1350.0, "e": 1353.2, "t": "spelen. Dit spel heb ik best wel veel"}, {"s": 1353.2, "e": 1356.08, "t": "gespeeld vroeger, dus ik weet best wel"}, {"s": 1356.08, "e": 1359.56, "t": "goed wat ik moet doen, maar van sommige"}, {"s": 1359.56, "e": 1362.92, "t": "andere spellen weet ik het niet zo goed."}, {"s": 1362.92, "e": 1365.48, "t": "Dus dit was snel,"}, {"s": 1365.48, "e": 1368.8, "t": "maar misschien de volgende keren niet."}, {"s": 1368.8, "e": 1371.36, "t": "Laten we het gaan zien."}, {"s": 1371.36, "e": 1374.12, "t": "Heb je een ander specifiek spel dat je"}, {"s": 1374.12, "e": 1376.8, "t": "leuk vindt om te zien? Specifiek van"}, {"s": 1376.8, "e": 1380.16, "t": "Amongus Games of een andere die in het"}, {"s": 1380.16, "e": 1383.16, "t": "Nederlands is? Laat het me alsjeblieft"}, {"s": 1383.16, "e": 1386.92, "t": "weten. En dan tot de volgende keer. Hele"}, {"s": 1386.92, "e": 1391.84, "t": "fijne dag. Doeg. Doeg."}]