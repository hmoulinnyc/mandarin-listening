[{"s": 0.2, "e": 5.08, "t": "Hoi allemaal. Hoi. Hoi. Ik ben Noelle"}, {"s": 5.08, "e": 8.76, "t": "en welkom terug op het kanaal. Ik wil"}, {"s": 8.76, "e": 10.88, "t": "vandaag vertellen"}, {"s": 10.88, "e": 12.84, "t": "over"}, {"s": 12.84, "e": 14.48, "t": "natuur."}, {"s": 14.48, "e": 18.72, "t": "Ik hou heel erg van natuur."}, {"s": 18.72, "e": 22.44, "t": "Het brengt mij heel veel rust en maakt"}, {"s": 22.44, "e": 25.84, "t": "mij ontspannen."}, {"s": 26.16, "e": 32.08, "t": "En specifiek de kleur de kleur groen"}, {"s": 32.08, "e": 35.68, "t": "geeft mij heel veel rust"}, {"s": 35.68, "e": 37.92, "t": "volgens mij."}, {"s": 37.92, "e": 43.92, "t": "Is dat iets van mensen in het algemeen?"}, {"s": 43.92, "e": 47.76, "t": "Iedereen of bijna elke mens"}, {"s": 47.76, "e": 51.88, "t": "heeft dat denk ik dat ze rustig worden"}, {"s": 51.88, "e": 55.36, "t": "van de kleur groen."}, {"s": 55.36, "e": 59.84, "t": "Maar ik merk het heel erg"}, {"s": 59.84, "e": 63.6, "t": "en ik wilde laten zien"}, {"s": 63.6, "e": 68.76, "t": "wat er om mij heen is."}, {"s": 68.76, "e": 70.88, "t": "Bijvoorbeeld"}, {"s": 70.88, "e": 73.48, "t": "zijn hier bomen."}, {"s": 73.48, "e": 76.6, "t": "Bomen met een boom Oeh oeh oeh oeh"}, {"s": 76.6, "e": 78.28, "t": "boomstronk."}, {"s": 78.28, "e": 80.72, "t": "Oh, dit is moeilijk."}, {"s": 80.72, "e": 83.48, "t": "Met een boomstronk. Kijk hier nog één."}, {"s": 83.48, "e": 87.76, "t": "Een boomstronk. Zo."}, {"s": 87.92, "e": 92.2, "t": "En takken. Kijk. Zo. Takken."}, {"s": 92.2, "e": 94.28, "t": "Takken."}, {"s": 94.28, "e": 97.92, "t": "Van de boomstronk gaan takken. Netj"}, {"s": 97.92, "e": 100.36, "t": "vingers."}, {"s": 100.8, "e": 103.28, "t": "En aan de takken"}, {"s": 103.28, "e": 107.52, "t": "zitten bladeren of blaadjes."}, {"s": 107.52, "e": 109.92, "t": "Allemaal blaadjes"}, {"s": 109.92, "e": 113.28, "t": "zoals dit."}, {"s": 114.0, "e": 116.4, "t": "Deze blaadjes."}, {"s": 116.4, "e": 120.52, "t": "Dit zijn droge blaadjes. Die zijn van de"}, {"s": 120.52, "e": 123.76, "t": "boom gevallen"}, {"s": 123.76, "e": 127.24, "t": "omdat ze droog zijn."}, {"s": 127.24, "e": 132.44, "t": "Dus de boom die laat ze dan vallen."}, {"s": 132.6, "e": 137.2, "t": "En er zijn hier heel veel verschillende"}, {"s": 137.2, "e": 140.4, "t": "verschillende bomen."}, {"s": 140.4, "e": 142.36, "t": "Bijvoorbeeld"}, {"s": 142.36, "e": 144.4, "t": "hier"}, {"s": 144.4, "e": 147.6, "t": "zijn deze bomen."}, {"s": 147.6, "e": 152.4, "t": "Dit zijn hele hoge bomen,"}, {"s": 152.48, "e": 157.2, "t": "maar ook zijn er"}, {"s": 158.0, "e": 161.6, "t": "even laten zien."}, {"s": 162.08, "e": 166.84, "t": "Ook zijn er deze bomen."}, {"s": 166.84, "e": 170.68, "t": "Kom, ik laat het je zien."}, {"s": 171.88, "e": 176.36, "t": "Er zijn zulke mooie bomen hier"}, {"s": 176.36, "e": 178.44, "t": "met bloemen."}, {"s": 178.44, "e": 182.2, "t": "Want de bloemen die bloeien hier in"}, {"s": 182.2, "e": 184.0, "t": "Thailand."}, {"s": 184.0, "e": 187.68, "t": "Vooral in het droogseizoen wanneer er"}, {"s": 187.68, "e": 191.84, "t": "niet veel regen is en het ietsjes"}, {"s": 191.84, "e": 197.92, "t": "kouder is. Kijk hoe de zon schijnt."}, {"s": 197.92, "e": 200.32, "t": "Ik laat het hier zien."}, {"s": 200.32, "e": 203.32, "t": "Kijk,"}, {"s": 204.52, "e": 206.56, "t": "zo mooi."}, {"s": 206.56, "e": 210.76, "t": "En dit is een kleinere kleinere"}, {"s": 210.76, "e": 214.48, "t": "boom met bloemen."}, {"s": 214.48, "e": 216.76, "t": "Allemaal bloemen."}, {"s": 216.76, "e": 219.04, "t": "Oranje bloemen."}, {"s": 219.04, "e": 220.68, "t": "Kijk,"}, {"s": 220.68, "e": 225.12, "t": "zo ziet deze bloem eruit."}, {"s": 225.36, "e": 227.4, "t": "Zo mooi"}, {"s": 227.4, "e": 229.72, "t": "oranje bloemen"}, {"s": 229.72, "e": 232.6, "t": "en ze zijn heel zacht."}, {"s": 232.6, "e": 236.04, "t": "Kun je dat zien?"}, {"s": 237.2, "e": 240.04, "t": "Heel zacht."}, {"s": 240.04, "e": 243.32, "t": "Deze vind ik heel mooi."}, {"s": 243.32, "e": 248.44, "t": "Oranje bloemen. En ook bijvoorbeeld"}, {"s": 248.44, "e": 251.04, "t": "zijn er planten"}, {"s": 251.04, "e": 255.12, "t": "die aan de bomen groeien."}, {"s": 255.12, "e": 258.4, "t": "Dus op de boomstronk,"}, {"s": 258.4, "e": 260.92, "t": "hierzo is de boomstronk,"}, {"s": 260.92, "e": 264.96, "t": "groeien allemaal planten"}, {"s": 264.96, "e": 268.92, "t": "met verschillende blaadjes."}, {"s": 269.6, "e": 272.56, "t": "Maar hier is een ander soort boom nog"}, {"s": 272.56, "e": 276.12, "t": "met hele kleine plaatjes."}, {"s": 276.12, "e": 279.12, "t": "Kijk,"}, {"s": 282.68, "e": 285.24, "t": "kijk, dit is ook een boom."}, {"s": 285.24, "e": 289.32, "t": "met kleine plaatjes."}, {"s": 290.0, "e": 292.48, "t": "Er is hier iemand een dutje aan het"}, {"s": 292.48, "e": 297.68, "t": "doen, [gelach] dus ik loop even weg."}, {"s": 299.68, "e": 303.0, "t": "Misschien kun je het horen,"}, {"s": 303.0, "e": 308.92, "t": "maar er is een concert daar verder"}, {"s": 308.92, "e": 314.44, "t": "verder gaande aan de gang."}, {"s": 314.44, "e": 320.12, "t": "Dus misschien kan je de muziek horen."}, {"s": 320.12, "e": 324.24, "t": "En hier op de grond op de grond zijn ook"}, {"s": 324.24, "e": 326.72, "t": "allemaal planten"}, {"s": 326.72, "e": 330.32, "t": "zoals deze plant. Als je deze plant"}, {"s": 330.32, "e": 332.0, "t": "aanraakt"}, {"s": 332.0, "e": 334.32, "t": "aanraakt"}, {"s": 334.32, "e": 337.33, "t": "dan schrikt het. Dan doet het zo."}, {"s": 338.16, "e": 341.16, "t": "Kijk."}, {"s": 342.88, "e": 344.56, "t": "Kun je het zien? Even kijken. Waar is"}, {"s": 344.56, "e": 347.56, "t": "die?"}, {"s": 348.44, "e": 351.79, "t": "Hier. Zo. Kijk. [gelach]"}, {"s": 352.8, "e": 355.8, "t": "Zag je dat? Ik hoop dat je het kan zien."}, {"s": 355.8, "e": 357.68, "t": "Even kijken. Is er nog één? Hier. Zo."}, {"s": 357.68, "e": 359.72, "t": "Kijk."}, {"s": 359.72, "e": 363.44, "t": "Ik raak het aan."}, {"s": 363.64, "e": 366.64, "t": "Kijk."}, {"s": 371.16, "e": 374.96, "t": "Dat is om te beschermen."}, {"s": 374.96, "e": 378.44, "t": "Dus dat is een schrik reactie van de"}, {"s": 378.44, "e": 379.84, "t": "plant."}, {"s": 379.84, "e": 383.96, "t": "Dus ik zal het niet teveel doen."}, {"s": 383.96, "e": 387.72, "t": "En er zijn hier nog meer planten. Kijk,"}, {"s": 387.72, "e": 390.32, "t": "groene blaadjes"}, {"s": 390.32, "e": 393.8, "t": "en paarse blaadjes."}, {"s": 393.8, "e": 397.88, "t": "Een beetje roze paars."}, {"s": 399.32, "e": 401.52, "t": "En er is hier niet echt gras."}, {"s": 402.64, "e": 405.72, "t": "Misschien is het wel gras,"}, {"s": 405.72, "e": 409.28, "t": "maar een ander type gras."}, {"s": 409.28, "e": 412.32, "t": "dat er zo uitziet."}, {"s": 412.32, "e": 414.44, "t": "Kijk,"}, {"s": 414.44, "e": 418.24, "t": "heel dik. Niet dun gras zoals in"}, {"s": 418.24, "e": 419.92, "t": "Nederland,"}, {"s": 419.92, "e": 423.88, "t": "maar heel dik gras."}, {"s": 426.12, "e": 428.08, "t": "En hier"}, {"s": 428.08, "e": 431.44, "t": "is ook water,"}, {"s": 431.44, "e": 435.24, "t": "want het is een vijver."}, {"s": 436.6, "e": 439.44, "t": "En om mij heen"}, {"s": 439.44, "e": 442.76, "t": "zijn allemaal vogels."}, {"s": 442.76, "e": 446.88, "t": "Je kunt ze nu horen."}, {"s": 451.24, "e": 454.68, "t": "Allemaal vogels."}, {"s": 455.36, "e": 459.04, "t": "Kijk. En hier achter mij achter mij is"}, {"s": 459.04, "e": 462.12, "t": "een eiland."}, {"s": 462.12, "e": 464.6, "t": "Een"}, {"s": 464.6, "e": 468.76, "t": "eiland. Dat is niet vast"}, {"s": 468.76, "e": 472.28, "t": "aan waar ik nu staan."}, {"s": 472.28, "e": 476.36, "t": "Kijk, ik sta nu hier, maar er is geen"}, {"s": 476.36, "e": 478.12, "t": "looppad"}, {"s": 478.12, "e": 480.96, "t": "naar dit eiland."}, {"s": 480.96, "e": 485.52, "t": "Dat is los met allemaal planten. Heel"}, {"s": 485.52, "e": 487.56, "t": "veel planten"}, {"s": 487.56, "e": 490.76, "t": "en ook heel veel vogels. Dat kan ik"}, {"s": 490.76, "e": 493.76, "t": "horen."}, {"s": 495.76, "e": 497.92, "t": "Dus hier ben ik vandaag aan het"}, {"s": 497.92, "e": 500.92, "t": "ontspannen."}, {"s": 500.92, "e": 505.0, "t": "En wat ook heel fijn is, is dat hier"}, {"s": 505.0, "e": 507.68, "t": "bankjes zijn."}, {"s": 507.68, "e": 513.04, "t": "bankjes. Oh, dat is mijn zonnebril"}, {"s": 514.04, "e": 517.52, "t": "om op te zitten."}, {"s": 517.56, "e": 521.68, "t": "Ik hoop dat je het een beetje kan horen."}, {"s": 521.68, "e": 525.96, "t": "Ik heb mijn microfoon niet mee,"}, {"s": 525.96, "e": 530.8, "t": "maar ik wilde het toch laten zien."}, {"s": 532.48, "e": 535.8, "t": "Een hele fijne dag en tot de volgende"}, {"s": 535.8, "e": 540.52, "t": "keer. Doeg. Doeg."}]