[{"s": 0.0, "e": 2.76, "t": "Kennismaking"}, {"s": 2.76, "e": 4.76, "t": "Hallo, hoe gaat het?"}, {"s": 4.76, "e": 7.31, "t": "Met mij gaat het goed, dank je."}, {"s": 7.31, "e": 8.66, "t": "Wat doe je nu?"}, {"s": 8.66, "e": 10.94, "t": "Ik spreek Nederlands met jou."}, {"s": 10.94, "e": 12.79, "t": "Waar kom je vandaan?"}, {"s": 12.79, "e": 14.79, "t": "Ik kom uit Italië."}, {"s": 14.79, "e": 15.95, "t": "Ben je gelukkig?"}, {"s": 15.95, "e": 17.81, "t": "Ja, ik ben gelukkig."}, {"s": 17.81, "e": 19.3, "t": "Waar woon je nu?"}, {"s": 19.3, "e": 21.43, "t": "Ik woon nu in Nederland."}, {"s": 21.43, "e": 23.75, "t": "Hoe lang woon je daar al?"}, {"s": 23.75, "e": 26.73, "t": "Ik woon al 2 jaar in Nederland."}, {"s": 26.73, "e": 28.54, "t": "Leer je Nederlands?"}, {"s": 28.54, "e": 30.77, "t": "Ja, ik leer Nederlands."}, {"s": 30.77, "e": 33.32, "t": "Spreek je ook andere talen?"}, {"s": 33.32, "e": 36.2, "t": "Ja, ik spreek Italiaans en Engels."}, {"s": 36.2, "e": 38.24, "t": "Hoe lang leer je al Nederlands?"}, {"s": 38.24, "e": 41.35, "t": "Ik leer al 2 jaar Nederlands."}, {"s": 41.35, "e": 43.67, "t": "Spreek je al Nederlands?"}, {"s": 43.67, "e": 46.51, "t": "Een beetje, maar het is nog moeilijk."}, {"s": 46.51, "e": 47.58, "t": "Hoe oud ben je?"}, {"s": 47.58, "e": 50.18, "t": "Ik ben 27 jaar."}, {"s": 50.18, "e": 52.27, "t": "Heb je gestudeerd?"}, {"s": 52.27, "e": 54.49, "t": "Ja, ik heb lang gestudeerd."}, {"s": 54.49, "e": 56.17, "t": "Wat doe je voor werk?"}, {"s": 56.17, "e": 57.98, "t": "Ik werk als leidster."}, {"s": 57.98, "e": 59.7, "t": "Verdien je veel geld?"}, {"s": 59.7, "e": 62.11, "t": "Ja, ik verdien genoeg geld."}, {"s": 62.11, "e": 63.88, "t": "Vind je Nederlands leuk?"}, {"s": 63.88, "e": 66.66, "t": "Ja, maar de grammatica is moeilijk."}, {"s": 66.66, "e": 68.19, "t": "In welke stad woon je?"}, {"s": 68.19, "e": 70.1, "t": "Ik woon in Amsterdam."}, {"s": 70.1, "e": 72.42, "t": "Vind je Amsterdam leuk?"}, {"s": 72.42, "e": 75.21, "t": "Ja, de stad bevalt me erg."}, {"s": 75.21, "e": 78.18, "t": "Woont je familie in Italië?"}, {"s": 78.18, "e": 82.13, "t": "Ja, mijn familie woont in Italië."}, {"s": 82.13, "e": 84.96, "t": "In welke stad woont je familie?"}, {"s": 84.96, "e": 87.09, "t": "Mijn familie woont in Rome."}, {"s": 87.09, "e": 89.09, "t": "Bezoek je je familie vaak?"}, {"s": 89.09, "e": 91.79, "t": "Ja, ik bezoek hen drie keer per jaar."}, {"s": 91.79, "e": 93.69, "t": "Heb je broers of zussen?"}, {"s": 93.69, "e": 95.96, "t": "Ja, ik heb een zus."}, {"s": 95.97, "e": 97.73, "t": "Mag je je zus?"}, {"s": 97.73, "e": 99.5, "t": "Nee, mijn zus is raar."}, {"s": 99.5, "e": 101.86, "t": "Hoe oud is je moeder?"}, {"s": 101.86, "e": 104.47, "t": "Mijn moeder is 55 jaar."}, {"s": 104.47, "e": 106.88, "t": "Hoe heet je vader?"}, {"s": 106.88, "e": 108.97, "t": "Mijn vader heet Mark."}, {"s": 108.97, "e": 111.43, "t": "Wat doet je moeder?"}, {"s": 111.43, "e": 113.85, "t": "Mijn moeder is verpleegster."}, {"s": 113.85, "e": 116.08, "t": "Heb je hier vrienden?"}, {"s": 116.08, "e": 118.54, "t": "Ja, ik heb veel vrienden."}, {"s": 118.54, "e": 121.0, "t": "Zijn je vrienden uit Nederland?"}, {"s": 121.0, "e": 124.9, "t": "Sommige wel, anderen komen uit het buitenland."}, {"s": 124.9, "e": 126.76, "t": "Zie je je vrienden vaak?"}, {"s": 126.76, "e": 129.17, "t": "Ja, meestal in het weekend."}, {"s": 129.17, "e": 130.94, "t": "Wat doe je 's ochtends?"}, {"s": 130.94, "e": 135.72, "t": "Ik sta op, poets mijn tanden en douche."}, {"s": 135.72, "e": 137.3, "t": "Wat eet je bij het ontbijt?"}, {"s": 137.3, "e": 139.25, "t": "Ik eet brood en fruit."}, {"s": 139.25, "e": 140.83, "t": "Drink je koffie?"}, {"s": 140.83, "e": 143.85, "t": "Ja, ik drink elke ochtend koffie."}, {"s": 143.85, "e": 145.52, "t": "Hoe ga je naar de taalschool?"}, {"s": 145.52, "e": 147.33, "t": "Ik ga met de fiets."}, {"s": 147.33, "e": 148.63, "t": "Wat doe je na de les?"}, {"s": 148.63, "e": 151.37, "t": "Ik leer Nederlands of rust uit."}, {"s": 151.37, "e": 154.25, "t": "Leer je elke dag Nederlands?"}, {"s": 154.25, "e": 157.87, "t": "Ja, ik leer bijna elke dag Nederlands."}, {"s": 157.87, "e": 160.56, "t": "Is Nederlands moeilijk voor jou?"}, {"s": 160.56, "e": 164.37, "t": "Ja, vooral de grammaticirca"}, {"s": 164.37, "e": 167.02, "t": "Voel je je hier thuis?"}, {"s": 167.02, "e": 169.11, "t": "Ja, ik ben hier blij."}, {"s": 169.11, "e": 171.62, "t": "Mis je Italië soms?"}, {"s": 171.62, "e": 174.82, "t": "Ja, vooral mijn familie en het eten."}, {"s": 174.82, "e": 177.75, "t": "Vind je het eten hier lekker?"}, {"s": 177.75, "e": 180.76, "t": "Nee, ik vind het eten hier niet lekker."}, {"s": 180.76, "e": 182.58, "t": "Heb je een huisdier?"}, {"s": 182.58, "e": 185.64, "t": "Nee, ik heb helaas geen huisdier."}, {"s": 185.64, "e": 187.64, "t": "Hou je van dieren?"}, {"s": 187.64, "e": 189.63, "t": "Ja, ik hou veel van dieren."}, {"s": 189.63, "e": 191.72, "t": "Ga je vroeg slapen?"}, {"s": 191.72, "e": 194.23, "t": "Ja, ik val vroeg in slaap."}, {"s": 194.23, "e": 196.04, "t": "Hoe is het weer vandaag?"}, {"s": 196.04, "e": 199.02, "t": "Het weer is koel, maar zonnig."}, {"s": 199.02, "e": 201.25, "t": "Hou je van koud weer?"}, {"s": 201.25, "e": 204.36, "t": "Niet zo, ik hou van warm weer."}, {"s": 204.36, "e": 205.84, "t": "Hou je van sneeuw?"}, {"s": 205.84, "e": 207.88, "t": "Ja, sneeuw vind ik mooi."}, {"s": 207.88, "e": 209.7, "t": "Wat is je favoriete seizoen?"}, {"s": 209.7, "e": 211.69, "t": "Ik hou van de zomer."}, {"s": 211.69, "e": 213.46, "t": "Wat doe je na een lange dag?"}, {"s": 213.46, "e": 214.99, "t": "Ik ontspan thuis."}, {"s": 214.99, "e": 217.18, "t": "Hoe ontspan je?"}, {"s": 217.18, "e": 219.87, "t": "Ik luister muziek of lees."}, {"s": 219.87, "e": 221.91, "t": "Lees je in het Nederlands?"}, {"s": 221.91, "e": 225.44, "t": "Soms, maar meestal in het Italiaans."}, {"s": 225.44, "e": 227.39, "t": "Kook je graag?"}, {"s": 227.39, "e": 229.99, "t": "Ja, ik kook graag."}, {"s": 229.99, "e": 232.08, "t": "Wat is je lievelingseten?"}, {"s": 232.08, "e": 233.94, "t": "Ik eet graag pasta."}, {"s": 233.94, "e": 236.4, "t": "Kook je Italiaans eten?"}, {"s": 236.4, "e": 238.31, "t": "Ja, ik kook heel vaak."}, {"s": 238.31, "e": 240.12, "t": "Kook je elke dag?"}, {"s": 240.12, "e": 242.21, "t": "Nee, ik kook niet elke dag."}, {"s": 242.21, "e": 244.53, "t": "Eet je soms buiten?"}, {"s": 244.53, "e": 246.8, "t": "Ja, soms met vrienden."}, {"s": 246.8, "e": 249.54, "t": "Ga je graag naar een café?"}, {"s": 249.54, "e": 251.22, "t": "Ja, heel graag."}, {"s": 251.22, "e": 254.37, "t": "Drink je liever koffie of thee?"}, {"s": 254.37, "e": 255.72, "t": "Liever koffie."}, {"s": 255.72, "e": 257.44, "t": "Hoe vind je het eten hier?"}, {"s": 257.44, "e": 260.04, "t": "Het is anders, maar goed."}, {"s": 260.04, "e": 262.5, "t": "Is er iets dat je niet lekker vindt?"}, {"s": 262.5, "e": 265.52, "t": "Heel vet eten vind ik niet lekker."}, {"s": 265.52, "e": 268.31, "t": "Mis je Italiaans eten?"}, {"s": 268.31, "e": 271.37, "t": "Ja, vooral verse gerechten."}, {"s": 271.37, "e": 274.02, "t": "Koop je hier Italiaanse producten?"}, {"s": 274.02, "e": 279.4, "t": "Ja, soms in de supermarkt."}, {"s": 279.43, "e": 282.43, "t": "Lievelingsdingen"}, {"s": 282.43, "e": 284.24, "t": "Hoe voel je je nu?"}, {"s": 284.24, "e": 286.0, "t": "Ik voel me goed."}, {"s": 286.0, "e": 288.42, "t": "Heb je vanavond plannen?"}, {"s": 288.42, "e": 291.16, "t": "Ja, ik ga met een vriendin uit."}, {"s": 291.16, "e": 293.76, "t": "Waar ontmoeten jullie elkaar?"}, {"s": 293.76, "e": 296.96, "t": "We spreken af in een café vlakbij."}, {"s": 296.96, "e": 300.4, "t": "Hoe ziet jouw ochtend meestal eruit?"}, {"s": 300.4, "e": 303.6, "t": "Ik sta meestal om half zeven op."}, {"s": 303.6, "e": 305.97, "t": "Ben je actief in de ochtend of avond?"}, {"s": 305.97, "e": 308.85, "t": "Ik ben graag 's avonds actief."}, {"s": 308.85, "e": 311.68, "t": "Drink je 's morgens iets warms?"}, {"s": 311.68, "e": 314.29, "t": "Ja, ik drink altijd koffie."}, {"s": 314.29, "e": 317.95, "t": "Luister je 's morgens graag muziek?"}, {"s": 317.95, "e": 320.74, "t": "Ja, muziek helpt me wakker worden."}, {"s": 320.74, "e": 323.43, "t": "Loop je liever of neem je de bus?"}, {"s": 323.43, "e": 326.45, "t": "Ik loop liever als ik tijd heb."}, {"s": 326.45, "e": 328.96, "t": "Woon je graag in een grote stad?"}, {"s": 328.96, "e": 331.51, "t": "Ja, maar soms is het te druk."}, {"s": 331.51, "e": 334.21, "t": "Heb je soms rust nodig?"}, {"s": 334.21, "e": 336.76, "t": "Ja, ik heb vaak rust nodig."}, {"s": 336.76, "e": 338.9, "t": "Waar kun je goed ontspannen?"}, {"s": 338.9, "e": 341.31, "t": "Ik ontspan graag in mijn tuin."}, {"s": 341.31, "e": 344.1, "t": "Ben je vaak in je tuin?"}, {"s": 344.1, "e": 347.21, "t": "Ja, altijd als ik tijd heb."}, {"s": 347.21, "e": 348.6, "t": "Loop je graag alleen?"}, {"s": 348.6, "e": 351.34, "t": "Soms alleen, soms met vrienden."}, {"s": 351.34, "e": 354.36, "t": "Praat je graag of luister je liever?"}, {"s": 354.36, "e": 356.45, "t": "Ik luister liever."}, {"s": 356.45, "e": 359.89, "t": "Wat is je lievelingsplek in de stad?"}, {"s": 359.89, "e": 362.35, "t": "Een rustig café om de hoek."}, {"s": 362.35, "e": 364.95, "t": "Drink je daar iets speciaals?"}, {"s": 364.95, "e": 367.41, "t": "Ja, ik drink graag bier."}, {"s": 367.41, "e": 369.18, "t": "Lees je graag boeken?"}, {"s": 369.18, "e": 371.64, "t": "Ja, ik lees graag romans."}, {"s": 371.64, "e": 374.43, "t": "Ben je liever alleen of met anderen?"}, {"s": 374.43, "e": 376.38, "t": "Ik ben liever alleen."}, {"s": 376.38, "e": 379.35, "t": "Kook je in je vrije tijd?"}, {"s": 379.35, "e": 381.58, "t": "Ja, als ik tijd heb."}, {"s": 381.58, "e": 383.94, "t": "Doe je graag aan sport?"}, {"s": 383.94, "e": 385.89, "t": "Niet veel, maar ik wandel."}, {"s": 385.89, "e": 388.4, "t": "Wat maakt je gelukkig?"}, {"s": 388.4, "e": 392.9, "t": "Tijd met lieve mensen."}, {"s": 392.91, "e": 396.6, "t": "Activiteiten"}, {"s": 396.6, "e": 400.41, "t": "Wat doe jij het liefst in je vrije tijd?"}, {"s": 400.41, "e": 401.99, "t": "Ik wandel graag."}, {"s": 401.99, "e": 404.17, "t": "Ben je vaak buiten?"}, {"s": 404.17, "e": 406.17, "t": "Ja, vooral in het weekend."}, {"s": 406.17, "e": 408.91, "t": "Loop je graag door de stad?"}, {"s": 408.91, "e": 411.84, "t": "Ja, ik kijk graag naar nieuwe plekken."}, {"s": 411.84, "e": 413.32, "t": "Wat zijn je hobby's?"}, {"s": 413.32, "e": 415.46, "t": "Ik maak graag foto's."}, {"s": 415.46, "e": 417.36, "t": "Wat fotografeer je liever?"}, {"s": 417.36, "e": 420.2, "t": "Ik fotografeer graag mensen."}, {"s": 420.2, "e": 424.75, "t": "Luister je in je vrije tijd graag muziek?"}, {"s": 424.75, "e": 427.63, "t": "Ja, ik luister elke dag naar muziek."}, {"s": 427.63, "e": 429.62, "t": "Welke muziek vind je leuk?"}, {"s": 429.62, "e": 433.8, "t": "Ik houd van pop en rustige liedjes."}, {"s": 433.8, "e": 437.1, "t": "Luister je ook naar Nederlandse muziek?"}, {"s": 437.1, "e": 440.77, "t": "Ja, ik leer met Nederlandse liedjes."}, {"s": 440.77, "e": 443.97, "t": "Reis je graag naar andere landen?"}, {"s": 443.97, "e": 447.5, "t": "Ja, reizen vind ik erg leuk."}, {"s": 447.5, "e": 450.15, "t": "Ben je al in andere landen geweest?"}, {"s": 450.15, "e": 454.05, "t": "Ja, ik ben in Frankrijk en Portugal geweest."}, {"s": 454.05, "e": 456.88, "t": "Waar wil je nog graag naartoe reizen?"}, {"s": 456.88, "e": 459.25, "t": "Ik wil graag naar Italië."}, {"s": 459.25, "e": 463.66, "t": "Reis je liever alleen of met anderen?"}, {"s": 463.66, "e": 466.22, "t": "Liever met vrienden of familie."}, {"s": 466.22, "e": 468.49, "t": "Mis je je thuisland soms?"}, {"s": 468.49, "e": 470.4, "t": "Ja, af en toe."}, {"s": 470.4, "e": 471.93, "t": "Wat mis je het meest?"}, {"s": 471.93, "e": 473.65, "t": "De zon en de zee."}, {"s": 473.65, "e": 476.39, "t": "Voel je je hier soms alleen?"}, {"s": 476.39, "e": 478.8, "t": "Zelden, maar soms wel."}, {"s": 478.8, "e": 480.34, "t": "Wat helpt je dan?"}, {"s": 480.34, "e": 482.33, "t": "Ik bel dan met mijn familie."}, {"s": 482.33, "e": 485.17, "t": "Heb je vaak contact met hen?"}, {"s": 485.17, "e": 487.49, "t": "Ja, bijna elke dag."}, {"s": 487.49, "e": 490.13, "t": "Hoe vind je je leven hier?"}, {"s": 490.13, "e": 492.83, "t": "Over het algemeen bevalt het me goed."}, {"s": 492.83, "e": 496.08, "t": "Wat vind je leuk aan Nederland?"}, {"s": 496.08, "e": 499.01, "t": "Het is rustig en heel veilig."}, {"s": 499.01, "e": 501.7, "t": "Vind je de Nederlandse cultuur leuk?"}, {"s": 501.7, "e": 504.16, "t": "Ja, ik vind haar interessant."}, {"s": 504.16, "e": 505.97, "t": "Wat heeft je verrast?"}, {"s": 505.97, "e": 509.04, "t": "Ja, de stiptheid van de mensen."}, {"s": 509.04, "e": 511.31, "t": "Ben je zelf op tijd?"}, {"s": 511.31, "e": 513.54, "t": "Ja, ik ben meestal op tijd."}, {"s": 513.54, "e": 515.35, "t": "Wat doe je meestal 's avonds?"}, {"s": 515.35, "e": 517.44, "t": "Ik kook 's avonds graag."}, {"s": 517.44, "e": 519.58, "t": "Kijk je 's avonds tv?"}, {"s": 519.58, "e": 522.18, "t": "Nee, ik lees liever een boek."}, {"s": 522.18, "e": 524.64, "t": "Kijk je films of series?"}, {"s": 524.64, "e": 526.59, "t": "Ik kijk graag series."}, {"s": 526.59, "e": 529.01, "t": "Zijn ze in het Nederlands?"}, {"s": 529.01, "e": 532.44, "t": "Soms, maar vaak in het Italiaans."}, {"s": 532.44, "e": 534.9, "t": "Versta je Nederlands op tv goed?"}, {"s": 534.9, "e": 538.15, "t": "Nee, ik begrijp nog niet alles."}, {"s": 538.15, "e": 539.55, "t": "Hoe voel je je nu?"}, {"s": 539.55, "e": 541.36, "t": "Ik ben een beetje moe."}, {"s": 541.36, "e": 543.68, "t": "Ben je tevreden met je leven?"}, {"s": 543.68, "e": 548.39, "t": "Ja, ik ben tevreden."}, {"s": 548.42, "e": 551.78, "t": "Dagelijkse routine"}, {"s": 551.78, "e": 554.29, "t": "Hoe lang ben je ’s ochtends in de badkamer?"}, {"s": 554.29, "e": 556.15, "t": "Ongeveer dertig minuten."}, {"s": 556.15, "e": 558.29, "t": "Eet je ’s middags warm of koud?"}, {"s": 558.29, "e": 559.96, "t": "Meestal eet ik warm."}, {"s": 559.96, "e": 562.33, "t": "Kook je ’s middags zelf?"}, {"s": 562.33, "e": 565.48, "t": "Nee, vaak eet ik iets snels."}, {"s": 565.48, "e": 568.5, "t": "Drink je genoeg water op een dag?"}, {"s": 568.5, "e": 571.75, "t": "Ja, ik probeer veel te drinken."}, {"s": 571.75, "e": 574.54, "t": "Schrijf je graag berichtjes?"}, {"s": 574.54, "e": 576.82, "t": "Ja, vooral met vrienden."}, {"s": 576.82, "e": 579.23, "t": "Gebruik je je mobiel veel?"}, {"s": 579.23, "e": 581.92, "t": "Ja, ik zit vaak op mijn mobiel."}, {"s": 581.92, "e": 584.66, "t": "Waarvoor gebruik je je mobiel het meest?"}, {"s": 584.66, "e": 587.45, "t": "Voor berichtjes en muziek."}, {"s": 587.45, "e": 590.93, "t": "Maak je graag plannen of ben je liever spontaan?"}, {"s": 590.93, "e": 593.12, "t": "Ik plan graag een beetje."}, {"s": 593.12, "e": 595.76, "t": "Hou je van lange gesprekken?"}, {"s": 595.76, "e": 598.46, "t": "Ja, met goede vrienden."}, {"s": 598.46, "e": 601.57, "t": "Luister je graag naar podcasts?"}, {"s": 601.57, "e": 604.91, "t": "Ja, soms om Nederlands te leren."}, {"s": 604.91, "e": 608.53, "t": "Leer je liever alleen of met anderen?"}, {"s": 608.53, "e": 611.23, "t": "Ik leer liever alleen."}, {"s": 611.23, "e": 613.92, "t": "Schrijf je nieuwe woorden op?"}, {"s": 613.92, "e": 616.76, "t": "Ja, in een klein schrift."}, {"s": 616.76, "e": 618.66, "t": "Herhaal je vaak?"}, {"s": 618.66, "e": 620.42, "t": "Ja, dat helpt mij."}, {"s": 620.42, "e": 623.49, "t": "Heb je een vaste dagplanning?"}, {"s": 623.49, "e": 627.07, "t": "Nee, ik heb geen vaste planning."}, {"s": 627.07, "e": 629.06, "t": "Hou je van routines?"}, {"s": 629.06, "e": 631.06, "t": "Ja, ze geven mij zekerheid."}, {"s": 631.06, "e": 633.71, "t": "Ga je liever alleen boodschappen doen?"}, {"s": 633.71, "e": 635.84, "t": "Ja, dat is rustiger."}, {"s": 635.84, "e": 638.35, "t": "Hou je van kleine winkels?"}, {"s": 638.35, "e": 642.07, "t": "Ja, ik vind grote winkels niet fijn."}, {"s": 642.07, "e": 644.48, "t": "Kijk je naar aanbiedingen?"}, {"s": 644.48, "e": 648.24, "t": "Ja, ik wil niet veel geld uitgeven."}, {"s": 648.24, "e": 652.79, "t": "Luister je muziek tijdens het schoonmaken?"}, {"s": 652.79, "e": 655.16, "t": "Ja, dat maakt het leuker."}, {"s": 655.16, "e": 657.67, "t": "Maak je regelmatig schoon?"}, {"s": 657.67, "e": 659.85, "t": "Ja, één keer per week."}, {"s": 659.85, "e": 663.06, "t": "Open je ’s ochtends graag het raam?"}, {"s": 663.06, "e": 665.8, "t": "Ja, frisse lucht is belangrijk."}, {"s": 665.8, "e": 668.77, "t": "Vergeet je soms afspraken?"}, {"s": 668.77, "e": 671.74, "t": "Zelden, maar het gebeurt."}, {"s": 671.74, "e": 676.48, "t": "Vraag je vaak na als je iets niet begrijpt?"}, {"s": 676.48, "e": 678.85, "t": "Ja, dat is belangrijk voor mij."}, {"s": 678.85, "e": 681.12, "t": "Heb je geduld met jezelf?"}, {"s": 681.12, "e": 684.05, "t": "Ja, ik leer stap voor stap."}, {"s": 684.05, "e": 687.49, "t": "Ben je blij met kleine successen?"}, {"s": 687.49, "e": 689.67, "t": "Ja, heel erg."}, {"s": 689.67, "e": 693.48, "t": "Vergelijk je jezelf met anderen?"}, {"s": 693.48, "e": 696.26, "t": "Soms, maar niet te veel."}, {"s": 696.26, "e": 698.58, "t": "Geloof je in jezelf?"}, {"s": 698.58, "e": 702.86, "t": "Ja, steeds meer."}, {"s": 702.86, "e": 706.09, "t": "Gevoelens"}, {"s": 706.09, "e": 708.64, "t": "Hoe voel je je vandaag?"}, {"s": 708.64, "e": 711.24, "t": "Vandaag voel ik me rustig."}, {"s": 711.24, "e": 713.19, "t": "Ben je vaak vrolijk?"}, {"s": 713.19, "e": 714.86, "t": "Ja, meestal wel."}, {"s": 714.86, "e": 716.72, "t": "Wat maakt je snel blij?"}, {"s": 716.72, "e": 719.14, "t": "Goede gesprekken en muziek."}, {"s": 719.14, "e": 722.11, "t": "Is er iets dat je verdrietig maakt?"}, {"s": 722.11, "e": 725.27, "t": "Ja, als ik mijn familie mis."}, {"s": 725.27, "e": 727.22, "t": "Huil je soms?"}, {"s": 727.22, "e": 729.03, "t": "Ja, maar niet vaak."}, {"s": 729.03, "e": 731.53, "t": "Wat helpt je als je verdrietig bent?"}, {"s": 731.53, "e": 734.27, "t": "Wandelen of muziek luisteren."}, {"s": 734.27, "e": 737.11, "t": "Voel je je soms gestrest?"}, {"s": 737.11, "e": 739.52, "t": "Ja, vooral voor toetsen."}, {"s": 739.52, "e": 741.61, "t": "Wat doe je tegen stress?"}, {"s": 741.61, "e": 744.91, "t": "Ik adem rustig en neem pauzes."}, {"s": 744.91, "e": 747.28, "t": "Ben je soms nerveus?"}, {"s": 747.28, "e": 750.58, "t": "Ja, voor belangrijke afspraken."}, {"s": 750.58, "e": 753.55, "t": "Hoe merk je dat je nerveus bent?"}, {"s": 753.55, "e": 755.5, "t": "Mijn hart klopt sneller."}, {"s": 755.5, "e": 757.63, "t": "Ben je soms bang?"}, {"s": 757.63, "e": 758.89, "t": "Ja, maar zelden."}, {"s": 758.89, "e": 761.3, "t": "Waar ben je bang voor?"}, {"s": 761.3, "e": 763.21, "t": "Voor grote veranderingen."}, {"s": 763.21, "e": 766.69, "t": "Voel je je vaak veilig?"}, {"s": 766.69, "e": 769.52, "t": "Ja, hier voel ik me veilig."}, {"s": 769.52, "e": 772.54, "t": "Ben je trots op jezelf?"}, {"s": 772.54, "e": 774.63, "t": "Ja, op mijn vooruitgang."}, {"s": 774.63, "e": 776.58, "t": "Word je blij van complimenten?"}, {"s": 776.58, "e": 778.16, "t": "Ja, heel blij."}, {"s": 778.16, "e": 780.53, "t": "Erger je je wel eens?"}, {"s": 780.53, "e": 782.66, "t": "Ja, als iets niet lukt."}, {"s": 782.66, "e": 785.31, "t": "Hoe reageer je als je boos bent?"}, {"s": 785.31, "e": 787.08, "t": "Ik word stil."}, {"s": 787.08, "e": 790.75, "t": "Kun je je gevoelens goed tonen?"}, {"s": 790.75, "e": 791.95, "t": "Niet altijd."}, {"s": 791.95, "e": 794.6, "t": "Praat je over je gevoelens?"}, {"s": 794.6, "e": 797.38, "t": "Ja, met vertrouwde mensen."}, {"s": 797.38, "e": 800.17, "t": "Wie vertrouw je het meest?"}, {"s": 800.17, "e": 801.47, "t": "Mijn familie."}, {"s": 801.47, "e": 805.09, "t": "Voel je je soms eenzaam?"}, {"s": 805.09, "e": 807.14, "t": "Zelden, maar soms wel."}, {"s": 807.14, "e": 809.6, "t": "Wanneer voel je je het best?"}, {"s": 809.6, "e": 811.22, "t": "Thuis in de avond."}, {"s": 811.22, "e": 813.68, "t": "Hou je van rustige momenten?"}, {"s": 813.68, "e": 815.54, "t": "Ja, heel veel."}, {"s": 815.54, "e": 818.7, "t": "Wat stelt je gerust?"}, {"s": 818.7, "e": 820.23, "t": "Zachte muziek."}, {"s": 820.23, "e": 822.18, "t": "Ben je geduldig?"}, {"s": 822.18, "e": 823.62, "t": "Ja, meestal."}, {"s": 823.62, "e": 825.99, "t": "Vergeef je snel?"}, {"s": 825.99, "e": 827.66, "t": "Ja, ik probeer het."}, {"s": 827.66, "e": 829.66, "t": "Denk je veel na?"}, {"s": 829.66, "e": 831.47, "t": "Ja, soms te veel."}, {"s": 831.47, "e": 833.14, "t": "Ben je optimistisch?"}, {"s": 833.14, "e": 835.18, "t": "Ja, ik denk positief."}, {"s": 835.18, "e": 837.83, "t": "Hoop je op de toekomst?"}, {"s": 837.83, "e": 839.13, "t": "Ja, zeker."}, {"s": 839.13, "e": 841.59, "t": "Hoe wil je je in de toekomst voelen?"}, {"s": 841.59, "e": 846.26, "t": "Gelukkig en tevreden."}]