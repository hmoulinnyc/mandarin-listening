[{"s": 0.64, "e": 6.64, "t": "Hoi allemaal, ik ben Noelle en vandaag"}, {"s": 6.64, "e": 9.16, "t": "ga ik praten"}, {"s": 9.16, "e": 13.96, "t": "over ziek zijn."}, {"s": 15.8, "e": 19.4, "t": "Ik moet niezen. Ik ben ziek."}, {"s": 19.4, "e": 23.16, "t": "Ik moet kuggen."}, {"s": 23.92, "e": 26.2, "t": "Ik ben ziek."}, {"s": 26.2, "e": 28.04, "t": "Oh,"}, {"s": 28.04, "e": 33.56, "t": "ik heb hoofd. pijn. Hm. Zoveel"}, {"s": 33.56, "e": 36.56, "t": "hoofdpijn."}, {"s": 36.8, "e": 42.92, "t": "Ik ben ziek. Het is nu winter. En in de"}, {"s": 42.92, "e": 45.04, "t": "winter"}, {"s": 45.04, "e": 49.04, "t": "zijn mensen heel veel ziek. Heel veel"}, {"s": 49.04, "e": 52.64, "t": "mensen moeten niezen"}, {"s": 52.64, "e": 56.04, "t": "of kugen"}, {"s": 56.32, "e": 59.4, "t": "of hebben hoofdpijn."}, {"s": 59.4, "e": 61.92, "t": "Oh, ik heb hoofdpijn."}, {"s": 61.92, "e": 64.64, "t": "En dan ben je ziek."}, {"s": 64.64, "e": 69.4, "t": "Maar wat doe je als je ziek bent?"}, {"s": 69.4, "e": 74.56, "t": "Wat doe je om beter te worden? Om weer"}, {"s": 74.56, "e": 76.88, "t": "gezond te zijn."}, {"s": 76.88, "e": 81.48, "t": "Je kunt een paar dingen doen om te"}, {"s": 81.48, "e": 83.56, "t": "helpen,"}, {"s": 83.56, "e": 86.56, "t": "zoals"}, {"s": 86.76, "e": 89.64, "t": "paracetamol nemen."}, {"s": 89.64, "e": 91.88, "t": "Ja, paracetamol"}, {"s": 91.88, "e": 96.2, "t": "nemen heel veel mensen in Nederland als"}, {"s": 96.2, "e": 98.2, "t": "ze ziek zijn."}, {"s": 98.2, "e": 102.4, "t": "Bijvoorbeeld als ze hoofd hoofdpijn"}, {"s": 102.4, "e": 106.56, "t": "hebben om minder"}, {"s": 106.56, "e": 109.48, "t": "pijn te hebben."}, {"s": 109.48, "e": 111.6, "t": "Paracetamon"}, {"s": 111.6, "e": 115.72, "t": "of slapen."}, {"s": 117.12, "e": 121.6, "t": "Schapen is ook heel goed als je ziek"}, {"s": 121.6, "e": 125.76, "t": "bent om beter te worden"}, {"s": 125.76, "e": 128.32, "t": "of"}, {"s": 128.32, "e": 130.92, "t": "thee drinken."}, {"s": 130.92, "e": 136.0, "t": "Heel veel thee drinken."}, {"s": 136.0, "e": 139.8, "t": "Hier zit thee in."}, {"s": 139.8, "e": 146.36, "t": "Ik drink heel veel thee als ik ziek ben."}, {"s": 146.36, "e": 149.16, "t": "Wat ook goed is,"}, {"s": 149.16, "e": 152.8, "t": "is gezond eten."}, {"s": 152.8, "e": 157.36, "t": "Eten met allemaal groente,"}, {"s": 157.36, "e": 159.92, "t": "fruit eten"}, {"s": 159.92, "e": 167.48, "t": "en soms gewoon iets eten. Niet niks."}, {"s": 167.48, "e": 172.2, "t": "niet. Want je lichaam heeft eten nodig"}, {"s": 172.2, "e": 175.32, "t": "om beter te kunnen worden."}, {"s": 175.32, "e": 179.68, "t": "Dus eten is heel belangrijk,"}, {"s": 179.68, "e": 184.68, "t": "maar het beste is gezond eten met veel"}, {"s": 184.68, "e": 188.44, "t": "groente en fruit."}, {"s": 188.44, "e": 190.2, "t": "Ja,"}, {"s": 190.2, "e": 193.92, "t": "maar veel mensen vinden het moeilijk."}, {"s": 193.92, "e": 197.92, "t": "Oer zo moeilijk om te eten als ze ziek"}, {"s": 197.92, "e": 199.12, "t": "zijn."}, {"s": 199.12, "e": 204.32, "t": "Dus dan eten ze bijvoorbeeld soep"}, {"s": 204.32, "e": 206.24, "t": "of drinken."}, {"s": 206.24, "e": 211.24, "t": "Drinken ze soep omdat dat het enige het"}, {"s": 211.24, "e": 216.4, "t": "enige ding is dat ze kunnen eten. Dus"}, {"s": 216.4, "e": 219.28, "t": "soep ook heel goed."}, {"s": 219.28, "e": 222.24, "t": "Ook voor het zout."}, {"s": 222.24, "e": 228.36, "t": "Wat ook heel fijn is als je ziek bent is"}, {"s": 228.36, "e": 232.08, "t": "warm blijven. Niet"}, {"s": 232.08, "e": 236.2, "t": "koud, maar hm warm."}, {"s": 236.2, "e": 240.52, "t": "En wat ik heel fijn vind daarvoor"}, {"s": 240.52, "e": 246.72, "t": "is een kruikje. Dit is een kruikje."}, {"s": 246.72, "e": 249.64, "t": "Een kruik."}, {"s": 249.64, "e": 256.8, "t": "Hierin doe ik warm water en dan ben ik"}, {"s": 256.8, "e": 258.92, "t": "warm."}, {"s": 258.92, "e": 263.16, "t": "Heel belangrijk als je ziek bent."}, {"s": 263.16, "e": 268.96, "t": "Iets anders wat ook helpt om warm te"}, {"s": 268.96, "e": 270.68, "t": "blijven"}, {"s": 270.68, "e": 274.16, "t": "is een dekentje."}, {"s": 274.16, "e": 280.0, "t": "een warm en zacht tekentje, zodat je op"}, {"s": 280.0, "e": 283.8, "t": "de bank"}, {"s": 284.12, "e": 286.44, "t": "onder onder"}, {"s": 286.44, "e": 290.04, "t": "een tekentje"}, {"s": 290.36, "e": 294.76, "t": "kunt liggen en dan"}, {"s": 294.76, "e": 297.24, "t": "kug je wel en"}, {"s": 297.24, "e": 302.72, "t": "nies, maar ben je wel warm?"}, {"s": 304.12, "e": 307.96, "t": "Heel goed en belangrijk. Ja."}, {"s": 307.96, "e": 311.64, "t": "En wat doe je dan als je gewoon moet"}, {"s": 311.64, "e": 315.64, "t": "liggen en wachten?"}, {"s": 315.64, "e": 321.12, "t": "Wachten totdat je beter bent. Dan kan je"}, {"s": 321.12, "e": 324.12, "t": "lezen."}, {"s": 325.8, "e": 327.8, "t": "Hm."}, {"s": 327.8, "e": 330.52, "t": "Ah, interessant."}, {"s": 330.52, "e": 334.56, "t": "Wat leuk dit boek."}, {"s": 335.68, "e": 341.84, "t": "Je kunt lezen of een spelletje spelen."}, {"s": 342.2, "e": 347.28, "t": "Bijvoorbeeld ik heb een Nintendo Switch."}, {"s": 347.28, "e": 349.24, "t": "Dat kan"}, {"s": 349.24, "e": 352.44, "t": "ook leuk."}, {"s": 352.44, "e": 356.76, "t": "Oh, mijn Nintendo Switch is leeg. De"}, {"s": 356.76, "e": 359.0, "t": "batterij is op."}, {"s": 359.0, "e": 361.72, "t": "Ik moet hem opladen"}, {"s": 361.72, "e": 365.12, "t": "met een oplader."}, {"s": 365.12, "e": 370.84, "t": "Of je kunt tekenen"}, {"s": 371.04, "e": 373.32, "t": "of een"}, {"s": 373.32, "e": 375.2, "t": "film"}, {"s": 375.2, "e": 376.8, "t": "kijken"}, {"s": 376.8, "e": 380.64, "t": "of een serie"}, {"s": 380.64, "e": 383.24, "t": "kijken."}, {"s": 383.24, "e": 389.84, "t": "Ja, je moet vooral ontspannen en rustig"}, {"s": 389.84, "e": 391.44, "t": "aandoen,"}, {"s": 391.44, "e": 395.24, "t": "zodat je beter kan worden en weer gezond"}, {"s": 395.24, "e": 398.16, "t": "bent. Ja,"}, {"s": 398.16, "e": 403.96, "t": "dit is wat ik doe als ik ziek ben en wat"}, {"s": 403.96, "e": 407.6, "t": "veel mensen in Nederland doen als ze"}, {"s": 407.6, "e": 409.6, "t": "ziek zijn."}, {"s": 409.6, "e": 411.68, "t": "Doe jij hetzelfde"}, {"s": 411.68, "e": 414.32, "t": "als je ziek bent?"}, {"s": 414.32, "e": 418.92, "t": "Of doe jij iets heel anders? Iets heel"}, {"s": 418.92, "e": 420.72, "t": "anders."}, {"s": 420.72, "e": 423.68, "t": "Ik hoor het heel graag in de"}, {"s": 423.68, "e": 425.52, "t": "opmerkingen."}, {"s": 425.52, "e": 429.48, "t": "En dan nu tot de volgende keer. Doeg."}, {"s": 429.48, "e": 432.48, "t": "Doeg."}]