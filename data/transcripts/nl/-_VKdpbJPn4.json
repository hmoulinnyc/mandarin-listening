[{"s": 0.6, "e": 2.64, "t": "Superhelden team Super Ultra Vitamin"}, {"s": 2.64, "e": 4.44, "t": "Squad heeft de dag weer gered."}, {"s": 4.44, "e": 6.64, "t": "Lang leven de Super Squad."}, {"s": 6.64, "e": 8.72, "t": "Echt nice of vitamine Een schild maakte"}, {"s": 8.72, "e": 10.68, "t": "tegen die schadelijke vrije radicalen."}, {"s": 10.68, "e": 11.92, "t": "Zonder de kracht van vitamine D was dat"}, {"s": 11.92, "e": 12.84, "t": "nooit gelukt hoor."}, {"s": 12.84, "e": 14.28, "t": "Jongens, het lichaam beschermen is"}, {"s": 14.28, "e": 16.52, "t": "teamwork. Ik zorg voor sterke botten."}, {"s": 16.52, "e": 17.92, "t": "B12 houdt de hersenen en het"}, {"s": 17.92, "e": 19.84, "t": "zenuwstelsel soepel. E blokkeert"}, {"s": 19.84, "e": 22.12, "t": "moleculen die cellen willen beschadigen."}, {"s": 22.12, "e": 24.04, "t": "En vitamine A. Ik haal [snuift] het haar"}, {"s": 24.04, "e": 25.76, "t": "glanzend, de nageltjes strak en de huid"}, {"s": 25.76, "e": 26.08, "t": "mooi."}, {"s": 26.08, "e": 28.04, "t": "Niet alleen van dit prachtige lichaam"}, {"s": 28.04, "e": 29.52, "t": "waar wij wonen en dat wij gezworen"}, {"s": 29.52, "e": 30.92, "t": "hebben te beschermen, maar ook van"}, {"s": 30.92, "e": 32.64, "t": "onszelf, hè. Zo staan wij altijd goed op"}, {"s": 32.64, "e": 35.76, "t": "de foto."}, {"s": 36.4, "e": 37.68, "t": "Lang leven de Surf Squad."}, {"s": 37.68, "e": 41.32, "t": "Het is SUV Squad. Niet Suf Squad. Dat"}, {"s": 41.32, "e": 42.6, "t": "klinkt zo suf."}, {"s": 42.6, "e": 43.36, "t": "Sorry."}, {"s": 43.36, "e": 46.68, "t": "En jij vitamine K. Ja. Wat doe jij"}, {"s": 46.68, "e": 47.4, "t": "eigenlijk?"}, {"s": 47.4, "e": 48.8, "t": "Behalve smoothies voor ons maken. Ik zou"}, {"s": 48.8, "e": 49.68, "t": "het niet weten."}, {"s": 49.68, "e": 50.68, "t": "Ja. Eh"}, {"s": 50.68, "e": 52.4, "t": "volgens mij weet hij het zelf ook niet."}, {"s": 53.32, "e": 54.68, "t": "Jongens, niet zo gemeen. Niemand weet"}, {"s": 54.68, "e": 56.52, "t": "precies wat zijn superkracht is. Maar"}, {"s": 56.52, "e": 61.0, "t": "hij is nou eenmaal onderdeel van ons."}, {"s": 63.16, "e": 64.48, "t": "Wat is er baas?"}, {"s": 64.48, "e": 66.2, "t": "Wat aardige virussen?"}, {"s": 66.2, "e": 67.72, "t": "Komt er een winterdip aan?"}, {"s": 67.72, "e": 69.44, "t": "Oh nee, ik heb winterdip al heel lang"}, {"s": 69.44, "e": 70.64, "t": "geleden uitgeschakeld met mijn"}, {"s": 70.64, "e": 73.84, "t": "calciumstraal. Het is wat anders."}, {"s": 73.84, "e": 76.44, "t": "Wat is dat?"}, {"s": 76.44, "e": 78.24, "t": "Huh? Het lijkt wel e"}, {"s": 78.24, "e": 79.96, "t": "een snee."}, {"s": 79.96, "e": 81.84, "t": "Ons prachtige lichaam heeft een snee en"}, {"s": 81.84, "e": 83.24, "t": "een wijsvinger. Oh nee,"}, {"s": 83.24, "e": 86.4, "t": "een snee? Wat moeten we doen baas?"}, {"s": 86.4, "e": 87.64, "t": "Moet ik een schuld maken om de cellen te"}, {"s": 87.64, "e": 88.2, "t": "beschermen?"}, {"s": 88.2, "e": 90.36, "t": "De cellen zijn al beschadigd. Moet ik"}, {"s": 90.36, "e": 92.32, "t": "iets doen in het zenuwstelsel? Het"}, {"s": 92.32, "e": 94.44, "t": "zenuwstelsel functioneert prima."}, {"s": 94.44, "e": 95.92, "t": "Dat bloed."}, {"s": 95.92, "e": 97.64, "t": "Vitamina A, doe iets. Genees die bond."}, {"s": 97.64, "e": 99.12, "t": "Ja, niet zolang dat bloed is. Dat is zo"}, {"s": 99.12, "e": 99.6, "t": "vies."}, {"s": 99.6, "e": 100.24, "t": "Eh guys,"}, {"s": 100.24, "e": 101.88, "t": "even niet K. Dit is een noodsituatie."}, {"s": 101.88, "e": 103.36, "t": "Ja, dat weet ik, maar ik dacht misschien"}, {"s": 103.36, "e": 104.0, "t": "kan ik iets doen."}, {"s": 104.0, "e": 105.04, "t": "Ja, wat zou jij nou kunnen doen,"}, {"s": 105.04, "e": 107.24, "t": "vitamine K? Nou, ik kan protrombrine"}, {"s": 107.24, "e": 108.96, "t": "aanmaken in de lever en dan schiet"}, {"s": 108.96, "e": 111.12, "t": "vitamine D erop met zijn calciumstraal"}, {"s": 111.12, "e": 111.48, "t": "en dan"}, {"s": 111.48, "e": 113.48, "t": "en dan stolt het bloed."}, {"s": 113.48, "e": 117.56, "t": "En dan stopt het met bloeden. Briljant."}, {"s": 117.56, "e": 119.32, "t": "Geen tijd te verliezen team."}, {"s": 119.32, "e": 119.8, "t": "E"}, {"s": 119.8, "e": 120.08, "t": "ja,"}, {"s": 120.08, "e": 122.08, "t": "begeleid vitamine K naar de lever. Ik"}, {"s": 122.08, "e": 125.24, "t": "zie jullie bij de wond."}, {"s": 127.04, "e": 129.32, "t": "De verborgen krachten van vitamine K kan"}, {"s": 129.32, "e": 131.92, "t": "het team heel goed gebruiken. Ik heb nog"}, {"s": 131.92, "e": 132.96, "t": "wel meer ideetjes hoor."}, {"s": 132.96, "e": 135.08, "t": "Eerst deze crisis oplossen vitamine K."}, {"s": 135.08, "e": 138.08, "t": "Tempel."}]