[{"s": 0.2, "e": 2.24, "t": "Hoi, welkom terug bij Melanie Judge"}, {"s": 2.24, "e": 3.44, "t": "podcast."}, {"s": 3.44, "e": 5.52, "t": "Hoi allemaal, we zijn zo blij dat jullie"}, {"s": 5.52, "e": 7.36, "t": "er weer bij zijn vandaag."}, {"s": 7.36, "e": 8.92, "t": "Ik ben Melanie."}, {"s": 8.92, "e": 10.56, "t": "En ik ben Hans."}, {"s": 10.56, "e": 12.68, "t": "We maken video's om jou te helpen elke"}, {"s": 12.68, "e": 14.6, "t": "dag Nederlands te spreken."}, {"s": 14.6, "e": 16.36, "t": "En als je dit leuk vindt, druk dan op"}, {"s": 16.36, "e": 18.24, "t": "like en abonneer je op ons kanaal. Het"}, {"s": 18.24, "e": 19.92, "t": "helpt ons enorm."}, {"s": 19.92, "e": 21.76, "t": "Vandaag hebben we het over de dagelijkse"}, {"s": 21.76, "e": 22.92, "t": "routine."}, {"s": 22.92, "e": 25.28, "t": "We gaan luisteren, nuttige zinnen leren"}, {"s": 25.28, "e": 27.32, "t": "en een leuk gesprek voeren."}, {"s": 27.32, "e": 30.48, "t": "Ben je er klaar voor? Laten we beginnen."}, {"s": 30.48, "e": 33.16, "t": "Hans, hoe gaat het met je vandaag?"}, {"s": 33.16, "e": 35.2, "t": "Het gaat goed, Melanie. Maar ik ben een"}, {"s": 35.2, "e": 36.84, "t": "beetje slaperig."}, {"s": 36.84, "e": 40.08, "t": "Oh nee, slaperig? Waarom ben je"}, {"s": 40.08, "e": 41.4, "t": "slaperig?"}, {"s": 41.4, "e": 43.44, "t": "Ik werd vandaag heel vroeg wakker om"}, {"s": 43.44, "e": 44.68, "t": "6:30."}, {"s": 44.68, "e": 47.36, "t": "6:30? Dat is best vroeg."}, {"s": 47.36, "e": 49.68, "t": "Ja, het is vroeg, maar ik had wel een"}, {"s": 49.68, "e": 51.2, "t": "lekker ontbijt."}, {"s": 51.2, "e": 53.4, "t": "Oh, fijn. Wat had je?"}, {"s": 53.4, "e": 55.16, "t": "Ik had een boterham met kaas en een"}, {"s": 55.16, "e": 56.44, "t": "banaan."}, {"s": 56.44, "e": 58.68, "t": "Dat is een goed begin van de dag."}, {"s": 58.68, "e": 61.28, "t": "Ja, ik denk het ook. Hoe laat werd jij"}, {"s": 61.28, "e": 62.36, "t": "wakker?"}, {"s": 62.36, "e": 64.68, "t": "Ik werd wakker om 6 uur. Ik doe eerst 10"}, {"s": 64.68, "e": 67.24, "t": "minuten yoga voordat ik ontbijt."}, {"s": 67.24, "e": 69.36, "t": "Wauw, dat is toegewijd. Wat doe je"}, {"s": 69.36, "e": 70.48, "t": "daarna?"}, {"s": 70.48, "e": 72.48, "t": "Daarna zet ik mijn wekker uit."}, {"s": 72.48, "e": 74.44, "t": "Ja, dat is heel belangrijk. Eerst de"}, {"s": 74.44, "e": 75.88, "t": "wekker uitzetten."}, {"s": 75.88, "e": 78.0, "t": "Dan blijf ik nog even liggen. Misschien"}, {"s": 78.0, "e": 79.24, "t": "een minuutje."}, {"s": 79.24, "e": 82.12, "t": "Ik ook. Ik spring niet meteen uit bed."}, {"s": 82.12, "e": 84.8, "t": "Precies. Ik word langzaam wakker."}, {"s": 84.8, "e": 87.72, "t": "En daarna sta je op en stap je uit bed."}, {"s": 87.72, "e": 91.16, "t": "Ja, precies. Maak jij je bed op?"}, {"s": 91.16, "e": 94.28, "t": "Soms niet elke dag. Is dat erg?"}, {"s": 94.28, "e": 96.68, "t": "Nee hoor, dat is niet erg. Ik maak mijn"}, {"s": 96.68, "e": 98.2, "t": "bed altijd op."}, {"s": 98.2, "e": 100.48, "t": "Waarom maak jij je bed elke dag op?"}, {"s": 100.48, "e": 102.4, "t": "Het geeft me een goed gevoel en het"}, {"s": 102.4, "e": 104.2, "t": "voelt klaar voor de dag."}, {"s": 104.2, "e": 106.8, "t": "Oké, ik ga het proberen vaker te doen."}, {"s": 106.8, "e": 108.4, "t": "Dat is een kleine overwinning voor de"}, {"s": 108.4, "e": 109.28, "t": "dag."}, {"s": 109.28, "e": 111.4, "t": "Dan loop ik naar de badkamer."}, {"s": 111.4, "e": 113.4, "t": "Wat doe je in de badkamer?"}, {"s": 113.4, "e": 115.2, "t": "Eerst poets ik mijn tanden"}, {"s": 115.2, "e": 117.72, "t": "met koud water of warm water?"}, {"s": 117.72, "e": 120.88, "t": "Koud water. Altijd koud water. Het maakt"}, {"s": 120.88, "e": 122.08, "t": "me wakker."}, {"s": 122.08, "e": 124.2, "t": "Ik gebruik warm water. We zijn"}, {"s": 124.2, "e": 125.64, "t": "verschillend."}, {"s": 125.64, "e": 127.52, "t": "Heel verschillend. En dan was ik mijn"}, {"s": 127.52, "e": 128.48, "t": "gezicht"}, {"s": 128.48, "e": 131.64, "t": "Ik ook. Ik was mijn gezicht met zeep."}, {"s": 131.64, "e": 134.68, "t": "Ja, met zeep. Dan kijk ik in de spiegel"}, {"s": 134.68, "e": 136.8, "t": "en dan denk je: \"Ik heb een knipbeurt"}, {"s": 136.8, "e": 137.96, "t": "nodig.\""}, {"s": 137.96, "e": 140.44, "t": "Hoe wist je dat? Dat denk ik echt elke"}, {"s": 140.44, "e": 141.64, "t": "ochtend."}, {"s": 141.64, "e": 143.92, "t": "Iedereen denkt dat."}, {"s": 143.92, "e": 145.84, "t": "Dan is het tijd voor een douche."}, {"s": 145.84, "e": 148.16, "t": "Neem jij een snelle warme douche?"}, {"s": 148.16, "e": 150.52, "t": "Ja, altijd een snelle douche."}, {"s": 150.52, "e": 152.36, "t": "Zing je onder de douche?"}, {"s": 152.36, "e": 155.8, "t": "Nee. Nee, ik zing niet. Mijn zangkunst"}, {"s": 155.8, "e": 157.16, "t": "is niet goed."}, {"s": 157.16, "e": 159.2, "t": "Dat geloof ik niet. Ik denk dat je heel"}, {"s": 159.2, "e": 160.4, "t": "goed zingt."}, {"s": 160.4, "e": 162.76, "t": "Misschien alleen als niemand luistert."}, {"s": 162.76, "e": 165.2, "t": "Na de douche, wat doe je dan?"}, {"s": 165.2, "e": 167.56, "t": "Ik droog mezelf af met een handdoek."}, {"s": 167.56, "e": 170.08, "t": "Ik droog mijn haar en kleed me aan."}, {"s": 170.08, "e": 172.88, "t": "Ja, ik trek mijn kleren aan, ondergoed,"}, {"s": 172.88, "e": 175.44, "t": "sokken, broek en een shirt."}, {"s": 175.44, "e": 177.4, "t": "Wat draag je naar je werk?"}, {"s": 177.4, "e": 179.84, "t": "Een spijkerbroek en een t-shirt."}, {"s": 179.84, "e": 181.32, "t": "Is jouw werk?"}, {"s": 181.32, "e": 183.84, "t": "Ja, heel informeel. Ik kan elke dag een"}, {"s": 183.84, "e": 185.4, "t": "spijkerbroek dragen."}, {"s": 185.4, "e": 187.12, "t": "Dat is fijn. Mijn werkkleding is"}, {"s": 187.12, "e": 188.32, "t": "grappig."}, {"s": 188.32, "e": 189.56, "t": "Hoezo?"}, {"s": 189.56, "e": 191.72, "t": "Ik draag een mooie blues voor de video,"}, {"s": 191.72, "e": 193.88, "t": "maar een joggingbroek eronder."}, {"s": 193.88, "e": 196.44, "t": "Echt waar? Dat is heel grappig."}, {"s": 196.44, "e": 198.16, "t": "Het is een geheim. Vertel het"}, {"s": 198.16, "e": 200.44, "t": "alsjeblieft niet aan mijn kijkers."}, {"s": 200.44, "e": 202.52, "t": "Maak je geen zorgen. Jouw geheim is"}, {"s": 202.52, "e": 203.92, "t": "veilig bij mij."}, {"s": 203.92, "e": 206.8, "t": "Dank je. En weet je, ik denk dat heel"}, {"s": 206.8, "e": 208.72, "t": "veel mensen dit stiekem doen."}, {"s": 208.72, "e": 211.24, "t": "Dat denk ik ook. Comfortabel onderaan,"}, {"s": 211.24, "e": 213.2, "t": "professioneel bovenaan."}, {"s": 213.2, "e": 215.12, "t": "Precies. Dat is het geheim van"}, {"s": 215.12, "e": 217.16, "t": "thuiswerken en videobellen."}, {"s": 217.16, "e": 218.64, "t": "Een goede tip voor iedereen die dit"}, {"s": 218.64, "e": 219.64, "t": "luistert."}, {"s": 219.64, "e": 221.72, "t": "Even een kleine pauze. Als je dit leuk"}, {"s": 221.72, "e": 223.76, "t": "vindt, druk dan op het duimpje omhoog"}, {"s": 223.76, "e": 225.52, "t": "knop en abonneer je op Melanie Dutch"}, {"s": 225.52, "e": 226.96, "t": "podcast."}, {"s": 226.96, "e": 228.92, "t": "Dat helpt ons om elke week weer nieuwe"}, {"s": 228.92, "e": 230.76, "t": "content te maken voor jou."}, {"s": 230.76, "e": 232.76, "t": "Oké, we gaan verder."}, {"s": 232.76, "e": 234.88, "t": "Dus je bent aangekleed. Nu is het tijd"}, {"s": 234.88, "e": 236.32, "t": "voor ontbijt."}, {"s": 236.32, "e": 239.64, "t": "Ja, ik heb mijn ontbijt al gemaakt."}, {"s": 239.64, "e": 240.92, "t": "Wat maakte je?"}, {"s": 240.92, "e": 243.36, "t": "Yoghurt met muuslee en wat fruit."}, {"s": 243.36, "e": 245.64, "t": "Dat klinkt gezond. En jij?"}, {"s": 245.64, "e": 247.76, "t": "Ik vroeg jou eigenlijk: \"Wat eet jij"}, {"s": 247.76, "e": 249.0, "t": "meestal?\""}, {"s": 249.0, "e": 251.28, "t": "Ik eet een boterham met kaas. Heel snel"}, {"s": 251.28, "e": 252.32, "t": "klaar."}, {"s": 252.32, "e": 255.24, "t": "Snel is ook goed. Eet je aan tafel?"}, {"s": 255.24, "e": 257.16, "t": "Nee, [zucht] ik sta meestal in de"}, {"s": 257.16, "e": 259.6, "t": "keuken. Dat is een slechte gewoonte."}, {"s": 259.6, "e": 261.84, "t": "Ik zit aan een klein tafeltje. Ik kijk"}, {"s": 261.84, "e": 263.2, "t": "naar buiten."}, {"s": 263.2, "e": 264.68, "t": "Dat klinkt fijn."}, {"s": 264.68, "e": 267.08, "t": "Ja, ik drink mijn sinasappelsap en"}, {"s": 267.08, "e": 268.48, "t": "ontspan even."}, {"s": 268.48, "e": 271.16, "t": "Een rustig moment. Dat vind ik fijn."}, {"s": 271.16, "e": 273.8, "t": "Ja, maar dan begint het probleem."}, {"s": 273.8, "e": 276.56, "t": "Het probleem? Welk probleem?"}, {"s": 276.56, "e": 278.92, "t": "Het probleem van het huis verlaten."}, {"s": 278.92, "e": 281.8, "t": "Oh nee, wat gebeurt er dan? Ik kan mijn"}, {"s": 281.8, "e": 283.56, "t": "spullen nooit vinden."}, {"s": 283.56, "e": 285.48, "t": "Welke spullen ben je kwijt?"}, {"s": 285.48, "e": 288.04, "t": "Mijn sleutels, mijn portemonnee en mijn"}, {"s": 288.04, "e": 291.04, "t": "telefoon. Elke dag zoek ik er naar."}, {"s": 291.04, "e": 293.6, "t": "Melanie, je hebt één speciale plek nodig"}, {"s": 293.6, "e": 294.92, "t": "voor je spullen."}, {"s": 294.92, "e": 296.36, "t": "Zoals wat?"}, {"s": 296.36, "e": 298.2, "t": "Een bakje bij de deur."}, {"s": 298.2, "e": 300.84, "t": "Een bakje? Dat is een goed idee."}, {"s": 300.84, "e": 302.8, "t": "Ja, je legt je sleutels elke dag in het"}, {"s": 302.8, "e": 303.96, "t": "bakje."}, {"s": 303.96, "e": 305.8, "t": "Dat vind ik leuk. Ik pak mijn sleutels"}, {"s": 305.8, "e": 308.12, "t": "uit het bakje en verlaat het huis."}, {"s": 308.12, "e": 311.12, "t": "Precies. En dan vergrendel je de deur."}, {"s": 311.12, "e": 313.36, "t": "Heel belangrijk. Ik doe de deur altijd"}, {"s": 313.36, "e": 314.6, "t": "op slot"}, {"s": 314.6, "e": 316.68, "t": "en dan loop je naar je fiets. Ik stap op"}, {"s": 316.68, "e": 319.04, "t": "mijn fiets en fiets naar mijn werk."}, {"s": 319.04, "e": 321.0, "t": "Fietsen jij naar je werk?"}, {"s": 321.0, "e": 324.6, "t": "Ja, altijd. Het is gezond en snel."}, {"s": 324.6, "e": 327.0, "t": "Is er veel verkeer onderweg?"}, {"s": 327.0, "e": 329.24, "t": "Soms wel. Als er veel fietsers zijn"}, {"s": 329.24, "e": 330.92, "t": "luister ik naar muziek."}, {"s": 330.92, "e": 332.4, "t": "Wat luister je?"}, {"s": 332.4, "e": 334.64, "t": "Muziek of het nieuws? Ik hou van muziek"}, {"s": 334.64, "e": 335.96, "t": "in de ochtend."}, {"s": 335.96, "e": 338.72, "t": "Mijn woonwerkverkeer is heel anders."}, {"s": 338.72, "e": 341.72, "t": "Hoezo? Ik neem de tram naar kantoor. Het"}, {"s": 341.72, "e": 343.8, "t": "is best druk 's ochtends."}, {"s": 343.8, "e": 345.56, "t": "Dat kan ik me voorstellen. Wanneer kom"}, {"s": 345.56, "e": 347.04, "t": "je aan bij je bureau?"}, {"s": 347.04, "e": 349.88, "t": "Als ik aankom zet ik mijn computer aan."}, {"s": 349.88, "e": 352.36, "t": "Ik doe hetzelfde. Ik kom op kantoor, zeg"}, {"s": 352.36, "e": 354.32, "t": "hallo tegen mijn collega's en zet mijn"}, {"s": 354.32, "e": 355.68, "t": "computer aan."}, {"s": 355.68, "e": 357.48, "t": "Wat is het eerste wat je op je computer"}, {"s": 357.48, "e": 358.56, "t": "doet?"}, {"s": 358.56, "e": 360.48, "t": "Ik check mijn agenda. Ik kijk naar mijn"}, {"s": 360.48, "e": 362.36, "t": "afspraken voor de dag."}, {"s": 362.36, "e": 365.0, "t": "Slim. Ik check mijn agenda ook. Dan"}, {"s": 365.0, "e": 366.84, "t": "check ik mijn e-mails."}, {"s": 366.84, "e": 368.76, "t": "Zoveel e-mails."}, {"s": 368.76, "e": 371.04, "t": "Altijd zoveel. Ik lees ze en beantwoord"}, {"s": 371.04, "e": 373.4, "t": "de belangrijke. Drink jij koffie aan je"}, {"s": 373.4, "e": 374.56, "t": "bureau?"}, {"s": 374.56, "e": 376.44, "t": "Ja, mijn eerste kop koffie is aan mijn"}, {"s": 376.44, "e": 377.52, "t": "bureau."}, {"s": 377.52, "e": 379.56, "t": "Terwijl je een mails leest?"}, {"s": 379.56, "e": 381.64, "t": "Ja, het is een ritueel."}, {"s": 381.64, "e": 384.0, "t": "Ritueel is een mooi woord. Een speciale"}, {"s": 384.0, "e": 386.36, "t": "gewoonte die je elke dag doet."}, {"s": 386.36, "e": 388.84, "t": "Precies. Wat is jouw werkritueel,"}, {"s": 388.84, "e": 390.0, "t": "Melenial?"}, {"s": 390.0, "e": 392.36, "t": "Na mijn e-mails maak ik een lijstje."}, {"s": 392.36, "e": 396.04, "t": "Een T-Do lijstje? Ja, ik schrijf op les"}, {"s": 396.04, "e": 397.6, "t": "voorbereiden,"}, {"s": 397.6, "e": 400.0, "t": "opnemen, studentbellen."}, {"s": 400.0, "e": 401.76, "t": "Heel georganiseerd."}, {"s": 401.76, "e": 403.96, "t": "Het helpt me focussen en dan geef ik"}, {"s": 403.96, "e": 405.48, "t": "mijn eerste les."}, {"s": 405.48, "e": 407.04, "t": "Hoe laat is dat?"}, {"s": 407.04, "e": 409.0, "t": "Om 9:30 's ochtends."}, {"s": 409.0, "e": 410.64, "t": "Wie geef je les?"}, {"s": 410.64, "e": 413.16, "t": "Studenten van over de hele wereld."}, {"s": 413.16, "e": 414.96, "t": "Dat is heel interessant."}, {"s": 414.96, "e": 416.84, "t": "Ja, ze hebben allemaal verschillende"}, {"s": 416.84, "e": 418.24, "t": "routines."}, {"s": 418.24, "e": 419.72, "t": "Echt waar?"}, {"s": 419.72, "e": 422.0, "t": "Ja. Mijn student in Japan wordt heel"}, {"s": 422.0, "e": 424.72, "t": "vroeg wakker. En in Brazilië?"}, {"s": 424.72, "e": 426.88, "t": "Mijn student in Brazilië gaat heel laat"}, {"s": 426.88, "e": 428.4, "t": "naar zijn werk."}, {"s": 428.4, "e": 430.44, "t": "Wauw, de wereld heeft veel verschillende"}, {"s": 430.44, "e": 432.6, "t": "routines. Hoe ziet jouw ochtend op werk"}, {"s": 432.6, "e": 433.68, "t": "eruit?"}, {"s": 433.68, "e": 435.4, "t": "Vergaderingen."}, {"s": 435.4, "e": 436.8, "t": "Vergaderingen?"}, {"s": 436.8, "e": 439.68, "t": "Ja, meestal een vergadering om 10 uur."}, {"s": 439.68, "e": 441.44, "t": "Waar heb je het dan over?"}, {"s": 441.44, "e": 444.16, "t": "Onze projecten. Ik zeg: \"Dit is mijn"}, {"s": 444.16, "e": 445.4, "t": "voortgang.\""}, {"s": 445.4, "e": 447.08, "t": "Dat is een nuttige zin."}, {"s": 447.08, "e": 450.28, "t": "Ik zeg ook: \"Ik heb hierbij hulp nodig.\""}, {"s": 450.28, "e": 452.04, "t": "Heel nuttig voor werk."}, {"s": 452.04, "e": 453.64, "t": "Na de vergadering werk ik op mijn"}, {"s": 453.64, "e": 454.8, "t": "computer."}, {"s": 454.8, "e": 456.16, "t": "Wat doe jij dan?"}, {"s": 456.16, "e": 457.84, "t": "Ik schrijf rapporten."}, {"s": 457.84, "e": 459.96, "t": "Dat klinkt rustig en geconcentreerd."}, {"s": 459.96, "e": 461.88, "t": "Soms is het te stil op mijn werk, dus"}, {"s": 461.88, "e": 463.88, "t": "praat ik met mijn collega Sam."}, {"s": 463.88, "e": 465.8, "t": "Waar praten jullie over?"}, {"s": 465.8, "e": 467.4, "t": "Gewoon een praatje"}, {"s": 467.4, "e": 468.88, "t": "zoals wat"}, {"s": 468.88, "e": 471.6, "t": "ik zeg: \"Hoe was je weekend?\" Of heb je"}, {"s": 471.6, "e": 473.4, "t": "de voetbalwedstrijd gezien?"}, {"s": 473.4, "e": 475.72, "t": "Dat is fijn. Sociale tijd is belangrijk"}, {"s": 475.72, "e": 477.16, "t": "op het werk."}, {"s": 477.16, "e": 479.92, "t": "Ja, dat is het. Dan komt de lunchtijd."}, {"s": 479.92, "e": 481.72, "t": "Hoe laat eet jij lunch?"}, {"s": 481.72, "e": 484.36, "t": "Ik heb honger om 12:30, maar ik eet om 1"}, {"s": 484.36, "e": 485.32, "t": "uur."}, {"s": 485.32, "e": 487.4, "t": "Waarom wacht je tot 1 uur?"}, {"s": 487.4, "e": 490.24, "t": "Omdat de kantine heel druk is om half:"}, {"s": 490.24, "e": 492.2, "t": "Oh, ik snap het."}, {"s": 492.2, "e": 493.64, "t": "Om 1 uur is het rustiger en"}, {"s": 493.64, "e": 495.16, "t": "comfortabeler."}, {"s": 495.16, "e": 497.16, "t": "Dat is slim. Wat is jouw favoriete"}, {"s": 497.16, "e": 498.28, "t": "lunch?"}, {"s": 498.28, "e": 501.12, "t": "Ik hou van een kipsandwich en soep."}, {"s": 501.12, "e": 502.52, "t": "Wat voor soep?"}, {"s": 502.52, "e": 504.08, "t": "Tomatensoep."}, {"s": 504.08, "e": 505.76, "t": "Dat klinkt heel lekker."}, {"s": 505.76, "e": 507.92, "t": "Ik eet ook soms soep. Het is makkelijk"}, {"s": 507.92, "e": 509.2, "t": "om te maken."}, {"s": 509.2, "e": 511.52, "t": "Stop jij met werken tijdens de lunch?"}, {"s": 511.52, "e": 513.36, "t": "Ik probeer te stoppen. Ik zit aan mijn"}, {"s": 513.36, "e": 514.76, "t": "keukentafel."}, {"s": 514.76, "e": 516.56, "t": "Kijk je naar je computer?"}, {"s": 516.56, "e": 518.96, "t": "Nee, ik kijk niet naar mijn computer"}, {"s": 518.96, "e": 520.4, "t": "tijdens de lunch."}, {"s": 520.4, "e": 522.28, "t": "Dat is een goede regel."}, {"s": 522.28, "e": 525.12, "t": "Ja, je hebt een echte pauze nodig."}, {"s": 525.12, "e": 527.28, "t": "Ik eet soms aan mijn bureau."}, {"s": 527.28, "e": 528.8, "t": "Dat is niet zo goed."}, {"s": 528.8, "e": 531.04, "t": "Je hebt gelijk. Na de lunch voel ik me"}, {"s": 531.04, "e": 532.24, "t": "traag."}, {"s": 532.24, "e": 534.24, "t": "Ik ook. Mijn energie is laag in de"}, {"s": 534.24, "e": 535.28, "t": "namiddag."}, {"s": 535.28, "e": 538.48, "t": "De namiddag dip. Ja, die ken ik goed."}, {"s": 538.48, "e": 539.8, "t": "Wat doe jij dan?"}, {"s": 539.8, "e": 541.68, "t": "Ik drink groene thee."}, {"s": 541.68, "e": 543.84, "t": "De geen koffie?"}, {"s": 543.84, "e": 546.28, "t": "Nee, groene thee. Het heeft minder"}, {"s": 546.28, "e": 547.52, "t": "cafeïne."}, {"s": 547.52, "e": 549.68, "t": "Dat is zachter voor je lichaam."}, {"s": 549.68, "e": 550.84, "t": "Precies."}, {"s": 550.84, "e": 552.16, "t": "Misschien ga ik ook groene thee"}, {"s": 552.16, "e": 553.32, "t": "proberen."}, {"s": 553.32, "e": 554.8, "t": "Mijn middag bestaat verder uit"}, {"s": 554.8, "e": 556.4, "t": "computerwerk."}, {"s": 556.4, "e": 558.12, "t": "En vergaderingen?"}, {"s": 558.12, "e": 560.6, "t": "Ja, soms nog een vergadering."}, {"s": 560.6, "e": 562.64, "t": "Hoe laat stop jij met werken?"}, {"s": 562.64, "e": 564.52, "t": "Ik stop om 5 uur."}, {"s": 564.52, "e": 567.08, "t": "Fijn. Ik zet mijn computer uit en zeg"}, {"s": 567.08, "e": 569.08, "t": "gedag tegen mijn collega's."}, {"s": 569.08, "e": 571.08, "t": "Ik stop ook met werken. Ik pak mijn tas"}, {"s": 571.08, "e": 572.12, "t": "in."}, {"s": 572.12, "e": 574.84, "t": "Ja, ik pak mijn tas in en verlaat"}, {"s": 574.84, "e": 576.12, "t": "kantoor."}, {"s": 576.12, "e": 578.0, "t": "Dan begint het avondverkeer."}, {"s": 578.0, "e": 580.16, "t": "Is dat erger dan de ochtend?"}, {"s": 580.16, "e": 583.44, "t": "Ja, veel erger. Er is meer verkeer."}, {"s": 583.44, "e": 585.36, "t": "Wat doe jij op de fiets?"}, {"s": 585.36, "e": 587.52, "t": "Ik luister naar podcasts."}, {"s": 587.52, "e": 589.88, "t": "Dat is een goed idee. Wat voor podcast?"}, {"s": 589.88, "e": 591.48, "t": "Podcasts over wetenschap of"}, {"s": 591.48, "e": 593.32, "t": "geschiedenis. Ik hou ervan om nieuwe"}, {"s": 593.32, "e": 594.6, "t": "dingen te leren."}, {"s": 594.6, "e": 596.52, "t": "Dat vind ik fijn. Je gebruikt je tijd"}, {"s": 596.52, "e": 597.4, "t": "goed."}, {"s": 597.4, "e": 599.52, "t": "En weet je, op regenachtige dagen fiets"}, {"s": 599.52, "e": 601.72, "t": "ik niet. Dan neem ik de bus."}, {"s": 601.72, "e": 603.96, "t": "Dat is slim. Fietsen in de regen is niet"}, {"s": 603.96, "e": 605.4, "t": "altijd fijn."}, {"s": 605.4, "e": 607.56, "t": "Zeker niet. Dan kom ik drijfnat aan op"}, {"s": 607.56, "e": 608.76, "t": "kantoor."}, {"s": 608.76, "e": 610.6, "t": "Dat wil niemand."}, {"s": 610.6, "e": 613.0, "t": "Dus op regenachtige dagen is de bus mijn"}, {"s": 613.0, "e": 614.4, "t": "beste vriend."}, {"s": 614.4, "e": 616.04, "t": "Goed om te weten."}, {"s": 616.04, "e": 617.68, "t": "Dan kom ik thuis."}, {"s": 617.68, "e": 619.72, "t": "Wat doe je eerst thuis?"}, {"s": 619.72, "e": 621.72, "t": "Ik doe de deur open en zeg: \"Ik ben"}, {"s": 621.72, "e": 623.0, "t": "thuis.\""}, {"s": 623.0, "e": 625.12, "t": "Zelfs als er niemand is."}, {"s": 625.12, "e": 627.92, "t": "Ja, het is een gewoonte van vroeger. Dat"}, {"s": 627.92, "e": 629.04, "t": "is leuk."}, {"s": 629.04, "e": 630.68, "t": "Dan zet ik mijn tas neer en doe ik mijn"}, {"s": 630.68, "e": 632.0, "t": "schoenen uit."}, {"s": 632.0, "e": 633.2, "t": "Ik ook."}, {"s": 633.2, "e": 635.8, "t": "Dan trek ik comfortabele kleren aan."}, {"s": 635.8, "e": 637.16, "t": "Heel belangrijk."}, {"s": 637.16, "e": 638.88, "t": "Ik trek mijn spijkerbroek uit en doe een"}, {"s": 638.88, "e": 640.4, "t": "joggingbroek aan."}, {"s": 640.4, "e": 642.2, "t": "Het beste gevoel."}, {"s": 642.2, "e": 644.16, "t": "Dat is het echt. Dan denk je aan het"}, {"s": 644.16, "e": 645.48, "t": "avondeten."}, {"s": 645.48, "e": 648.6, "t": "Ja. Ik vraag mezelf af: moet ik naar de"}, {"s": 648.6, "e": 649.56, "t": "winkel?"}, {"s": 649.56, "e": 651.4, "t": "Ik kijk in de koelkast."}, {"s": 651.4, "e": 653.6, "t": "Ik ook. Ik open de koelkast en kijk"}, {"s": 653.6, "e": 654.6, "t": "erin."}, {"s": 654.6, "e": 656.76, "t": "Je denkt: \"Hebben we groente? Hebben we"}, {"s": 656.76, "e": 658.0, "t": "rijst?\""}, {"s": 658.0, "e": 659.08, "t": "Precies."}, {"s": 659.08, "e": 661.08, "t": "En als je geen eten hebt, maak je een"}, {"s": 661.08, "e": 662.68, "t": "boodschappenlijstje."}, {"s": 662.68, "e": 665.76, "t": "Ja, ik schrijf het op mijn telefoon."}, {"s": 665.76, "e": 667.64, "t": "Zoals melk en uien."}, {"s": 667.64, "e": 670.12, "t": "Ja, dan ga ik naar de supermarkt."}, {"s": 670.12, "e": 671.88, "t": "Wat doe je daar? Ik pak een"}, {"s": 671.88, "e": 673.4, "t": "winkelwagentje en loop door de"}, {"s": 673.4, "e": 674.84, "t": "gangpaden."}, {"s": 674.84, "e": 676.44, "t": "Gangpaden zijn de paden tussen de"}, {"s": 676.44, "e": 677.6, "t": "schappen."}, {"s": 677.6, "e": 679.72, "t": "Precies. Ik loop door de gangpaden en"}, {"s": 679.72, "e": 681.32, "t": "zoek wat ik nodig heb."}, {"s": 681.32, "e": 683.68, "t": "Koop je alleen wat op je lijstje staat?"}, {"s": 683.68, "e": 685.64, "t": "Nee, nooit."}, {"s": 685.64, "e": 687.0, "t": "Waarom niet?"}, {"s": 687.0, "e": 689.08, "t": "Omdat ik chocola zie en dan koop ik"}, {"s": 689.08, "e": 690.36, "t": "chocola."}, {"s": 690.36, "e": 692.36, "t": "Een kleine tractatie?"}, {"s": 692.36, "e": 694.48, "t": "Ja, een kleine tractatie voor na het"}, {"s": 694.48, "e": 695.92, "t": "avondeten."}, {"s": 695.92, "e": 698.08, "t": "Dan ga je naar huis en kook je."}, {"s": 698.08, "e": 700.68, "t": "Ja, ik kook simpel eten"}, {"s": 700.68, "e": 702.0, "t": "zoals wat?"}, {"s": 702.0, "e": 704.56, "t": "Ik kan pasta koken. Ik kan rijst koken"}, {"s": 704.56, "e": 706.4, "t": "met groente en kip."}, {"s": 706.4, "e": 707.8, "t": "Dat is heel goed."}, {"s": 707.8, "e": 709.92, "t": "Ik kook water voor de pasta en snijd de"}, {"s": 709.92, "e": 711.12, "t": "groente."}, {"s": 711.12, "e": 713.84, "t": "Ja, ik snijd ook groente. Soms snijd ik"}, {"s": 713.84, "e": 715.56, "t": "een beetje in mijn vinger."}, {"s": 715.56, "e": 718.84, "t": "Oh nee, wees alsjeblieft voorzichtig."}, {"s": 718.84, "e": 721.24, "t": "Ik ben voorzichtig, maar soms gebeurt"}, {"s": 721.24, "e": 722.04, "t": "het."}, {"s": 722.04, "e": 724.2, "t": "Koken kan gevaarlijk zijn."}, {"s": 724.2, "e": 727.4, "t": "Ja, dan kook ik alles samen in een pan."}, {"s": 727.4, "e": 729.56, "t": "Ik weet zeker dat het heerlijk ruikt."}, {"s": 729.56, "e": 731.36, "t": "En weet je, op zondag kook ik iets"}, {"s": 731.36, "e": 733.12, "t": "groters. Een echte stoofpot"}, {"s": 733.12, "e": 734.48, "t": "bijvoorbeeld."}, {"s": 734.48, "e": 736.48, "t": "Oh, vertel eens meer."}, {"s": 736.48, "e": 738.2, "t": "Ik zet het 's middags op en dan pruttelt"}, {"s": 738.2, "e": 740.4, "t": "het de hele middag. Het hele huis ruikt"}, {"s": 740.4, "e": 741.44, "t": "heerlijk."}, {"s": 741.44, "e": 743.56, "t": "Dat klinkt echt gezellig. Kook je dat"}, {"s": 743.56, "e": 745.44, "t": "samen met iemand?"}, {"s": 745.44, "e": 748.28, "t": "Soms wel, met mijn broer. We koken graag"}, {"s": 748.28, "e": 749.96, "t": "samen op het weekend."}, {"s": 749.96, "e": 751.88, "t": "Dat is een mooie gewoonte."}, {"s": 751.88, "e": 753.52, "t": "En op weekdagen kook ik meestal iets"}, {"s": 753.52, "e": 755.72, "t": "simpels. Geen tijd voor grote gerechten"}, {"s": 755.72, "e": 758.52, "t": "dan. Dat begrijp ik helemaal. Door de"}, {"s": 758.52, "e": 760.28, "t": "weeks moet het snel gaan."}, {"s": 760.28, "e": 762.64, "t": "Precies. Een half uurtje in de keuken,"}, {"s": 762.64, "e": 763.8, "t": "meer niet."}, {"s": 763.8, "e": 765.24, "t": "Ik probeer het weekend altijd te"}, {"s": 765.24, "e": 767.44, "t": "gebruiken om vooruit te koken."}, {"s": 767.44, "e": 770.36, "t": "Vooruit koken? Wat betekent dat?"}, {"s": 770.36, "e": 772.24, "t": "Dat betekent dat ik grote porties maak"}, {"s": 772.24, "e": 774.6, "t": "en ze invries voor de rest van de week."}, {"s": 774.6, "e": 777.0, "t": "Wat een slim idee. Dat scheelt echt tijd"}, {"s": 777.0, "e": 778.28, "t": "door de weeks."}, {"s": 778.28, "e": 780.32, "t": "Precies. Op maandag hoef ik dan alleen"}, {"s": 780.32, "e": 781.96, "t": "maar op te warmen."}, {"s": 781.96, "e": 783.84, "t": "Dat is echt een goede tip. Ik ga dat ook"}, {"s": 783.84, "e": 785.12, "t": "eens proberen."}, {"s": 785.12, "e": 787.28, "t": "Doe dat. Het scheelt je zoveel stress"}, {"s": 787.28, "e": 788.56, "t": "door de weeks."}, {"s": 788.56, "e": 790.32, "t": "En dan heb je 's avonds meer tijd om te"}, {"s": 790.32, "e": 791.52, "t": "ontspannen."}, {"s": 791.52, "e": 793.64, "t": "Precies. Meer tijd voor de dingen die je"}, {"s": 793.64, "e": 795.96, "t": "echt leuk vindt. En dat is precies waar"}, {"s": 795.96, "e": 798.0, "t": "een goede routine voor dient. Elke dag"}, {"s": 798.0, "e": 801.28, "t": "opnieuw. Zonder stress, zonder haast."}, {"s": 801.28, "e": 803.48, "t": "Ik ben er klaar voor. Laten we samen"}, {"s": 803.48, "e": 805.4, "t": "verder gaan met de rest van mijn hele"}, {"s": 805.4, "e": 807.48, "t": "lange drukke avond."}, {"s": 807.48, "e": 809.08, "t": "Zullen we verder gaan met de rest van de"}, {"s": 809.08, "e": 810.8, "t": "avond? Ik ben benieuwd naar wat je"}, {"s": 810.8, "e": 813.6, "t": "daarna nog doet. Echt heel benieuwd."}, {"s": 813.6, "e": 815.96, "t": "Dat hoop ik. Dan eet ik mijn avondet."}, {"s": 815.96, "e": 817.32, "t": "Waar eet je?"}, {"s": 817.32, "e": 819.28, "t": "Meestal voor de televisie."}, {"s": 819.28, "e": 821.68, "t": "Wat kijk je? Het nieuws?"}, {"s": 821.68, "e": 824.4, "t": "Nee, ik kijk een grappige serie."}, {"s": 824.4, "e": 825.8, "t": "Dat is goed."}, {"s": 825.8, "e": 827.72, "t": "Ik moet lachen na het werk."}, {"s": 827.72, "e": 829.24, "t": "Dat begrijp ik."}, {"s": 829.24, "e": 830.36, "t": "En jij?"}, {"s": 830.36, "e": 832.64, "t": "Ik eet aan tafel, maar ik kijk iets op"}, {"s": 832.64, "e": 834.0, "t": "mijn tablet."}, {"s": 834.0, "e": 836.24, "t": "Zelfde idee. Ontspannen en genieten van"}, {"s": 836.24, "e": 837.76, "t": "het avondeten."}, {"s": 837.76, "e": 840.2, "t": "Ja, na het avondeten komt het ergste"}, {"s": 840.2, "e": 841.28, "t": "deel."}, {"s": 841.28, "e": 843.0, "t": "De afwas."}, {"s": 843.0, "e": 844.2, "t": "Ja."}, {"s": 844.2, "e": 846.08, "t": "Ik haat de afwas doen."}, {"s": 846.08, "e": 848.08, "t": "Ik doe de vaatwasser vol."}, {"s": 848.08, "e": 850.36, "t": "Ik heb geen vaatwasser, dus ik was de"}, {"s": 850.36, "e": 853.6, "t": "afwas met de hand. Dat duurt lang."}, {"s": 853.6, "e": 856.16, "t": "Ja, jij was en ik droog."}, {"s": 856.16, "e": 858.64, "t": "Alleen in je dromen, Melenijnen."}, {"s": 858.64, "e": 861.56, "t": "Ja, in mijn dromen. Ik was en droog"}, {"s": 861.56, "e": 862.96, "t": "alles zelf."}, {"s": 862.96, "e": 864.8, "t": "Jij bent een goede vrouw."}, {"s": 864.8, "e": 866.08, "t": "Dank je."}, {"s": 866.08, "e": 868.52, "t": "Daarna is het tijd om te ontspannen."}, {"s": 868.52, "e": 871.24, "t": "Ja, ik ga op de bank zitten."}, {"s": 871.24, "e": 872.68, "t": "Wat doe je dan?"}, {"s": 872.68, "e": 874.64, "t": "Soms bel ik mijn ouders."}, {"s": 874.64, "e": 876.24, "t": "Hoe vaak bel je ze?"}, {"s": 876.24, "e": 878.36, "t": "Ongeveer twee keer per week."}, {"s": 878.36, "e": 879.8, "t": "Wat zeg je dan?"}, {"s": 879.8, "e": 882.76, "t": "Ik zeg: \"Hoi mama, hoe was je dag?\""}, {"s": 882.76, "e": 885.8, "t": "Dat is fijn. Familie is heel belangrijk."}, {"s": 885.8, "e": 887.72, "t": "Ja, dat is het."}, {"s": 887.72, "e": 889.16, "t": "Wat doe je daarna?"}, {"s": 889.16, "e": 890.84, "t": "Misschien speel ik 30 minuten een"}, {"s": 890.84, "e": 891.76, "t": "videospel."}, {"s": 891.76, "e": 893.28, "t": "Of je leest"}, {"s": 893.28, "e": 895.64, "t": "Ja, soms lees ik."}, {"s": 895.64, "e": 896.84, "t": "Wat lees je nu?"}, {"s": 896.84, "e": 899.68, "t": "Een detective boek. Het is spannend."}, {"s": 899.68, "e": 901.04, "t": "Mooie keuze."}, {"s": 901.04, "e": 903.12, "t": "Dan begint de avondroutine."}, {"s": 903.12, "e": 904.6, "t": "Hoe laat is dat?"}, {"s": 904.6, "e": 906.36, "t": "Rond 10 uur 's avonds begin ik aan"}, {"s": 906.36, "e": 908.0, "t": "slapen te denken."}, {"s": 908.0, "e": 910.0, "t": "Neem je 's avonds een douche?"}, {"s": 910.0, "e": 911.8, "t": "Soms, maar meestal douche ik 's"}, {"s": 911.8, "e": 913.0, "t": "ochtends."}, {"s": 913.0, "e": 914.96, "t": "Ik neem een warme douche 's avonds. Het"}, {"s": 914.96, "e": 917.0, "t": "helpt me ontspannen en slapen."}, {"s": 917.0, "e": 918.48, "t": "Dat klinkt fijn."}, {"s": 918.48, "e": 920.6, "t": "Dan poets je je tanden weer"}, {"s": 920.6, "e": 922.76, "t": "natuurlijk. Ik poets elke avond mijn"}, {"s": 922.76, "e": 923.92, "t": "tanden."}, {"s": 923.92, "e": 925.24, "t": "Flos je?"}, {"s": 925.24, "e": 927.96, "t": "Ja, ik flos mijn tanden. Het is heel"}, {"s": 927.96, "e": 929.36, "t": "belangrijk."}, {"s": 929.36, "e": 932.36, "t": "Oh vossen, ik vergeet het altijd."}, {"s": 932.36, "e": 934.6, "t": "Proberen te onthouden, Hans."}, {"s": 934.6, "e": 936.6, "t": "Oké, ik zal het proberen. Dan doe ik"}, {"s": 936.6, "e": 937.96, "t": "huidverzorging."}, {"s": 937.96, "e": 939.6, "t": "Huidverzorging?"}, {"s": 939.6, "e": 941.6, "t": "Ja, ik doe lotion op mijn gezicht en"}, {"s": 941.6, "e": 942.56, "t": "handen."}, {"s": 942.56, "e": 944.28, "t": "Ik ga gewoon naar bed."}, {"s": 944.28, "e": 945.88, "t": "Dat is ook oké."}, {"s": 945.88, "e": 947.48, "t": "Dan zet ik mijn wekker voor de volgende"}, {"s": 947.48, "e": 948.44, "t": "dag."}, {"s": 948.44, "e": 950.2, "t": "Hoe laat zet jij hem?"}, {"s": 950.2, "e": 952.52, "t": "Ik zet mijn wekker op 6:30."}, {"s": 952.52, "e": 953.96, "t": "Dat is vroeg."}, {"s": 953.96, "e": 957.52, "t": "Ja, maar ik wil hem op 7 uur veranderen."}, {"s": 957.52, "e": 960.12, "t": "Goed idee. Meer slaap is goed."}, {"s": 960.12, "e": 961.76, "t": "Dan stap ik in bed."}, {"s": 961.76, "e": 963.4, "t": "Lees je in bed?"}, {"s": 963.4, "e": 966.56, "t": "Nee, ik kijk op mijn telefoon."}, {"s": 966.56, "e": 969.64, "t": "Oh nee, dat is een slechte gewoonte."}, {"s": 969.64, "e": 972.24, "t": "Ik weet het. Het is niet goed."}, {"s": 972.24, "e": 974.12, "t": "Probeer in plaats daarvan je boek te"}, {"s": 974.12, "e": 975.04, "t": "lezen."}, {"s": 975.04, "e": 977.08, "t": "Hey, ik zal het proberen. Jij bent een"}, {"s": 977.08, "e": 978.56, "t": "goede invloed."}, {"s": 978.56, "e": 981.24, "t": "Dank je. Wat doe jij voor het slapen? Ik"}, {"s": 981.24, "e": 983.28, "t": "lees ongeveer 20 minuten"}, {"s": 983.28, "e": 984.44, "t": "en dan"}, {"s": 984.44, "e": 986.28, "t": "dan doe ik het licht uit."}, {"s": 986.28, "e": 988.32, "t": "Zeg je wel te rusten?"}, {"s": 988.32, "e": 991.08, "t": "Ja, ik zeg wel te rusten tegen jou"}, {"s": 991.08, "e": 992.8, "t": "in je gedachten."}, {"s": 992.8, "e": 995.12, "t": "Ja, in mijn gedachten."}, {"s": 995.12, "e": 998.24, "t": "Wel te rusten Melanie. Slaap lekker."}, {"s": 998.24, "e": 1001.44, "t": "Wel te rusten Hans. Slaap lekker."}, {"s": 1001.44, "e": 1003.4, "t": "En dan vallen we in slaap."}, {"s": 1003.4, "e": 1005.32, "t": "En de routine begint weer de volgende"}, {"s": 1005.32, "e": 1006.24, "t": "dag."}, {"s": 1006.24, "e": 1007.92, "t": "Het is een kringloop."}, {"s": 1007.92, "e": 1009.64, "t": "Een goede kringloop."}, {"s": 1009.64, "e": 1012.32, "t": "Ja. Routines zijn niet saai."}, {"s": 1012.32, "e": 1014.28, "t": "Ze geven ons structuur."}, {"s": 1014.28, "e": 1016.0, "t": "Ze geven ons tijd voor belangrijke"}, {"s": 1016.0, "e": 1016.96, "t": "dingen."}, {"s": 1016.96, "e": 1019.24, "t": "Zoals ontbijten bij het raam."}, {"s": 1019.24, "e": 1021.0, "t": "Zoals je familie bellen,"}, {"s": 1021.0, "e": 1023.56, "t": "zoals Nederlands leren met ons."}, {"s": 1023.56, "e": 1024.76, "t": "Precies."}, {"s": 1024.76, "e": 1026.28, "t": "Nu gaan we een aantal nuttige korte"}, {"s": 1026.28, "e": 1028.28, "t": "zinnen oefenen in de volgorde van een"}, {"s": 1028.28, "e": 1029.56, "t": "hele dag."}, {"s": 1029.56, "e": 1031.0, "t": "Ik word wakker."}, {"s": 1031.0, "e": 1032.84, "t": "Ik zet mijn wekker uit."}, {"s": 1032.84, "e": 1034.6, "t": "Ik blijf nog even liggen."}, {"s": 1034.6, "e": 1036.12, "t": "Ik sta op."}, {"s": 1036.12, "e": 1038.32, "t": "Ik maak mijn bed op. Ik loop naar de"}, {"s": 1038.32, "e": 1039.64, "t": "badkamer."}, {"s": 1039.64, "e": 1041.4, "t": "Ik poets mijn tanden."}, {"s": 1041.4, "e": 1043.2, "t": "Ik was mijn gezicht."}, {"s": 1043.2, "e": 1044.6, "t": "Ik neem een douche."}, {"s": 1044.6, "e": 1046.36, "t": "Ik droog mijn haar."}, {"s": 1046.36, "e": 1047.88, "t": "Ik kleed me aan."}, {"s": 1047.88, "e": 1049.44, "t": "Ik maak ontbijt."}, {"s": 1049.44, "e": 1051.12, "t": "Ik eet ontbijt."}, {"s": 1051.12, "e": 1052.52, "t": "Ik drink koffie."}, {"s": 1052.52, "e": 1054.12, "t": "Ik lees het nieuws."}, {"s": 1054.12, "e": 1055.88, "t": "Ik verlaat het huis."}, {"s": 1055.88, "e": 1057.68, "t": "Ik doe de deur op slot."}, {"s": 1057.68, "e": 1059.4, "t": "Ik fiets naar mijn werk."}, {"s": 1059.4, "e": 1061.24, "t": "Ik kom aan op kantoor."}, {"s": 1061.24, "e": 1063.72, "t": "Ik zet mijn computer aan. Ik check mijn"}, {"s": 1063.72, "e": 1065.08, "t": "e-mails."}, {"s": 1065.08, "e": 1066.88, "t": "Ik heb een vergadering."}, {"s": 1066.88, "e": 1068.76, "t": "Ik werk aan een project."}, {"s": 1068.76, "e": 1070.24, "t": "Ik neem een pauze."}, {"s": 1070.24, "e": 1071.52, "t": "Ik eet lunch."}, {"s": 1071.52, "e": 1073.04, "t": "Ik werk verder."}, {"s": 1073.04, "e": 1074.72, "t": "Ik stop met werken."}, {"s": 1074.72, "e": 1076.36, "t": "Ik pak mijn tas in."}, {"s": 1076.36, "e": 1077.84, "t": "Ik ga naar huis."}, {"s": 1077.84, "e": 1079.28, "t": "Ik kom thuis."}, {"s": 1079.28, "e": 1081.32, "t": "Ik verander van kleren."}, {"s": 1081.32, "e": 1083.28, "t": "Ik kook avondeten."}, {"s": 1083.28, "e": 1085.12, "t": "Ik eet avondeting."}, {"s": 1085.12, "e": 1086.68, "t": "Ik doe de afwas."}, {"s": 1086.68, "e": 1088.6, "t": "Ik ontspan op de bank."}, {"s": 1088.6, "e": 1090.92, "t": "Ik lees een boek. Ik poets mijn tanden"}, {"s": 1090.92, "e": 1091.88, "t": "weer."}, {"s": 1091.88, "e": 1093.4, "t": "Ik zet mijn wekker."}, {"s": 1093.4, "e": 1094.68, "t": "Ik ga naar bed."}, {"s": 1094.68, "e": 1096.48, "t": "Ik val in slaap."}, {"s": 1096.48, "e": 1098.28, "t": "Perfect. Dat is een hele dag in het"}, {"s": 1098.28, "e": 1099.64, "t": "Nederlands."}, {"s": 1099.64, "e": 1101.36, "t": "Nu gaan we een paar belangrijke woorden"}, {"s": 1101.36, "e": 1104.04, "t": "dieper bekijken. Deze woorden hoor en"}, {"s": 1104.04, "e": 1105.96, "t": "gebruik je constant."}, {"s": 1105.96, "e": 1107.92, "t": "Laten we beginnen. Wat is het eerste"}, {"s": 1107.92, "e": 1108.8, "t": "woord?"}, {"s": 1108.8, "e": 1111.12, "t": "Routine. Het betekent de gewone dingen"}, {"s": 1111.12, "e": 1113.28, "t": "die je elke dag doet. Vaak in dezelfde"}, {"s": 1113.28, "e": 1114.56, "t": "volgorde."}, {"s": 1114.56, "e": 1117.4, "t": "Bijvoorbeeld mijn ochtendroutine is ik"}, {"s": 1117.4, "e": 1119.68, "t": "word wakker. Ik poets mijn tanden en ik"}, {"s": 1119.68, "e": 1120.96, "t": "maak koffie."}, {"s": 1120.96, "e": 1123.8, "t": "Precies. Woord twee ontspannen. Het"}, {"s": 1123.8, "e": 1126.8, "t": "betekent rusten, je kalm voelen."}, {"s": 1126.8, "e": 1129.12, "t": "Bijvoorbeeld: Na het werk ontspan ik op"}, {"s": 1129.12, "e": 1130.28, "t": "de bank."}, {"s": 1130.28, "e": 1133.08, "t": "Woord drie, boodschappen. Dit betekent"}, {"s": 1133.08, "e": 1134.96, "t": "eten en andere dingen die je koopt bij"}, {"s": 1134.96, "e": 1136.24, "t": "de supermarkt,"}, {"s": 1136.24, "e": 1139.92, "t": "zoals melk, brood, fruit en groente."}, {"s": 1139.92, "e": 1142.6, "t": "Woord vier, woonwerkverkeer."}, {"s": 1142.6, "e": 1144.72, "t": "Dit is je dagelijkse reis naar werk en"}, {"s": 1144.72, "e": 1146.84, "t": "terug. Bijvoorbeeld: \"Mijn"}, {"s": 1146.84, "e": 1148.88, "t": "woonwerkverkeer is 20 minuten met de"}, {"s": 1148.88, "e": 1149.8, "t": "fiets.\""}, {"s": 1149.8, "e": 1152.84, "t": "Woord 5: gewoonte. Iets wat je steeds"}, {"s": 1152.84, "e": 1155.08, "t": "opnieuw doet, vaak zonder erover na te"}, {"s": 1155.08, "e": 1156.12, "t": "denken."}, {"s": 1156.12, "e": 1158.08, "t": "Gewoontes kunnen goed of slecht zijn."}, {"s": 1158.08, "e": 1160.36, "t": "Tanden poetsen is een goede gewoonte."}, {"s": 1160.36, "e": 1163.0, "t": "Woord zes, uitstellen. Dit betekent iets"}, {"s": 1163.0, "e": 1164.48, "t": "later doen, zoals wanneer je de"}, {"s": 1164.48, "e": 1166.0, "t": "snozenknop indrukt."}, {"s": 1166.0, "e": 1167.92, "t": "Ik stel het opstaan graag 10 minuutjes"}, {"s": 1167.92, "e": 1168.92, "t": "uit."}, {"s": 1168.92, "e": 1172.6, "t": "Woord z klusjes. Kleine taken buiten het"}, {"s": 1172.6, "e": 1174.72, "t": "huis, zoals naar de bank of de apotheek"}, {"s": 1174.72, "e": 1175.68, "t": "gaan."}, {"s": 1175.68, "e": 1178.16, "t": "Op zaterdag doe ik altijd mijn klusjes."}, {"s": 1178.16, "e": 1181.08, "t": "Woord 8: essentieel. Het betekent heel"}, {"s": 1181.08, "e": 1183.56, "t": "belangrijk, noodzakelijk."}, {"s": 1183.56, "e": 1186.2, "t": "Water is essentieel voor het leven."}, {"s": 1186.2, "e": 1189.36, "t": "Woord 9: fris. Het kan schoon en koel"}, {"s": 1189.36, "e": 1191.44, "t": "betekenen of nieuw."}, {"s": 1191.44, "e": 1192.96, "t": "Na het wassen van mijn gezicht voel ik"}, {"s": 1192.96, "e": 1194.24, "t": "me fris."}, {"s": 1194.24, "e": 1196.76, "t": "En het laatste woord opgeruimd. Het"}, {"s": 1196.76, "e": 1199.72, "t": "betekent netjes en georganiseerd."}, {"s": 1199.72, "e": 1201.28, "t": "Ik maak mijn bed op om mijn kamer"}, {"s": 1201.28, "e": 1202.96, "t": "opgeruimd te houden."}, {"s": 1202.96, "e": 1205.28, "t": "En nu onze vraag van de dag."}, {"s": 1205.28, "e": 1207.2, "t": "Welk deel van jouw dagelijkse routine"}, {"s": 1207.2, "e": 1208.8, "t": "geniet je het meest van?"}, {"s": 1208.8, "e": 1211.12, "t": "Bijvoorbeeld: \"Ik geniet echt van mijn"}, {"s": 1211.12, "e": 1213.16, "t": "eerste kopje koffie in de ochtend.\""}, {"s": 1213.16, "e": 1214.92, "t": "En ik geniet van mijn avondwandeling."}, {"s": 1214.92, "e": 1217.32, "t": "Het helpt me nadenken en ontspannen."}, {"s": 1217.32, "e": 1219.72, "t": "Dus nu is het jouw beurt. Welk deel van"}, {"s": 1219.72, "e": 1221.36, "t": "je dag geniet je van?"}, {"s": 1221.36, "e": 1223.76, "t": "Is het je ontbijt? Is het praten met een"}, {"s": 1223.76, "e": 1224.84, "t": "vriend?"}, {"s": 1224.84, "e": 1226.36, "t": "Schrijf je antwoord in de reacties"}, {"s": 1226.36, "e": 1229.6, "t": "hieronder. We lezen echt elke reactie."}, {"s": 1229.6, "e": 1231.08, "t": "Druk op het duimpje omhoog als je dit"}, {"s": 1231.08, "e": 1233.08, "t": "leuk vond. Abonneer je op Melanie Dutch"}, {"s": 1233.08, "e": 1235.28, "t": "podcast als je dat nog niet hebt gedaan."}, {"s": 1235.28, "e": 1237.44, "t": "We maken elke week nieuwe video's, dus"}, {"s": 1237.44, "e": 1239.44, "t": "je kunt met ons blijven leren."}, {"s": 1239.44, "e": 1241.2, "t": "Bedankt voor het kijken en luisteren"}, {"s": 1241.2, "e": 1242.28, "t": "vandaag."}, {"s": 1242.28, "e": 1244.72, "t": "Tot de volgende keer. Tot dan."}, {"s": 1244.72, "e": 1247.28, "t": "Blijf praten, blijf leren en blijf"}, {"s": 1247.28, "e": 1249.92, "t": "groeien. En vergeet niet, elke dag telt"}, {"s": 1249.92, "e": 1253.48, "t": "echt. Dag iedereen."}]