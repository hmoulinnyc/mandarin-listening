[{"s": 0.2, "e": 2.28, "t": "Hoi allemaal."}, {"s": 2.28, "e": 6.48, "t": "Ik ben weer terug in de verbouwkamer."}, {"s": 6.48, "e": 10.92, "t": "Ik ben Noelle en ik maak video's over"}, {"s": 10.92, "e": 15.2, "t": "dingen in mijn leven in het Nederlands,"}, {"s": 15.2, "e": 18.88, "t": "zodat jij ook Nederlands kan leren."}, {"s": 18.88, "e": 25.12, "t": "En vandaag net als de andere verbouwv."}, {"s": 25.12, "e": 29.44, "t": "Ik weet niet waar het is. Hier denk ik"}, {"s": 29.44, "e": 31.76, "t": "wil ik jullie nog meer spullen laten"}, {"s": 31.76, "e": 34.8, "t": "zien die wij gebruiken voor het"}, {"s": 34.8, "e": 38.92, "t": "verbouwen, voor het renoveren van onze"}, {"s": 38.92, "e": 40.76, "t": "kamer."}, {"s": 40.76, "e": 45.28, "t": "Maar deze keer kleine dingen zoals al"}, {"s": 45.28, "e": 49.8, "t": "deze spullen. Als eerste heb ik hier een"}, {"s": 49.8, "e": 52.04, "t": "kwast."}, {"s": 52.04, "e": 58.84, "t": "Dit is een ronde kwast. Kijk, rond."}, {"s": 58.84, "e": 61.48, "t": "Goed voor hoekjes"}, {"s": 61.48, "e": 65.24, "t": "en kleine stukjes."}, {"s": 65.24, "e": 70.16, "t": "En hij is blauw met een houten"}, {"s": 71.16, "e": 73.4, "t": "houten houder misschien ook wel, want"}, {"s": 73.4, "e": 76.36, "t": "hier houd je het vast."}, {"s": 76.36, "e": 81.6, "t": "En dit gebruik je voor verven of lakken."}, {"s": 81.6, "e": 85.72, "t": "Lakken doe je op hout en verf op andere"}, {"s": 85.72, "e": 89.52, "t": "dingen zoals een muur."}, {"s": 89.52, "e": 92.56, "t": "Een muur verven."}, {"s": 92.56, "e": 96.72, "t": "En hout doe je op een houten deur zoals"}, {"s": 96.72, "e": 103.08, "t": "deze deur of de omlijsting van de deur."}, {"s": 103.08, "e": 105.44, "t": "Ja, dat is wel mooi zo. Kijk, dan ben ik"}, {"s": 105.44, "e": 108.48, "t": "het aan het verven."}, {"s": 108.48, "e": 111.0, "t": "Zo."}, {"s": 111.0, "e": 114.4, "t": "En deze is ongebruikt. Deze hebben wij"}, {"s": 114.4, "e": 117.84, "t": "nog niet gebruikt voor verven,"}, {"s": 117.84, "e": 122.64, "t": "maar volgens mij wel voor wat anders."}, {"s": 123.08, "e": 126.52, "t": "Ik weet niet waarvoor."}, {"s": 126.52, "e": 131.08, "t": "Dit is een kwast. Als tweede"}, {"s": 131.08, "e": 133.8, "t": "heb ik een doekje."}, {"s": 133.8, "e": 137.28, "t": "Een doekje is heel handig voor heel veel"}, {"s": 137.28, "e": 140.8, "t": "verschillende dingen. Meestal gebruik je"}, {"s": 140.8, "e": 142.92, "t": "het voor schoonmaken."}, {"s": 142.92, "e": 145.48, "t": "Voor het schoonmaken van iets dat vies"}, {"s": 145.48, "e": 150.08, "t": "is geworden of waar stof op zit."}, {"s": 150.08, "e": 152.76, "t": "Bijvoorbeeld door het schuren."}, {"s": 152.76, "e": 155.6, "t": "Jij weet wat schuren is als je de andere"}, {"s": 155.6, "e": 158.64, "t": "video hebt gezien. Dan is er allemaal"}, {"s": 158.64, "e": 162.4, "t": "stof. En met een doekje kun je dan het"}, {"s": 162.4, "e": 165.08, "t": "stof weghalen."}, {"s": 165.08, "e": 168.64, "t": "Weghalen van plekken."}, {"s": 168.64, "e": 171.92, "t": "En ook dit doekje is blauw. Heel veel"}, {"s": 171.92, "e": 173.52, "t": "blauw"}, {"s": 173.52, "e": 177.08, "t": "en geel. De rand"}, {"s": 177.08, "e": 179.12, "t": "is geel"}, {"s": 179.12, "e": 182.96, "t": "en deze is heel zacht."}, {"s": 182.96, "e": 187.88, "t": "Als derde heb ik een spatel"}, {"s": 187.88, "e": 191.12, "t": "of een plamuurmes."}, {"s": 191.12, "e": 194.4, "t": "Dat is een moeilijke naam, maar dit"}, {"s": 194.4, "e": 197.12, "t": "gebruik je voor plamuren."}, {"s": 197.12, "e": 200.64, "t": "Voor het vullen van gaatjes."}, {"s": 200.64, "e": 203.0, "t": "Gaatjes"}, {"s": 203.0, "e": 206.04, "t": "in muren bijvoorbeeld."}, {"s": 206.04, "e": 210.72, "t": "In deze muren zaten wat gaatjes, maar nu"}, {"s": 210.72, "e": 214.72, "t": "niet meer, want ze zijn gevuld met"}, {"s": 214.72, "e": 218.68, "t": "plamuur en een plamuurmes"}, {"s": 218.68, "e": 221.88, "t": "om het glad te maken."}, {"s": 221.88, "e": 227.28, "t": "Niet hobbelig, maar glad gehad."}, {"s": 227.28, "e": 230.44, "t": "door het plamuurmes. Zo."}, {"s": 230.44, "e": 234.6, "t": "En ook deze heeft een houten handvat"}, {"s": 234.6, "e": 236.84, "t": "waar je het vasthoudt."}, {"s": 236.84, "e": 240.28, "t": "Oh. En een gat om het op te hangen aan"}, {"s": 240.28, "e": 243.88, "t": "een spijker. Zo aan de muur. Zo."}, {"s": 243.88, "e": 247.08, "t": "Als je het opbergt."}, {"s": 247.08, "e": 250.96, "t": "Ja. Als vierde"}, {"s": 250.96, "e": 253.8, "t": "hebben we dit."}, {"s": 253.8, "e": 257.68, "t": "Dit ziet er raar uit. Wat is dit?"}, {"s": 257.68, "e": 261.32, "t": "Even openmaken."}, {"s": 261.32, "e": 263.24, "t": "Oh, hier."}, {"s": 263.24, "e": 265.56, "t": "Dit is een mes,"}, {"s": 265.56, "e": 268.12, "t": "maar niet een plammuurmes."}, {"s": 268.12, "e": 271.24, "t": "Dit gebruik je om te snijden,"}, {"s": 271.24, "e": 274.52, "t": "om verpakkingen, om spullen open te"}, {"s": 274.52, "e": 279.76, "t": "maken of om stukken af te snijden."}, {"s": 279.76, "e": 283.44, "t": "En dit heet een Stanley mes."}, {"s": 283.44, "e": 287.04, "t": "Het is niet van het merk Stanley,"}, {"s": 287.04, "e": 290.4, "t": "maar misschien het origineel wel."}, {"s": 290.4, "e": 293.12, "t": "Maar het heet een Stanley mes. Dat is"}, {"s": 293.12, "e": 298.08, "t": "een mes dat je kan opbergen zo."}, {"s": 298.48, "e": 301.44, "t": "En dan is het niet meer scherp. Ah,"}, {"s": 301.44, "e": 305.36, "t": "scherp. Nee, dat is het niet."}, {"s": 305.36, "e": 310.08, "t": "Maar wel als ik zo doe."}, {"s": 311.04, "e": 314.48, "t": "Zo. Nu is het veilig."}, {"s": 314.48, "e": 318.52, "t": "En je kunt stukjes, Kijk,"}, {"s": 318.52, "e": 321.28, "t": "zie je deze"}, {"s": 321.28, "e": 323.96, "t": "lijntjes?"}, {"s": 323.96, "e": 327.68, "t": "Als het mes bot is, dus niet meer"}, {"s": 327.68, "e": 329.32, "t": "scherp,"}, {"s": 329.32, "e": 334.12, "t": "dan kun je een stuk afbreken"}, {"s": 334.12, "e": 337.6, "t": "en dan heb je weer een scherp stukje."}, {"s": 337.6, "e": 342.44, "t": "Dus een stuk dat goed snijdt."}, {"s": 342.68, "e": 344.68, "t": "En dit Stanly"}, {"s": 344.68, "e": 348.2, "t": "is rood met zwart."}, {"s": 348.2, "e": 350.84, "t": "Het rode stim."}, {"s": 350.84, "e": 354.28, "t": "Als vifde"}, {"s": 354.48, "e": 358.04, "t": "hebben we dit gereedschap."}, {"s": 358.04, "e": 360.36, "t": "Dit ken je vast wel."}, {"s": 360.36, "e": 364.04, "t": "Dit is een schroevendraaier"}, {"s": 364.12, "e": 366.8, "t": "om schroeven"}, {"s": 366.8, "e": 370.4, "t": "in iets te draaien."}, {"s": 370.4, "e": 373.08, "t": "Zo, dit is een lange schroevendraaier."}, {"s": 373.08, "e": 378.28, "t": "Een grote met een platte kop. Kijk, het"}, {"s": 378.28, "e": 382.64, "t": "is een minnetje. Een minnetje."}, {"s": 382.72, "e": 388.64, "t": "Niet een kruisje, maar een minnetje."}, {"s": 388.72, "e": 393.96, "t": "Wij hebben ook een kruiskop."}, {"s": 394.24, "e": 399.4, "t": "Ik ga even zoeken. Ja, kijk,"}, {"s": 399.4, "e": 403.16, "t": "hier is een kruiskop."}, {"s": 404.84, "e": 408.48, "t": "En dit is een platte."}, {"s": 408.48, "e": 411.32, "t": "Zie je het?"}, {"s": 411.32, "e": 413.2, "t": "Minnetje"}, {"s": 413.2, "e": 416.2, "t": "kruis."}, {"s": 417.12, "e": 420.68, "t": "Allebei schroevendraaiers."}, {"s": 420.68, "e": 425.92, "t": "Kijk, deze is langer dan deze."}, {"s": 426.68, "e": 429.56, "t": "Een langere schroevendraaier."}, {"s": 429.56, "e": 432.88, "t": "Een kortere schroevendraaier"}, {"s": 432.88, "e": 436.88, "t": "in het rood met geel."}, {"s": 436.88, "e": 439.84, "t": "Rood met geel."}, {"s": 439.84, "e": 442.04, "t": "Als zese"}, {"s": 442.04, "e": 446.48, "t": "heb ik iets heel bekends."}, {"s": 447.72, "e": 450.12, "t": "Dat is een pen."}, {"s": 450.12, "e": 452.84, "t": "Dan denk je een pen, dat is toch niet"}, {"s": 452.84, "e": 454.44, "t": "bijzonder."}, {"s": 454.44, "e": 457.16, "t": "Dat gebruik ik ook om te schrijven op"}, {"s": 457.16, "e": 461.04, "t": "papier of in een boekje."}, {"s": 461.04, "e": 463.96, "t": "Maar een pen is heel belangrijk, want je"}, {"s": 463.96, "e": 466.8, "t": "moet ook kunnen markeren"}, {"s": 466.8, "e": 470.24, "t": "of snel dingen opschrijven."}, {"s": 470.24, "e": 473.28, "t": "Bijvoorbeeld afmetingen"}, {"s": 473.28, "e": 477.16, "t": "of dingen die je hebt gemeten."}, {"s": 477.16, "e": 481.72, "t": "Of als je het later niet ziet, gewoon op"}, {"s": 481.72, "e": 483.56, "t": "de muur."}, {"s": 483.56, "e": 486.48, "t": "Als je eroverheen gaat verven is dat"}, {"s": 486.48, "e": 490.4, "t": "oké. Maar is heel belangrijk."}, {"s": 490.4, "e": 495.04, "t": "Anders maak je iets te kort of te lang"}, {"s": 495.04, "e": 498.56, "t": "of vergeet je informatie."}, {"s": 498.56, "e": 501.0, "t": "Dus een pen"}, {"s": 501.0, "e": 503.96, "t": "is heel belangrijk."}, {"s": 503.96, "e": 507.44, "t": "En deze is roze."}, {"s": 507.44, "e": 509.31, "t": "Roze met papierbruin."}, {"s": 512.12, "e": 514.44, "t": "Fuxia heet het ook wel."}, {"s": 514.44, "e": 517.72, "t": "zo velroze."}, {"s": 518.24, "e": 521.88, "t": "Als zevende"}, {"s": 522.84, "e": 526.36, "t": "heb ik een tang."}, {"s": 526.36, "e": 530.72, "t": "Dit heet ook wel een knijptang."}, {"s": 530.72, "e": 534.0, "t": "En je kunt ook hier dingen mee knippen"}, {"s": 534.0, "e": 537.28, "t": "of een dus een kniptang."}, {"s": 537.28, "e": 540.56, "t": "Dus deze is multifunctioneel."}, {"s": 540.56, "e": 544.8, "t": "Het heeft meerdere functies."}, {"s": 545.28, "e": 549.48, "t": "een tang om dingen mee dicht te knijpen"}, {"s": 549.48, "e": 555.4, "t": "of af te knippen of te verplaatsen."}, {"s": 557.32, "e": 561.84, "t": "Dat daarvoor gebruik je het denk ik."}, {"s": 561.84, "e": 566.12, "t": "En deze is ook rood. Heel veel rood en"}, {"s": 566.12, "e": 567.88, "t": "blauw"}, {"s": 567.88, "e": 571.76, "t": "en geel. Dat is wel interessant. En dan"}, {"s": 571.76, "e": 574.32, "t": "als laatste"}, {"s": 574.32, "e": 576.88, "t": "als achtste"}, {"s": 576.88, "e": 578.44, "t": "ding"}, {"s": 578.44, "e": 581.44, "t": "artikel"}, {"s": 581.76, "e": 584.04, "t": "dit."}, {"s": 584.04, "e": 586.36, "t": "Dan denk je: \"Wat is dit?"}, {"s": 586.36, "e": 589.92, "t": "Dit is een afstandsmeter."}, {"s": 589.92, "e": 594.68, "t": "Afstand is de lengte tussen iets."}, {"s": 594.68, "e": 596.6, "t": "Bijvoorbeeld"}, {"s": 596.6, "e": 600.24, "t": "tussen muren. Deze muur en deze muur."}, {"s": 600.24, "e": 604.24, "t": "Niet helemaal deze muur en die muur."}, {"s": 604.24, "e": 609.8, "t": "Verschillende muren of het plafond."}, {"s": 609.8, "e": 613.04, "t": "het plafond"}, {"s": 613.64, "e": 617.04, "t": "en de vloer."}, {"s": 618.24, "e": 622.52, "t": "En deze heeft een laser."}, {"s": 623.8, "e": 627.56, "t": "Een laser. Die heeft een laser om dat te"}, {"s": 627.56, "e": 630.0, "t": "meten."}, {"s": 630.0, "e": 634.04, "t": "En nu is hij uit."}, {"s": 634.04, "e": 637.36, "t": "Maar zo staat hij aan."}, {"s": 637.36, "e": 640.28, "t": "En met nog een keer klikken op de knop,"}, {"s": 640.28, "e": 643.16, "t": "nog een keer drukken."}, {"s": 643.16, "e": 647.68, "t": "Gaat hij dan meten? Ja. Kijk,"}, {"s": 647.68, "e": 652.48, "t": "zie je dat nou? Nou, zie je het niet?"}, {"s": 652.48, "e": 657.04, "t": "De laser zie je niet op de camera."}, {"s": 657.04, "e": 658.68, "t": "Zo is die klaar."}, {"s": 658.68, "e": 661.68, "t": "En dan staat hier 1,"}, {"s": 661.68, "e": 663.44, "t": "300"}, {"s": 663.44, "e": 666.44, "t": "16m."}, {"s": 666.48, "e": 671.68, "t": "Dus 1m en 3 31,6"}, {"s": 671.68, "e": 673.56, "t": "cm"}, {"s": 673.56, "e": 675.76, "t": "of"}, {"s": 675.76, "e": 677.76, "t": "131"}, {"s": 677.76, "e": 682.52, "t": "cm en 6mm."}, {"s": 682.64, "e": 686.84, "t": "Oh nee. Oké, ik stop hier."}, {"s": 686.84, "e": 691.56, "t": "Zo. En zo klik ik hem uit. Maak ik zet"}, {"s": 691.56, "e": 697.44, "t": "ik hem uit. Zo, nu is hij uitgezet."}, {"s": 698.0, "e": 701.56, "t": "En deze heeft een polsbandje. Zo kun je"}, {"s": 701.56, "e": 706.36, "t": "zo lopen met je afstandsmeter."}, {"s": 707.48, "e": 710.88, "t": "Ja, helemaal goed."}, {"s": 710.88, "e": 714.84, "t": "Nou, dat was het laatste ding. Dat was"}, {"s": 714.84, "e": 717.2, "t": "het laatste ding dat wij gebruiken voor"}, {"s": 717.2, "e": 719.76, "t": "verbouwen. Niet het laatste ding, maar"}, {"s": 719.76, "e": 723.44, "t": "het laatste ding dat ik nu laat zien. En"}, {"s": 723.44, "e": 726.04, "t": "ik vraag mij af, heb jij ook deze"}, {"s": 726.04, "e": 729.32, "t": "dingen? Heb jij een afstandsmeter,"}, {"s": 729.32, "e": 731.64, "t": "een schroevendraaier,"}, {"s": 731.64, "e": 735.52, "t": "een doekje? Ik denk dat wel. Ben"}, {"s": 735.52, "e": 737.72, "t": "benieuwd. Laat je het me weten in de"}, {"s": 737.72, "e": 739.6, "t": "opmerkingen"}, {"s": 739.6, "e": 745.44, "t": "en dan tot de volgende keer. Doeg. Doeg."}]