[{"s": 0.44, "e": 4.8, "t": "Hoi allemaal, ik ben Noelle."}, {"s": 4.8, "e": 6.72, "t": "Vandaag"}, {"s": 6.72, "e": 8.24, "t": "gaan"}, {"s": 8.24, "e": 12.32, "t": "wij of ik"}, {"s": 12.32, "e": 15.32, "t": "maten."}, {"s": 15.72, "e": 18.0, "t": "Ik drink"}, {"s": 18.0, "e": 21.04, "t": "heel graag matja."}, {"s": 21.04, "e": 26.6, "t": "Ik vind dat heel lekker. Heel lekker."}, {"s": 26.6, "e": 32.96, "t": "En ik ga jullie laten zien hoe"}, {"s": 32.96, "e": 38.52, "t": "hoe je dat maakt."}, {"s": 38.52, "e": 43.44, "t": "Wat heb je nodig voor Matja?"}, {"s": 43.44, "e": 46.76, "t": "Een paar dingen."}, {"s": 46.76, "e": 49.64, "t": "Deze dingen."}, {"s": 49.64, "e": 51.76, "t": "Als eerste"}, {"s": 51.76, "e": 54.72, "t": "een kommetje"}, {"s": 54.72, "e": 58.28, "t": "om de matcha"}, {"s": 60.96, "e": 63.96, "t": "gebruik"}, {"s": 66.44, "e": 72.4, "t": "ook ook voor drinken."}, {"s": 72.4, "e": 77.04, "t": "Dat vind ik handig en fijn."}, {"s": 77.36, "e": 79.96, "t": "Als tweede"}, {"s": 79.96, "e": 82.68, "t": "een maa"}, {"s": 82.68, "e": 87.92, "t": "bamboe klopper of garden."}, {"s": 87.92, "e": 92.16, "t": "Dat klinkt een beetje chic,"}, {"s": 92.16, "e": 97.96, "t": "maar hiermee klop je en meng je"}, {"s": 97.96, "e": 101.24, "t": "de matcha."}, {"s": 102.72, "e": 108.4, "t": "Ik laat het je straks zien."}, {"s": 109.04, "e": 114.08, "t": "Deze is voor Matja gemaakt"}, {"s": 114.08, "e": 116.6, "t": "van bamboe."}, {"s": 116.6, "e": 119.76, "t": "Bambo is een plant."}, {"s": 119.76, "e": 125.04, "t": "Maar als je van bakken houdt, bakken van"}, {"s": 125.04, "e": 126.6, "t": "koekjes"}, {"s": 126.6, "e": 129.56, "t": "en cupcakes"}, {"s": 129.56, "e": 134.32, "t": "en taarten, dan gebruik je ook vaak een"}, {"s": 134.32, "e": 136.92, "t": "garde."}, {"s": 136.92, "e": 142.92, "t": "Dat is dit. Dit is een andere"}, {"s": 142.92, "e": 145.4, "t": "garde"}, {"s": 145.4, "e": 151.6, "t": "of de normale garde voor bakken. Kijk,"}, {"s": 151.6, "e": 154.12, "t": "allebei een garde,"}, {"s": 154.12, "e": 157.92, "t": "maar dit is voor matje en dit is voor"}, {"s": 157.92, "e": 159.44, "t": "bakken."}, {"s": 159.44, "e": 162.92, "t": "Als volgende heb je nodig, als derde"}, {"s": 162.92, "e": 165.2, "t": "ding"}, {"s": 165.2, "e": 168.24, "t": "een lepel."}, {"s": 168.24, "e": 175.2, "t": "Dit ziet er niet uit als een lepel. Toch"}, {"s": 175.2, "e": 178.56, "t": "niet een normale lepel."}, {"s": 178.56, "e": 182.12, "t": "Want dit"}, {"s": 182.12, "e": 186.44, "t": "is een normale lepel."}, {"s": 187.2, "e": 190.96, "t": "Dit is een theelepeltje, dus een klein"}, {"s": 190.96, "e": 193.4, "t": "lepeltje."}, {"s": 193.4, "e": 197.8, "t": "En dit is een maa lepel."}, {"s": 197.8, "e": 202.12, "t": "Deze is gemaakt ook van bamboe, van een"}, {"s": 202.12, "e": 203.72, "t": "plant."}, {"s": 203.72, "e": 208.56, "t": "En deze is gemaakt van metaal."}, {"s": 208.56, "e": 212.32, "t": "Kijk, metaal"}, {"s": 213.44, "e": 216.8, "t": "en bumble."}, {"s": 217.4, "e": 220.2, "t": "Net als"}, {"s": 220.2, "e": 224.72, "t": "de garde of de klopper."}, {"s": 225.56, "e": 229.4, "t": "Maar deze gebruik ik"}, {"s": 229.4, "e": 232.88, "t": "om de macha poeder in het kommetje te"}, {"s": 232.88, "e": 235.48, "t": "doen."}, {"s": 235.48, "e": 238.48, "t": "Dit kommetje."}, {"s": 238.48, "e": 242.92, "t": "Als vierde ding heb ik nodig"}, {"s": 242.92, "e": 245.4, "t": "macha poeder,"}, {"s": 245.4, "e": 249.16, "t": "want we gaan macha maken."}, {"s": 249.16, "e": 252.2, "t": "Dit is macha poeder."}, {"s": 252.2, "e": 255.6, "t": "En dit is Macha poeder."}, {"s": 255.6, "e": 258.84, "t": "Hier in een zakje"}, {"s": 258.84, "e": 263.48, "t": "die open is. Kijk, open."}, {"s": 263.48, "e": 267.44, "t": "Ik zal het laten zien."}, {"s": 270.12, "e": 272.24, "t": "Macha poeder."}, {"s": 272.24, "e": 276.12, "t": "Het is echt poeder."}, {"s": 276.12, "e": 278.52, "t": "Zie je dat?"}, {"s": 278.52, "e": 283.88, "t": "Het is niet vast, maar een poeder."}, {"s": 284.8, "e": 287.76, "t": "En ook"}, {"s": 287.76, "e": 291.84, "t": "in dit blikje,"}, {"s": 292.64, "e": 297.44, "t": "dit is een blikje, zit ook ma van een"}, {"s": 297.44, "e": 303.08, "t": "ander merk. Een ander merk of"}, {"s": 303.08, "e": 305.48, "t": "merk"}, {"s": 305.48, "e": 308.88, "t": "ander bedrijf."}, {"s": 309.4, "e": 315.08, "t": "Daar zit ook poeder in hierin."}, {"s": 317.64, "e": 324.28, "t": "Maar vandaag ga ik deze gebruiken."}, {"s": 324.96, "e": 327.08, "t": "Nu dicht,"}, {"s": 327.08, "e": 330.96, "t": "zodat het goed blijft."}, {"s": 330.96, "e": 335.8, "t": "En dan als laatste, dat is een optie."}, {"s": 335.8, "e": 339.52, "t": "Dat hoef je niet te doen. Dat is niet"}, {"s": 339.52, "e": 341.96, "t": "noodzakelijk."}, {"s": 341.96, "e": 347.8, "t": "is melk voor een maa late. Ik gebruik"}, {"s": 347.8, "e": 354.08, "t": "sojamelk ervoor gemaakt van sojabonen."}, {"s": 354.08, "e": 356.92, "t": "Deze"}, {"s": 356.92, "e": 361.2, "t": "maar ook vind ik lekker havermelk"}, {"s": 361.2, "e": 363.64, "t": "of kokosmelk"}, {"s": 363.64, "e": 365.28, "t": "of"}, {"s": 365.28, "e": 367.08, "t": "amandelmelk."}, {"s": 367.08, "e": 372.88, "t": "Ja, maar vandaag gebruik ik sojamelk"}, {"s": 372.88, "e": 378.16, "t": "en dan wordt het wat zachter, wat"}, {"s": 378.16, "e": 379.8, "t": "romiger"}, {"s": 379.8, "e": 382.76, "t": "omdat ik er sojamelk"}, {"s": 382.76, "e": 384.8, "t": "bij doe."}, {"s": 384.8, "e": 387.72, "t": "Als allerlaatste"}, {"s": 387.72, "e": 389.96, "t": "hebben we nodig"}, {"s": 389.96, "e": 391.72, "t": "water,"}, {"s": 391.72, "e": 394.8, "t": "want dat gebruiken we om de macha te"}, {"s": 394.8, "e": 400.8, "t": "maken. Ik gebruik een waterkoker."}, {"s": 400.8, "e": 406.32, "t": "Dat heb ik dus dat gebruik ik."}, {"s": 406.52, "e": 408.48, "t": "deze waterkoker."}, {"s": 408.48, "e": 411.16, "t": "En deze waterkoker"}, {"s": 411.16, "e": 417.08, "t": "kan ik instellen instellen plupatuur."}, {"s": 418.24, "e": 421.52, "t": "Dus hoeveel graden ik het water wil"}, {"s": 421.52, "e": 423.76, "t": "laten worden."}, {"s": 423.76, "e": 425.36, "t": "bijvoorbeeld"}, {"s": 425.36, "e": 427.2, "t": "60°"}, {"s": 427.2, "e": 429.92, "t": "of 70°,"}, {"s": 429.92, "e": 432.08, "t": "80°,"}, {"s": 432.08, "e": 434.2, "t": "90°"}, {"s": 434.2, "e": 437.6, "t": "of 100."}, {"s": 437.64, "e": 443.56, "t": "Volgens mij is voor Matja ongeveer 80°"}, {"s": 443.56, "e": 446.44, "t": "het beste."}, {"s": 446.44, "e": 451.64, "t": "Dus ik ga het water opwarmen straks voor"}, {"s": 451.64, "e": 455.4, "t": "80° naar 80°."}, {"s": 455.4, "e": 461.56, "t": "Oké, we gaan nu de matcha maken. Maken."}, {"s": 461.56, "e": 467.72, "t": "Als eerste stap pak ik de macha poeder."}, {"s": 469.52, "e": 471.24, "t": "de poeder"}, {"s": 471.24, "e": 474.8, "t": "met het lepeltje"}, {"s": 476.8, "e": 483.04, "t": "en pak ik een beetje eruit."}, {"s": 483.04, "e": 485.28, "t": "Zoveel ongeveer."}, {"s": 485.28, "e": 488.0, "t": "Ongeveer zoveel."}, {"s": 488.0, "e": 491.8, "t": "Dit is misschien een beetje veel. Ik ga"}, {"s": 491.8, "e": 494.0, "t": "wat minder"}, {"s": 494.0, "e": 497.12, "t": "doen. Zoveel."}, {"s": 497.12, "e": 501.04, "t": "zoveel macha poeder."}, {"s": 501.04, "e": 507.84, "t": "En dan doe ik dat in het kommetje."}, {"s": 514.36, "e": 519.32, "t": "Nu is het in dit kommetje de macha"}, {"s": 519.32, "e": 522.32, "t": "poeder."}, {"s": 522.92, "e": 528.08, "t": "Misschien een klein beetje meer."}, {"s": 532.84, "e": 535.72, "t": "Zoveel extra."}, {"s": 535.72, "e": 539.0, "t": "Kijk, zoveel."}, {"s": 544.96, "e": 551.52, "t": "Dus nu heb ik deze hoeveelheid"}, {"s": 551.52, "e": 554.92, "t": "macha poeder."}, {"s": 555.88, "e": 560.28, "t": "Dan doe ik het zakje dicht."}, {"s": 561.76, "e": 564.76, "t": "Zo."}, {"s": 565.16, "e": 568.6, "t": "En ben ik klaar met de poeder."}, {"s": 568.6, "e": 573.32, "t": "Als volgende stap pak ik de garde, de"}, {"s": 573.32, "e": 578.92, "t": "klopper en verdeel ik de macha poeder"}, {"s": 578.92, "e": 581.12, "t": "een beetje."}, {"s": 581.12, "e": 584.12, "t": "Kijken of ik het kan laten zien."}, {"s": 584.12, "e": 588.32, "t": "Ik doe een beetje zo,"}, {"s": 592.04, "e": 595.48, "t": "zodat het een beetje"}, {"s": 595.48, "e": 598.96, "t": "opgedeeld wordt in kleinere"}, {"s": 598.96, "e": 600.68, "t": "kleinere"}, {"s": 600.68, "e": 603.68, "t": "stukjes."}, {"s": 603.88, "e": 607.36, "t": "Want ik heb geen kleine"}, {"s": 607.36, "e": 611.84, "t": "zeef. Ik heb geen kleine zeef om dit te"}, {"s": 611.84, "e": 616.56, "t": "doen. Dus ik stamp"}, {"s": 618.32, "e": 623.04, "t": "de poeder. Voor mij werkt het."}, {"s": 623.04, "e": 626.36, "t": "Zo. Kijk, zie je? Het is al meer"}, {"s": 626.36, "e": 631.0, "t": "verdeeld verdeeld over het kommetje en"}, {"s": 631.0, "e": 635.44, "t": "in kleinere stukjes."}, {"s": 635.44, "e": 639.36, "t": "Ik denk dat het werkt."}, {"s": 641.56, "e": 647.04, "t": "En dan ga ik het water opwarmen in de"}, {"s": 647.04, "e": 648.56, "t": "waterkoker"}, {"s": 648.56, "e": 653.0, "t": "op 80°."}, {"s": 658.48, "e": 662.2, "t": "Dan moet ik wachten."}, {"s": 669.0, "e": 672.84, "t": "Oké, de waterkoker is klaar."}, {"s": 672.84, "e": 677.0, "t": "Dus nu pak ik de waterkoker en doe een"}, {"s": 677.0, "e": 681.88, "t": "beetje water bij de macha poeder"}, {"s": 681.88, "e": 685.56, "t": "in het kommetje."}, {"s": 694.8, "e": 698.68, "t": "Niet heel veel. Ongeveer"}, {"s": 698.68, "e": 701.6, "t": "eerst ongeveer"}, {"s": 701.6, "e": 704.6, "t": "zoveel."}, {"s": 705.96, "e": 709.64, "t": "Zoveel zoveel. Kun je het zien? Nee."}, {"s": 709.64, "e": 714.24, "t": "Zoveel. Zoveel. Zoveel."}, {"s": 717.04, "e": 720.12, "t": "Niet heel veel."}, {"s": 720.12, "e": 724.4, "t": "En dan pak ik de klopper en ga het"}, {"s": 724.4, "e": 729.72, "t": "mengen mixen in het water."}, {"s": 730.2, "e": 735.68, "t": "Dus ga ik het eerst zo roeren."}, {"s": 745.16, "e": 747.48, "t": "roeren"}, {"s": 747.48, "e": 751.44, "t": "en naar links roeren. Dus eerst naar"}, {"s": 751.44, "e": 753.32, "t": "rechts."}, {"s": 753.32, "e": 758.12, "t": "Rechts roeren met de klok mee en dan"}, {"s": 758.12, "e": 760.96, "t": "naar links roeren"}, {"s": 760.96, "e": 765.08, "t": "tegen de klok in."}, {"s": 766.92, "e": 772.64, "t": "En dan ziet het er zo uit."}, {"s": 780.48, "e": 783.0, "t": "Heel groen."}, {"s": 783.0, "e": 788.88, "t": "En dan gaan we zo heen en weer heen en"}, {"s": 788.88, "e": 790.52, "t": "weer"}, {"s": 790.52, "e": 793.8, "t": "het kloppen."}, {"s": 797.8, "e": 800.32, "t": "Pardon."}, {"s": 800.32, "e": 802.68, "t": "Ik zet het neer"}, {"s": 802.68, "e": 805.68, "t": "zo."}, {"s": 807.36, "e": 812.0, "t": "Zodat er schuim op komt."}, {"s": 814.44, "e": 817.44, "t": "Zo,"}, {"s": 818.64, "e": 821.64, "t": "klaar."}, {"s": 823.28, "e": 826.72, "t": "Zo zie je het schuim"}, {"s": 826.72, "e": 829.84, "t": "allemaal schuim erop."}, {"s": 829.84, "e": 834.36, "t": "En dit kan je al drinken."}, {"s": 834.36, "e": 840.56, "t": "Zo. Maar vandaag ga ik sojamelk"}, {"s": 840.56, "e": 843.4, "t": "erbij doen"}, {"s": 843.4, "e": 846.92, "t": "voor matja lating. Dus dat ga ik even"}, {"s": 846.92, "e": 850.6, "t": "schudden. D zodat dit goed gemengd is."}, {"s": 850.6, "e": 856.8, "t": "Ook gemengd en geen laagjes heeft."}, {"s": 858.12, "e": 861.44, "t": "Zo, geschud."}, {"s": 861.44, "e": 865.32, "t": "En dan maak ik het open"}, {"s": 865.32, "e": 870.2, "t": "en doe een beetje erbij."}, {"s": 872.16, "e": 873.76, "t": "Zo."}, {"s": 873.76, "e": 876.76, "t": "Kijk."}, {"s": 879.2, "e": 880.96, "t": "Zo."}, {"s": 880.96, "e": 885.68, "t": "En ook dit meng."}, {"s": 890.32, "e": 894.36, "t": "En dan heb ik machaat."}, {"s": 894.36, "e": 897.36, "t": "Dit ga ik even afspoelen"}, {"s": 897.36, "e": 900.88, "t": "in het water."}, {"s": 913.32, "e": 917.52, "t": "En dat moet dan drogen"}, {"s": 917.52, "e": 920.52, "t": "hierop"}, {"s": 920.6, "e": 925.36, "t": "op de houder. Dus dat het de vorm"}, {"s": 925.36, "e": 931.6, "t": "behoudt. Dat het deze vorm blijft."}, {"s": 931.6, "e": 935.6, "t": "Dat kan hier. Oké,"}, {"s": 935.6, "e": 938.72, "t": "nu is de macha"}, {"s": 938.72, "e": 942.84, "t": "klaar en kan ik het drinken. Dus dat ga"}, {"s": 942.84, "e": 946.36, "t": "ik nu doen."}, {"s": 950.08, "e": 953.44, "t": "Nou, wel goed."}, {"s": 959.6, "e": 962.8, "t": "Goede matje."}, {"s": 964.84, "e": 970.36, "t": "Zo, op. Helemaal op. Het was niet heel"}, {"s": 970.36, "e": 973.52, "t": "veel, het was een beetje, want ik heb"}, {"s": 973.52, "e": 977.52, "t": "een beetje gemaakt."}, {"s": 978.04, "e": 981.64, "t": "Dan kan ik nu alles terugzetten waar het"}, {"s": 981.64, "e": 984.64, "t": "hoort."}, {"s": 988.88, "e": 990.72, "t": "De macha"}, {"s": 990.72, "e": 996.68, "t": "de macha poeder moet in de koelkast,"}, {"s": 1002.92, "e": 1006.08, "t": "zodat het goed blijft."}, {"s": 1006.08, "e": 1010.4, "t": "En dan kan dit in de vaatwasser straks"}, {"s": 1010.4, "e": 1013.68, "t": "waar het schoon wordt gemaakt."}, {"s": 1013.68, "e": 1015.52, "t": "Oké."}, {"s": 1015.52, "e": 1019.68, "t": "En dan ben ik klaar."}, {"s": 1019.68, "e": 1022.08, "t": "Ik ben benieuwd."}, {"s": 1022.08, "e": 1027.0, "t": "Drink jij ook Matja? Vind je het ook"}, {"s": 1027.0, "e": 1031.4, "t": "lekker of goed voor je gezondheid"}, {"s": 1031.4, "e": 1033.28, "t": "of niet?"}, {"s": 1033.28, "e": 1039.08, "t": "En maak je het dan thuis zoals ik of"}, {"s": 1039.08, "e": 1043.36, "t": "koop je het buiten de deur in een café"}, {"s": 1043.36, "e": 1048.44, "t": "of een maa winkeltje?"}, {"s": 1048.44, "e": 1052.12, "t": "Ik hoor het heel graag. Laat je het"}, {"s": 1052.12, "e": 1054.88, "t": "weten in de opmerkingen?"}, {"s": 1054.88, "e": 1058.92, "t": "En dan voor nu tot de volgende keer."}, {"s": 1058.92, "e": 1062.28, "t": "Doeg. Doeg."}]