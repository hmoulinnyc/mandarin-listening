754.08, "e": 755.96, "t": "het theekopje."}, {"s": 755.96, "e": 759.32, "t": "Dus in de rechterbovenhoek"}, {"s": 759.32, "e": 763.72, "t": "hoek. Zie je het? Rechtsboven."}, {"s": 765.92, "e": 769.8, "t": "Ik denk ook rondom deze dat we iets"}, {"s": 769.8, "e": 772.68, "t": "moeten toevoegen."}, {"s": 772.68, "e": 776.44, "t": "Misschien deze."}, {"s": 776.76, "e": 779.76, "t": "Ja."}, {"s": 787.84, "e": 791.64, "t": "Ah ja, hier. Zo."}, {"s": 793.28, "e": 799.8, "t": "Deze is links onder deze sticker geplakt"}, {"s": 799.8, "e": 803.48, "t": "in de linkeronderhoek."}, {"s": 804.64, "e": 808.68, "t": "Kijk, dit begint al beter te worden."}, {"s": 808.68, "e": 812.2, "t": "Wat hebben we hier?"}, {"s": 812.2, "e": 815.32, "t": "Oh mijn"}, {"s": 817.68, "e": 820.68, "t": "h"}, {"s": 828.44, "e": 831.44, "t": "plakken"}, {"s": 838.68, "e": 840.52, "t": "met het"}, {"s": 840.52, "e": 844.8, "t": "Konijntje denk ik met hangoortjes. Ze"}, {"s": 844.8, "e": 846.56, "t": "hangen"}, {"s": 846.56, "e": 848.72, "t": "net als de aardbeien."}, {"s": 848.72, "e": 852.56, "t": "Die hangen ook."}, {"s": 857.84, "e": 862.48, "t": "Hm. Ietsjes omhoog misschien."}, {"s": 862.48, "e": 865.48, "t": "Zo."}, {"s": 869.64, "e": 874.2, "t": "Nee, ik haal hem eraf"}, {"s": 880.48, "e": 884.32, "t": "en plak hem opnieuw."}, {"s": 890.2, "e": 893.28, "t": "Hier zo misschien."}, {"s": 893.52, "e": 897.04, "t": "Ja, dat is wat beter."}, {"s": 897.04, "e": 900.56, "t": "Dat is wat beter."}, {"s": 901.68, "e": 904.8, "t": "En dan En dan misschien"}, {"s": 904.8, "e": 908.48, "t": "moeten we één van de kleine stickers nu"}, {"s": 908.48, "e": 910.48, "t": "plakken."}, {"s": 910.48, "e": 914.56, "t": "Bijvoorbeeld deze. Is dat een idee?"}, {"s": 914.56, "e": 917.56, "t": "kijken."}, {"s": 933.04, "e": 936.32, "t": "Hier zo."}, {"s": 939.16, "e": 943.12, "t": "Beetje rechts."}, {"s": 943.12, "e": 948.84, "t": "Een beetje rechts boven deze sticker."}, {"s": 949.2, "e": 951.92, "t": "Deze aardbeesticker."}, {"s": 951.92, "e": 955.16, "t": "Oh kijk, er zijn ook allemaal blaadjes."}, {"s": 955.16, "e": 959.12, "t": "Die ga ik straks pakken."}, {"s": 964.16, "e": 968.12, "t": "Hm. Hm. Ik denk dat ik deze ook wil"}, {"s": 968.12, "e": 971.12, "t": "plakken."}, {"s": 975.6, "e": 977.84, "t": "Maar waar?"}, {"s": 977.84, "e": 980.6, "t": "Hier. Zo of hier? Oh ja, hier. Hier zo"}, {"s": 980.6, "e": 983.84, "t": "denk ik."}, {"s": 988.32, "e": 991.4, "t": "Oh, die is een beetje scheef."}, {"s": 991.4, "e": 994.72, "t": "Je moet opnieuw."}, {"s": 1004.16, "e": 1006.04, "t": "Zo."}, {"s": 1006.04, "e": 1010.48, "t": "Boven deze sticker."}, {"s": 1012.76, "e": 1016.08, "t": "Ja. En dan en dan"}, {"s": 1016.08, "e": 1018.32, "t": "eh"}, {"s": 1018.32, "e": 1021.68, "t": "één van deze. Nee."}, {"s": 1021.68, "e": 1026.0, "t": "Nou misschien wel. Even kijken."}, {"s": 1029.8, "e": 1032.04, "t": "Nee,"}, {"s": 1032.04, "e": 1037.44, "t": "hier deze mee. Was net niet."}, {"s": 1049.4, "e": 1054.72, "t": "Misschien deze hier links op het papier"}, {"s": 1054.72, "e": 1056.88, "t": "en de linkermidden"}, {"s": 1056.88, "e": 1060.8, "t": "hoek. Nou, hoek links in het midden."}, {"s": 1060.8, "e": 1062.36, "t": "Kijk, zie je?"}, {"s": 1062.36, "e": 1065.36, "t": "Misschien is dat wel mooi."}, {"s": 1091.64, "e": 1092.48, "t": "Ja."}, {"s": 1092.48, "e": 1094.36, "t": "Ja. En dan hier nog een blaadje"}, {"s": 1094.36, "e": 1097.24, "t": "misschien"}, {"s": 1097.24, "e": 1099.96, "t": "of een bloemetje. Ja, een bloemetje denk"}, {"s": 1099.96, "e": 1102.96, "t": "ik."}, {"s": 1106.24, "e": 1109.36, "t": "Dit bloemetje."}, {"s": 1111.72, "e": 1117.04, "t": "Zo. Precies. Tussen tussen deze drie"}, {"s": 1117.04, "e": 1120.04, "t": "stickers."}, {"s": 1121.56, "e": 1124.52, "t": "Oké, dat is het denk ik even. Ik ga het"}, {"s": 1124.52, "e": 1127.6, "t": "de rest afmaken en dan laat ik het zien"}, {"s": 1127.6, "e": 1131.08, "t": "hoe het is geworden."}, {"s": 1131.08, "e": 1134.84, "t": "Zo, het boekje is klaar. De voorkant van"}, {"s": 1134.84, "e": 1137.68, "t": "het boekje."}, {"s": 1137.68, "e": 1142.08, "t": "Ik heb het gevuld met allemaal stickers"}, {"s": 1142.08, "e": 1145.0, "t": "van links naar rechts, van boven naar"}, {"s": 1145.0, "e": 1147.28, "t": "onder."}, {"s": 1147.28, "e": 1149.96, "t": "En nu is die klaar."}, {"s": 1149.96, "e": 1155.2, "t": "Ik zal het van dichterbij laten zien."}, {"s": 1156.32, "e": 1159.24, "t": "met diertjes"}, {"s": 1159.24, "e": 1163.48, "t": "en de bloemetjes en de aardbeien"}, {"s": 1163.48, "e": 1166.24, "t": "en de blaadjes,"}, {"s": 1166.24, "e": 1170.56, "t": "de gem, het theekopje"}, {"s": 1170.56, "e": 1174.2, "t": "en deze krans."}, {"s": 1174.56, "e": 1178.32, "t": "Oh en nog een poesje."}, {"s": 1179.44, "e": 1181.8, "t": "En een strikje."}, {"s": 1181.8, "e": 1185.36, "t": "En een roos zie ik ook."}, {"s": 1185.36, "e": 1187.96, "t": "Nu is die klaar. Kijken hoe het eruit"}, {"s": 1187.96, "e": 1191.28, "t": "ziet als die dicht is."}, {"s": 1191.28, "e": 1194.64, "t": "Oh, kijk wat leuk."}, {"s": 1194.64, "e": 1198.0, "t": "Nou, mijn doel is behaald. Ik heb een"}, {"s": 1198.0, "e": 1202.16, "t": "notitieboekje zelf ontworpen."}, {"s": 1202.16, "e": 1206.12, "t": "Misschien doe ik ook de achterkant."}, {"s": 1206.12, "e": 1208.88, "t": "We gaan het zien."}, {"s": 1208.88, "e": 1211.96, "t": "Ik ben heel blij. Jee,"}, {"s": 1211.96, "e": 1214.76, "t": "ik ben heel blij."}, {"s": 1214.76, "e": 1217.0, "t": "Wat fijn."}, {"s": 1217.0, "e": 1219.8, "t": "Nou, ik hoop dat jullie dit leuk vonden"}, {"s": 1219.8, "e": 1224.08, "t": "en wat hebben geleerd over richtingen en"}, {"s": 1224.08, "e": 1227.56, "t": "gedeeltes van een stuk papier en"}, {"s": 1227.56, "e": 1230.12, "t": "stickers."}, {"s": 1230.12, "e": 1234.24, "t": "En dan tot de volgende keer. Doei."}]