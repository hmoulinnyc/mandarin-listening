[{"s": 0.0, "e": 3.82, "t": "Dag allemaal, en welkom terug bij Melanie Dutch"}, {"s": 3.82, "e": 6.1, "t": "Podcast! Ik ben Melanie."}, {"s": 6.1, "e": 8.1, "t": "En ik ben Hans. Sorry,"}, {"s": 8.1, "e": 10.6, "t": "ik ben een beetje buiten adem."}, {"s": 10.6, "e": 13.79, "t": "Dat zie ik. Wat is er gebeurd?"}, {"s": 13.79, "e": 15.75, "t": "Ik heb mijn trein gemist."}, {"s": 15.75, "e": 17.71, "t": "Ik zag hem nog wegrijden."}, {"s": 17.71, "e": 18.79, "t": "O nee."}, {"s": 18.79, "e": 22.11, "t": "Dan past ons onderwerp vandaag perfect."}, {"s": 22.11, "e": 24.43, "t": "Het openbaar vervoer."}, {"s": 24.43, "e": 28.63, "t": "Ja. De trein, de bus en de tram."}, {"s": 28.63, "e": 30.32, "t": "In Nederland gebruik"}, {"s": 30.32, "e": 32.12, "t": "je het bijna elke dag."}, {"s": 32.12, "e": 34.83, "t": "Maar het is niet altijd makkelijk."}, {"s": 34.83, "e": 37.84, "t": "Nee. Je moet inchecken, uitchecken,"}, {"s": 37.84, "e": 39.44, "t": "overstappen..."}, {"s": 39.44, "e": 41.49, "t": "En de omroep op het station"}, {"s": 41.49, "e": 43.65, "t": "is vaak moeilijk te verstaan."}, {"s": 43.65, "e": 46.45, "t": "Ik versta zelf ook niet alles."}, {"s": 46.45, "e": 49.11, "t": "Daarom oefenen we vandaag tachtig"}, {"s": 49.11, "e": 51.77, "t": "zinnen voor het openbaar vervoer."}, {"s": 51.77, "e": 53.63, "t": "Van je planning thuis"}, {"s": 53.63, "e": 55.49, "t": "tot de laatste halte."}, {"s": 55.49, "e": 57.97, "t": "Leer je graag Nederlands met ons?"}, {"s": 57.98, "e": 60.29, "t": "Abonneer je dan op het kanaal."}, {"s": 60.29, "e": 62.48, "t": "En geef deze video een like."}, {"s": 62.48, "e": 64.2, "t": "Dat helpt ons enorm."}, {"s": 64.2, "e": 66.42, "t": "Na deze aflevering kun je de"}, {"s": 66.42, "e": 68.52, "t": "weg vragen op het station."}, {"s": 68.52, "e": 70.17, "t": "En je weet wat je moet"}, {"s": 70.17, "e": 71.72, "t": "doen bij vertraging."}, {"s": 71.72, "e": 74.28, "t": "Hans, waar wilde je eigenlijk naartoe"}, {"s": 74.28, "e": 75.43, "t": "vanochtend?"}, {"s": 75.43, "e": 76.85, "t": "Naar Utrecht."}, {"s": 76.85, "e": 79.44, "t": "Ik had een afspraak om tien uur."}, {"s": 79.44, "e": 81.66, "t": "En hoe laat ging je trein?"}, {"s": 81.66, "e": 83.88, "t": "Om tien over negen."}, {"s": 83.88, "e": 86.19, "t": "Had je de reis niet gepland?"}, {"s": 86.19, "e": 89.39, "t": "Jawel. Ik keek gisteren al in de app."}, {"s": 89.39, "e": 91.18, "t": "In de NS-app?"}, {"s": 91.18, "e": 93.13, "t": "Ja. Of 9292."}, {"s": 93.13, "e": 97.38, "t": "Die gebruik ik voor de bus en de tram."}, {"s": 97.38, "e": 99.9, "t": "Wat vraag je dan aan de app?"}, {"s": 99.9, "e": 102.7, "t": "Hoe laat gaat de trein naar Utrecht?"}, {"s": 102.7, "e": 105.5, "t": "En de app geeft je een paar opties."}, {"s": 105.5, "e": 109.1, "t": "Precies. Ik kies meestal de snelste."}, {"s": 109.1, "e": 111.09, "t": "Moest je overstappen?"}, {"s": 111.09, "e": 114.48, "t": "Nee, het was een rechtstreekse trein."}, {"s": 114.48, "e": 116.26, "t": "Rechtstreeks betekent:"}, {"s": 116.26, "e": 118.49, "t": "je hoeft niet over te stappen."}, {"s": 118.49, "e": 120.37, "t": "Dat vind ik het fijnst."}, {"s": 120.37, "e": 122.31, "t": "Ik stap niet graag over."}, {"s": 122.31, "e": 123.9, "t": "Waarom niet?"}, {"s": 123.9, "e": 126.61, "t": "Dan moet ik rennen naar een ander spoor."}, {"s": 126.61, "e": 129.02, "t": "En jij rent niet graag."}, {"s": 129.02, "e": 132.31, "t": "Vanochtend wel. Maar het hielp niet."}, {"s": 132.31, "e": 135.21, "t": "Hoe lang duurt de reis naar Utrecht?"}, {"s": 135.21, "e": 137.43, "t": "Ongeveer een half uur."}, {"s": 137.43, "e": 139.03, "t": "Dat valt mee."}, {"s": 139.03, "e": 141.83, "t": "Ja, als ik de trein haal."}, {"s": 141.83, "e": 143.9, "t": "Ik kijk altijd ook naar de"}, {"s": 143.9, "e": 146.43, "t": "vertrektijd van de volgende trein."}, {"s": 146.43, "e": 149.53, "t": "Slim. Voor als je de eerste mist."}, {"s": 149.53, "e": 152.48, "t": "Precies. Dan weet je: geen stress,"}, {"s": 152.48, "e": 154.43, "t": "er komt er nog één."}, {"s": 154.43, "e": 157.27, "t": "Tussen grote steden rijdt er vaak elke"}, {"s": 157.27, "e": 159.94, "t": "tien of vijftien minuten een trein."}, {"s": 159.94, "e": 162.15, "t": "Dus je hoefde niet te rennen."}, {"s": 162.15, "e": 164.27, "t": "Dat wist ik toen nog niet."}, {"s": 164.27, "e": 166.75, "t": "Goed. Je bent op het station."}, {"s": 166.75, "e": 168.47, "t": "Wat doe je eerst?"}, {"s": 168.47, "e": 169.09, "t": "Inchecken."}, {"s": 169.09, "e": 171.2, "t": "Hoe check jij in?"}, {"s": 171.2, "e": 173.01, "t": "Met mijn bankpas."}, {"s": 173.01, "e": 175.81, "t": "Ik houd hem tegen de kaartlezer."}, {"s": 175.81, "e": 177.81, "t": "Je hoort een piepje en je"}, {"s": 177.81, "e": 179.63, "t": "ziet een groen lampje."}, {"s": 179.63, "e": 182.23, "t": "Dan weet je: het is gelukt."}, {"s": 182.23, "e": 184.71, "t": "Veel mensen weten dit nog niet."}, {"s": 184.71, "e": 187.31, "t": "Je kunt inchecken met je bankpas."}, {"s": 187.31, "e": 190.7, "t": "Of met je telefoon, of met je horloge."}, {"s": 190.71, "e": 193.02, "t": "En de oude OV-chipkaart?"}, {"s": 193.02, "e": 194.41, "t": "Die verdwijnt."}, {"s": 194.41, "e": 196.51, "t": "Er komt een nieuwe OV-pas."}, {"s": 196.51, "e": 199.02, "t": "Dat systeem heet OVpay."}, {"s": 199.02, "e": 201.0, "t": "Je hoeft dus geen kaartje meer"}, {"s": 201.0, "e": 202.73, "t": "te kopen bij de automaat."}, {"s": 202.73, "e": 204.65, "t": "Je checkt gewoon in,"}, {"s": 204.65, "e": 207.53, "t": "en je betaalt later met je bankpas."}, {"s": 207.53, "e": 210.43, "t": "Er is één heel belangrijke regel."}, {"s": 210.43, "e": 211.63, "t": "Welke?"}, {"s": 211.63, "e": 215.02, "t": "Je checkt in en uit met dezelfde pas."}, {"s": 215.02, "e": 217.34, "t": "Waarom is dat belangrijk?"}, {"s": 217.34, "e": 220.24, "t": "Stel: je checkt in met je bankpas."}, {"s": 220.24, "e": 223.05, "t": "En je checkt uit met je telefoon."}, {"s": 223.05, "e": 224.67, "t": "Dan denkt het systeem:"}, {"s": 224.67, "e": 226.95, "t": "dit zijn twee verschillende reizen."}, {"s": 226.96, "e": 229.26, "t": "En dan betaal je te veel."}, {"s": 229.26, "e": 233.17, "t": "Precies. Dus: dezelfde pas, altijd."}, {"s": 233.18, "e": 236.37, "t": "Op grote stations zijn er poortjes."}, {"s": 236.37, "e": 239.72, "t": "Ja. Je houdt je pas tegen het poortje en het"}, {"s": 239.72, "e": 240.97, "t": "gaat open."}, {"s": 240.97, "e": 243.67, "t": "Maar soms gaat het poortje niet open."}, {"s": 243.67, "e": 246.28, "t": "Dat overkwam mij vorige week."}, {"s": 246.28, "e": 248.27, "t": "Wat deed je toen?"}, {"s": 248.27, "e": 251.88, "t": "Ik vroeg aan een medewerker: het poortje gaat niet open."}, {"s": 251.88, "e": 253.36, "t": "Kunt u me helpen?"}, {"s": 253.36, "e": 256.84, "t": "Goede zin. En wat zei de medewerker?"}, {"s": 256.84, "e": 260.23, "t": "Houd uw pas iets langer tegen de lezer."}, {"s": 260.23, "e": 261.33, "t": "En?"}, {"s": 261.33, "e": 264.63, "t": "Het werkte. Ik hield hem gewoon te kort."}, {"s": 264.63, "e": 267.44, "t": "Soms is het probleem heel klein."}, {"s": 267.44, "e": 269.39, "t": "En het allerbelangrijkste:"}, {"s": 269.39, "e": 271.45, "t": "vergeet niet uit te checken!"}, {"s": 271.45, "e": 274.16, "t": "Ben jij dat weleens vergeten?"}, {"s": 274.16, "e": 276.3, "t": "Eén keer. Ik was moe,"}, {"s": 276.3, "e": 278.57, "t": "ik liep zo naar buiten."}, {"s": 278.57, "e": 279.87, "t": "En toen?"}, {"s": 279.87, "e": 281.77, "t": "Ik betaalde veel te veel"}, {"s": 281.77, "e": 283.45, "t": "voor een korte reis."}, {"s": 283.45, "e": 287.27, "t": "O nee. Kun je dat geld terugkrijgen?"}, {"s": 287.27, "e": 290.16, "t": "Ja. Je kunt het later terugvragen,"}, {"s": 290.16, "e": 292.46, "t": "via de website of de app."}, {"s": 292.46, "e": 294.35, "t": "Goed om te weten."}, {"s": 294.35, "e": 296.09, "t": "Maar het is makkelijker"}, {"s": 296.09, "e": 297.94, "t": "om gewoon uit te checken."}, {"s": 297.94, "e": 300.26, "t": "Dus: inchecken bij het begin,"}, {"s": 300.26, "e": 302.34, "t": "uitchecken aan het einde."}, {"s": 302.34, "e": 303.87, "t": "Ook als je overstapt"}, {"s": 303.87, "e": 305.45, "t": "op een ander station?"}, {"s": 305.45, "e": 308.27, "t": "Bij een overstap tussen treinen niet."}, {"s": 308.27, "e": 310.86, "t": "Alleen aan het einde van je reis."}, {"s": 310.86, "e": 312.68, "t": "Behalve als je overstapt"}, {"s": 312.68, "e": 314.67, "t": "naar een andere vervoerder."}, {"s": 314.67, "e": 317.77, "t": "Klopt. Dat is soms lastig."}, {"s": 317.77, "e": 319.2, "t": "Kijk dan goed naar de"}, {"s": 319.2, "e": 320.68, "t": "borden op het station."}, {"s": 320.68, "e": 322.57, "t": "En als je twijfelt?"}, {"s": 322.57, "e": 324.11, "t": "Dan vraag je het."}, {"s": 324.11, "e": 326.06, "t": "Moet ik hier uitchecken?"}, {"s": 326.06, "e": 328.25, "t": "Mooi. Je hebt ingecheckt."}, {"s": 328.25, "e": 330.07, "t": "Nu naar het perron."}, {"s": 330.07, "e": 332.22, "t": "Het perron is de plek waar"}, {"s": 332.22, "e": 334.08, "t": "je op de trein wacht."}, {"s": 334.08, "e": 337.05, "t": "En het spoor is het nummer op het bord."}, {"s": 337.05, "e": 338.87, "t": "Daar stopt de trein."}, {"s": 338.87, "e": 341.91, "t": "Op het bord staat: spoor vijf,"}, {"s": 341.91, "e": 343.96, "t": "of spoor zeven b."}, {"s": 343.96, "e": 346.37, "t": "Wat betekent die b?"}, {"s": 346.37, "e": 349.33, "t": "Een lang perron is soms in twee delen:"}, {"s": 349.33, "e": 350.38, "t": "a en b."}, {"s": 350.38, "e": 353.48, "t": "Dat is verwarrend voor nieuwe reizigers."}, {"s": 353.49, "e": 357.39, "t": "Zeker. Ik zie vaak toeristen die zoeken."}, {"s": 357.39, "e": 360.6, "t": "Zullen we het oefenen? Jij bent een toerist,"}, {"s": 360.61, "e": 362.39, "t": "ik ben een reiziger."}, {"s": 362.39, "e": 365.97, "t": "Goed. Sorry, mag ik u iets vragen?"}, {"s": 365.97, "e": 367.47, "t": "Natuurlijk."}, {"s": 367.47, "e": 369.27, "t": "Van welk spoor vertrekt"}, {"s": 369.27, "e": 370.97, "t": "de trein naar Leiden?"}, {"s": 370.97, "e": 374.26, "t": "Even kijken... Van spoor acht."}, {"s": 374.26, "e": 376.26, "t": "Is dat hier in de buurt?"}, {"s": 376.26, "e": 380.36, "t": "Ja. U gaat de trap op, en dan rechtdoor."}, {"s": 380.37, "e": 384.08, "t": "Dank u. Stopt deze trein ook in Haarlem?"}, {"s": 384.08, "e": 386.65, "t": "Nee, die stopt niet in Haarlem."}, {"s": 386.65, "e": 388.78, "t": "Daar moet u overstappen."}, {"s": 388.78, "e": 391.09, "t": "Waar moet ik overstappen?"}, {"s": 391.09, "e": 394.57, "t": "In Leiden. Daar neemt u de Sprinter."}, {"s": 394.57, "e": 397.58, "t": "Een Sprinter? Wat is dat?"}, {"s": 397.58, "e": 400.76, "t": "Een trein die bij elk station stopt."}, {"s": 400.76, "e": 402.66, "t": "En een Intercity?"}, {"s": 402.66, "e": 405.51, "t": "Die stopt alleen bij de grote stations."}, {"s": 405.51, "e": 406.96, "t": "Hij is sneller."}, {"s": 406.96, "e": 410.26, "t": "Dank u wel. U bent heel vriendelijk."}, {"s": 410.26, "e": 413.26, "t": "Graag gedaan. Goede reis!"}, {"s": 413.26, "e": 416.27, "t": "Goede reis. Dat is een mooie zin."}, {"s": 416.27, "e": 419.34, "t": "Ja. Dat zeggen Nederlanders vaak als iemand"}, {"s": 419.34, "e": 420.38, "t": "weggaat."}, {"s": 420.38, "e": 421.93, "t": "Ik hoor ook vaak:"}, {"s": 421.93, "e": 424.29, "t": "is dit de trein naar Amsterdam?"}, {"s": 424.29, "e": 426.57, "t": "Die vraag stel ik zelf ook."}, {"s": 426.57, "e": 428.8, "t": "Ook als ik het zeker weet."}, {"s": 428.8, "e": 430.19, "t": "Waarom?"}, {"s": 430.19, "e": 433.09, "t": "Een keer zat ik in de verkeerde trein."}, {"s": 433.09, "e": 435.7, "t": "Echt waar? Waar ging je naartoe?"}, {"s": 435.7, "e": 437.29, "t": "Naar Den Haag."}, {"s": 437.3, "e": 440.21, "t": "Maar de trein ging naar Rotterdam."}, {"s": 440.21, "e": 441.71, "t": "Hoe kan dat?"}, {"s": 441.71, "e": 443.63, "t": "Er stonden twee treinen"}, {"s": 443.63, "e": 445.31, "t": "op hetzelfde spoor."}, {"s": 445.31, "e": 448.02, "t": "Op hetzelfde spoor? Allebei?"}, {"s": 448.02, "e": 452.13, "t": "Ja. Eentje voorin, eentje achterin."}, {"s": 452.13, "e": 453.74, "t": "Dat wist ik niet."}, {"s": 453.74, "e": 457.57, "t": "Het gebeurt soms. Kijk dus altijd op het bordje van de"}, {"s": 457.57, "e": 458.53, "t": "trein."}, {"s": 458.53, "e": 461.14, "t": "Of vraag het aan iemand op het perron."}, {"s": 461.14, "e": 462.64, "t": "Precies."}, {"s": 462.64, "e": 465.27, "t": "Daar komt de trein. Hij stopt."}, {"s": 465.27, "e": 467.24, "t": "De deuren gaan open."}, {"s": 467.24, "e": 469.94, "t": "Eerst laat je de mensen uitstappen."}, {"s": 469.94, "e": 472.84, "t": "Ja. Dan stap je in."}, {"s": 472.84, "e": 476.56, "t": "En dan zoek je een plek. Wat vraag je?"}, {"s": 476.56, "e": 478.78, "t": "Is deze plek nog vrij?"}, {"s": 478.78, "e": 481.39, "t": "Of korter: is deze vrij?"}, {"s": 481.39, "e": 484.2, "t": "En als er een tas op de stoel ligt?"}, {"s": 484.2, "e": 486.9, "t": "Dan vraag je: mag ik hier zitten?"}, {"s": 486.9, "e": 490.19, "t": "Meestal pakt de persoon dan de tas weg."}, {"s": 490.19, "e": 492.6, "t": "En als je bij het raam wilt zitten?"}, {"s": 492.6, "e": 494.81, "t": "Mag ik er even langs?"}, {"s": 494.81, "e": 498.5, "t": "Die zin gebruik je overal. In de trein,"}, {"s": 498.5, "e": 501.2, "t": "in de bus, in de bioscoop."}, {"s": 501.2, "e": 503.41, "t": "Waar zit jij het liefst?"}, {"s": 503.41, "e": 507.32, "t": "Bij het raam. Ik kijk graag naar buiten."}, {"s": 507.32, "e": 509.83, "t": "Naar de koeien en de weilanden."}, {"s": 509.83, "e": 512.35, "t": "Ja. En naar de molens."}, {"s": 512.35, "e": 514.62, "t": "Het is heel rustig."}, {"s": 514.62, "e": 516.66, "t": "Ik zit liever bij de deur."}, {"s": 516.66, "e": 518.53, "t": "Dan ben ik snel buiten."}, {"s": 518.53, "e": 520.32, "t": "Dat past bij jou."}, {"s": 520.33, "e": 522.92, "t": "Hoe laat reis jij meestal?"}, {"s": 522.92, "e": 525.64, "t": "Ik probeer de spits te vermijden."}, {"s": 525.64, "e": 530.1, "t": "De spits is de drukke tijd. 's Ochtends en aan het einde van de"}, {"s": 530.1, "e": 531.14, "t": "middag."}, {"s": 531.14, "e": 533.42, "t": "Dan gaat iedereen naar zijn werk,"}, {"s": 533.42, "e": 534.64, "t": "of naar huis."}, {"s": 534.64, "e": 537.43, "t": "In de spits sta ik vaak in de trein."}, {"s": 537.43, "e": 539.55, "t": "En buiten de spits?"}, {"s": 539.55, "e": 541.13, "t": "Dan is het rustig."}, {"s": 541.13, "e": 542.95, "t": "Je kunt altijd zitten."}, {"s": 542.95, "e": 545.86, "t": "Daarom reis ik liever om tien uur."}, {"s": 545.86, "e": 547.65, "t": "Niet om acht uur."}, {"s": 547.65, "e": 549.4, "t": "Dat kan niet iedereen."}, {"s": 549.4, "e": 551.86, "t": "Ik moet vaak om negen uur beginnen."}, {"s": 551.86, "e": 555.23, "t": "Dat is waar. Neem jij weleens je fiets mee in de"}, {"s": 555.23, "e": 556.16, "t": "trein?"}, {"s": 556.16, "e": 559.67, "t": "Soms. Maar op werkdagen in de spits mag dat"}, {"s": 559.67, "e": 560.66, "t": "niet."}, {"s": 560.66, "e": 562.54, "t": "En wat heb je nodig?"}, {"s": 562.54, "e": 565.25, "t": "Een extra kaartje voor je fiets."}, {"s": 565.25, "e": 567.56, "t": "En waar zet je de fiets neer?"}, {"s": 567.56, "e": 570.46, "t": "In de wagon met een fiets op de deur."}, {"s": 570.46, "e": 573.26, "t": "Vraag je het weleens aan de conducteur?"}, {"s": 573.26, "e": 576.86, "t": "Ja. Mag mijn fiets mee in deze trein?"}, {"s": 576.86, "e": 580.83, "t": "Goede vraag. Maar het is makkelijker om een OV-fiets"}, {"s": 580.83, "e": 582.05, "t": "te huren."}, {"s": 582.05, "e": 584.17, "t": "Daar komen we straks nog op."}, {"s": 584.17, "e": 586.29, "t": "Je hebt een plan vandaag."}, {"s": 586.29, "e": 589.78, "t": "Altijd. Behalve om tien over negen."}, {"s": 589.78, "e": 590.7, "t": "Goed."}, {"s": 590.7, "e": 593.78, "t": "En waar zit je als je rustig wilt lezen?"}, {"s": 593.78, "e": 595.54, "t": "In sommige treinen is"}, {"s": 595.54, "e": 597.19, "t": "er een stiltecoupé."}, {"s": 597.19, "e": 599.25, "t": "Dat is een deel van de trein"}, {"s": 599.25, "e": 601.1, "t": "waar het stil moet zijn."}, {"s": 601.1, "e": 602.82, "t": "Je mag daar niet bellen"}, {"s": 602.82, "e": 604.39, "t": "en niet hard praten."}, {"s": 604.39, "e": 607.79, "t": "Ik zit daar graag. Dan kan ik lezen."}, {"s": 607.79, "e": 609.78, "t": "Ik vergeet het soms."}, {"s": 609.78, "e": 611.57, "t": "Wat gebeurt er dan?"}, {"s": 611.58, "e": 614.86, "t": "Dan gaat mijn telefoon. En ik neem op."}, {"s": 614.86, "e": 616.98, "t": "En iedereen kijkt naar jou."}, {"s": 616.98, "e": 621.0, "t": "Ja. Dan zeg ik snel: ik bel je zo terug."}, {"s": 621.0, "e": 624.3, "t": "Goede zin. Ik bel je zo terug."}, {"s": 624.3, "e": 627.3, "t": "Nu kom ik bij mijn verhaal van vandaag."}, {"s": 627.3, "e": 628.79, "t": "Nog een verhaal?"}, {"s": 628.79, "e": 631.45, "t": "Ja. Dit is van vorige maand."}, {"s": 631.45, "e": 633.69, "t": "De trein was heel vol."}, {"s": 633.69, "e": 636.39, "t": "Dat is vaak zo in de spits."}, {"s": 636.39, "e": 639.51, "t": "Precies. Ik zag één rustige wagon."}, {"s": 639.51, "e": 641.49, "t": "Veel lege stoelen."}, {"s": 641.49, "e": 642.42, "t": "O..."}, {"s": 642.42, "e": 645.7, "t": "ik denk dat ik weet waar dit heen gaat."}, {"s": 645.7, "e": 649.19, "t": "Ik ging zitten. Heerlijk. Grote stoel,"}, {"s": 649.19, "e": 650.79, "t": "veel ruimte."}, {"s": 650.79, "e": 654.08, "t": "Zag je het grote cijfer één op de deur?"}, {"s": 654.08, "e": 656.7, "t": "Nee. Ik zag niets."}, {"s": 656.7, "e": 659.78, "t": "Dat was de eerste klas, Hans."}, {"s": 659.78, "e": 663.11, "t": "Ja. Maar ik had ingecheckt voor de tweede"}, {"s": 663.11, "e": 664.09, "t": "klas."}, {"s": 664.09, "e": 665.81, "t": "Met je bankpas kun je"}, {"s": 665.81, "e": 667.81, "t": "alleen tweede klas reizen."}, {"s": 667.81, "e": 669.46, "t": "Dat weet ik nu ook."}, {"s": 669.46, "e": 671.4, "t": "Toen kwam de conducteur."}, {"s": 671.4, "e": 673.31, "t": "Zullen we het naspelen?"}, {"s": 673.31, "e": 675.11, "t": "Ik ben de conducteur."}, {"s": 675.11, "e": 676.32, "t": "Goed."}, {"s": 676.32, "e": 677.64, "t": "Goedemorgen."}, {"s": 677.64, "e": 680.04, "t": "Mag ik uw vervoersbewijs zien?"}, {"s": 680.04, "e": 681.22, "t": "Goedemorgen."}, {"s": 681.22, "e": 683.62, "t": "Ik heb ingecheckt met mijn bankpas."}, {"s": 683.62, "e": 686.13, "t": "Dank u. Ik scan hem even."}, {"s": 686.13, "e": 687.74, "t": "Alstublieft."}, {"s": 687.74, "e": 690.74, "t": "U heeft ingecheckt voor de tweede klas."}, {"s": 690.74, "e": 692.86, "t": "Ja, dat klopt."}, {"s": 692.86, "e": 695.46, "t": "Maar u zit in de eerste klas."}, {"s": 695.46, "e": 698.46, "t": "O nee. Sorry, dat wist ik niet."}, {"s": 698.47, "e": 700.98, "t": "U kunt hier niet blijven zitten."}, {"s": 700.98, "e": 702.2, "t": "Natuurlijk."}, {"s": 702.2, "e": 704.7, "t": "Ik ga meteen naar de tweede klas."}, {"s": 704.7, "e": 707.4, "t": "Dank u. Een fijne dag nog."}, {"s": 707.4, "e": 710.5, "t": "U ook. En nogmaals sorry."}, {"s": 710.5, "e": 712.21, "t": "Was de echte conducteur"}, {"s": 712.21, "e": 713.71, "t": "ook zo vriendelijk?"}, {"s": 713.71, "e": 715.25, "t": "Ja, gelukkig."}, {"s": 715.25, "e": 718.2, "t": "Hij zag dat ik het echt niet wist."}, {"s": 718.2, "e": 720.61, "t": "Maar het kan ook anders gaan."}, {"s": 720.61, "e": 723.61, "t": "Ja. Soms krijg je een boete."}, {"s": 723.61, "e": 727.07, "t": "Daarom: kijk naar het cijfer op de deur."}, {"s": 727.07, "e": 728.6, "t": "Eén of twee."}, {"s": 728.6, "e": 731.21, "t": "Daarna stond ik in de tweede klas."}, {"s": 731.21, "e": 733.1, "t": "Er was geen plek meer."}, {"s": 733.1, "e": 734.99, "t": "Dat is de straf."}, {"s": 734.99, "e": 737.11, "t": "Veertig minuten staan."}, {"s": 737.11, "e": 739.82, "t": "Wat zegt een conducteur nog meer?"}, {"s": 739.82, "e": 741.81, "t": "Nog iemand ingestapt?"}, {"s": 741.81, "e": 744.65, "t": "Dat betekent: wie is er net ingestapt?"}, {"s": 744.65, "e": 746.6, "t": "Ik wil je kaartje zien."}, {"s": 746.6, "e": 749.13, "t": "En: het volgende station is Utrecht"}, {"s": 749.13, "e": 750.19, "t": "Centraal."}, {"s": 750.19, "e": 752.9, "t": "Dat zegt hij via de omroep."}, {"s": 752.9, "e": 756.15, "t": "Ja. Of: deze trein rijdt niet verder dan"}, {"s": 756.15, "e": 757.51, "t": "Amersfoort."}, {"s": 757.51, "e": 759.25, "t": "Dat is belangrijk."}, {"s": 759.25, "e": 761.61, "t": "Dan moet je daar uitstappen."}, {"s": 761.61, "e": 764.02, "t": "En dan zoek je een andere trein."}, {"s": 764.02, "e": 765.69, "t": "Daarmee komen we bij"}, {"s": 765.69, "e": 767.41, "t": "het minst leuke deel."}, {"s": 767.41, "e": 769.11, "t": "Vertraging."}, {"s": 769.11, "e": 771.81, "t": "Hoe vaak heb jij vertraging?"}, {"s": 771.82, "e": 773.23, "t": "Niet heel vaak."}, {"s": 773.23, "e": 775.54, "t": "Meestal rijden de treinen goed."}, {"s": 775.54, "e": 777.23, "t": "Maar als het gebeurt,"}, {"s": 777.23, "e": 779.25, "t": "hoor je het op het station."}, {"s": 779.25, "e": 781.74, "t": "De trein van negen uur tien naar"}, {"s": 781.74, "e": 784.57, "t": "Utrecht heeft vijf minuten vertraging."}, {"s": 784.57, "e": 787.08, "t": "Dat was jouw trein vanochtend!"}, {"s": 787.09, "e": 788.36, "t": "Nee hoor."}, {"s": 788.36, "e": 791.1, "t": "Die was helaas precies op tijd."}, {"s": 791.1, "e": 793.09, "t": "Wat hoor je nog meer?"}, {"s": 793.09, "e": 795.71, "t": "De trein naar Zwolle rijdt niet."}, {"s": 795.71, "e": 798.7, "t": "Dat betekent: hij komt helemaal niet."}, {"s": 798.7, "e": 801.39, "t": "Of: door een storing rijden er minder"}, {"s": 801.39, "e": 802.42, "t": "treinen."}, {"s": 802.42, "e": 805.73, "t": "Een storing is een technisch probleem."}, {"s": 805.73, "e": 809.31, "t": "Soms aan de trein, soms aan het spoor."}, {"s": 809.31, "e": 811.0, "t": "En in de herfst?"}, {"s": 811.0, "e": 813.41, "t": "Bladeren op het spoor."}, {"s": 813.41, "e": 814.62, "t": "Echt waar."}, {"s": 814.62, "e": 817.62, "t": "Dat is in Nederland een bekend probleem."}, {"s": 817.62, "e": 819.8, "t": "En in de winter: sneeuw."}, {"s": 819.8, "e": 822.12, "t": "Twee centimeter is genoeg."}, {"s": 822.12, "e": 825.12, "t": "Wat doe je als er geen treinen rijden?"}, {"s": 825.12, "e": 826.94, "t": "Dan kijk ik in de app."}, {"s": 826.94, "e": 829.23, "t": "Er staat vaak een alternatief."}, {"s": 829.23, "e": 832.03, "t": "Soms is er vervangend vervoer."}, {"s": 832.03, "e": 835.12, "t": "Dat zijn bussen in plaats van treinen."}, {"s": 835.12, "e": 836.84, "t": "Ze staan meestal bij de"}, {"s": 836.84, "e": 838.6, "t": "uitgang van het station."}, {"s": 838.6, "e": 840.09, "t": "Je kunt vragen:"}, {"s": 840.09, "e": 842.7, "t": "waar vertrekt de bus naar Utrecht?"}, {"s": 842.71, "e": 843.44, "t": "Of:"}, {"s": 843.44, "e": 846.11, "t": "is dit de bus in plaats van de trein?"}, {"s": 846.11, "e": 848.09, "t": "Dat duurt wel langer."}, {"s": 848.09, "e": 849.99, "t": "Maar je komt er wel."}, {"s": 849.99, "e": 852.28, "t": "En als je je trein hebt gemist,"}, {"s": 852.28, "e": 853.8, "t": "zoals ik vandaag?"}, {"s": 853.8, "e": 855.04, "t": "Dan vraag je:"}, {"s": 855.04, "e": 857.3, "t": "hoe laat gaat de volgende trein?"}, {"s": 857.3, "e": 862.45, "t": "Precies. En de app zei vanochtend: de volgende trein gaat over vijftien"}, {"s": 862.45, "e": 863.59, "t": "minuten."}, {"s": 863.59, "e": 866.0, "t": "Dus je hebt een kwartier gewacht."}, {"s": 866.0, "e": 869.29, "t": "Met een koffie. Het was niet heel erg."}, {"s": 869.29, "e": 871.9, "t": "Zullen we naar een leukere reis gaan?"}, {"s": 871.9, "e": 874.41, "t": "Graag. Waarheen?"}, {"s": 874.41, "e": 877.91, "t": "Naar Schiphol. Je gaat op vakantie."}, {"s": 877.91, "e": 879.53, "t": "Eindelijk vakantie!"}, {"s": 879.53, "e": 881.82, "t": "Ik heb een grote koffer bij me."}, {"s": 881.82, "e": 883.94, "t": "Hoe kom je op Schiphol?"}, {"s": 883.94, "e": 887.13, "t": "Met de trein. Er gaat een trein direct naar het"}, {"s": 887.13, "e": 888.24, "t": "vliegveld."}, {"s": 888.24, "e": 891.54, "t": "Het station is onder de luchthaven."}, {"s": 891.54, "e": 893.35, "t": "Dat is heel handig."}, {"s": 893.35, "e": 895.65, "t": "Je stapt uit en je bent er."}, {"s": 895.65, "e": 897.46, "t": "Maar met een koffer is"}, {"s": 897.46, "e": 899.22, "t": "de trein soms lastig."}, {"s": 899.22, "e": 902.71, "t": "Ja. Je moet de trap op met je koffer."}, {"s": 902.71, "e": 905.91, "t": "Dan kun je vragen: is hier een lift?"}, {"s": 905.91, "e": 907.88, "t": "Of iemand vraagt aan jou:"}, {"s": 907.88, "e": 909.63, "t": "zal ik u even helpen?"}, {"s": 909.63, "e": 912.04, "t": "Dat vind ik altijd heel aardig."}, {"s": 912.04, "e": 913.64, "t": "In de trein zet je de"}, {"s": 913.64, "e": 915.14, "t": "koffer bij de deur."}, {"s": 915.14, "e": 918.34, "t": "Of boven je hoofd, in het rek."}, {"s": 918.34, "e": 920.56, "t": "Als hij niet te zwaar is."}, {"s": 920.56, "e": 924.15, "t": "En dan zit je. Naast je zit een vrouw."}, {"s": 924.15, "e": 926.14, "t": "Ze heeft ook een koffer."}, {"s": 926.14, "e": 928.39, "t": "Misschien begin je een praatje."}, {"s": 928.39, "e": 930.15, "t": "Zullen we dat oefenen?"}, {"s": 930.15, "e": 934.36, "t": "Ja. Ik begin. Gaat u ook naar Schiphol?"}, {"s": 934.36, "e": 938.17, "t": "Ja. Ik ga naar Spanje. En u?"}, {"s": 938.17, "e": 941.46, "t": "Ik ga naar Italië. Een week Rome."}, {"s": 941.46, "e": 943.0, "t": "O, wat leuk."}, {"s": 943.0, "e": 945.66, "t": "Hoe laat vertrekt uw vlucht?"}, {"s": 945.66, "e": 948.23, "t": "Om drie uur. Ik ben vroeg,"}, {"s": 948.23, "e": 950.65, "t": "maar ik wil geen stress."}, {"s": 950.65, "e": 952.1, "t": "Dat snap ik."}, {"s": 952.1, "e": 955.25, "t": "Weet u of deze trein vertraging heeft?"}, {"s": 955.25, "e": 957.11, "t": "Nee, hij is op tijd."}, {"s": 957.11, "e": 959.54, "t": "Ik heb net in de app gekeken."}, {"s": 959.54, "e": 962.63, "t": "Gelukkig. Waar stapt u uit?"}, {"s": 962.63, "e": 965.05, "t": "Op Schiphol. Net als u."}, {"s": 965.05, "e": 969.06, "t": "Dan stappen we samen uit. Goede reis!"}, {"s": 969.06, "e": 971.67, "t": "U ook. Fijne vakantie!"}, {"s": 971.67, "e": 973.87, "t": "Heel natuurlijk, Hans."}, {"s": 973.87, "e": 974.86, "t": "Dank je."}, {"s": 974.86, "e": 977.59, "t": "Ik vind dat soort korte gesprekjes leuk."}, {"s": 977.59, "e": 979.31, "t": "Veel Nederlanders praten"}, {"s": 979.31, "e": 981.08, "t": "niet zo veel in de trein."}, {"s": 981.08, "e": 984.58, "t": "Nee, iedereen kijkt op zijn telefoon."}, {"s": 984.58, "e": 987.13, "t": "Maar met een koffer is het anders."}, {"s": 987.13, "e": 989.57, "t": "Dan heb je meteen een onderwerp."}, {"s": 989.57, "e": 991.08, "t": "Waar ga je naartoe?"}, {"s": 991.08, "e": 993.16, "t": "Dat is altijd een goede vraag."}, {"s": 993.16, "e": 994.61, "t": "En: wat leuk!"}, {"s": 994.61, "e": 997.26, "t": "Dat is altijd een goede reactie."}, {"s": 997.26, "e": 999.36, "t": "Nog één tip voor Schiphol."}, {"s": 999.36, "e": 1001.57, "t": "Vergeet niet uit te checken."}, {"s": 1001.57, "e": 1003.17, "t": "Daar is hij weer."}, {"s": 1003.17, "e": 1005.97, "t": "Ja. Ook op vakantie."}, {"s": 1005.97, "e": 1007.64, "t": "En 's avonds laat?"}, {"s": 1007.64, "e": 1009.78, "t": "Rijden er dan nog treinen?"}, {"s": 1009.78, "e": 1011.72, "t": "Tot ongeveer middernacht"}, {"s": 1011.72, "e": 1013.6, "t": "rijden er veel treinen."}, {"s": 1013.6, "e": 1015.71, "t": "Daarna wordt het lastig."}, {"s": 1015.71, "e": 1018.8, "t": "Ja. Daarom vraag ik op een feestje altijd op"}, {"s": 1018.8, "e": 1019.66, "t": "tijd:"}, {"s": 1019.66, "e": 1022.01, "t": "hoe laat gaat de laatste trein?"}, {"s": 1022.01, "e": 1024.51, "t": "Heb je die weleens gemist?"}, {"s": 1024.51, "e": 1028.01, "t": "Eén keer. Na een verjaardag in Haarlem."}, {"s": 1028.01, "e": 1029.71, "t": "Wat deed je toen?"}, {"s": 1029.71, "e": 1031.18, "t": "Ik heb bij een vriend"}, {"s": 1031.18, "e": 1032.6, "t": "op de bank geslapen."}, {"s": 1032.6, "e": 1035.99, "t": "Op de bank. Was het comfortabel?"}, {"s": 1035.99, "e": 1038.98, "t": "Niet echt. Maar het was gezellig."}, {"s": 1038.98, "e": 1042.03, "t": "Dus: kijk op tijd hoe laat de laatste trein"}, {"s": 1042.03, "e": 1042.89, "t": "gaat."}, {"s": 1042.89, "e": 1045.21, "t": "Of neem een slaapzak mee."}, {"s": 1045.21, "e": 1047.84, "t": "Kleine pauze voor de luisteraar."}, {"s": 1047.84, "e": 1050.29, "t": "Antwoord hardop, als je kunt."}, {"s": 1050.29, "e": 1054.02, "t": "Eerste vraag. Je zoekt de trein naar Leiden."}, {"s": 1054.02, "e": 1055.6, "t": "Wat vraag je?"}, {"s": 1055.6, "e": 1057.45, "t": "Van welk spoor vertrekt"}, {"s": 1057.45, "e": 1059.19, "t": "de trein naar Leiden?"}, {"s": 1059.19, "e": 1062.38, "t": "Tweede vraag. Er ligt een tas op de stoel."}, {"s": 1062.38, "e": 1063.79, "t": "Wat vraag je?"}, {"s": 1063.79, "e": 1066.0, "t": "Is deze plek nog vrij?"}, {"s": 1066.0, "e": 1069.92, "t": "Derde vraag. Je hebt je trein gemist."}, {"s": 1069.92, "e": 1072.72, "t": "Hoe laat gaat de volgende trein?"}, {"s": 1072.72, "e": 1074.32, "t": "Heel goed."}, {"s": 1074.32, "e": 1076.41, "t": "Hans, je bent in Utrecht."}, {"s": 1076.41, "e": 1078.13, "t": "Moet je nog verder?"}, {"s": 1078.13, "e": 1079.75, "t": "Ja, met de bus."}, {"s": 1079.75, "e": 1082.93, "t": "Mijn afspraak was niet bij het station."}, {"s": 1082.93, "e": 1085.44, "t": "Hoe gaat inchecken in de bus?"}, {"s": 1085.44, "e": 1087.66, "t": "Je stapt in bij de voordeur,"}, {"s": 1087.66, "e": 1089.24, "t": "bij de chauffeur."}, {"s": 1089.24, "e": 1092.04, "t": "En je houdt je pas tegen de lezer."}, {"s": 1092.04, "e": 1094.65, "t": "Precies. Weer een piepje."}, {"s": 1094.65, "e": 1097.64, "t": "Kun je in de bus nog contant betalen?"}, {"s": 1097.64, "e": 1099.7, "t": "In veel bussen niet meer."}, {"s": 1099.7, "e": 1102.05, "t": "Alleen met je pas of telefoon."}, {"s": 1102.05, "e": 1103.84, "t": "Goed om te weten."}, {"s": 1103.84, "e": 1105.36, "t": "Ik weet nooit precies"}, {"s": 1105.36, "e": 1107.03, "t": "waar ik moet uitstappen."}, {"s": 1107.03, "e": 1109.38, "t": "Dan vraag je het aan de chauffeur."}, {"s": 1109.38, "e": 1111.04, "t": "Zullen we het spelen?"}, {"s": 1111.04, "e": 1114.05, "t": "Ja. Ik ben de reiziger."}, {"s": 1114.05, "e": 1116.96, "t": "En ik ben de chauffeur. Goedemiddag."}, {"s": 1116.96, "e": 1118.26, "t": "Goedemiddag."}, {"s": 1118.26, "e": 1120.87, "t": "Stopt deze bus bij het ziekenhuis?"}, {"s": 1120.87, "e": 1124.16, "t": "Ja, het ziekenhuis is de vijfde halte."}, {"s": 1124.16, "e": 1126.66, "t": "Kunt u zeggen wanneer ik eruit moet?"}, {"s": 1126.66, "e": 1129.56, "t": "Natuurlijk. Ik roep het wel."}, {"s": 1129.56, "e": 1132.86, "t": "Dank u wel. Hoe lang duurt het ongeveer?"}, {"s": 1132.86, "e": 1134.65, "t": "Een minuut of tien."}, {"s": 1134.65, "e": 1136.87, "t": "Perfect. Dank u."}, {"s": 1136.87, "e": 1138.14, "t": "Goed gedaan."}, {"s": 1138.14, "e": 1140.58, "t": "Veel chauffeurs helpen je graag."}, {"s": 1140.58, "e": 1143.2, "t": "In de bus zie je ook een scherm."}, {"s": 1143.2, "e": 1145.9, "t": "Daar staat de volgende halte op."}, {"s": 1145.9, "e": 1147.61, "t": "Vlak voor jouw halte"}, {"s": 1147.61, "e": 1149.48, "t": "druk je op de stopknop."}, {"s": 1149.48, "e": 1151.99, "t": "Dan stopt de bus bij die halte."}, {"s": 1151.99, "e": 1153.6, "t": "Als je niet drukt,"}, {"s": 1153.6, "e": 1155.9, "t": "rijdt de bus soms gewoon door."}, {"s": 1155.9, "e": 1157.89, "t": "Is dat jou gebeurd?"}, {"s": 1157.89, "e": 1160.99, "t": "Natuurlijk. Twee haltes te ver."}, {"s": 1160.99, "e": 1162.79, "t": "Wat heb je gedaan?"}, {"s": 1162.79, "e": 1166.08, "t": "Toen moest ik teruglopen. In de regen."}, {"s": 1166.08, "e": 1168.88, "t": "Het is echt jouw week, Hans."}, {"s": 1168.88, "e": 1170.37, "t": "Ik weet het."}, {"s": 1170.37, "e": 1172.36, "t": "En bij het uitstappen?"}, {"s": 1172.36, "e": 1173.97, "t": "Dan check je uit."}, {"s": 1173.97, "e": 1176.66, "t": "Dat vergeten veel mensen in de bus."}, {"s": 1176.66, "e": 1179.76, "t": "In de tram is het bijna hetzelfde."}, {"s": 1179.76, "e": 1181.04, "t": "Alleen zijn de"}, {"s": 1181.04, "e": 1182.95, "t": "kaartlezers bij de deuren."}, {"s": 1182.95, "e": 1184.65, "t": "Bij elke deur?"}, {"s": 1184.65, "e": 1186.61, "t": "Bij veel deuren, ja."}, {"s": 1186.61, "e": 1189.35, "t": "Je checkt in en uit bij de deur."}, {"s": 1189.35, "e": 1191.23, "t": "En in de metro?"}, {"s": 1191.23, "e": 1193.0, "t": "Daar zijn weer poortjes,"}, {"s": 1193.0, "e": 1194.71, "t": "net als op het station."}, {"s": 1194.71, "e": 1197.86, "t": "Dus overal: inchecken, uitchecken,"}, {"s": 1197.86, "e": 1199.51, "t": "dezelfde pas."}, {"s": 1199.51, "e": 1202.61, "t": "Precies. Overal hetzelfde."}, {"s": 1202.61, "e": 1204.4, "t": "Volgende maand komt mijn"}, {"s": 1204.4, "e": 1206.62, "t": "vriendin uit Engeland op bezoek."}, {"s": 1206.62, "e": 1209.82, "t": "Leuk! Gaan jullie samen met de trein?"}, {"s": 1209.82, "e": 1211.74, "t": "Ja. Maar ze vraagt:"}, {"s": 1211.74, "e": 1214.12, "t": "moet ik een kaartje kopen?"}, {"s": 1214.12, "e": 1215.91, "t": "Wat zeg jij dan?"}, {"s": 1215.91, "e": 1218.93, "t": "Je kunt inchecken met je eigen bankpas."}, {"s": 1218.93, "e": 1221.1, "t": "Ook met een buitenlandse."}, {"s": 1221.1, "e": 1224.01, "t": "Als het een contactloze pas is."}, {"s": 1224.01, "e": 1227.21, "t": "Precies. Of met haar telefoon."}, {"s": 1227.21, "e": 1228.64, "t": "Maar let op."}, {"s": 1228.64, "e": 1231.32, "t": "Kan ze ook met jouw pas reizen?"}, {"s": 1231.32, "e": 1235.52, "t": "Nee. Iedereen heeft een eigen pas nodig."}, {"s": 1235.52, "e": 1237.44, "t": "Je kunt niet met twee mensen"}, {"s": 1237.44, "e": 1239.01, "t": "op één pas inchecken."}, {"s": 1239.01, "e": 1241.23, "t": "Dat wist ik eerst ook niet."}, {"s": 1241.23, "e": 1243.12, "t": "Wat wilde je doen?"}, {"s": 1243.12, "e": 1246.18, "t": "Ik wilde twee keer inchecken met mijn"}, {"s": 1246.18, "e": 1248.53, "t": "bankpas. Voor ons allebei."}, {"s": 1248.53, "e": 1249.97, "t": "Dat werkt niet."}, {"s": 1249.97, "e": 1252.44, "t": "De tweede keer check je weer uit."}, {"s": 1252.44, "e": 1255.83, "t": "Ja! Dat zei een medewerker ook."}, {"s": 1255.83, "e": 1257.82, "t": "Wat zei hij precies?"}, {"s": 1257.82, "e": 1260.63, "t": "Eén pas is één reiziger."}, {"s": 1260.63, "e": 1262.74, "t": "Makkelijk te onthouden."}, {"s": 1262.74, "e": 1264.36, "t": "En als iemand geen"}, {"s": 1264.36, "e": 1266.22, "t": "contactloze pas heeft?"}, {"s": 1266.22, "e": 1267.89, "t": "Dan kan hij een kaartje"}, {"s": 1267.89, "e": 1269.52, "t": "kopen bij de automaat."}, {"s": 1269.52, "e": 1271.46, "t": "Of bij de servicebalie,"}, {"s": 1271.46, "e": 1273.11, "t": "op grote stations."}, {"s": 1273.11, "e": 1274.83, "t": "Bij de automaat kun je"}, {"s": 1274.83, "e": 1276.4, "t": "de taal veranderen."}, {"s": 1276.4, "e": 1279.5, "t": "Ja, er is een knop voor Engels."}, {"s": 1279.5, "e": 1281.34, "t": "Maar onze luisteraars kiezen"}, {"s": 1281.34, "e": 1282.88, "t": "natuurlijk Nederlands."}, {"s": 1282.88, "e": 1284.34, "t": "Natuurlijk."}, {"s": 1284.34, "e": 1287.19, "t": "Wat kies je dan op de automaat?"}, {"s": 1287.19, "e": 1289.41, "t": "Eerst: waar wil je naartoe?"}, {"s": 1289.41, "e": 1292.02, "t": "Dan: enkele reis of retour."}, {"s": 1292.02, "e": 1294.62, "t": "Enkele reis is alleen heen."}, {"s": 1294.62, "e": 1297.01, "t": "Retour is heen en terug."}, {"s": 1297.01, "e": 1299.62, "t": "En dan: eerste of tweede klas."}, {"s": 1299.62, "e": 1302.53, "t": "Kies tweede klas. Geloof me."}, {"s": 1302.53, "e": 1304.94, "t": "Na jouw verhaal zeker."}, {"s": 1304.94, "e": 1307.05, "t": "Daarna betaal je met je pinpas,"}, {"s": 1307.05, "e": 1308.85, "t": "en je krijgt een kaartje."}, {"s": 1308.85, "e": 1311.26, "t": "Op het kaartje staat een code."}, {"s": 1311.26, "e": 1313.55, "t": "Die scan je bij het poortje."}, {"s": 1313.55, "e": 1316.84, "t": "Mooi. Je vriendin is er klaar voor."}, {"s": 1316.84, "e": 1320.3, "t": "Ik denk het ook. Ik heb het allemaal al voor haar"}, {"s": 1320.3, "e": 1321.64, "t": "opgeschreven."}, {"s": 1321.64, "e": 1323.43, "t": "In het Nederlands?"}, {"s": 1323.43, "e": 1325.34, "t": "Nee, in het Engels."}, {"s": 1325.34, "e": 1328.24, "t": "Ze is nog geen luisteraar van ons."}, {"s": 1328.24, "e": 1329.63, "t": "Nog niet!"}, {"s": 1329.63, "e": 1332.14, "t": "Ik moet jou ook nog iets vertellen."}, {"s": 1332.14, "e": 1333.54, "t": "Wat dan?"}, {"s": 1333.54, "e": 1335.29, "t": "Vorige week ben ik mijn"}, {"s": 1335.29, "e": 1337.26, "t": "sjaal vergeten in de trein."}, {"s": 1337.26, "e": 1340.64, "t": "O nee. Je mooie rode sjaal?"}, {"s": 1340.64, "e": 1344.22, "t": "Ja. Ik zag het pas thuis."}, {"s": 1344.22, "e": 1346.73, "t": "Ben je teruggegaan naar het station?"}, {"s": 1346.73, "e": 1349.09, "t": "Ja, de volgende dag."}, {"s": 1349.09, "e": 1351.52, "t": "Naar de servicebalie."}, {"s": 1351.52, "e": 1353.02, "t": "Wat zei je daar?"}, {"s": 1353.02, "e": 1354.39, "t": "Goedemorgen."}, {"s": 1354.39, "e": 1357.43, "t": "Ik ben mijn sjaal vergeten in de trein."}, {"s": 1357.43, "e": 1359.94, "t": "En wat vroeg de medewerker?"}, {"s": 1359.94, "e": 1361.73, "t": "Welke trein was het?"}, {"s": 1361.73, "e": 1363.53, "t": "En hoe laat was het?"}, {"s": 1363.53, "e": 1365.23, "t": "Wist je dat nog?"}, {"s": 1365.23, "e": 1368.54, "t": "Ja. De Intercity naar Den Haag,"}, {"s": 1368.54, "e": 1370.32, "t": "om vijf uur."}, {"s": 1370.32, "e": 1372.53, "t": "Kon zij je sjaal vinden?"}, {"s": 1372.53, "e": 1376.13, "t": "Nee. Ze zei: kijk op de website bij gevonden"}, {"s": 1376.13, "e": 1377.53, "t": "voorwerpen."}, {"s": 1377.53, "e": 1381.19, "t": "Gevonden voorwerpen. Dat is waar je verloren spullen kunt"}, {"s": 1381.19, "e": 1382.13, "t": "zoeken."}, {"s": 1382.13, "e": 1385.14, "t": "Precies. Ik vulde een formulier in,"}, {"s": 1385.14, "e": 1387.22, "t": "met een beschrijving."}, {"s": 1387.22, "e": 1388.82, "t": "Wat schreef je?"}, {"s": 1388.82, "e": 1392.02, "t": "Een lange rode sjaal, van wol."}, {"s": 1392.02, "e": 1395.13, "t": "En? Heb je hem teruggekregen?"}, {"s": 1395.13, "e": 1399.24, "t": "Ja! Na drie dagen kreeg ik een bericht."}, {"s": 1399.24, "e": 1402.34, "t": "Wat goed. Dat had ik niet verwacht."}, {"s": 1402.34, "e": 1405.73, "t": "Ik ook niet. Maar het werkt echt."}, {"s": 1405.73, "e": 1407.99, "t": "Dus als je iets verliest:"}, {"s": 1407.99, "e": 1409.92, "t": "geef niet meteen op."}, {"s": 1409.92, "e": 1413.07, "t": "Nee. Vraag het bij de servicebalie,"}, {"s": 1413.07, "e": 1414.82, "t": "of kijk online."}, {"s": 1414.82, "e": 1416.23, "t": "Mooie tip."}, {"s": 1416.23, "e": 1419.46, "t": "Hans, ik denk dat jij liever fietst dan de"}, {"s": 1419.46, "e": 1420.82, "t": "trein neemt."}, {"s": 1420.82, "e": 1422.56, "t": "Eerlijk gezegd wel."}, {"s": 1422.57, "e": 1424.73, "t": "De fiets is nooit te laat."}, {"s": 1424.73, "e": 1427.33, "t": "Behalve als jij te laat bent."}, {"s": 1427.33, "e": 1431.07, "t": "Dat is waar. Maar ik gebruik ook vaak de trein én de"}, {"s": 1431.07, "e": 1432.03, "t": "fiets."}, {"s": 1432.03, "e": 1433.72, "t": "Hoe bedoel je?"}, {"s": 1433.72, "e": 1436.53, "t": "Ik neem de trein naar een andere stad."}, {"s": 1436.53, "e": 1437.83, "t": "En dan?"}, {"s": 1437.83, "e": 1439.55, "t": "Daar huur ik een OV-fiets"}, {"s": 1439.55, "e": 1440.83, "t": "bij het station."}, {"s": 1440.83, "e": 1443.44, "t": "Dat zijn die blauw-gele fietsen."}, {"s": 1443.44, "e": 1447.04, "t": "Ja. Je kunt ze bij veel stations huren."}, {"s": 1447.04, "e": 1449.46, "t": "Dat is heel Nederlands."}, {"s": 1449.46, "e": 1451.73, "t": "Trein en fiets samen."}, {"s": 1451.73, "e": 1455.23, "t": "En jij? Fiets je ook in een andere stad?"}, {"s": 1455.23, "e": 1458.94, "t": "Nee. Ik neem liever de tram of de bus."}, {"s": 1458.94, "e": 1460.35, "t": "Waarom?"}, {"s": 1460.35, "e": 1462.06, "t": "Ik ken de weg niet."}, {"s": 1462.06, "e": 1464.95, "t": "En ik word nerveus van al die fietsers."}, {"s": 1464.95, "e": 1468.21, "t": "Ik snap het. In Amsterdam is het druk op het"}, {"s": 1468.21, "e": 1469.35, "t": "fietspad."}, {"s": 1469.35, "e": 1471.3, "t": "In de tram kan ik rustig"}, {"s": 1471.3, "e": 1472.84, "t": "zitten en kijken."}, {"s": 1472.84, "e": 1475.16, "t": "En ik ben sneller met de fiets."}, {"s": 1475.16, "e": 1477.47, "t": "We zijn het weer niet eens."}, {"s": 1477.47, "e": 1479.27, "t": "Dat maakt het leuk."}, {"s": 1479.27, "e": 1480.99, "t": "Zullen we de belangrijkste"}, {"s": 1480.99, "e": 1482.76, "t": "zinnen nog één keer zeggen?"}, {"s": 1482.76, "e": 1486.97, "t": "Ja. Zeg ze hardop mee! Eerst plannen."}, {"s": 1486.97, "e": 1489.87, "t": "Hoe laat gaat de trein naar Utrecht?"}, {"s": 1489.87, "e": 1491.64, "t": "Moet ik overstappen?"}, {"s": 1491.64, "e": 1493.86, "t": "Hoe lang duurt de reis?"}, {"s": 1493.86, "e": 1496.17, "t": "Ik kijk even in de app."}, {"s": 1496.17, "e": 1497.86, "t": "Nu inchecken."}, {"s": 1497.86, "e": 1500.37, "t": "Ik check in met mijn bankpas."}, {"s": 1500.37, "e": 1503.67, "t": "Ik check in en uit met dezelfde pas."}, {"s": 1503.67, "e": 1505.88, "t": "Het poortje gaat niet open."}, {"s": 1505.88, "e": 1507.67, "t": "Kunt u me helpen?"}, {"s": 1507.67, "e": 1509.89, "t": "Vergeet niet uit te checken!"}, {"s": 1509.89, "e": 1512.4, "t": "Ik ben vergeten uit te checken."}, {"s": 1512.4, "e": 1514.28, "t": "Moet ik hier uitchecken?"}, {"s": 1514.28, "e": 1515.98, "t": "Op het station."}, {"s": 1515.98, "e": 1517.78, "t": "Van welk spoor vertrekt"}, {"s": 1517.78, "e": 1519.47, "t": "de trein naar Leiden?"}, {"s": 1519.47, "e": 1521.97, "t": "Is dit de trein naar Amsterdam?"}, {"s": 1521.97, "e": 1524.68, "t": "Stopt deze trein in Haarlem?"}, {"s": 1524.68, "e": 1526.78, "t": "Waar moet ik overstappen?"}, {"s": 1526.78, "e": 1530.08, "t": "Is dit een Sprinter of een Intercity?"}, {"s": 1530.08, "e": 1531.68, "t": "Goede reis!"}, {"s": 1531.68, "e": 1533.28, "t": "In de trein."}, {"s": 1533.28, "e": 1535.39, "t": "Is deze plek nog vrij?"}, {"s": 1535.39, "e": 1537.09, "t": "Mag ik hier zitten?"}, {"s": 1537.09, "e": 1539.21, "t": "Mag ik er even langs?"}, {"s": 1539.21, "e": 1541.42, "t": "Ik bel je zo terug."}, {"s": 1541.42, "e": 1543.92, "t": "Mag ik uw vervoersbewijs zien?"}, {"s": 1543.92, "e": 1546.83, "t": "Ik heb ingecheckt met mijn bankpas."}, {"s": 1546.83, "e": 1549.14, "t": "Sorry, dat wist ik niet."}, {"s": 1549.14, "e": 1551.74, "t": "Ik ga meteen naar de tweede klas."}, {"s": 1551.74, "e": 1553.73, "t": "Bij vertraging."}, {"s": 1553.73, "e": 1557.02, "t": "De trein heeft vijf minuten vertraging."}, {"s": 1557.02, "e": 1559.0, "t": "De trein rijdt niet."}, {"s": 1559.0, "e": 1560.89, "t": "Er is een storing."}, {"s": 1560.89, "e": 1563.6, "t": "Waar vertrekt de bus naar Utrecht?"}, {"s": 1563.6, "e": 1566.01, "t": "Ik heb mijn trein gemist."}, {"s": 1566.01, "e": 1568.71, "t": "Hoe laat gaat de volgende trein?"}, {"s": 1568.71, "e": 1570.83, "t": "In de bus en de tram."}, {"s": 1570.83, "e": 1573.82, "t": "Stopt deze bus bij het ziekenhuis?"}, {"s": 1573.82, "e": 1576.53, "t": "Kunt u zeggen wanneer ik eruit moet?"}, {"s": 1576.53, "e": 1578.84, "t": "Hoe lang duurt het ongeveer?"}, {"s": 1578.84, "e": 1580.95, "t": "Ik druk op de stopknop."}, {"s": 1580.95, "e": 1583.77, "t": "Bij de volgende halte stap ik uit."}, {"s": 1583.77, "e": 1585.17, "t": "Onderweg."}, {"s": 1585.17, "e": 1587.98, "t": "Ik reis liever buiten de spits."}, {"s": 1587.98, "e": 1590.79, "t": "Mag mijn fiets mee in deze trein?"}, {"s": 1590.79, "e": 1592.68, "t": "Is hier een lift?"}, {"s": 1592.68, "e": 1594.68, "t": "Zal ik u even helpen?"}, {"s": 1594.68, "e": 1596.89, "t": "Gaat u ook naar Schiphol?"}, {"s": 1596.89, "e": 1598.79, "t": "Waar stapt u uit?"}, {"s": 1598.79, "e": 1601.59, "t": "Hoe laat gaat de laatste trein?"}, {"s": 1601.59, "e": 1604.49, "t": "Eén pas is één reiziger."}, {"s": 1604.49, "e": 1607.1, "t": "Enkele reis of retour?"}, {"s": 1607.1, "e": 1608.69, "t": "En tot slot."}, {"s": 1608.69, "e": 1611.89, "t": "Ik ben mijn sjaal vergeten in de trein."}, {"s": 1611.89, "e": 1614.9, "t": "Ik huur een OV-fiets bij het station."}, {"s": 1614.9, "e": 1616.05, "t": "Heel goed!"}, {"s": 1616.05, "e": 1618.91, "t": "Dat was een hele reis in het Nederlands."}, {"s": 1618.91, "e": 1620.74, "t": "Van mijn gemiste trein"}, {"s": 1620.74, "e": 1622.5, "t": "tot de laatste halte."}, {"s": 1622.5, "e": 1625.01, "t": "Onthoud vooral: dezelfde pas,"}, {"s": 1625.01, "e": 1627.0, "t": "en altijd uitchecken."}, {"s": 1627.0, "e": 1629.55, "t": "En geen stress bij een gemiste trein."}, {"s": 1629.55, "e": 1631.11, "t": "Er komt er nog één."}, {"s": 1631.11, "e": 1633.52, "t": "Nu onze vraag van de dag."}, {"s": 1633.52, "e": 1636.91, "t": "Hoe reis jij het liefst? Met de trein,"}, {"s": 1636.91, "e": 1639.81, "t": "de bus, of de fiets? En waarom?"}, {"s": 1639.81, "e": 1643.34, "t": "Mijn antwoord: ik reis het liefst met de trein."}, {"s": 1643.34, "e": 1645.01, "t": "Dan kan ik lezen."}, {"s": 1645.01, "e": 1648.31, "t": "En ik fiets het liefst. Dan ben ik vrij."}, {"s": 1648.31, "e": 1650.67, "t": "Schrijf je antwoord in één of"}, {"s": 1650.67, "e": 1652.91, "t": "twee zinnen in de reacties."}, {"s": 1652.91, "e": 1655.02, "t": "We lezen ze allemaal."}, {"s": 1655.02, "e": 1657.31, "t": "Bedankt voor het luisteren."}, {"s": 1657.31, "e": 1659.23, "t": "Tot de volgende keer!"}, {"s": 1659.23, "e": 1662.04, "t": "Doei, en goede reis!"}]