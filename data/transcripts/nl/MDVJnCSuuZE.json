[{"s": 0.76, "e": 5.56, "t": "Hoi allemaal, ik ben Noella en vandaag"}, {"s": 5.56, "e": 10.2, "t": "laat ik jullie zien wat ik eet."}, {"s": 10.2, "e": 14.48, "t": "Ik heb allemaal thuis eten"}, {"s": 14.48, "e": 19.84, "t": "en ik zal eerst het laten zien."}, {"s": 19.84, "e": 24.44, "t": "Ik heb dit een bakje"}, {"s": 24.44, "e": 26.96, "t": "met rijst."}, {"s": 26.96, "e": 31.04, "t": "Witte rijst heet het."}, {"s": 34.64, "e": 39.12, "t": "Dan heb ik dit pakje"}, {"s": 39.12, "e": 41.64, "t": "met"}, {"s": 41.64, "e": 44.72, "t": "patsu heet het."}, {"s": 44.72, "e": 47.68, "t": "Ik denk dat ik het goed uitspreek. En"}, {"s": 47.68, "e": 52.24, "t": "hierin zitten noedels."}, {"s": 52.24, "e": 56.4, "t": "Kijk, dit zijn de noedels."}, {"s": 57.28, "e": 60.24, "t": "Dit zijn bijzondere noedels, want ze"}, {"s": 60.24, "e": 65.08, "t": "zijn breed, niet smal."}, {"s": 65.08, "e": 68.28, "t": "En volgens mij zijn ze gemaakt van"}, {"s": 68.28, "e": 71.28, "t": "rijst."}, {"s": 72.48, "e": 74.96, "t": "rijst"}, {"s": 74.96, "e": 77.96, "t": "ook zit hier in"}, {"s": 77.96, "e": 80.96, "t": "tofu."}, {"s": 82.04, "e": 87.0, "t": "Dit is tofu en"}, {"s": 87.52, "e": 90.44, "t": "dit is tofu."}, {"s": 90.44, "e": 96.44, "t": "En er zit ook in kol."}, {"s": 96.44, "e": 101.04, "t": "Volgens mij is dit Chinese kol."}, {"s": 101.04, "e": 103.48, "t": "en"}, {"s": 103.48, "e": 106.48, "t": "tauge."}, {"s": 107.28, "e": 110.32, "t": "Zo heet dat in het Nederlands."}, {"s": 110.32, "e": 112.28, "t": "En"}, {"s": 112.28, "e": 115.28, "t": "wortel."}, {"s": 116.32, "e": 118.76, "t": "En ik denk"}, {"s": 118.76, "e": 124.0, "t": "dat dit een soort broccoli is."}, {"s": 124.0, "e": 125.92, "t": "Gesneden."}, {"s": 125.92, "e": 129.6, "t": "Gesneden broccoli."}, {"s": 129.6, "e": 133.88, "t": "En wat nog meer? Ik denk dat dat alle"}, {"s": 133.88, "e": 138.36, "t": "ingrediënten zijn. En dan"}, {"s": 138.36, "e": 141.0, "t": "bakken ze"}, {"s": 141.0, "e": 145.64, "t": "bakken ze het in sojasaus."}, {"s": 145.64, "e": 150.44, "t": "Een beetje zoals dit sojasaus."}, {"s": 151.68, "e": 154.64, "t": "En oeh en"}, {"s": 154.64, "e": 159.44, "t": "limoen. De limoen is eroverheen al. Is"}, {"s": 159.44, "e": 161.72, "t": "er op uitgeknepen."}, {"s": 161.72, "e": 165.36, "t": "Knijpen. Knijpen."}, {"s": 167.04, "e": 170.68, "t": "Dit is wat zie uw"}, {"s": 170.68, "e": 173.84, "t": "Dit vind ik heel lekker."}, {"s": 173.84, "e": 177.2, "t": "Ik kijk er naar uit om het te eten. Maar"}, {"s": 177.2, "e": 179.12, "t": "eerst"}, {"s": 179.12, "e": 182.8, "t": "het volgende gerecht."}, {"s": 182.8, "e": 186.92, "t": "Dat is dit."}, {"s": 187.04, "e": 190.8, "t": "Ik weet niet of dit een naam heeft,"}, {"s": 190.8, "e": 194.16, "t": "maar waar wij het hebben besteld"}, {"s": 194.16, "e": 198.28, "t": "besteld op mijn mobiel"}, {"s": 198.28, "e": 202.04, "t": "eh heet het"}, {"s": 202.04, "e": 203.28, "t": "Mok."}, {"s": 203.28, "e": 205.2, "t": "Pork"}, {"s": 205.2, "e": 209.72, "t": "in red curry sauce. Dus neppe"}, {"s": 209.72, "e": 211.64, "t": "eh"}, {"s": 211.64, "e": 214.72, "t": "neppe varkensvlees"}, {"s": 214.72, "e": 218.56, "t": "in rode curry saus."}, {"s": 218.56, "e": 221.68, "t": "Eh zoals je kan zien zijn er allemaal"}, {"s": 221.68, "e": 224.68, "t": "stukjes."}, {"s": 225.28, "e": 227.72, "t": "Allemaal stukjes"}, {"s": 227.72, "e": 229.88, "t": "vleesvervangers."}, {"s": 229.88, "e": 233.36, "t": "Net als de tofel."}, {"s": 233.36, "e": 236.84, "t": "Dit is stof."}, {"s": 237.08, "e": 240.12, "t": "Is dit een vleesvervanger?"}, {"s": 240.12, "e": 245.48, "t": "Dus iets dat je eet in plaats van vlees."}, {"s": 245.48, "e": 250.0, "t": "En deze zijn heel lekker. Ze zijn heel"}, {"s": 250.0, "e": 253.0, "t": "knapperig"}, {"s": 253.28, "e": 256.88, "t": "en zijn heel lekker van smaak. Van"}, {"s": 256.88, "e": 259.24, "t": "smaak."}, {"s": 259.24, "e": 261.68, "t": "Verder in dit gerecht."}, {"s": 261.68, "e": 265.32, "t": "zijn sperybonen"}, {"s": 266.32, "e": 270.56, "t": "en ook wortel."}, {"s": 271.8, "e": 278.16, "t": "En ik denk dat dit ui is."}, {"s": 279.96, "e": 285.08, "t": "En wat nog meer? Volgens mij basilicum."}, {"s": 285.08, "e": 286.72, "t": "Kijk."}, {"s": 286.72, "e": 292.4, "t": "Oh, hier. Volgens mij is dit basilicum,"}, {"s": 292.4, "e": 294.16, "t": "maar"}, {"s": 294.16, "e": 296.16, "t": "basilicum."}, {"s": 296.16, "e": 299.28, "t": "Dat wordt hier holy bezel genoemd. En"}, {"s": 299.28, "e": 301.44, "t": "het smaakt"}, {"s": 301.44, "e": 305.88, "t": "smaakt anders dan de Europese basilicum"}, {"s": 305.88, "e": 309.76, "t": "of de Italiaanse basilicum."}, {"s": 309.76, "e": 311.72, "t": "En"}, {"s": 311.72, "e": 314.24, "t": "het ruikt er naar."}, {"s": 314.24, "e": 317.92, "t": "En ook zit hier dit in."}, {"s": 317.92, "e": 322.08, "t": "En volgens mij"}, {"s": 322.12, "e": 325.64, "t": "is dit laurierblad."}, {"s": 326.24, "e": 328.28, "t": "Ik denk het, maar ik weet het niet"}, {"s": 328.28, "e": 330.56, "t": "zeker."}, {"s": 330.56, "e": 333.32, "t": "Het ruikt zo lekker"}, {"s": 333.32, "e": 337.2, "t": "en elke keer dat dit in een gerecht is,"}, {"s": 337.2, "e": 340.04, "t": "vind ik het heel lekker."}, {"s": 340.04, "e": 343.28, "t": "Dus ja, ik weet niet wat het is. Ik denk"}, {"s": 343.28, "e": 345.96, "t": "laurierblad."}, {"s": 345.96, "e": 349.44, "t": "En volgens mij zit er nog iets in hier."}, {"s": 349.44, "e": 351.56, "t": "Oh ja, kijk."}, {"s": 351.56, "e": 353.8, "t": "Chili"}, {"s": 353.8, "e": 356.52, "t": "of rode peper."}, {"s": 356.52, "e": 359.48, "t": "Dat is heel heet,"}, {"s": 359.48, "e": 361.52, "t": "heel pittig."}, {"s": 361.52, "e": 365.6, "t": "Het voelt alsof je mond in brand staat."}, {"s": 365.6, "e": 372.52, "t": "Dus dit gerecht is pittig of is scherp."}, {"s": 372.52, "e": 376.24, "t": "Deze haal ik eruit."}, {"s": 376.24, "e": 380.72, "t": "Anders is het te pittig."}, {"s": 380.72, "e": 386.0, "t": "Even kijken of er nog meer in zit."}, {"s": 386.0, "e": 391.0, "t": "Oh, nog een blad."}, {"s": 392.72, "e": 396.12, "t": "Even kijken."}, {"s": 397.24, "e": 399.96, "t": "Nee, dat was het denk ik."}, {"s": 399.96, "e": 404.12, "t": "Oké, ik ga een beetje hiervan eten. Ik"}, {"s": 404.12, "e": 407.68, "t": "heb heel erg trek."}, {"s": 408.84, "e": 411.84, "t": "H"}, {"s": 427.2, "e": 430.92, "t": "ik verslik me. Dit is niet omdat het"}, {"s": 430.92, "e": 435.64, "t": "pittig is, maar ik verslik me."}, {"s": 435.64, "e": 439.36, "t": "Het ging in het verkeerde keelgat."}, {"s": 439.36, "e": 441.92, "t": "Ik heb even wat water nodig. Ik ga water"}, {"s": 441.92, "e": 444.92, "t": "pakken."}, {"s": 448.04, "e": 451.96, "t": "Ah, ik heb water."}, {"s": 453.88, "e": 456.36, "t": "Zo,"}, {"s": 456.36, "e": 459.32, "t": "beter."}, {"s": 459.32, "e": 461.32, "t": "Oké,"}, {"s": 461.32, "e": 463.32, "t": "volgende poging."}, {"s": 463.32, "e": 465.4, "t": "Oh, nog een stuk chili. Nog een stuk"}, {"s": 465.4, "e": 468.28, "t": "zien jullie. Oké,"}, {"s": 468.28, "e": 474.72, "t": "ik denk dat ik wat rijst pak"}, {"s": 475.4, "e": 479.88, "t": "met deze lepel. Ik heb net gegeten met"}, {"s": 479.88, "e": 481.44, "t": "eetstokjes."}, {"s": 481.44, "e": 484.96, "t": "Dit zijn eetstokjes,"}, {"s": 485.52, "e": 489.12, "t": "maar het is ietsjes makkelijker"}, {"s": 489.12, "e": 494.04, "t": "denk ik met een lepel."}, {"s": 494.08, "e": 498.36, "t": "Dus ik pak wat rijstrij"}, {"s": 503.04, "e": 507.0, "t": "van dit gerecht"}, {"s": 507.24, "e": 511.24, "t": "en een stukje vleesvervanger,"}, {"s": 511.24, "e": 515.04, "t": "wortel en sperboon"}, {"s": 517.84, "e": 521.76, "t": "en een beetje basilicum."}, {"s": 522.56, "e": 525.56, "t": "Oh,"}, {"s": 528.12, "e": 531.4, "t": "en ui."}, {"s": 541.0, "e": 544.0, "t": "H,"}, {"s": 549.88, "e": 551.36, "t": "heel lekker."}, {"s": 551.36, "e": 555.28, "t": "Ik neem nog een hap."}, {"s": 566.08, "e": 569.52, "t": "Ik had heel erg honger."}, {"s": 569.52, "e": 574.44, "t": "Mijn buik zei: \"Ik wil eten.\""}, {"s": 577.72, "e": 583.8, "t": "Zo. Oké, laatste hap van deze."}, {"s": 584.28, "e": 587.28, "t": "Hm."}, {"s": 595.64, "e": 599.0, "t": "Mag ik die?"}, {"s": 600.12, "e": 603.12, "t": "Dankjewel."}, {"s": 603.56, "e": 607.72, "t": "En dan nu een paar happen van deze."}, {"s": 607.72, "e": 611.04, "t": "Dit is makkelijker met een stokje."}, {"s": 611.04, "e": 614.4, "t": "Kijk, ik pak gewoon zo"}, {"s": 614.4, "e": 617.64, "t": "een stukje"}, {"s": 623.64, "e": 626.28, "t": "met de Chinese kom"}, {"s": 626.28, "e": 629.4, "t": "en de noedel"}, {"s": 629.4, "e": 633.36, "t": "en wat wortel."}, {"s": 633.36, "e": 636.36, "t": "Zo,"}, {"s": 646.56, "e": 649.76, "t": "deze is ook heel lekker. Deze is niet"}, {"s": 649.76, "e": 653.12, "t": "pittig. Deze is een beetje zoet. Klein"}, {"s": 653.12, "e": 654.84, "t": "beetje zoet."}, {"s": 654.84, "e": 657.8, "t": "En dat vind ik fijn omdat die andere een"}, {"s": 657.8, "e": 661.4, "t": "beetje pittig is om dan iets anders te"}, {"s": 661.4, "e": 664.96, "t": "hebben dat niet pittig is. D zodat mijn"}, {"s": 664.96, "e": 669.56, "t": "mond kan rusten."}, {"s": 670.8, "e": 676.56, "t": "Zo, kijk, een stukje met tofu en kol"}, {"s": 676.56, "e": 679.88, "t": "en wortel."}, {"s": 687.2, "e": 690.52, "t": "En de broccoli,"}, {"s": 692.68, "e": 696.52, "t": "die is heel knapperig,"}, {"s": 697.56, "e": 701.88, "t": "niet zacht, maar knapperig."}, {"s": 702.08, "e": 705.4, "t": "En de noedels zijn heel zacht. Daar hoef"}, {"s": 705.4, "e": 710.32, "t": "ik niet heel veel op te kouwen."}, {"s": 717.44, "e": 720.24, "t": "Oh,"}, {"s": 720.24, "e": 724.52, "t": "dat was zelde rij denk ik."}, {"s": 728.96, "e": 733.72, "t": "Zo, laatste hapje voor nu met noedel en"}, {"s": 733.72, "e": 736.72, "t": "de broccoli denk ik. Oh oh ja, je kunt"}, {"s": 736.72, "e": 739.92, "t": "het zien. Misschien brocolini."}, {"s": 739.92, "e": 744.68, "t": "Dat is hier wel vaker in gerechten."}, {"s": 750.24, "e": 751.6, "t": "Oké."}, {"s": 751.6, "e": 754.2, "t": "Nou, nu hebben jullie gezien wat ik heb"}, {"s": 754.2, "e": 759.6, "t": "gegeten. Ik ga verder eten en dan tot de"}, {"s": 759.6, "e": 761.84, "t": "volgende keer."}, {"s": 761.84, "e": 765.12, "t": "Doeg. Doeg."}, {"s": 766.64, "e": 772.36, "t": "Op mijn lepel dus rijst en de basilicum"}, {"s": 772.36, "e": 776.96, "t": "en de wortel."}, {"s": 781.4, "e": 784.56, "t": "My life"}, {"s": 786.04, "e": 788.8, "t": "steak"}]