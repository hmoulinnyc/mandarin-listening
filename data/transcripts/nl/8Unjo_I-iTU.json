[{"s": 0.0, "e": 2.27, "t": "Hoofdstuk 1:"}, {"s": 2.27, "e": 3.6, "t": "Ik word wakker."}, {"s": 3.6, "e": 5.96, "t": "Ik word wakker."}, {"s": 5.96, "e": 9.2, "t": "Het daglicht komt zacht door het raam."}, {"s": 9.2, "e": 11.7, "t": "Ik open langzaam mijn ogen."}, {"s": 11.7, "e": 13.45, "t": "Ik ben nog moe."}, {"s": 13.45, "e": 16.14, "t": "Ik wil nog even slapen."}, {"s": 16.14, "e": 18.55, "t": "Maar het is vroeg in de ochtend."}, {"s": 18.55, "e": 21.66, "t": "Dus draai ik me nog een keer om in bed."}, {"s": 21.66, "e": 24.16, "t": "Ik adem diep in."}, {"s": 24.16, "e": 25.65, "t": "Het is rustig."}, {"s": 25.65, "e": 27.4, "t": "Ik kijk rond."}, {"s": 27.4, "e": 28.73, "t": "De dag begint."}, {"s": 28.73, "e": 33.17, "t": "Ik zeg tegen mezelf: goedemorgen."}, {"s": 33.17, "e": 36.96, "t": "Dat zijn mijn eerste woorden in het Nederlands vandaag."}, {"s": 36.96, "e": 40.49, "t": "Ik wil elke dag Nederlands spreken."}, {"s": 40.49, "e": 42.29, "t": "Dus begin ik nu."}, {"s": 42.29, "e": 46.42, "t": "Ook als ik alleen ben, zeg ik: goedemorgen."}, {"s": 46.42, "e": 48.12, "t": "Dat voelt goed."}, {"s": 48.12, "e": 51.41, "t": "Mijn stem is zacht, maar ik hoor hem."}, {"s": 51.41, "e": 53.16, "t": "Ik begrijp hem."}, {"s": 53.16, "e": 57.29, "t": "Het is een kleine stap, maar een grote vooruitgang."}, {"s": 57.29, "e": 58.57, "t": "Ik sta op."}, {"s": 58.57, "e": 60.47, "t": "Ik strek mijn armen."}, {"s": 60.47, "e": 62.69, "t": "Ik ga naar de badkamer."}, {"s": 62.69, "e": 64.36, "t": "Ik kijk in de spiegel."}, {"s": 64.36, "e": 66.17, "t": "Ik lach."}, {"s": 66.17, "e": 68.26, "t": "Ik poets mijn tanden."}, {"s": 68.26, "e": 70.66, "t": "Ik pak mijn tandenborstel."}, {"s": 70.66, "e": 75.26, "t": "Ik zeg: dit is mijn tandenborstel."}, {"s": 75.26, "e": 77.77, "t": "Ik begin mijn tanden te poetsen."}, {"s": 77.77, "e": 80.35, "t": "Een, twee, drie."}, {"s": 80.35, "e": 82.81, "t": "Ik tel in het Nederlands."}, {"s": 82.81, "e": 85.63, "t": "Dat helpt mij in de taal te blijven."}, {"s": 85.63, "e": 87.95, "t": "Dan was ik mijn gezicht."}, {"s": 87.95, "e": 89.94, "t": "Het water is koud."}, {"s": 89.94, "e": 93.28, "t": "Ik zeg: ik was mijn gezicht."}, {"s": 93.28, "e": 95.19, "t": "Ik kijk weer in de spiegel."}, {"s": 95.19, "e": 98.79, "t": "Ik zeg: ik zie er moe uit."}, {"s": 98.79, "e": 100.78, "t": "Maar ik voel me goed."}, {"s": 100.78, "e": 102.71, "t": "Ik ga terug naar de kamer."}, {"s": 102.71, "e": 104.52, "t": "Ik kleed me aan."}, {"s": 104.52, "e": 108.3, "t": "Ik zeg: ik hou van mijn kleren."}, {"s": 108.3, "e": 110.34, "t": "Ik kies een T-shirt."}, {"s": 110.34, "e": 113.92, "t": "Ik zeg: dit T-shirt is blauw."}, {"s": 113.92, "e": 115.72, "t": "Ik trek een broek aan."}, {"s": 115.72, "e": 118.54, "t": "Ik zeg: dit is mijn broek."}, {"s": 118.54, "e": 120.53, "t": "Ik zit een moment."}, {"s": 120.53, "e": 122.02, "t": "Ik kijk uit het raam."}, {"s": 122.02, "e": 124.84, "t": "Ik zeg: het is mooi."}, {"s": 124.84, "e": 128.18, "t": "Of: het is grijs."}, {"s": 128.18, "e": 130.27, "t": "Elke zin is een kans."}, {"s": 130.27, "e": 133.56, "t": "Elk woord is een stap naar Nederlands."}, {"s": 133.56, "e": 137.22, "t": "Vroeger was het vreemd om alleen te spreken."}, {"s": 137.22, "e": 139.02, "t": "Maar nu is het normaal."}, {"s": 139.02, "e": 141.97, "t": "Dat is mijn geheim om te oefenen."}, {"s": 141.97, "e": 144.32, "t": "Ik heb geen cursus nodig."}, {"s": 144.32, "e": 146.54, "t": "Ik heb geen partner nodig."}, {"s": 146.54, "e": 150.33, "t": "Ik moet alleen over mijn echte leven praten."}, {"s": 150.33, "e": 152.74, "t": "En de ochtend is perfect."}, {"s": 152.74, "e": 155.69, "t": "Want elke ochtend begint hetzelfde."}, {"s": 155.69, "e": 158.09, "t": "Ik kan dezelfde dingen herhalen."}, {"s": 158.09, "e": 160.91, "t": "En dat is super om te leren."}, {"s": 160.91, "e": 164.67, "t": "Toen ik begon, wist ik niet wat ik moest zeggen."}, {"s": 164.67, "e": 166.9, "t": "Ik kende maar weinig woorden."}, {"s": 166.9, "e": 168.18, "t": "Wakker worden."}, {"s": 168.18, "e": 169.98, "t": "Tanden poetsen."}, {"s": 169.98, "e": 171.73, "t": "Eten."}, {"s": 171.73, "e": 173.4, "t": "Maar ik zei ze."}, {"s": 173.4, "e": 174.97, "t": "Elke dag."}, {"s": 174.97, "e": 177.66, "t": "En mijn hoofd begon ze te onthouden."}, {"s": 177.66, "e": 179.56, "t": "De woorden werden makkelijker."}, {"s": 179.56, "e": 181.26, "t": "De zinnen werden langer."}, {"s": 181.26, "e": 185.39, "t": "Nu zeg ik: ik word om zeven uur wakker."}, {"s": 185.39, "e": 187.24, "t": "Ik poets mijn tanden."}, {"s": 187.24, "e": 188.52, "t": "Ik was mijn gezicht."}, {"s": 188.52, "e": 190.74, "t": "Ik voel me goed."}, {"s": 190.74, "e": 193.2, "t": "Dat zijn kleine stappen."}, {"s": 193.2, "e": 195.94, "t": "Maar dat zijn overwinningen."}, {"s": 195.94, "e": 198.63, "t": "Soms gebruik ik mijn telefoon."}, {"s": 198.63, "e": 200.2, "t": "Ik open de camera."}, {"s": 200.2, "e": 202.05, "t": "Ik kijk naar mezelf."}, {"s": 202.06, "e": 204.22, "t": "Ik zeg: goedemorgen."}, {"s": 204.22, "e": 206.31, "t": "Vandaag is het maandag."}, {"s": 206.31, "e": 207.88, "t": "Ik voel me blij."}, {"s": 207.88, "e": 209.63, "t": "Ik neem mezelf op."}, {"s": 209.63, "e": 211.01, "t": "Ik luister."}, {"s": 211.01, "e": 212.29, "t": "Ik lach."}, {"s": 212.29, "e": 214.99, "t": "Ik maak vooruitgang."}, {"s": 214.99, "e": 218.75, "t": "Ook al is het niet perfect, het is een stap."}, {"s": 218.75, "e": 221.52, "t": "Veel mensen durven niet te spreken."}, {"s": 221.52, "e": 224.47, "t": "Ze wachten op de perfecte zin."}, {"s": 224.47, "e": 225.85, "t": "Maar ik wacht niet."}, {"s": 225.85, "e": 227.6, "t": "Ik spreek."}, {"s": 227.6, "e": 229.59, "t": "Ook al is het eenvoudig."}, {"s": 229.59, "e": 231.57, "t": "Ook al is het langzaam."}, {"s": 231.57, "e": 233.01, "t": "Ik spreek."}, {"s": 233.01, "e": 234.58, "t": "Zo groei ik."}, {"s": 234.58, "e": 236.69, "t": "En jij kunt ook groeien."}, {"s": 236.69, "e": 239.7, "t": "Je hebt geen moeilijke grammatica nodig."}, {"s": 239.7, "e": 242.21, "t": "Je hebt geen moeilijke woorden nodig."}, {"s": 242.21, "e": 244.43, "t": "Zeg gewoon wat je doet."}, {"s": 244.43, "e": 246.41, "t": "Zeg wat je ziet."}, {"s": 246.41, "e": 248.08, "t": "Zeg wat je voelt."}, {"s": 248.08, "e": 250.85, "t": "Zo wordt Nederlands jouw taal."}, {"s": 250.85, "e": 252.52, "t": "Hoofdstuk 2:"}, {"s": 252.52, "e": 254.09, "t": "Ik ontbijt."}, {"s": 254.09, "e": 256.68, "t": "Na het klaarmaken heb ik honger."}, {"s": 256.68, "e": 258.38, "t": "Mijn buik maakt geluid."}, {"s": 258.38, "e": 260.6, "t": "Hij zegt: eet iets."}, {"s": 260.6, "e": 262.69, "t": "Dus ga ik naar de keuken."}, {"s": 262.69, "e": 266.16, "t": "Ik zeg: ik ontbijt."}, {"s": 266.16, "e": 270.0, "t": "Deze woorden zijn mijn nieuwe gewoonte in het Nederlands."}, {"s": 270.0, "e": 271.91, "t": "Ik zeg ze langzaam."}, {"s": 271.91, "e": 273.6, "t": "Ik ontbijt."}, {"s": 273.6, "e": 275.12, "t": "Ik open de kast."}, {"s": 275.12, "e": 276.92, "t": "Ik pak een bord."}, {"s": 276.92, "e": 280.03, "t": "Ik zeg: dit is mijn bord."}, {"s": 280.03, "e": 281.73, "t": "Ik open de koelkast."}, {"s": 281.73, "e": 283.11, "t": "Ik zie eieren."}, {"s": 283.11, "e": 285.62, "t": "Ik zeg: ik eet eieren."}, {"s": 285.62, "e": 287.06, "t": "Ik pak brood."}, {"s": 287.06, "e": 289.64, "t": "Ik zeg: ik hou van brood."}, {"s": 289.64, "e": 291.55, "t": "Ik zie boter."}, {"s": 291.55, "e": 295.99, "t": "Ik zeg: ik smeer boter op het brood."}, {"s": 295.99, "e": 298.5, "t": "Elke handeling wordt een zin."}, {"s": 298.5, "e": 301.03, "t": "Elke zin wordt een oefening."}, {"s": 301.03, "e": 304.32, "t": "Ik heb geen moeilijke grammatica nodig."}, {"s": 304.32, "e": 307.28, "t": "Ik heb alleen mijn echte leven nodig."}, {"s": 307.28, "e": 309.73, "t": "Ik ga aan tafel zitten."}, {"s": 309.73, "e": 312.5, "t": "Ik zeg: ik ga aan tafel zitten."}, {"s": 312.5, "e": 314.01, "t": "Ik neem een hap."}, {"s": 314.01, "e": 317.49, "t": "Ik zeg: ik eet mijn ontbijt."}, {"s": 317.49, "e": 319.0, "t": "Ik drink water."}, {"s": 319.0, "e": 322.17, "t": "Ik zeg: ik drink water."}, {"s": 322.17, "e": 327.08, "t": "Als ik thee drink, zeg ik: ik drink thee."}, {"s": 327.08, "e": 331.33, "t": "Als ik fruit eet, zeg ik: ik eet een banaan."}, {"s": 331.33, "e": 335.23, "t": "Dat is een eenvoudige zin, maar hij telt."}, {"s": 335.23, "e": 337.26, "t": "Ik lees geen boek."}, {"s": 337.26, "e": 339.2, "t": "Ik maak geen oefening."}, {"s": 339.2, "e": 341.6, "t": "Ik leef in het Nederlands."}, {"s": 341.6, "e": 344.66, "t": "En dat is de beste methode."}, {"s": 344.66, "e": 347.01, "t": "Op sommige dagen eet ik alleen."}, {"s": 347.01, "e": 349.7, "t": "Soms eet ik met mijn familie."}, {"s": 349.7, "e": 353.12, "t": "Ik zeg: ik eet met mijn moeder."}, {"s": 353.12, "e": 355.58, "t": "Of mijn broer eet met mij."}, {"s": 355.58, "e": 357.9, "t": "Ik stel kleine vragen."}, {"s": 357.9, "e": 359.42, "t": "Wil je thee."}, {"s": 359.42, "e": 360.7, "t": "Dat is genoeg."}, {"s": 360.7, "e": 364.82, "t": "Ook al zijn het eenvoudige zinnen, ze zijn sterk."}, {"s": 364.82, "e": 367.77, "t": "Want ik gebruik ze in mijn echte leven."}, {"s": 367.77, "e": 369.89, "t": "En ik maak vooruitgang."}, {"s": 369.89, "e": 372.06, "t": "Soms ben ik lui."}, {"s": 372.06, "e": 374.46, "t": "Ik heb geen zin om te oefenen."}, {"s": 374.46, "e": 376.79, "t": "Maar ik herinner mezelf."}, {"s": 376.79, "e": 380.21, "t": "Nederlands leren is niet alleen voor school."}, {"s": 380.21, "e": 382.66, "t": "Het is voor het leven."}, {"s": 382.66, "e": 387.21, "t": "Als ik kan zeggen: ik eet brood, dan leer ik al."}, {"s": 387.21, "e": 389.48, "t": "Ik zeg ook hoe ik me voel."}, {"s": 389.48, "e": 392.02, "t": "Ik zeg: ik ben blij."}, {"s": 392.02, "e": 394.11, "t": "Of ik ben nog wat moe."}, {"s": 394.11, "e": 397.87, "t": "Ik zeg: de thee is heet."}, {"s": 397.87, "e": 399.62, "t": "Hij doet me goed."}, {"s": 399.62, "e": 402.86, "t": "Ik praat over mijn wereld in het Nederlands."}, {"s": 402.86, "e": 405.78, "t": "En stukje bij beetje voel ik me zekerder."}, {"s": 405.78, "e": 408.55, "t": "Ik maak ook video’s met mijn telefoon."}, {"s": 408.55, "e": 410.88, "t": "Ik zeg: goedemorgen."}, {"s": 410.88, "e": 413.41, "t": "Vandaag eet ik brood en eieren."}, {"s": 413.41, "e": 414.74, "t": "Ik drink thee."}, {"s": 414.74, "e": 416.26, "t": "Ik voel me goed."}, {"s": 416.26, "e": 418.66, "t": "Dan kijk ik de video."}, {"s": 418.66, "e": 421.67, "t": "Ik zeg tegen mezelf: dat is mooi."}, {"s": 421.67, "e": 423.47, "t": "Ik spreek Nederlands."}, {"s": 423.47, "e": 428.2, "t": "Toen ik begon, zei ik alleen: eten, thee, brood."}, {"s": 428.2, "e": 431.85, "t": "Nu kan ik zeggen: ik ontbijt elke dag."}, {"s": 431.85, "e": 433.97, "t": "Ik hou van thee."}, {"s": 433.97, "e": 436.79, "t": "Ik voel me goed na het eten."}, {"s": 436.79, "e": 441.57, "t": "Dat zijn hele zinnen en ze zijn het resultaat van kleine oefeningen."}, {"s": 441.57, "e": 444.21, "t": "Je hebt geen leraar nodig."}, {"s": 444.21, "e": 446.38, "t": "Jij bent je eigen leraar."}, {"s": 446.38, "e": 448.13, "t": "Kijk naar je eten."}, {"s": 448.13, "e": 449.98, "t": "Praat over wat je ziet."}, {"s": 449.98, "e": 456.62, "t": "Zeg: dat is zoet, dat is heet, ik hou daarvan, ik hou daar niet van."}, {"s": 456.62, "e": 460.38, "t": "Ook al is het maar één zin, zeg hem."}, {"s": 460.38, "e": 461.89, "t": "Je hoofd luistert."}, {"s": 461.89, "e": 464.01, "t": "Je tong onthoudt het."}, {"s": 464.01, "e": 466.41, "t": "Zoek niet naar perfectie."}, {"s": 466.41, "e": 468.95, "t": "Gebruik het Nederlands dat je kent."}, {"s": 468.95, "e": 470.57, "t": "Spreek langzaam."}, {"s": 470.57, "e": 472.26, "t": "Spreek duidelijk."}, {"s": 472.26, "e": 475.08, "t": "Spreek met je hart."}, {"s": 475.08, "e": 476.99, "t": "Hoofdstuk 3:"}, {"s": 476.99, "e": 479.94, "t": "Ik ga naar school of naar mijn werk."}, {"s": 479.94, "e": 483.42, "t": "Na het ontbijt maak ik me klaar om te gaan."}, {"s": 483.42, "e": 485.35, "t": "Ik pak mijn tas."}, {"s": 485.35, "e": 488.17, "t": "Ik zeg: ik ga naar school."}, {"s": 488.17, "e": 491.54, "t": "Of ik zeg: ik ga naar mijn werk."}, {"s": 491.54, "e": 494.05, "t": "Dat zijn eenvoudige zinnen."}, {"s": 494.05, "e": 495.8, "t": "Maar ze zijn echt."}, {"s": 495.8, "e": 498.07, "t": "En ik zeg ze elke dag."}, {"s": 498.07, "e": 500.19, "t": "Ze worden mijn oefenzinnen."}, {"s": 500.19, "e": 501.76, "t": "Ik ga naar de deur."}, {"s": 501.76, "e": 505.18, "t": "Ik zeg: ik verlaat het huis."}, {"s": 505.18, "e": 507.21, "t": "Ik sluit de deur."}, {"s": 507.21, "e": 511.05, "t": "Ik zeg: ik doe de deur op slot."}, {"s": 511.06, "e": 513.38, "t": "Ik adem diep in."}, {"s": 513.38, "e": 516.02, "t": "Een nieuw deel van mijn dag begint."}, {"s": 516.02, "e": 520.2, "t": "Ik wil Nederlands in elk moment van mijn dag spreken."}, {"s": 520.2, "e": 522.6, "t": "Dit deel is de weg."}, {"s": 522.6, "e": 524.51, "t": "Ik loop op straat."}, {"s": 524.51, "e": 526.0, "t": "Ik kijk rond."}, {"s": 526.0, "e": 528.64, "t": "Ik zie auto’s, fietsen, mensen."}, {"s": 528.64, "e": 531.8, "t": "Ik zeg: ik zie auto’s."}, {"s": 531.8, "e": 533.47, "t": "Ik zie mensen."}, {"s": 533.47, "e": 535.09, "t": "Ik loop verder."}, {"s": 535.09, "e": 538.25, "t": "Ik zeg: ik loop naar school."}, {"s": 538.25, "e": 542.04, "t": "Of ik zeg: ik loop naar de bushalte."}, {"s": 542.04, "e": 544.54, "t": "Dat zijn eenvoudige woorden."}, {"s": 544.54, "e": 547.42, "t": "Maar ze zijn deel van mijn leven."}, {"s": 547.42, "e": 549.27, "t": "Ik zeg ze langzaam."}, {"s": 549.27, "e": 551.91, "t": "Ik voel me sterk als ik ze spreek."}, {"s": 551.91, "e": 556.69, "t": "Als ik de bus neem, zeg ik: ik wacht op de bus."}, {"s": 556.69, "e": 560.87, "t": "Als de bus komt, zeg ik: de bus is er."}, {"s": 560.87, "e": 562.2, "t": "Ik stap in."}, {"s": 562.2, "e": 565.08, "t": "Ik zeg: ik stap in de bus."}, {"s": 565.08, "e": 567.01, "t": "Ik ga zitten."}, {"s": 567.01, "e": 570.61, "t": "Ik zeg: ik zit bij het raam."}, {"s": 570.61, "e": 572.6, "t": "Ik kijk naar buiten."}, {"s": 572.6, "e": 575.66, "t": "Ik zeg: ik zie bomen."}, {"s": 575.66, "e": 577.59, "t": "Ik zie winkels."}, {"s": 577.59, "e": 579.99, "t": "Deze zinnen zijn klein."}, {"s": 579.99, "e": 581.85, "t": "Maar ze zijn echt."}, {"s": 581.85, "e": 584.49, "t": "En ik zeg ze in het Nederlands."}, {"s": 584.49, "e": 587.44, "t": "Op sommige dagen neem ik de fiets."}, {"s": 587.44, "e": 591.38, "t": "Ik zeg: ik neem mijn fiets."}, {"s": 591.38, "e": 593.91, "t": "Op andere dagen rijd ik met de auto."}, {"s": 593.91, "e": 597.62, "t": "Ik zeg: ik rijd met de auto."}, {"s": 597.62, "e": 600.63, "t": "Ik praat ook over mijn gevoelens."}, {"s": 600.63, "e": 602.33, "t": "Ik zeg: ik ben moe."}, {"s": 602.33, "e": 604.18, "t": "Of ik ben blij."}, {"s": 604.18, "e": 606.87, "t": "Of ik ben gestrest."}, {"s": 606.87, "e": 611.05, "t": "Deze woorden helpen mij te laten zien hoe ik me voel."}, {"s": 611.05, "e": 613.82, "t": "Het gaat niet alleen om handelingen."}, {"s": 613.82, "e": 616.17, "t": "Het gaat ook om gevoelens."}, {"s": 616.17, "e": 619.83, "t": "En dat maakt mijn Nederlands echter."}, {"s": 619.83, "e": 621.87, "t": "Ik kijk naar buiten."}, {"s": 621.87, "e": 624.45, "t": "Ik zeg: het is acht uur."}, {"s": 624.45, "e": 628.06, "t": "Woorden voor de tijd helpen mij betere zinnen te maken."}, {"s": 628.06, "e": 630.75, "t": "Ik ga om acht uur naar school."}, {"s": 630.75, "e": 633.67, "t": "Ik kom om kwart over acht aan."}, {"s": 633.67, "e": 638.04, "t": "Dat zijn nuttige zinnen die ik elke ochtend kan zeggen."}, {"s": 638.04, "e": 640.78, "t": "Als iemand bij me is, praat ik met hem."}, {"s": 640.78, "e": 644.15, "t": "Ik zeg: ben je klaar."}, {"s": 644.15, "e": 645.4, "t": "Hij lacht."}, {"s": 645.4, "e": 647.44, "t": "Hij antwoordt mij."}, {"s": 647.44, "e": 649.84, "t": "En dat is een echt gesprek."}, {"s": 649.84, "e": 652.72, "t": "Ik heb geen lange tekst nodig."}, {"s": 652.72, "e": 656.09, "t": "Een vraag, een antwoord."}, {"s": 656.09, "e": 658.62, "t": "Dat is genoeg om te beginnen."}, {"s": 658.62, "e": 663.66, "t": "Ik herinner me de eerste keer dat ik zei: ik ga naar school."}, {"s": 663.66, "e": 665.46, "t": "Het was vreemd."}, {"s": 665.46, "e": 668.76, "t": "Mijn stem was zwak, ik was bang."}, {"s": 668.76, "e": 673.9, "t": "Maar nu zeg ik het zeker, omdat ik het steeds weer heb gezegd."}, {"s": 673.9, "e": 676.07, "t": "Dat is het geheim."}, {"s": 676.07, "e": 677.92, "t": "Elke dag herhalen."}, {"s": 677.92, "e": 681.16, "t": "Als ik thuis blijf, kan ik ook oefenen."}, {"s": 681.16, "e": 684.64, "t": "Ik zeg: ik loop in het huis."}, {"s": 684.64, "e": 686.81, "t": "Of ik ga naar de keuken."}, {"s": 686.81, "e": 688.79, "t": "Of ik zit op mijn stoel."}, {"s": 688.79, "e": 692.55, "t": "Mijn huis heeft veel mogelijkheden om te spreken."}, {"s": 692.55, "e": 695.84, "t": "Sommigen wachten op een cursus om te spreken."}, {"s": 695.84, "e": 698.67, "t": "Maar wij hoeven niet te wachten."}, {"s": 698.67, "e": 701.49, "t": "Wij kunnen al pratend lopen."}, {"s": 701.49, "e": 704.23, "t": "Wij kunnen in de bus spreken."}, {"s": 704.23, "e": 707.6, "t": "Wij kunnen met onszelf praten."}, {"s": 707.6, "e": 709.27, "t": "Dat is niet vreemd."}, {"s": 709.27, "e": 711.07, "t": "Dat is slim."}, {"s": 711.07, "e": 713.16, "t": "Ik denk ook in het Nederlands."}, {"s": 713.16, "e": 716.09, "t": "Ik zie iemand en ik denk."}, {"s": 716.09, "e": 717.37, "t": "Hij loopt."}, {"s": 717.37, "e": 719.72, "t": "Of zij praat aan de telefoon."}, {"s": 719.72, "e": 722.83, "t": "Deze kleine gedachten zijn een oefening."}, {"s": 722.83, "e": 726.25, "t": "Ze zijn stil, maar sterk."}, {"s": 726.25, "e": 729.73, "t": "Een keer vroeg een toerist mij."}, {"s": 729.73, "e": 731.84, "t": "Waar is het station."}, {"s": 731.84, "e": 733.54, "t": "Ik antwoordde."}, {"s": 733.54, "e": 735.63, "t": "Ga rechtdoor."}, {"s": 735.63, "e": 737.61, "t": "Dan rechts afslaan."}, {"s": 737.61, "e": 740.38, "t": "Het was eenvoudig, maar hij begreep het."}, {"s": 740.38, "e": 741.9, "t": "Hij zei dank je."}, {"s": 741.9, "e": 744.54, "t": "Dit moment gaf mij kracht."}, {"s": 744.54, "e": 749.03, "t": "Ik begreep dat ik Nederlands in het echte leven kan spreken."}, {"s": 749.03, "e": 754.7, "t": "Dus vandaag, als jij naar school of naar je werk gaat, spreek."}, {"s": 754.7, "e": 756.32, "t": "Zeg wat je doet."}, {"s": 756.32, "e": 757.88, "t": "Zeg wat je ziet."}, {"s": 757.88, "e": 759.92, "t": "Zeg wat je voelt."}, {"s": 759.92, "e": 762.43, "t": "Ook twee woorden zijn goed."}, {"s": 762.43, "e": 765.07, "t": "Ook één zin is nuttig."}, {"s": 765.07, "e": 766.69, "t": "Hoofdstuk 4:"}, {"s": 766.69, "e": 768.73, "t": "Ik werk of ik leer."}, {"s": 768.73, "e": 770.4, "t": "Ik kom aan."}, {"s": 770.4, "e": 773.74, "t": "Ik ben op school of op mijn werk."}, {"s": 773.74, "e": 775.83, "t": "Ik adem diep in."}, {"s": 775.83, "e": 777.22, "t": "Mijn dag begint."}, {"s": 777.22, "e": 780.04, "t": "Ik zeg: ik begin met werken."}, {"s": 780.04, "e": 782.57, "t": "Of ik begin met de les."}, {"s": 782.57, "e": 786.23, "t": "Dat helpt mij om mijn dag in het Nederlands te starten."}, {"s": 786.23, "e": 787.98, "t": "Ik ga zitten."}, {"s": 787.98, "e": 790.09, "t": "Ik open mijn tas."}, {"s": 790.09, "e": 794.04, "t": "Ik zeg: ik open mijn tas."}, {"s": 794.04, "e": 795.71, "t": "Ik pak mijn schrift."}, {"s": 795.71, "e": 799.0, "t": "Ik zeg: dit is mijn schrift."}, {"s": 799.0, "e": 800.93, "t": "Ik schrijf erin."}, {"s": 800.93, "e": 802.45, "t": "Ik pak een pen."}, {"s": 802.45, "e": 805.51, "t": "Ik zeg: dit is mijn pen."}, {"s": 805.51, "e": 808.04, "t": "Ik gebruik hem elke dag."}, {"s": 808.04, "e": 809.89, "t": "Ik kijk op de klok."}, {"s": 809.89, "e": 813.19, "t": "Ik zeg: het is negen uur."}, {"s": 813.19, "e": 814.8, "t": "Ik begin."}, {"s": 814.8, "e": 817.57, "t": "Op school luister ik naar de leraar."}, {"s": 817.57, "e": 820.76, "t": "Ik zeg: ik luister goed."}, {"s": 820.76, "e": 822.67, "t": "Ik lees wat op het bord staat."}, {"s": 822.67, "e": 825.49, "t": "Ik zeg: ik lees wat er staat."}, {"s": 825.49, "e": 827.48, "t": "Ik maak notities."}, {"s": 827.48, "e": 830.84, "t": "Ik zeg: ik schrijf wat ik leer."}, {"s": 830.84, "e": 833.67, "t": "Elke handeling is een zin."}, {"s": 833.67, "e": 836.2, "t": "Elke zin is een oefening."}, {"s": 836.2, "e": 838.73, "t": "Op het werk zit ik aan mijn bureau."}, {"s": 838.73, "e": 841.66, "t": "Ik zeg: ik werk aan mijn bureau."}, {"s": 841.66, "e": 843.88, "t": "Ik typ op de computer."}, {"s": 843.88, "e": 846.57, "t": "Ik zeg: ik typ berichten."}, {"s": 846.57, "e": 848.84, "t": "Ik controleer mijn e-mails."}, {"s": 848.84, "e": 850.96, "t": "Ik praat met mijn collega’s."}, {"s": 850.96, "e": 855.03, "t": "Ik zeg: ik praat met mijn team."}, {"s": 855.03, "e": 857.2, "t": "Soms is mijn hoofd moe."}, {"s": 857.2, "e": 859.32, "t": "Nederlands lijkt zwaar."}, {"s": 859.32, "e": 860.7, "t": "Dan stop ik even."}, {"s": 860.7, "e": 861.9, "t": "Ik adem."}, {"s": 861.9, "e": 865.01, "t": "Ik zeg: dat is normaal."}, {"s": 865.01, "e": 866.94, "t": "Eén zin is genoeg."}, {"s": 866.95, "e": 868.38, "t": "Ik ga door."}, {"s": 868.38, "e": 871.02, "t": "Ik maak vooruitgang."}, {"s": 871.02, "e": 873.48, "t": "Ik denk ook aan mijn begin."}, {"s": 873.48, "e": 875.83, "t": "Vroeger kon ik niets zeggen."}, {"s": 875.83, "e": 878.28, "t": "Nu zeg ik: ik ga naar school."}, {"s": 878.28, "e": 879.9, "t": "Ik zit in de les."}, {"s": 879.9, "e": 881.6, "t": "Ik leer wiskunde."}, {"s": 881.6, "e": 883.17, "t": "Ik lees een boek."}, {"s": 883.17, "e": 886.12, "t": "Dat zijn hele zinnen."}, {"s": 886.12, "e": 888.29, "t": "Dat is mijn vooruitgang."}, {"s": 888.29, "e": 891.53, "t": "Ik spreek ook in mijn hoofd tijdens de les of het werk."}, {"s": 891.53, "e": 895.29, "t": "Ik denk: dat is de leraar."}, {"s": 895.29, "e": 896.96, "t": "Hij schrijft."}, {"s": 896.96, "e": 898.89, "t": "Zij stelt een vraag."}, {"s": 898.89, "e": 901.17, "t": "Ik denk in het Nederlands."}, {"s": 901.17, "e": 903.52, "t": "Stil, maar heel nuttig."}, {"s": 903.52, "e": 907.64, "t": "Als ik mijn hand opsteek, zeg ik: ik heb een vraag."}, {"s": 907.64, "e": 910.99, "t": "Dat is een kleine zin, maar belangrijk."}, {"s": 910.99, "e": 914.59, "t": "Het kost moed, maar ik doe het."}, {"s": 914.59, "e": 917.78, "t": "En elke keer word ik sterker."}, {"s": 917.78, "e": 920.31, "t": "Soms maak ik fouten."}, {"s": 920.31, "e": 922.3, "t": "Ik zeg een verkeerd woord."}, {"s": 922.3, "e": 924.2, "t": "Ik vergeet een regel."}, {"s": 924.21, "e": 926.19, "t": "Ik voel me onzeker."}, {"s": 926.19, "e": 930.61, "t": "Maar ik herinner me: fouten horen bij leren."}, {"s": 930.61, "e": 932.59, "t": "Ze zijn niet slecht."}, {"s": 932.59, "e": 933.74, "t": "Ze zijn goed."}, {"s": 933.74, "e": 936.56, "t": "Ze laten zien dat ik het probeer."}, {"s": 936.56, "e": 943.07, "t": "Als ik iets niet begrijp, vraag ik: kun je dat herhalen of wat betekent dat."}, {"s": 943.07, "e": 945.47, "t": "Deze zinnen brengen mij verder."}, {"s": 945.47, "e": 948.21, "t": "Ze laten zien dat ik dapper ben."}, {"s": 948.21, "e": 950.67, "t": "Ik spreek ook met mijn klasgenoten."}, {"s": 950.67, "e": 952.65, "t": "Ik zeg: hallo."}, {"s": 952.65, "e": 954.4, "t": "Ik vraag: hoe gaat het."}, {"s": 954.4, "e": 958.16, "t": "Ik antwoord: goed, dank je."}, {"s": 958.16, "e": 962.37, "t": "Dat zijn eenvoudige zinnen, maar ze zijn echt."}, {"s": 962.37, "e": 964.7, "t": "Ze horen bij het leven."}, {"s": 964.7, "e": 969.71, "t": "Als de leraar een vraag stelt, probeer ik te antwoorden."}, {"s": 969.71, "e": 972.58, "t": "Misschien zeg ik maar een paar woorden."}, {"s": 972.58, "e": 974.75, "t": "Maar dat is belangrijk."}, {"s": 974.75, "e": 978.04, "t": "Ik zeg: dat is mijn antwoord."}, {"s": 978.04, "e": 981.1, "t": "Ook als het fout is, ik leer."}, {"s": 981.1, "e": 983.22, "t": "Ik luister naar de anderen."}, {"s": 983.22, "e": 985.15, "t": "Ik leer nieuwe woorden."}, {"s": 985.15, "e": 990.61, "t": "Ik zeg: dat is een nieuw woord, ik gebruik het morgen."}, {"s": 990.61, "e": 993.66, "t": "Als ik leer, zeg ik: ik leer Nederlands."}, {"s": 993.66, "e": 995.23, "t": "Ik lees verhalen."}, {"s": 995.23, "e": 997.09, "t": "Ik schrijf zinnen."}, {"s": 997.09, "e": 999.73, "t": "Deze handelingen zijn echt."}, {"s": 999.73, "e": 1001.95, "t": "Deze zinnen zijn nuttig."}, {"s": 1001.95, "e": 1003.8, "t": "Ze maken mij trots."}, {"s": 1003.8, "e": 1006.49, "t": "Op het werk praat ik over mijn taken."}, {"s": 1006.49, "e": 1009.73, "t": "Ik zeg: ik stuur e-mails."}, {"s": 1009.73, "e": 1011.64, "t": "Ik neem de telefoon op."}, {"s": 1011.64, "e": 1013.49, "t": "Ik help klanten."}, {"s": 1013.49, "e": 1017.25, "t": "Ik zeg het hardop, ook als ik alleen ben."}, {"s": 1017.25, "e": 1018.74, "t": "Dat voelt goed."}, {"s": 1018.74, "e": 1022.53, "t": "Elk woord dat ik zeg is een stap vooruit."}, {"s": 1022.53, "e": 1026.42, "t": "Elke zin die ik spreek maakt mij sterker."}, {"s": 1026.42, "e": 1029.35, "t": "Ik wacht niet op het juiste moment."}, {"s": 1029.35, "e": 1031.62, "t": "Ik gebruik dit moment."}, {"s": 1031.62, "e": 1034.15, "t": "Ik praat met mijn vrienden."}, {"s": 1034.15, "e": 1038.33, "t": "Na de les of tijdens het werk zie ik mijn vrienden."}, {"s": 1038.33, "e": 1040.32, "t": "Ze lopen naast mij."}, {"s": 1040.32, "e": 1042.23, "t": "Ze glimlachen naar mij."}, {"s": 1042.23, "e": 1045.81, "t": "Ze zeggen: hallo, en ik lach ook."}, {"s": 1045.81, "e": 1049.59, "t": "Ik antwoord: goedendag."}, {"s": 1049.59, "e": 1052.28, "t": "Deze eenvoudige woorden zijn sterk."}, {"s": 1052.28, "e": 1054.4, "t": "Ze geven mij plezier."}, {"s": 1054.4, "e": 1057.4, "t": "Ze helpen mij om Nederlands te spreken."}, {"s": 1057.4, "e": 1060.17, "t": "Ik zeg: hoe gaat het met je."}, {"s": 1060.17, "e": 1062.68, "t": "Mijn vriend antwoordt: goed."}, {"s": 1062.68, "e": 1063.65, "t": "En jij."}, {"s": 1063.65, "e": 1065.5, "t": "Ik zeg: ook goed."}, {"s": 1065.5, "e": 1069.21, "t": "Dat zijn kleine zinnen, maar ze zijn echt."}, {"s": 1069.21, "e": 1071.85, "t": "Dat zijn de woorden van het leven."}, {"s": 1071.85, "e": 1076.03, "t": "En als ik ze zeg, ben ik trots."}, {"s": 1076.03, "e": 1078.01, "t": "Omdat ik spreek."}, {"s": 1078.01, "e": 1079.95, "t": "Omdat ik een band maak."}, {"s": 1079.95, "e": 1081.62, "t": "Ik zit met mijn vrienden."}, {"s": 1081.62, "e": 1082.64, "t": "We praten."}, {"s": 1082.64, "e": 1086.35, "t": "Ik vraag: wat doe jij."}, {"s": 1086.35, "e": 1089.04, "t": "Mijn vriend zegt: ik lees."}, {"s": 1089.04, "e": 1091.62, "t": "Ik zeg: dat is goed."}, {"s": 1091.62, "e": 1093.37, "t": "Hou je van het boek."}, {"s": 1093.37, "e": 1095.83, "t": "Dat zijn eenvoudige zinnen."}, {"s": 1095.83, "e": 1098.36, "t": "Maar het is een echt gesprek."}, {"s": 1098.36, "e": 1101.31, "t": "En zo maak ik vooruitgang."}, {"s": 1101.31, "e": 1103.07, "t": "Soms ben ik bang."}, {"s": 1103.07, "e": 1106.72, "t": "Ik denk: wat als ik een fout maak."}, {"s": 1106.72, "e": 1111.87, "t": "Maar ik adem, ik zeg tegen mezelf: fouten zijn normaal."}, {"s": 1111.87, "e": 1114.64, "t": "Mijn vrienden zijn aardig, ze lachen niet."}, {"s": 1114.64, "e": 1119.68, "t": "Ze luisteren, ze helpen, ze wachten tot ik spreek."}, {"s": 1119.68, "e": 1121.9, "t": "Ik leer nieuwe uitdrukkingen."}, {"s": 1121.9, "e": 1126.63, "t": "Ik vraag: wat betekent dat."}, {"s": 1126.63, "e": 1129.08, "t": "Mijn vriend legt het uit."}, {"s": 1129.08, "e": 1131.25, "t": "Ik zeg: dank je."}, {"s": 1131.25, "e": 1132.95, "t": "Ik schrijf het woord op."}, {"s": 1132.95, "e": 1135.12, "t": "Ik herhaal het morgen."}, {"s": 1135.12, "e": 1137.39, "t": "Zo onthoud ik het."}, {"s": 1137.39, "e": 1139.32, "t": "Dat is mijn methode."}, {"s": 1139.32, "e": 1143.27, "t": "Met echte gesprekken, met echte mensen."}, {"s": 1143.27, "e": 1145.54, "t": "Soms lachen we samen."}, {"s": 1145.54, "e": 1148.18, "t": "We zeggen: dat is grappig."}, {"s": 1148.18, "e": 1149.8, "t": "Ik voel me goed."}, {"s": 1149.8, "e": 1152.38, "t": "Ik voel me geaccepteerd."}, {"s": 1152.38, "e": 1154.5, "t": "Ik voel me in de groep."}, {"s": 1154.5, "e": 1158.68, "t": "Nederlands helpt mij om me dicht bij anderen te voelen."}, {"s": 1158.68, "e": 1165.6, "t": "Als we samen lunchen, zeg ik: dit gerecht is lekker, of ik hou van dit brood."}, {"s": 1165.6, "e": 1170.46, "t": "Ik vraag: en jij, wat vind jij lekker."}, {"s": 1170.46, "e": 1173.99, "t": "Mijn vriend zegt: ik hou van pasta."}, {"s": 1173.99, "e": 1175.61, "t": "Ik zeg: ik ook."}, {"s": 1175.61, "e": 1180.05, "t": "Dat zijn heel eenvoudige zinnen, maar ze zijn belangrijk."}, {"s": 1180.05, "e": 1181.98, "t": "Ze zijn echt."}, {"s": 1181.98, "e": 1183.96, "t": "Ze maken mij blij."}, {"s": 1183.96, "e": 1187.33, "t": "Ik denk terug aan de tijd toen ik niet sprak."}, {"s": 1187.34, "e": 1188.95, "t": "Ik bleef stil."}, {"s": 1188.95, "e": 1190.86, "t": "Ik keek naar de anderen."}, {"s": 1190.86, "e": 1192.95, "t": "Ik wilde spreken."}, {"s": 1192.95, "e": 1194.7, "t": "Maar ik durfde niet."}, {"s": 1194.7, "e": 1198.23, "t": "Ik was verlegen, ik was verdrietig."}, {"s": 1198.23, "e": 1202.17, "t": "Maar nu spreek ik langzaam, eenvoudig."}, {"s": 1202.17, "e": 1206.12, "t": "Maar ik spreek, en dat verandert alles."}, {"s": 1206.12, "e": 1209.04, "t": "Ik herhaal vaak dezelfde zinnen."}, {"s": 1209.04, "e": 1212.1, "t": "Hallo, goedendag, hoe gaat het."}, {"s": 1212.1, "e": 1215.26, "t": "Ook goed, dank je, ik hou daarvan."}, {"s": 1215.26, "e": 1216.93, "t": "Dat zijn mijn basis."}, {"s": 1216.93, "e": 1219.26, "t": "Ik gebruik ze elke dag."}, {"s": 1219.26, "e": 1222.08, "t": "Ik wacht niet op perfecte grammatica."}, {"s": 1222.08, "e": 1224.17, "t": "Ik gebruik wat ik ken."}, {"s": 1224.17, "e": 1226.57, "t": "En ik word beter."}, {"s": 1226.57, "e": 1228.9, "t": "Een keer vergat ik een woord."}, {"s": 1228.9, "e": 1230.38, "t": "Ik stopte."}, {"s": 1230.38, "e": 1232.47, "t": "Mijn vriend hielp mij."}, {"s": 1232.47, "e": 1234.88, "t": "Hij zei het woord voor mij."}, {"s": 1234.88, "e": 1236.31, "t": "Ik herhaalde het."}, {"s": 1236.31, "e": 1237.59, "t": "Ik lachte."}, {"s": 1237.59, "e": 1239.29, "t": "Hij lachte ook."}, {"s": 1239.29, "e": 1241.93, "t": "Dit moment bleef bij mij."}, {"s": 1241.93, "e": 1243.79, "t": "Het leerde mij iets."}, {"s": 1243.79, "e": 1246.29, "t": "Ik hoef niet perfect te zijn."}, {"s": 1246.29, "e": 1249.24, "t": "Ik hoef alleen te proberen."}, {"s": 1249.24, "e": 1251.83, "t": "We praten ook over onze vakken."}, {"s": 1251.83, "e": 1255.54, "t": "Ik vraag: heb je de les begrepen."}, {"s": 1255.54, "e": 1258.23, "t": "Mijn vriend zegt: een beetje."}, {"s": 1258.23, "e": 1260.74, "t": "Ik zeg: ik ook."}, {"s": 1260.74, "e": 1262.41, "t": "We kunnen samen leren."}, {"s": 1262.41, "e": 1264.16, "t": "Dan helpen we elkaar."}, {"s": 1264.16, "e": 1265.96, "t": "We leren samen."}, {"s": 1265.96, "e": 1267.71, "t": "Dat is fijn."}, {"s": 1267.71, "e": 1269.88, "t": "Met vrienden praten is makkelijk."}, {"s": 1269.88, "e": 1271.27, "t": "Het is leuk."}, {"s": 1271.27, "e": 1274.09, "t": "Het heeft veel kleine momenten."}, {"s": 1274.09, "e": 1277.43, "t": "Deze kleine momenten helpen mij vooruit."}, {"s": 1277.43, "e": 1279.1, "t": "Ik spreek meer."}, {"s": 1279.1, "e": 1280.62, "t": "Ik voel me beter."}, {"s": 1280.62, "e": 1282.55, "t": "Ik word sterker."}, {"s": 1282.55, "e": 1287.1, "t": "Bedankt dat je tot het einde bent gebleven."}, {"s": 1287.1, "e": 1291.35, "t": "Ik hoop dat de tekst je heeft geholpen en plezier gaf."}, {"s": 1291.35, "e": 1296.45, "t": "Schrijf nu in de reacties hoe jouw dagelijkse routine eruitziet."}, {"s": 1296.45, "e": 1302.14, "t": "Zie het als oefening en schrijf een paar eenvoudige zinnen."}, {"s": 1302.14, "e": 1307.0, "t": "Je kunt ook de reacties van anderen lezen en daarvan leren."}, {"s": 1307.0, "e": 1312.25, "t": "Reageer gerust ook bij anderen, zodat we elkaar steunen."}, {"s": 1312.25, "e": 1314.94, "t": "Zo leren we samen sneller."}, {"s": 1314.94, "e": 1319.36, "t": "Heel erg bedankt, jullie zijn een geweldige community."}]