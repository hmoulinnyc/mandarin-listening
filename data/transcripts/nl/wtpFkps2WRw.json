[{"s": 2.16, "e": 6.76, "t": "Hoi allemaal. Ik ben Noelle en"}, {"s": 6.76, "e": 9.88, "t": "ik zit in de natuur."}, {"s": 9.88, "e": 14.36, "t": "Je kunt denk ik een vogel horen."}, {"s": 14.64, "e": 18.12, "t": "Kun je het horen?"}, {"s": 18.92, "e": 22.24, "t": "Kun je stoppen alsjeblieft?"}, {"s": 22.24, "e": 25.08, "t": "Dit klinkt heel mooi, maar ik hoop dat"}, {"s": 25.08, "e": 27.72, "t": "jullie mij kunnen horen, want de vogel"}, {"s": 27.72, "e": 30.8, "t": "is heel luid."}, {"s": 30.8, "e": 34.16, "t": "Ik wilde uitleg geven"}, {"s": 34.16, "e": 38.52, "t": "over een gezicht."}, {"s": 39.04, "e": 42.72, "t": "Dit is mijn gezicht."}, {"s": 42.72, "e": 45.92, "t": "En op het moment"}, {"s": 45.92, "e": 47.48, "t": "schijnt"}, {"s": 47.48, "e": 53.56, "t": "de zon de zon in mijn ogen."}, {"s": 53.56, "e": 56.16, "t": "Nu is er schaduw"}, {"s": 56.16, "e": 59.16, "t": "en nu schijnt de zon."}, {"s": 59.16, "e": 62.28, "t": "in mijn ogen."}, {"s": 62.28, "e": 64.8, "t": "In mijn twee"}, {"s": 64.8, "e": 67.48, "t": "ogen."}, {"s": 67.48, "e": 69.84, "t": "Ik heb twee ogen."}, {"s": 69.84, "e": 75.76, "t": "En deze ogen gebruik ik om te kijken."}, {"s": 75.76, "e": 79.96, "t": "Kijken. Nu kijk ik naar de camera."}, {"s": 79.96, "e": 85.48, "t": "En jij kijkt naar deze video."}, {"s": 85.52, "e": 88.52, "t": "Dit is één oog."}, {"s": 88.52, "e": 93.0, "t": "En dit zijn twee ogen."}, {"s": 93.0, "e": 97.64, "t": "En op mijn oog of op mijn ogenlid, het"}, {"s": 97.64, "e": 99.96, "t": "is een ooglid,"}, {"s": 99.96, "e": 103.64, "t": "zitten wimpers."}, {"s": 103.88, "e": 108.92, "t": "Kijk, dit zijn mijn wimpers."}, {"s": 109.04, "e": 113.96, "t": "Ik heb zwarte of heel donkerbruine"}, {"s": 113.96, "e": 116.96, "t": "wimpers."}, {"s": 118.12, "e": 122.72, "t": "En nu op dit moment zijn dit mijn"}, {"s": 122.72, "e": 127.16, "t": "wimpers. Mijn wimpers."}, {"s": 127.16, "e": 130.72, "t": "Ik draag geen mascara,"}, {"s": 130.72, "e": 135.0, "t": "dus geen make-up op mijn wimpers."}, {"s": 135.0, "e": 140.16, "t": "Boven boven mijn oog of ogen"}, {"s": 140.16, "e": 144.28, "t": "heb ik wenkbrauwen."}, {"s": 146.24, "e": 149.76, "t": "Mijn wenkbrauwen"}, {"s": 149.76, "e": 154.32, "t": "zijn ook donker. Donker van kleur."}, {"s": 154.32, "e": 158.24, "t": "Bijna zwart of donkerbruin."}, {"s": 158.24, "e": 161.48, "t": "Net als mijn haar."}, {"s": 161.48, "e": 164.88, "t": "Kijk mijn haar."}, {"s": 165.6, "e": 168.04, "t": "Ja."}, {"s": 168.04, "e": 170.4, "t": "En tussen"}, {"s": 170.4, "e": 175.52, "t": "tussen mijn wenkbrauwen, tussen het ene"}, {"s": 175.52, "e": 179.2, "t": "wenkbrauw en andere wenkbrauw"}, {"s": 179.2, "e": 181.76, "t": "is mijn neus."}, {"s": 181.76, "e": 184.12, "t": "Dit is mijn neus"}, {"s": 184.12, "e": 187.4, "t": "en ik heb twee"}, {"s": 187.4, "e": 190.4, "t": "neusgaten."}, {"s": 191.12, "e": 193.88, "t": "Mijn neus."}, {"s": 193.88, "e": 197.24, "t": "met neusgaten."}, {"s": 198.64, "e": 202.2, "t": "Ik heb nog iets extra's aan mijn neus,"}, {"s": 202.2, "e": 204.48, "t": "zoals je kan zien."}, {"s": 204.48, "e": 207.28, "t": "En dat is mijn piercing."}, {"s": 207.28, "e": 211.44, "t": "Ik heb een neuspiercing."}, {"s": 213.12, "e": 221.24, "t": "En naast naast mijn neus heb ik wangen."}, {"s": 222.92, "e": 227.52, "t": "Ik heb best wel grote wangen. Heel ronde"}, {"s": 227.52, "e": 231.64, "t": "ronde wangen."}, {"s": 231.64, "e": 235.64, "t": "En mijn wangen zijn nu een beetje rood"}, {"s": 235.64, "e": 240.64, "t": "of roze, want ik heb het heel warm."}, {"s": 240.64, "e": 244.2, "t": "En vaak worden wangen,"}, {"s": 244.2, "e": 248.04, "t": "deze wang en deze wang dan een beetje"}, {"s": 248.04, "e": 252.04, "t": "rood of roze."}, {"s": 252.72, "e": 256.0, "t": "Mijn wangen."}, {"s": 256.32, "e": 260.08, "t": "Onder mijn neus en wangen"}, {"s": 260.08, "e": 263.68, "t": "zijn mijn lippen."}, {"s": 264.64, "e": 267.96, "t": "Dit zijn mijn lippen."}, {"s": 267.96, "e": 272.12, "t": "Mijn lippen zijn onderdeel. Ze horen bij"}, {"s": 272.12, "e": 277.64, "t": "mijn mond. Ik praat met mijn mond nu. Je"}, {"s": 277.64, "e": 282.96, "t": "ziet dat ik praat met mijn mond."}, {"s": 282.96, "e": 286.8, "t": "Ik ben aan het glimlachen."}, {"s": 288.08, "e": 294.8, "t": "En in mijn mond zijn tanden."}, {"s": 296.48, "e": 302.08, "t": "Ik heb veel tanden en dit is één"}, {"s": 302.08, "e": 304.08, "t": "tand."}, {"s": 304.08, "e": 310.48, "t": "In mijn mond is ook een tong."}, {"s": 310.48, "e": 315.0, "t": "Dat is mijn tong."}, {"s": 315.0, "e": 321.0, "t": "Onder mijn lippen, onder mijn mond"}, {"s": 321.0, "e": 324.2, "t": "is mijn kin."}, {"s": 324.2, "e": 328.96, "t": "Dit is mijn kin."}, {"s": 333.0, "e": 337.76, "t": "Wat zeg je over een kin? Dit is mijn kin"}, {"s": 337.76, "e": 340.4, "t": "aan de onderkant"}, {"s": 340.4, "e": 344.16, "t": "van mijn gezicht."}, {"s": 344.96, "e": 349.44, "t": "En iets wat niet echt mijn gezicht is,"}, {"s": 349.44, "e": 351.76, "t": "maar wel ernaast"}, {"s": 351.76, "e": 357.32, "t": "is, is mijn oor of mijn oren."}, {"s": 357.32, "e": 360.64, "t": "Ik heb twee oren"}, {"s": 360.64, "e": 366.16, "t": "en in mijn oren heb ik oorbellen."}, {"s": 366.16, "e": 368.84, "t": "Dit zijn oorbellen."}, {"s": 368.84, "e": 373.32, "t": "Aan mijn oorlel heb ik een oorbel."}, {"s": 373.32, "e": 377.48, "t": "En ook heb ik een oorpiercing"}, {"s": 377.48, "e": 381.12, "t": "ook aan deze kant."}, {"s": 381.12, "e": 386.48, "t": "Aan deze kant in dit oor heb ik meer"}, {"s": 386.48, "e": 389.32, "t": "piercings."}, {"s": 389.32, "e": 392.4, "t": "Ik heb deze piercing. Dat heet een conch"}, {"s": 392.4, "e": 395.16, "t": "piercing."}, {"s": 395.16, "e": 399.16, "t": "En deze en deze."}, {"s": 399.16, "e": 401.96, "t": "En in dit oorgaatje"}, {"s": 401.96, "e": 406.24, "t": "kan ik oorbellen doen. Één oorbel."}, {"s": 406.24, "e": 410.04, "t": "En in deze. Deze ook."}, {"s": 410.04, "e": 412.96, "t": "Maar nu heb ik alleen maar deze"}, {"s": 412.96, "e": 415.56, "t": "oorpellen in."}, {"s": 415.56, "e": 420.44, "t": "In mijn oren, mijn twee oren."}, {"s": 420.44, "e": 423.48, "t": "En op mijn hoofd,"}, {"s": 423.48, "e": 426.2, "t": "mijn hoofd"}, {"s": 426.2, "e": 429.64, "t": "heb ik ook haar."}, {"s": 429.64, "e": 435.48, "t": "En dit is mijn keel. Dit is mijn keel."}, {"s": 435.48, "e": 440.56, "t": "Mijn keel. Daarmee kan ik slikken en"}, {"s": 440.56, "e": 444.16, "t": "praten en drinken."}, {"s": 444.16, "e": 448.2, "t": "En mijn keel is onderdeel"}, {"s": 448.2, "e": 453.2, "t": "van mijn hals. Dit is mijn hals."}, {"s": 453.2, "e": 457.44, "t": "En om mijn hals"}, {"s": 457.44, "e": 459.68, "t": "zit een ketting."}, {"s": 459.68, "e": 462.64, "t": "Dit is mijn ketting."}, {"s": 462.64, "e": 467.48, "t": "Deze hoort bij deze oorbellen."}, {"s": 467.48, "e": 471.32, "t": "Kijk, ze lijken op elkaar"}, {"s": 471.32, "e": 473.52, "t": "met opaal."}, {"s": 473.52, "e": 476.84, "t": "Opaal vind ik heel mooi. Kijk, hier is"}, {"s": 476.84, "e": 479.48, "t": "de andere."}, {"s": 479.48, "e": 481.08, "t": "Oké,"}, {"s": 481.08, "e": 485.2, "t": "dat was het. Dankjewel voor het kijken."}, {"s": 485.2, "e": 489.04, "t": "Heb jij ook een ketting of piercings of"}, {"s": 489.04, "e": 492.6, "t": "een neus? Heb jij een neus?"}, {"s": 492.6, "e": 495.48, "t": "Ik hoor het graag in de opmerkingen en"}, {"s": 495.48, "e": 501.08, "t": "tot de volgende keer. Doeg. Doeg."}, {"s": 513.68, "e": 515.76, "t": "Ja."}]