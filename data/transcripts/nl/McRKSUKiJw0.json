[{"s": 0.6, "e": 2.3, "t": "Hoi Martha."}, {"s": 2.3, "e": 4.3, "t": "Dit pakketje is voor jou."}, {"s": 4.3, "e": 7.2, "t": "De bezorger had het bij mij gebracht."}, {"s": 7.2, "e": 8.0, "t": "Dankjewel."}, {"s": 8.0, "e": 9.5, "t": "Graag gedaan."}, {"s": 9.5, "e": 11.3, "t": "Wat vind je van de buurt?"}, {"s": 11.3, "e": 14.4, "t": "Heel aardig. Jij helpt altijd. En de"}, {"s": 14.4, "e": 15.8, "t": "buurman ook."}, {"s": 15.8, "e": 18.0, "t": "Oh, je bedoelt de buren."}, {"s": 18.0, "e": 20.7, "t": "De buurt?"}, {"s": 21.0, "e": 24.23, "t": "Buurt. Buren. Dat is moeilijk."}, {"s": 25.3, "e": 27.4, "t": "Je gaf je buurvrouw in elk geval een"}, {"s": 27.4, "e": 28.82, "t": "compliment."}, {"s": 31.2, "e": 33.2, "t": "Je buren zijn mensen die vlakbij je"}, {"s": 33.2, "e": 34.3, "t": "wonen."}, {"s": 34.3, "e": 37.4, "t": "Bijvoorbeeld naast je of tegenover je."}, {"s": 37.4, "e": 39.9, "t": "Je buurt is de omgeving van je huis met"}, {"s": 39.9, "e": 44.1, "t": "de straten, huizen en winkels."}, {"s": 44.1, "e": 47.6, "t": "Mijn buren zijn aardig. Mijn buurt is"}, {"s": 47.6, "e": 49.5, "t": "rustig."}, {"s": 49.5, "e": 51.2, "t": "Precies."}, {"s": 51.2, "e": 54.3, "t": "Dus je buurvrouw en je buurt krijgen een"}, {"s": 54.3, "e": 56.6, "t": "compliment. Ja."}, {"s": 56.6, "e": 58.95, "t": "Nu is iedereen blij."}, {"s": 65.5, "e": 68.2, "t": "Welkom bij Café Talk van Zeg maar"}, {"s": 68.2, "e": 70.74, "t": "Nederlands."}, {"s": 72.0, "e": 74.4, "t": "Hier praten we in makkelijk Nederlands"}, {"s": 74.4, "e": 77.9, "t": "over het dagelijks leven in Nederland."}, {"s": 77.9, "e": 80.3, "t": "Ik ben Ling. En ik [muziek] ben Marieke,"}, {"s": 80.3, "e": 82.4, "t": "docent Nederlands."}, {"s": 82.4, "e": 84.7, "t": "Vandaag praten we over je huis en je"}, {"s": 84.7, "e": 88.1, "t": "buurt met makkelijke gesprekken voor A1"}, {"s": 88.1, "e": 90.2, "t": "en A2."}, {"s": 90.2, "e": 93.67, "t": "En Martha is bij ons. Welkom."}, {"s": 94.7, "e": 96.1, "t": "Dankjewel."}, {"s": 96.1, "e": 98.9, "t": "Ik kom uit Polen. Ik woon met mijn man"}, {"s": 98.9, "e": 101.8, "t": "en onze dochter in Utrecht."}, {"s": 101.8, "e": 104.8, "t": "Hoelang wonen jullie hier?"}, {"s": 104.8, "e": 106.2, "t": "Acht maanden."}, {"s": 106.2, "e": 108.2, "t": "Mijn man werkt hier."}, {"s": 108.2, "e": 112.1, "t": "Ik leer al zes maanden Nederlands."}, {"s": 112.1, "e": 114.0, "t": "Hoe oefen je?"}, {"s": 114.0, "e": 117.1, "t": "Ik heb twee keer per week les."}, {"s": 117.1, "e": 122.09, "t": "En ik probeer ehm met de buren praten."}, {"s": 122.09, "e": 125.49, "t": "Wat wil je graag kunnen zeggen?"}, {"s": 125.49, "e": 129.49, "t": "Ik wil mijn buurvrouw uitnodigen"}, {"s": 129.49, "e": 131.29, "t": "voor koffie"}, {"s": 131.29, "e": 134.39, "t": "en mijn huis laten zien."}, {"s": 134.39, "e": 136.69, "t": "Maar als ze iets vraagt"}, {"s": 136.69, "e": 140.59, "t": "ehm dan zoek ik woorden."}, {"s": 140.59, "e": 142.99, "t": "Dan oefenen we dat vandaag."}, {"s": 142.99, "e": 143.99, "t": "Hm hm."}, {"s": 143.99, "e": 146.69, "t": "En aan het einde weten we"}, {"s": 146.69, "e": 148.69, "t": "komt Anja op bezoek?"}, {"s": 149.89, "e": 151.69, "t": "En woont er verder nog iemand bij"}, {"s": 151.69, "e": 152.99, "t": "jullie?"}, {"s": 152.99, "e": 155.69, "t": "Onze kat Pip."}, {"s": 155.69, "e": 158.49, "t": "Die moeten we natuurlijk niet vergeten."}, {"s": 158.49, "e": 159.89, "t": "Nee."}, {"s": 159.89, "e": 162.44, "t": "Pip vindt dat het zijn huis is."}, {"s": 167.49, "e": 168.99, "t": "De ochtendzon wat zachtjes door"}, {"s": 168.99, "e": 172.09, "t": "Martha, woon je in een appartement of in"}, {"s": 172.09, "e": 173.99, "t": "een huis?"}, {"s": 173.99, "e": 176.79, "t": "In een huis met een tuin"}, {"s": 176.79, "e": 180.59, "t": "en buren aan twee kanten."}, {"s": 180.59, "e": 183.39, "t": "Je huis zit links en rechts vast aan een"}, {"s": 183.39, "e": 185.59, "t": "ander huis."}, {"s": 185.59, "e": 188.49, "t": "Dat noemen we een tussenwoning."}, {"s": 188.49, "e": 191.09, "t": "Je kunt zeggen ik woon in een"}, {"s": 191.09, "e": 194.09, "t": "tussenwoning."}, {"s": 194.29, "e": 198.49, "t": "Ik woon in een tussenwoning."}, {"s": 198.89, "e": 201.39, "t": "Dit is ons huis."}, {"s": 201.39, "e": 205.59, "t": "De buren wonen links en rechts."}, {"s": 205.59, "e": 209.59, "t": "Achter het huis is een kleine tuin."}, {"s": 209.59, "e": 212.89, "t": "Sam en ik wonen in een benedenwoning."}, {"s": 212.89, "e": 216.49, "t": "Dat is een woning op de begane grond."}, {"s": 216.49, "e": 219.49, "t": "Boven ons wonen andere mensen."}, {"s": 219.49, "e": 221.89, "t": "We hebben wel een eigen voordeur en een"}, {"s": 221.89, "e": 224.29, "t": "tuin."}, {"s": 224.49, "e": 227.19, "t": "En jullie hebben ook een kat?"}, {"s": 227.19, "e": 228.19, "t": "Nee."}, {"s": 228.19, "e": 230.89, "t": "Maar Mimi, de kat van onze buurvrouw,"}, {"s": 230.89, "e": 232.69, "t": "komt vaak langs."}, {"s": 232.69, "e": 236.39, "t": "Dankzij Mimi ken ik onze buurvrouw."}, {"s": 236.39, "e": 238.99, "t": "Maar terug naar Pip. Kent hij jouw buren"}, {"s": 238.99, "e": 239.89, "t": "al?"}, {"s": 239.89, "e": 243.09, "t": "Ja, beter dan ik. Hij gaat gewoon naar"}, {"s": 243.09, "e": 244.97, "t": "iedereen toe."}, {"s": 251.39, "e": 255.49, "t": "Stel Anja staat bij de deur. Wat zeg je?"}, {"s": 255.49, "e": 259.29, "t": "Hoi Anja, kom binnen."}, {"s": 259.29, "e": 261.79, "t": "Een goed begin."}, {"s": 261.79, "e": 265.09, "t": "En nu laat je ons je huis zien."}, {"s": 265.09, "e": 267.69, "t": "Kijk maar."}, {"s": 268.09, "e": 270.29, "t": "Beneden is de woonkamer"}, {"s": 270.29, "e": 271.69, "t": "en de keuken."}, {"s": 271.69, "e": 272.99, "t": "Boven"}, {"s": 272.99, "e": 275.59, "t": "er is twee slaapkamers"}, {"s": 275.59, "e": 277.89, "t": "en een werkkamer."}, {"s": 277.89, "e": 280.39, "t": "Bij één slaapkamer zeg je er is één"}, {"s": 280.39, "e": 281.89, "t": "slaapkamer."}, {"s": 281.89, "e": 284.99, "t": "Bij twee slaapkamers zeg je er zijn twee"}, {"s": 284.99, "e": 287.59, "t": "slaapkamers."}, {"s": 287.59, "e": 291.09, "t": "Oh dus bij ons thuis ehm"}, {"s": 291.09, "e": 293.59, "t": "is er één werkkamer en er zijn twee"}, {"s": 293.59, "e": 295.49, "t": "slaapkamers."}, {"s": 295.49, "e": 297.29, "t": "Precies."}, {"s": 297.29, "e": 299.69, "t": "En het toilet?"}, {"s": 299.69, "e": 303.59, "t": "Beneden ehm naast de keuken."}, {"s": 303.59, "e": 305.79, "t": "De badkamer is boven."}, {"s": 305.79, "e": 308.29, "t": "Handig om dat eerst te weten"}, {"s": 308.29, "e": 311.49, "t": "voordat we door het hele huis lopen."}, {"s": 311.49, "e": 312.39, "t": "Ja."}, {"s": 312.39, "e": 314.79, "t": "Mijn man laat altijd alles zien. Ook de"}, {"s": 314.79, "e": 317.29, "t": "kast met ehm"}, {"s": 317.29, "e": 318.99, "t": "schoonmaakspullen."}, {"s": 320.19, "e": 322.59, "t": "Dan vraag ik eerst komen we alleen"}, {"s": 322.59, "e": 326.9, "t": "kijken of moeten we ook helpen? [gelach]"}, {"s": 333.69, "e": 335.69, "t": "Dit is onze woonkamer."}, {"s": 335.69, "e": 339.29, "t": "Hier staat de bank, daar staat de kast"}, {"s": 339.29, "e": 342.29, "t": "en dit is Pip."}, {"s": 342.79, "e": 345.69, "t": "Dat ziet er gezellig uit. Waar ligt Pip"}, {"s": 345.69, "e": 348.29, "t": "precies?"}, {"s": 348.49, "e": 351.69, "t": "Bij het raam ehm"}, {"s": 351.69, "e": 355.59, "t": "op die ehm rand onder het raam."}, {"s": 355.59, "e": 358.99, "t": "Daar staan soms planten."}, {"s": 358.99, "e": 361.49, "t": "Hoe heet die ook alweer?"}, {"s": 361.49, "e": 363.39, "t": "De vensterbank."}, {"s": 363.39, "e": 366.19, "t": "Oh ja, de vensterbank."}, {"s": 366.19, "e": 369.1, "t": "Pip ligt op de vensterbank."}, {"s": 369.1, "e": 371.3, "t": "Hm."}, {"s": 371.3, "e": 373.3, "t": "Je beschreef het goed."}, {"s": 373.3, "e": 374.8, "t": "Je zei"}, {"s": 374.8, "e": 376.69, "t": "waar het was"}, {"s": 376.69, "e": 379.6, "t": "en wat erop kan staan."}, {"s": 379.6, "e": 383.2, "t": "Staan er bij jullie ook planten?"}, {"s": 383.3, "e": 386.8, "t": "Eén Pip heeft de rest van ehm de"}, {"s": 386.8, "e": 390.0, "t": "vensterbank nodig. [gelach]"}, {"s": 390.0, "e": 393.5, "t": "Het is dus zijn vensterbank."}, {"s": 393.5, "e": 394.8, "t": "Ja."}, {"s": 394.8, "e": 397.59, "t": "Wij betalen alleen de huur."}, {"s": 400.5, "e": 402.6, "t": "Met deze woorden kun je de rest van de"}, {"s": 402.6, "e": 407.1, "t": "kamer beschrijven. Naast tegenover en"}, {"s": 407.1, "e": 408.6, "t": "tussen."}, {"s": 408.6, "e": 411.0, "t": "Kijk eens naar onze kopjes."}, {"s": 411.0, "e": 414.8, "t": "Mijn kopje staat tussen dat van Ling"}, {"s": 414.8, "e": 417.6, "t": "en dat van Martha."}, {"s": 417.6, "e": 420.3, "t": "En bij jou thuis, Martha?"}, {"s": 420.3, "e": 423.89, "t": "Waar staan de bank en de kast?"}, {"s": 423.89, "e": 426.3, "t": "De bank staat naast het raam."}, {"s": 426.3, "e": 431.19, "t": "Ehm de kast staat tegenover de bank."}, {"s": 431.19, "e": 434.09, "t": "Precies."}, {"s": 438.69, "e": 442.39, "t": "Martha, Marieke komt op bezoek."}, {"s": 442.39, "e": 445.89, "t": "Jij laat haar de woonkamer zien."}, {"s": 445.89, "e": 449.8, "t": "Kom binnen. Dit is onze woonkamer."}, {"s": 449.8, "e": 452.69, "t": "Wat gezellig. En wat is er achter die"}, {"s": 452.69, "e": 453.69, "t": "deur?"}, {"s": 453.69, "e": 455.89, "t": "De keuken."}, {"s": 455.89, "e": 458.3, "t": "Wil je even kijken?"}, {"s": 458.3, "e": 461.39, "t": "Graag. Hebben jullie ook een tuin?"}, {"s": 461.39, "e": 464.6, "t": "Ja, achter het huis. Een kleine tuin."}, {"s": 464.6, "e": 467.3, "t": "En waar kan ik mijn jas hangen?"}, {"s": 467.3, "e": 471.19, "t": "Hm, in de bij de voordeur."}, {"s": 471.19, "e": 473.0, "t": "We hebben daar"}, {"s": 473.0, "e": 476.39, "t": "ehm voor jassen."}, {"s": 476.39, "e": 478.6, "t": "Je bedoelt de kapstok?"}, {"s": 478.6, "e": 481.3, "t": "Ja, aan de kapstok."}, {"s": 481.3, "e": 483.89, "t": "In de hal."}, {"s": 483.89, "e": 487.1, "t": "Goed. Je kunt je jas in de hal hangen is"}, {"s": 487.1, "e": 489.9, "t": "ook duidelijk."}, {"s": 490.1, "e": 493.2, "t": "Je kunt je jas in de hal hangen."}, {"s": 493.2, "e": 496.1, "t": "Dankjewel. Waar kan ik zitten?"}, {"s": 496.1, "e": 498.6, "t": "Op de bank naast Pip."}, {"s": 498.6, "e": 501.1, "t": "Als hij een plekje vrij maakt?"}, {"s": 501.1, "e": 503.05, "t": "Dat moet je aan hem vragen."}, {"s": 509.9, "e": 512.2, "t": "We kennen het huis nu."}, {"s": 512.2, "e": 514.4, "t": "Hoe is de buurt?"}, {"s": 514.4, "e": 516.9, "t": "Rustig."}, {"s": 516.9, "e": 521.3, "t": "Er is ehm een park dichtbij"}, {"s": 521.3, "e": 523.1, "t": "en een supermarkt."}, {"s": 523.1, "e": 525.6, "t": "5 minuten lopen."}, {"s": 525.6, "e": 527.8, "t": "Wat vind je daar fijn aan?"}, {"s": 527.8, "e": 529.1, "t": "Ehm"}, {"s": 529.1, "e": 531.6, "t": "ik kan naar het park lopen"}, {"s": 531.6, "e": 533.9, "t": "met mijn dochter"}, {"s": 533.9, "e": 536.1, "t": "en naar de winkel."}, {"s": 536.1, "e": 538.2, "t": "En wat zoek je nog?"}, {"s": 538.2, "e": 541.8, "t": "Ehm bakker. Mijn buurvrouw weet er één"}, {"s": 541.8, "e": 545.1, "t": "maar ik ehm begreep haar uitleg niet"}, {"s": 545.1, "e": 546.4, "t": "goed."}, {"s": 546.4, "e": 548.9, "t": "Is er een bakker in de buurt?"}, {"s": 548.9, "e": 552.3, "t": "Ja, hier om de hoek rechts naast de"}, {"s": 552.3, "e": 554.0, "t": "apotheek."}, {"s": 554.0, "e": 555.6, "t": "Om de hoek"}, {"s": 555.6, "e": 557.5, "t": "ehm"}, {"s": 557.5, "e": 559.6, "t": "Ik ken hier"}, {"s": 559.6, "e": 561.5, "t": "en naast"}, {"s": 561.5, "e": 564.4, "t": "maar om de hoek"}, {"s": 564.4, "e": 566.5, "t": "Stel je voor dat je door een straat"}, {"s": 566.5, "e": 568.1, "t": "loopt."}, {"s": 568.1, "e": 571.0, "t": "Dan kom je bij een andere straat."}, {"s": 571.0, "e": 573.3, "t": "Waar die twee straten bij elkaar komen"}, {"s": 573.3, "e": 575.4, "t": "is de hoek."}, {"s": 575.4, "e": 578.1, "t": "En als je niet zeker weet welke kant je"}, {"s": 578.1, "e": 579.5, "t": "op moet"}, {"s": 579.5, "e": 581.8, "t": "Hm hm."}, {"s": 581.8, "e": 584.4, "t": "Dan kun je vragen moet ik bij de hoek"}, {"s": 584.4, "e": 586.6, "t": "rechtsaf?"}, {"s": 586.6, "e": 588.9, "t": "Zullen we het oefenen?"}, {"s": 588.9, "e": 591.7, "t": "Ik speel Anja."}, {"s": 591.7, "e": 594.4, "t": "Moet ik hier rechtsaf?"}, {"s": 594.4, "e": 596.2, "t": "Ja."}, {"s": 596.2, "e": 599.4, "t": "De bakker zit naast de apotheek."}, {"s": 599.4, "e": 603.3, "t": "En hoe vraag ik hoeveel minuten?"}, {"s": 603.3, "e": 605.3, "t": "Dan vraag je"}, {"s": 605.3, "e": 607.4, "t": "hoelang is het lopen?"}, {"s": 607.4, "e": 608.6, "t": "Ah."}, {"s": 608.6, "e": 613.7, "t": "Ik loop die kant ehm eigenlijk nooit op."}, {"s": 613.7, "e": 616.3, "t": "Voor de supermarkt ga ik altijd ehm"}, {"s": 616.3, "e": 618.9, "t": "linksaf."}, {"s": 619.1, "e": 621.9, "t": "Vijf minuten lopen voor verse broodjes."}, {"s": 621.9, "e": 624.22, "t": "Gevaarlijk dichtbij."}, {"s": 625.6, "e": 628.7, "t": "Dat klinkt vooral heel handig."}, {"s": 628.7, "e": 631.1, "t": "Dan koop ik elke ochtend een broodje of"}, {"s": 631.1, "e": 632.08, "t": "twee."}, {"s": 638.3, "e": 640.7, "t": "Martha, Anja helpt je om de buurt te"}, {"s": 640.7, "e": 642.8, "t": "leren kennen."}, {"s": 642.8, "e": 645.9, "t": "Hoe nodig je haar nu uit?"}, {"s": 645.9, "e": 648.0, "t": "Ik wil vragen"}, {"s": 648.0, "e": 650.1, "t": "zaterdag"}, {"s": 650.1, "e": 652.1, "t": "koffie bij ons."}, {"s": 652.1, "e": 654.9, "t": "Maar hoe vraag ik dat?"}, {"s": 654.9, "e": 656.3, "t": "Je kunt zeggen"}, {"s": 656.3, "e": 660.1, "t": "kom je zaterdag koffie drinken?"}, {"s": 660.3, "e": 663.2, "t": "Kom je zaterdag koffie drinken?"}, {"s": 663.2, "e": 664.3, "t": "Ja."}, {"s": 664.3, "e": 666.5, "t": "Kort en vriendelijk."}, {"s": 666.5, "e": 669.7, "t": "Ik ben even Anja. Vraag het maar."}, {"s": 669.7, "e": 672.3, "t": "Kom je zaterdag koffie drinken?"}, {"s": 672.3, "e": 674.5, "t": "Ja, leuk. Hoe laat?"}, {"s": 674.5, "e": 676.4, "t": "Om 11 uur?"}, {"s": 676.4, "e": 679.0, "t": "Prima. Tot zaterdag."}, {"s": 679.0, "e": 680.7, "t": "Tot zaterdag."}, {"s": 680.7, "e": 683.3, "t": "Dat is geregeld. Ja."}, {"s": 683.3, "e": 685.79, "t": "Nu nog het huis opruimen."}, {"s": 687.6, "e": 689.6, "t": "Je hoeft de kast met schoonmaakspullen"}, {"s": 689.6, "e": 690.8, "t": "niet te laten zien."}, {"s": 690.8, "e": 695.3, "t": "Nee. [gelach] Die deur blijft dicht."}, {"s": 699.0, "e": 700.3, "t": "De ochtendzon valt zachtjes [muziek]"}, {"s": 700.3, "e": 702.4, "t": "door het glas."}, {"s": 702.4, "e": 704.0, "t": "Hoi Anja."}, {"s": 704.0, "e": 705.2, "t": "Kom binnen."}, {"s": 705.2, "e": 707.2, "t": "Je kunt je jas in de hal hangen."}, {"s": 707.2, "e": 709.1, "t": "Dankjewel."}, {"s": 709.1, "e": 711.7, "t": "Dit is onze woonkamer."}, {"s": 711.7, "e": 715.1, "t": "En dit is de keuken. Daar is ehm het"}, {"s": 715.1, "e": 717.0, "t": "ding voor koffie."}, {"s": 717.0, "e": 718.4, "t": "De koffiemachine?"}, {"s": 718.4, "e": 719.5, "t": "Ja."}, {"s": 719.5, "e": 721.5, "t": "De koffiemachine. Wil je koffie?"}, {"s": 721.5, "e": 723.5, "t": "Graag."}, {"s": 723.5, "e": 727.2, "t": "En achter het huis is de tuin."}, {"s": 727.2, "e": 729.5, "t": "Wat gezellig."}, {"s": 729.5, "e": 731.2, "t": "En dit is Pip."}, {"s": 731.2, "e": 734.9, "t": "Hij ligt graag op de vensterbank."}, {"s": 737.7, "e": 740.8, "t": "Je hebt je huis zelf laten zien."}, {"s": 740.8, "e": 742.7, "t": "Ja."}, {"s": 742.7, "e": 744.7, "t": "Ik zocht soms een woord,"}, {"s": 744.7, "e": 748.0, "t": "maar we konden praten."}, {"s": 748.0, "e": 749.8, "t": "Dat is goed gelukt."}, {"s": 749.8, "e": 752.0, "t": "En liet Pip haar rustig zitten?"}, {"s": 752.0, "e": 754.0, "t": "Ja, maar later [muziek]"}, {"s": 754.0, "e": 756.53, "t": "ging hij op haar jas liggen."}, {"s": 762.8, "e": 766.8, "t": "Marieke, welke zinnen nemen we mee?"}, {"s": 766.8, "e": 768.0, "t": "Eerst"}, {"s": 768.0, "e": 770.1, "t": "ik woon in"}, {"s": 770.1, "e": 773.8, "t": "bijvoorbeeld ik woon in een tussenwoning"}, {"s": 773.8, "e": 777.4, "t": "of ik woon in een benedenwoning."}, {"s": 777.4, "e": 781.1, "t": "Ik woon in een tussenwoning."}, {"s": 781.1, "e": 782.1, "t": "Twee"}, {"s": 782.1, "e": 785.6, "t": "er is en er zijn."}, {"s": 785.6, "e": 788.3, "t": "Er is een keuken."}, {"s": 788.3, "e": 791.5, "t": "Er zijn twee slaapkamers."}, {"s": 791.5, "e": 794.7, "t": "En waar iets staat?"}, {"s": 794.7, "e": 798.1, "t": "De bank staat naast het raam."}, {"s": 798.1, "e": 802.5, "t": "Of de kast staat tegenover de bank."}, {"s": 802.5, "e": 806.1, "t": "De kast staat tegenover de bank."}, {"s": 806.1, "e": 807.8, "t": "Voor de buurt"}, {"s": 807.8, "e": 810.9, "t": "is er een bakker in de buurt?"}, {"s": 810.9, "e": 812.7, "t": "Je kunt bakker vervangen door"}, {"s": 812.7, "e": 817.3, "t": "bijvoorbeeld supermarkt of park."}, {"s": 817.3, "e": 820.7, "t": "En als je wilt weten of iets dichtbij is"}, {"s": 820.7, "e": 822.3, "t": "is het ver?"}, {"s": 822.3, "e": 826.1, "t": "Of hoelang is het lopen?"}, {"s": 826.1, "e": 828.3, "t": "Vijf minuten naar de bakker."}, {"s": 828.3, "e": 829.89, "t": "Dat onthoud ik wel."}, {"s": 836.2, "e": 837.6, "t": "Marieke"}, {"s": 837.6, "e": 841.7, "t": "hoe kan Martha dit thuis verder oefenen?"}, {"s": 841.7, "e": 844.5, "t": "Eén loop door je huis."}, {"s": 844.5, "e": 847.9, "t": "Vertel hardop waar je bent."}, {"s": 847.9, "e": 849.6, "t": "Dit is de keuken."}, {"s": 849.6, "e": 852.8, "t": "De badkamer is boven."}, {"s": 852.8, "e": 855.6, "t": "Pip kan luisteren."}, {"s": 855.6, "e": 856.2, "t": "Die"}, {"s": 856.2, "e": 858.71, "t": "misschien gewoon mee."}, {"s": 860.7, "e": 861.7, "t": "Twee."}, {"s": 861.7, "e": 864.6, "t": "Oefen drie zinnen over je buurt."}, {"s": 864.6, "e": 867.2, "t": "Wat is er dichtbij?"}, {"s": 867.2, "e": 869.5, "t": "Wat vind je fijn?"}, {"s": 869.5, "e": 872.5, "t": "Wat zoek je nog?"}, {"s": 872.7, "e": 875.6, "t": "En als je een woord niet weet?"}, {"s": 875.6, "e": 881.2, "t": "Vertel waar het is of wat je ermee doet."}, {"s": 881.3, "e": 884.0, "t": "Zoals Martha met de vensterbank, de"}, {"s": 884.0, "e": 887.2, "t": "kapstok en de koffiemachine."}, {"s": 887.2, "e": 890.1, "t": "Je mag ook wijzen en vragen hoe heet"}, {"s": 890.1, "e": 891.9, "t": "dit?"}, {"s": 891.9, "e": 894.0, "t": "Dus ik kan ook gewoon beginnen. Niet"}, {"s": 894.0, "e": 896.9, "t": "eerst ehm"}, {"s": 896.9, "e": 899.2, "t": "elk woord opzoeken."}, {"s": 899.2, "e": 900.4, "t": "Ja."}, {"s": 900.4, "e": 902.0, "t": "En tip drie."}, {"s": 902.0, "e": 904.9, "t": "Stel een buur een korte vraag."}, {"s": 904.9, "e": 907.3, "t": "Bijvoorbeeld is er een bakker in de"}, {"s": 907.3, "e": 908.4, "t": "buurt?"}, {"s": 908.4, "e": 912.0, "t": "Zo kan een gesprek beginnen."}, {"s": 912.0, "e": 914.0, "t": "Of een koffiebezoek."}, {"s": 914.0, "e": 915.7, "t": "Ja."}, {"s": 915.7, "e": 918.32, "t": "Nu moet ik ook koekjes kopen."}, {"s": 925.0, "e": 927.5, "t": "Martha, wat is nu het verschil tussen je"}, {"s": 927.5, "e": 930.4, "t": "buren en je buurt?"}, {"s": 930.4, "e": 934.1, "t": "Mijn buren zijn ehm de mensen die vlak"}, {"s": 934.1, "e": 936.0, "t": "bij mij wonen."}, {"s": 936.0, "e": 938.1, "t": "En mijn buurt is de omgeving van mijn"}, {"s": 938.1, "e": 939.4, "t": "huis."}, {"s": 939.4, "e": 943.8, "t": "Met ehm straten, huizen en winkels."}, {"s": 943.8, "e": 946.2, "t": "Precies."}, {"s": 946.2, "e": 949.4, "t": "En wie kent de buurt het best?"}, {"s": 949.4, "e": 950.5, "t": "Pip."}, {"s": 950.5, "e": 953.69, "t": "Maar ik weet nu waar de bakker is."}, {"s": 956.3, "e": 957.6, "t": "En jij?"}, {"s": 957.6, "e": 960.5, "t": "Schrijf in de reacties één woord. Wat is"}, {"s": 960.5, "e": 962.5, "t": "er in de buurt van jouw huis?"}, {"s": 962.5, "e": 967.4, "t": "Bijvoorbeeld park, bakker of supermarkt."}, {"s": 967.4, "e": 970.5, "t": "Eén woord is genoeg."}, {"s": 970.5, "e": 972.7, "t": "Voordat we afscheid nemen"}, {"s": 972.7, "e": 976.9, "t": "oefenen we nog een paar zinnen samen."}, {"s": 980.7, "e": 982.8, "t": "Nee ben jij aan de buurt."}, {"s": 982.8, "e": 985.6, "t": "Ik zeg elke zin twee keer."}, {"s": 985.6, "e": 989.6, "t": "Eerst normaal en daarna iets langzamer."}, {"s": 989.6, "e": 993.0, "t": "Daarna zeg jij de zin."}, {"s": 993.1, "e": 995.4, "t": "Bij de eerste drie zinnen mag je iets"}, {"s": 995.4, "e": 998.0, "t": "over jouw eigen huis vertellen."}, {"s": 998.0, "e": 1001.2, "t": "Bijvoorbeeld, ik woon in een appartement"}, {"s": 1001.2, "e": 1004.5, "t": "of er is een balkon."}, {"s": 1004.5, "e": 1008.1, "t": "Ik woon in een tussenwoning."}, {"s": 1008.1, "e": 1012.5, "t": "Ik woon in een tussenwoning."}, {"s": 1015.6, "e": 1018.7, "t": "Er zijn twee slaapkamers."}, {"s": 1018.7, "e": 1022.8, "t": "Er zijn twee slaapkamers."}, {"s": 1025.7, "e": 1029.5, "t": "De bank staat naast het raam."}, {"s": 1029.5, "e": 1034.3, "t": "De bank staat naast het raam."}, {"s": 1037.3, "e": 1040.2, "t": "Nu een vraag over de buurt."}, {"s": 1040.2, "e": 1044.1, "t": "Je mag ook naar een andere plek vragen."}, {"s": 1044.1, "e": 1047.6, "t": "Is er een bakker in de buurt?"}, {"s": 1047.6, "e": 1051.7, "t": "Is er een bakker in de buurt?"}, {"s": 1054.6, "e": 1058.0, "t": "De volgende zinnen kun je precies zo"}, {"s": 1058.0, "e": 1060.6, "t": "herhalen."}, {"s": 1060.6, "e": 1063.5, "t": "Hoelang is het lopen?"}, {"s": 1063.5, "e": 1067.4, "t": "Hoelang is het lopen?"}, {"s": 1070.3, "e": 1073.6, "t": "Kom je zaterdag koffie drinken?"}, {"s": 1073.6, "e": 1077.7, "t": "Kom je zaterdag koffie drinken?"}, {"s": 1080.4, "e": 1082.5, "t": "Kom binnen."}, {"s": 1082.5, "e": 1085.2, "t": "Kom binnen."}, {"s": 1088.4, "e": 1090.8, "t": "Hoe heet dit?"}, {"s": 1090.8, "e": 1093.7, "t": "Hoe heet dit?"}, {"s": 1097.3, "e": 1099.4, "t": "Goed gedaan."}, {"s": 1099.4, "e": 1102.2, "t": "Oefen deze week een paar zinnen in je"}, {"s": 1102.2, "e": 1104.5, "t": "eigen huis."}, {"s": 1104.5, "e": 1107.2, "t": "Je mag tegen de kat praten als je die"}, {"s": 1107.2, "e": 1109.0, "t": "hebt."}, {"s": 1109.0, "e": 1111.0, "t": "Maar probeer het ook een keer met de"}, {"s": 1111.0, "e": 1112.9, "t": "buren."}, {"s": 1112.9, "e": 1115.4, "t": "Bedankt voor het kijken en luisteren."}, {"s": 1115.4, "e": 1119.1, "t": "Tot de volgende Café Talk. Zeg maar"}, {"s": 1119.1, "e": 1123.3, "t": "Nederlands, Nederlands."}]