[{"s": 1.24, "e": 5.48, "t": "Hoi allemaal, ik ben Noelle en welkom"}, {"s": 5.48, "e": 9.44, "t": "terug op het kanaal."}, {"s": 9.44, "e": 12.52, "t": "Ik sta nu in mijn huis"}, {"s": 12.52, "e": 16.72, "t": "en wij zijn nu in deze kamer."}, {"s": 16.72, "e": 19.8, "t": "Deze kamer"}, {"s": 19.8, "e": 24.68, "t": "aan het verbouwen, aan het renoveren."}, {"s": 24.68, "e": 27.72, "t": "En dat betekent dat wij dingen aan het"}, {"s": 27.72, "e": 32.76, "t": "aanpassen zijn aan de kamer om het fijn"}, {"s": 32.76, "e": 37.48, "t": "te maken, om het leuk te maken of"}, {"s": 37.48, "e": 42.48, "t": "duurzamer te maken. dat eh de verwarming"}, {"s": 42.48, "e": 45.52, "t": "minder energie verbruikt"}, {"s": 45.52, "e": 49.4, "t": "of er minder kouw naar binnen komt door"}, {"s": 49.4, "e": 52.08, "t": "te isoleren"}, {"s": 52.08, "e": 55.6, "t": "of door te verven"}, {"s": 55.6, "e": 59.56, "t": "op de muren te verven"}, {"s": 59.56, "e": 65.84, "t": "of een nieuwe vloer erin doen. Vloer."}, {"s": 65.84, "e": 69.64, "t": "Nou, dat doen wij allemaal."}, {"s": 69.64, "e": 74.24, "t": "Dus wij doen heel veel in deze kamer"}, {"s": 74.24, "e": 77.6, "t": "en daarvoor gebruiken wij heel veel"}, {"s": 77.6, "e": 80.4, "t": "dingen, heel veel spullen"}, {"s": 80.4, "e": 83.24, "t": "waaronder gereedschap"}, {"s": 83.24, "e": 86.28, "t": "en voorbouwmateriaal."}, {"s": 86.28, "e": 90.48, "t": "En ik wilde dat aan jullie laten zien."}, {"s": 90.48, "e": 93.44, "t": "Dus dat ga ik nu doen."}, {"s": 93.44, "e": 97.48, "t": "Sommige dingen zijn heel groot en"}, {"s": 97.48, "e": 101.24, "t": "sommige dingen zijn klein."}, {"s": 101.24, "e": 105.6, "t": "Dus sommige kan ik niet optillen en"}, {"s": 105.6, "e": 109.36, "t": "andere dingen wel."}, {"s": 109.36, "e": 112.76, "t": "Als eerste hebben wij een heel"}, {"s": 112.76, "e": 116.2, "t": "belangrijk eh ding"}, {"s": 116.2, "e": 119.32, "t": "en dat is dit."}, {"s": 119.32, "e": 122.6, "t": "Dit is een ladder,"}, {"s": 122.6, "e": 126.88, "t": "maar het is niet heel groot. Ladders"}, {"s": 126.88, "e": 129.92, "t": "zijn meestal heel lang,"}, {"s": 129.92, "e": 133.8, "t": "maar dit is eigenlijk Hallo."}, {"s": 133.8, "e": 138.8, "t": "Maar dit is een kleine ladder. Kijk,"}, {"s": 139.84, "e": 145.8, "t": "deze heeft maar vier treden."}, {"s": 145.8, "e": 149.8, "t": "Dus het is eigenlijk ook wel een trapje."}, {"s": 149.8, "e": 153.48, "t": "Dit wordt ook wel een huishoudtrapje"}, {"s": 153.48, "e": 157.24, "t": "of een verbouwtrapje genoemd."}, {"s": 157.24, "e": 161.24, "t": "Want het wordt gebruikt om"}, {"s": 161.24, "e": 163.68, "t": "midden in de kamer"}, {"s": 163.68, "e": 166.36, "t": "het neer te zetten"}, {"s": 166.36, "e": 169.44, "t": "en dan daar wat te kunnen doen en niet"}, {"s": 169.44, "e": 174.56, "t": "tegen een muur aan. Dus los."}, {"s": 174.56, "e": 175.84, "t": "Los."}, {"s": 175.84, "e": 178.84, "t": "Niet"}, {"s": 179.96, "e": 185.52, "t": "niet tegen de muur. Voorzichtig het"}, {"s": 185.52, "e": 187.52, "t": "terugzetten."}, {"s": 187.52, "e": 190.6, "t": "Zo geluid. Zo."}, {"s": 190.6, "e": 193.8, "t": "Hier op de vloer,"}, {"s": 193.8, "e": 196.6, "t": "dat kun jij niet zien,"}, {"s": 196.6, "e": 200.04, "t": "ligt iets."}, {"s": 201.24, "e": 204.6, "t": "En dat is dit."}, {"s": 204.6, "e": 207.84, "t": "Dit is schuurpapier."}, {"s": 207.84, "e": 211.24, "t": "Het is papier"}, {"s": 214.84, "e": 218.56, "t": "allemaal stof"}, {"s": 218.56, "e": 221.6, "t": "om mee te schuren."}, {"s": 221.6, "e": 224.16, "t": "De muur te schuren"}, {"s": 224.16, "e": 227.52, "t": "of hout te schuren."}, {"s": 227.52, "e": 231.72, "t": "En dit is vel geel."}, {"s": 231.72, "e": 235.96, "t": "En type 120."}, {"s": 236.16, "e": 241.44, "t": "Dit zegt iets over hoe klein"}, {"s": 241.44, "e": 245.84, "t": "de schuurstukjes zijn. Dus hoeveel je"}, {"s": 245.84, "e": 248.56, "t": "wegschuurt."}, {"s": 248.56, "e": 252.04, "t": "En deze is gebruikt al. Dit is niet"}, {"s": 252.04, "e": 256.08, "t": "nieuw. Dit is gebruikt schuurpapier."}, {"s": 256.08, "e": 261.28, "t": "Dus daarom ligt het op de vloer. Kijk."}, {"s": 261.28, "e": 265.36, "t": "Dit is nieuw schuurpapier."}, {"s": 265.64, "e": 267.92, "t": "Zie je het verschil?"}, {"s": 267.92, "e": 271.28, "t": "Ze zijn niet hetzelfde, maar anders. Er"}, {"s": 271.28, "e": 274.88, "t": "is een verschil."}, {"s": 275.76, "e": 278.04, "t": "Zo."}, {"s": 278.04, "e": 280.08, "t": "Nieuw schuurpapier. Gebruikt"}, {"s": 280.08, "e": 281.8, "t": "schuurpapier."}, {"s": 281.8, "e": 284.72, "t": "Deze leg ik terug op de grond, op de"}, {"s": 284.72, "e": 287.72, "t": "vloer."}, {"s": 288.92, "e": 292.68, "t": "En nog iets voor schuren"}, {"s": 292.68, "e": 295.96, "t": "is dit."}, {"s": 298.08, "e": 302.04, "t": "Dit is een schuurmachine."}, {"s": 302.04, "e": 307.0, "t": "Kijk, zie je? Dit is geel,"}, {"s": 307.0, "e": 310.64, "t": "net als het andere schuurpapier."}, {"s": 310.64, "e": 314.64, "t": "Maar het is rond"}, {"s": 315.4, "e": 318.76, "t": "met gaatjes."}, {"s": 319.4, "e": 323.12, "t": "En dit apparaat, deze machine"}, {"s": 323.12, "e": 327.36, "t": "maakt schuren makkelijker"}, {"s": 327.36, "e": 330.8, "t": "en het zit vol met"}, {"s": 330.8, "e": 335.8, "t": "verf en gips van de muur."}, {"s": 335.8, "e": 340.32, "t": "Dus daarom is het wit."}, {"s": 340.44, "e": 345.44, "t": "En overal in de kamer is het wit. Ook"}, {"s": 345.44, "e": 347.52, "t": "deze plant"}, {"s": 347.52, "e": 352.8, "t": "is een beetje wit en heeft dit stof"}, {"s": 352.8, "e": 356.36, "t": "erop. Ja,"}, {"s": 356.36, "e": 361.4, "t": "mijn handen zijn nu ook een beetje wit."}, {"s": 364.72, "e": 367.56, "t": "Hier is wel iets wat daar handig voor"}, {"s": 367.56, "e": 370.56, "t": "is."}, {"s": 371.84, "e": 376.4, "t": "Dit is stoffer en blik."}, {"s": 376.4, "e": 379.4, "t": "Dit is de stoffer."}, {"s": 379.4, "e": 382.32, "t": "En dit is het blik."}, {"s": 382.32, "e": 385.36, "t": "Dit zijn oude namen"}, {"s": 385.36, "e": 389.48, "t": "en vroeger was dat misschien logischer,"}, {"s": 389.48, "e": 392.6, "t": "maar nu heet het stoffer en blik"}, {"s": 392.6, "e": 396.12, "t": "om dingen mee op te vegen en weg te"}, {"s": 396.12, "e": 400.56, "t": "gooien in de prullenbak."}, {"s": 400.8, "e": 405.64, "t": "En deze zijn gemaakt van plastic"}, {"s": 405.72, "e": 410.28, "t": "en ook een beetje wit. Kijk."}, {"s": 411.56, "e": 415.32, "t": "Dan hier nog iets wat handig is voor al"}, {"s": 415.32, "e": 421.8, "t": "het stof in de kamer en al het vel."}, {"s": 421.8, "e": 424.08, "t": "Die is groot."}, {"s": 424.08, "e": 429.48, "t": "Dus ik ga kijken of ik het kan optillen."}, {"s": 431.96, "e": 435.68, "t": "Oeh, de sportschool heeft geholpen."}, {"s": 435.68, "e": 437.68, "t": "W"}, {"s": 437.68, "e": 441.88, "t": "Dit is onze stofzuiger."}, {"s": 442.52, "e": 445.52, "t": "Kijk."}, {"s": 447.76, "e": 450.44, "t": "En deze stofzuiger"}, {"s": 450.44, "e": 453.88, "t": "is niet normaal. Dit is niet een normale"}, {"s": 453.88, "e": 455.76, "t": "stofzuiger,"}, {"s": 455.76, "e": 460.32, "t": "maar een renovatiestofzuiger."}, {"s": 460.32, "e": 463.64, "t": "Een verbouwenstofzuiger"}, {"s": 463.76, "e": 467.76, "t": "die minder snel kapot gaat van stof en"}, {"s": 467.76, "e": 471.24, "t": "harde stukjes."}, {"s": 472.44, "e": 475.24, "t": "Een normale stofzuiger kan daar kapot"}, {"s": 475.24, "e": 478.84, "t": "van gaan. Dus deze was belangrijk om te"}, {"s": 478.84, "e": 481.48, "t": "kopen."}, {"s": 481.48, "e": 485.96, "t": "En dit is een opzetstukje"}, {"s": 485.96, "e": 489.08, "t": "voor kleine hoekjes."}, {"s": 489.08, "e": 491.48, "t": "En"}, {"s": 491.48, "e": 496.12, "t": "anders kun je deze gebruiken"}, {"s": 496.12, "e": 499.36, "t": "voor de grond. Zo, de vloer."}, {"s": 499.36, "e": 506.64, "t": "Dan zet je dit zo erop en dan zo"}, {"s": 506.64, "e": 510.32, "t": "gebruik je het. Zo."}, {"s": 512.32, "e": 516.12, "t": "Nog een paar dingen."}, {"s": 516.36, "e": 518.8, "t": "Dit is een"}, {"s": 518.8, "e": 521.8, "t": "oorbeschermer"}, {"s": 523.32, "e": 526.52, "t": "tegen hartgeluid. Ik kan mezelf nu niet"}, {"s": 526.52, "e": 530.72, "t": "horen, maar dit is tegen"}, {"s": 530.72, "e": 536.08, "t": "artgeluid van de machines."}, {"s": 537.2, "e": 540.2, "t": "En"}, {"s": 540.48, "e": 545.32, "t": "dit is een mondkapje tegen het stof. En"}, {"s": 545.32, "e": 548.64, "t": "dat is ongezond. Dat is niet goed voor"}, {"s": 548.64, "e": 551.48, "t": "je gezondheid."}, {"s": 551.48, "e": 554.68, "t": "Zoveel stof overal."}, {"s": 554.68, "e": 558.08, "t": "Oh, er is nog zoveel."}, {"s": 558.08, "e": 560.68, "t": "Wat nog meer?"}, {"s": 560.68, "e": 564.24, "t": "Dit zijn maar een paar dingen"}, {"s": 564.24, "e": 567.76, "t": "van alles wat hier ligt."}, {"s": 567.76, "e": 571.64, "t": "Dit is een sponsje. Kijk,"}, {"s": 571.64, "e": 574.24, "t": "een sponsje"}, {"s": 574.24, "e": 577.24, "t": "om schoon te maken"}, {"s": 577.24, "e": 582.56, "t": "met een zachte kant en een ruwe kant."}, {"s": 582.56, "e": 586.28, "t": "Dit zijn handschoenen"}, {"s": 586.88, "e": 590.4, "t": "voor je handen. Handschoenen."}, {"s": 590.4, "e": 592.88, "t": "Dan denk je: \"Waarom heet dit een"}, {"s": 592.88, "e": 596.84, "t": "handschoen? Een schoen is toch"}, {"s": 596.84, "e": 598.84, "t": "dit?\""}, {"s": 598.84, "e": 603.24, "t": "Ja, het is een handschoen. Zo heet dat."}, {"s": 603.24, "e": 606.56, "t": "Het is raar, maar zo heet dat."}, {"s": 606.56, "e": 610.92, "t": "om je handen te beschermen."}, {"s": 611.52, "e": 616.08, "t": "En deze heeft ook grip om makkelijker"}, {"s": 616.08, "e": 620.12, "t": "dingen vast te houden."}, {"s": 620.8, "e": 623.52, "t": "Dus belangrijk ook voor bescherming,"}, {"s": 623.52, "e": 626.0, "t": "voor veiligheid."}, {"s": 626.0, "e": 630.88, "t": "En dan als laatste voor vandaag"}, {"s": 630.88, "e": 634.36, "t": "is er dit."}, {"s": 635.16, "e": 639.2, "t": "Dit is een kitpistool."}, {"s": 639.2, "e": 642.6, "t": "Daarin kun je kit doen. Kijk, dit is"}, {"s": 642.6, "e": 645.44, "t": "kit. Dit was voor de badkamer"}, {"s": 645.44, "e": 648.84, "t": "voor tegels."}, {"s": 649.52, "e": 652.72, "t": "Dus niet in deze kamer, maar in onze"}, {"s": 652.72, "e": 655.52, "t": "badkamer."}, {"s": 655.52, "e": 658.24, "t": "En daar doe je deze in."}, {"s": 658.24, "e": 661.88, "t": "En dan druk druk"}, {"s": 661.88, "e": 665.36, "t": "je hier het in."}, {"s": 665.36, "e": 670.0, "t": "Dan druk je hier zo wanneer je het eruit"}, {"s": 670.0, "e": 674.28, "t": "wilt laten komen en het wilt"}, {"s": 674.28, "e": 678.12, "t": "toepassen, het erop wilt doen"}, {"s": 678.12, "e": 682.0, "t": "op de tegels. In dit geval"}, {"s": 682.0, "e": 685.24, "t": "kijk zoals dit."}, {"s": 685.24, "e": 687.68, "t": "Hier is de lijmpistool."}, {"s": 687.68, "e": 691.28, "t": "Die zit hier. En dan doe je het hier zo"}, {"s": 691.28, "e": 694.28, "t": "erop."}, {"s": 695.96, "e": 699.08, "t": "Het kitpistool."}, {"s": 702.08, "e": 705.4, "t": "Ik hou niet van pistolen of wapens, maar"}, {"s": 705.4, "e": 707.68, "t": "deze is heel fijn."}, {"s": 707.68, "e": 712.8, "t": "Zo, dat waren wat grote dingen"}, {"s": 712.8, "e": 716.52, "t": "die wij gebruiken voor de verbouwing,"}, {"s": 716.52, "e": 721.28, "t": "voor de renovaties in ons huis."}, {"s": 721.28, "e": 725.32, "t": "In een andere video zal ik wat kleinere"}, {"s": 725.32, "e": 728.2, "t": "dingen laten zien, want daar hebben wij"}, {"s": 728.2, "e": 732.56, "t": "er ook heel veel van."}, {"s": 733.0, "e": 736.6, "t": "Oké. Heb jij ook deze spullen? Ben jij"}, {"s": 736.6, "e": 738.92, "t": "ook aan het verbouwen"}, {"s": 738.92, "e": 743.24, "t": "of vind je dat niet leuk of niet fijn?"}, {"s": 743.24, "e": 746.68, "t": "Laat je het me weten in de opmerkingen."}, {"s": 746.68, "e": 752.12, "t": "Tot de volgende keer. Doei. Doei."}]