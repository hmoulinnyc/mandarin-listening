[{"s": 0.32, "e": 6.12, "t": "Hoi allemaal, ik ben Noelle en het is"}, {"s": 6.12, "e": 10.8, "t": "tijd om mijn haar"}, {"s": 10.8, "e": 12.84, "t": "mijn haar"}, {"s": 12.84, "e": 14.92, "t": "te knippen,"}, {"s": 14.92, "e": 17.44, "t": "korter te maken."}, {"s": 17.44, "e": 21.0, "t": "Het is heel lang nu."}, {"s": 21.0, "e": 25.84, "t": "Lang. Kijk, heel lang voor mij."}, {"s": 25.84, "e": 29.56, "t": "Oe, kijk een haar."}, {"s": 29.6, "e": 32.6, "t": "En mijn"}, {"s": 32.6, "e": 35.04, "t": "laagjes."}, {"s": 35.04, "e": 37.32, "t": "Laagjes."}, {"s": 37.32, "e": 42.6, "t": "Kijk, hier is een laagje"}, {"s": 42.6, "e": 45.6, "t": "en hier is een laagje."}, {"s": 45.6, "e": 52.48, "t": "En hier die zijn ook heel lang. Die wil"}, {"s": 52.48, "e": 54.12, "t": "ik"}, {"s": 54.12, "e": 59.88, "t": "korter. hebben. Dus nu zijn ze lang en"}, {"s": 59.88, "e": 65.04, "t": "ik wil ze korter maken."}, {"s": 65.76, "e": 71.04, "t": "Mijn haar is ook heel vet."}, {"s": 71.04, "e": 72.76, "t": "Kijk."}, {"s": 72.76, "e": 75.0, "t": "Vet."}, {"s": 75.0, "e": 77.88, "t": "Nu het lijkt"}, {"s": 77.88, "e": 82.84, "t": "alsof er heel veel olie in zit. olie"}, {"s": 82.84, "e": 86.04, "t": "hier zo bij mijn hoofdhuid"}, {"s": 86.04, "e": 90.16, "t": "hier bij mijn hoofdhuid op mijn hoofd"}, {"s": 90.16, "e": 95.16, "t": "want ik moet het wassen"}, {"s": 95.32, "e": 97.96, "t": "met shampoo"}, {"s": 97.96, "e": 103.72, "t": "en altijd als ik mijn haar knip dan doe"}, {"s": 103.72, "e": 106.24, "t": "ik dat voordat"}, {"s": 106.24, "e": 112.88, "t": "ik mijn haar was zodat het minder"}, {"s": 112.88, "e": 116.0, "t": "gekruld is."}, {"s": 116.0, "e": 119.4, "t": "Normaal heb ik krullen"}, {"s": 119.4, "e": 122.28, "t": "een beetje"}, {"s": 122.28, "e": 125.8, "t": "ja, even kijken. Een klein beetje zoals"}, {"s": 125.8, "e": 129.4, "t": "dit. Oh, kijk. Ja,"}, {"s": 129.4, "e": 133.08, "t": "een beetje zoals dit. Een krul, maar dan"}, {"s": 133.08, "e": 135.24, "t": "overal"}, {"s": 135.24, "e": 138.28, "t": "overal in mijn haar."}, {"s": 138.28, "e": 142.12, "t": "Maar als ik het moet wassen,"}, {"s": 142.12, "e": 145.6, "t": "dan wordt het wat stij."}, {"s": 145.6, "e": 149.52, "t": "Dus stel zo."}, {"s": 149.52, "e": 154.08, "t": "Stel niet gekruld."}, {"s": 154.24, "e": 156.52, "t": "Niet gekruld,"}, {"s": 156.52, "e": 159.12, "t": "maar stel"}, {"s": 159.12, "e": 162.6, "t": "stel haar."}, {"s": 162.8, "e": 168.88, "t": "Nu is het een beetje met slag. Niet"}, {"s": 168.88, "e": 174.08, "t": "krul, niet stij, maar slag."}, {"s": 174.08, "e": 177.2, "t": "En dan is het makkelijker,"}, {"s": 177.2, "e": 181.52, "t": "niet moeilijk om mijn haar te knippen."}, {"s": 181.52, "e": 187.44, "t": "Want als eerste als eerste stap moet ik"}, {"s": 187.44, "e": 189.76, "t": "het borstelen."}, {"s": 189.76, "e": 193.96, "t": "Dit is een borstel. Dit is een speciale"}, {"s": 193.96, "e": 197.8, "t": "borstel. Speciaal voor gekruld haar om"}, {"s": 197.8, "e": 202.96, "t": "te stijlen. Dus met gel gebruik ik om"}, {"s": 202.96, "e": 208.68, "t": "het in een bepaalde vorm te houden na"}, {"s": 208.68, "e": 211.0, "t": "het wassen."}, {"s": 211.0, "e": 213.28, "t": "Daar gebruik"}, {"s": 213.28, "e": 215.68, "t": "ik dit voor."}, {"s": 215.68, "e": 220.2, "t": "Maar ik kan het ook gebruiken voor"}, {"s": 220.2, "e": 221.76, "t": "borstelen."}, {"s": 221.76, "e": 226.88, "t": "Dus ik ga mijn haar nu borstelen."}, {"s": 229.08, "e": 231.44, "t": "Ik borstel"}, {"s": 231.44, "e": 238.16, "t": "mijn haar om klitten eruit te halen,"}, {"s": 238.16, "e": 243.44, "t": "zodat er geen klitten in mijn haar zijn"}, {"s": 243.44, "e": 246.28, "t": "wanneer ik het knip."}, {"s": 246.28, "e": 249.28, "t": "Dat is heel belangrijk."}, {"s": 249.28, "e": 253.0, "t": "Dus oeh, kijk hier is een klit. Moet ik"}, {"s": 253.0, "e": 256.0, "t": "eruitborstelen?"}, {"s": 259.08, "e": 261.76, "t": "Je kunt het hier zo zien. Dit is een"}, {"s": 261.76, "e": 264.76, "t": "klit"}, {"s": 265.0, "e": 268.6, "t": "hier. Zo. Kijk, dat is een klit."}, {"s": 268.6, "e": 271.6, "t": "Eh"}, {"s": 273.56, "e": 276.96, "t": "hier dit"}, {"s": 276.96, "e": 280.8, "t": "dat is een klit. Dat is allemaal haar"}, {"s": 280.8, "e": 284.8, "t": "haren. Dat zijn haren die in de knoop"}, {"s": 284.8, "e": 287.4, "t": "zijn."}, {"s": 287.4, "e": 290.96, "t": "En zo"}, {"s": 290.96, "e": 295.6, "t": "borstel ik het eruit."}, {"s": 297.16, "e": 300.16, "t": "Ja,"}, {"s": 300.2, "e": 303.2, "t": "opgelost."}, {"s": 303.76, "e": 308.36, "t": "Zo, mijn linkerkant."}, {"s": 308.36, "e": 311.52, "t": "is geborsteld"}, {"s": 311.52, "e": 315.68, "t": "en dan de rechterkant."}, {"s": 316.0, "e": 319.08, "t": "Daar waren geen klitten,"}, {"s": 319.08, "e": 322.04, "t": "dus dat is goed."}, {"s": 322.04, "e": 329.16, "t": "Oké, de eerste stap is mijn haar"}, {"s": 329.16, "e": 334.92, "t": "nat maken. Daarvoor heb ik iets nodig."}, {"s": 334.92, "e": 337.8, "t": "Dat is deze spray."}, {"s": 337.8, "e": 341.48, "t": "Dit is een sprayf"}, {"s": 341.48, "e": 343.88, "t": "waarmee ik"}, {"s": 343.88, "e": 348.24, "t": "eh water in mijn haar kan doen. Het heet"}, {"s": 348.24, "e": 351.96, "t": "ook wel een spuit, een haarpuit, want"}, {"s": 351.96, "e": 355.84, "t": "het spuit water."}, {"s": 355.84, "e": 359.84, "t": "Dus ik ga mijn haar nat spuiten nu met"}, {"s": 359.84, "e": 362.84, "t": "water."}, {"s": 364.88, "e": 367.92, "t": "Ene helft."}, {"s": 367.92, "e": 374.32, "t": "Helft. Één helft. Tweede helft is nu een"}, {"s": 374.32, "e": 377.76, "t": "beetje nat."}, {"s": 384.64, "e": 387.48, "t": "Oeh, mijn trui"}, {"s": 387.48, "e": 391.52, "t": "is ook nat nu."}, {"s": 391.52, "e": 395.48, "t": "En overal zijn haren."}, {"s": 395.48, "e": 397.92, "t": "Hier is een haar."}, {"s": 397.92, "e": 404.32, "t": "Oh ja, hier is een haar. Allemaal haren."}, {"s": 404.48, "e": 408.88, "t": "Die doe ik hier."}, {"s": 408.88, "e": 414.8, "t": "Oké. De volgende stap is de lengte"}, {"s": 414.8, "e": 416.48, "t": "lengte"}, {"s": 416.48, "e": 419.2, "t": "korter maken."}, {"s": 419.2, "e": 422.44, "t": "En daarvoor"}, {"s": 423.36, "e": 427.52, "t": "ik moet even de microfoon verplaatsen."}, {"s": 427.52, "e": 432.28, "t": "Daarvoor heb ik twee dingen nodig."}, {"s": 432.28, "e": 435.36, "t": "Ja, wel meer, maar"}, {"s": 435.36, "e": 437.96, "t": "twee spullen."}, {"s": 437.96, "e": 441.32, "t": "Deze kam."}, {"s": 441.32, "e": 444.12, "t": "Dit is een kam."}, {"s": 444.12, "e": 447.04, "t": "En"}, {"s": 447.04, "e": 448.6, "t": "deze"}, {"s": 448.6, "e": 452.92, "t": "haarschaar of kappers schaar."}, {"s": 452.92, "e": 457.84, "t": "Dit is als een kapper."}, {"s": 457.84, "e": 463.32, "t": "Iemand die haar knipt voor werk. Als die"}, {"s": 463.32, "e": 465.04, "t": "kijkt,"}, {"s": 465.04, "e": 469.12, "t": "dan denkt de kapper:"}, {"s": 469.12, "e": 474.4, "t": "\"Waarom knip jij met deze schaar?"}, {"s": 474.4, "e": 476.2, "t": "Want"}, {"s": 476.2, "e": 479.4, "t": "het is speciaal voor"}, {"s": 479.4, "e": 481.52, "t": "h"}, {"s": 481.52, "e": 485.92, "t": "een bepaalde soort kniptechniek."}, {"s": 485.92, "e": 490.88, "t": "Maar ik heb kleine handen"}, {"s": 490.88, "e": 497.32, "t": "handen. En ik wilde een schaar"}, {"s": 497.32, "e": 502.24, "t": "die makkelijk vast te houden"}, {"s": 502.24, "e": 507.52, "t": "was voor mij. Dus ik heb deze"}, {"s": 507.52, "e": 510.52, "t": "gekocht"}, {"s": 511.08, "e": 513.56, "t": "en het werkt prima."}, {"s": 513.56, "e": 517.96, "t": "Dus ik vind het goed. Oké."}, {"s": 517.96, "e": 522.64, "t": "Ik wil denk ik"}, {"s": 523.28, "e": 526.28, "t": "ongeveer"}, {"s": 528.36, "e": 531.32, "t": "zo"}, {"s": 531.32, "e": 533.4, "t": "ja,"}, {"s": 533.4, "e": 537.04, "t": "ik denk ongeveer"}, {"s": 537.04, "e": 539.72, "t": "zoveel knippen."}, {"s": 539.72, "e": 544.08, "t": "Ja, wel een beetje. Niet heel veel, maar"}, {"s": 544.08, "e": 546.56, "t": "wel een beetje,"}, {"s": 546.56, "e": 551.12, "t": "zodat mijn haar gezond blijft."}, {"s": 551.12, "e": 553.52, "t": "Oeh, ik vind het een beetje spannend"}, {"s": 553.52, "e": 555.76, "t": "altijd."}, {"s": 555.76, "e": 561.16, "t": "Dus goed kammen met een kam."}, {"s": 561.16, "e": 567.12, "t": "een beetje extra nat maken. En dan"}, {"s": 567.12, "e": 568.72, "t": "draai"}, {"s": 568.72, "e": 571.44, "t": "ik mijn hoofd"}, {"s": 571.44, "e": 575.64, "t": "deze kant op,"}, {"s": 575.64, "e": 580.56, "t": "zodat het gelijk is."}, {"s": 580.68, "e": 584.08, "t": "En dan heb ik dit."}, {"s": 584.08, "e": 588.96, "t": "En dan ga ik knippen."}, {"s": 591.24, "e": 593.44, "t": "Ietsjes minder."}, {"s": 593.44, "e": 596.76, "t": "Ja, dit is beter."}, {"s": 596.76, "e": 601.16, "t": "Ik kan altijd meer knippen, maar niet"}, {"s": 601.16, "e": 604.16, "t": "minder."}, {"s": 604.48, "e": 607.88, "t": "Ik ga knippen."}, {"s": 612.44, "e": 615.56, "t": "gelukt. Geknipt."}, {"s": 615.56, "e": 617.08, "t": "Oké,"}, {"s": 617.08, "e": 619.44, "t": "ene kant"}, {"s": 619.44, "e": 621.16, "t": "gedaan,"}, {"s": 621.16, "e": 625.08, "t": "dan de andere kant"}, {"s": 625.08, "e": 628.68, "t": "ook kammen."}, {"s": 629.92, "e": 635.2, "t": "En het moet gelijk zijn met deze kant."}, {"s": 635.2, "e": 638.24, "t": "Dus ik moet goed"}, {"s": 638.24, "e": 642.32, "t": "ik moet goed kijken."}, {"s": 643.32, "e": 648.4, "t": "Ja, dit ga ik knippen."}, {"s": 651.64, "e": 655.0, "t": "Klaar geknipt."}, {"s": 655.0, "e": 657.64, "t": "Is dit gelijk?"}, {"s": 657.64, "e": 660.96, "t": "Even kijken."}, {"s": 664.88, "e": 668.32, "t": "Ik denk het wel."}, {"s": 668.32, "e": 670.36, "t": "Fijn."}, {"s": 670.36, "e": 672.2, "t": "Kijken."}, {"s": 672.2, "e": 674.52, "t": "Ja, ongeveer"}, {"s": 674.52, "e": 676.24, "t": "wel."}, {"s": 676.24, "e": 679.52, "t": "Het hoeft niet perfect te zijn, want"}, {"s": 679.52, "e": 683.16, "t": "mijn haar krult op."}, {"s": 683.16, "e": 686.52, "t": "Dus het verschil"}, {"s": 686.52, "e": 692.08, "t": "is niet heel goed te zien."}, {"s": 692.08, "e": 693.88, "t": "Oké,"}, {"s": 693.88, "e": 697.8, "t": "eerste gedeelte klaar."}, {"s": 697.8, "e": 701.72, "t": "Eerlijk gezegd het makkelijkste."}, {"s": 701.72, "e": 709.28, "t": "Nu komen alle laagjes en de voorplukjes."}, {"s": 709.28, "e": 713.52, "t": "Ik ga eerst de voorplukjes"}, {"s": 713.52, "e": 715.32, "t": "doen,"}, {"s": 715.32, "e": 719.32, "t": "want dan kan ik de laagjes"}, {"s": 719.32, "e": 722.04, "t": "daarop baseren."}, {"s": 722.04, "e": 726.0, "t": "Ehm en daarvoor heb ik nodig"}, {"s": 726.0, "e": 728.08, "t": "een"}, {"s": 728.08, "e": 730.72, "t": "elastiekje."}, {"s": 730.72, "e": 734.96, "t": "Even kijken. Hier is een elastiekje."}, {"s": 734.96, "e": 738.96, "t": "En klemmetjes."}, {"s": 740.32, "e": 742.16, "t": "Even kijken."}, {"s": 742.16, "e": 746.44, "t": "Ik maak een driehoek"}, {"s": 746.44, "e": 752.16, "t": "hier aan de voorkant en eerst een"}, {"s": 752.16, "e": 756.84, "t": "schiding. Kijk, ik maak een scheiding in"}, {"s": 756.84, "e": 759.4, "t": "mijn haar"}, {"s": 759.4, "e": 763.2, "t": "zo over mijn hoofd uit."}, {"s": 763.2, "e": 767.56, "t": "Oh nee, die is niet goed. Nieuw."}, {"s": 767.56, "e": 770.64, "t": "Hm. Oké, goed begin."}, {"s": 770.64, "e": 775.08, "t": "Maar nog steeds niet helemaal goed."}, {"s": 777.44, "e": 780.88, "t": "Niet recht"}, {"s": 781.28, "e": 785.04, "t": "beter denk ik."}, {"s": 785.64, "e": 789.64, "t": "Nee, opnieuw."}, {"s": 792.64, "e": 794.32, "t": "Ja,"}, {"s": 794.32, "e": 796.4, "t": "stuk beter."}, {"s": 796.4, "e": 800.48, "t": "En dan"}, {"s": 800.48, "e": 804.68, "t": "maak ik de driehoek."}, {"s": 813.12, "e": 816.76, "t": "Oké, ene helft"}, {"s": 816.76, "e": 819.4, "t": "is hier."}, {"s": 819.4, "e": 823.88, "t": "En dan pak ik een klemmetje."}, {"s": 826.28, "e": 831.56, "t": "En de andere helft."}, {"s": 832.68, "e": 836.84, "t": "Oeh, droge lenzen."}, {"s": 837.92, "e": 841.6, "t": "Dit is niet goed, denk ik."}, {"s": 841.6, "e": 847.32, "t": "Het is moeilijk te zien door het haar."}, {"s": 847.32, "e": 850.68, "t": "Even kijken. Nee,"}, {"s": 850.68, "e": 855.28, "t": "ietsjes dichterbij hier."}, {"s": 856.6, "e": 858.76, "t": "Volgens mij"}, {"s": 858.76, "e": 861.44, "t": "is dit goed."}, {"s": 861.44, "e": 864.16, "t": "Ongeveer wel. Ja."}, {"s": 864.16, "e": 867.16, "t": "Oké."}, {"s": 867.16, "e": 871.88, "t": "En dan zet ik dit vast"}, {"s": 871.88, "e": 875.64, "t": "in een staart."}, {"s": 875.64, "e": 878.48, "t": "Oh. of een knot."}, {"s": 878.48, "e": 881.76, "t": "Zo, in een knot."}, {"s": 881.76, "e": 887.04, "t": "En dan moet ik denken"}, {"s": 887.04, "e": 891.64, "t": "hoe kort ik de kortste plukjes wil"}, {"s": 891.64, "e": 894.64, "t": "hebben."}, {"s": 896.04, "e": 899.4, "t": "En die mogen wel"}, {"s": 899.4, "e": 903.48, "t": "een stuk korter dan nu."}, {"s": 903.48, "e": 909.36, "t": "Nu is het zo lang. Heel lang."}, {"s": 909.36, "e": 912.0, "t": "Kijk hoe lang."}, {"s": 912.0, "e": 918.04, "t": "Veel te lang. Het moet korter."}, {"s": 918.04, "e": 922.2, "t": "Veel te lang. Ik denk dat ik het tot"}, {"s": 922.2, "e": 924.76, "t": "hier knip"}, {"s": 924.76, "e": 927.2, "t": "om te beginnen."}, {"s": 927.2, "e": 930.92, "t": "Dus dat ga ik nu doen"}, {"s": 930.92, "e": 935.68, "t": "in ieder geval tot hier."}, {"s": 938.08, "e": 939.76, "t": "Zo"}, {"s": 939.76, "e": 943.56, "t": "tot mijn kin."}, {"s": 944.44, "e": 949.72, "t": "Want als dit krult dan wordt het korter."}, {"s": 949.72, "e": 951.96, "t": "Wat denk ik?"}, {"s": 951.96, "e": 957.52, "t": "Ja, denk ik wel. Goed. En dan"}, {"s": 958.72, "e": 962.2, "t": "knip ik"}, {"s": 962.44, "e": 966.88, "t": "een hoek"}, {"s": 968.0, "e": 972.04, "t": "in elke kant."}, {"s": 973.72, "e": 976.24, "t": "Even kijken hoor."}, {"s": 976.24, "e": 982.28, "t": "Zo. Dus dan knip ik op een hoek."}, {"s": 987.44, "e": 991.24, "t": "Zie je het verschil?"}, {"s": 993.4, "e": 998.92, "t": "Dit is geknipt en dit nog niet."}, {"s": 998.92, "e": 1003.2, "t": "Dus nu ook deze kant."}, {"s": 1006.04, "e": 1009.56, "t": "Een beetje korter hier"}, {"s": 1009.56, "e": 1012.88, "t": "en hier."}, {"s": 1013.6, "e": 1015.8, "t": "Oké."}, {"s": 1015.8, "e": 1021.24, "t": "Ah oké. Ik denk dat ik deze ietsjes"}, {"s": 1021.24, "e": 1024.76, "t": "korter moet maken."}, {"s": 1024.76, "e": 1028.08, "t": "Hier. Zo."}, {"s": 1033.52, "e": 1036.52, "t": "Ja,"}, {"s": 1044.44, "e": 1048.8, "t": "nu is het meer gelijk"}, {"s": 1048.8, "e": 1052.96, "t": "hetzelfde. Hoe? Hetzelfde."}, {"s": 1052.96, "e": 1056.52, "t": "Niet anders."}, {"s": 1058.32, "e": 1066.72, "t": "Oké, dan de rest van de zijkant hier."}, {"s": 1069.04, "e": 1073.52, "t": "Kijk, want nu is er een groot verschil"}, {"s": 1073.52, "e": 1078.16, "t": "tussen dit en dit."}, {"s": 1078.32, "e": 1080.96, "t": "Het stopt hier en dan gaat het hier"}, {"s": 1080.96, "e": 1082.28, "t": "verder."}, {"s": 1082.28, "e": 1088.72, "t": "Dus ik moet dat ook verder knippen."}, {"s": 1088.72, "e": 1091.96, "t": "Het plukje."}, {"s": 1097.32, "e": 1103.04, "t": "Nu loopt het beter door."}, {"s": 1103.04, "e": 1107.52, "t": "Ene kant klaar."}, {"s": 1107.52, "e": 1110.92, "t": "Deze kant."}, {"s": 1114.2, "e": 1117.68, "t": "in een knot."}, {"s": 1120.72, "e": 1125.44, "t": "En dan hetzelfde hier"}, {"s": 1126.2, "e": 1127.8, "t": "kammen."}, {"s": 1127.8, "e": 1131.68, "t": "Kijk, heel groot verschil. Stopt hier en"}, {"s": 1131.68, "e": 1134.08, "t": "dan hier verder."}, {"s": 1134.08, "e": 1135.76, "t": "Oké,"}, {"s": 1135.76, "e": 1138.48, "t": "dus ik pak"}, {"s": 1138.48, "e": 1141.88, "t": "dit plukje."}, {"s": 1146.08, "e": 1152.0, "t": "Zit dit er goed uit? Even kijken."}, {"s": 1152.76, "e": 1157.48, "t": "Vergeleken met deze kant."}, {"s": 1159.32, "e": 1162.08, "t": "Ik denk"}, {"s": 1162.08, "e": 1166.52, "t": "dat het wel goed is."}, {"s": 1169.0, "e": 1171.52, "t": "Oké,"}, {"s": 1171.52, "e": 1175.76, "t": "dan gaan we verder naar de laagjes"}, {"s": 1175.76, "e": 1179.44, "t": "aan de achterkant."}, {"s": 1179.44, "e": 1182.16, "t": "Dat is"}, {"s": 1182.16, "e": 1187.16, "t": "h ook een beetje moeilijk."}, {"s": 1187.68, "e": 1190.44, "t": "Maar ik ga proberen het makkelijk te"}, {"s": 1190.44, "e": 1192.72, "t": "maken"}, {"s": 1192.72, "e": 1197.12, "t": "door een bepaalde techniek te gebruiken."}, {"s": 1197.12, "e": 1200.76, "t": "Oké, wat ik moet doen,"}, {"s": 1200.76, "e": 1205.4, "t": "ik maak mijn haar weer nat en"}, {"s": 1205.4, "e": 1209.64, "t": "ik maak een paardenstaart of een staart"}, {"s": 1209.64, "e": 1212.16, "t": "aan allebei"}, {"s": 1212.16, "e": 1215.4, "t": "de kanten."}, {"s": 1221.2, "e": 1224.2, "t": "Zo,"}, {"s": 1224.72, "e": 1228.36, "t": "één kleur. Dan heb ik nog een elastiek"}, {"s": 1228.36, "e": 1230.64, "t": "nodig."}, {"s": 1230.64, "e": 1235.2, "t": "Nu deze kant. Oh ja, eerst nat maken met"}, {"s": 1235.2, "e": 1238.92, "t": "de spray"}, {"s": 1238.92, "e": 1242.4, "t": "en de borstel."}, {"s": 1246.16, "e": 1247.68, "t": "Oké."}, {"s": 1247.68, "e": 1249.16, "t": "Wauw."}, {"s": 1249.16, "e": 1252.72, "t": "in één keer."}, {"s": 1254.24, "e": 1259.48, "t": "Ze moeten hetzelfde zijn, niet anders."}, {"s": 1259.48, "e": 1263.2, "t": "Anders gaat het verkeerd."}, {"s": 1263.2, "e": 1268.56, "t": "En ik denk dat ze hetzelfde zijn. Yes."}, {"s": 1268.56, "e": 1272.48, "t": "Oké. Hoe? Dan"}, {"s": 1272.48, "e": 1278.12, "t": "ga ik een stukje een stukje knippen om"}, {"s": 1278.12, "e": 1282.08, "t": "laagjes te maken."}, {"s": 1282.08, "e": 1285.96, "t": "Ik vind het een beetje spannend,"}, {"s": 1285.96, "e": 1289.72, "t": "maar dit is veel sneller. Veel sneller."}, {"s": 1289.72, "e": 1294.52, "t": "Het is minder langzaam"}, {"s": 1294.52, "e": 1298.08, "t": "dan een andere techniek."}, {"s": 1298.08, "e": 1302.36, "t": "Dus ik ga het toch maar doen."}, {"s": 1302.36, "e": 1305.88, "t": "Daar gaan we."}, {"s": 1305.92, "e": 1309.2, "t": "Het moet recht."}, {"s": 1309.2, "e": 1312.2, "t": "Zo.்ப்ப"}, {"s": 1315.68, "e": 1320.12, "t": "ik zoveel voor nu."}, {"s": 1320.88, "e": 1325.8, "t": "En dan ook aan deze kant."}, {"s": 1326.8, "e": 1332.32, "t": "Oké, deze kant nu knippen."}, {"s": 1342.4, "e": 1346.16, "t": "Dat is wel gelijk."}, {"s": 1347.28, "e": 1352.0, "t": "Hm. Deze kant is ietsjes langer, dus ik"}, {"s": 1352.0, "e": 1354.32, "t": "ga het ietsjes"}, {"s": 1354.32, "e": 1357.8, "t": "meer knippen."}, {"s": 1360.68, "e": 1364.32, "t": "Ja, nu goed. Oké, we halen de"}, {"s": 1364.32, "e": 1368.56, "t": "elastiekjes eruit"}, {"s": 1368.72, "e": 1372.6, "t": "om te kijken of het"}, {"s": 1372.6, "e": 1375.08, "t": "goed is."}, {"s": 1375.08, "e": 1379.52, "t": "Oh, dat is nog steeds heel lang."}, {"s": 1382.76, "e": 1386.64, "t": "Ik ga meer knippen."}, {"s": 1386.64, "e": 1390.48, "t": "Poging twee."}, {"s": 1391.52, "e": 1394.8, "t": "Nog meer."}, {"s": 1397.96, "e": 1400.16, "t": "Spannend."}, {"s": 1400.16, "e": 1403.44, "t": "En dan deze kant."}, {"s": 1403.44, "e": 1406.64, "t": "Dit nu."}, {"s": 1408.16, "e": 1410.8, "t": "Oké,"}, {"s": 1410.8, "e": 1415.0, "t": "ik hoop dat het goed is gegaan."}, {"s": 1417.6, "e": 1421.04, "t": "Ik denk het."}, {"s": 1422.96, "e": 1427.2, "t": "Oh. Oh, een klit."}, {"s": 1429.0, "e": 1433.24, "t": "Oh, en een stuk trui."}, {"s": 1435.64, "e": 1440.96, "t": "Het elastiekje zit vast in mijn haar."}, {"s": 1440.96, "e": 1443.96, "t": "Hallo."}, {"s": 1444.96, "e": 1447.0, "t": "Zo,"}, {"s": 1447.0, "e": 1450.64, "t": "dit is nu het resultaat"}, {"s": 1450.64, "e": 1453.16, "t": "tot nu toe."}, {"s": 1453.16, "e": 1457.88, "t": "Het is al beter. Er zijn al betere"}, {"s": 1457.88, "e": 1459.76, "t": "laagjes,"}, {"s": 1459.76, "e": 1462.64, "t": "maar deze"}, {"s": 1462.64, "e": 1466.0, "t": "zijn nog steeds te lang."}, {"s": 1466.0, "e": 1467.76, "t": "Dus"}, {"s": 1467.76, "e": 1471.44, "t": "wat ik meestal doe"}, {"s": 1471.44, "e": 1474.4, "t": "is ik pak wat plukjes"}, {"s": 1474.4, "e": 1478.32, "t": "van de bovenste bovenste"}, {"s": 1478.32, "e": 1479.92, "t": "laag"}, {"s": 1479.92, "e": 1484.4, "t": "en knip die korter"}, {"s": 1484.6, "e": 1489.32, "t": "op een hoek opnieuw."}, {"s": 1489.56, "e": 1492.48, "t": "Zo."}, {"s": 1492.48, "e": 1496.04, "t": "En hier zo."}, {"s": 1496.04, "e": 1499.04, "t": "Deze."}, {"s": 1500.28, "e": 1504.96, "t": "En deze is heel belangrijk."}, {"s": 1511.48, "e": 1514.92, "t": "Oké, beter."}, {"s": 1515.04, "e": 1518.44, "t": "Soms is het moeilijk om goed te zien."}, {"s": 1518.44, "e": 1521.0, "t": "hoe het eruitziet."}, {"s": 1521.0, "e": 1524.44, "t": "hoe het eruitziet"}, {"s": 1524.64, "e": 1528.36, "t": "na het wassen."}, {"s": 1528.36, "e": 1530.88, "t": "Dus"}, {"s": 1530.88, "e": 1533.76, "t": "ja,"}, {"s": 1533.76, "e": 1537.28, "t": "ik ga dit nu zo laten"}, {"s": 1537.28, "e": 1541.44, "t": "en deze kant doen."}, {"s": 1541.44, "e": 1544.96, "t": "bijvoorbeeld deze."}, {"s": 1551.0, "e": 1553.68, "t": "Nog een plukje."}, {"s": 1553.68, "e": 1557.4, "t": "En nog een plukje."}, {"s": 1558.52, "e": 1561.6, "t": "Ehm hierchter"}, {"s": 1561.6, "e": 1564.96, "t": "mijn achterhoofd"}, {"s": 1564.96, "e": 1567.96, "t": "ook"}, {"s": 1568.8, "e": 1571.64, "t": "zo"}, {"s": 1571.64, "e": 1575.2, "t": "allemaal schilvertjes."}, {"s": 1576.24, "e": 1580.72, "t": "Oké, ik denk ik denk dat dat wel goed"}, {"s": 1580.72, "e": 1583.64, "t": "is."}, {"s": 1583.64, "e": 1588.04, "t": "Hier bijvoorbeeld deze. Hoe krult hij?"}, {"s": 1588.04, "e": 1589.92, "t": "Zo."}, {"s": 1589.92, "e": 1592.8, "t": "Krult hij zo"}, {"s": 1592.8, "e": 1595.72, "t": "straks zoiets."}, {"s": 1595.72, "e": 1599.16, "t": "Ja, dat is wel goed, denk ik."}, {"s": 1599.16, "e": 1603.8, "t": "Oké. Oh, het haar. Ik denk"}, {"s": 1603.8, "e": 1607.76, "t": "dat ik klaar ben."}, {"s": 1608.52, "e": 1610.44, "t": "Ja,"}, {"s": 1610.44, "e": 1612.92, "t": "ik denk het."}, {"s": 1612.92, "e": 1617.16, "t": "En dan kan ik nu gaan wassen"}, {"s": 1617.16, "e": 1619.56, "t": "en opruimen."}, {"s": 1619.56, "e": 1621.64, "t": "Kijk,"}, {"s": 1621.64, "e": 1625.28, "t": "allemaal haar en de elastiekjes"}, {"s": 1625.28, "e": 1630.44, "t": "en de klemmetjes en de kam en de spray."}, {"s": 1630.44, "e": 1632.12, "t": "Waar is mijn schaar? Oh, hier is mijn"}, {"s": 1632.12, "e": 1634.36, "t": "schaar."}, {"s": 1634.36, "e": 1638.12, "t": "Allemaal moet opgeruimd worden."}, {"s": 1638.12, "e": 1642.6, "t": "Dus ehm dat ga ik doen. En dan douchen."}, {"s": 1642.6, "e": 1647.52, "t": "Douchen en mijn haren wassen"}, {"s": 1647.52, "e": 1650.36, "t": "en dan stijlen"}, {"s": 1650.36, "e": 1652.04, "t": "en"}, {"s": 1652.04, "e": 1654.92, "t": "mijn haar föen"}, {"s": 1654.92, "e": 1659.4, "t": "met een fö. En dan zien we het resultaat"}, {"s": 1659.4, "e": 1661.04, "t": "erna."}, {"s": 1661.04, "e": 1664.4, "t": "Dankjewel voor het kijken. Ik hoop dat"}, {"s": 1664.4, "e": 1667.96, "t": "je nieuwe woorden hebt geleerd."}, {"s": 1667.96, "e": 1670.68, "t": "Ik ben benieuwd."}, {"s": 1670.68, "e": 1675.52, "t": "Knip jij ook eigen haar of ga je naar de"}, {"s": 1675.52, "e": 1679.76, "t": "kapper? Iemand die je haar knipt? Iemand"}, {"s": 1679.76, "e": 1681.44, "t": "anders?"}, {"s": 1681.44, "e": 1685.04, "t": "Laat je het weten in de opmerkingen?"}, {"s": 1685.04, "e": 1687.68, "t": "Ik hoor het graag."}, {"s": 1687.68, "e": 1692.76, "t": "En tot de volgende keer. Doei. Doei."}]