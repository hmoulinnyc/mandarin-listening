[{"s": 1.16, "e": 6.2, "t": "Hoi allemaal, ik ben Noelle en vandaag"}, {"s": 6.2, "e": 11.16, "t": "ga ik jullie laten zien wat ik vaak, dus"}, {"s": 11.16, "e": 13.56, "t": "heel veel dagen,"}, {"s": 13.56, "e": 16.16, "t": "eet als lunch."}, {"s": 16.16, "e": 20.36, "t": "Ik vind het fijn om warm,"}, {"s": 20.36, "e": 21.88, "t": "warm,"}, {"s": 21.88, "e": 23.72, "t": "heet, [gelach]"}, {"s": 23.72, "e": 26.56, "t": "niet koud"}, {"s": 26.56, "e": 28.4, "t": "te lunchen."}, {"s": 28.4, "e": 33.88, "t": "En als ik thuis thuis hier in mijn huis"}, {"s": 33.88, "e": 37.2, "t": "ben, dan maak ik dit."}, {"s": 37.2, "e": 40.52, "t": "Het is best wel gezond, dus goed voor"}, {"s": 40.52, "e": 42.6, "t": "mijn gezondheid."}, {"s": 42.6, "e": 45.4, "t": "En ik vind het lekker."}, {"s": 45.4, "e": 50.6, "t": "En het is best wel makkelijk. Niet heel"}, {"s": 50.6, "e": 52.8, "t": "moeilijk."}, {"s": 52.8, "e": 57.28, "t": "Ik vind het ook makkelijk om vaak"}, {"s": 57.28, "e": 59.0, "t": "hetzelfde"}, {"s": 59.0, "e": 64.0, "t": "hetzelfde te maken. Niet andere dingen,"}, {"s": 64.0, "e": 68.24, "t": "want dan hoef ik niet veel te denken. Ik"}, {"s": 68.24, "e": 72.68, "t": "kan gewoon doen, gewoon maken en niet"}, {"s": 72.68, "e": 79.12, "t": "denken over wat ik ga maken voor lunch."}, {"s": 79.12, "e": 84.12, "t": "Oké, dus wat maak ik dan voor lunch? Er"}, {"s": 84.12, "e": 87.44, "t": "staat hier nog helemaal niks."}, {"s": 87.44, "e": 91.2, "t": "Ik zal het laten zien, want het is"}, {"s": 91.2, "e": 95.32, "t": "allemaal in de koelkast."}, {"s": 95.32, "e": 98.76, "t": "Hier in de koelkast."}, {"s": 98.76, "e": 101.76, "t": "Oké,"}, {"s": 102.4, "e": 107.08, "t": "als eerste dit bakje"}, {"s": 107.88, "e": 109.96, "t": "en dan"}, {"s": 109.96, "e": 115.16, "t": "als tweede in de bovenste koelkast."}, {"s": 115.16, "e": 119.08, "t": "Dat moet ik even pakken"}, {"s": 119.4, "e": 122.56, "t": "met een krukje."}, {"s": 122.56, "e": 125.36, "t": "Mijn krukje."}, {"s": 125.36, "e": 129.2, "t": "Want ik weet niet of jullie dat weten,"}, {"s": 129.2, "e": 133.0, "t": "maar ik ben heel kort. Ik ben niet een"}, {"s": 133.0, "e": 135.16, "t": "lang persoon. [gelach]"}, {"s": 135.16, "e": 138.86, "t": "Dus ik heb een krukje nodig"}, {"s": 142.76, "e": 147.52, "t": "om daar iets te pakken."}, {"s": 154.36, "e": 157.26, "t": "Nog een bakje. [schraapt keel]"}, {"s": 159.08, "e": 163.56, "t": "Nog een bakje"}, {"s": 163.88, "e": 166.92, "t": "en dan als derde"}, {"s": 166.92, "e": 171.76, "t": "niet een bakje iets uit de vriezer. Dat"}, {"s": 171.76, "e": 176.28, "t": "vriezer waar alles bevroren"}, {"s": 176.28, "e": 181.04, "t": "is. Dat pak ik nu."}, {"s": 187.04, "e": 190.44, "t": "Wat een geluid."}, {"s": 190.52, "e": 193.8, "t": "Hier is een zak"}, {"s": 193.8, "e": 195.92, "t": "met broccoli."}, {"s": 195.92, "e": 199.78, "t": "Kijk, broccoli. Dit is broccoli. En"}, {"s": 203.2, "e": 205.2, "t": "beetje"}, {"s": 205.2, "e": 208.84, "t": "broccoli. Oké,"}, {"s": 208.84, "e": 212.6, "t": "dat is dus bevroren."}, {"s": 212.6, "e": 215.2, "t": "En wat is dit?"}, {"s": 215.2, "e": 220.32, "t": "Hierin zit zoete aardappel."}, {"s": 220.32, "e": 224.8, "t": "Zoete aardappel is zoals een aardappel,"}, {"s": 224.8, "e": 227.36, "t": "maar zoet."}, {"s": 227.36, "e": 229.96, "t": "Een beetje zoet."}, {"s": 229.96, "e": 234.36, "t": "En zo ziet het eruit."}, {"s": 234.36, "e": 240.92, "t": "En dit is al eerder een paar"}, {"s": 240.92, "e": 243.88, "t": "dagen geleden"}, {"s": 243.88, "e": 246.52, "t": "in de oven."}, {"s": 246.52, "e": 249.0, "t": "Dit is onze oven"}, {"s": 249.0, "e": 251.44, "t": "gebakken."}, {"s": 251.44, "e": 255.48, "t": "En dat doen we dan in een bakje."}, {"s": 255.48, "e": 259.76, "t": "En dan kunnen we het de dagen erna"}, {"s": 259.76, "e": 261.72, "t": "eten voor lunch."}, {"s": 261.72, "e": 265.44, "t": "En dit is heel gezond en lekker en"}, {"s": 265.44, "e": 269.24, "t": "vullend. Vullend. Dus als je dit eet,"}, {"s": 269.24, "e": 273.56, "t": "dan voel je je vol. Dan wil je niet heel"}, {"s": 273.56, "e": 275.96, "t": "veel eten."}, {"s": 275.96, "e": 280.0, "t": "Ehm dus allemaal goede dingen."}, {"s": 280.0, "e": 282.2, "t": "Zoete aardappel."}, {"s": 282.2, "e": 285.48, "t": "En oh en dit is specifiek"}, {"s": 285.48, "e": 287.76, "t": "specifiek"}, {"s": 287.76, "e": 292.04, "t": "paarse zoete aardappel. Je hebt ook"}, {"s": 292.04, "e": 296.16, "t": "oranje. Dat is heel gebruikelijk als"}, {"s": 296.16, "e": 298.88, "t": "soorten aardappel in Nederland."}, {"s": 298.88, "e": 302.56, "t": "Maar dit is paarse. Dat zie je hier wel"}, {"s": 302.56, "e": 304.76, "t": "goed."}, {"s": 304.76, "e": 309.32, "t": "D is een beetje paars. En dat smaakt een"}, {"s": 309.32, "e": 314.64, "t": "beetje anders dan oranje. En de textur"}, {"s": 314.64, "e": 318.76, "t": "is ook een beetje anders. Ik vind de"}, {"s": 318.76, "e": 320.4, "t": "textuur"}, {"s": 320.4, "e": 326.96, "t": "heel fijn van deze. Wat minder nat."}, {"s": 327.04, "e": 330.04, "t": "Nat, waterig"}, {"s": 330.04, "e": 334.92, "t": "en wat meer ja, iets droger."}, {"s": 334.92, "e": 336.64, "t": "En"}, {"s": 336.64, "e": 340.88, "t": "iemand omschreef het ooit dus met"}, {"s": 340.88, "e": 344.76, "t": "woorden uitleggen wat het betekent als"}, {"s": 344.76, "e": 348.68, "t": "een beetje een cakeje."}, {"s": 348.68, "e": 353.04, "t": "Ehm dat snap ik wel. Dus de zoete"}, {"s": 353.04, "e": 358.24, "t": "aardappel. En dan als derde"}, {"s": 358.24, "e": 361.48, "t": "iets waar één van jullie"}, {"s": 361.48, "e": 366.32, "t": "mij een berichtje over had geschreven."}, {"s": 366.32, "e": 368.12, "t": "Zeit:"}, {"s": 368.12, "e": 371.6, "t": "\"Ik heb een paar maanden geleden"}, {"s": 371.6, "e": 375.56, "t": "gemaakt voor de allereerste keer en nu"}, {"s": 375.56, "e": 379.68, "t": "eet ik het heel veel.\""}, {"s": 379.68, "e": 383.64, "t": "Oh, dit is een beetje vol."}, {"s": 383.64, "e": 388.47, "t": "Even het dekseltje eraf halen. [snuift]"}, {"s": 388.64, "e": 391.64, "t": "Kom op."}, {"s": 391.64, "e": 394.8, "t": "Er zit ook vloeistof in. Kijk,"}, {"s": 394.8, "e": 398.44, "t": "vloeistof. Dus ik moet voorzichtig"}, {"s": 398.44, "e": 401.04, "t": "zijn."}, {"s": 401.04, "e": 404.2, "t": "Het lepeltje."}, {"s": 405.64, "e": 408.72, "t": "Oeh, hoorde je dat [gelach]"}, {"s": 409.48, "e": 411.88, "t": "zo?"}, {"s": 411.88, "e": 415.12, "t": "En als je dit ziet, dan denk je niet hm"}, {"s": 415.12, "e": 419.72, "t": "heel lekker. Dat denk je niet."}, {"s": 419.72, "e": 422.64, "t": "Maar het is echt heel lekker."}, {"s": 422.64, "e": 427.24, "t": "Kijk, ik ga het laten zien."}, {"s": 432.88, "e": 435.88, "t": "Ja,"}, {"s": 436.08, "e": 438.96, "t": "het is echt lekker. [gelach]"}, {"s": 438.96, "e": 441.6, "t": "Ehm"}, {"s": 441.6, "e": 446.6, "t": "maar heel veel hiervan zijn kruiden."}, {"s": 446.92, "e": 448.52, "t": "Kruiden"}, {"s": 448.52, "e": 452.8, "t": "waarin het gekookt is. Gekookt in water"}, {"s": 452.8, "e": 455.44, "t": "in een pan."}, {"s": 455.44, "e": 458.36, "t": "En die pan ga ik nu pakken. [snuift]"}, {"s": 458.36, "e": 461.8, "t": "Deze pan"}, {"s": 461.92, "e": 466.92, "t": "hierin heeft de site gekookt."}, {"s": 466.92, "e": 470.84, "t": "Maar vandaag nu gaan we het gebruiken"}, {"s": 470.84, "e": 474.08, "t": "voor de broccoli."}, {"s": 474.08, "e": 477.88, "t": "En we gaan het stomen"}, {"s": 477.88, "e": 481.52, "t": "in een stoommandje."}, {"s": 481.52, "e": 484.84, "t": "Ik weet niet of je dat ook gebruikt,"}, {"s": 484.84, "e": 489.88, "t": "maar ik gebruik dit al heel lang."}, {"s": 489.88, "e": 491.8, "t": "Ik denk"}, {"s": 491.8, "e": 495.4, "t": "nu 10 jaar."}, {"s": 495.4, "e": 497.08, "t": "Ja,"}, {"s": 497.08, "e": 502.28, "t": "mijn moeder heeft dit aan mij gegeven"}, {"s": 502.28, "e": 505.24, "t": "toen ik uit huis"}, {"s": 505.24, "e": 508.28, "t": "ging. Dus toen ik niet meer bij haar"}, {"s": 508.28, "e": 512.72, "t": "woonde en in mijn eentje"}, {"s": 512.72, "e": 514.68, "t": "ging wonen."}, {"s": 514.68, "e": 517.68, "t": "Zelfstandig."}, {"s": 517.68, "e": 520.56, "t": "Dus die heb ik nog steeds. Ik vond het"}, {"s": 520.56, "e": 522.96, "t": "heel fijn."}, {"s": 522.96, "e": 530.4, "t": "En dit duurt eh 10 minuten denk ik."}, {"s": 532.28, "e": 535.08, "t": "Ja, meestal na"}, {"s": 535.08, "e": 540.16, "t": "5 tot 10 minuten. Dus dat ga ik snel"}, {"s": 540.16, "e": 542.16, "t": "opzetten."}, {"s": 542.16, "e": 546.4, "t": "Eerst met een waterkoker."}, {"s": 546.44, "e": 551.28, "t": "Wat water koken."}, {"s": 551.8, "e": 555.84, "t": "Ik zet je even hier zo neer."}, {"s": 555.84, "e": 559.4, "t": "Dat is beter. De waterkoker is nu aan"}, {"s": 559.4, "e": 561.32, "t": "het koken."}, {"s": 561.32, "e": 565.36, "t": "Zo, kijk, het water is gekookt. Er is"}, {"s": 565.36, "e": 567.76, "t": "stom."}, {"s": 567.76, "e": 569.6, "t": "Stom."}, {"s": 569.6, "e": 573.92, "t": "En dat doe ik in de pan."}, {"s": 575.24, "e": 579.4, "t": "Ja, een laagje."}, {"s": 579.4, "e": 583.44, "t": "Niet heel veel, want het moet niet koken"}, {"s": 583.44, "e": 588.16, "t": "in het water, maar het moet stomen in de"}, {"s": 588.16, "e": 589.88, "t": "stoom."}, {"s": 589.88, "e": 593.44, "t": "Oké, dus een laagje en dan zet ik het"}, {"s": 593.44, "e": 596.16, "t": "aan."}, {"s": 596.16, "e": 600.04, "t": "Pak ik de deksel. [schraapt keel]"}, {"s": 604.72, "e": 608.16, "t": "De deksel doe ik op de pan"}, {"s": 608.16, "e": 612.0, "t": "zodat het water en de stoom Jeetje, wat"}, {"s": 612.0, "e": 615.05, "t": "is er aan de hand?"}, {"s": 616.04, "e": 619.04, "t": "Zodat het water"}, {"s": 619.04, "e": 621.76, "t": "en de stoom"}, {"s": 621.76, "e": 627.12, "t": "erin blijft. En ondertussen"}, {"s": 627.12, "e": 629.76, "t": "pak ik een schaar"}, {"s": 629.76, "e": 631.92, "t": "en knip"}, {"s": 631.92, "e": 636.2, "t": "ik de zak open"}, {"s": 639.64, "e": 645.12, "t": "en doe ik de broccoli erin."}, {"s": 647.2, "e": 650.2, "t": "Zo."}, {"s": 652.72, "e": 656.36, "t": "ongeveer zoveel"}, {"s": 660.64, "e": 662.88, "t": "voor mij"}, {"s": 662.88, "e": 666.84, "t": "en mijn partner."}, {"s": 666.84, "e": 668.48, "t": "Zo."}, {"s": 668.48, "e": 672.84, "t": "Eh dus voor twee mensen."}, {"s": 672.84, "e": 678.36, "t": "En dan zet ik een timer aan."}, {"s": 678.36, "e": 682.0, "t": "Ja, 7 minuten misschien."}, {"s": 682.0, "e": 683.72, "t": "Z."}, {"s": 683.72, "e": 686.88, "t": "En ondertussen"}, {"s": 686.88, "e": 691.4, "t": "ga ik de zoete aardappel en de"}, {"s": 691.4, "e": 694.4, "t": "opwarmen."}, {"s": 695.0, "e": 699.24, "t": "En deze broccoli gaat terug de vriezer"}, {"s": 699.24, "e": 702.24, "t": "in."}, {"s": 706.32, "e": 709.12, "t": "Zo."}, {"s": 709.12, "e": 711.24, "t": "Oké."}, {"s": 711.24, "e": 715.84, "t": "Dus voor de zoete aardappel,"}, {"s": 716.12, "e": 719.68, "t": "de zoete aardappel"}, {"s": 719.96, "e": 728.16, "t": "pak ik deze en breek hem door midden."}, {"s": 728.44, "e": 730.72, "t": "Zo."}, {"s": 730.72, "e": 733.76, "t": "Een beetje weinig."}, {"s": 733.76, "e": 737.96, "t": "Dus ik doe deze ook erbij."}, {"s": 737.96, "e": 742.84, "t": "En dan in de air fryer."}, {"s": 746.4, "e": 748.48, "t": "Oh nee."}, {"s": 748.48, "e": 751.6, "t": "Oh nee."}, {"s": 753.48, "e": 756.53, "t": "Het het bakje is weg. Het bakje"}, {"s": 760.72, "e": 763.84, "t": "Oké. Wacht."}, {"s": 763.84, "e": 768.08, "t": "Oh, drama. Drama. Kijk."}, {"s": 771.68, "e": 773.72, "t": "De vaatwasser"}, {"s": 773.72, "e": 776.76, "t": "heeft het bakje."}, {"s": 776.76, "e": 780.04, "t": "Waar is het? Het is aan het stomen. Oeh,"}, {"s": 780.04, "e": 783.64, "t": "kijk allemaal stoom."}, {"s": 785.4, "e": 788.76, "t": "Oh jeetje."}, {"s": 790.56, "e": 793.24, "t": "Oké,"}, {"s": 793.24, "e": 796.16, "t": "nummer één."}, {"s": 796.16, "e": 799.16, "t": "En"}, {"s": 799.6, "e": 802.92, "t": "zo en dan dicht"}, {"s": 802.92, "e": 808.76, "t": "voor de stoom. Dat het kan stomen. Oe."}, {"s": 808.8, "e": 812.72, "t": "De [zucht] bak. Ik heb de bak."}, {"s": 812.72, "e": 814.8, "t": "Oh."}, {"s": 814.8, "e": 817.8, "t": "kijken"}, {"s": 817.96, "e": 822.12, "t": "waar moet het hier zo."}, {"s": 822.12, "e": 824.8, "t": "Jeet is niet echt schoon hè."}, {"s": 824.8, "e": 827.8, "t": "Zo,"}, {"s": 830.0, "e": 835.24, "t": "de zoete aardappel erin."}, {"s": 837.72, "e": 839.88, "t": "Als eerste"}, {"s": 839.88, "e": 842.4, "t": "dan"}, {"s": 842.4, "e": 844.88, "t": "de setan."}, {"s": 844.88, "e": 847.72, "t": "Dit ga ik in stukjes"}, {"s": 847.72, "e": 849.84, "t": "snijden."}, {"s": 849.84, "e": 852.84, "t": "Ehm"}, {"s": 852.84, "e": 855.84, "t": "zo"}, {"s": 863.8, "e": 869.48, "t": "met een vork en een mes."}, {"s": 871.12, "e": 873.83, "t": "Zo, [schraapt keel]"}, {"s": 880.16, "e": 883.64, "t": "dit is Seitan."}, {"s": 884.0, "e": 890.24, "t": "En dit ga ik snijden nu"}, {"s": 894.84, "e": 899.32, "t": "in plakjes. Kijk,"}, {"s": 900.36, "e": 904.16, "t": "dit is een plakje"}, {"s": 905.48, "e": 910.2, "t": "of in stukjes."}, {"s": 913.64, "e": 915.52, "t": "Hm."}, {"s": 915.52, "e": 919.72, "t": "Maar kijk, een stukje wat meer zo."}, {"s": 919.72, "e": 924.76, "t": "Maar ik doe dat meestal met mijn handen"}, {"s": 924.76, "e": 930.2, "t": "en daar heb ik nu geen zin in."}, {"s": 932.92, "e": 936.36, "t": "Even kijken of dit lukt."}, {"s": 936.36, "e": 940.0, "t": "Ja, wel een beetje."}, {"s": 940.76, "e": 945.68, "t": "Oh, de broccoli. Is die al klaar?"}, {"s": 950.24, "e": 954.4, "t": "Kijk, de broccoli biept."}, {"s": 955.8, "e": 960.88, "t": "Met de vork ga ik het proberen."}, {"s": 961.2, "e": 963.0, "t": "Nee,"}, {"s": 963.0, "e": 968.56, "t": "die is nog hard. Niet zacht."}, {"s": 968.56, "e": 973.68, "t": "Ik kan er niet in prikken."}, {"s": 973.68, "e": 976.68, "t": "Dus"}, {"s": 979.2, "e": 985.0, "t": "ik doe 3 minuten erbij."}, {"s": 985.0, "e": 989.2, "t": "Verder met de site dan."}, {"s": 992.56, "e": 998.4, "t": "Zo, dit gaat terug."}, {"s": 998.4, "e": 1002.64, "t": "in dit bakje."}, {"s": 1002.64, "e": 1007.4, "t": "En dit gaat in de air frryer."}, {"s": 1008.72, "e": 1014.04, "t": "Zo, deksel erop en dicht."}, {"s": 1014.04, "e": 1019.08, "t": "En ook voor de zoete aardappel."}, {"s": 1025.12, "e": 1028.56, "t": "naar de airfryer."}, {"s": 1028.56, "e": 1034.48, "t": "De stukjes gaan in de airfryer."}, {"s": 1040.24, "e": 1043.04, "t": "Zo,"}, {"s": 1043.04, "e": 1046.16, "t": "goed verdeeld."}, {"s": 1046.16, "e": 1049.68, "t": "Zodat het goed bakt."}, {"s": 1049.68, "e": 1054.2, "t": "Dan doe ik het dicht"}, {"s": 1054.64, "e": 1057.52, "t": "en aan."}, {"s": 1057.52, "e": 1060.0, "t": "Kun je het zien?"}, {"s": 1060.0, "e": 1063.24, "t": "Eerst de temperatuur"}, {"s": 1063.24, "e": 1067.52, "t": "op 200°"}, {"s": 1067.64, "e": 1071.68, "t": "en de tijd"}, {"s": 1072.04, "e": 1073.84, "t": "eerst"}, {"s": 1073.84, "e": 1078.04, "t": "6 minuten."}, {"s": 1078.2, "e": 1080.48, "t": "Hm. Zeven denk ik."}, {"s": 1080.48, "e": 1083.32, "t": "Z"}, {"s": 1083.32, "e": 1086.84, "t": "en dan aan"}, {"s": 1086.84, "e": 1089.24, "t": "en dan wachten."}, {"s": 1089.24, "e": 1092.32, "t": "Terwijl ik wacht"}, {"s": 1092.32, "e": 1095.4, "t": "ga ik opruimen."}, {"s": 1095.4, "e": 1097.36, "t": "Dus dean"}, {"s": 1097.36, "e": 1101.52, "t": "en de zoete aardappel."}, {"s": 1102.44, "e": 1105.36, "t": "Oh,"}, {"s": 1105.36, "e": 1110.68, "t": "opnieuw de broccoli checken."}, {"s": 1112.48, "e": 1116.48, "t": "Nu is het goed."}, {"s": 1117.0, "e": 1122.36, "t": "Kijk, ik kan erin prikken."}, {"s": 1132.0, "e": 1133.52, "t": "Zo,"}, {"s": 1133.52, "e": 1138.6, "t": "dus de broccoli is klaar."}, {"s": 1139.56, "e": 1143.72, "t": "Nu moet ik wachten op de zoete aardappel"}, {"s": 1143.72, "e": 1146.08, "t": "en de"}, {"s": 1146.08, "e": 1153.28, "t": "ondertussen ga ik opruimen. Dus de bakje"}, {"s": 1153.28, "e": 1157.56, "t": "terug in de koelkast doen."}, {"s": 1165.2, "e": 1169.72, "t": "En het bakje zoete aardappel ook in de"}, {"s": 1169.72, "e": 1172.72, "t": "koelkast."}, {"s": 1176.76, "e": 1185.52, "t": "En ook pak ik homoes uit de koelkast,"}, {"s": 1185.52, "e": 1191.2, "t": "want dat doe ik straks bij het eten."}, {"s": 1191.2, "e": 1193.04, "t": "Ho hem."}, {"s": 1193.04, "e": 1197.64, "t": "En nu moet ik wachten."}, {"s": 1197.64, "e": 1201.28, "t": "Ik pak alvast"}, {"s": 1201.72, "e": 1205.64, "t": "twee borden."}, {"s": 1206.4, "e": 1209.64, "t": "Één bord."}, {"s": 1210.68, "e": 1214.08, "t": "Tweede bord"}, {"s": 1215.52, "e": 1218.52, "t": "en een vork."}, {"s": 1218.52, "e": 1221.32, "t": "En een lepel."}, {"s": 1221.32, "e": 1224.96, "t": "Hier is de vork."}, {"s": 1227.8, "e": 1230.56, "t": "Hier is een lepel,"}, {"s": 1230.56, "e": 1235.92, "t": "want ik eet graag met een vork."}, {"s": 1235.92, "e": 1242.24, "t": "En mijn partner eet graag met een pekel."}, {"s": 1242.24, "e": 1248.0, "t": "Hm. Hoeveel minuten nog?"}, {"s": 1248.0, "e": 1250.76, "t": "Nog 4er"}, {"s": 1250.76, "e": 1252.64, "t": "minuten."}, {"s": 1252.64, "e": 1258.48, "t": "Ik ga even praten met mijn partner."}, {"s": 1258.48, "e": 1262.68, "t": "Ben zo terug. Oké,"}, {"s": 1262.92, "e": 1268.32, "t": "dan pak ik alvast de hemouses."}, {"s": 1270.48, "e": 1274.04, "t": "Dit is hem."}, {"s": 1275.4, "e": 1279.88, "t": "Het is het allerlekkerste"}, {"s": 1279.88, "e": 1283.56, "t": "om het zelf te maken,"}, {"s": 1283.56, "e": 1285.24, "t": "maar"}, {"s": 1285.24, "e": 1289.56, "t": "soms doe ik dat niet. Of heel vaak."}, {"s": 1289.56, "e": 1293.96, "t": "omdat het tijd kost."}, {"s": 1293.96, "e": 1298.32, "t": "Maar voor lunch wil ik wel graag hemes."}, {"s": 1298.32, "e": 1303.0, "t": "Oké, ik pak een lepel"}, {"s": 1303.04, "e": 1306.04, "t": "homoes"}, {"s": 1307.04, "e": 1311.44, "t": "en nog een lepel hemes"}, {"s": 1312.76, "e": 1316.32, "t": "voor dit bord. Voor mijn bord en mijn"}, {"s": 1316.32, "e": 1318.68, "t": "partnersbord."}, {"s": 1318.68, "e": 1323.48, "t": "Ik denk een beetje meer."}, {"s": 1332.52, "e": 1335.68, "t": "Want we vinden het allebei"}, {"s": 1335.68, "e": 1338.08, "t": "heel lekker,"}, {"s": 1338.08, "e": 1342.96, "t": "maar er zit heel veel olie"}, {"s": 1342.96, "e": 1345.36, "t": "olie"}, {"s": 1345.36, "e": 1347.4, "t": "in"}, {"s": 1347.4, "e": 1351.32, "t": "als je het koopt in de supermarkt."}, {"s": 1351.32, "e": 1354.72, "t": "Als je het zelf maakt"}, {"s": 1354.72, "e": 1358.68, "t": "maakt de hemoes, dan kun je minder"}, {"s": 1358.68, "e": 1362.8, "t": "minder olie"}, {"s": 1363.04, "e": 1367.68, "t": "olie erin doen."}, {"s": 1367.68, "e": 1372.36, "t": "Maar omdat olie goedkoop is, qua prijs"}, {"s": 1372.36, "e": 1376.96, "t": "niet heel duur. Sommige oliën zijn niet"}, {"s": 1376.96, "e": 1378.88, "t": "heel duur."}, {"s": 1378.88, "e": 1381.8, "t": "Eh doen ze dat erin."}, {"s": 1381.8, "e": 1384.4, "t": "Dus ja."}, {"s": 1384.4, "e": 1386.88, "t": "En de hoemoes doe ik terug in de"}, {"s": 1386.88, "e": 1389.88, "t": "koelkast."}, {"s": 1393.2, "e": 1399.56, "t": "Oh, het is bijna bijna klaar, hoop ik."}, {"s": 1399.56, "e": 1402.88, "t": "Ik ga kijken."}, {"s": 1403.72, "e": 1407.32, "t": "Oeh. Oeh, kijk."}, {"s": 1407.32, "e": 1411.6, "t": "Het is een beetje bruiner"}, {"s": 1412.28, "e": 1415.36, "t": "en krokanter."}, {"s": 1415.36, "e": 1418.76, "t": "Kun je dat horen?"}, {"s": 1421.48, "e": 1424.48, "t": "Ja,"}, {"s": 1427.2, "e": 1430.52, "t": "het kan nog langer,"}, {"s": 1430.52, "e": 1435.88, "t": "maar ik heb honger. Ik wil eten. Ik wil"}, {"s": 1435.88, "e": 1438.84, "t": "eten."}, {"s": 1438.84, "e": 1442.28, "t": "Ik pak het"}, {"s": 1442.96, "e": 1447.52, "t": "en dan doe ik het op de borden."}, {"s": 1447.52, "e": 1451.76, "t": "Dus de zoete aardappel,"}, {"s": 1451.92, "e": 1455.12, "t": "de andere helft"}, {"s": 1455.12, "e": 1460.4, "t": "en een stukje zoete aardappel hier. En"}, {"s": 1460.4, "e": 1465.36, "t": "een ander stukje zoete aardappel hier."}, {"s": 1465.36, "e": 1469.64, "t": "En dan de"}, {"s": 1470.24, "e": 1472.6, "t": "plakjes"}, {"s": 1472.6, "e": 1475.28, "t": "voor mijn partner."}, {"s": 1475.28, "e": 1479.8, "t": "Nog een plakje. Twee plakjes."}, {"s": 1480.84, "e": 1484.36, "t": "Drie plakjes."}, {"s": 1486.4, "e": 1490.0, "t": "Vier plakjes."}, {"s": 1491.44, "e": 1495.0, "t": "Vijf plakjes."}, {"s": 1495.48, "e": 1499.2, "t": "Hm. Ja. Hier"}, {"s": 1499.2, "e": 1502.28, "t": "zes plakjes."}, {"s": 1502.28, "e": 1507.92, "t": "En voor mij Oeh, die ziet er lekker uit."}, {"s": 1507.92, "e": 1510.88, "t": "Allemaal stukjes. Kijk. Allemaal"}, {"s": 1510.88, "e": 1513.88, "t": "stukjes."}, {"s": 1514.12, "e": 1518.8, "t": "En dan oh en dan"}, {"s": 1518.8, "e": 1523.24, "t": "en dan de broccoli."}, {"s": 1525.36, "e": 1528.68, "t": "De broccoli."}, {"s": 1529.12, "e": 1532.32, "t": "De ene helft"}, {"s": 1532.32, "e": 1536.16, "t": "op dit bord"}, {"s": 1536.68, "e": 1541.84, "t": "en de andere helft op dit bord."}, {"s": 1545.16, "e": 1547.08, "t": "Hm."}, {"s": 1547.08, "e": 1552.36, "t": "Een beetje weinig eigenlijk."}, {"s": 1553.48, "e": 1557.8, "t": "Weinig broccoli. Heel veel seit."}, {"s": 1557.8, "e": 1560.08, "t": "Heel veel."}, {"s": 1560.08, "e": 1563.24, "t": "Een beetje broccoli. Een beetje broccoli"}, {"s": 1563.24, "e": 1566.8, "t": "en een beetje zoete aardappel. Ik denk"}, {"s": 1566.8, "e": 1571.36, "t": "dat ik te weinig heb gemaakt. Niet"}, {"s": 1571.36, "e": 1575.44, "t": "genoeg. Niet precies de hoeveelheid"}, {"s": 1575.44, "e": 1578.48, "t": "die goed is."}, {"s": 1578.48, "e": 1583.0, "t": "Maar we gaan nu gewoon eten"}, {"s": 1583.0, "e": 1586.6, "t": "en dan misschien eet ik nog wat extra's"}, {"s": 1586.6, "e": 1593.32, "t": "erbij. zoals een appel of een koekje."}, {"s": 1593.32, "e": 1596.92, "t": "Het komt goed. Komt goed."}, {"s": 1596.92, "e": 1603.2, "t": "En ik pak ook wat zout"}, {"s": 1603.2, "e": 1609.96, "t": "en peper. Kijk, zout en peper."}, {"s": 1609.96, "e": 1613.8, "t": "En dat doe ik eroverheen."}, {"s": 1619.6, "e": 1623.68, "t": "Hm. Voor mijn partner niet."}, {"s": 1623.68, "e": 1626.56, "t": "En een beetje peper"}, {"s": 1626.56, "e": 1630.08, "t": "op de broccoli."}, {"s": 1634.32, "e": 1637.76, "t": "En voor mijn partner gebruik ik"}, {"s": 1637.76, "e": 1640.76, "t": "sojasaus."}, {"s": 1646.52, "e": 1649.52, "t": "Zo."}, {"s": 1649.64, "e": 1651.28, "t": "Oké,"}, {"s": 1651.28, "e": 1654.0, "t": "dat is de lunch."}, {"s": 1654.0, "e": 1657.64, "t": "Tada. En nu ga ik eten, want ik heb heel"}, {"s": 1657.64, "e": 1660.2, "t": "erg honger. [schraapt keel]"}, {"s": 1660.2, "e": 1664.56, "t": "Wat eet jij voor lunch? Zeg je het in de"}, {"s": 1664.56, "e": 1666.24, "t": "opmerkingen?"}, {"s": 1666.24, "e": 1669.36, "t": "Ik hoor het heel graag."}, {"s": 1669.36, "e": 1671.56, "t": "Doei."}]