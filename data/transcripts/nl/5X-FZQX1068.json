[{"s": 1.1, "e": 4.84, "t": "De ochtend voor het werk"}, {"s": 5.34, "e": 9.38, "t": "Goedemorgen, Joris."}, {"s": 9.43, "e": 13.02, "t": "Goedemorgen, Lotte."}, {"s": 13.07, "e": 16.6, "t": "Ben je al wakker?"}, {"s": 16.65, "e": 21.26, "t": "Ja, maar nog moe."}, {"s": 21.31, "e": 26.34, "t": "De wekker was luid."}, {"s": 26.39, "e": 30.97, "t": "Ik heb hem bijna niet gehoord."}, {"s": 31.02, "e": 35.85, "t": "Je hebt nu koffie nodig."}, {"s": 35.9, "e": 40.74, "t": "Ja, graag heel sterk."}, {"s": 40.79, "e": 44.33, "t": "Ik zet ook thee."}, {"s": 44.38, "e": 49.14, "t": "Voor jezelf, zoals altijd?"}, {"s": 49.19, "e": 54.17, "t": "Ja, met weinig suiker."}, {"s": 54.22, "e": 58.63, "t": "Wat eten we vandaag?"}, {"s": 58.68, "e": 64.22, "t": "Brood, kaas en tomaten."}, {"s": 64.27, "e": 68.55, "t": "Dat klinkt heel goed."}, {"s": 68.6, "e": 72.91, "t": "Neem ook een appel mee."}, {"s": 72.96, "e": 76.88, "t": "Voor mijn pauze op het werk?"}, {"s": 76.93, "e": 80.86, "t": "Ja, je eet laat."}, {"s": 80.91, "e": 85.74, "t": "Vandaag heb ik vergaderingen."}, {"s": 85.79, "e": 89.98, "t": "Eet nu dan genoeg."}, {"s": 90.03, "e": 95.15, "t": "Heb je mijn overhemd gezien?"}, {"s": 95.2, "e": 100.07, "t": "Het hangt in de slaapkamer."}, {"s": 100.12, "e": 103.89, "t": "Dank je, ik pak het."}, {"s": 103.94, "e": 107.64, "t": "Vergeet je tas niet."}, {"s": 107.69, "e": 112.06, "t": "Die staat naast de deur."}, {"s": 112.11, "e": 115.62, "t": "En je sleutel?"}, {"s": 115.67, "e": 119.53, "t": "O, die heb ik nog niet."}, {"s": 119.58, "e": 123.74, "t": "Hij ligt bij de spiegel."}, {"s": 123.79, "e": 128.43, "t": "Goed, nu heb ik alles."}, {"s": 128.48, "e": 132.71, "t": "Wanneer vertrek je?"}, {"s": 132.76, "e": 136.4, "t": "Over tien minuten."}, {"s": 136.45, "e": 141.04, "t": "De bus komt vroeg."}, {"s": 141.09, "e": 145.49, "t": "Ik loop vandaag wat sneller."}, {"s": 145.54, "e": 149.29, "t": "Neem je jas mee."}, {"s": 149.34, "e": 153.61, "t": "Is het buiten koud?"}, {"s": 153.66, "e": 158.79, "t": "Ja, het is fris vanochtend."}, {"s": 158.84, "e": 162.71, "t": "Goed, ik neem hem mee."}, {"s": 162.76, "e": 166.56, "t": "Je koffie is klaar."}, {"s": 166.61, "e": 170.92, "t": "Dank je, hij ruikt lekker."}, {"s": 170.97, "e": 174.74, "t": "Ga nog even zitten."}, {"s": 174.79, "e": 179.52, "t": "Graag, twee minuutjes."}, {"s": 179.57, "e": 185.37, "t": "Zo begint de dag rustig."}, {"s": 185.42, "e": 189.96, "t": "Ja, zo is het beter."}, {"s": 190.01, "e": 196.09, "t": "Succes op kantoor."}, {"s": 196.14, "e": 201.96, "t": "Dank je, tot vanavond."}, {"s": 206.14, "e": 210.59, "t": "Een afspraak bij de dokter maken"}, {"s": 211.09, "e": 216.38, "t": "Praktijk Van Dijk, goedemorgen."}, {"s": 216.43, "e": 222.04, "t": "Goedemorgen, met Sofie Bakker."}, {"s": 222.09, "e": 225.89, "t": "Hoe kan ik u helpen?"}, {"s": 225.94, "e": 231.09, "t": "Ik wil een afspraak maken."}, {"s": 231.14, "e": 235.44, "t": "Wat zijn uw klachten?"}, {"s": 235.49, "e": 240.28, "t": "Ik moet veel hoesten."}, {"s": 240.33, "e": 244.82, "t": "Sinds wanneer hoest u?"}, {"s": 244.87, "e": 249.48, "t": "Sinds maandagavond."}, {"s": 249.53, "e": 253.32, "t": "Heeft u ook koorts?"}, {"s": 253.37, "e": 256.62, "t": "Een beetje."}, {"s": 256.67, "e": 260.9, "t": "Heeft u keelpijn?"}, {"s": 260.95, "e": 264.83, "t": "Ja, bij het slikken."}, {"s": 264.88, "e": 269.06, "t": "Kunt u vandaag komen?"}, {"s": 269.11, "e": 273.91, "t": "Ja, maar pas vanmiddag."}, {"s": 273.96, "e": 278.69, "t": "Om drie uur is er plaats."}, {"s": 278.74, "e": 282.52, "t": "Dat komt goed uit."}, {"s": 282.57, "e": 287.0, "t": "Neem uw pas mee."}, {"s": 287.05, "e": 290.89, "t": "Mijn zorgpas?"}, {"s": 290.94, "e": 295.12, "t": "Die neem ik mee."}, {"s": 295.17, "e": 299.66, "t": "Kom tien minuten eerder."}, {"s": 299.71, "e": 302.93, "t": "Dat doe ik."}, {"s": 302.98, "e": 308.76, "t": "Draag alstublieft een mondkapje."}, {"s": 308.81, "e": 313.4, "t": "Natuurlijk, geen probleem."}, {"s": 313.45, "e": 318.91, "t": "Onze praktijk is vandaag open."}, {"s": 318.96, "e": 322.52, "t": "Tot hoe laat?"}, {"s": 322.57, "e": 326.44, "t": "Tot zes uur."}, {"s": 326.49, "e": 330.33, "t": "Goed om te weten."}, {"s": 330.38, "e": 334.37, "t": "Bent u benauwd?"}, {"s": 334.42, "e": 339.21, "t": "Nee, ik hoest alleen."}, {"s": 339.26, "e": 344.34, "t": "Dan kunt u om drie uur komen."}, {"s": 344.39, "e": 348.87, "t": "Mag ik daarvoor eten?"}, {"s": 348.92, "e": 353.89, "t": "Ja, eet iets lichts."}, {"s": 353.94, "e": 359.02, "t": "Mag ik thee drinken?"}, {"s": 359.07, "e": 363.88, "t": "Ja, drink voldoende."}, {"s": 363.93, "e": 368.15, "t": "Bedankt voor het advies."}, {"s": 368.2, "e": 373.12, "t": "Graag gedaan, mevrouw Bakker."}, {"s": 373.17, "e": 378.34, "t": "Dus vandaag om drie uur."}, {"s": 378.39, "e": 382.53, "t": "Ja, dat klopt."}, {"s": 382.58, "e": 386.98, "t": "Dan kom ik op tijd."}, {"s": 387.03, "e": 393.97, "t": "Tot straks en beterschap."}, {"s": 394.02, "e": 400.77, "t": "Hartelijk dank, tot straks."}, {"s": 404.97, "e": 410.15, "t": "Boodschappen doen in de supermarkt"}, {"s": 410.65, "e": 415.63, "t": "Pardon, meneer De Bruin."}, {"s": 415.68, "e": 420.15, "t": "Ja, hoe kan ik u helpen?"}, {"s": 420.2, "e": 424.54, "t": "Ik zoek verse melk."}, {"s": 424.59, "e": 429.92, "t": "De melk staat achteraan links."}, {"s": 429.97, "e": 433.82, "t": "Naast de yoghurt?"}, {"s": 433.87, "e": 437.74, "t": "Ja, precies daar."}, {"s": 437.79, "e": 443.31, "t": "Dank u, ik heb twee pakken nodig."}, {"s": 443.36, "e": 447.92, "t": "Wilt u biologische melk?"}, {"s": 447.97, "e": 452.15, "t": "Hoeveel kost die?"}, {"s": 452.2, "e": 456.41, "t": "Eén euro vijftig."}, {"s": 456.46, "e": 461.21, "t": "Dan neem ik één pak."}, {"s": 461.26, "e": 465.68, "t": "Heeft u ook brood nodig?"}, {"s": 465.73, "e": 470.06, "t": "Ja, een bruin brood."}, {"s": 470.11, "e": 474.91, "t": "Het brood ligt vooraan."}, {"s": 474.96, "e": 478.87, "t": "Is het vandaag vers?"}, {"s": 478.92, "e": 483.93, "t": "Ja, het kwam vanochtend binnen."}, {"s": 483.98, "e": 487.16, "t": "Heel goed."}, {"s": 487.21, "e": 492.01, "t": "Wat staat er nog op uw lijstje?"}, {"s": 492.06, "e": 499.11, "t": "Tomaten, rijst en eieren."}, {"s": 499.16, "e": 504.04, "t": "Tomaten zijn in de aanbieding."}, {"s": 504.09, "e": 508.04, "t": "O, wat fijn."}, {"s": 508.09, "e": 512.72, "t": "Twee euro per kilo."}, {"s": 512.77, "e": 517.67, "t": "Dan neem ik één kilo."}, {"s": 517.72, "e": 522.43, "t": "Rijst staat in het vijfde schap."}, {"s": 522.48, "e": 527.37, "t": "Dank u, dat kan ik vinden."}, {"s": 527.42, "e": 532.28, "t": "Eieren staan bij de koeling."}, {"s": 532.33, "e": 536.71, "t": "Tien eieren zijn genoeg."}, {"s": 536.76, "e": 540.4, "t": "Wilt u een tas?"}, {"s": 540.45, "e": 545.02, "t": "Ik heb mijn eigen tas."}, {"s": 545.07, "e": 549.0, "t": "Dat is heel goed."}, {"s": 549.05, "e": 553.41, "t": "Waar is de kassa?"}, {"s": 553.46, "e": 558.11, "t": "Direct achter het fruit."}, {"s": 558.16, "e": 561.5, "t": "Kan ik pinnen?"}, {"s": 561.55, "e": 566.24, "t": "Ja, vanaf één euro."}, {"s": 566.29, "e": 570.35, "t": "Prima, dank u."}, {"s": 570.4, "e": 573.81, "t": "Geen probleem."}, {"s": 573.86, "e": 577.96, "t": "Nu heb ik alles."}, {"s": 578.01, "e": 582.81, "t": "Veel plezier met uw boodschappen."}, {"s": 582.86, "e": 588.75, "t": "Dank u, fijne dag."}, {"s": 588.8, "e": 594.57, "t": "U ook, tot ziens."}, {"s": 598.76, "e": 602.26, "t": "Bij de tandarts"}, {"s": 602.76, "e": 607.17, "t": "Goedemorgen, meneer De Wit."}, {"s": 607.22, "e": 611.29, "t": "Goedemorgen, dokter."}, {"s": 611.34, "e": 614.84, "t": "Gaat u maar zitten."}, {"s": 614.89, "e": 619.9, "t": "Dank u, ik ben zenuwachtig."}, {"s": 619.95, "e": 624.05, "t": "Dat begrijp ik goed."}, {"s": 624.1, "e": 628.09, "t": "Mijn kies doet pijn."}, {"s": 628.14, "e": 632.64, "t": "Sinds wanneer precies?"}, {"s": 632.69, "e": 636.61, "t": "Sinds gisteravond."}, {"s": 636.66, "e": 641.04, "t": "Boven of onder?"}, {"s": 641.09, "e": 644.64, "t": "Rechtsonder."}, {"s": 644.69, "e": 648.15, "t": "Kunt u kauwen?"}, {"s": 648.2, "e": 652.27, "t": "Alleen heel langzaam."}, {"s": 652.32, "e": 656.94, "t": "Doet drinken ook pijn?"}, {"s": 656.99, "e": 662.07, "t": "Ja, vooral koude drankjes."}, {"s": 662.12, "e": 665.68, "t": "Ik kijk even."}, {"s": 665.73, "e": 670.53, "t": "Goed, ik doe mijn mond open."}, {"s": 670.58, "e": 675.54, "t": "Blijf rustig, alstublieft."}, {"s": 675.59, "e": 679.35, "t": "Ja, ik probeer het."}, {"s": 679.4, "e": 684.11, "t": "De kies is gevoelig."}, {"s": 684.16, "e": 687.97, "t": "Is het ernstig?"}, {"s": 688.02, "e": 691.88, "t": "Nee, nog niet."}, {"s": 691.93, "e": 695.67, "t": "Wat doen we nu?"}, {"s": 695.72, "e": 700.74, "t": "Ik maak deze plek schoon."}, {"s": 700.79, "e": 704.88, "t": "Doet dat veel pijn?"}, {"s": 704.93, "e": 708.65, "t": "Een beetje maar."}, {"s": 708.7, "e": 713.19, "t": "Goed, laten we dat doen."}, {"s": 713.24, "e": 718.23, "t": "Daarna krijgt u een gel."}, {"s": 718.28, "e": 721.58, "t": "Voor thuis?"}, {"s": 721.63, "e": 726.35, "t": "Ja, twee keer per dag."}, {"s": 726.4, "e": 730.75, "t": "Moet ik terugkomen?"}, {"s": 730.8, "e": 734.71, "t": "Ja, volgende week."}, {"s": 734.76, "e": 738.32, "t": "Kan het maandag?"}, {"s": 738.37, "e": 744.05, "t": "Maandag om negen uur kan."}, {"s": 744.1, "e": 747.86, "t": "Dat komt goed uit."}, {"s": 747.91, "e": 752.82, "t": "Eet vandaag zacht voedsel."}, {"s": 752.87, "e": 757.75, "t": "Kan ik beter geen koffie drinken?"}, {"s": 757.8, "e": 762.98, "t": "Ja, vandaag liever niet."}, {"s": 763.03, "e": 767.83, "t": "En heel koud water?"}, {"s": 767.88, "e": 772.81, "t": "Vandaag ook liever niet."}, {"s": 772.86, "e": 777.85, "t": "Kan ik bijvoorbeeld soep eten?"}, {"s": 777.9, "e": 782.62, "t": "Ja, soep is goed."}, {"s": 782.67, "e": 788.62, "t": "Hartelijk dank voor alles."}, {"s": 788.66, "e": 795.58, "t": "Graag gedaan en beterschap."}, {"s": 799.78, "e": 804.77, "t": "Met de bus en trein naar het werk"}, {"s": 805.27, "e": 809.25, "t": "Goedemorgen, Eline."}, {"s": 809.3, "e": 813.15, "t": "Goedemorgen, Niek."}, {"s": 813.2, "e": 817.96, "t": "De bus is te laat."}, {"s": 818.01, "e": 822.18, "t": "Ja, al vijf minuten."}, {"s": 822.23, "e": 826.16, "t": "Ik moet naar mijn werk."}, {"s": 826.21, "e": 830.22, "t": "Ik ook, helaas."}, {"s": 830.27, "e": 834.56, "t": "Welke lijn neem jij?"}, {"s": 834.61, "e": 838.35, "t": "Eerst bus vier."}, {"s": 838.4, "e": 841.74, "t": "En daarna?"}, {"s": 841.79, "e": 845.84, "t": "Daarna de trein."}, {"s": 845.89, "e": 849.7, "t": "Ik neem de metro."}, {"s": 849.75, "e": 853.54, "t": "Heb je een kaartje?"}, {"s": 853.59, "e": 858.49, "t": "Ja, ik heb een ov-abonnement."}, {"s": 858.54, "e": 862.88, "t": "Goed, dan is het makkelijk."}, {"s": 862.93, "e": 867.74, "t": "De app geeft vertraging aan."}, {"s": 867.79, "e": 871.42, "t": "Hoelang nog?"}, {"s": 871.47, "e": 875.36, "t": "Nog acht minuten."}, {"s": 875.41, "e": 879.03, "t": "Dan redden we het."}, {"s": 879.08, "e": 882.12, "t": "Hopelijk."}, {"s": 882.17, "e": 886.99, "t": "Wanneer begint je dienst?"}, {"s": 887.04, "e": 890.8, "t": "Om half negen."}, {"s": 890.85, "e": 895.84, "t": "Het is nu tien voor acht."}, {"s": 895.89, "e": 900.48, "t": "We hebben weinig tijd."}, {"s": 900.53, "e": 905.09, "t": "Stuur je baas even een bericht."}, {"s": 905.14, "e": 908.2, "t": "Goed idee."}, {"s": 908.25, "e": 913.67, "t": "Zeg dat de bus vertraagd is."}, {"s": 913.72, "e": 918.5, "t": "Ik stuur nu een bericht."}, {"s": 918.55, "e": 922.35, "t": "Daar komt de bus."}, {"s": 922.4, "e": 926.52, "t": "De bus is vol."}, {"s": 926.57, "e": 933.32, "t": "We kunnen beter vooraan staan."}, {"s": 933.37, "e": 936.93, "t": "Daar gaat het sneller."}, {"s": 936.98, "e": 941.71, "t": "Ik houd de stang vast."}, {"s": 941.76, "e": 946.25, "t": "Straks wordt het rustiger."}, {"s": 946.3, "e": 950.0, "t": "Dan kun je zitten."}, {"s": 950.05, "e": 954.35, "t": "Eindelijk, dat is fijn."}, {"s": 954.4, "e": 958.89, "t": "Laten we vooraan instappen."}, {"s": 958.94, "e": 963.29, "t": "Ja, daar is plaats."}, {"s": 963.34, "e": 968.0, "t": "Na drie haltes uitstappen?"}, {"s": 968.05, "e": 972.86, "t": "Ja, dan naar de metro."}, {"s": 972.91, "e": 977.48, "t": "De metro rijdt vaak."}, {"s": 977.53, "e": 981.68, "t": "Elke vijf minuten."}, {"s": 981.73, "e": 985.68, "t": "Dan kom je op tijd."}, {"s": 985.73, "e": 990.99, "t": "Misschien, als alles goed gaat."}, {"s": 991.04, "e": 994.85, "t": "Ik hoop dat het lukt."}, {"s": 994.9, "e": 999.09, "t": "Dank je, aardig van je."}, {"s": 999.14, "e": 1004.65, "t": "Nu vertrekken we."}, {"s": 1004.7, "e": 1011.73, "t": "Goed, nu kunnen we rustig reizen."}, {"s": 1015.91, "e": 1019.41, "t": "Bij de huisarts"}, {"s": 1019.91, "e": 1024.16, "t": "Goedendag, meneer Bos."}, {"s": 1024.21, "e": 1027.9, "t": "Goedendag, dokter."}, {"s": 1027.95, "e": 1031.73, "t": "Waarvoor komt u?"}, {"s": 1031.78, "e": 1035.2, "t": "Ik voel me slap."}, {"s": 1035.25, "e": 1039.44, "t": "Sinds wanneer precies?"}, {"s": 1039.49, "e": 1043.55, "t": "Sinds drie dagen."}, {"s": 1043.6, "e": 1047.2, "t": "Heeft u koorts?"}, {"s": 1047.25, "e": 1051.39, "t": "Nee, ik ben alleen moe."}, {"s": 1051.44, "e": 1055.29, "t": "Heeft u hoofdpijn?"}, {"s": 1055.34, "e": 1059.59, "t": "Ja, in de middag."}, {"s": 1059.64, "e": 1063.45, "t": "Slaapt u goed?"}, {"s": 1063.5, "e": 1067.64, "t": "Nee, niet zo goed."}, {"s": 1067.69, "e": 1071.23, "t": "Werkt u veel?"}, {"s": 1071.28, "e": 1075.81, "t": "Ja, vooral deze week."}, {"s": 1075.86, "e": 1079.66, "t": "Eet u regelmatig?"}, {"s": 1079.71, "e": 1084.49, "t": "Soms vergeet ik te eten."}, {"s": 1084.54, "e": 1088.74, "t": "Drinkt u genoeg water?"}, {"s": 1088.79, "e": 1093.52, "t": "Helaas vaak te weinig."}, {"s": 1093.57, "e": 1097.61, "t": "Dat is niet goed."}, {"s": 1097.66, "e": 1102.16, "t": "Dat weet ik, helaas."}, {"s": 1102.21, "e": 1106.54, "t": "Ik meet uw bloeddruk."}, {"s": 1106.59, "e": 1111.66, "t": "Goed, ik zit rustig."}, {"s": 1111.71, "e": 1116.8, "t": "Uw bloeddruk is normaal."}, {"s": 1116.85, "e": 1120.63, "t": "Dat stelt me gerust."}, {"s": 1120.68, "e": 1125.41, "t": "Ik luister naar uw longen."}, {"s": 1125.46, "e": 1130.12, "t": "Moet ik diep ademhalen?"}, {"s": 1130.17, "e": 1135.14, "t": "Ja, adem diep in."}, {"s": 1135.19, "e": 1138.08, "t": "Zo?"}, {"s": 1138.13, "e": 1142.34, "t": "Ja, alles klinkt goed."}, {"s": 1142.39, "e": 1146.4, "t": "Wat heb ik nodig?"}, {"s": 1146.45, "e": 1151.17, "t": "Meer slaap en pauzes."}, {"s": 1151.22, "e": 1154.81, "t": "En medicijnen?"}, {"s": 1154.86, "e": 1159.0, "t": "Die zijn nu niet nodig."}, {"s": 1159.05, "e": 1163.65, "t": "Wat kan ik het beste eten?"}, {"s": 1163.7, "e": 1169.19, "t": "Eet regelmatig iets warms en lichts."}, {"s": 1169.24, "e": 1174.4, "t": "Ik maak vandaag soep."}, {"s": 1174.45, "e": 1178.63, "t": "Een heel goed idee."}, {"s": 1178.68, "e": 1182.79, "t": "Mag ik werken?"}, {"s": 1182.84, "e": 1187.71, "t": "Ja, maar doe het rustiger aan."}, {"s": 1187.76, "e": 1192.38, "t": "Ik neem morgen rust."}, {"s": 1192.43, "e": 1196.16, "t": "Dat helpt zeker."}, {"s": 1196.21, "e": 1202.64, "t": "Bedankt voor uw hulp."}, {"s": 1202.69, "e": 1209.59, "t": "Graag gedaan en beterschap."}, {"s": 1213.78, "e": 1217.88, "t": "Thuis koken en avondeten"}, {"s": 1218.38, "e": 1222.74, "t": "Bram, heb je honger?"}, {"s": 1222.79, "e": 1227.19, "t": "Ja, heel veel."}, {"s": 1227.24, "e": 1231.9, "t": "Dan gaan we nu koken."}, {"s": 1231.95, "e": 1235.9, "t": "Wat maken we vandaag?"}, {"s": 1235.95, "e": 1240.73, "t": "Pasta met groentesaus."}, {"s": 1240.78, "e": 1244.56, "t": "Dat klinkt makkelijk."}, {"s": 1244.61, "e": 1250.03, "t": "Ja, en het is snel klaar."}, {"s": 1250.08, "e": 1254.14, "t": "Wat moet ik snijden?"}, {"s": 1254.19, "e": 1258.97, "t": "De paprika's, alsjeblieft."}, {"s": 1259.02, "e": 1264.35, "t": "De rode of de gele?"}, {"s": 1264.4, "e": 1268.89, "t": "Allebei, alsjeblieft."}, {"s": 1268.94, "e": 1272.72, "t": "Ik was ze eerst."}, {"s": 1272.77, "e": 1277.46, "t": "Goed, dan zijn ze schoon."}, {"s": 1277.51, "e": 1281.91, "t": "Waar is het mes?"}, {"s": 1281.96, "e": 1286.83, "t": "In de la links."}, {"s": 1286.88, "e": 1290.0, "t": "Ik heb het."}, {"s": 1290.05, "e": 1295.84, "t": "Snijd ze in kleine stukjes."}, {"s": 1295.89, "e": 1299.71, "t": "Is het zo goed?"}, {"s": 1299.76, "e": 1303.93, "t": "Ja, perfect."}, {"s": 1303.98, "e": 1307.57, "t": "Wat doe jij?"}, {"s": 1307.62, "e": 1312.06, "t": "Ik kook de pasta."}, {"s": 1312.11, "e": 1316.08, "t": "Hoelang moet die koken?"}, {"s": 1316.13, "e": 1320.93, "t": "Ongeveer tien minuten."}, {"s": 1320.98, "e": 1325.69, "t": "Zal ik de tomaten openmaken?"}, {"s": 1325.74, "e": 1330.29, "t": "Ja, één blik."}, {"s": 1330.34, "e": 1334.5, "t": "Ik kan het niet vinden."}, {"s": 1334.55, "e": 1339.46, "t": "Het staat rechtsboven."}, {"s": 1339.51, "e": 1343.99, "t": "O, nu zie ik het."}, {"s": 1344.04, "e": 1348.58, "t": "Doe er ook zout bij."}, {"s": 1348.63, "e": 1352.25, "t": "Niet te veel, toch?"}, {"s": 1352.3, "e": 1356.85, "t": "Nee, maar een beetje."}, {"s": 1356.9, "e": 1360.84, "t": "Zal ik kaas raspen?"}, {"s": 1360.89, "e": 1365.67, "t": "Ja, maar een beetje."}, {"s": 1365.72, "e": 1369.55, "t": "Waar is de rasp?"}, {"s": 1369.6, "e": 1374.31, "t": "Naast de grote pan."}, {"s": 1374.36, "e": 1378.32, "t": "Ik heb hem gevonden."}, {"s": 1378.37, "e": 1383.58, "t": "Zet hem hier neer, alsjeblieft."}, {"s": 1383.63, "e": 1387.61, "t": "Dat doe ik meteen."}, {"s": 1387.66, "e": 1392.01, "t": "De saus ruikt lekker."}, {"s": 1392.06, "e": 1397.33, "t": "Dank je, hij is bijna klaar."}, {"s": 1397.38, "e": 1401.33, "t": "Zullen we de tafel dekken?"}, {"s": 1401.38, "e": 1405.61, "t": "Ja, twee borden."}, {"s": 1405.66, "e": 1410.0, "t": "En twee glazen water."}, {"s": 1410.05, "e": 1413.51, "t": "Heel goed."}, {"s": 1413.56, "e": 1417.73, "t": "Het eten is klaar."}, {"s": 1417.78, "e": 1421.89, "t": "Dan gaan we zitten."}, {"s": 1421.94, "e": 1427.67, "t": "Eet smakelijk, Clara."}, {"s": 1427.72, "e": 1433.74, "t": "Eet smakelijk, Bram."}, {"s": 1437.94, "e": 1441.24, "t": "Bij de oogarts"}, {"s": 1441.74, "e": 1446.18, "t": "Goedendag, mevrouw Jansen."}, {"s": 1446.23, "e": 1450.38, "t": "Goedendag, dokter."}, {"s": 1450.43, "e": 1454.67, "t": "Welke klachten heeft u?"}, {"s": 1454.72, "e": 1459.55, "t": "Mijn ogen branden vaak."}, {"s": 1459.6, "e": 1463.74, "t": "Sinds wanneer heeft u dat?"}, {"s": 1463.79, "e": 1467.62, "t": "Sinds twee weken."}, {"s": 1467.67, "e": 1472.69, "t": "Werkt u achter een computer?"}, {"s": 1472.74, "e": 1476.56, "t": "Ja, elke dag lang."}, {"s": 1476.61, "e": 1480.12, "t": "Hoeveel uur?"}, {"s": 1480.17, "e": 1484.4, "t": "Ongeveer acht uur."}, {"s": 1484.45, "e": 1488.39, "t": "Dat is heel veel."}, {"s": 1488.44, "e": 1492.99, "t": "Ja, dat hoort bij mijn werk."}, {"s": 1493.04, "e": 1497.2, "t": "Ziet u ook wazig?"}, {"s": 1497.25, "e": 1501.28, "t": "Soms in de avond."}, {"s": 1501.33, "e": 1505.44, "t": "Draagt u een bril?"}, {"s": 1505.49, "e": 1509.54, "t": "Nee, nog niet."}, {"s": 1509.59, "e": 1514.88, "t": "We controleren uw ogen."}, {"s": 1514.93, "e": 1519.38, "t": "Goed, wat moet ik doen?"}, {"s": 1519.43, "e": 1525.47, "t": "Lees de letters, alstublieft."}, {"s": 1525.52, "e": 1531.32, "t": "De bovenste kan ik goed lezen."}, {"s": 1531.37, "e": 1536.34, "t": "En de rij met kleine letters?"}, {"s": 1536.39, "e": 1540.49, "t": "Die is moeilijk."}, {"s": 1540.54, "e": 1545.57, "t": "Uw rechteroog heeft hulp nodig."}, {"s": 1545.62, "e": 1550.32, "t": "Heb ik een bril nodig?"}, {"s": 1550.37, "e": 1555.4, "t": "Misschien alleen bij de computer."}, {"s": 1555.45, "e": 1559.32, "t": "Dat zou prima zijn."}, {"s": 1559.37, "e": 1563.88, "t": "Ik geef u oogdruppels."}, {"s": 1563.93, "e": 1567.99, "t": "Hoe vaak gebruik ik die?"}, {"s": 1568.04, "e": 1572.26, "t": "Drie keer per dag."}, {"s": 1572.31, "e": 1575.81, "t": "Ook op het werk?"}, {"s": 1575.86, "e": 1580.07, "t": "Ja, vooral daar."}, {"s": 1580.12, "e": 1584.22, "t": "Wat helpt nog meer?"}, {"s": 1584.27, "e": 1590.62, "t": "Neem korte pauzes."}, {"s": 1590.67, "e": 1594.36, "t": "Elke twee uur?"}, {"s": 1594.41, "e": 1598.36, "t": "Liever elk uur."}, {"s": 1598.41, "e": 1602.45, "t": "Goed, ik probeer het."}, {"s": 1602.5, "e": 1607.31, "t": "Kom volgende maand terug."}, {"s": 1607.36, "e": 1611.97, "t": "Ik maak een afspraak."}, {"s": 1612.02, "e": 1615.07, "t": "Heel goed."}, {"s": 1615.12, "e": 1621.49, "t": "Bedankt voor uw hulp."}, {"s": 1621.54, "e": 1628.05, "t": "Graag gedaan, tot ziens."}, {"s": 1632.24, "e": 1636.54, "t": "De avond na een lange dag"}, {"s": 1637.04, "e": 1641.8, "t": "Eindelijk ben ik thuis."}, {"s": 1641.85, "e": 1645.89, "t": "Je ziet er moe uit."}, {"s": 1645.94, "e": 1651.02, "t": "Het was een lange dag."}, {"s": 1651.07, "e": 1654.66, "t": "Had je veel werk?"}, {"s": 1654.71, "e": 1659.59, "t": "Ja, heel veel e-mails."}, {"s": 1659.64, "e": 1663.78, "t": "Rust dan even uit."}, {"s": 1663.83, "e": 1669.35, "t": "Eerst trek ik andere kleren aan."}, {"s": 1669.4, "e": 1673.97, "t": "Je pantoffels staan daar."}, {"s": 1674.02, "e": 1677.92, "t": "Dank je, fijn."}, {"s": 1677.97, "e": 1681.3, "t": "Wil je thee?"}, {"s": 1681.35, "e": 1686.7, "t": "Ja, kamillethee, alsjeblieft."}, {"s": 1686.75, "e": 1690.6, "t": "Ik zet hem meteen."}, {"s": 1690.65, "e": 1694.75, "t": "Ik was even mijn handen."}, {"s": 1694.8, "e": 1699.06, "t": "We eten later."}, {"s": 1699.11, "e": 1702.47, "t": "Geen probleem."}, {"s": 1702.52, "e": 1707.29, "t": "Heb je vandaag gegeten?"}, {"s": 1707.34, "e": 1711.33, "t": "Alleen een broodje."}, {"s": 1711.38, "e": 1715.4, "t": "Dat is te weinig."}, {"s": 1715.45, "e": 1718.76, "t": "Ik weet het."}, {"s": 1718.81, "e": 1723.17, "t": "Morgen neem je soep mee."}, {"s": 1723.22, "e": 1726.29, "t": "Goed idee."}, {"s": 1726.34, "e": 1731.05, "t": "Leg nu je telefoon weg."}, {"s": 1731.1, "e": 1735.19, "t": "Nog maar één berichtje."}, {"s": 1735.24, "e": 1739.72, "t": "Wil je muziek luisteren?"}, {"s": 1739.77, "e": 1744.08, "t": "Ja, iets rustigs."}, {"s": 1744.13, "e": 1748.32, "t": "Ik zet zachte muziek op."}, {"s": 1748.37, "e": 1752.22, "t": "Dat helpt me erg."}, {"s": 1752.27, "e": 1756.37, "t": "Je tas staat open."}, {"s": 1756.42, "e": 1760.86, "t": "Ik ruim hem later op."}, {"s": 1760.91, "e": 1765.11, "t": "Nee, liever nu."}, {"s": 1765.16, "e": 1770.35, "t": "Daarna ben je klaar voor vandaag."}, {"s": 1770.4, "e": 1774.15, "t": "Ja, beloofd."}, {"s": 1774.2, "e": 1777.74, "t": "Wil je even douchen?"}, {"s": 1777.79, "e": 1783.13, "t": "Ja, een warme douche helpt."}, {"s": 1783.18, "e": 1788.86, "t": "Daarna staat je thee klaar."}, {"s": 1788.91, "e": 1793.32, "t": "Dat klinkt heerlijk."}, {"s": 1793.37, "e": 1798.75, "t": "Later lezen we samen."}, {"s": 1798.8, "e": 1802.71, "t": "Maar tien minuten."}, {"s": 1802.76, "e": 1806.46, "t": "Dat is genoeg."}, {"s": 1806.51, "e": 1811.68, "t": "Morgen sta ik vroeg op."}, {"s": 1811.73, "e": 1815.98, "t": "Ga dan vroeg naar bed."}, {"s": 1816.03, "e": 1819.76, "t": "Om tien uur."}, {"s": 1819.81, "e": 1823.36, "t": "Heel verstandig."}, {"s": 1823.41, "e": 1827.31, "t": "Bedankt voor de thee."}, {"s": 1827.36, "e": 1832.37, "t": "Graag gedaan, drink rustig."}, {"s": 1832.42, "e": 1839.55, "t": "Nu wordt het een rustige avond."}, {"s": 1839.6, "e": 1846.79, "t": "Precies, dat heb je nodig."}, {"s": 1850.99, "e": 1856.07, "t": "Bloedonderzoek en de uitslag"}, {"s": 1856.57, "e": 1861.1, "t": "Goedendag, mevrouw Meijer."}, {"s": 1861.15, "e": 1865.09, "t": "Goedendag, dokter."}, {"s": 1865.14, "e": 1869.57, "t": "De uitslag is binnen."}, {"s": 1869.62, "e": 1873.55, "t": "Is alles in orde?"}, {"s": 1873.6, "e": 1878.09, "t": "Bijna alles, ja."}, {"s": 1878.14, "e": 1882.6, "t": "Wat bedoelt u met bijna?"}, {"s": 1882.65, "e": 1887.46, "t": "U heeft te weinig ijzer."}, {"s": 1887.51, "e": 1891.46, "t": "Ben ik daarom moe?"}, {"s": 1891.51, "e": 1895.26, "t": "Dat kan zeker."}, {"s": 1895.31, "e": 1898.83, "t": "Is het gevaarlijk?"}, {"s": 1898.88, "e": 1903.83, "t": "Nee, maar het is belangrijk."}, {"s": 1903.88, "e": 1907.67, "t": "Wat moet ik doen?"}, {"s": 1907.72, "e": 1912.43, "t": "Eet meer voedsel met ijzer."}, {"s": 1912.48, "e": 1916.6, "t": "Welk voedsel helpt?"}, {"s": 1916.65, "e": 1922.16, "t": "Linzen, bonen en spinazie."}, {"s": 1922.21, "e": 1926.01, "t": "Dat eet ik graag."}, {"s": 1926.06, "e": 1929.25, "t": "Heel goed."}, {"s": 1929.3, "e": 1933.8, "t": "Heb ik tabletten nodig?"}, {"s": 1933.85, "e": 1938.29, "t": "Ja, voor vier weken."}, {"s": 1938.34, "e": 1942.12, "t": "Hoe neem ik die in?"}, {"s": 1942.17, "e": 1946.46, "t": "Eén tablet in de ochtend."}, {"s": 1946.51, "e": 1950.19, "t": "Voor het eten?"}, {"s": 1950.24, "e": 1955.02, "t": "Liever na het ontbijt."}, {"s": 1955.07, "e": 1959.08, "t": "Zijn er bijwerkingen?"}, {"s": 1959.13, "e": 1963.14, "t": "Soms buikpijn."}, {"s": 1963.19, "e": 1966.92, "t": "Moet ik dan bellen?"}, {"s": 1966.97, "e": 1971.08, "t": "Ja, graag meteen."}, {"s": 1971.13, "e": 1976.13, "t": "Wanneer controleren we het weer?"}, {"s": 1976.18, "e": 1980.4, "t": "Over zes weken."}, {"s": 1980.45, "e": 1984.08, "t": "Mag ik sporten?"}, {"s": 1984.13, "e": 1988.97, "t": "Ja, maar rustig."}, {"s": 1989.02, "e": 1992.82, "t": "Ik wandel graag."}, {"s": 1992.87, "e": 1996.71, "t": "Dat is heel goed."}, {"s": 1996.76, "e": 2001.71, "t": "Moet ik veel drinken?"}, {"s": 2001.76, "e": 2006.69, "t": "Ja, water is belangrijk."}, {"s": 2006.74, "e": 2011.53, "t": "Dan verander ik een paar dingen."}, {"s": 2011.58, "e": 2015.43, "t": "Dat helpt zeker."}, {"s": 2015.48, "e": 2019.93, "t": "Bedankt voor de uitleg."}, {"s": 2019.98, "e": 2024.36, "t": "Graag gedaan, mevrouw Meijer."}, {"s": 2024.41, "e": 2028.28, "t": "Ik haal de tabletten op."}, {"s": 2028.33, "e": 2032.95, "t": "Hier is het recept."}, {"s": 2033.0, "e": 2039.34, "t": "Hartelijk dank, tot ziens."}, {"s": 2039.39, "e": 2044.36, "t": "Tot ziens."}]