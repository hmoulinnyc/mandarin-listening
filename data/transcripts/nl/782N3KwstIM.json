[{"s": 1.1, "e": 5.85, "t": "Mijn school en mijn taalcursus"}, {"s": 6.35, "e": 10.82, "t": "Hoe is je taalcursus?"}, {"s": 10.87, "e": 16.83, "t": "Goed, maar soms best vermoeiend."}, {"s": 16.88, "e": 21.1, "t": "Wanneer heb je les?"}, {"s": 21.15, "e": 27.02, "t": "Op maandag, woensdag en vrijdag."}, {"s": 27.07, "e": 31.0, "t": "Altijd 's avonds?"}, {"s": 31.05, "e": 36.3, "t": "Ja, van zes tot acht uur."}, {"s": 36.35, "e": 40.09, "t": "Dat is laat."}, {"s": 40.14, "e": 45.4, "t": "Ja, want overdag werk ik."}, {"s": 45.45, "e": 49.83, "t": "Hoe heet je lerares?"}, {"s": 49.88, "e": 54.53, "t": "Ze heet mevrouw De Vries."}, {"s": 54.58, "e": 58.11, "t": "Is ze streng?"}, {"s": 58.16, "e": 63.48, "t": "Een beetje, maar ze legt goed uit."}, {"s": 63.53, "e": 68.03, "t": "Wat leren jullie nu?"}, {"s": 68.08, "e": 75.74, "t": "We leren de voltooide tijd en voorzetsels."}, {"s": 75.79, "e": 80.98, "t": "O, voorzetsels zijn moeilijk."}, {"s": 81.03, "e": 86.18, "t": "Ja, maar we oefenen veel."}, {"s": 86.23, "e": 91.86, "t": "Hoeveel mensen zitten er in de groep?"}, {"s": 91.91, "e": 95.41, "t": "Twaalf mensen."}, {"s": 95.46, "e": 100.02, "t": "Komen ze uit verschillende landen?"}, {"s": 100.07, "e": 104.63, "t": "Ja, dat is interessant."}, {"s": 104.68, "e": 110.55, "t": "Spreken jullie in de les alleen Nederlands?"}, {"s": 110.6, "e": 114.16, "t": "Meestal wel."}, {"s": 114.21, "e": 117.88, "t": "Dat helpt vast."}, {"s": 117.93, "e": 124.46, "t": "Ja, maar soms zoek ik lang naar een woord."}, {"s": 124.51, "e": 129.16, "t": "Dat gebeurt bij iedereen."}, {"s": 129.21, "e": 135.08, "t": "Vandaag moest ik een presentatie geven."}, {"s": 135.13, "e": 139.11, "t": "Echt? Waarover?"}, {"s": 139.16, "e": 143.88, "t": "Over mijn dagelijks leven."}, {"s": 143.93, "e": 147.79, "t": "Was je zenuwachtig?"}, {"s": 147.84, "e": 152.69, "t": "Ja, heel erg. Maar het ging goed."}, {"s": 152.74, "e": 157.75, "t": "Fijn. Dan leer je snel."}, {"s": 157.8, "e": 161.23, "t": "Ik hoop het."}, {"s": 161.28, "e": 168.7, "t": "Het belangrijkste is dat je doorgaat."}, {"s": 168.75, "e": 176.69, "t": "Precies. Elke dag een klein stapje."}, {"s": 180.89, "e": 184.75, "t": "Nederlands leren"}, {"s": 185.25, "e": 190.26, "t": "Waarom leer je Nederlands?"}, {"s": 190.31, "e": 195.8, "t": "Omdat ik in Nederland wil werken."}, {"s": 195.85, "e": 200.0, "t": "Dat is een goede reden."}, {"s": 200.05, "e": 206.56, "t": "Ja, en ik wil met mijn buren praten."}, {"s": 206.61, "e": 211.11, "t": "Begrijp je al veel?"}, {"s": 211.16, "e": 217.74, "t": "Een beetje. Langzame gesprekken begrijp ik goed."}, {"s": 217.79, "e": 222.04, "t": "Wat vind je moeilijk?"}, {"s": 222.09, "e": 228.47, "t": "De lidwoorden. De en het."}, {"s": 228.52, "e": 233.79, "t": "Ja, die zijn lastig."}, {"s": 233.84, "e": 240.46, "t": "Ik schrijf nieuwe woorden altijd met het lidwoord op."}, {"s": 240.51, "e": 245.27, "t": "Dat is een heel goede manier."}, {"s": 245.32, "e": 250.96, "t": "En jij? Waarom leer jij Nederlands?"}, {"s": 251.01, "e": 256.28, "t": "Ik wil een beroepsopleiding volgen."}, {"s": 256.33, "e": 262.57, "t": "Dan moet je vast goed Nederlands kunnen."}, {"s": 262.62, "e": 267.34, "t": "Ja, vooral op kantoor."}, {"s": 267.39, "e": 271.22, "t": "Hoe leer je?"}, {"s": 271.27, "e": 281.32, "t": "Ik luister elke dag naar eenvoudige dialogen."}, {"s": 281.37, "e": 286.74, "t": "Dat helpt om gesprekken te begrijpen."}, {"s": 286.79, "e": 293.23, "t": "Precies. Ik praat ook tegen mezelf."}, {"s": 293.28, "e": 296.02, "t": "Echt?"}, {"s": 296.07, "e": 301.26, "t": "Ja, thuis. Niemand hoort me."}, {"s": 301.31, "e": 304.67, "t": "Dat is slim."}, {"s": 304.72, "e": 309.83, "t": "Soms antwoordt mijn kat."}, {"s": 309.88, "e": 313.48, "t": "In het Nederlands?"}, {"s": 313.53, "e": 319.95, "t": "Natuurlijk alleen met 'miauw'."}, {"s": 320.0, "e": 326.24, "t": "Dan heeft ze al niveau A1."}, {"s": 326.29, "e": 332.22, "t": "Misschien. Ze begrijpt 'kom'."}, {"s": 332.27, "e": 335.59, "t": "Heel goed."}, {"s": 335.64, "e": 341.62, "t": "We moeten vaker samen oefenen."}, {"s": 341.67, "e": 347.39, "t": "Ja, dan durven we meer te praten."}, {"s": 347.44, "e": 354.45, "t": "Afgesproken. Morgen in de pauze?"}, {"s": 354.5, "e": 359.13, "t": "Prima."}, {"s": 363.33, "e": 366.64, "t": "Mijn werkplek"}, {"s": 367.14, "e": 370.89, "t": "Hoe is het op je werk?"}, {"s": 370.94, "e": 376.92, "t": "Best goed. Ik werk op een kantoor."}, {"s": 376.97, "e": 380.6, "t": "Wat doe je daar?"}, {"s": 380.65, "e": 386.75, "t": "Ik beantwoord e-mails en bel met klanten."}, {"s": 386.8, "e": 391.64, "t": "Heb je aardige collega's?"}, {"s": 391.69, "e": 396.88, "t": "Ja, de meesten helpen me graag."}, {"s": 396.93, "e": 400.56, "t": "Dat is belangrijk."}, {"s": 400.61, "e": 405.84, "t": "Ja, vooral omdat ik nog nieuw ben."}, {"s": 405.89, "e": 409.69, "t": "Hoe laat begin je?"}, {"s": 409.74, "e": 413.52, "t": "Om half negen."}, {"s": 413.57, "e": 417.44, "t": "En hoe laat ben je klaar?"}, {"s": 417.49, "e": 421.96, "t": "Meestal om vijf uur."}, {"s": 422.01, "e": 425.64, "t": "Heb je een pauze?"}, {"s": 425.69, "e": 429.58, "t": "Ja, om half één."}, {"s": 429.63, "e": 433.33, "t": "Waar eet je?"}, {"s": 433.38, "e": 437.61, "t": "In de kleine keuken."}, {"s": 437.66, "e": 441.02, "t": "Is daar koffie?"}, {"s": 441.07, "e": 447.12, "t": "Ja, maar de koffie is erg sterk."}, {"s": 447.17, "e": 450.61, "t": "Vind je die lekker?"}, {"s": 450.66, "e": 455.7, "t": "Niet echt, maar ik word er wakker van."}, {"s": 455.75, "e": 460.0, "t": "Wat staat er op je bureau?"}, {"s": 460.05, "e": 467.46, "t": "Een computer, een telefoon en veel briefjes."}, {"s": 467.51, "e": 470.93, "t": "Veel briefjes?"}, {"s": 470.98, "e": 477.87, "t": "Ja, ik schrijf alles op, zodat ik niets vergeet."}, {"s": 477.92, "e": 481.22, "t": "Goed idee."}, {"s": 481.27, "e": 486.22, "t": "Gisteren vergat ik toch iets."}, {"s": 486.27, "e": 489.52, "t": "Wat dan?"}, {"s": 489.57, "e": 495.41, "t": "Ik nam mijn muis mee naar huis."}, {"s": 495.46, "e": 498.48, "t": "Waarom?"}, {"s": 498.53, "e": 505.05, "t": "Ik dacht dat het mijn eigen muis was."}, {"s": 505.1, "e": 510.59, "t": "Dat is grappig."}, {"s": 510.64, "e": 517.08, "t": "Vandaag breng ik hem terug."}, {"s": 521.28, "e": 525.93, "t": "Beroepen leren kennen"}, {"s": 526.43, "e": 532.22, "t": "Vandaag praten we over beroepen."}, {"s": 532.27, "e": 538.21, "t": "Ik ken dokter en lerares."}, {"s": 538.26, "e": 543.31, "t": "Heel goed. Wat doet een dokter?"}, {"s": 543.36, "e": 549.14, "t": "Hij helpt zieke mensen."}, {"s": 549.19, "e": 554.14, "t": "Juist. En wat doet een lerares?"}, {"s": 554.19, "e": 559.85, "t": "Ze legt dingen uit en geeft les."}, {"s": 559.9, "e": 563.1, "t": "Precies."}, {"s": 563.15, "e": 568.25, "t": "Wat betekent 'verkoper'?"}, {"s": 568.3, "e": 573.7, "t": "Een verkoper werkt in een winkel."}, {"s": 573.75, "e": 579.45, "t": "Verkoopt hij kleding of eten?"}, {"s": 579.5, "e": 583.67, "t": "Ja, bijvoorbeeld."}, {"s": 583.72, "e": 587.58, "t": "En een chauffeur?"}, {"s": 587.63, "e": 595.26, "t": "Een chauffeur rijdt een bus, taxi of vrachtwagen."}, {"s": 595.31, "e": 600.66, "t": "Mijn oom is buschauffeur."}, {"s": 600.71, "e": 605.95, "t": "Interessant. Vindt hij zijn werk leuk?"}, {"s": 606.0, "e": 612.89, "t": "Ja, maar hij staat heel vroeg op."}, {"s": 612.94, "e": 617.28, "t": "Dat is vast zwaar."}, {"s": 617.33, "e": 623.07, "t": "Welke beroepen zijn er nog meer?"}, {"s": 623.12, "e": 629.99, "t": "Kok, bakker, verpleegkundige en ingenieur."}, {"s": 630.04, "e": 636.24, "t": "Verpleegkundige is een belangrijk beroep."}, {"s": 636.29, "e": 640.9, "t": "Ja, heel belangrijk."}, {"s": 640.95, "e": 646.03, "t": "Ik wil later op kantoor werken."}, {"s": 646.08, "e": 652.06, "t": "Dan past administratief medewerker goed bij je."}, {"s": 652.11, "e": 656.29, "t": "Wat moet je dan doen?"}, {"s": 656.34, "e": 663.13, "t": "Bellen, schrijven en afspraken plannen."}, {"s": 663.18, "e": 667.05, "t": "Dat klinkt goed."}, {"s": 667.1, "e": 672.4, "t": "Welk beroep past niet bij jou?"}, {"s": 672.45, "e": 679.48, "t": "Bakker. Ik sta niet graag om vier uur op."}, {"s": 679.53, "e": 683.17, "t": "Dat begrijp ik."}, {"s": 683.22, "e": 691.58, "t": "Maar ik vind verse broodjes wel lekker."}, {"s": 691.63, "e": 698.3, "t": "Dan kun je beter klant blijven."}, {"s": 698.35, "e": 703.8, "t": "Goed idee."}, {"s": 707.99, "e": 711.04, "t": "Huisdieren"}, {"s": 711.54, "e": 715.41, "t": "Heb je een huisdier?"}, {"s": 715.46, "e": 719.96, "t": "Ja, ik heb een kat."}, {"s": 720.01, "e": 723.32, "t": "Hoe heet ze?"}, {"s": 723.37, "e": 727.52, "t": "Ze heet Luna."}, {"s": 727.57, "e": 731.63, "t": "Hoe oud is Luna?"}, {"s": 731.68, "e": 735.23, "t": "Vier jaar."}, {"s": 735.28, "e": 739.32, "t": "Welke kleur heeft ze?"}, {"s": 739.37, "e": 745.58, "t": "Ze is grijs en heeft witte pootjes."}, {"s": 745.63, "e": 749.94, "t": "Lief. Is ze rustig?"}, {"s": 749.99, "e": 756.72, "t": "Soms. 's Avonds is ze heel actief."}, {"s": 756.77, "e": 760.27, "t": "Wat doet ze dan?"}, {"s": 760.32, "e": 767.46, "t": "Ze rent door het huis en jaagt op balletjes."}, {"s": 767.51, "e": 770.84, "t": "Dat ken ik."}, {"s": 770.89, "e": 775.74, "t": "Heb jij ook een huisdier?"}, {"s": 775.79, "e": 779.69, "t": "Ja, een hond."}, {"s": 779.74, "e": 783.56, "t": "Hoe heet hij?"}, {"s": 783.61, "e": 787.28, "t": "Hij heet Max."}, {"s": 787.33, "e": 792.33, "t": "Moet je vaak met hem naar buiten?"}, {"s": 792.38, "e": 799.49, "t": "Ja, 's ochtends, 's middags en 's avonds."}, {"s": 799.54, "e": 803.96, "t": "Dat is veel werk."}, {"s": 804.01, "e": 808.41, "t": "Ja, maar het is leuk."}, {"s": 808.46, "e": 812.98, "t": "Wat eet Max?"}, {"s": 813.03, "e": 818.58, "t": "Hondenvoer en soms wortels."}, {"s": 818.63, "e": 824.3, "t": "Mijn kat eet geen wortels."}, {"s": 824.35, "e": 827.66, "t": "Dat geloof ik."}, {"s": 827.71, "e": 835.06, "t": "Gisteren verstopte Luna mijn schrift voor Nederlands."}, {"s": 835.11, "e": 837.86, "t": "Echt?"}, {"s": 837.91, "e": 842.2, "t": "Ja, onder de bank."}, {"s": 842.25, "e": 847.85, "t": "Misschien wilde ze ook leren."}, {"s": 847.9, "e": 854.21, "t": "Misschien. Ze zat op het boek."}, {"s": 854.26, "e": 861.03, "t": "Dan was zij de lerares."}, {"s": 861.08, "e": 870.31, "t": "Ja, maar wel een strenge lerares."}, {"s": 874.51, "e": 878.19, "t": "Kleuren en vormen"}, {"s": 878.69, "e": 883.67, "t": "Laten we kleuren oefenen."}, {"s": 883.72, "e": 889.65, "t": "Graag. Welke kleur heeft je trui?"}, {"s": 889.7, "e": 893.8, "t": "Hij is geel."}, {"s": 893.85, "e": 898.11, "t": "Goed. En mijn tas?"}, {"s": 898.16, "e": 902.59, "t": "Je tas is zwart."}, {"s": 902.64, "e": 905.7, "t": "Heel goed."}, {"s": 905.75, "e": 911.47, "t": "Welke kleur heeft de pen?"}, {"s": 911.52, "e": 914.53, "t": "Blauw."}, {"s": 914.58, "e": 920.42, "t": "Nee, kijk eens goed."}, {"s": 920.47, "e": 924.87, "t": "O, hij is donkergroen."}, {"s": 924.92, "e": 928.19, "t": "Precies."}, {"s": 928.24, "e": 933.24, "t": "Vormen zijn moeilijker."}, {"s": 933.29, "e": 941.04, "t": "We gaan oefenen. De tafel is rechthoekig."}, {"s": 941.09, "e": 945.52, "t": "En de klok is rond."}, {"s": 945.57, "e": 950.68, "t": "Goed. Wat is vierkant?"}, {"s": 950.73, "e": 956.7, "t": "Misschien dat kleine schilderij aan de muur."}, {"s": 956.75, "e": 961.94, "t": "Ja, dat is bijna vierkant."}, {"s": 961.99, "e": 967.12, "t": "Welke vorm heeft je telefoon?"}, {"s": 967.17, "e": 972.28, "t": "Die is ook rechthoekig."}, {"s": 972.33, "e": 976.61, "t": "Alles is rechthoekig."}, {"s": 976.66, "e": 981.97, "t": "Bijna. Het bord is rond."}, {"s": 982.02, "e": 985.28, "t": "Dat klopt."}, {"s": 985.33, "e": 990.87, "t": "Beschrijf deze kop eens."}, {"s": 990.92, "e": 997.03, "t": "De kop is wit en rond."}, {"s": 997.08, "e": 1003.58, "t": "Heel goed. En hij heeft een rood oor."}, {"s": 1003.63, "e": 1008.19, "t": "O ja, dat zag ik niet."}, {"s": 1008.24, "e": 1013.38, "t": "Details zijn belangrijk."}, {"s": 1013.43, "e": 1018.61, "t": "Ik zie een driehoekig servet."}, {"s": 1018.66, "e": 1022.93, "t": "Echt? Waar?"}, {"s": 1022.98, "e": 1026.97, "t": "Daar op de tafel."}, {"s": 1027.02, "e": 1035.13, "t": "Dat is geen driehoek. Het is alleen verkeerd gevouwen."}, {"s": 1035.18, "e": 1042.76, "t": "Dan heb ik een nieuwe vorm bedacht."}, {"s": 1042.81, "e": 1052.26, "t": "Misschien. Van Nederlands leren word je creatief."}, {"s": 1056.46, "e": 1059.29, "t": "In het park"}, {"s": 1059.79, "e": 1064.77, "t": "Zullen we in het park wandelen?"}, {"s": 1064.82, "e": 1070.34, "t": "Ja, graag. Het is mooi weer."}, {"s": 1070.39, "e": 1077.69, "t": "De zon schijnt, maar het is niet te warm."}, {"s": 1077.74, "e": 1082.06, "t": "Heerlijk om te wandelen."}, {"s": 1082.11, "e": 1087.17, "t": "Kijk, daar voetballen kinderen."}, {"s": 1087.22, "e": 1093.06, "t": "Ja, en daar zitten mensen op het gras."}, {"s": 1093.11, "e": 1099.29, "t": "Ik vind dit een fijn, rustig plekje."}, {"s": 1099.34, "e": 1104.45, "t": "Zullen we op het bankje gaan zitten?"}, {"s": 1104.5, "e": 1110.67, "t": "Ja, maar eerst lopen we een rondje."}, {"s": 1110.72, "e": 1113.93, "t": "Goed idee."}, {"s": 1113.98, "e": 1117.93, "t": "Hoor je de vogels?"}, {"s": 1117.98, "e": 1122.82, "t": "Ja, ze zingen heel mooi."}, {"s": 1122.87, "e": 1128.24, "t": "In het park kan ik goed ontspannen."}, {"s": 1128.29, "e": 1134.45, "t": "Ik ook. Na mijn werk wil ik frisse lucht."}, {"s": 1134.5, "e": 1138.61, "t": "Heb je water bij je?"}, {"s": 1138.66, "e": 1143.28, "t": "Ja, een klein flesje."}, {"s": 1143.33, "e": 1148.21, "t": "Fijn. Ik ben het vergeten."}, {"s": 1148.26, "e": 1152.9, "t": "Geen probleem, we delen het."}, {"s": 1152.95, "e": 1155.99, "t": "Dank je."}, {"s": 1156.04, "e": 1161.77, "t": "O, daar loopt een hond zonder riem."}, {"s": 1161.82, "e": 1167.51, "t": "Hij komt naar ons toe."}, {"s": 1167.56, "e": 1173.14, "t": "Geen zorgen, hij ziet er lief uit."}, {"s": 1173.19, "e": 1179.04, "t": "Toch blijf ik even staan."}, {"s": 1179.09, "e": 1184.01, "t": "Kijk, zijn baasje roept hem al."}, {"s": 1184.06, "e": 1189.11, "t": "Ja, hij loopt weer terug."}, {"s": 1189.16, "e": 1193.71, "t": "Nu is het weer rustig."}, {"s": 1193.76, "e": 1198.4, "t": "Laten we naar het bankje gaan."}, {"s": 1198.45, "e": 1203.76, "t": "Ja, en daarna halen we een ijsje."}, {"s": 1203.81, "e": 1211.69, "t": "Goed idee. Bij een dagje park hoort een ijsje."}, {"s": 1211.74, "e": 1218.07, "t": "Precies. Dat wordt lekker."}, {"s": 1222.25, "e": 1225.88, "t": "Mijn weekend"}, {"s": 1226.38, "e": 1230.03, "t": "Hoe was je weekend?"}, {"s": 1230.08, "e": 1236.27, "t": "Leuk, maar een beetje druk en rommelig."}, {"s": 1236.32, "e": 1240.46, "t": "Wat is er gebeurd?"}, {"s": 1240.51, "e": 1245.83, "t": "Zaterdag wilde ik uitslapen."}, {"s": 1245.88, "e": 1248.58, "t": "En?"}, {"s": 1248.63, "e": 1255.06, "t": "Om zeven uur begon mijn buurman te boren."}, {"s": 1255.11, "e": 1258.68, "t": "O nee."}, {"s": 1258.73, "e": 1263.16, "t": "Ja, daarom was ik vroeg wakker."}, {"s": 1263.21, "e": 1267.47, "t": "Wat heb je toen gedaan?"}, {"s": 1267.52, "e": 1271.74, "t": "Ik ben boodschappen gaan doen."}, {"s": 1271.79, "e": 1275.19, "t": "Was het druk?"}, {"s": 1275.24, "e": 1281.42, "t": "Heel druk. Iedereen wilde verse broodjes."}, {"s": 1281.47, "e": 1284.74, "t": "En 's middags?"}, {"s": 1284.79, "e": 1289.48, "t": "Toen ging ik bij een vriendin op bezoek."}, {"s": 1289.53, "e": 1293.87, "t": "Hebben jullie iets leuks gedaan?"}, {"s": 1293.92, "e": 1299.03, "t": "Ja, we zijn naar de bioscoop geweest."}, {"s": 1299.08, "e": 1303.82, "t": "Welke film hebben jullie gezien?"}, {"s": 1303.87, "e": 1307.37, "t": "Een komedie."}, {"s": 1307.42, "e": 1310.82, "t": "Was die leuk?"}, {"s": 1310.87, "e": 1315.62, "t": "Ja, we hebben veel gelachen."}, {"s": 1315.67, "e": 1318.81, "t": "En zondag?"}, {"s": 1318.86, "e": 1326.6, "t": "Zondag was rustig. Ik heb gekookt en Nederlands geleerd."}, {"s": 1326.65, "e": 1330.09, "t": "Goed bezig."}, {"s": 1330.14, "e": 1337.8, "t": "Maar een beetje hoor. Daarna heb ik lang gebeld."}, {"s": 1337.85, "e": 1341.26, "t": "Met je familie?"}, {"s": 1341.31, "e": 1345.15, "t": "Ja, met mijn zus."}, {"s": 1345.2, "e": 1349.85, "t": "Dat klinkt als een fijn weekend."}, {"s": 1349.9, "e": 1357.41, "t": "Ja, ook al begon het met lawaai."}, {"s": 1357.46, "e": 1362.95, "t": "Volgend weekend wordt het rustiger."}, {"s": 1363.0, "e": 1366.16, "t": "Hopelijk."}, {"s": 1366.21, "e": 1369.75, "t": "Heb je al plannen?"}, {"s": 1369.8, "e": 1377.36, "t": "Misschien een dagje weg, als het mooi weer is."}, {"s": 1377.41, "e": 1384.36, "t": "Dan hoop ik op mooi weer voor je."}, {"s": 1388.54, "e": 1392.47, "t": "Vakantie aan zee"}, {"s": 1392.97, "e": 1399.1, "t": "Ik ga volgende week naar zee."}, {"s": 1399.15, "e": 1404.02, "t": "Echt? Waar ga je precies heen?"}, {"s": 1404.07, "e": 1407.93, "t": "Naar de Noordzee."}, {"s": 1407.98, "e": 1412.24, "t": "Leuk. Ga je alleen?"}, {"s": 1412.29, "e": 1416.47, "t": "Nee, met mijn zus."}, {"s": 1416.52, "e": 1421.13, "t": "Hebben jullie al een hotel?"}, {"s": 1421.18, "e": 1428.05, "t": "Ja, een klein hotel dicht bij het strand."}, {"s": 1428.1, "e": 1431.66, "t": "Dat is handig."}, {"s": 1431.71, "e": 1436.88, "t": "Ja, we kunnen naar het water lopen."}, {"s": 1436.93, "e": 1441.42, "t": "Wat willen jullie daar doen?"}, {"s": 1441.47, "e": 1447.42, "t": "Wandelen, schelpen zoeken en fietsen."}, {"s": 1447.47, "e": 1451.17, "t": "Ga je ook zwemmen?"}, {"s": 1451.22, "e": 1457.88, "t": "Misschien, maar het water is vaak koud."}, {"s": 1457.93, "e": 1461.08, "t": "Dat klopt."}, {"s": 1461.13, "e": 1467.33, "t": "Ik heb vooral zin in verse vis."}, {"s": 1467.38, "e": 1470.95, "t": "Hou je van vis?"}, {"s": 1471.0, "e": 1476.36, "t": "Ja, heel erg. Mijn zus niet."}, {"s": 1476.41, "e": 1480.27, "t": "Wat eet zij dan?"}, {"s": 1480.32, "e": 1484.66, "t": "Waarschijnlijk patat."}, {"s": 1484.71, "e": 1487.94, "t": "Ook lekker."}, {"s": 1487.99, "e": 1493.7, "t": "We hebben ook regenjassen ingepakt."}, {"s": 1493.75, "e": 1500.09, "t": "Goed idee, want aan zee verandert het weer snel."}, {"s": 1500.14, "e": 1503.38, "t": "Precies."}, {"s": 1503.43, "e": 1507.52, "t": "Heb je zonnebrandcrème?"}, {"s": 1507.57, "e": 1513.83, "t": "Ja, maar ik was bijna mijn badpak vergeten."}, {"s": 1513.88, "e": 1518.26, "t": "Voor een vakantie aan zee?"}, {"s": 1518.31, "e": 1525.71, "t": "Ja, ik pak mijn spullen soms een beetje raar in."}, {"s": 1525.76, "e": 1530.95, "t": "Maak dan liever een lijstje."}, {"s": 1531.0, "e": 1536.98, "t": "Dat heb ik nu gedaan."}, {"s": 1537.03, "e": 1543.93, "t": "Dan vergeet je niets meer."}, {"s": 1548.12, "e": 1552.55, "t": "Inchecken in het hotel"}, {"s": 1553.05, "e": 1558.77, "t": "Goedenavond. Welkom in ons hotel."}, {"s": 1558.82, "e": 1564.22, "t": "Goedenavond. Ik heb gereserveerd."}, {"s": 1564.27, "e": 1567.92, "t": "Op welke naam?"}, {"s": 1567.96, "e": 1571.6, "t": "Op naam van Bakker."}, {"s": 1571.64, "e": 1575.7, "t": "Een moment, alstublieft."}, {"s": 1575.76, "e": 1579.07, "t": "Natuurlijk."}, {"s": 1579.12, "e": 1583.98, "t": "Ja, ik zie uw reservering."}, {"s": 1584.04, "e": 1587.1, "t": "Heel goed."}, {"s": 1587.14, "e": 1592.79, "t": "Een eenpersoonskamer voor twee nachten."}, {"s": 1592.84, "e": 1596.01, "t": "Dat klopt."}, {"s": 1596.06, "e": 1601.22, "t": "Mag ik uw identiteitsbewijs zien?"}, {"s": 1601.27, "e": 1604.87, "t": "Ja, alstublieft."}, {"s": 1604.91, "e": 1609.77, "t": "Dank u. Wilt u ontbijt?"}, {"s": 1609.83, "e": 1615.54, "t": "Is het ontbijt bij de prijs inbegrepen?"}, {"s": 1615.59, "e": 1621.4, "t": "Nee, het kost twaalf euro per dag."}, {"s": 1621.45, "e": 1626.69, "t": "Dan wil ik alleen morgen ontbijt."}, {"s": 1626.74, "e": 1630.07, "t": "Geen probleem."}, {"s": 1630.12, "e": 1635.16, "t": "Vanaf hoe laat is het ontbijt?"}, {"s": 1635.21, "e": 1640.08, "t": "Van zeven tot tien uur."}, {"s": 1640.13, "e": 1644.67, "t": "Goed. Waar is mijn kamer?"}, {"s": 1644.72, "e": 1651.49, "t": "Op de derde verdieping, kamer 312."}, {"s": 1651.55, "e": 1655.44, "t": "Is er een lift?"}, {"s": 1655.48, "e": 1659.59, "t": "Ja, daar links."}, {"s": 1659.64, "e": 1665.29, "t": "Dank u. Wat is het wifiwachtwoord?"}, {"s": 1665.34, "e": 1669.98, "t": "Dat staat op dit kaartje."}, {"s": 1670.03, "e": 1672.93, "t": "Prima."}, {"s": 1672.97, "e": 1677.59, "t": "Hier is uw sleutelkaart."}, {"s": 1677.64, "e": 1680.53, "t": "Dank u."}, {"s": 1680.58, "e": 1686.42, "t": "Nog één ding: u krijgt een andere kamer."}, {"s": 1686.47, "e": 1689.47, "t": "Waarom?"}, {"s": 1689.53, "e": 1695.14, "t": "In uw vorige kamer was het raam kapot."}, {"s": 1695.19, "e": 1699.62, "t": "Goed dat u dat heeft gezien."}, {"s": 1699.66, "e": 1707.03, "t": "Ja, nu heeft u een rustige kamer."}, {"s": 1707.08, "e": 1713.37, "t": "Dat klinkt zelfs beter."}]