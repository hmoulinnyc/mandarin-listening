[{"s": 0.0, "e": 3.22, "t": "السلام عليكم، كيف حالكم؟"}, {"s": 3.22, "e": 7.5, "t": "اليوم أريد أن أتحدث إليكم."}, {"s": 7.5, "e": 11.08, "t": "أريد أن أتعرف إليكم،"}, {"s": 11.08, "e": 16.32, "t": "وأريد أن أعرفكم على نفسي."}, {"s": 16.32, "e": 18.98, "t": "اسمي خاسو."}, {"s": 18.98, "e": 23.34, "t": "ولا تسألني ما معنى هذا الاسم."}, {"s": 23.34, "e": 26.0, "t": "والله أنا لا أعرفه."}, {"s": 26.0, "e": 33.86, "t": "إنه اسم شيشاني قديم، ونادر جدًا."}, {"s": 33.86, "e": 39.0, "t": "في الشيشان الآن، أظن هناك"}, {"s": 40.02, "e": 45.1, "t": "خمسة أشخاص يحملون هذا الاسم."}, {"s": 45.1, "e": 49.0, "t": "خمسة: أنا وأربعة آخرون."}, {"s": 49.78, "e": 50.78, "t": "والله أعلم."}, {"s": 50.78, "e": 56.0, "t": "اسم نادر، ولا أحد يعرف ما معناه."}, {"s": 60.32, "e": 65.5, "t": "وكما قلت، إنني من الشيشان."}, {"s": 65.5, "e": 68.98, "t": "هل سمعتم عن الشيشان؟"}, {"s": 68.98, "e": 75.8, "t": "الشيشان هي جمهورية إسلامية صغيرة،"}, {"s": 78.22, "e": 85.36, "t": "تقع على شمال سلسلة جبال القوقاز."}, {"s": 85.36, "e": 87.68, "t": "هناك سلسلة الجبال."}, {"s": 87.68, "e": 89.84, "t": "جبل، جبل، جبل، جبل."}, {"s": 89.84, "e": 92.7, "t": "سلسلة جبال القوقاز."}, {"s": 92.7, "e": 100.86, "t": "وعلى شمال جبال القوقاز هناك الشيشان."}, {"s": 100.86, "e": 106.42, "t": "وهي تقع في جنوب روسيا الاتحادية."}, {"s": 106.42, "e": 108.36, "t": "نعم، الشيشان"}, {"s": 108.36, "e": 115.36, "t": "الآن جزء من روسيا الاتحادية."}, {"s": 116.0, "e": 120.24, "t": "وعندي جواز سفر روسي."}, {"s": 120.24, "e": 125.88, "t": "وروسيا بلد كبير جدًا،"}, {"s": 125.88, "e": 131.36, "t": "يعيش فيه شعوب مختلفة."}, {"s": 132.06, "e": 137.68, "t": "وأكبر هذه الشعوب الشعب الروسي."}, {"s": 137.68, "e": 139.68, "t": "الشعب الروسي."}, {"s": 140.34, "e": 147.12, "t": "الروسيون، شعرهم عادة أشقر،"}, {"s": 147.12, "e": 149.34, "t": "يعني أبيض، أشقر."}, {"s": 149.34, "e": 155.06, "t": "فهم يشبهون الأوروبيين، يشبهون الألمانيين،"}, {"s": 156.0, "e": 157.76, "t": "وهكذا."}, {"s": 157.76, "e": 164.7, "t": "وكذلك في روسيا شعوب مسلمة كثيرة."}, {"s": 164.7, "e": 168.28, "t": "منها الشعب التتاري."}, {"s": 168.28, "e": 171.28, "t": "الشعب التتاري."}, {"s": 172.3, "e": 178.32, "t": "عددهم ما يقارب خمسة ملايين."}, {"s": 179.46, "e": 186.28, "t": "وبعد الشعب التتاري يأتي الشعب الشيشاني."}, {"s": 187.48, "e": 195.28, "t": "وعدد الشيشانيين ما يقارب مليون ونصف."}, {"s": 195.28, "e": 198.28, "t": "مليون ونصف شخص."}, {"s": 200.48, "e": 204.82, "t": "وبعد الشيشانيين هناك داغستانيون،"}, {"s": 204.82, "e": 208.36, "t": "وعندهم أيضًا شعوب كثيرة."}, {"s": 208.36, "e": 214.96, "t": "سوف نتكلم عنهم في حلقة أخرى، إن شاء الله."}, {"s": 214.96, "e": 221.2, "t": "لأن الحديث عن داغستان حديث طويل،"}, {"s": 221.2, "e": 223.62, "t": "يحتاج إلى وقت."}, {"s": 223.62, "e": 228.78, "t": "لأن داغستان بلد عجيب،"}, {"s": 228.78, "e": 236.56, "t": "بلد عجيب حقًا، وجميل، وعندهم قصص كثيرة."}, {"s": 238.03, "e": 244.75, "t": "طيب، قلت: اسمي خاسو، أنا من الشيشان،"}, {"s": 244.75, "e": 252.09, "t": "وعمري أربعة وثلاثون عامًا."}, {"s": 254.16, "e": 254.74, "t": "و..."}, {"s": 255.74, "e": 257.44, "t": "نعم."}, {"s": 260.12, "e": 261.2, "t": "ماذا أيضًا؟"}, {"s": 261.2, "e": 266.38, "t": "ولي عائلة كبيرة."}, {"s": 266.38, "e": 274.2, "t": "أنا حاليًا أعيش في عاصمة ماليزيا،"}, {"s": 274.2, "e": 278.38, "t": "في مدينة كوالالمبور."}, {"s": 278.38, "e": 285.42, "t": "أعيش في هذه المدينة منذ سنة."}, {"s": 286.9, "e": 291.34, "t": "منذ سنتين تقريبًا."}, {"s": 292.88, "e": 297.28, "t": "أدرس هنا في الجامعة الإسلامية،"}, {"s": 297.96, "e": 303.96, "t": "في مرحلة الماجستير، في قسم"}, {"s": 304.82, "e": 309.72, "t": "تعليم العربية لغير الناطقين بها."}, {"s": 309.72, "e": 316.06, "t": "أنا أدرس في الماجستير، في كلية"}, {"s": 316.06, "e": 320.68, "t": "التعليم والتربية، في قسم"}, {"s": 321.26, "e": 325.7, "t": "تعليم العربية لغير الناطقين بها."}, {"s": 327.14, "e": 333.38, "t": "وقبل ماليزيا، درست في الأردن."}, {"s": 334.66, "e": 341.92, "t": "قضيت هناك ثلاث سنوات، وتخرجت"}, {"s": 341.92, "e": 345.34, "t": "في الجامعة الأردنية."}, {"s": 345.34, "e": 352.46, "t": "في كلية الشريعة، في قسم أصول الدين."}, {"s": 354.38, "e": 358.84, "t": "وقبل الأردن، كنت في مصر."}, {"s": 359.56, "e": 366.22, "t": "تعلمت علوم العربية في مصر، في"}, {"s": 366.84, "e": 371.26, "t": "عاصمة مصر، في القاهرة."}, {"s": 371.84, "e": 379.36, "t": "وقضيت في مصر سنة تقريبًا."}, {"s": 380.06, "e": 387.36, "t": "وخلال تلك السنة، تعلمت من العربية الشيء الكثير،"}, {"s": 387.36, "e": 390.1, "t": "ولله الحمد."}, {"s": 390.1, "e": 393.3, "t": "أظن هذا يكفي اليوم."}, {"s": 393.86, "e": 400.54, "t": "لعلي سأشارككم بعض التفاصيل"}, {"s": 400.54, "e": 402.3, "t": "في..."}, {"s": 402.84, "e": 404.24, "t": "في مرة أخرى."}, {"s": 405.84, "e": 407.38, "t": "هل يوجد أي سؤال؟"}]