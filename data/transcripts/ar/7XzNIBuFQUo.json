[{"s": 2.96, "e": 6.08, "t": "2016 كنت عندي 18 عام والعالم بدأ كيتغير."}, {"s": 6.08, "e": 8.04, "t": ">> ومنصات التواصل الاجتماعي كانت في قلب كل"}, {"s": 8.04, "e": 8.4, "t": "ده."}, {"s": 8.4, "e": 10.44, "t": ">> ساعتها ولد شيء جديد."}, {"s": 10.44, "e": 13.81, "t": ">> مشروع رائد في الإعلام الرقمي. [موسيقى]"}, {"s": 17.84, "e": 20.28, "t": ">> لكن الأهم أنه كان دائماً قريب مني"}, {"s": 20.28, "e": 23.44, "t": "وبيتكلم لغتي."}, {"s": 28.16, "e": 29.08, "t": ">> [موسيقى]"}, {"s": 29.08, "e": 30.84, "t": ">> سنين كتير عدت"}, {"s": 30.84, "e": 32.52, "t": ">> أصحاب وأعزاء."}, {"s": 32.52, "e": 33.28, "t": ">> صرنا رفقاء"}, {"s": 33.28, "e": 35.24, "t": ">> في البحث عن الحقيقة، باكتشاف قصص"}, {"s": 35.24, "e": 37.24, "t": "الإنسان، بفهم العالم."}, {"s": 37.24, "e": 40.04, "t": ">> نفهم إيه اللي بيحصل حوالينا وإزاي بيأثر"}, {"s": 40.04, "e": 41.68, "t": "على حياتنا."}, {"s": 41.68, "e": 44.4, "t": ">> في إيه جي بلس، مهمتنا دائماً كانت القرب"}, {"s": 44.4, "e": 48.48, "t": "من جمهورنا، الوفاء لواقعهم."}, {"s": 50.36, "e": 52.12, "t": ">> ونشجعهم باش يطرحوا أسئلة أخرى."}, {"s": 52.12, "e": 54.36, "t": ">> خلنا ندور على إجاباتها مع بعض."}, {"s": 54.36, "e": 56.76, "t": ">> مع بعض، كتبنا عشرات آلاف القصص."}, {"s": 56.76, "e": 57.76, "t": ">> قصصنا"}, {"s": 57.76, "e": 59.6, "t": ">> بالعربية."}, {"s": 59.6, "e": 61.62, "t": ">> [موسيقى]"}, {"s": 61.84, "e": 62.92, "t": ">> قصصنا وصلت"}, {"s": 62.92, "e": 64.0, "t": ">> لـ3 مليارات المشاهدة."}, {"s": 64.0, "e": 68.52, "t": ">> وعائلتنا كبرت لملايين المتابعين."}, {"s": 71.44, "e": 74.64, "t": ">> أنتم الجهة الوحيدة"}, {"s": 78.96, "e": 80.68, "t": ">> لكن الموضوع ما كان بس عن [موسيقى]"}, {"s": 80.68, "e": 82.92, "t": "الأرقام."}, {"s": 82.92, "e": 85.6, "t": ">> اللي يتجاوز الشاشة ليمس حياة الناس."}, {"s": 85.6, "e": 87.68, "t": ">> وليوصل الأصوات اللي تستحق"}, {"s": 87.68, "e": 89.72, "t": ">> تستاهل نسمعها."}, {"s": 89.72, "e": 92.08, "t": ">> ما كان صوتي واصل للعالم، بس لما إيه جي"}, {"s": 92.08, "e": 93.84, "t": "بلس نشرت قصتي"}, {"s": 93.84, "e": 96.56, "t": ">> اختلفت حياته كلياً، ركب أطراف صناعية."}, {"s": 96.56, "e": 99.16, "t": ">> ما في زول كان عارف قصتي، فلقيت إيه جي"}, {"s": 99.16, "e": 100.68, "t": "بلس عملوا معانا اللقاء."}, {"s": 100.68, "e": 104.8, "t": ">> ونقلت قصتنا للعالم، وصلت صوتنا."}, {"s": 104.8, "e": 106.82, "t": ">> [موسيقى]"}, {"s": 116.6, "e": 121.37, "t": ">> نهاية قصص ضلينا في إيه جي بلس مستمرين."}, {"s": 123.01, "e": 124.81, "t": "وإلى الجيل الجديد. [موسيقى]"}, {"s": 124.81, "e": 128.65, "t": "وأنا اليوم عمري 19 سنة."}, {"s": 129.21, "e": 131.81, "t": "نحن شباب [موسيقى] اليوم."}, {"s": 131.81, "e": 134.93, "t": "احتياجاتنا تغيرت. وعاداتنا تغيرت."}, {"s": 134.93, "e": 135.45, "t": ">> [موسيقى]"}, {"s": 135.45, "e": 138.45, "t": ">> نريد أن نكون جزءاً من الحوار. وعلشان كذا"}, {"s": 138.45, "e": 141.89, "t": "في إيجي بلس تكيفنا."}, {"s": 142.05, "e": 144.37, "t": "نتكلم بلغته. [موسيقى]"}, {"s": 144.37, "e": 146.53, "t": "بصحب أصوات الناس اللي تثقوا فيهم ثاني."}, {"s": 146.53, "e": 149.21, "t": "صناع محتوى. أنتموا لهم."}, {"s": 149.21, "e": 151.17, "t": "من [موسيقى] مصر. من السودان. من غزة."}, {"s": 151.17, "e": 154.09, "t": "سوريا. تونس. ليبيا. الصومال. واشنطن دي."}, {"s": 154.09, "e": 156.13, "t": "سي. كولومبيا. بيرو."}, {"s": 156.13, "e": 158.57, "t": "إسبانيا. [موسيقى]"}, {"s": 159.61, "e": 162.01, "t": "في مدننا."}, {"s": 162.01, "e": 164.25, "t": "بنحكي القصص اللي بنعيشها. وبنسأل الأسئلة"}, {"s": 164.25, "e": 168.53, "t": "اللي بتشغلنا. وبأصواتنا نحن."}, {"s": 172.92, "e": 173.49, "t": ">> [موسيقى]"}, {"s": 173.49, "e": 176.21, "t": ">> العالم حوالينا دائماً بيتغير، لكن وعدنا"}, {"s": 176.21, "e": 178.77, "t": "نفضل دائماً قريبين."}, {"s": 178.77, "e": 181.49, "t": "من الفضول."}, {"s": 188.64, "e": 190.66, "t": ">> [موسيقى]"}]