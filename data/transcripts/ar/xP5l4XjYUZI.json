ى في بلدنا"}, {"s": 1581.44, "e": 1586.48, "t": "اوهايو اخوه كثيرين من من فلسطين"}, {"s": 1586.48, "e": 1586.8, "t": ">> ام"}, {"s": 1586.8, "e": 1590.72, "t": ">> واحيانا التقي اخوه من سوريا"}, {"s": 1590.72, "e": 1595.36, "t": "ولهجتهما مختلفان صحيح هو في سوريا نفسها"}, {"s": 1595.36, "e": 1598.0, "t": "في سوريا نفسها ستجد لهجات مختلفه في"}, {"s": 1598.0, "e": 1601.88, "t": "فلسطين ستجد لهجات مختلفه لكن بشكل عام"}, {"s": 1601.88, "e": 1604.84, "t": "يعني ما زالت اللهجات الشاميه متقاربه"}, {"s": 1604.84, "e": 1606.04, "t": ">> متقاربه ما شاء الله"}, {"s": 1606.04, "e": 1608.4, "t": ">> اه نعم يعني مثلا كيف حالك"}, {"s": 1608.4, "e": 1611.76, "t": ">> كيف حالك شلونك شو اخبارك هذه نقولها"}, {"s": 1611.76, "e": 1614.44, "t": ">> شلونك من العراق صحيح شلونك"}, {"s": 1614.44, "e": 1615.32, "t": ">> لا لحتى"}, {"s": 1615.32, "e": 1616.36, "t": ">> منرا"}, {"s": 1616.36, "e": 1618.48, "t": ">> ادولي نعم يا نعم"}, {"s": 1618.48, "e": 1622.76, "t": ">> نعم وهي وتستعمل في سوريا وتستعمل"}, {"s": 1622.76, "e": 1627.84, "t": "ايضا اييه في باقي البلدان المنتميه لبلاد"}, {"s": 1627.84, "e": 1631.0, "t": "الشام يعني هي بلاد الشام الطبيعيه يعني"}, {"s": 1631.0, "e": 1635.84, "t": "التي هي معروفه اييه فهذا صحيح حكيم ولكن"}, {"s": 1635.84, "e": 1640.48, "t": "لان عادات ومشتركه فعلا ما زالت الى الان"}, {"s": 1640.48, "e": 1644.32, "t": "اللهجه قريبه يعني قريبه من بعضها جدا"}, {"s": 1644.32, "e": 1648.16, "t": "ريجينا هل لديك اسئله للاصدقاء او ناديه"}, {"s": 1648.16, "e": 1652.4, "t": "او حليمه من من ترغب من ك في ان تتكلم"}, {"s": 1652.4, "e": 1653.96, "t": "تتفضل"}, {"s": 1653.96, "e": 1657.68, "t": ">> نعم ا انا يعني الان"}, {"s": 1657.68, "e": 1660.92, "t": "سمعت سوالك ايضا مره اخرى نعم"}, {"s": 1660.92, "e": 1663.68, "t": ">> انا اوافق"}, {"s": 1663.68, "e": 1668.56, "t": "اخي انريو ان ماذا قال اللغه العربيه انا"}, {"s": 1668.56, "e": 1672.6, "t": "مثله هو"}, {"s": 1673.48, "e": 1677.88, "t": "نعم مثله يعني بدات تعلم اللغه العربيه"}, {"s": 1677.88, "e": 1682.08, "t": "منذ اكثر من ثلاث سنوات"}, {"s": 1682.08, "e": 1686.76, "t": "والان انا اشعر بان"}, {"s": 1686.76, "e": 1689.36, "t": "تعلم اللغه العربيه"}, {"s": 1689.36, "e": 1692.44, "t": "هي هو صار"}, {"s": 1692.44, "e": 1697.92, "t": "عندي ان عندي يعني انا نعم كل يوم انا"}, {"s": 1697.92, "e": 1703.76, "t": "استمع الى الى يعني محاضرات"}, {"s": 1703.76, "e": 1706.0, "t": "اشاهد فيديو"}, {"s": 1706.0, "e": 1709.68, "t": "وكل كلام انت تتكلم يا استاذ انا اشاهد"}, {"s": 1709.68, "e": 1715.0, "t": "بكل رغبه بكل رغبه وا ادرس مع استاذ وفي"}, {"s": 1715.0, "e": 1720.76, "t": "يوم السبت ويوم الاحد ليس عندي فصل فصل"}, {"s": 1720.76, "e": 1727.48, "t": "فانا اشعر بالضيق يعني كان هناك شيء"}, {"s": 1727.48, "e": 1733.64, "t": "ليس موجود في حياتي انا نعم فيعني"}, {"s": 1733.64, "e": 1735.32, "t": "وان"}, {"s": 1735.32, "e": 1740.84, "t": "امسي كنت اشعر بصداع شديد فلكن هدرت الى"}, {"s": 1740.84, "e": 1743.68, "t": "الى الدرس وقلت"}, {"s": 1743.68, "e": 1746.76, "t": "كنت اشعر بصداء شديد"}, {"s": 1746.76, "e": 1749.56, "t": "انا لا اريد ان اترك الدرس درس لو انا"}, {"s": 1749.56, "e": 1753.72, "t": "استمع الى التسجيل ايضا فانا اشعر بان انا"}, {"s": 1753.72, "e": 1755.6, "t": "لا اتذوق"}, {"s": 1755.6, "e": 1759.48, "t": "الدرس انا لست موجوده في في نفسي"}, {"s": 1759.48, "e": 1763.24, "t": ">> اه اه نعم [ضحك] تحبين ان تعيشي الدرس حيا"}, {"s": 1763.24, "e": 1764.08, "t": "مباشره"}, {"s": 1764.08, "e": 1771.84, "t": ">> نعم نعم فلذلك انا انا اشاهد واستمع اليك"}, {"s": 1771.84, "e": 1773.68, "t": "بكل شوق"}, {"s": 1773.68, "e": 1774.88, "t": ">> وبكل رب"}, {"s": 1774.88, "e": 1778.44, "t": ">> بارك الله بك وهذا يسعدني شكرا"}, {"s": 1778.44, "e": 1781.88, "t": "ريجينا ايضا عادتها يعني ريجينا شيء"}, {"s": 1781.88, "e": 1785.76, "t": "ستحدثنا عنه وهي الاغاني الاغاني وهي تعزف"}, {"s": 1785.76, "e": 1791.04, "t": "طبعا ريجينا تعزف على الجيتار وتغني ايضا"}, {"s": 1791.04, "e": 1794.48, "t": "اغاني مع الاطفال العربي صحيح يا ريجينا"}, {"s": 1794.48, "e": 1798.24, "t": "امحاول نعم [ضحك]"}, {"s": 1798.24, "e": 1802.4, "t": ">> هذه عاده عندك الان"}, {"s": 1802.84, "e": 1806.6, "t": ">> احاول لانني حقا"}, {"s": 1806.6, "e": 1808.8, "t": "احب اللغه العربيه"}, {"s": 1808.8, "e": 1809.36, "t": ">> ام"}, {"s": 1809.36, "e": 1814.8, "t": ">> لكن ا نعم عندما اتكلم"}, {"s": 1814.8, "e": 1819.61, "t": "معكم انا الشاور انني لا استطي ان"}, {"s": 1822.28, "e": 1826.76, "t": ">> لا لا تشعور باطل تتكلمين بشكل جيد انا"}, {"s": 1826.76, "e": 1830.28, "t": "اقول لك كلامك جيد جدا تفضلي"}, {"s": 1830.28, "e": 1831.84, "t": ">> نعم"}, {"s": 1831.84, "e": 1837.88, "t": ">> ام وانا مثلكم ام انا اشاهد الفيديوهات"}, {"s": 1837.88, "e": 1841.12, "t": "بالعربيه كل يوم"}, {"s": 1841.12, "e": 1846.04, "t": ">> واغني باللغتي العربيه"}, {"s": 1846.32, "e": 1847.88, "t": ">> واتكلم"}, {"s": 1847.88, "e": 1849.64, "t": "بنفسي لانني"}, {"s": 1849.64, "e": 1852.28, "t": ">> مع نفسي اتكلم مع نفسي"}, {"s": 1852.28, "e": 1853.96, "t": ">> مع نفسي"}, {"s": 1853.96, "e": 1854.36, "t": ">> ام"}, {"s": 1854.36, "e": 1861.28, "t": ">> لانني لا اعرف هنا الناس الذين يتكلمون"}, {"s": 1861.28, "e": 1862.44, "t": "العربيه"}, {"s": 1862.44, "e": 1863.16, "t": ">> ام"}, {"s": 1863.16, "e": 1869.32, "t": ">> لا استطي ان امارس معهم اللغه العربيه هو"}, {"s": 1869.32, "e": 1871.88, "t": "هو ان شاء الله ريجينا الدرس اللقاء"}, {"s": 1871.88, "e": 1875.0, "t": "القادم ان شاء الله سيكون الجمعه القادمه"}, {"s": 1875.0, "e": 1877.72, "t": "سنتحدث عن الطريقه اليوميه مع اللغه"}, {"s": 1877.72, "e": 1880.44, "t": "العربيه كل شخص اتمنى منكم ان يحدثنا عن"}, {"s": 1880.44, "e": 1883.44, "t": "الطريقه اليوميه كي يستفيد المشاهدون ان"}, {"s": 1883.44, "e": 1885.96, "t": "شاء الله وحليمه الان شكرا لك ريجينا"}, {"s": 1885.96, "e": 1889.8, "t": "حليمه نختم معك بقي دقيقتان انت ما العاده"}, {"s": 1889.8, "e": 1893.24, "t": "التي تواض قلتي تواظبين على تعلم العلوم"}, {"s": 1893.24, "e": 1896.16, "t": "الفقهيه لكن هل لديك عاده اخرى الان"}, {"s": 1896.16, "e": 1900.6, "t": "تحاولين ان تعتاديها"}, {"s": 1902.8, "e": 1905.12, "t": ">> نعم اي"}, {"s": 1905.12, "e": 1907.28, "t": "من عاداتي"}, {"s": 1907.28, "e": 1909.2, "t": "فمثلي"}, {"s": 1909.2, "e": 1914.36, "t": "اخي عبد الحكيم انا احب القراءه بالقران"}, {"s": 1914.36, "e": 1915.28, "t": "الكريم"}, {"s": 1915.28, "e": 1915.8, "t": ">> اها"}, {"s": 1915.8, "e": 1917.68, "t": ">> في كل يوم"}, {"s": 1917.68, "e": 1918.12, "t": ">> نعم"}, {"s": 1918.12, "e": 1919.56, "t": ">> هذا من فضل الله سبحانه"}, {"s": 1919.56, "e": 1920.88, "t": ">> وتعالىميل"}, {"s": 1920.88, "e": 1924.04, "t": ">> وكذلك من عاداتي"}, {"s": 1924.04, "e": 1928.72, "t": ">> ان اكون كل يوم او كل ليله"}, {"s": 1928.72, "e": 1931.52, "t": "مع الدراسه او بالدراسه"}, {"s": 1931.52, "e": 1932.04, "t": ">> مع الدراسه"}, {"s": 1932.04, "e": 1933.28, "t": ">> قليلا ام كطيرا"}, {"s": 1933.28, "e": 1934.64, "t": ">> نعم الدراسه"}, {"s": 1934.64, "e": 1935.64, "t": ">> مع العلم يعني"}, {"s": 1935.64, "e": 1937.72, "t": ">> نعم مع طلب العلم صحيح"}, {"s": 1937.72, "e": 1942.4, "t": ">> اذا هذه عاده جميله اي كنا كنت ارغب ان"}, {"s": 1942.4, "e": 1944.4, "t": "تتكلمي اكثر اختي حليمه ان شاء الله في"}, {"s": 1944.4, "e": 1946.24, "t": "اللقاءات القادمه اتمنى ان يكون هذا"}, {"s": 1946.24, "e": 1949.64, "t": "اللقاء جميلا لكم لا اعرف انا انا اتكلم"}, {"s": 1949.64, "e": 1953.04, "t": "كثيرا فلا اعرف كيف تكون رده الفعل عندكم"}, {"s": 1953.04, "e": 1955.32, "t": "هل كان اللقاء جميلا اتمنى"}, {"s": 1955.32, "e": 1956.2, "t": "ان يكون كذلك"}, {"s": 1956.2, "e": 1958.96, "t": ">> جميلا جدا جميلا جدا يا استاذ"}, {"s": 1958.96, "e": 1963.76, "t": ">> اشكركم هذا يسعدك جدا وكما قلت لكم باذن"}, {"s": 1963.76, "e": 1966.52, "t": "الله الجمعه القادم لان هذا الشهر فقط هذا"}, {"s": 1966.52, "e": 1970.04, "t": "اول لقاء نحن قلنا كل شهر لقاءان بقي لقاء"}, {"s": 1970.04, "e": 1972.32, "t": "نختم به هذا الشهر الشهر السابع ان شاء"}, {"s": 1972.32, "e": 1975.44, "t": "الله في الجمعه القادمه جيد هذا اليوم جيد"}, {"s": 1975.44, "e": 1978.12, "t": "لكم جميعا صحيح يوم اعتبره"}, {"s": 1978.12, "e": 1981.08, "t": ">> ما رايك هل ترغبون"}, {"s": 1981.08, "e": 1985.36, "t": ">> شكرا يا استاذ شكرا لكم حياكم اذا نلتقي"}, {"s": 1985.36, "e": 1987.96, "t": "الجمعه القادمه الى اللقاء جميعا التمنيات"}, {"s": 1987.96, "e": 1993.08, "t": "لكم بيوم جميل وسعيد ونلتقي"}, {"s": 1993.08, "e": 1995.28, "t": ">> شكرا مع السلامه"}, {"s": 1995.28, "e": 1995.72, "t": "السلامه في"}, {"s": 1995.72, "e": 1997.88, "t": ">> امانسلام عليكم"}, {"s": 1997.88, "e": 2002.24, "t": ">> وعليكم السلام ورحمه ح"}]