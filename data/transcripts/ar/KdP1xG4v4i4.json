[{"s": 0.0, "e": 2.0, "t": "تيرارارا,"}, {"s": 2.0, "e": 6.16, "t": "واخطفي من الدنيا للفضاء. وأنا بخاف"}, {"s": 6.16, "e": 8.08, "t": "الملامة،"}, {"s": 8.08, "e": 12.84, "t": "وأنا بخاف الملامة، وأه من الملامة."}, {"s": 12.84, "e": 15.48, "t": "يا تركيا."}, {"s": 20.3, "e": 22.32, "t": ">> [موسيقى]"}, {"s": 26.44, "e": 29.16, "t": ">> تخيل إنك بتعوم في الشارع، وتتخيل ليه؟ في"}, {"s": 29.16, "e": 31.56, "t": "الريفيرا التركية تقدر تعملها. تحتنا"}, {"s": 31.56, "e": 33.52, "t": "بالظبط مكان [موسيقى] مش شبه أي مكان في"}, {"s": 33.52, "e": 36.04, "t": "الدنيا. مدينة كاملة تحت البحر المتوسط من"}, {"s": 36.04, "e": 37.52, "t": "2000 سنة."}, {"s": 37.52, "e": 40.28, "t": "مدينة فيها مينا كبير، ومسارح، وشوارع"}, {"s": 40.28, "e": 41.24, "t": "كاملة."}, {"s": 41.24, "e": 43.52, "t": "قريبة من السطح، والناس عايشين جنبها."}, {"s": 43.52, "e": 47.16, "t": "هنزل بالكاميرا، وتعالوا شوفوا معايا."}, {"s": 47.16, "e": 49.18, "t": ">> [موسيقى]"}, {"s": 52.04, "e": 53.92, "t": ">> قبل ما أغطس، كان لازم أجرب الكاياك"}, {"s": 53.92, "e": 58.16, "t": "الشفاف ده. وكأني بطير فوق التاريخ."}, {"s": 58.16, "e": 60.68, "t": "واللي تحتنا دي مدينة ليكيا، اللي اسمها"}, {"s": 60.68, "e": 63.36, "t": "معناه نور المعرفة."}, {"s": 63.36, "e": 65.96, "t": "شايفين السلم ده؟ نصه فوق الماية، ونصه"}, {"s": 65.96, "e": 69.08, "t": "تحت الماية. وكأن الماية بلعت نص التاريخ،"}, {"s": 69.08, "e": 71.39, "t": "وسابتلنا النص التاني يشهدله."}, {"s": 71.39, "e": 73.41, "t": ">> [موسيقى]"}, {"s": 75.32, "e": 77.16, "t": ">> وأنا طبعًا مش هفوت الفرصة إني أشوف"}, {"s": 77.16, "e": 80.16, "t": "المدينة الجميلة دي مع واحد من أهم علماء"}, {"s": 80.16, "e": 82.36, "t": "الآثار في تركيا. دكتور في جامعة البحر"}, {"s": 82.36, "e": 85.04, "t": "المتوسط، ورئيس التنقيب لكل المناطق"}, {"s": 85.04, "e": 87.76, "t": "التاريخية دي. عالم من 40 سنة اختار إنه"}, {"s": 87.76, "e": 90.32, "t": "يكتشف المدينة القديمة، يحافظ عليها،"}, {"s": 90.32, "e": 92.76, "t": "وينقل المعرفة للأجيال اللي جاية. أستاذ"}, {"s": 92.76, "e": 94.16, "t": "نوزات، مرحبًا."}, {"s": 94.16, "e": 94.76, "t": ">> مرحبًا. [ضحك]"}, {"s": 94.76, "e": 96.76, "t": ">> إيه اللي خلاك تقع في حب الآثار؟"}, {"s": 96.76, "e": 99.48, "t": ">> Türkiye sevdasına herkes gibi arkeoloji"}, {"s": 99.48, "e": 101.48, "t": "merakı nedeniyle elbette düştüm. Ama"}, {"s": 101.48, "e": 103.68, "t": "arkeolojiyle tanıştıktan sonra oradaki"}, {"s": 103.68, "e": 106.0, "t": "bulduğunuz objeler çok olağanüstü"}, {"s": 106.0, "e": 107.92, "t": "şeyler. Tarihin karanlıklarından gelip"}, {"s": 107.92, "e": 109.88, "t": "oradan aydınlıklar bize taşıyan"}, {"s": 109.88, "e": 112.24, "t": "objelerle tanıştıkça ve onlarla"}, {"s": 112.24, "e": 114.52, "t": "konuştukça sevdamız daha da arttı tabii."}, {"s": 114.52, "e": 117.52, "t": "Arkeolojide biz objenin peşinde değiliz."}, {"s": 117.52, "e": 119.96, "t": "Obje bir anlamsız bir şey. Ama o objenin"}, {"s": 119.96, "e": 121.83, "t": "taşıdığı bilgi yetinin peşindeyiz"}, {"s": 123.61, "e": 125.93, "t": ">> عشان نحافظ على الآثار الغطس ممنوع في"}, {"s": 125.93, "e": 129.21, "t": "كاش. لكن في مدينة قريبة جدا اسمها كاش"}, {"s": 129.21, "e": 132.21, "t": "جنة الغطاسين."}, {"s": 132.85, "e": 135.93, "t": "سحر غريب. وكأنك واقف على الخط الفاصل بين"}, {"s": 135.93, "e": 137.17, "t": "زمنين."}, {"s": 137.17, "e": 139.57, "t": "فوق المية في إنسان عايش يومه عادي. وفي"}, {"s": 139.57, "e": 142.37, "t": "نفس المكان تحت المية في إنسان ثاني عايش"}, {"s": 142.37, "e": 143.93, "t": "من 2000 سنة."}, {"s": 143.93, "e": 147.29, "t": "سابلنا بيوته ورسايله وسلمه. حضارة تحت"}, {"s": 147.29, "e": 150.05, "t": "المية وحضارة فوق المية والاثنين بيتنفسوا"}, {"s": 150.05, "e": 151.69, "t": "في نفس المكان."}, {"s": 151.69, "e": 154.53, "t": "واقفين سوا يصوروا."}, {"s": 158.51, "e": 160.53, "t": ">> [موسيقى]"}, {"s": 240.09, "e": 242.73, "t": ">> مية وحضارة فوق المية والاثنين بيتنفسوا"}, {"s": 242.73, "e": 244.37, "t": "في نفس المكان."}, {"s": 244.37, "e": 247.53, "t": "واقفين سوا يفكرونا إن القصة مستمرة وإننا"}, {"s": 247.53, "e": 249.97, "t": "مش أول ناس نعيش على الأرض وأكيد مش آخر"}, {"s": 249.97, "e": 252.33, "t": "ناس."}, {"s": 256.11, "e": 258.13, "t": ">> [موسيقى]"}, {"s": 261.97, "e": 263.97, "t": ">> ما ينفعش أشوف الجمال ده كله وما أطلعش"}, {"s": 263.97, "e": 265.93, "t": "أعمل باراسيلينج."}, {"s": 265.93, "e": 267.93, "t": ">> [موسيقى]"}, {"s": 267.93, "e": 270.49, "t": ">> لا لا"}, {"s": 271.17, "e": 272.33, "t": ">> [موسيقى]"}, {"s": 272.33, "e": 275.17, "t": ">> تركيا من فوق حلوة ومن تحت حلوة ومن الجنب"}, {"s": 275.17, "e": 279.65, "t": "حلوة ومن الجنب الثاني حلوة، في إيه؟"}, {"s": 279.65, "e": 281.73, "t": "اكتشفت في آخر الرحلة إن المتعة الحقيقية"}, {"s": 281.73, "e": 284.37, "t": "للسفر مش إن احنا نشوف أماكن لكن إن احنا"}, {"s": 284.37, "e": 287.97, "t": "نعرف القصة كاملة. قصة الإنسان. لو القصة"}, {"s": 287.97, "e": 290.93, "t": "دي غيرت مفهومك عن السفر ابعت الفيديو ده"}, {"s": 290.93, "e": 293.61, "t": "لصاحبك أو صاحبتك اللي نفسك تعمله مع بعض"}, {"s": 293.61, "e": 296.33, "t": "مغامرات."}, {"s": 300.65, "e": 302.67, "t": ">> [موسيقى]"}]