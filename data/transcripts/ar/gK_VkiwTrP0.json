[{"s": 0.93, "e": 2.75, "t": "هل تعرفون ما هو أول"}, {"s": 2.75, "e": 4.9, "t": "حديث للصح بكر؟ هل"}, {"s": 4.9, "e": 6.37, "t": "ترغبون في فهم هذا"}, {"s": 6.37, "e": 8.29, "t": "الحديث؟ إن شاء الله،"}, {"s": 8.29, "e": 10.15, "t": "في درس اليوم، سنتعلم"}, {"s": 10.15, "e": 11.77, "t": "هذا الحديث باللغة"}, {"s": 11.77, "e": 14.64, "t": "العربية، وفي النهاية"}, {"s": 15.01, "e": 16.99, "t": "سنفهمه كما ورد باللغة"}, {"s": 16.99, "e": 20.41, "t": "الإنجليزية. هيا بنا"}, {"s": 20.41, "e": 24.27, "t": "نبدأ. عليّ أن أجلس هنا"}, {"s": 24.27, "e": 27.02, "t": "لتتمكنوا من رؤية أن"}, {"s": 29.41, "e": 34.04, "t": "هذا الحديث مروي عن"}, {"s": 34.04, "e": 36.16, "t": "النبي صلى الله عليه"}, {"s": 36.16, "e": 43.3, "t": "وسلم، قال عمر: سمعت"}, {"s": 43.3, "e": 45.44, "t": "النبي صلى الله عليه"}, {"s": 45.44, "e": 72.4, "t": "وسلم يقول: \"كيف تفهمون"}, {"s": 72.4, "e": 81.41, "t": "هذا؟ كلمة\" أنا \"تعني\""}, {"s": 81.41, "e": 91.63, "t": "لا شيء إلا \"أو\" فقط \"."}, {"s": 95.43, "e": 98.03, "t": "فلنستخدمها في جملة."}, {"s": 98.03, "e": 100.04, "t": "تقول:\" كيف حالك؟ \""}, {"s": 100.04, "e": 105.18, "t": "فأقول:\" أنا لست إلا"}, {"s": 105.18, "e": 107.65, "t": "طالبًا \". أو يقول"}, {"s": 107.65, "e": 109.62, "t": "أحدهم:\" لا تُعلّمني،"}, {"s": 109.62, "e": 111.44, "t": "فأنت لست أبي، ولست"}, {"s": 111.44, "e": 113.84, "t": "معلمي \". فأقول:\" أنا"}, {"s": 113.84, "e": 116.73, "t": "مجرد صديقك، أنا لست"}, {"s": 116.73, "e": 120.46, "t": "إلا صديقك \".\" إذن، \"\"[لا"}, {"s": 120.46, "e": 122.48, "t": "تعني] شيئًا سوى \"فقط\"[]"}, {"s": 122.48, "e": 124.44, "t": "\"فقط،\" كل هذه الكلمات"}, {"s": 124.44, "e": 129.17, "t": "الإنجليزية. ثم، \"al\"[ما]"}, {"s": 131.47, "e": 135.59, "t": "هو، هو جمع الذي هو \""}, {"s": 135.59, "e": 142.05, "t": "أفعال.\" إذن، في الواقع"}, {"s": 142.05, "e": 147.94, "t": "، الأفعال أولاً وقبل"}, {"s": 147.94, "e": 155.1, "t": "كل شيء هي مع، إنها سيد"}, {"s": 155.1, "e": 159.41, "t": "الأفعال. إذن، الفعل"}, {"s": 159.41, "e": 164.03, "t": "هو، وماذا يعني عندما"}, {"s": 164.03, "e": 168.86, "t": "تقول يني؟ إذن ما هو"}, {"s": 168.86, "e": 177.4, "t": "نوح؟ نوح يني. إذن، يني"}, {"s": 177.4, "e": 179.01, "t": "أيضًا يعني أن يكون"}, {"s": 179.01, "e": 181.37, "t": "لديك نية لفعل شيء ما."}, {"s": 181.37, "e": 184.35, "t": "لذلك يمكنك أن تقول"}, {"s": 185.29, "e": 187.32, "t": "لدي نية للسفر كما"}, {"s": 187.32, "e": 189.64, "t": "أريد، أنا أخطط. إذن،"}, {"s": 189.64, "e": 195.64, "t": "التخطيط هو أيضًا نية"}, {"s": 196.96, "e": 206.28, "t": "وهو جمع نية. إذن، لا"}, {"s": 206.28, "e": 207.84, "t": "شيء سوى الأفعال مع"}, {"s": 207.84, "e": 211.07, "t": "النية. لذلك في اللغة"}, {"s": 211.07, "e": 213.13, "t": "الإنجليزية، لا تقول"}, {"s": 213.13, "e": 215.3, "t": "ذلك، بل تقول: الأفعال"}, {"s": 215.3, "e": 218.85, "t": "هي مع لا شيء سوى"}, {"s": 218.85, "e": 222.55, "t": "النوايا. إذن، الأفعال"}, {"s": 222.55, "e": 225.34, "t": "فقط هي مع النوايا. ثم"}, {"s": 225.34, "e": 227.19, "t": "يقول النبي صلى الله"}, {"s": 227.19, "e": 238.62, "t": "عليه وسلم: \"نفس الشيء"}, {"s": 238.62, "e": 243.47, "t": "فقط، لا شيء سوى هو كل\"."}, {"s": 243.47, "e": 249.06, "t": "إذن، يعني لـ. لذلك إذا"}, {"s": 249.06, "e": 255.56, "t": "قلتَ: سيكون لكل، لكل،"}, {"s": 255.56, "e": 263.4, "t": "و هو رجل. إذن هي امرأة"}, {"s": 263.4, "e": 269.82, "t": "و هو رجل، يعني لكل رجل"}, {"s": 269.82, "e": 279.05, "t": ". ما خطط له نوح له نية."}, {"s": 280.0, "e": 285.77, "t": "إذن، الرجل لا يحصل"}, {"s": 285.77, "e": 287.59, "t": "إلا على ما كانت لديه"}, {"s": 287.59, "e": 297.31, "t": "نية له. إذن، هو فقط ما"}, {"s": 297.31, "e": 299.39, "t": "كانت لديه نية له، أو"}, {"s": 299.39, "e": 301.31, "t": "نعم، الرجل لن يحصل"}, {"s": 301.31, "e": 303.4, "t": "إلا على ما كانت لديه"}, {"s": 303.4, "e": 311.4, "t": "نية له. ثم النبي يقول"}, {"s": 311.4, "e": 320.63, "t": "صلى الله عليه وسلم إن"}, {"s": 320.63, "e": 322.23, "t": "الهجرة من مكة إلى"}, {"s": 322.23, "e": 337.66, "t": "المدينة هي هجرة من"}, {"s": 340.49, "e": 370.71, "t": "كان إلى من. فالهجرة"}, {"s": 370.71, "e": 489.46, "t": "تعني من كان، ومن..."}, {"s": 503.8, "e": 505.56, "t": "كنتُ أفضل لو فعلتُ"}, {"s": 505.56, "e": 507.47, "t": "ذلك باللغة العربية،"}, {"s": 507.47, "e": 509.02, "t": "لكن ليس كل الناس"}, {"s": 509.02, "e": 511.52, "t": "يفهمون ما أقوله."}, {"s": 512.76, "e": 514.37, "t": "ولديّ أيضًا ملاحظة"}, {"s": 514.37, "e": 516.12, "t": "سأكتبها في التعليقات"}, {"s": 516.12, "e": 517.77, "t": "، لذا يُرجى الاطلاع"}, {"s": 517.77, "e": 519.28, "t": "عليها."}]