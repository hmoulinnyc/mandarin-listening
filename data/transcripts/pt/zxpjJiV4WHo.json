2, "t": ">> Nunca."}, {"s": 1160.2, "e": 1163.88, "t": ">> Você já viajou pro Japão?"}, {"s": 1163.88, "e": 1164.88, "t": ">> Nunca."}, {"s": 1164.88, "e": 1166.44, "t": ">> Nunca."}, {"s": 1166.44, "e": 1168.8, "t": "Eu nunca viajei"}, {"s": 1168.8, "e": 1172.2, "t": "pra China. Eu sou brasileiro e não"}, {"s": 1172.2, "e": 1174.52, "t": "desisto nunca."}, {"s": 1174.52, "e": 1176.48, "t": ">> 47."}, {"s": 1176.48, "e": 1178.4, "t": "Hoje,"}, {"s": 1178.4, "e": 1181.0, "t": "hoje é"}, {"s": 1181.0, "e": 1183.8, "t": ">> quarta-feira. [risadas] Quarta-feira."}, {"s": 1183.8, "e": 1184.8, "t": ">> Hoje é quarta-feira."}, {"s": 1184.8, "e": 1187.32, "t": ">> Hoje é dia de gravação."}, {"s": 1187.32, "e": 1189.04, "t": "48."}, {"s": 1189.04, "e": 1190.6, "t": "Ontem."}, {"s": 1190.6, "e": 1191.76, "t": ">> Hum."}, {"s": 1191.76, "e": 1193.92, "t": ">> Ontem foi terça-feira."}, {"s": 1193.92, "e": 1198.12, "t": ">> Ontem choveu o dia inteiro."}, {"s": 1198.12, "e": 1199.36, "t": ">> Sim."}, {"s": 1199.36, "e": 1201.0, "t": "49."}, {"s": 1201.0, "e": 1203.16, "t": "Amanhã."}, {"s": 1203.16, "e": 1207.6, "t": "Amanhã não vai chover. Por favor."}, {"s": 1207.6, "e": 1210.32, "t": ">> O que você vai fazer amanhã?"}, {"s": 1210.32, "e": 1214.28, "t": ">> Amanhã é dia de edição. Então eu vou"}, {"s": 1214.28, "e": 1218.0, "t": "sentar na frente do computador e editar"}, {"s": 1218.0, "e": 1222.04, "t": "vídeo para vocês. E [roncando] você, o"}, {"s": 1222.04, "e": 1224.52, "t": "que você vai fazer amanhã?"}, {"s": 1224.52, "e": 1228.28, "t": "Amanhã eu tenho meditação às 9 horas da"}, {"s": 1228.28, "e": 1228.76, "t": "manhã."}, {"s": 1228.76, "e": 1232.48, "t": ">> Hum. E você, o que você vai fazer"}, {"s": 1232.48, "e": 1234.36, "t": "amanhã?"}, {"s": 1234.36, "e": 1237.88, "t": "Palavra 50. Chegamos."}, {"s": 1237.88, "e": 1239.92, "t": ">> 50."}, {"s": 1239.92, "e": 1242.16, "t": ">> Não é a palavra, não é chegamos, a"}, {"s": 1242.16, "e": 1245.16, "t": "palavra é agora."}, {"s": 1245.16, "e": 1246.92, "t": ">> Agora. [limpando a garganta]"}, {"s": 1246.92, "e": 1250.56, "t": ">> O que você vai fazer agora?"}, {"s": 1250.56, "e": 1254.28, "t": "Agora você vai pegar todas essas"}, {"s": 1254.28, "e": 1257.28, "t": "palavras e escrever"}, {"s": 1257.28, "e": 1260.84, "t": "50 frases nos comentários."}, {"s": 1260.84, "e": 1263.64, "t": ">> Uau!"}, {"s": 1263.64, "e": 1266.8, "t": "Uma tarefa gigante. Você não vai"}, {"s": 1266.8, "e": 1269.92, "t": "terminar isso agora. As vai demorar um"}, {"s": 1269.92, "e": 1274.96, "t": "pouquinho. As 50 tarefas de Hércules"}, {"s": 1274.96, "e": 1276.44, "t": "não eram sete,"}, {"s": 1276.44, "e": 1279.6, "t": ">> acho que eram 12. 12 12 trabalhos de"}, {"s": 1279.6, "e": 1283.48, "t": "Hércules, só que agora vão ser 50. E eu"}, {"s": 1283.48, "e": 1286.0, "t": "posso dar uma dica, porque eu lembro que"}, {"s": 1286.0, "e": 1288.72, "t": "quando eu comecei a estudar grego, eu"}, {"s": 1288.72, "e": 1292.04, "t": "peguei essas 50 palavras básicas do"}, {"s": 1292.04, "e": 1295.44, "t": "grego e eu ficava procurando onde que"}, {"s": 1295.44, "e": 1299.4, "t": "elas apareciam nos vídeos do Easy Greek."}, {"s": 1299.4, "e": 1302.16, "t": "Então vocês podem fazer a mesma coisa."}, {"s": 1302.16, "e": 1305.64, "t": "Assistam os nossos vídeos de entrevistas"}, {"s": 1305.64, "e": 1308.08, "t": "e vejam onde que essas palavras"}, {"s": 1308.08, "e": 1311.2, "t": "aparecem. Você não precisa fazer isso"}, {"s": 1311.2, "e": 1312.12, "t": "sozinho."}, {"s": 1312.12, "e": 1312.56, "t": ">> Hum."}, {"s": 1312.56, "e": 1314.44, "t": ">> Oportuguerece"}, {"s": 1314.44, "e": 1317.12, "t": "suporte para vocês, com a nossa"}, {"s": 1317.12, "e": 1321.12, "t": "comunidade. Então, para que você aprenda"}, {"s": 1321.12, "e": 1323.4, "t": "e para que esse trabalho continue, eu"}, {"s": 1323.4, "e": 1325.88, "t": "peço a você que você se torne um membro."}, {"s": 1325.88, "e": 1328.08, "t": "Não fica fazendo as coisas sozinho, não."}, {"s": 1328.08, "e": 1330.6, "t": "Tem muita gente que, como você também tá"}, {"s": 1330.6, "e": 1332.44, "t": "aprendendo português e a gente reúne"}, {"s": 1332.44, "e": 1334.24, "t": "essas pessoas na comunidade."}, {"s": 1334.24, "e": 1337.28, "t": ">> Então, esperamos você num próximo vídeo"}, {"s": 1337.28, "e": 1339.48, "t": "e até mais."}, {"s": 1339.48, "e": 1340.96, "t": "Beijo e tchau."}, {"s": 1340.96, "e": 1341.84, "t": ">> Tchau."}, {"s": 1341.84, "e": 1346.04, "t": ">> Nesse vídeo, nesse vídeo, nesse vídeo,"}, {"s": 1346.24, "e": 1348.6, "t": ">> nesse vídeo,"}, {"s": 1348.6, "e": 1349.4, "t": ">> nesse vídeo,"}, {"s": 1349.4, "e": 1350.4, "t": ">> nesse vídeo,"}, {"s": 1350.4, "e": 1350.96, "t": ">> nesse vídeo,"}, {"s": 1350.96, "e": 1352.92, "t": ">> nesse vídeo,"}, {"s": 1352.92, "e": 1356.44, "t": ">> nesse vídeo."}, {"s": 1358.12, "e": 1358.6, "t": ">> Tudo bem,"}, {"s": 1358.6, "e": 1360.0, "t": ">> tudo bem. É isso."}, {"s": 1360.0, "e": 1362.52, "t": ">> É isso."}]