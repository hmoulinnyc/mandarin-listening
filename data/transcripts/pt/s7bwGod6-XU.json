[{"s": 0.32, "e": 1.44, "t": "Olá."}, {"s": 1.44, "e": 4.24, "t": "Bem-vindo ou bem-vinda ao Portuguese"}, {"s": 4.24, "e": 5.24, "t": "Tune."}, {"s": 5.24, "e": 9.12, "t": "Hoje eu vou contar-te uma história."}, {"s": 9.12, "e": 12.8, "t": "Vou-te contar uma história escrita pelos"}, {"s": 12.8, "e": 14.48, "t": "irmãos Grimm."}, {"s": 14.48, "e": 16.08, "t": "Vamos começar."}, {"s": 16.08, "e": 19.04, "t": "O Flautista de Hamelin."}, {"s": 19.04, "e": 22.56, "t": "Há muito, muito tempo,"}, {"s": 22.56, "e": 26.88, "t": "na cidade de Hamelin, numa bela manhã,"}, {"s": 26.88, "e": 30.8, "t": "os seus habitantes encontraram a cidade"}, {"s": 30.8, "e": 33.48, "t": "repleta de ratos"}, {"s": 33.48, "e": 36.2, "t": "famintos que devoravam"}, {"s": 36.2, "e": 38.64, "t": "toda a comida disponível."}, {"s": 38.64, "e": 41.88, "t": "Como a cada dia que passava os ratos se"}, {"s": 41.88, "e": 43.68, "t": "multiplicavam,"}, {"s": 43.68, "e": 47.6, "t": "os moradores desesperados reuniram-se,"}, {"s": 47.6, "e": 50.64, "t": "né? Os moradores reuniram-se"}, {"s": 50.64, "e": 54.6, "t": "e decidiram oferecer um pote de ouro a"}, {"s": 54.6, "e": 58.72, "t": "quem acabasse com aquela terrível praga."}, {"s": 58.72, "e": 62.88, "t": "Logo chegou à cidade um flautista que"}, {"s": 62.88, "e": 64.2, "t": "lhes disse:"}, {"s": 64.2, "e": 65.8, "t": "\"O ouro"}, {"s": 65.8, "e": 67.48, "t": "será meu."}, {"s": 67.48, "e": 71.68, "t": "Esta noite não haverá um só rato em"}, {"s": 71.68, "e": 75.52, "t": "Hamelin.\" O flautista pegou então na sua"}, {"s": 75.52, "e": 76.72, "t": "flauta"}, {"s": 76.72, "e": 81.44, "t": "e saiu pelas ruas de Hamelin"}, {"s": 81.44, "e": 86.52, "t": "entuando uma linda melodia que encantava"}, {"s": 86.52, "e": 89.08, "t": "os ratos. Todos ficavam assim:"}, {"s": 89.08, "e": 90.2, "t": ">> [suspirando]"}, {"s": 90.2, "e": 93.76, "t": ">> O flautista pegou então na sua flauta e"}, {"s": 93.76, "e": 96.72, "t": "saiu pelas ruas de Hamelin entoando uma"}, {"s": 96.72, "e": 101.16, "t": "linda melodia que encantava os ratos e"}, {"s": 101.16, "e": 104.88, "t": "fazia com que todos o seguissem pelas"}, {"s": 104.88, "e": 108.0, "t": "ruas de Hamelin."}, {"s": 108.0, "e": 112.24, "t": "O flautista foi tocando e caminhando"}, {"s": 112.24, "e": 116.56, "t": "para fora da cidade, sempre seguido"}, {"s": 116.56, "e": 120.64, "t": "pelos ratos, até que chegou a um grande"}, {"s": 120.64, "e": 121.68, "t": "rio."}, {"s": 121.68, "e": 125.88, "t": "Sem parar de tocar, atravessou"}, {"s": 125.88, "e": 129.12, "t": "o rio e os ratos,"}, {"s": 129.12, "e": 133.16, "t": "seguindo-o, acabaram por morrer"}, {"s": 133.16, "e": 134.56, "t": "afogados."}, {"s": 134.56, "e": 136.72, "t": "No dia seguinte,"}, {"s": 136.72, "e": 138.92, "t": "o flautista foi falar com os"}, {"s": 138.92, "e": 143.04, "t": "responsáveis pela cidade para receber a"}, {"s": 143.04, "e": 145.8, "t": "recompensa devida."}, {"s": 145.8, "e": 149.72, "t": "Porém, o conselho da cidade achava que"}, {"s": 149.72, "e": 152.52, "t": "não devia pagar uma fortuna quando o"}, {"s": 152.52, "e": 155.68, "t": "flautista apenas se limitara a tocar a"}, {"s": 155.68, "e": 161.28, "t": "sua flauta e decidiu não lhe pagar."}, {"s": 161.28, "e": 164.76, "t": "E agora, o que é que acontece a seguir?"}, {"s": 164.76, "e": 168.52, "t": "Furioso, furioso pela avareza e"}, {"s": 168.52, "e": 170.32, "t": "ingratidão"}, {"s": 170.32, "e": 173.8, "t": "dos habitantes de Hamelin, o flautista,"}, {"s": 173.8, "e": 176.88, "t": "da mesma forma que fizera no dia"}, {"s": 176.88, "e": 178.16, "t": "anterior,"}, {"s": 178.16, "e": 181.68, "t": "tocou uma doce melodia."}, {"s": 181.68, "e": 185.56, "t": "Tu tu tu tu tu. Tocou uma doce melodia"}, {"s": 185.56, "e": 189.64, "t": "uma e outra vez, insistentemente."}, {"s": 189.64, "e": 190.92, "t": "Porém,"}, {"s": 190.92, "e": 195.16, "t": "agora, desta vez, não eram os ratos que"}, {"s": 195.16, "e": 196.92, "t": "o seguiam,"}, {"s": 196.92, "e": 201.16, "t": "mas sim as crianças da cidade,"}, {"s": 201.16, "e": 205.04, "t": "que, arrebatadas, não é, tipo zumbis."}, {"s": 205.04, "e": 205.92, "t": "Ah!"}, {"s": 205.92, "e": 208.56, "t": "Uau! Uau!"}, {"s": 208.56, "e": 213.04, "t": "Arrebatadas por aquele som maravilhoso,"}, {"s": 213.04, "e": 218.04, "t": "iam atrás dos passos do estranho músico."}, {"s": 218.04, "e": 221.44, "t": "De mãos dadas e sorridentes, formavam"}, {"s": 221.44, "e": 223.48, "t": "uma grande fila,"}, {"s": 223.48, "e": 225.2, "t": "surda"}, {"s": 225.2, "e": 229.92, "t": "aos pedidos e gritos de seus pais. Não,"}, {"s": 229.92, "e": 233.16, "t": "por favor! Formavam uma grande fila,"}, {"s": 233.16, "e": 236.76, "t": "surda aos pedidos e gritos de seus pais"}, {"s": 236.76, "e": 237.6, "t": "que,"}, {"s": 237.6, "e": 239.04, "t": "em vão,"}, {"s": 239.04, "e": 240.36, "t": "sem hipótese,"}, {"s": 240.36, "e": 243.52, "t": "em vão, entre soluços de desespero,"}, {"s": 243.52, "e": 245.72, "t": "tentavam impedir que as crianças"}, {"s": 245.72, "e": 248.52, "t": "seguissem o flautista."}, {"s": 248.52, "e": 252.24, "t": "As crianças nunca mais apareceram"}, {"s": 252.24, "e": 255.48, "t": "e a cidade de Hamelin ficou para sempre"}, {"s": 255.48, "e": 257.76, "t": "triste e"}, {"s": 257.76, "e": 259.52, "t": "silenciosa."}, {"s": 259.52, "e": 263.12, "t": "E, por mais que se procure, nunca lá se"}, {"s": 263.12, "e": 268.24, "t": "encontra nenhum rato, nem uma criança."}, {"s": 268.24, "e": 270.16, "t": "Vitória, vitória,"}, {"s": 270.16, "e": 272.24, "t": "acabou-se a história."}, {"s": 272.24, "e": 275.72, "t": "Esta foi a história do flautista de"}, {"s": 275.72, "e": 276.96, "t": "Hamelin."}, {"s": 276.96, "e": 278.44, "t": "Parabéns!"}, {"s": 278.44, "e": 280.72, "t": "Parabéns por ter chegado ao final deste"}, {"s": 280.72, "e": 283.6, "t": "vídeo. Eu espero que tu tenhas gostado"}, {"s": 283.6, "e": 287.44, "t": "do vídeo e, se gostaste, dá um gosto."}, {"s": 287.44, "e": 289.36, "t": "Até à próxima. Lembra-te que tu"}, {"s": 289.36, "e": 291.64, "t": "consegues alcançar qualquer objetivo,"}, {"s": 291.64, "e": 294.88, "t": "OK? Acredita em ti. Até à próxima."}, {"s": 294.88, "e": 297.6, "t": "Tchau, tchau."}]