[{"s": 0.0, "e": 3.44, "t": "Todas as pessoas, uma vez na vida, pelo"}, {"s": 3.44, "e": 6.88, "t": "menos, adiaram alguma coisa que era"}, {"s": 6.88, "e": 10.04, "t": "muito importante para fazer alguma coisa"}, {"s": 10.04, "e": 12.45, "t": "que não tinha importância nenhuma."}, {"s": 12.45, "e": 12.72, "t": ">> [roncando]"}, {"s": 12.72, "e": 15.72, "t": ">> Procrastinação."}, {"s": 15.92, "e": 17.56, "t": "Se você"}, {"s": 17.56, "e": 19.64, "t": "tá deixando o seu estudo de português de"}, {"s": 19.64, "e": 20.92, "t": "lado"}, {"s": 20.92, "e": 23.72, "t": "para fazer alguma coisa que"}, {"s": 23.72, "e": 25.64, "t": "vale a pena naquele momento, é"}, {"s": 25.64, "e": 28.56, "t": "gostosinho, mas que depois"}, {"s": 28.56, "e": 30.88, "t": "não tem importância nenhuma,"}, {"s": 30.88, "e": 32.75, "t": "esse vídeo é para você."}, {"s": 32.75, "e": 33.2, "t": ">> [roncando]"}, {"s": 33.2, "e": 35.24, "t": ">> Então vamos lá que eu tô curioso. A"}, {"s": 35.24, "e": 38.28, "t": "gente vai falar sobre as causas da"}, {"s": 38.28, "e": 39.8, "t": "procrastinação"}, {"s": 39.8, "e": 42.52, "t": "e conversar também sobre estratégias"}, {"s": 42.52, "e": 46.92, "t": "para que você evite isso."}, {"s": 46.92, "e": 50.56, "t": "Curte o vídeo e vamos lá."}, {"s": 51.74, "e": 53.77, "t": ">> [música]"}, {"s": 54.44, "e": 56.36, "t": ">> Vamos começar?"}, {"s": 56.36, "e": 57.6, "t": "Uma hora tem que começar."}, {"s": 57.6, "e": 59.32, "t": ">> que eu tenho que ir ali fazer um café."}, {"s": 59.32, "e": 61.8, "t": "Pera aí."}, {"s": 62.52, "e": 64.8, "t": ">> Você quer água? Tudo bem."}, {"s": 64.8, "e": 66.72, "t": ">> Acho que aguinha. Você vai ficar"}, {"s": 66.72, "e": 67.6, "t": ">> né? É bom."}, {"s": 67.6, "e": 68.68, "t": ">> Você vai fazer café mesmo?"}, {"s": 68.68, "e": 70.72, "t": ">> Faço um café, faço um chá e depois a"}, {"s": 70.72, "e": 71.6, "t": "gente começa."}, {"s": 71.6, "e": 73.12, "t": ">> Chá eu não vou querer."}, {"s": 73.12, "e": 73.68, "t": "Só água."}, {"s": 73.68, "e": 75.56, "t": ">> Mas é bom fazer um chá, né? Vai que"}, {"s": 75.56, "e": 78.92, "t": "chega alguém, a gente faz um chá e"}, {"s": 78.92, "e": 81.12, "t": "não, não, não, não, faz não."}, {"s": 81.12, "e": 81.88, "t": "Não."}, {"s": 81.88, "e": 82.04, "t": ">> [grito]"}, {"s": 82.04, "e": 86.16, "t": ">> Vou pegar a água. Depois prende a porta."}, {"s": 86.16, "e": 87.44, "t": ">> Tá bom."}, {"s": 87.44, "e": 89.2, "t": ">> Procrastinação"}, {"s": 89.2, "e": 91.8, "t": "é quando a gente adia uma coisa"}, {"s": 91.8, "e": 93.36, "t": "importante"}, {"s": 93.36, "e": 95.36, "t": "sem um motivo"}, {"s": 95.36, "e": 98.0, "t": "realmente importante."}, {"s": 98.0, "e": 99.8, "t": "Eu gosto."}, {"s": 99.8, "e": 102.52, "t": "Faz sentido para você?"}, {"s": 102.52, "e": 104.8, "t": ">> Ah, faz, mas você gosta de"}, {"s": 104.8, "e": 106.0, "t": "procrastinação?"}, {"s": 106.0, "e": 107.92, "t": ">> Eu gosto da definição."}, {"s": 107.92, "e": 111.16, "t": ">> Ah, da definição, OK."}, {"s": 111.16, "e": 114.0, "t": "Mas eu diria que às vezes o motivo ele"}, {"s": 114.0, "e": 114.8, "t": "está"}, {"s": 114.8, "e": 117.24, "t": "é, tá aparente aí."}, {"s": 117.24, "e": 119.2, "t": "A gente às vezes sabe porque tá"}, {"s": 119.2, "e": 122.0, "t": "procrastinando e continua procrastinando"}, {"s": 122.0, "e": 124.0, "t": "mesmo assim."}, {"s": 124.0, "e": 125.56, "t": "Hum."}, {"s": 125.56, "e": 127.32, "t": "Fale mais."}, {"s": 127.32, "e": 128.72, "t": "Eu vou trazer para as minhas"}, {"s": 128.72, "e": 130.24, "t": "experiências."}, {"s": 130.24, "e": 131.76, "t": "Normalmente,"}, {"s": 131.76, "e": 134.84, "t": "eu não faço alguma coisa"}, {"s": 134.84, "e": 138.12, "t": "por causa de dificuldades."}, {"s": 138.12, "e": 139.24, "t": "Então, quando eu tenho alguma"}, {"s": 139.24, "e": 142.32, "t": "dificuldade, eu tenho uma tendência a"}, {"s": 142.32, "e": 144.08, "t": "não querer"}, {"s": 144.08, "e": 147.92, "t": "mexer com aquilo. E aí eu 