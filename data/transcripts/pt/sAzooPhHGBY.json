[{"s": 0.44, "e": 2.68, "t": "Você sabe como falar em português no dia"}, {"s": 2.68, "e": 4.92, "t": "a dia no Brasil?"}, {"s": 4.92, "e": 6.8, "t": "Como"}, {"s": 6.8, "e": 9.2, "t": "pegar um ônibus ou um metrô,"}, {"s": 9.2, "e": 10.8, "t": "como"}, {"s": 10.8, "e": 12.88, "t": "pedir alguma coisa no restaurante, o que"}, {"s": 12.88, "e": 14.96, "t": "dizer num hotel."}, {"s": 14.96, "e": 19.48, "t": "Para você, de 9 a 20 de novembro, vem aí"}, {"s": 19.48, "e": 23.4, "t": "o Portuguese in Action, um evento da"}, {"s": 23.4, "e": 25.96, "t": "comunidade do Easy Portuguese, onde você"}, {"s": 25.96, "e": 29.4, "t": "vai poder praticar situações do dia a"}, {"s": 29.4, "e": 32.8, "t": "dia através de sketches. Você vai fazer"}, {"s": 32.8, "e": 35.88, "t": "isso através de chamadas ao vivo na"}, {"s": 35.88, "e": 39.2, "t": "nossa comunidade, comigo, com o Dani e"}, {"s": 39.2, "e": 42.12, "t": "com todos os membros do Easy Portuguese."}, {"s": 42.12, "e": 44.32, "t": "É uma oportunidade para você conhecer"}, {"s": 44.32, "e": 49.4, "t": "pessoas, aprender, praticar, interagir."}, {"s": 49.4, "e": 52.4, "t": "Que tal? Se você tá interessado,"}, {"s": 52.4, "e": 54.92, "t": "tem um link aqui na descrição com mais"}, {"s": 54.92, "e": 56.44, "t": "informações."}, {"s": 56.44, "e": 58.84, "t": "E se você ainda não é um membro, se"}, {"s": 58.84, "e": 61.36, "t": "torne um membro para participar e"}, {"s": 61.36, "e": 64.72, "t": "colocar o seu português em ação."}, {"s": 64.72, "e": 66.88, "t": "E por falar em ação,"}, {"s": 66.88, "e": 69.0, "t": "a gente tem mais um episódio do Easy"}, {"s": 69.0, "e": 70.36, "t": "Portuguese."}, {"s": 70.36, "e": 72.24, "t": "Vamos lá?"}, {"s": 72.24, "e": 74.64, "t": "Existem alguns verbos que dependem do"}, {"s": 74.64, "e": 77.0, "t": "lugar onde a gente tá."}, {"s": 77.0, "e": 79.8, "t": "Esses verbos podem causar confusão"}, {"s": 79.8, "e": 81.4, "t": "porque em algumas línguas eles são"}, {"s": 81.4, "e": 84.0, "t": "usados de forma diferente."}, {"s": 84.0, "e": 86.6, "t": "E nesse episódio, a gente vai ver esses"}, {"s": 86.6, "e": 89.4, "t": "verbos com alguns exemplos. Então curte"}, {"s": 89.4, "e": 91.05, "t": "o vídeo e vamos lá."}, {"s": 91.05, "e": 93.06, "t": ">> [música]"}, {"s": 114.64, "e": 117.08, "t": ">> A gente vai fazer um piquenique."}, {"s": 117.08, "e": 119.33, "t": "Eu já trouxe algumas coisas, mas o Dani"}, {"s": 119.33, "e": 122.49, "t": "vai trazer mais coisas."}, {"s": 122.49, "e": 124.51, "t": ">> [música]"}, {"s": 132.69, "e": 135.01, "t": ">> Alô?"}, {"s": 135.01, "e": 137.57, "t": "Pera aí, pera aí que eu preciso explicar"}, {"s": 137.57, "e": 139.93, "t": "uma coisa."}, {"s": 139.93, "e": 143.25, "t": "Alguns verbos dependem de onde a gente"}, {"s": 143.25, "e": 144.93, "t": "se encontra."}, {"s": 144.93, "e": 148.17, "t": "O verbo levar, por exemplo, indica que a"}, {"s": 148.17, "e": 152.17, "t": "gente vai transportar algo para outro"}, {"s": 152.17, "e": 154.53, "t": "lugar."}, {"s": 154.53, "e": 157.25, "t": "É, Lê, então."}, {"s": 157.25, "e": 161.45, "t": "Eu vou levar bananas."}, {"s": 162.53, "e": 166.85, "t": "Eu vou levar um suco de uva."}, {"s": 167.57, "e": 171.69, "t": "E vou levar uma bolacha também."}, {"s": 172.37, "e": 174.13, "t": "Eu levo."}, {"s": 174.13, "e": 177.05, "t": "Você leva."}, {"s": 177.05, "e": 178.89, "t": "Eu levei."}, {"s": 178.89, "e": 182.13, "t": "Você levou."}, {"s": 182.13, "e": 184.97, "t": "Hum. Ah, tá ótimo."}, {"s": 184.97, "e": 186.69, "t": "Mas agora pera aí que eu preciso"}, {"s": 186.69, "e": 189.85, "t": "explicar uma coisa."}, {"s": 190.17, "e": 192.37, "t": "O verbo trazer"}, {"s": 192.37, "e": 195.13, "t": "é o oposto do verbo levar."}, {"s": 195.13, "e": 198.53, "t": "Ele vai indicar que você moveu ou vai"}, {"s": 198.53, "e": 200.69, "t": "mover algo para o lugar em que você"}, {"s": 200.69, "e": 203.21, "t": "está."}, {"s": 203.85, "e": 207.33, "t": "Eu trouxe a toalha."}, {"s": 207.89, "e": 211.05, "t": "Já trouxe amendoim."}, {"s": 211.05, "e": 213.17, "t": "Trouxe maçã."}, {"s": 213.17, "e": 216.01, "t": "E abacate."}, {"s": 216.33, "e": 218.33, "t": "E eu também trouxe"}, {"s": 218.33, "e": 220.85, "t": "água."}, {"s": 221.25, "e": 222.69, "t": "Eu trago."}, {"s": 222.69, "e": 224.97, "t": "Você traz."}, {"s": 224.97, "e": 229.89, "t": "Eu trouxe. Você trouxe."}, {"s": 235.81, "e": 237.57, "t": "Se você quiser trabalhar mais o seu"}, {"s": 237.57, "e": 240.73, "t": "português de uma forma interativa,"}, {"s": 240.73, "e": 243.37, "t": "a gente deixou exercícios de três"}, {"s": 243.37, "e": 245.81, "t": "episódios básicos lá na nossa"}, {"s": 245.81, "e": 247.17, "t": "plataforma."}, {"s": 247.17, "e": 250.01, "t": "Então, clica no link, entra na nossa"}, {"s": 250.01, "e": 254.65, "t": "plataforma e aproveita os exercícios."}, {"s": 254.8, "e": 256.82, "t": ">> [música]"}, {"s": 266.41, "e": 271.21, "t": ">> Lê, você levou protetor solar?"}, {"s": 271.21, "e": 276.25, "t": ">> Puts, não, não trouxe. Eu esqueci."}, {"s": 276.25, "e": 278.21, "t": ">> Hum, vou levar então."}, {"s": 278.21, "e": 281.69, "t": "Eh, você levou óculos de sol?"}, {"s": 281.69, "e": 282.89, "t": ">> Ah,"}, {"s": 282.89, "e": 285.69, "t": "eu trouxe óculos de sol."}, {"s": 285.69, "e": 287.49, "t": "Mas eu trouxe para mim."}, {"s": 287.49, "e": 290.05, "t": "Traz um para você."}, {"s": 290.05, "e": 292.89, "t": "Ah, esqueci o boné."}, {"s": 292.89, "e": 295.05, "t": "Traz um para mim?"}, {"s": 295.05, "e": 298.89, "t": ">> OK, vou levar dois bonés então."}, {"s": 298.89, "e": 302.77, "t": "E leva um guarda-chuva?"}, {"s": 302.81, "e": 304.81, "t": ">> Não precisa trazer."}, {"s": 304.81, "e": 308.01, "t": "Eu acho que não vai chover."}, {"s": 308.01, "e": 310.57, "t": ">> Você viu que esses dois verbos são"}, {"s": 310.57, "e": 315.17, "t": "traduzidos como to bring em inglês."}, {"s": 315.17, "e": 318.37, "t": "Existem outros dois verbos que também se"}, {"s": 318.37, "e": 322.05, "t": "comportam como trazer e levar."}, {"s": 322.05, "e": 325.25, "t": "Os verbos ir e vir."}, {"s": 325.25, "e": 328.09, "t": "Eles também dependem do lugar onde a"}, {"s": 328.09, "e": 330.37, "t": "pessoa está."}, {"s": 330.37, "e": 333.13, "t": "O verbo ir indica que alguém está se"}, {"s": 333.13, "e": 337.17, "t": "deslocando para um outro lugar."}, {"s": 337.33, "e": 338.97, "t": "O verbo vir"}, {"s": 338.97, "e": 342.41, "t": "indica que alguém está se deslocando"}, {"s": 342.41, "e": 344.29, "t": "para o lugar que a pessoa que está"}, {"s": 344.29, "e": 347.61, "t": "falando está."}, {"s": 348.33, "e": 350.57, "t": ">> Que horas você vem?"}, {"s": 350.57, "e": 352.61, "t": ">> Eu vou daqui a pouco, eu só preciso"}, {"s": 352.61, "e": 355.09, "t": "terminar algumas coisas."}, {"s": 355.09, "e": 357.41, "t": "Já vou."}, {"s": 360.25, "e": 362.27, "t": ">> [música]"}, {"s": 375.74, "e": 377.5, "t": ">> Alô?"}, {"s": 377.5, "e": 380.21, "t": ">> Você tá vindo?"}, {"s": 380.21, "e": 383.38, "t": ">> Tô indo, tô indo, tô indo."}, {"s": 385.14, "e": 387.16, "t": ">> [música]"}, {"s": 409.01, "e": 411.42, "t": ">> Espero que esse episódio tenha tirado"}, {"s": 411.42, "e": 413.45, "t": "essa dúvida."}, {"s": 413.45, "e": 416.45, "t": "E se você tiver mais dúvidas, eu peço"}, {"s": 416.45, "e": 417.98, "t": "para você se tornar um membro da"}, {"s": 417.98, "e": 420.42, "t": "comunidade, que aí você entra no nosso"}, {"s": 420.42, "e": 423.06, "t": "Discord, onde você pode tirar não só"}, {"s": 423.06, "e": 425.25, "t": "essa, mas também outras dúvidas."}, {"s": 425.25, "e": 427.01, "t": ">> Tem muita gente lá que gosta de"}, {"s": 427.01, "e": 429.69, "t": "gramática. Ô se tem! Já vi muitas"}, {"s": 429.69, "e": 430.34, "t": "perguntas."}, {"s": 430.34, "e": 431.94, "t": ">> [risadas]"}, {"s": 431.94, "e": 434.06, "t": ">> Muito obrigado"}, {"s": 434.06, "e": 436.45, "t": "por assistir esse vídeo até aqui."}, {"s": 436.45, "e": 438.57, "t": "E até o próximo episódio."}, {"s": 438.57, "e": 439.62, "t": "Tchau."}, {"s": 439.62, "e": 441.65, "t": ">> Tchau. Passa a banana."}, {"s": 441.65, "e": 443.97, "t": ">> Aqui."}, {"s": 446.71, "e": 448.73, "t": ">> [música]"}]