[{"s": 0.0, "e": 3.48, "t": "Sabe aquele momento em que você está"}, {"s": 3.48, "e": 5.68, "t": "quase se despedindo?"}, {"s": 5.68, "e": 8.24, "t": "Mas você quer deixar uma porta aberta"}, {"s": 8.24, "e": 10.52, "t": "pro próximo encontro?"}, {"s": 10.52, "e": 12.0, "t": ">> Ah!"}, {"s": 12.0, "e": 16.16, "t": "Nesse episódio, a gente vai ver frases"}, {"s": 16.16, "e": 20.12, "t": "muito comuns num tempo verbal que sempre"}, {"s": 20.12, "e": 22.48, "t": "aparece nesses momentos."}, {"s": 22.48, "e": 24.48, "t": ">> Então, curte o vídeo"}, {"s": 24.48, "e": 25.24, "t": ">> e"}, {"s": 25.24, "e": 28.2, "t": ">> vamos lá!"}, {"s": 34.06, "e": 36.08, "t": ">> [música]"}, {"s": 36.8, "e": 40.8, "t": ">> Antes de mostrar as frases pra vocês,"}, {"s": 40.8, "e": 44.72, "t": "a gente precisa esclarecer uma coisa"}, {"s": 44.72, "e": 46.52, "t": "importante."}, {"s": 46.52, "e": 49.28, "t": ">> É uma construção gramatical"}, {"s": 49.28, "e": 54.32, "t": "que se chama futuro do subjuntivo."}, {"s": 54.92, "e": 57.0, "t": ">> Parece difícil,"}, {"s": 57.0, "e": 60.72, "t": "mas se você se acostumar com algumas"}, {"s": 60.72, "e": 62.32, "t": "estruturas,"}, {"s": 62.32, "e": 65.24, "t": "você vai ter esse tempo na ponta da"}, {"s": 65.24, "e": 66.56, "t": "língua."}, {"s": 66.56, "e": 68.16, "t": ">> Presta atenção"}, {"s": 68.16, "e": 72.6, "t": "que alguns verbos vão mudar de forma."}, {"s": 72.6, "e": 75.64, "t": "Bora pro primeiro verbo."}, {"s": 75.64, "e": 77.84, "t": ">> Poder."}, {"s": 77.84, "e": 80.52, "t": "Puder."}, {"s": 80.52, "e": 83.52, "t": ">> O verbo poder muda pra"}, {"s": 83.52, "e": 85.04, "t": "puder."}, {"s": 85.04, "e": 88.76, "t": "E a frase quando você puder"}, {"s": 88.76, "e": 93.6, "t": "sempre vem acompanhada de um pedido."}, {"s": 96.96, "e": 97.6, "t": "Oi, Lê."}, {"s": 97.6, "e": 98.68, "t": ">> Oi."}, {"s": 98.68, "e": 101.52, "t": ">> Quando você puder, passa lá em casa."}, {"s": 101.52, "e": 102.96, "t": ">> Ah, tá."}, {"s": 102.96, "e": 104.4, "t": "Passo."}, {"s": 104.4, "e": 105.64, "t": "Pra quê?"}, {"s": 105.64, "e": 108.48, "t": ">> Ah, é que eu tô fazendo uma reforma e eu"}, {"s": 108.48, "e": 110.96, "t": "preciso da sua ajuda."}, {"s": 110.96, "e": 113.56, "t": ">> Ah, tá."}, {"s": 113.56, "e": 117.16, "t": "Pode deixar que eu vou lá."}, {"s": 117.16, "e": 119.84, "t": ">> Quando você puder,"}, {"s": 119.84, "e": 123.16, "t": "passa lá em casa."}, {"s": 123.2, "e": 125.88, "t": "Querer,"}, {"s": 125.88, "e": 128.76, "t": "quiser."}, {"s": 129.4, "e": 134.4, "t": "O verbo querer se transforma em quiser."}, {"s": 134.4, "e": 138.16, "t": "E a frase mais comum para oferecer algo"}, {"s": 138.16, "e": 139.24, "t": "é"}, {"s": 139.24, "e": 142.48, "t": "se você quiser,"}, {"s": 142.8, "e": 145.8, "t": "aqui tem uns salgados,"}, {"s": 145.8, "e": 148.48, "t": "mas eles são muito grandes."}, {"s": 148.48, "e": 150.24, "t": "Hum."}, {"s": 150.24, "e": 153.04, "t": "Mas se você quiser,"}, {"s": 153.04, "e": 158.08, "t": "a gente pode dividir. Hum, boa ideia."}, {"s": 158.08, "e": 161.92, "t": "Me vê uma coxinha, por favor?"}, {"s": 161.92, "e": 164.44, "t": "Se você quiser,"}, {"s": 164.44, "e": 168.48, "t": "a gente pode dividir um."}, {"s": 168.48, "e": 170.96, "t": "Dar,"}, {"s": 170.96, "e": 173.4, "t": "der."}, {"s": 173.4, "e": 175.36, "t": "O verbo dar"}, {"s": 175.36, "e": 178.04, "t": "muda para der."}, {"s": 178.04, "e": 181.76, "t": "E ele aparece na esperança de que algo"}, {"s": 181.76, "e": 184.28, "t": "vai dar certo."}, {"s": 184.28, "e": 186.92, "t": "Onde você vai amanhã?"}, {"s": 186.92, "e": 190.88, "t": "Amanhã, eu vou visitar um amigo"}, {"s": 190.88, "e": 191.8, "t": "aqui"}, {"s": 191.8, "e": 193.48, "t": "em Veg Hausen."}, {"s": 193.48, "e": 194.96, "t": ">> Hum."}, {"s": 194.96, "e": 198.12, "t": "Será que dá para a gente se encontrar?"}, {"s": 198.12, "e": 199.36, "t": ">> Hum,"}, {"s": 199.36, "e": 200.48, "t": "ah."}, {"s": 200.48, "e": 203.2, "t": "Se der, eu te aviso."}, {"s": 203.2, "e": 205.64, "t": "Porque eu não sei"}, {"s": 205.64, "e": 207.72, "t": "que horas eu vou voltar."}, {"s": 207.72, "e": 210.16, "t": ">> Hum, tá bom."}, {"s": 210.16, "e": 211.4, "t": "Se der,"}, {"s": 211.4, "e": 214.48, "t": "eu te aviso."}, {"s": 214.48, "e": 217.32, "t": ">> O futuro do subjuntivo aparece nessas"}, {"s": 217.32, "e": 220.52, "t": "pequenas frases que expressam algo que"}, {"s": 220.52, "e": 223.8, "t": "pode acontecer no futuro."}, {"s": 223.8, "e": 225.4, "t": "Geralmente,"}, {"s": 225.4, "e": 227.4, "t": "ele vem acompanhado"}, {"s": 227.4, "e": 229.64, "t": "das palavras se"}, {"s": 229.64, "e": 231.28, "t": "e quando."}, {"s": 231.28, "e": 234.32, "t": "Tudo isso, você pode aprofundar lá na"}, {"s": 234.32, "e": 236.16, "t": "nossa plataforma,"}, {"s": 236.16, "e": 239.0, "t": "onde você pode fazer exercícios"}, {"s": 239.0, "e": 241.08, "t": "quando você quiser."}, {"s": 241.08, "e": 243.24, "t": "E quando der,"}, {"s": 243.24, "e": 246.04, "t": "clica no link que aparece aqui embaixo"}, {"s": 246.04, "e": 247.8, "t": "na descrição,"}, {"s": 247.8, "e": 250.16, "t": "para que você possa ver"}, {"s": 250.16, "e": 253.08, "t": "o que o Easy Portuguese oferece para os"}, {"s": 253.08, "e": 254.68, "t": "nossos membros."}, {"s": 254.68, "e": 255.8, "t": "Então,"}, {"s": 255.8, "e": 257.64, "t": "se possível,"}, {"s": 257.64, "e": 260.52, "t": "se se torne um membro."}, {"s": 260.52, "e": 262.72, "t": "Ver."}, {"s": 262.72, "e": 265.24, "t": "Vir."}, {"s": 265.24, "e": 267.04, "t": "O verbo ver"}, {"s": 267.04, "e": 269.48, "t": "muda para vir."}, {"s": 269.48, "e": 272.72, "t": "Cuidado para não confundir com o verbo"}, {"s": 272.72, "e": 275.2, "t": "vir."}, {"s": 275.2, "e": 278.56, "t": "Você sabe onde está o Jonathan?"}, {"s": 278.56, "e": 280.92, "t": "Não."}, {"s": 281.12, "e": 284.08, "t": "Quando você vir ele, você me avisa?"}, {"s": 284.08, "e": 286.52, "t": "Pode deixar."}, {"s": 287.72, "e": 290.32, "t": "Quando você vir ele,"}, {"s": 290.32, "e": 293.6, "t": "você me avisa?"}, {"s": 293.6, "e": 295.48, "t": "Vir."}, {"s": 295.48, "e": 298.16, "t": "Vier."}, {"s": 298.16, "e": 299.52, "t": "Agora sim,"}, {"s": 299.52, "e": 301.36, "t": "o verbo vir"}, {"s": 301.36, "e": 304.44, "t": "se transforma em vier."}, {"s": 304.44, "e": 306.88, "t": "Então, cuidado para não confundir o"}, {"s": 306.88, "e": 310.52, "t": "verbo vir e ver."}, {"s": 310.52, "e": 312.76, "t": "Quando eu vir,"}, {"s": 312.76, "e": 315.96, "t": "quando eu vier."}, {"s": 319.44, "e": 320.4, "t": "Alô?"}, {"s": 320.4, "e": 323.16, "t": "Você não vem para festa?"}, {"s": 323.16, "e": 325.08, "t": "Eu vou, mas eu estou terminando de me"}, {"s": 325.08, "e": 326.0, "t": "arrumar."}, {"s": 326.0, "e": 329.08, "t": "Se você não vier logo, a festa vai"}, {"s": 329.08, "e": 331.6, "t": "acabar."}, {"s": 332.32, "e": 334.96, "t": "Se você não vier logo,"}, {"s": 334.96, "e": 338.52, "t": "a festa vai acabar."}, {"s": 338.88, "e": 341.12, "t": "Saber."}, {"s": 341.12, "e": 344.12, "t": "Souber."}, {"s": 344.36, "e": 348.56, "t": "O verbo saber muda para souber."}, {"s": 348.56, "e": 351.64, "t": "E é ótimo para expressar algo que você"}, {"s": 351.64, "e": 353.8, "t": "vai tomar conhecimento"}, {"s": 353.8, "e": 355.64, "t": "no futuro."}, {"s": 355.64, "e": 358.24, "t": ">> Você já sabe o resultado dos seus"}, {"s": 358.24, "e": 358.96, "t": "exames?"}, {"s": 358.96, "e": 359.68, "t": ">> Hum."}, {"s": 359.68, "e": 361.36, "t": ">> Não."}, {"s": 361.36, "e": 363.44, "t": "Mas quando eu souber,"}, {"s": 363.44, "e": 364.68, "t": "eu te aviso."}, {"s": 364.68, "e": 368.84, "t": ">> Por favor, estou preocupado, viu?"}, {"s": 368.92, "e": 370.8, "t": "Quando eu souber,"}, {"s": 370.8, "e": 373.32, "t": "eu te aviso."}, {"s": 373.32, "e": 375.44, "t": "Ter"}, {"s": 375.44, "e": 378.32, "t": "tiver."}, {"s": 378.32, "e": 382.48, "t": "O verbo ter muda para tiver."}, {"s": 382.48, "e": 386.76, "t": "E é ótimo para pedir algo com a frase"}, {"s": 386.76, "e": 391.12, "t": "quando você tiver um tempinho."}, {"s": 391.2, "e": 393.76, "t": "Lê. Quando você tiver um tempinho, dá"}, {"s": 393.76, "e": 395.64, "t": "uma olhada nisso para mim?"}, {"s": 395.64, "e": 398.08, "t": ">> Ah, tá."}, {"s": 398.08, "e": 400.52, "t": "Ok, deixa aqui"}, {"s": 400.52, "e": 403.12, "t": "que eu vou dar uma olhada depois."}, {"s": 403.12, "e": 404.32, "t": "Ok."}, {"s": 404.32, "e": 405.84, "t": "Obrigado."}, {"s": 405.84, "e": 408.12, "t": "De nada."}, {"s": 408.12, "e": 411.16, "t": ">> Quando você tiver um tempinho,"}, {"s": 411.16, "e": 416.28, "t": "você pode dar uma olhada nisso para mim?"}, {"s": 426.92, "e": 429.16, "t": "Para alguns verbos, o futuro do"}, {"s": 429.16, "e": 430.68, "t": "subjuntivo"}, {"s": 430.68, "e": 433.92, "t": "é igual ao infinitivo."}, {"s": 433.92, "e": 436.64, "t": "Como no verbo comer,"}, {"s": 436.64, "e": 438.12, "t": "beber,"}, {"s": 438.12, "e": 440.12, "t": "jogar."}, {"s": 440.12, "e": 443.28, "t": ">> Mas isso pode ficar para um próximo"}, {"s": 443.28, "e": 444.72, "t": "episódio."}, {"s": 444.72, "e": 448.24, "t": ">> Esse episódio foi gravado em Backhausen,"}, {"s": 448.24, "e": 452.76, "t": "aqui na Alemanha, próximo de Karlsruhe."}, {"s": 452.76, "e": 453.92, "t": ">> E"}, {"s": 453.92, "e": 457.4, "t": "no mais, Daniel e eu queremos agradecer"}, {"s": 457.4, "e": 460.52, "t": "a você que está aí até agora."}, {"s": 460.52, "e": 464.92, "t": "E se você puder, se torne um membro do"}, {"s": 464.92, "e": 467.28, "t": "Easy Portuguese. Entre para nossa"}, {"s": 467.28, "e": 468.68, "t": "comunidade."}, {"s": 468.68, "e": 470.76, "t": "E se você quiser,"}, {"s": 470.76, "e": 474.08, "t": "veja o episódio que vai aparecer aqui no"}, {"s": 474.08, "e": 475.6, "t": "card do final."}, {"s": 475.6, "e": 477.44, "t": "Acho que você vai gostar."}, {"s": 477.44, "e": 478.8, "t": ">> Sim, sim."}, {"s": 478.8, "e": 481.4, "t": ">> Então, muito obrigado"}, {"s": 481.4, "e": 483.76, "t": "e até o próximo episódio."}, {"s": 483.76, "e": 484.56, "t": "Beijo."}, {"s": 484.56, "e": 485.04, "t": ">> Tchau."}, {"s": 485.04, "e": 486.92, "t": ">> Tchau."}, {"s": 486.92, "e": 488.16, "t": "Mas eles"}, {"s": 488.16, "e": 491.04, "t": "são muito grandes. [risadas]"}, {"s": 491.04, "e": 492.52, "t": ">> Tá."}, {"s": 492.52, "e": 495.0, "t": ">> Alô?"}, {"s": 496.4, "e": 498.24, "t": "Alô?"}, {"s": 498.24, "e": 500.72, "t": "Tem alguém?"}, {"s": 500.72, "e": 504.4, "t": "Ah, você não vem para festa?"}]