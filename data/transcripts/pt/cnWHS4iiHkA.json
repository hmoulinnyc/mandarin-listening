[{"s": 0.0, "e": 3.96, "t": "Olá e bem-vindo ou bem-vinda ao"}, {"s": 3.96, "e": 5.84, "t": "Portuguese with Leo."}, {"s": 5.84, "e": 8.56, "t": "O meu nome é Leonardo e neste canal"}, {"s": 8.56, "e": 11.92, "t": "ensino o português de Portugal."}, {"s": 11.92, "e": 15.16, "t": "Neste vídeo vamos fazer um teste"}, {"s": 15.16, "e": 19.48, "t": "completo de português de nível B1."}, {"s": 19.48, "e": 23.8, "t": "Por favor, ativa as legendas e antes de"}, {"s": 23.8, "e": 26.8, "t": "começarmos vou dar-te algumas"}, {"s": 26.8, "e": 30.68, "t": "informações úteis para perceberes como"}, {"s": 30.68, "e": 33.16, "t": "funciona o teste."}, {"s": 33.16, "e": 36.08, "t": "Este teste está dividido em cinco"}, {"s": 36.08, "e": 37.44, "t": "partes."}, {"s": 37.44, "e": 39.16, "t": "Compreensão oral,"}, {"s": 39.16, "e": 42.4, "t": "compreensão escrita, gramática,"}, {"s": 42.4, "e": 46.16, "t": "vocabulário e expressão oral."}, {"s": 46.16, "e": 49.0, "t": "Antes de começarmos, clica no primeiro"}, {"s": 49.0, "e": 51.52, "t": "link na descrição deste vídeo para"}, {"s": 51.52, "e": 55.16, "t": "descarregares a folha de respostas."}, {"s": 55.16, "e": 58.24, "t": "Esta é uma folha que podes imprimir ou"}, {"s": 58.24, "e": 61.12, "t": "abrir no teu telemóvel para poderes"}, {"s": 61.12, "e": 63.96, "t": "anotar as tuas respostas."}, {"s": 63.96, "e": 66.48, "t": "Isto é importante porque no final do"}, {"s": 66.48, "e": 70.12, "t": "teste podes fazer a tua autoavaliação e"}, {"s": 70.12, "e": 73.2, "t": "saber quantos pontos tiveste."}, {"s": 73.2, "e": 76.0, "t": "Por isso, põe o vídeo em pausa e"}, {"s": 76.0, "e": 79.12, "t": "descarrega a folha de respostas enquanto"}, {"s": 79.12, "e": 83.2, "t": "eu fico aqui à tua espera."}, {"s": 84.0, "e": 86.28, "t": "Já tens a tua folha de respostas?"}, {"s": 86.28, "e": 88.8, "t": "Boa. Então, agora,"}, {"s": 88.8, "e": 90.72, "t": "antes de começarmos,"}, {"s": 90.72, "e": 94.08, "t": "recomendo que te sentes à secretária,"}, {"s": 94.08, "e": 97.88, "t": "num lugar tranquilo e silencioso para"}, {"s": 97.88, "e": 101.4, "t": "que te possas concentrar. Certifica-te"}, {"s": 101.4, "e": 104.44, "t": "de que tens pelo menos 40 minutos para"}, {"s": 104.44, "e": 107.4, "t": "fazer o teste, mas não te preocupes se"}, {"s": 107.4, "e": 110.0, "t": "precisares de mais tempo porque não há"}, {"s": 110.0, "e": 111.8, "t": "limite de tempo."}, {"s": 111.8, "e": 114.64, "t": "O importante é fazeres o teste com"}, {"s": 114.64, "e": 116.64, "t": "calma."}, {"s": 116.64, "e": 119.36, "t": "Como eu te disse, o teste tem cinco"}, {"s": 119.36, "e": 120.48, "t": "partes."}, {"s": 120.48, "e": 122.4, "t": "Agora vamos começar com a primeira"}, {"s": 122.4, "e": 125.36, "t": "parte, a compreensão oral,"}, {"s": 125.36, "e": 128.08, "t": "e ao longo do teste, eu vou te explicar"}, {"s": 128.08, "e": 131.16, "t": "sempre cada parte em detalhe"}, {"s": 131.16, "e": 134.24, "t": "antes de começares."}, {"s": 134.44, "e": 137.48, "t": "A parte de compreensão oral tem dois"}, {"s": 137.48, "e": 139.28, "t": "exercícios."}, {"s": 139.28, "e": 142.16, "t": "No primeiro exercício, vais ouvir duas"}, {"s": 142.16, "e": 145.92, "t": "vezes um diálogo entre a dona Margarida"}, {"s": 145.92, "e": 147.6, "t": "e o Jorge."}, {"s": 147.6, "e": 149.8, "t": "Enquanto ouves o diálogo,"}, {"s": 149.8, "e": 153.68, "t": "vão aparecer no ecrã 10 afirmações que"}, {"s": 153.68, "e": 157.84, "t": "tu deves escolher se são V, verdadeiras,"}, {"s": 157.84, "e": 159.16, "t": "ou F,"}, {"s": 159.16, "e": 160.96, "t": "falsas."}, {"s": 160.96, "e": 164.84, "t": "Responde na tua folha de respostas."}, {"s": 164.84, "e": 167.32, "t": "Vamos começar."}, {"s": 167.32, "e": 169.84, "t": "A dona Margarida e o Jorge vivem no"}, {"s": 169.84, "e": 171.32, "t": "mesmo prédio."}, {"s": 171.32, "e": 174.24, "t": "Certa manhã, o Jorge desce as escadas a"}, {"s": 174.24, "e": 177.12, "t": "correr e encontra a dona Margarida à"}, {"s": 177.12, "e": 179.12, "t": "porta do prédio."}, {"s": 179.12, "e": 180.48, "t": "Bom dia, Jorge."}, {"s": 180.48, "e": 182.32, "t": "Que pressa é essa? Já vai para o"}, {"s": 182.32, "e": 183.52, "t": "trabalho?"}, {"s": 183.52, "e": 185.32, "t": "Bom dia, dona Margarida."}, {"s": 185.32, "e": 186.92, "t": "É verdade, hoje tenho de entrar um pouco"}, {"s": 186.92, "e": 189.44, "t": "mais cedo. E a vizinha, como está? Tudo"}, {"s": 189.44, "e": 190.52, "t": "bem?"}, {"s": 190.52, "e": 192.36, "t": "Vai-se andando, obrigada."}, {"s": 192.36, "e": 193.12, "t": "Olhe,"}, {"s": 193.12, "e": 194.92, "t": "ainda bem que o vejo."}, {"s": 194.92, "e": 196.96, "t": "Queria perguntar-lhe uma coisa."}, {"s": 196.96, "e": 199.44, "t": "Reparou naquele gatinho que tem andado"}, {"s": 199.44, "e": 203.16, "t": "ali junto ao caixote do lixo? Vi sim. É"}, {"s": 203.16, "e": 204.88, "t": "um gato preto com manchas brancas, não"}, {"s": 204.88, "e": 205.67, "t": "é?"}, {"s": 205.67, "e": 205.8, "t": ">> [roncando]"}, {"s": 205.8, "e": 208.24, "t": ">> Já o vejo ali há dois dias. Ele parece"}, {"s": 208.24, "e": 210.36, "t": "estar bem tratado e tem uma coleira, por"}, {"s": 210.36, "e": 212.44, "t": "isso deve ser de alguém."}, {"s": 212.44, "e": 214.16, "t": "Pois, eu também acho que ele está"}, {"s": 214.16, "e": 216.12, "t": "perdido. Coitado."}, {"s": 216.12, "e": 217.8, "t": "Parece assustado."}, {"s": 217.8, "e": 220.44, "t": "Já lhe dei comida e água, mas ele foge"}, {"s": 220.44, "e": 222.36, "t": "mal eu me aproximo."}, {"s": 222.36, "e": 224.4, "t": "Espero que ele encontre a família antes"}, {"s": 224.4, "e": 226.44, "t": "que seja atropelado por algum carro."}, {"s": 226.44, "e": 228.68, "t": "O melhor era tirarmos uma fotografia e"}, {"s": 228.68, "e": 230.64, "t": "divulgarmos no Facebook."}, {"s": 230.64, "e": 232.4, "t": "Hoje em dia, as pessoas usam muito as"}, {"s": 232.4, "e": 234.08, "t": "redes sociais para encontrar animais"}, {"s": 234.08, "e": 237.32, "t": "perdidos. Pois tem toda a razão, mas eu"}, {"s": 237.32, "e": 239.36, "t": "não percebo nada dessas coisas da"}, {"s": 239.36, "e": 240.64, "t": "internet."}, {"s": 240.64, "e": 242.88, "t": "Não se preocupe dona Margarida, eu trato"}, {"s": 242.88, "e": 245.0, "t": "disso assim que chegar ao escritório."}, {"s": 245.0, "e": 247.04, "t": "Vou já tirar uma fotografia e a seguir"}, {"s": 247.04, "e": 249.4, "t": "publico nos grupos aqui da zona. Se"}, {"s": 249.4, "e": 251.52, "t": "alguém responder, eu aviso-a."}, {"s": 251.52, "e": 253.76, "t": "Fico-lhe muito agradecida."}, {"s": 253.76, "e": 256.04, "t": "Olhe Jorge, outra coisa."}, {"s": 256.04, "e": 258.24, "t": "Reparou que estamos sem luz na entrada"}, {"s": 258.24, "e": 260.64, "t": "do prédio? É verdade, reparei ontem à"}, {"s": 260.64, "e": 262.32, "t": "noite quando cheguei a casa"}, {"s": 262.32, "e": 263.8, "t": "e nas escadas também não havia luz"}, {"s": 263.8, "e": 266.52, "t": "nenhuma, tive de subir quase às escuras."}, {"s": 266.52, "e": 269.24, "t": "Isto é um perigo, alguém pode cair e"}, {"s": 269.24, "e": 271.2, "t": "aleijar-se a sério."}, {"s": 271.2, "e": 273.2, "t": "Sabe quem é o administrador do"}, {"s": 273.2, "e": 275.92, "t": "condomínio? Sei, acho que é o vizinho do"}, {"s": 275.92, "e": 277.12, "t": "primeiro andar."}, {"s": 277.12, "e": 280.2, "t": "Ah, já sei quem é. O senhor Manuel."}, {"s": 280.2, "e": 282.6, "t": "Daqui a pouco já vou falar com ele."}, {"s": 282.6, "e": 284.48, "t": "É preciso mandar alguém arranjar a luz"}, {"s": 284.48, "e": 287.4, "t": "com urgência. Boa ideia dona Margarida,"}, {"s": 287.4, "e": 288.84, "t": "é melhor resolvermos isso o quanto"}, {"s": 288.84, "e": 289.84, "t": "antes."}, {"s": 289.84, "e": 291.92, "t": "Olhe, agora tenho mesmo de ir, senão vou"}, {"s": 291.92, "e": 293.68, "t": "chegar atrasado. Vou já tirar uma"}, {"s": 293.68, "e": 295.12, "t": "fotografia ao gatinho."}, {"s": 295.12, "e": 298.0, "t": "Claro Jorge, não o empato mais. Obrigada"}, {"s": 