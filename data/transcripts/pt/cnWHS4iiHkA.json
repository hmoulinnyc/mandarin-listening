0.56, "e": 1062.08, "t": "Dois."}, {"s": 1062.08, "e": 1064.76, "t": "Eles mal conseguem pagar as despesas de"}, {"s": 1064.76, "e": 1067.2, "t": "casa."}, {"s": 1071.84, "e": 1073.08, "t": "Três."}, {"s": 1073.08, "e": 1075.6, "t": "Eu duvido que ele consiga passar no"}, {"s": 1075.6, "e": 1078.04, "t": "exame."}, {"s": 1083.28, "e": 1084.72, "t": "Quatro."}, {"s": 1084.72, "e": 1087.44, "t": "Oxalá o tempo esteja bom para que possam"}, {"s": 1087.44, "e": 1090.96, "t": "desfrutar das férias."}, {"s": 1094.32, "e": 1095.68, "t": "Cinco."}, {"s": 1095.68, "e": 1098.36, "t": "Eu não aceitei o convite porque já tinha"}, {"s": 1098.36, "e": 1101.56, "t": "almoçado em casa."}, {"s": 1107.0, "e": 1110.2, "t": "Estamos agora na parte do vocabulário"}, {"s": 1110.2, "e": 1112.96, "t": "e aqui temos dois exercícios."}, {"s": 1112.96, "e": 1115.12, "t": "No primeiro exercício vou dar-te cinco"}, {"s": 1115.12, "e": 1118.12, "t": "grupos de cinco palavras e vais ter de"}, {"s": 1118.12, "e": 1121.44, "t": "encontrar o intruso, ou seja, a palavra"}, {"s": 1121.44, "e": 1124.2, "t": "que não pertence àquele grupo lexical,"}, {"s": 1124.2, "e": 1126.12, "t": "que não tem relação com as outras"}, {"s": 1126.12, "e": 1128.24, "t": "palavras."}, {"s": 1128.24, "e": 1130.44, "t": "Põe o vídeo em pausa para fazeres o"}, {"s": 1130.44, "e": 1133.2, "t": "exercício."}, {"s": 1135.0, "e": 1137.44, "t": "No nosso segundo exercício de"}, {"s": 1137.44, "e": 1139.12, "t": "vocabulário"}, {"s": 1139.12, "e": 1142.72, "t": "vais ter de identificar 10 palavras a"}, {"s": 1142.72, "e": 1145.32, "t": "partir da sua definição."}, {"s": 1145.32, "e": 1148.2, "t": "Eu dou-te a definição de uma palavra e"}, {"s": 1148.2, "e": 1152.36, "t": "tu tens de selecionar a opção A, B ou C"}, {"s": 1152.36, "e": 1155.24, "t": "que corresponde à palavra certa."}, {"s": 1155.24, "e": 1158.0, "t": "Se quiseres pensar entre uma pergunta e"}, {"s": 1158.0, "e": 1160.92, "t": "outra, podes pôr o vídeo em pausa"}, {"s": 1160.92, "e": 1162.92, "t": "e não te esqueças de escrever a tua"}, {"s": 1162.92, "e": 1167.04, "t": "resposta na folha de respostas."}, {"s": 1167.04, "e": 1168.44, "t": "Um."}, {"s": 1168.44, "e": 1172.08, "t": "Penalização em dinheiro aplicada quando"}, {"s": 1172.08, "e": 1176.64, "t": "alguém não cumpre uma regra ou lei."}, {"s": 1178.72, "e": 1180.08, "t": "Dois."}, {"s": 1180.08, "e": 1182.92, "t": "Pessoa que tem dificuldade em manter a"}, {"s": 1182.92, "e": 1185.68, "t": "atenção."}, {"s": 1187.84, "e": 1189.12, "t": "Três."}, {"s": 1189.12, "e": 1192.48, "t": "Ato de entregar um produto à loja depois"}, {"s": 1192.48, "e": 1197.12, "t": "da compra, recebendo o valor pago."}, {"s": 1198.8, "e": 1203.68, "t": "Quatro. Não se lembrou, ou seja"}, {"s": 1205.32, "e": 1206.88, "t": "Cinco."}, {"s": 1206.88, "e": 1209.28, "t": "Paragem organizada dos trabalhadores"}, {"s": 1209.28, "e": 1212.88, "t": "como forma de protesto."}, {"s": 1214.72, "e": 1216.28, "t": "Seis."}, {"s": 1216.28, "e": 1218.44, "t": "Pessoa que pensa sobretudo nos próprios"}, {"s": 1218.44, "e": 1220.56, "t": "interesses e não se preocupa com os"}, {"s": 1220.56, "e": 1223.08, "t": "outros."}, {"s": 1225.04, "e": 1226.64, "t": "Sete."}, {"s": 1226.64, "e": 1228.8, "t": "Pessoa que vive numa casa que pertence a"}, {"s": 1228.8, "e": 1233.32, "t": "outra pessoa e paga para lá viver."}, {"s": 1235.12, "e": 1236.44, "t": "Oito."}, {"s": 1236.44, "e": 1239.04, "t": "Queixa feita por um cliente quando um"}, {"s": 1239.04, "e": 1241.88, "t": "serviço ou produto não corresponde ao"}, {"s": 1241.88, "e": 1244.48, "t": "esperado."}, {"s": 1245.96, "e": 1247.2, "t": "Nove."}, {"s": 1247.2, "e": 1252.0, "t": "Ele não chegou a horas, ou seja"}, {"s": 1253.88, "e": 1257.52, "t": "Dez. No dia 1 de janeiro o comércio está"}, {"s": 1257.52, "e": 1260.76, "t": "fechado porque é"}, {"s": 1261.96, "e": 1263.2, "t": "Muito bem."}, {"s": 1263.2, "e": 1266.28, "t": "Chegamos à última parte do teste, a"}, {"s": 1266.28, "e": 1269.12, "t": "parte da expressão oral."}, {"s": 1269.12, "e": 1270.76, "t": "Falar."}, {"s": 1270.76, "e": 1273.04, "t": "Obviamente, eu não posso avaliar a tua"}, {"s": 1273.04, "e": 1275.48, "t": "expressão oral, porque não te consigo"}, {"s": 1275.48, "e": 1278.08, "t": "ouvir através do ecrã."}, {"s": 1278.08, "e": 1281.68, "t": "Por isso, vamos usar uma técnica chamada"}, {"s": 1281.68, "e": 1284.52, "t": "shadowing. O shadowing consiste em"}, {"s": 1284.52, "e": 1287.28, "t": "repetir em voz alta uma frase que"}, {"s": 1287.28, "e": 1288.96, "t": "acabamos de ouvir,"}, {"s": 1288.96, "e": 1291.84, "t": "tentando pronunciá-la exatamente como"}, {"s": 1291.84, "e": 1293.76, "t": "ouvimos. Portanto, [roncando]"}, {"s": 1293.76, "e": 1296.36, "t": "este exercício funciona assim."}, {"s": 1296.36, "e": 1299.0, "t": "Tu vais ouvir uma frase e depois tens"}, {"s": 1299.0, "e": 1301.52, "t": "alguns segundos para a repetir"}, {"s": 1301.52, "e": 1305.32, "t": "exatamente da mesma forma. Por exemplo,"}, {"s": 1305.32, "e": 1307.48, "t": "a encomenda ainda não chegou."}, {"s": 1307.48, "e": 1310.28, "t": "A encomenda ainda não chegou."}, {"s": 1310.28, "e": 1313.16, "t": "Não te esqueças de avisar a Joana."}, {"s": 1313.16, "e": 1316.32, "t": "Não te esqueças de avisar a Joana."}, {"s": 1316.32, "e": 1319.12, "t": "Como viste, tens de repetir a frase"}, {"s": 1319.12, "e": 1322.12, "t": "imediatamente depois de ouvires e não"}, {"s": 1322.12, "e": 1324.2, "t": "vais ter muito tempo."}, {"s": 1324.2, "e": 1326.6, "t": "As frases vão ficar progressivamente"}, {"s": 1326.6, "e": 1329.92, "t": "mais difíceis e o teste termina quando"}, {"s": 1329.92, "e": 1332.8, "t": "já não conseguires acompanhar o ritmo,"}, {"s": 1332.8, "e": 1334.92, "t": "quando já não conseguires repetir a"}, {"s": 1334.92, "e": 1339.16, "t": "frase no tempo que te é dado. Portanto,"}, {"s": 1339.16, "e": 1341.44, "t": "imagina que conseguiste repetir as três"}, {"s": 1341.44, "e": 1343.92, "t": "primeiras frases, mas não a frase"}, {"s": 1343.92, "e": 1345.08, "t": "quatro."}, {"s": 1345.08, "e": 1346.72, "t": "Então ganhaste"}, {"s": 1346.72, "e": 1349.2, "t": "três pontos neste exercício."}, {"s": 1349.2, "e": 1351.76, "t": "Ou então imagina que conseguiste repetir"}, {"s": 1351.76, "e": 1354.08, "t": "as sete primeiras frases, mas não"}, {"s": 1354.08, "e": 1356.88, "t": "conseguiste repetir a frase número oito."}, {"s": 1356.88, "e": 1358.72, "t": "Então ganhaste"}, {"s": 1358.72, "e": 1360.68, "t": "sete pontos."}, {"s": 1360.68, "e": 1362.96, "t": "E atenção, para este teste poder"}, {"s": 1362.96, "e": 1365.48, "t": "funcionar, tu não podes pôr o vídeo em"}, {"s": 1365.48, "e": 1368.92, "t": "pausa, nem voltar atrás, nem repetir o"}, {"s": 1368.92, "e": 1371.04, "t": "exercício."}, {"s": 1371.04, "e": 1372.6, "t": "Então vamos lá."}, {"s": 1372.6, "e": 1376.96, "t": "Vamos começar em três, dois, um."}, {"s": 1376.96, "e": 1378.72, "t": "Vamos."}, {"s": 1378.72, "e": 1381.04, "t": "Elas andam a tirar um curso de"}, {"s": 1381.04, "e": 1384.0, "t": "fotografia."}, {"s": 1386.72, "e": 1389.44, "t": "Queria saber se tem mesa para duas"}, {"s": 1389.44, "e": 1392.24, "t": "pessoas."}, {"s": 1394.96, "e": 1397.84, "t": "Ontem encontrei uma amiga que não via há"}, {"s": 1397.84, "e": 1400.56, "t": "meses."}, {"s": 1403.76, "e": 1406.52, "t": "Acho que é preferível adiarmos a"}, {"s": 1406.52, "e": 1409.16, "t": "reunião."}, {"s": 1411.56, "e": 1414.0, "t": "O banco já estava fechado quando nós"}, {"s": 1414.0, "e": 1416.84, "t": "chegamos."}, {"s": 1419.4, "e": 1422.28, "t": "Ele disse-me que ia chegar atrasado por"}, {"s": 1422.28, "e": 1425.64, "t": "causa do trânsito."}, {"s": 1428.84, "e": 1431.48, "t": "Não era melhor irmos de táxi? Está a"}, {"s": 1431.48, "e": 1434.68, "t": "começar a chover."}, {"s": 1437.6, "e": 1440.16, "t": "Assim que puderes, arranja forma de"}, {"s": 1440.16, "e": 1443.44, "t": "resolver o problema."}, {"s": 1446.28, "e": 1449.08, "t": "Gostaria que me explicassem as condições"}, {"s": 1449.08, "e": 1452.08, "t": "do empréstimo."}, {"s": 1454.92, "e": 1457.2, "t": "Se soubesse que a festa começava tão"}, {"s": 1457.2, "e": 1460.8, "t": "tarde, nem tinha vindo."}, {"s": 1463.36, "e": 1466.6, "t": "Muito bem, finalmente acabamos o teste."}, {"s": 1466.6, "e": 1468.2, "t": "Como é que correu?"}, {"s": 1468.2, "e": 1471.08, "t": "Agora, para veres as soluções e para"}, {"s": 1471.08, "e": 1473.56, "t": "fazeres a tua autoavaliação, vai à"}, {"s": 1473.56, "e": 1476.52, "t": "descrição deste vídeo e clica no link"}, {"s": 1476.52, "e": 1479.44, "t": "obter resultados do teste. É o segundo"}, {"s": 1479.44, "e": 1481.08, "t": "link na descrição."}, {"s": 1481.08, "e": 1483.88, "t": "Este link leva-te ao meu site, onde só"}, {"s": 1483.88, "e": 1486.76, "t": "tens de colocar o teu nome e e-mail e eu"}, {"s": 1486.76, "e": 1490.08, "t": "envio-te o PDF com as soluções do teste."}, {"s": 1490.08, "e": 1492.6, "t": "Assim, vais poder corrigir as tuas"}, {"s": 1492.6, "e": 1495.28, "t": "respostas e ver quais são as respostas"}, {"s": 1495.28, "e": 1499.08, "t": "certas e porquê. Depois, volta aqui ao"}, {"s": 1499.08, "e": 1502.24, "t": "YouTube e diz-me como decorreu o teste."}, {"s": 1502.24, "e": 1504.48, "t": "Estou muito curioso para saber o teu"}, {"s": 1504.48, "e": 1505.68, "t": "resultado."}, {"s": 1505.68, "e": 1507.96, "t": "Se o teste não correu muito bem,"}, {"s": 1507.96, "e": 1511.04, "t": "é porque ainda não tens um nível B1."}, {"s": 1511.04, "e": 1513.16, "t": "Se for esse o caso e quiseres melhorar o"}, {"s": 1513.16, "e": 1515.88, "t": "teu português, recomendo-te o meu curso"}, {"s": 1515.88, "e": 1519.32, "t": "de nível B1, Uma Viagem por Portugal."}, {"s": 1519.32, "e": 1522.48, "t": "Um curso completo de nível intermédio,"}, {"s": 1522.48, "e": 1525.16, "t": "baseado numa história que te vai levar"}, {"s": 1525.16, "e": 1528.4, "t": "do nível A2 ao nível B1, enquanto"}, {"s": 1528.4, "e": 1531.44, "t": "aprendes mais sobre Portugal e a cultura"}, {"s": 1531.44, "e": 1532.84, "t": "portuguesa."}, {"s": 1532.84, "e": 1535.96, "t": "Se, por outro lado, o teste correu bem,"}, {"s": 1535.96, "e": 1538.12, "t": "então é porque talvez já tenhas o nível"}, {"s": 1538.12, "e": 1539.08, "t": "B1"}, {"s": 1539.08, "e": 1541.64, "t": "e provavelmente estás pronto ou pronta"}, {"s": 1541.64, "e": 1545.24, "t": "para o meu curso de nível B2, A Vida em"}, {"s": 1545.24, "e": 1546.68, "t": "Portugal."}, {"s": 1546.68, "e": 1548.96, "t": "Um curso completo de nível intermédio"}, {"s": 1548.96, "e": 1552.12, "t": "alto, baseado em entrevistas com pessoas"}, {"s": 1552.12, "e": 1554.96, "t": "reais, onde vais aprender o português"}, {"s": 1554.96, "e": 1557.88, "t": "que realmente falamos no dia-a-dia"}, {"s": 1557.88, "e": 1560.48, "t": "e que te vai levar do nível B1 ao nível"}, {"s": 1560.48, "e": 1561.6, "t": "B2."}, {"s": 1561.6, "e": 1563.8, "t": "Se tiveres interesse em qualquer um dos"}, {"s": 1563.8, "e": 1566.28, "t": "cursos, podes ver mais informações"}, {"s": 1566.28, "e": 1568.96, "t": "clicando nos respectivos links na"}, {"s": 1568.96, "e": 1571.96, "t": "descrição e, finalmente, se gostaste"}, {"s": 1571.96, "e": 1574.2, "t": "deste teste e queres mais testes"}, {"s": 1574.2, "e": 1577.08, "t": "semelhantes, então clica na playlist que"}, {"s": 1577.08, "e": 1580.08, "t": "vai aparecer agora no ecrã e subscreve o"}, {"s": 1580.08, "e": 1583.4, "t": "canal para mais conteúdos como este."}, {"s": 1583.4, "e": 1586.2, "t": "Até à próxima."}]