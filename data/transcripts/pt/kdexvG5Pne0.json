[{"s": 0.0, "e": 4.08, "t": "Você sabe responder perguntas básicas?"}, {"s": 4.08, "e": 6.88, "t": "Nesse episódio a gente tem uma lista de"}, {"s": 6.88, "e": 10.32, "t": "perguntas do dia a dia e a gente vai ver"}, {"s": 10.32, "e": 12.36, "t": "como as pessoas aqui em São Paulo"}, {"s": 12.36, "e": 18.84, "t": "respondem. Curte o vídeo e vamos lá."}, {"s": 27.36, "e": 30.36, "t": ">> Qual é o seu nome? Caik."}, {"s": 30.36, "e": 33.68, "t": "Caik, prazer, Caik. Eu sou Leandro."}, {"s": 33.68, "e": 34.8, "t": ">> Prazer."}, {"s": 34.8, "e": 36.16, "t": ">> De onde você é?"}, {"s": 36.16, "e": 38.2, "t": ">> Eu sou de São Paulo, zona Leste. São"}, {"s": 38.2, "e": 39.6, "t": "Miguel Paulista."}, {"s": 39.6, "e": 41.12, "t": ">> São Miguel Paulista."}, {"s": 41.12, "e": 42.52, "t": ">> Ah, e trabalha aqui?"}, {"s": 42.52, "e": 44.24, "t": ">> Isso, trabalho aqui na Paulista."}, {"s": 44.24, "e": 46.84, "t": ">> Quantos anos você tem?"}, {"s": 46.84, "e": 49.28, "t": ">> Eu tenho 21 anos."}, {"s": 49.28, "e": 51.2, "t": ">> Muito jovem, mas [limpando a garganta]"}, {"s": 51.2, "e": 53.36, "t": "parece que tem menos."}, {"s": 53.36, "e": 55.64, "t": ">> Sempre me falam isso, infelizmente."}, {"s": 55.64, "e": 57.76, "t": ">> Com o que você trabalha? Eu sou"}, {"s": 57.76, "e": 61.32, "t": "propagandista farmacêutico,"}, {"s": 61.32, "e": 64.24, "t": "representante de de medicamentos."}, {"s": 64.24, "e": 67.32, "t": ">> E você estudou farmácia?"}, {"s": 67.32, "e": 69.92, "t": ">> Não, eu estudei administração, mas tem"}, {"s": 69.92, "e": 72.64, "t": "muitos farmacêuticos também. Tem muita"}, {"s": 72.64, "e": 74.16, "t": "gente da área de saúde nessa profissão,"}, {"s": 74.16, "e": 76.52, "t": "nesse ramo, mas tem muita gente de áreas"}, {"s": 76.52, "e": 78.48, "t": "mais comerciais mesmo, administração,"}, {"s": 78.48, "e": 80.2, "t": "publicidade, enfim."}, {"s": 80.2, "e": 82.12, "t": ">> Você trabalha com o quê?"}, {"s": 82.12, "e": 83.56, "t": ">> Sou cabeleireiro."}, {"s": 83.56, "e": 84.84, "t": ">> Hum."}, {"s": 84.84, "e": 87.4, "t": "E olha que eu eu parei você na rua e eu"}, {"s": 87.4, "e": 89.28, "t": "prestei atenção no seu cabelo."}, {"s": 89.28, "e": 89.8, "t": ">> É"}, {"s": 89.8, "e": 92.04, "t": ">> porque eu eu pensei que você era o meu"}, {"s": 92.04, "e": 94.48, "t": "amigo Aderbal. Eu falei o Aderbal cortou"}, {"s": 94.48, "e": 96.28, "t": "o cabelo. [risadas]"}, {"s": 96.28, "e": 98.44, "t": ">> Você me pegou. Você queria me amarrado"}, {"s": 98.44, "e": 99.64, "t": "conversa."}, {"s": 99.64, "e": 103.68, "t": ">> Não, foi foi genuíno. Quando você faz"}, {"s": 103.68, "e": 105.24, "t": "aniversário?"}, {"s": 105.24, "e": 108.64, "t": ">> Eu faço aniversário dia 15 de abril."}, {"s": 108.64, "e": 110.08, "t": ">> É dia 15 de abril."}, {"s": 110.08, "e": 113.36, "t": ">> 15 de abril eu faço no dia 28 de março."}, {"s": 113.36, "e": 114.64, "t": ">> Ah, legal."}, {"s": 114.64, "e": 116.76, "t": "Qual é a sua cor favorita?"}, {"s": 116.76, "e": 118.72, "t": ">> Vermelho."}, {"s": 118.72, "e": 121.56, "t": ">> Por que o vermelho?"}, {"s": 121.56, "e": 123.48, "t": ">> É, desde criança. Sempre gostei do"}, {"s": 123.48, "e": 124.28, "t": "vermelho."}, {"s": 124.28, "e": 128.08, "t": ">> O que você gosta de fazer?"}, {"s": 128.08, "e": 131.71, "t": ">> Assistir jogo de futebol. [risadas]"}, {"s": 131.76, "e": 134.04, "t": ">> E ele é palmeirense, viu?"}, {"s": 134.04, "e": 134.92, "t": ">> É palmeirense."}, {"s": 134.92, "e": 135.6, "t": ">> É palmeirense."}, {"s": 135.6, "e": 137.68, "t": ">> Muito palmeirense. Muito palmeirense."}, {"s": 137.68, "e": 139.76, "t": ">> Meu pai também é palmeirense."}, {"s": 139.76, "e": 141.48, "t": ">> Inteligente demais seu pai, viu?"}, {"s": 142.76, "e": 144.56, "t": "Já já vi que é diferenciado."}, {"s": 144.56, "e": 145.92, "t": ">> Meu nome é Leandro por causa de um"}, {"s": 145.92, "e": 148.03, "t": "jogador de Palmeiras, inclusive."}, {"s": 149.4, "e": 150.84, "t": ">> Onde você mora?"}, {"s": 150.84, "e": 152.96, "t": ">> São Miguel Paulista, na zona Leche."}, {"s": 152.96, "e": 154.28, "t": ">> Fica perto,"}, {"s": 154.28, "e": 156.6, "t": ">> um pouquinho longe. Dá uma horinha."}, {"s": 156.6, "e": 158.28, "t": ">> Uma hora de metrô."}, {"s": 158.28, "e": 160.52, "t": ">> Uma hora de trem metrô."}, {"s": 160.52, "e": 162.32, "t": ">> Você mora sozinho?"}, {"s": 162.32, "e": 164.72, "t": ">> Não, moro com"}, {"s": 164.72, "e": 169.88, "t": "tenho um filho e uma uma ex-mulher."}, {"s": 169.88, "e": 171.16, "t": ">> Mora com a ex-mulher?"}, {"s": 171.16, "e": 172.88, "t": ">> É."}, {"s": 172.88, "e": 176.32, "t": "Interessante. Quem mora com você?"}, {"s": 176.32, "e": 179.96, "t": ">> Eu e meu cachorro Pitoco. [risadas]"}, {"s": 179.96, "e": 182.0, "t": ">> Mas a gente mora perto. É uma cidade"}, {"s": 182.0, "e": 184.76, "t": "fica 100 km uma da outra. Eu moro em"}, {"s": 184.76, "e": 186.84, "t": "Salvador, ele mora em Feira de Santana."}, {"s": 186.84, "e": 188.24, "t": ">> Feira? Sim."}, {"s": 188.24, "e": 190.52, "t": ">> Pitoco. O cachorro Pitoco."}, {"s": 190.52, "e": 191.24, "t": ">> Pitoco."}, {"s": 191.24, "e": 192.48, "t": ">> É uma boa companhia."}, {"s": 192.48, "e": 195.08, "t": ">> É danado que só [risadas]"}, {"s": 195.08, "e": 197.44, "t": "come sofá, roi parede, mas é uma boa"}, {"s": 197.44, "e": 199.6, "t": "companhia."}, {"s": 199.6, "e": 202.4, "t": "Quantos irmãos você tem?"}, {"s": 202.4, "e": 203.6, "t": ">> Tenho cinco."}, {"s": 203.6, "e": 208.04, "t": ">> Cinco irmãos? Uau, que família grande."}, {"s": 208.04, "e": 210.36, "t": "E como é crescer numa casa de cinco"}, {"s": 210.36, "e": 211.6, "t": "irmãos?"}, {"s": 211.6, "e": 214.24, "t": ">> É porque os meus pais são separados. Aí"}, {"s": 214.24, "e": 216.2, "t": "são três por parte de pai e dois por"}, {"s": 216.2, "e": 217.6, "t": "parte de mãe."}, {"s": 217.6, "e": 219.36, "t": ">> Que aí eles se casaram e tiveram outros"}, {"s": 219.36, "e": 220.32, "t": "filhos."}, {"s": 220.32, "e": 221.8, "t": ">> Você tem filhos?"}, {"s": 221.8, "e": 224.84, "t": ">> Não, sou muito jovem para isso. Sou"}, {"s": 224.84, "e": 226.72, "t": "muito jovem."}, {"s": 226.72, "e": 229.28, "t": "Não, você é jovem, mas não é tão jovem a"}, {"s": 229.28, "e": 230.96, "t": "ponto de não poder ter filhos."}, {"s": 230.96, "e": 233.24, "t": ">> Exato. Mas não é meu plano agora. É um"}, {"s": 233.24, "e": 236.52, "t": "plano futuro."}, {"s": 243.32, "e": 246.04, "t": ">> Tem uma pergunta que é básica e que vai"}, {"s": 246.04, "e": 248.96, "t": "ajudar você a saber um monte de coisas"}, {"s": 248.96, "e": 252.44, "t": "em português. O que é isso? Pergunta"}, {"s": 252.44, "e": 254.84, "t": "pros seus amigos. O que é isso? O que é"}, {"s": 254.84, "e": 257.52, "t": "isso? Você vai descobrir um monte de"}, {"s": 257.52, "e": 260.96, "t": "coisa. E lá na nossa comunidade do"}, {"s": 260.96, "e": 264.16, "t": "Discord, a gente se sente entre amigos."}, {"s": 264.16, "e": 266.68, "t": "Você pode, por exemplo, postar uma foto"}, {"s": 266.68, "e": 269.24, "t": "e perguntar: \"O que é isso?\""}, {"s": 269.24, "e": 271.84, "t": "Eu, o Dani e as outras pessoas da"}, {"s": 271.84, "e": 275.6, "t": "comunidade vão adorar responder."}, {"s": 275.6, "e": 277.88, "t": "Para participar da comunidade do Ey"}, {"s": 277.88, "e": 281.68, "t": "Português, tem um link na descrição."}, {"s": 281.68, "e": 283.88, "t": "Clica nesse link, saiba mais"}, {"s": 283.88, "e": 285.44, "t": "informações,"}, {"s": 285.44, "e": 289.96, "t": "se torne um membro e venha saber o que é"}, {"s": 289.96, "e": 292.96, "t": "isso, o que é a comunidade do Sport"}, {"s": 292.96, "e": 296.72, "t": "Guiz. Estamos esperando você."}, {"s": 296.72, "e": 298.74, "t": ">> [música]"}, {"s": 302.24, "e": 303.6, "t": ">> Oi, tudo bem?"}, {"s": 303.6, "e": 305.16, "t": ">> Tudo bem. E você?"}, {"s": 305.16, "e": 307.72, "t": ">> Eu vou bem. Obrigado."}, {"s": 307.72, "e": 309.68, "t": "O que você tá fazendo?"}, {"s": 309.68, "e": 312.76, "t": ">> Pagando conta só [risadas]"}, {"s": 312.76, "e": 313.68, "t": ">> e vivendo."}, {"s": 313.68, "e": 315.44, "t": ">> É."}, {"s": 315.44, "e": 317.12, "t": ">> Como foi seu dia?"}, {"s": 317.12, "e": 320.44, "t": ">> Foi bom. A gente acordou, se preparou"}, {"s": 320.44, "e": 323.24, "t": "pro dia, tomou um banhozinho, passou no"}, {"s": 323.24, "e": 326.0, "t": "mercado, só pegou uma coisinha para para"}, {"s": 326.0, "e": 327.36, "t": "dar um up e agora a gente vai pro"}, {"s": 327.36, "e": 328.28, "t": "mercadão."}, {"s": 328.28, "e": 330.36, "t": ">> Tem planos para hoje?"}, {"s": 330.36, "e": 332.48, "t": ">> Não, hoje eu não tenho planos. Vou ficar"}, {"s": 332.48, "e": 335.44, "t": "em casa, assistir um filme, ficar"}, {"s": 335.44, "e": 337.12, "t": "tranquila. Hoje é dia de folga."}, {"s": 337.12, "e": 339.2, "t": ">> Ah, que maravilha. Acho que às vezes o"}, {"s": 339.2, "e": 341.04, "t": "melhor é não ter plano, né?"}, {"s": 341.04, "e": 342.52, "t": ">> Né? Às vezes é bom, às vezes só"}, {"s": 342.52, "e": 344.28, "t": "descansar. [risadas]"}, {"s": 344.28, "e": 345.76, "t": ">> Que horas são?"}, {"s": 345.76, "e": 349.28, "t": ">> São 10:34. Hum. Amanhã."}, {"s": 349.28, "e": 351.12, "t": ">> 10:34 da manhã."}, {"s": 351.12, "e": 351.56, "t": ">> Isso."}, {"s": 351.56, "e": 352.84, "t": ">> Nossa, já"}, {"s": 352.84, "e": 355.08, "t": ">> já passou rápido o dia."}, {"s": 355.08, "e": 357.12, "t": ">> Será que vai chover?"}, {"s": 357.12, "e": 358.88, "t": ">> Não, acho que não vai chover. O céu tá"}, {"s": 358.88, "e": 361.88, "t": "tão claro, sem nuvens."}, {"s": 361.88, "e": 365.92, "t": ">> Tá bem azulzinho mesmo, né? Quem é ele?"}, {"s": 365.92, "e": 369.12, "t": ">> Ele é meu irmãozão, minha companhia. A"}, {"s": 369.12, "e": 371.68, "t": "gente tá fazendo viagem de irmãos aqui,"}, {"s": 371.68, "e": 374.0, "t": "aproveitando vários momentos. Meu irmão"}, {"s": 374.0, "e": 375.96, "t": "mais velho,"}, {"s": 375.96, "e": 379.04, "t": "meu conselheiro, meu exemplo. Tudo de"}, {"s": 379.04, "e": 380.56, "t": "bom. [risadas]"}, {"s": 380.56, "e": 382.12, "t": ">> Qual é o nome dele?"}, {"s": 382.12, "e": 383.4, "t": ">> Pedro."}, {"s": 383.4, "e": 386.52, "t": ">> Pedro. Oh, que bom. Que declaração pro"}, {"s": 386.52, "e": 387.0, "t": "irmão, hein?"}, {"s": 387.0, "e": 389.78, "t": ">> Gostou? Gostou? [risadas]"}, {"s": 394.56, "e": 399.68, "t": ">> Qual prato você recomenda? Eu recomendo"}, {"s": 399.68, "e": 401.84, "t": "o arroz com brócolis"}, {"s": 401.84, "e": 405.52, "t": "e batata frita e filé minon."}, {"s": 405.52, "e": 407.16, "t": ">> Hum."}, {"s": 407.16, "e": 408.96, "t": ">> Ou um frango. Ou um frango também. Eu"}, {"s": 408.96, "e": 410.36, "t": "sou muito fã de frango."}, {"s": 410.36, "e": 413.76, "t": ">> Eu nunca comi arroz com brócolis. É bom?"}, {"s": 413.76, "e": 416.0, "t": ">> É incrível. É o melhor tipo de arroz que"}, {"s": 416.0, "e": 416.8, "t": "tem."}, {"s": 416.8, "e": 418.68, "t": ">> Qual é o prato do dia?"}, {"s": 418.68, "e": 422.16, "t": ">> Prato do dia é virada paulista."}, {"s": 422.16, "e": 425.76, "t": "Arroz, feijão, batata frita. É. Ai, eu"}, {"s": 425.76, "e": 427.44, "t": "esqueci o que que é. Tem farofa?"}, {"s": 427.44, "e": 429.4, "t": ">> Tem, tem farofa."}, {"s": 429.4, "e": 430.16, "t": ">> Salada tem"}, {"s": 430.16, "e": 431.64, "t": ">> também. Acompanha."}, {"s": 431.64, "e": 433.56, "t": ">> Eu vou querer esse daí, por favor."}, {"s": 433.56, "e": 434.96, "t": ">> Tá bom, já trago para você."}, {"s": 434.96, "e": 438.36, "t": ">> Obrigado. O bife acebolado pode ser sem"}, {"s": 438.36, "e": 440.52, "t": "cebola?"}, {"s": 440.52, "e": 442.76, "t": ">> Não, [risadas]"}, {"s": 442.76, "e": 445.52, "t": "infelizmente o bifeolado não pode ser"}, {"s": 445.52, "e": 446.4, "t": "sem cebola."}, {"s": 446.4, "e": 449.64, "t": ">> Ah, então eu posso pedir um bife sem"}, {"s": 449.64, "e": 451.64, "t": "cebola?"}, {"s": 451.64, "e": 455.64, "t": "Pode, pode. É um diferente."}, {"s": 455.64, "e": 457.32, "t": ">> Então é esse que eu vou querer."}, {"s": 457.32, "e": 458.8, "t": ">> Perfeito."}, {"s": 458.8, "e": 461.76, "t": ">> Vocês têm PF?"}, {"s": 461.76, "e": 464.4, "t": ">> Com certeza."}, {"s": 464.4, "e": 468.12, "t": ">> Quais tipos de PF vocês têm hoje?"}, {"s": 468.12, "e": 471.8, "t": ">> Executivo e comercial."}, {"s": 471.8, "e": 475.04, "t": ">> Então, eu vou querer um bife com"}, {"s": 475.04, "e": 476.76, "t": "calabresa. Pode ser?"}, {"s": 476.76, "e": 478.88, "t": ">> Pode sim. Perfeito."}, {"s": 478.88, "e": 481.4, "t": ">> Obrigado. Pode embrulhar pra viagem?"}, {"s": 481.4, "e": 483.72, "t": ">> Claro, vou embrulhar pra viagem."}, {"s": 483.72, "e": 486.92, "t": ">> Obrigado. Então, hoje já tem janta."}, {"s": 486.92, "e": 489.36, "t": ">> Você vai querer alguma bebida?"}, {"s": 489.36, "e": 490.76, "t": ">> Eu tava pensando em algum suco. Qual que"}, {"s": 490.76, "e": 492.92, "t": "você me recomenda?"}, {"s": 492.92, "e": 495.6, "t": ">> Você gosta de caju?"}, {"s": 495.6, "e": 497.44, "t": ">> Gosto. É bom."}, {"s": 497.44, "e": 499.96, "t": ">> Suco de caju aqui da casa é muito bom."}, {"s": 499.96, "e": 501.04, "t": "Eu recomendo."}, {"s": 501.04, "e": 502.68, "t": ">> Eu vou querer um, então, por favor."}, {"s": 502.68, "e": 504.52, "t": ">> Onde é o banheiro?"}, {"s": 504.52, "e": 506.72, "t": ">> Banheiro é à direita. Você segue o final"}, {"s": 506.72, "e": 508.44, "t": "do corredor à direita."}, {"s": 508.44, "e": 509.64, "t": ">> Descendo a escada,"}, {"s": 509.64, "e": 511.4, "t": ">> pode descer a escada. Descendo a escada,"}, {"s": 511.4, "e": 512.48, "t": "final do corredor à direita."}, {"s": 512.48, "e": 514.92, "t": ">> Ah, ótimo. Obrigado. Vão querer"}, {"s": 514.92, "e": 516.96, "t": "sobremesa?"}, {"s": 516.96, "e": 519.24, "t": ">> Ah, sim. A gente vai querer sim. Aqui"}, {"s": 519.24, "e": 521.2, "t": "vem de Petigat."}, {"s": 521.2, "e": 523.8, "t": ">> Petigatô. Sim. Uma sobremesa bem"}, {"s": 523.8, "e": 526.12, "t": "brasileira."}, {"s": 526.12, "e": 527.94, "t": ">> Eu vou querer dois, então. Por favor."}, {"s": 528.96, "e": 532.44, "t": ">> A conta é junta ou separada?"}, {"s": 532.44, "e": 534.08, "t": ">> Junta. [roncando]"}, {"s": 534.08, "e": 538.42, "t": ">> OK. Eu vou trazer a maquininha."}, {"s": 542.32, "e": 543.6, "t": "Tem pão fresquinho."}, {"s": 543.6, "e": 545.92, "t": ">> Tem, tem pão fresquinho. Só agora."}, {"s": 545.92, "e": 549.32, "t": ">> Oba! Vim na hora certa."}, {"s": 549.32, "e": 551.08, "t": ">> Chegou agora. Chegou na hora."}, {"s": 551.08, "e": 554.32, "t": ">> Quanto tá o quilo do queijo prato? Tá"}, {"s": 554.32, "e": 558.07, "t": "caro. 40. Deve tá uns R$ 40 o quilo."}, {"s": 558.64, "e": 560.08, "t": ">> Eu acho que nem é 40."}, {"s": 560.08, "e": 561.88, "t": ">> Eu acho que é uns R$ 60"}, {"s": 561.88, "e": 564.28, "t": ">> mesmo. Queijo prato, rapaz. Está"}, {"s": 564.28, "e": 565.52, "t": "absurdo. Então,"}, {"s": 565.52, "e": 567.0, "t": ">> quer que eu esquente,"}, {"s": 567.0, "e": 569.16, "t": ">> por favor? Por favor."}, {"s": 569.16, "e": 571.08, "t": ">> Tá bom, eu vou pôr no um pouquinho lá no"}, {"s": 571.08, "e": 572.12, "t": "forno microondas."}, {"s": 572.12, "e": 574.36, "t": ">> Fechou? Obrigado. Ficou no aguardo."}, {"s": 574.36, "e": 576.28, "t": ">> Você quer essa cola?"}, {"s": 576.28, "e": 578.28, "t": ">> Sim, eu vou querer três, por favor."}, {"s": 578.28, "e": 579.92, "t": ">> 15 centavos."}, {"s": 579.92, "e": 582.3, "t": ">> Muito caro."}, {"s": 582.88, "e": 583.96, "t": "Pode ser."}, {"s": 583.96, "e": 587.6, "t": ">> Tá bom. [música]"}, {"s": 590.88, "e": 594.84, "t": ">> Deu R$ 40. Crédito ou débito?"}, {"s": 594.84, "e": 596.72, "t": ">> Pix."}, {"s": 596.72, "e": 600.64, "t": ">> Pix. Tudo bem. CPF na nota?"}, {"s": 600.64, "e": 602.44, "t": ">> Não, nunca peço."}, {"s": 602.44, "e": 604.8, "t": ">> Você quer a sua via?"}, {"s": 604.8, "e": 607.8, "t": ">> Não. Olho tudo no aplicativo."}, {"s": 607.8, "e": 610.2, "t": ">> Você vai querer a notinha?"}, {"s": 610.2, "e": 612.0, "t": ">> Não."}, {"s": 612.0, "e": 614.92, "t": ">> Ok. Parcelado ou à vista?"}, {"s": 614.92, "e": 617.52, "t": ">> Eu quero parcelado em cinco vezes."}, {"s": 617.52, "e": 620.72, "t": ">> Cinco vezes. A gente pode fazer até três"}, {"s": 620.72, "e": 623.32, "t": "vezes. Tudo bem? Sim, tudo bem. Tem"}, {"s": 623.32, "e": 624.52, "t": "juros?"}, {"s": 624.52, "e": 626.28, "t": ">> Não, três vezes sem juros."}, {"s": 626.28, "e": 627.72, "t": ">> Ok, aceito."}, {"s": 627.72, "e": 630.04, "t": ">> Quantas vezes?"}, {"s": 630.04, "e": 633.52, "t": ">> Casas Bahia 15 vezes. [risadas]"}, {"s": 633.52, "e": 636.04, "t": "Parcela perder de vista. Aí no máximo"}, {"s": 636.04, "e": 638.6, "t": "sem juros. [risadas]"}, {"s": 638.6, "e": 641.12, "t": ">> Tá bom. Eu eu posso parcelar em 12 sem"}, {"s": 641.12, "e": 641.96, "t": "juros."}, {"s": 641.96, "e": 646.2, "t": ">> Tá ótimo. Você fez o possível. [risadas]"}, {"s": 646.2, "e": 647.52, "t": "Aproximação."}, {"s": 647.52, "e": 650.84, "t": ">> Sim, aproximação."}, {"s": 659.64, "e": 662.24, "t": ">> Com licença. Você pode me ajudar?"}, {"s": 662.24, "e": 664.6, "t": ">> Claro. Qual a sua dúvida?"}, {"s": 664.6, "e": 668.16, "t": ">> Eu quero saber onde fica o Banco do"}, {"s": 668.16, "e": 668.96, "t": "Brasil."}, {"s": 668.96, "e": 670.8, "t": ">> Banco do Brasil. Se você seguir direto"}, {"s": 670.8, "e": 674.24, "t": "aqui na Avenida Paulista mesmo, a nessa"}, {"s": 674.24, "e": 675.88, "t": "mesma calçada você consegue já encontrar"}, {"s": 675.88, "e": 677.32, "t": "ele um pouquinho mais pra frente, uns"}, {"s": 677.32, "e": 678.96, "t": "dois minutinos andando."}, {"s": 678.96, "e": 681.88, "t": ">> Tá bom, obrigado. Onde fica o metrô mais"}, {"s": 681.88, "e": 683.88, "t": "próximo?"}, {"s": 683.88, "e": 686.16, "t": ">> Você segue reto [risadas]"}, {"s": 686.16, "e": 687.92, "t": "e é isso. É aqui na frente."}, {"s": 687.92, "e": 689.92, "t": ">> É, seguindo reto, virando na direita. É"}, {"s": 689.92, "e": 692.32, "t": "o a estação consolado, eu acho."}, {"s": 692.32, "e": 692.56, "t": ">> É,"}, {"s": 692.56, "e": 694.4, "t": ">> é lá que fica o metrô mais próximo."}, {"s": 694.4, "e": 695.32, "t": ">> Consolação."}, {"s": 695.32, "e": 697.48, "t": ">> Consolação. Isso. Consolação."}, {"s": 697.48, "e": 700.04, "t": ">> Ok. Obrigado. Obrigado pela informação."}, {"s": 700.04, "e": 702.36, "t": "Onde fica o ponto de ônibus?"}, {"s": 702.36, "e": 704.6, "t": ">> Ah, fica aqui no final da rua. É só você"}, {"s": 704.6, "e": 707.0, "t": "virar à esquerda"}, {"s": 707.0, "e": 709.6, "t": ">> lá. Passa ônibus para São Miguel."}, {"s": 709.6, "e": 711.64, "t": ">> Passa, passa ônibus para São Miguel."}, {"s": 711.64, "e": 714.8, "t": ">> Que ônibus eu pego para ir pro centro?"}, {"s": 714.8, "e": 717.64, "t": ">> Comércio Lapa. [risadas]"}, {"s": 717.64, "e": 718.32, "t": ">> Esse aí é"}, {"s": 718.32, "e": 720.72, "t": ">> aí de Salvador. É. Aí passa no centro."}, {"s": 720.72, "e": 722.56, "t": ">> Ele vai passar na rua do comércio."}, {"s": 722.56, "e": 723.72, "t": ">> Com certeza. Sim,"}, {"s": 723.72, "e": 725.56, "t": ">> absolutamente, velho."}, {"s": 725.56, "e": 728.52, "t": ">> Qual lado do metrô vai pro centro?"}, {"s": 728.52, "e": 730.52, "t": ">> O lado direito. Você pega a escada,"}, {"s": 730.52, "e": 733.8, "t": "desce, escada rolante e tá ali no metrô"}, {"s": 733.8, "e": 734.6, "t": "já."}, {"s": 734.6, "e": 739.76, "t": ">> Muito obrigado. Onde fica o MASP?"}, {"s": 740.64, "e": 742.32, "t": ">> A direita aqui, ó."}, {"s": 742.32, "e": 743.76, "t": ">> Dá para ir a pé?"}, {"s": 743.76, "e": 746.24, "t": ">> Dá."}, {"s": 746.24, "e": 747.88, "t": ">> Então, é logo, é logo ali."}, {"s": 747.88, "e": 750.2, "t": ">> Ah, 300 m."}, {"s": 750.2, "e": 753.91, "t": "300 m. Exatamente."}, {"s": 759.12, "e": 761.6, "t": ">> Esse ônibus vai pro centro."}, {"s": 761.6, "e": 763.48, "t": ">> Vai."}, {"s": 763.48, "e": 766.08, "t": ">> É o comércio Lapa. Lapa comércio."}, {"s": 766.08, "e": 767.92, "t": ">> Isso. [risadas]"}, {"s": 767.92, "e": 770.16, "t": "Você vai descer na estação da Lapa."}, {"s": 770.16, "e": 770.76, "t": ">> Aham."}, {"s": 770.76, "e": 773.64, "t": ">> E aí você já tá no centro. Aí você pode"}, {"s": 773.64, "e": 776.2, "t": "ir paraa Barra, que já é região de"}, {"s": 776.2, "e": 779.08, "t": "praia, cidade baixa, se quiser ir na"}, {"s": 779.08, "e": 780.72, "t": "igreja do Bom Fim."}, {"s": 780.72, "e": 781.32, "t": ">> Exatamente."}, {"s": 781.32, "e": 783.6, "t": ">> Só ponto turístico assim de Salvador."}, {"s": 783.6, "e": 787.68, "t": ">> Licença. E qual é a próxima estação?"}, {"s": 787.68, "e": 790.72, "t": ">> A próxima estação é Pavuna."}, {"s": 790.72, "e": 793.16, "t": ">> Pavuna. Ah, sempre quis conhecer a"}, {"s": 793.16, "e": 795.24, "t": "Pavuna. [risadas]"}, {"s": 795.24, "e": 796.64, "t": ">> É um lugar interessante."}, {"s": 796.64, "e": 798.88, "t": ">> Quanto custa a passagem"}, {"s": 798.88, "e": 802.0, "t": ">> hoje? Tá em torno de 5:20."}, {"s": 802.0, "e": 804.2, "t": "5:20 a passagem do metrô, que a de"}, {"s": 804.2, "e": 806.12, "t": "ônibus é 5, é 5,20 a do metrô, se eu não"}, {"s": 806.12, "e": 807.96, "t": "me engano. É isso mesmo."}, {"s": 807.96, "e": 809.64, "t": ">> É mais barato que Uber."}, {"s": 809.64, "e": 811.44, "t": ">> É bem mais barato que Uber, mas demora"}, {"s": 811.44, "e": 813.48, "t": "mais. E é um pouquinho de desconforto,"}, {"s": 813.48, "e": 816.36, "t": "dependendo do horário."}, {"s": 816.36, "e": 819.6, "t": ">> Qual horário? Horário de pico é, você"}, {"s": 819.6, "e": 822.12, "t": "sabe, horário de pico o pessoal tá tá"}, {"s": 822.12, "e": 824.84, "t": "muito amulado. Então, 5 da tarde, 8 da"}, {"s": 824.84, "e": 826.52, "t": "manhã é um horário muito cheio."}, {"s": 826.52, "e": 828.28, "t": ">> Ah, valeu. Eu vou evitar esse horário,"}, {"s": 828.28, "e": 830.55, "t": "então, porque eu tô turistando."}, {"s": 831.6, "e": 833.96, "t": "Onde eu compro a passagem?"}, {"s": 833.96, "e": 836.64, "t": ">> Na bilheteria."}, {"s": 836.64, "e": 840.76, "t": ">> Ah, bilheteria ali."}, {"s": 840.88, "e": 843.16, "t": ">> Eu acho que acho que desce aqui compra"}, {"s": 843.16, "e": 844.44, "t": "na bilheteria ali. Aí compra o"}, {"s": 844.44, "e": 846.0, "t": "cartãozinho, né?"}, {"s": 846.0, "e": 848.52, "t": "Esse lugar tá ocupado"}, {"s": 848.52, "e": 851.28, "t": ">> do meu lado? Não, eu vou tirar a mochila"}, {"s": 851.28, "e": 852.32, "t": "para você sentar."}, {"s": 852.32, "e": 855.72, "t": ">> Ah, obrigado."}, {"s": 860.04, "e": 862.2, "t": ">> Como foi a viagem?"}, {"s": 862.2, "e": 864.76, "t": ">> Muito boa. Sempre é boa."}, {"s": 864.76, "e": 867.56, "t": ">> O que você fez nessa viagem?"}, {"s": 867.56, "e": 869.8, "t": ">> Comi bastante, bebi com esses lugares"}, {"s": 869.8, "e": 871.6, "t": "novos, estava em boas companhias."}, {"s": 871.6, "e": 872.52, "t": ">> Deu entrevista."}, {"s": 872.52, "e": 873.92, "t": ">> Dei entrevista. [risadas] Então foi"}, {"s": 873.92, "e": 876.48, "t": "fantástico."}, {"s": 876.48, "e": 879.84, "t": ">> Quando você chega? Segunda."}, {"s": 879.84, "e": 881.36, "t": ">> Segunda [risadas]"}, {"s": 881.36, "e": 883.52, "t": ">> não. Eu estou aqui em São Paulo, não tô"}, {"s": 883.52, "e": 886.52, "t": "viajando."}, {"s": 890.76, "e": 892.88, "t": ">> Que horas é a reunião?"}, {"s": 892.88, "e": 895.8, "t": ">> Às 10."}, {"s": 895.8, "e": 898.36, "t": ">> Nossa, menina, mas já são 10:05."}, {"s": 898.36, "e": 900.92, "t": ">> Tô atrasada. [risadas]"}, {"s": 900.92, "e": 901.04, "t": "Você"}, {"s": 901.04, "e": 903.28, "t": ">> está ocupado?"}, {"s": 903.28, "e": 904.96, "t": "Se eu estou, eu falo que estou, né,"}, {"s": 904.96, "e": 906.88, "t": "culpado."}, {"s": 906.88, "e": 910.0, "t": "Geralmente quando eu estou atendendo"}, {"s": 910.0, "e": 913.56, "t": "alguma, alguns clientes, né,"}, {"s": 913.56, "e": 914.96, "t": "aí eu tô ocupado."}, {"s": 914.96, "e": 917.2, "t": ">> Ficou alguma dúvida?"}, {"s": 917.2, "e": 918.76, "t": ">> Não, nenhuma dúvida. Ah, não, mentira."}, {"s": 918.76, "e": 920.28, "t": "Qual o nome do canal?"}, {"s": 920.28, "e": 922.96, "t": ">> Ah, chama Easy Português."}, {"s": 922.96, "e": 925.28, "t": "É um canal que ajuda estrangeiros a"}, {"s": 925.28, "e": 928.0, "t": "aprender português. E a gente tá na rua"}, {"s": 928.0, "e": 930.12, "t": "entrevistando pessoas generosas como"}, {"s": 930.12, "e": 934.36, "t": "vocês há 4 anos. Caramba, 4 anos."}, {"s": 934.36, "e": 935.12, "t": ">> Então,"}, {"s": 935.12, "e": 936.36, "t": ">> muito obrigado."}, {"s": 936.36, "e": 939.36, "t": ">> Obrigado, viu? Perguntas simples,"}, {"s": 939.36, "e": 942.8, "t": "perguntas do dia a dia, mas você precisa"}, {"s": 942.8, "e": 945.2, "t": "estar preparado."}, {"s": 945.2, "e": 946.6, "t": "E é por isso que a gente faz esse"}, {"s": 946.6, "e": 948.96, "t": "trabalho. E é por isso que sempre no"}, {"s": 948.96, "e": 951.64, "t": "final do episódio a gente convida você"}, {"s": 951.64, "e": 953.16, "t": "para se tornar um membro do Easy"}, {"s": 953.16, "e": 955.04, "t": "Portugueses."}, {"s": 955.04, "e": 958.4, "t": "Eu espero você no próximo episódio."}, {"s": 958.4, "e": 962.28, "t": "Um beijo. Tchau."}, {"s": 962.28, "e": 966.56, "t": "Se torne um membro."}, {"s": 970.07, "e": 972.09, "t": ">> [música]"}]