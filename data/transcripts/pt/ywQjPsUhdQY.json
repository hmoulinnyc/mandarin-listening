[{"s": 0.0, "e": 3.6, "t": "Você percebe diferença entre o português"}, {"s": 3.6, "e": 6.8, "t": "falado e o português escrito?"}, {"s": 6.8, "e": 11.08, "t": "Gente, isso causa uma confusão."}, {"s": 11.08, "e": 13.88, "t": "Pra vocês terem ideia, muitas perguntas"}, {"s": 13.88, "e": 17.2, "t": "que a gente recebe lá na comunidade,"}, {"s": 17.2, "e": 20.24, "t": "elas têm a ver com essa diferença. E"}, {"s": 20.24, "e": 22.52, "t": "nesse episódio, a gente vai falar um"}, {"s": 22.52, "e": 24.92, "t": "pouco sobre essas diferenças"}, {"s": 24.92, "e": 26.76, "t": "e aí você vai poder organizar o seu"}, {"s": 26.76, "e": 30.36, "t": "pensamento enquanto você estiver falando"}, {"s": 30.36, "e": 32.8, "t": "ouvindo, escrevendo"}, {"s": 32.8, "e": 34.72, "t": "e"}, {"s": 34.72, "e": 36.16, "t": "lendo."}, {"s": 36.16, "e": 40.2, "t": "Então, curte o vídeo e vamos lá."}, {"s": 41.92, "e": 43.94, "t": ">> [música]"}, {"s": 44.96, "e": 47.52, "t": ">> Oralidade e escrita"}, {"s": 47.52, "e": 50.28, "t": "se complementam, obviamente, né? A gente"}, {"s": 50.28, "e": 53.2, "t": "tá falando da mesma língua."}, {"s": 53.2, "e": 56.16, "t": "Só que eu acredito"}, {"s": 56.16, "e": 57.32, "t": "não sei,"}, {"s": 57.32, "e": 60.12, "t": "acho que o cérebro funciona diferente"}, {"s": 60.12, "e": 62.56, "t": "quando você tá falando e escutando ou"}, {"s": 62.56, "e": 65.44, "t": "quando você tá escrevendo e lendo."}, {"s": 65.44, "e": 67.56, "t": "E é por isso que o Easy Portuguese"}, {"s": 67.56, "e": 70.44, "t": "existe também, né? Quando a gente vai na"}, {"s": 70.44, "e": 73.76, "t": "rua e entrevista pessoas a gente tá"}, {"s": 73.76, "e": 76.88, "t": "mostrando como o português falado é"}, {"s": 76.88, "e": 80.4, "t": "muito diferente do português escrito."}, {"s": 80.4, "e": 83.04, "t": "Eles têm semelhanças, porque a gente"}, {"s": 83.04, "e": 86.0, "t": "está falando, óbvio, da mesma língua, é"}, {"s": 86.0, "e": 88.0, "t": "o português brasileiro."}, {"s": 88.0, "e": 91.36, "t": "Mas a gente vai falar sobre isso"}, {"s": 91.36, "e": 95.36, "t": "com uma lista que você tem aí na mão."}, {"s": 95.36, "e": 98.4, "t": "Essa aqui, né? Isso, nessa lista tá bem"}, {"s": 98.4, "e": 101.8, "t": "assim explicado a diferença de interação"}, {"s": 101.8, "e": 104.04, "t": "entre o que é falar"}, {"s": 104.04, "e": 106.96, "t": "né? A oralidade, a escuta"}, {"s": 106.96, "e": 110.08, "t": "e o que é escrever. Uhum."}, {"s": 110.08, "e": 112.92, "t": "Vamos lá? Bora. Aqui a gente tem uma"}, {"s": 112.92, "e": 116.04, "t": "tabela que mostra de um lado a língua"}, {"s": 116.04, "e": 119.16, "t": "oral e a língua escrita do outro lado."}, {"s": 119.16, "e": 121.72, "t": ">> Sim. Posso falar uma coisa? Agradecer"}, {"s": 121.72, "e": 124.84, "t": "uma pessoa que é a minha professora lá"}, {"s": 124.84, "e": 127.68, "t": "da universidade. Ah, Bruna."}, {"s": 127.68, "e": 130.24, "t": "A Bruna Ruffano que dá aula para mim lá"}, {"s": 130.24, "e": 132.2, "t": "na pós-graduação."}, {"s": 132.2, "e": 135.88, "t": "Então, essa tabela eu agradeço a você,"}, {"s": 135.88, "e": 139.16, "t": "Bruna, que trabalha há muito tempo com"}, {"s": 139.16, "e": 141.6, "t": "estrangeiros aprendendo português. Ah,"}, {"s": 141.6, "e": 143.45, "t": "muito obrigado, Bruna."}, {"s": 143.45, "e": 144.2, "t": ">> [risadas]"}, {"s": 144.2, "e": 147.8, "t": ">> A primeira linha é: a língua oral é"}, {"s": 147.8, "e": 150.28, "t": "espontânea e natural."}, {"s": 150.28, "e": 153.56, "t": "E a língua escrita é um sistema rígido e"}, {"s": 153.56, "e": 156.08, "t": "tem normas gramaticais."}, {"s": 156.08, "e": 158.68, "t": ">> Uma das dificuldades da fala é"}, {"s": 158.68, "e": 160.96, "t": "justamente a espontaneidade,"}, {"s": 160.96, "e": 164.92, "t": "né? Você tem que lidar com algo que não"}, {"s": 164.92, "e": 168.76, "t": "tá fixo, né? Que você muitas vezes não"}, {"s": 168.76, "e": 172.27, "t": "pode repetir exatamente da mesma forma."}, {"s": 172.27, "e": 172.32, "t": ">> [roncando]"}, {"s": 172.32, "e": 175.6, "t": ">> Então, essa naturalidade"}, {"s": 175.6, "e": 177.12, "t": "que a fala tem,"}, {"s": 177.12, "e": 178.68, "t": "a escrita não tem."}, {"s": 178.68, "e": 179.16, "t": ">> Sim."}, {"s": 179.16, "e": 181.36, "t": ">> Num sentido de que você pode escrever"}, {"s": 181.36, "e": 183.8, "t": "muito bem naturalmente, mas o que tá"}, {"s": 183.8, "e": 188.0, "t": "escrito é uma coisa que tá antes, né?"}, {"s": 188.0, "e": 190.96, "t": "Tem um outro pensamento por trás."}, {"s": 190.96, "e": 193.28, "t": ">> Que você tem mais tempo para pensar"}, {"s": 193.28, "e": 195.56, "t": "quando você escreve, né?"}, {"s": 195.56, "e": 198.8, "t": "E aí, quando você fala, você"}, {"s": 198.8, "e": 199.76, "t": "é,"}, {"s": 199.76, "e": 201.09, "t": "hesita."}, {"s": 201.09, "e": 202.0, "t": ">> [risadas]"}, {"s": 202.0, "e": 204.92, "t": ">> Né? Então, você não não tem, às vezes, o"}, {"s": 204.92, "e": 208.56, "t": "seu pensamento não acompanha exatamente"}, {"s": 208.56, "e": 211.96, "t": "tudo aquilo que você quer falar."}, {"s": 211.96, "e": 214.52, "t": "Na escrita não, você escreve, aí você"}, {"s": 214.52, "e": 216.68, "t": "fala: \"Ah, tinha outra coisa que eu"}, {"s": 216.68, "e": 219.6, "t": "queria falar\". Aí você reescreve."}, {"s": 219.6, "e": 219.84, "t": ">> Sim."}, {"s": 219.84, "e": 223.04, "t": ">> Na fala não, você fala, você já falou."}, {"s": 223.04, "e": 224.84, "t": "Aí você lembrou de alguma coisa? Você"}, {"s": 224.84, "e": 227.08, "t": "faz um adendo e você vai adicionando"}, {"s": 227.08, "e": 229.8, "t": "informação em cima de informação."}, {"s": 229.8, "e": 233.88, "t": ">> Notícias e recados do Easy Portuguese."}, {"s": 233.88, "e": 236.76, "t": "A gente tá muito feliz porque"}, {"s": 236.76, "e": 240.68, "t": "acabou a primeira edição do Portuguese"}, {"s": 240.68, "e": 242.88, "t": "Living Intensive."}, {"s": 242.88, "e": 244.96, "t": "Então foram 10 semanas de português"}, {"s": 244.96, "e": 246.72, "t": "intensivo"}, {"s": 246.72, "e": 250.52, "t": "com pessoas maravilhosas que não tinham"}, {"s": 250.52, "e": 253.36, "t": "confiança em falar português."}, {"s": 253.36, "e": 255.2, "t": "E depois dessas 10 semanas com a"}, {"s": 255.2, "e": 257.12, "t": "estrutura que a gente apresenta nesse"}, {"s": 257.12, "e": 260.92, "t": "plano, as pessoas estão mais confiantes"}, {"s": 260.92, "e": 262.76, "t": "mais confortáveis com a língua"}, {"s": 262.76, "e": 264.08, "t": "portuguesa."}, {"s": 264.08, "e": 266.68, "t": "A gente vai ter uma segunda edição desse"}, {"s": 266.68, "e": 269.56, "t": "programa e para isso tem"}, {"s": 269.56, "e": 271.6, "t": ">> Tem uma lista de espera."}, {"s": 271.6, "e": 273.36, "t": "A lista de espera vai tá aqui na"}, {"s": 273.36, "e": 274.68, "t": "descrição."}, {"s": 274.68, "e": 277.24, "t": "Clica no link. Coloque seu nome lá se"}, {"s": 277.24, "e": 279.16, "t": "você tiver interesse nesse tipo de"}, {"s": 279.16, "e": 281.88, "t": "programa que quando tiver próximo a"}, {"s": 281.88, "e": 284.4, "t": "gente vai entrar em contato com você"}, {"s": 284.4, "e": 286.68, "t": "e quem sabe você vai participar da"}, {"s": 286.68, "e": 289.28, "t": "segunda versão do Easy Portuguese"}, {"s": 289.28, "e": 290.0, "t": "Living Intensive."}, {"s": 290.0, "e": 290.8, "t": ">> Intensive."}, {"s": 290.8, "e": 292.24, "t": ">> Então é isso."}, {"s": 292.24, "e": 295.24, "t": "Link na descrição e o seu nome na lista"}, {"s": 295.24, "e": 297.4, "t": "de espera."}, {"s": 297.4, "e": 298.56, "t": ">> Muito bem."}, {"s": 298.56, "e": 301.28, "t": "A segunda linha é: a língua oral é"}, {"s": 301.28, "e": 302.88, "t": "dinâmica."}, {"s": 302.88, "e": 306.52, "t": "E a língua escrita é estática e fixa."}, {"s": 306.52, "e": 307.68, "t": ">> Sim."}, {"s": 307.68, "e": 311.04, "t": "É, eu gosto da frase: o que está escrito"}, {"s": 311.04, "e": 312.44, "t": "está escrito."}, {"s": 312.44, "e": 312.84, "t": ">> [risadas]"}, {"s": 312.84, "e": 314.04, "t": ">> Maktub."}, {"s": 314.04, "e": 315.44, "t": ">> É material,"}, {"s": 315.44, "e": 318.88, "t": "né? Muita E a palavra na oralidade, ela"}, {"s": 318.88, "e": 319.92, "t": "é solta."}, {"s": 319.92, "e": 320.52, "t": ">> Uhum."}, {"s": 320.52, "e": 321.52, "t": ">> Ela flui, né?"}, {"s": 321.52, "e": 322.04, "t": ">> Sim."}, {"s": 322.04, "e": 324.72, "t": ">> Você não tem nenhuma representação,"}, {"s": 324.72, "e": 326.48, "t": "é, visual dela."}, {"s": 326.48, "e": 327.16, "t": ">> Uhum."}, {"s": 327.16, "e": 328.96, "t": ">> Você só tem o som"}, {"s": 328.96, "e": 329.16, "t": ">> Sim."}, {"s": 329.16, "e": 332.12, "t": ">> e essas ondas que tão passando aqui."}, {"s": 332.12, "e": 334.05, "t": "Caprichei na onda."}, {"s": 334.05, "e": 335.56, "t": ">> [risadas]"}, {"s": 335.56, "e": 336.6, "t": ">> É"}, {"s": 336.6, "e": 339.28, "t": "e que se se se dissipa, né?"}, {"s": 339.28, "e": 341.76, "t": ">> A língua falada também tá associada às"}, {"s": 341.76, "e": 344.4, "t": "suas emoções, né?"}, {"s": 344.4, "e": 345.8, "t": "Não é o oi."}, {"s": 345.8, "e": 347.32, "t": "Microfone."}, {"s": 347.32, "e": 349.48, "t": "Como você tá se sentindo daquela,"}, {"s": 349.48, "e": 351.24, "t": "naquele momento, né?"}, {"s": 351.24, "e": 354.68, "t": "E como essa língua falada vai sair,"}, {"s": 354.68, "e": 358.28, "t": "né? Você tá bravo? Você tá com medo?"}, {"s": 358.28, "e": 360.92, "t": "É, como vão sair essas palavras?"}, {"s": 360.92, "e": 363.56, "t": "Na escrita, né? Quantas vezes você manda"}, {"s": 363.56, "e": 365.2, "t": "uma mensagem"}, {"s": 365.2, "e": 367.2, "t": "num tom irônico"}, {"s": 367.2, "e": 369.44, "t": "e ninguém sabe que você tá sendo"}, {"s": 369.44, "e": 370.73, "t": "irônico,"}, {"s": 370.73, "e": 371.24, "t": ">> [risadas]"}, {"s": 371.24, "e": 373.44, "t": ">> as pessoas levam a sério."}, {"s": 373.44, "e": 375.92, "t": "Terceira linha diz:"}, {"s": 375.92, "e": 377.76, "t": "A língua oral"}, {"s": 377.76, "e": 381.76, "t": "é a língua em tempo real, imediata."}, {"s": 381.76, "e": 385.24, "t": "E a língua escrita, ela permanece"}, {"s": 385.24, "e": 388.52, "t": "Não, mentira, errei, volta."}, {"s": 388.52, "e": 391.0, "t": "Volta."}, {"s": 391.32, "e": 392.88, "t": "Terceira linha."}, {"s": 392.88, "e": 396.76, "t": "A língua oral é a palavra sonora."}, {"s": 396.76, "e": 399.6, "t": "E a língua escrita é a palavra gráfica."}, {"s": 399.6, "e": 401.8, "t": ">> Ah, foi o que a gente falou, né?"}, {"s": 401.8, "e": 402.16, "t": ">> Uhum."}, {"s": 402.16, "e": 405.56, "t": ">> O que, que existe aqui são sons trocados"}, {"s": 405.56, "e": 406.72, "t": "em português."}, {"s": 406.72, "e": 407.4, "t": ">> Uhum."}, {"s": 407.4, "e": 409.8, "t": ">> Que, vão ser transcritos."}, {"s": 409.8, "e": 410.32, "t": ">> Sim."}, {"s": 410.32, "e": 412.32, "t": ">> Então, aqui você tem a representação"}, {"s": 412.32, "e": 415.68, "t": "sonora e a representação gráfica."}, {"s": 415.68, "e": 416.12, "t": ">> Uhum."}, {"s": 416.12, "e": 419.4, "t": ">> É, isso pra ajudar você a aprender o"}, {"s": 419.4, "e": 421.96, "t": "português. O que a gente tenta fazer"}, {"s": 421.96, "e": 425.24, "t": "aqui nas legendas é reproduzir o que a"}, {"s": 425.24, "e": 426.68, "t": "gente fala."}, {"s": 426.68, "e": 427.68, "t": ">> Uhum."}, {"s": 427.68, "e": 431.88, "t": ">> Obviamente, usando regras gramaticais"}, {"s": 431.88, "e": 433.6, "t": "sempre que a gente pode."}, {"s": 433.6, "e": 434.27, "t": ">> Sim."}, {"s": 434.27, "e": 434.4, "t": ">> [risadas]"}, {"s": 434.4, "e": 438.24, "t": ">> Mas às vezes isso tem uma, uma"}, {"s": 438.24, "e": 439.44, "t": "adaptação."}, {"s": 439.44, "e": 443.16, "t": ">> Sim. Eu penso muito nisso porque"}, {"s": 443.16, "e": 447.08, "t": "eu vejo como o japonês, ele progrediu"}, {"s": 447.08, "e": 450.04, "t": "muito nesse sentido. Porque, como existe"}, {"s": 450.04, "e": 451.44, "t": "muito mangá,"}, {"s": 451.44, "e": 454.6, "t": "eles, eles já desapegaram muito dessa"}, {"s": 454.6, "e": 456.76, "t": "gramática escrita e da forma de"}, {"s": 456.76, "e": 457.84, "t": "escrever."}, {"s": 457.84, "e": 460.28, "t": "Então, eles tentam se aproximar o máximo"}, {"s": 460.28, "e": 463.84, "t": "possível da maneira como eles falam."}, {"s": 463.84, "e": 466.48, "t": "Então eles quebram muitas palavras, eles"}, {"s": 466.48, "e": 469.64, "t": "trocam vogais. Aqui no Brasil eu acho"}, {"s": 469.64, "e": 471.52, "t": "que a gente está muito longe disso, eu"}, {"s": 471.52, "e": 474.16, "t": "acho que a nossa língua escrita"}, {"s": 474.16, "e": 477.88, "t": "ela é muito mais, é, rígida."}, {"s": 477.88, "e": 479.52, "t": "Né? E é muito mais difícil você ver"}, {"s": 479.52, "e": 482.8, "t": "pessoas quebrando essas regras e"}, {"s": 482.8, "e": 486.8, "t": "escrevendo como a gente realmente fala."}, {"s": 486.8, "e": 488.24, "t": "Quarta linha."}, {"s": 488.24, "e": 490.04, "t": "São linhas."}, {"s": 490.04, "e": 494.4, "t": "A língua oral, língua em tempo real."}, {"s": 494.4, "e": 496.0, "t": "Imediata."}, {"s": 496.0, "e": 497.6, "t": "Língua escrita"}, {"s": 497.6, "e": 500.24, "t": "permanece ao longo do tempo."}, {"s": 500.24, "e": 502.72, "t": "Pode ser corrigida."}, {"s": 502.72, "e": 506.24, "t": ">> Hum, é, a gente comentou dessa questão"}, {"s": 506.24, "e": 507.84, "t": "da correção."}, {"s": 507.84, "e": 508.4, "t": ">> É."}, {"s": 508.4, "e": 510.88, "t": ">> Né? Escrever"}, {"s": 510.88, "e": 512.32, "t": "é escrever,"}, {"s": 512.32, "e": 515.16, "t": "apagar e escrever alguma coisa por cima."}, {"s": 515.16, "e": 515.56, "t": ">> Aham."}, {"s": 515.56, "e": 517.44, "t": ">> Né? Então,"}, {"s": 517.44, "e": 520.52, "t": "o que você deletou,"}, {"s": 520.52, "e": 523.0, "t": "a pessoa que vai ler nunca vai saber o"}, {"s": 523.0, "e": 524.24, "t": "que você deletou."}, {"s": 524.24, "e": 525.24, "t": ">> Né? Sim. [risadas]"}, {"s": 525.24, "e": 527.28, "t": ">> Enquanto você tá falando, a pessoa"}, {"s": 527.28, "e": 529.48, "t": "percebe tudo que você tá deletando da"}, {"s": 529.48, "e": 529.96, "t": "fala."}, {"s": 529.96, "e": 530.44, "t": ">> Uhum."}, {"s": 530.44, "e": 534.2, "t": ">> Porque você se engana, você"}, {"s": 534.2, "e": 537.12, "t": "pode dizer: \"Ah, não é isso."}, {"s": 537.12, "e": 538.24, "t": "É outra coisa\"."}, {"s": 538.24, "e": 538.64, "t": ">> Sim."}, {"s": 538.64, "e": 541.0, "t": ">> Ou a gente fala uma coisa assim."}, {"s": 541.0, "e": 542.68, "t": ">> Ih, falei besteira."}, {"s": 542.68, "e": 543.66, "t": ">> É."}, {"s": 543.66, "e": 543.76, "t": ">> [risadas]"}, {"s": 543.76, "e": 546.28, "t": ">> Ou a gente"}, {"s": 546.28, "e": 547.6, "t": ">> Já era, falou."}, {"s": 547.6, "e": 548.64, "t": ">> É."}, {"s": 548.64, "e": 550.84, "t": "Tem gente que fala alguma coisa assim:"}, {"s": 550.84, "e": 554.12, "t": "\"Eu tava lá em casa, minto, eu tava no"}, {"s": 554.12, "e": 555.45, "t": "trabalho\"."}, {"s": 555.45, "e": 557.12, "t": ">> [risadas]"}, {"s": 557.12, "e": 560.04, "t": ">> Ninguém vai escrever isso, né?"}, {"s": 560.04, "e": 562.52, "t": "Todo mundo vai deletar e escrever"}, {"s": 562.52, "e": 565.24, "t": "o que quer escrever, né?"}, {"s": 565.24, "e": 568.08, "t": "Próxima linha. Quantos são? 1, 2, 3, 4,"}, {"s": 568.08, "e": 569.16, "t": "5."}, {"s": 569.16, "e": 571.2, "t": "Quinta linha."}, {"s": 571.2, "e": 573.96, "t": "Língua oral, turnos de fala,"}, {"s": 573.96, "e": 577.2, "t": "sobreposição de vozes."}, {"s": 577.2, "e": 578.64, "t": "Não me interromper?"}, {"s": 578.64, "e": 580.04, "t": "Língua escrita."}, {"s": 580.04, "e": 581.64, "t": ">> Na língua escrita"}, {"s": 581.64, "e": 583.68, "t": ">> é mais precisa e elaborada."}, {"s": 583.68, "e": 585.56, "t": ">> Ah, e na língua falada?"}, {"s": 585.56, "e": 587.24, "t": ">> A gente se interrompe."}, {"s": 587.24, "e": 588.84, "t": ">> Eu Não, eu"}, {"s": 588.84, "e": 590.48, "t": "Eu Eu falo ou você fala?"}, {"s": 590.48, "e": 593.44, "t": ">> falar, mas a gente pode também alternar,"}, {"s": 593.44, "e": 595.04, "t": "porque tem turnos."}, {"s": 595.04, "e": 595.64, "t": ">> Turnos?"}, {"s": 595.64, "e": 597.8, "t": ">> É, se eu falo, enquanto eu tô falando,"}, {"s": 597.8, "e": 598.88, "t": "você espera um pouquinho."}, {"s": 598.88, "e": 600.36, "t": ">> Não, na minha vez eu falo, na sua vez"}, {"s": 600.36, "e": 601.44, "t": "você fala, beleza?"}, {"s": 601.44, "e": 602.6, "t": ">> é, mais ou menos assim."}, {"s": 602.6, "e": 604.48, "t": ">> tá. Entendi."}, {"s": 604.48, "e": 606.28, "t": "Mas, então."}, {"s": 606.28, "e": 607.85, "t": ">> Hum, chega."}, {"s": 607.85, "e": 609.32, "t": ">> [risadas]"}, {"s": 609.32, "e": 612.64, "t": ">> Sobreposição de fala. Isso acontece o"}, {"s": 612.64, "e": 613.8, "t": "tempo todo."}, {"s": 613.8, "e": 614.68, "t": ">> Hum."}, {"s": 614.68, "e": 616.88, "t": ">> E é uma dificuldade"}, {"s": 616.88, "e": 619.16, "t": "que a pessoa que tá aprendendo português"}, {"s": 619.16, "e": 622.52, "t": "tem, hum, porque uma pessoa que tá"}, {"s": 622.52, "e": 624.84, "t": "aprendendo português e ainda tá um pouco"}, {"s": 624.84, "e": 628.8, "t": "insegura em falar, ela sempre espera."}, {"s": 628.8, "e": 629.56, "t": ">> Hum."}, {"s": 629.56, "e": 631.88, "t": ">> Ela não pega a vez pra ela."}, {"s": 631.88, "e": 632.8, "t": ">> Hum."}, {"s": 632.8, "e": 635.08, "t": ">> E isso é comunicação."}, {"s": 635.08, "e": 636.92, "t": ">> Mas eu É assim,"}, {"s": 636.92, "e": 637.4, "t": ">> Hum."}, {"s": 637.4, "e": 639.8, "t": ">> eu ia mudar, eu tava em outra Minha"}, {"s": 639.8, "e": 641.48, "t": "cabeça estava em outro lugar."}, {"s": 641.48, "e": 642.56, "t": ">> Então."}, {"s": 642.56, "e": 643.16, "t": ">> [risadas]"}, {"s": 643.16, "e": 646.44, "t": ">> Eu acho que brasileiro fala em cima dos"}, {"s": 646.44, "e": 647.84, "t": "outros."}, {"s": 647.84, "e": 650.56, "t": "Quem tem dificuldade é ele aqui, ó. Por"}, {"s": 650.56, "e": 652.84, "t": "quê? Quando tá fazendo entrevista com"}, {"s": 652.84, "e": 655.92, "t": "duas pessoas, onde vai o microfone? Ai,"}, {"s": 655.92, "e": 657.76, "t": "não, porque esse falou isso, essa falou"}, {"s": 657.76, "e": 659.88, "t": "isso, tá uma falando em cima da outra e"}, {"s": 659.88, "e": 661.0, "t": "aí você fala,"}, {"s": 661.0, "e": 662.21, "t": "é isso."}, {"s": 662.21, "e": 664.12, "t": ">> [risadas]"}, {"s": 664.12, "e": 666.76, "t": ">> Um, dois, três, quatro, cinco, seis."}, {"s": 666.76, "e": 668.76, "t": "Sexta linha."}, {"s": 668.76, "e": 668.92, "t": ">> [roncando]"}, {"s": 668.92, "e": 670.52, "t": ">> Língua oral."}, {"s": 670.52, "e": 671.88, "t": "Gestos."}, {"s": 671.88, "e": 672.52, "t": ">> Ah."}, {"s": 672.52, "e": 674.92, "t": ">> Fisionomia."}, {"s": 674.92, "e": 676.8, "t": "Expressivi"}, {"s": 676.8, "e": 679.56, "t": "Expressividade."}, {"s": 679.56, "e": 682.56, "t": "Expressividade."}, {"s": 683.2, "e": 684.64, "t": "Língua escrita."}, {"s": 684.64, "e": 686.36, "t": "Não tem nada escrito."}, {"s": 686.36, "e": 688.28, "t": "Tá até em branco."}, {"s": 688.28, "e": 691.0, "t": ">> Mas o que tá escrito aí é possível"}, {"s": 691.0, "e": 692.0, "t": ">> Não tem nada escrito."}, {"s": 692.0, "e": 693.6, "t": ">> Ah, não tá nada escrito."}, {"s": 693.6, "e": 695.28, "t": ">> Realmente, tá vazio."}, {"s": 695.28, "e": 696.16, "t": ">> Então,"}, {"s": 696.16, "e": 698.76, "t": ">> Por que? Qual é a diferença? O que, qual"}, {"s": 698.76, "e": 700.68, "t": "seria o"}, {"s": 700.68, "e": 703.64, "t": "o correlato de gestos, fisionomia e"}, {"s": 703.64, "e": 705.64, "t": "expressividade"}, {"s": 705.64, "e": 707.36, "t": "na língua escrita?"}, {"s": 707.36, "e": 709.44, "t": ">> O máximo que a gente pode chegar na"}, {"s": 709.44, "e": 712.2, "t": "língua escrita com relação a isso é, às"}, {"s": 712.2, "e": 714.36, "t": "vezes, a pontuação."}, {"s": 714.36, "e": 715.04, "t": ">> Hum."}, {"s": 715.04, "e": 718.8, "t": ">> É, a pontuação ela dá, às vezes, essa"}, {"s": 718.8, "e": 721.08, "t": "intenção de"}, {"s": 721.08, "e": 723.44, "t": "Ah, isso é mais intenso, isso é uma"}, {"s": 723.44, "e": 724.44, "t": "pergunta."}, {"s": 724.44, "e": 725.48, "t": ">> Uhum."}, {"s": 725.48, "e": 727.32, "t": ">> Se é uma pergunta, tem uma entonação um"}, {"s": 727.32, "e": 729.28, "t": "pouco mais clara"}, {"s": 729.28, "e": 731.48, "t": "é, pras pessoas."}, {"s": 731.48, "e": 735.68, "t": "Mas, na língua, na língua oral,"}, {"s": 735.68, "e": 738.48, "t": "isso acontece o tempo todo, né?"}, {"s": 738.48, "e": 740.12, "t": "É, eu tô falando aqui, eu tô"}, {"s": 740.12, "e": 741.92, "t": "gesticulando,"}, {"s": 741.92, "e": 744.32, "t": "a minha testa tá enrugando,"}, {"s": 744.32, "e": 746.16, "t": "desenrugando,"}, {"s": 746.16, "e": 748.68, "t": "né? Eu tô pondo intenção, eu tô pondo"}, {"s": 748.68, "e": 750.16, "t": "volumes."}, {"s": 750.16, "e": 750.88, "t": ">> Sim."}, {"s": 750.88, "e": 753.0, "t": ">> E última linha,"}, {"s": 753.0, "e": 755.68, "t": "o con, é, língua oral, o contexto"}, {"s": 755.68, "e": 759.4, "t": "extralinguístico tem grande influência."}, {"s": 759.4, "e": 761.52, "t": "Língua escrita, o contexto"}, {"s": 761.52, "e": 765.48, "t": "extralinguístico tem menos importância."}, {"s": 765.48, "e": 769.52, "t": "O que é o contexto extralinguístico?"}, {"s": 769.52, "e": 771.2, "t": ">> A situação."}, {"s": 771.2, "e": 772.24, "t": ">> Hum."}, {"s": 772.24, "e": 775.28, "t": ">> Aqui a gente tá falando"}, {"s": 775.28, "e": 778.24, "t": "num estilo de episódio conversation."}, {"s": 778.24, "e": 779.04, "t": ">> Uhum."}, {"s": 779.04, "e": 782.2, "t": ">> Né? É diferente do episódio gravado na"}, {"s": 782.2, "e": 783.0, "t": "rua."}, {"s": 783.0, "e": 783.64, "t": ">> Sim."}, {"s": 783.64, "e": 786.24, "t": ">> É um contexto extralinguístico."}, {"s": 786.24, "e": 789.96, "t": "A gente tá falando de estar na rua, lá"}, {"s": 789.96, "e": 793.0, "t": "fora, em meio à cidade, em meio a outros"}, {"s": 793.0, "e": 796.84, "t": "ruídos. Ah, então,"}, {"s": 796.84, "e": 798.8, "t": "isso pra mim é o extralinguístico. É"}, {"s": 798.8, "e": 801.24, "t": "tudo que foge da ideia da palavra."}, {"s": 801.24, "e": 802.52, "t": ">> Uhum."}, {"s": 802.52, "e": 804.2, "t": ">> Ela coloca como, o contexto"}, {"s": 804.2, "e": 806.72, "t": "extralinguístico tem menos importância"}, {"s": 806.72, "e": 809.16, "t": "na língua escrita. Mas significa que"}, {"s": 809.16, "e": 811.8, "t": "ainda tem alguma importância, né? Alguma"}, {"s": 811.8, "e": 814.0, "t": "in influência."}, {"s": 814.0, "e": 818.0, "t": ">> Sim, o estado emocional de quem escreve."}, {"s": 818.0, "e": 818.4, "t": ">> Sim."}, {"s": 818.4, "e": 821.2, "t": ">> Com que intenção ela tá escrevendo. Acho"}, {"s": 821.2, "e": 824.6, "t": "que isso isso vai para além da da língua"}, {"s": 824.6, "e": 826.48, "t": "e da palavra, né?"}, {"s": 826.48, "e": 828.96, "t": "O contexto cultural é um contexto"}, {"s": 828.96, "e": 831.52, "t": "extralinguístico, sim."}, {"s": 831.52, "e": 835.04, "t": "E muito importante para se comunicar."}, {"s": 835.04, "e": 837.92, "t": "É, língua não é só língua. Isso é"}, {"s": 837.92, "e": 839.8, "t": "engraçado, né?"}, {"s": 839.8, "e": 840.08, "t": ">> Uhum."}, {"s": 840.08, "e": 843.0, "t": ">> É, quando você aprende uma língua, você"}, {"s": 843.0, "e": 844.32, "t": "tá"}, {"s": 844.32, "e": 846.48, "t": "na verdade"}, {"s": 846.48, "e": 849.04, "t": "dominando um mundo"}, {"s": 849.04, "e": 849.44, "t": ">> Uhum."}, {"s": 849.44, "e": 851.28, "t": ">> de circunstâncias,"}, {"s": 851.28, "e": 856.08, "t": "de cultura, de situações, né? E por isso"}, {"s": 856.08, "e": 858.44, "t": "é tão difícil."}, {"s": 858.44, "e": 860.96, "t": "É, admiro bastante as pessoas que tão aí"}, {"s": 860.96, "e": 865.0, "t": "nos vendo e aprendendo português."}, {"s": 865.0, "e": 868.88, "t": "Porque a gente sabe que é"}, {"s": 868.88, "e": 870.92, "t": "sair um pouquinho lá da sua zona de"}, {"s": 870.92, "e": 875.6, "t": "conforto, seu ninho, a sua língua mãe"}, {"s": 875.6, "e": 878.2, "t": "para ir para um lugar onde a sua língua"}, {"s": 878.2, "e": 879.6, "t": "não é mãe."}, {"s": 879.6, "e": 880.76, "t": ">> Não. [risadas]"}, {"s": 880.76, "e": 882.8, "t": ">> Né? É"}, {"s": 882.8, "e": 885.32, "t": "é algo assim corajoso,"}, {"s": 885.32, "e": 886.92, "t": "desconfortável."}, {"s": 886.92, "e": 889.92, "t": ">> Sim, vai enfrentar muitas dificuldades,"}, {"s": 889.92, "e": 890.76, "t": "né?"}, {"s": 890.76, "e": 894.36, "t": ">> Mas ao mesmo tempo, você encontra aí"}, {"s": 894.36, "e": 898.0, "t": "no mundo todo pessoas que tão"}, {"s": 898.0, "e": 900.36, "t": "querendo sair desse ninho, né? Pessoas"}, {"s": 900.36, "e": 903.16, "t": "que tão afim de aprender com você."}, {"s": 903.16, "e": 905.96, "t": "Canais como o Easy Portuguese, né? O"}, {"s": 905.96, "e": 908.24, "t": "trabalho que a gente faz aqui"}, {"s": 908.24, "e": 910.68, "t": "é maravilhoso para a gente também. A"}, {"s": 910.68, "e": 913.0, "t": "gente aprende muitas coisas,"}, {"s": 913.0, "e": 916.84, "t": "porque a gente tá também ah"}, {"s": 916.84, "e": 918.76, "t": "saindo um pouco do nosso ninho, se"}, {"s": 918.76, "e": 922.12, "t": "relacionando com culturas, com pessoas,"}, {"s": 922.12, "e": 924.04, "t": "né? Então a gente"}, {"s": 924.04, "e": 927.36, "t": "usa o português como uma grande ponte"}, {"s": 927.36, "e": 929.44, "t": "para essas outras coisas."}, {"s": 929.44, "e": 932.64, "t": "Esse contexto extralinguístico."}, {"s": 932.64, "e": 934.72, "t": "Se você tá vendo esse vídeo até aqui, é"}, {"s": 934.72, "e": 937.6, "t": "porque você gosta dessa ideia"}, {"s": 937.6, "e": 940.4, "t": "e a gente espera que você se torne um"}, {"s": 940.4, "e": 942.6, "t": "membro do canal"}, {"s": 942.6, "e": 943.68, "t": "e"}, {"s": 943.68, "e": 947.52, "t": "apoie, reforce essa ideia que a gente"}, {"s": 947.52, "e": 950.0, "t": "acha tão maravilhosa e que nos faz tão"}, {"s": 950.0, "e": 950.56, "t": "bem."}, {"s": 950.56, "e": 951.72, "t": ">> Sim."}, {"s": 951.72, "e": 954.04, "t": "Então é isso. Muito obrigado, Léo, por"}, {"s": 954.04, "e": 956.24, "t": "trazer essa tabela"}, {"s": 956.24, "e": 958.52, "t": "que gerou uma boa conversa."}, {"s": 958.52, "e": 961.92, "t": ">> Sim. Espero que o pessoal tenha gostado."}, {"s": 961.92, "e": 964.92, "t": ">> Sim. E como você vê a língua falada e a"}, {"s": 964.92, "e": 966.6, "t": "língua escrita?"}, {"s": 966.6, "e": 968.08, "t": "Continua essa conversa aqui nos"}, {"s": 968.08, "e": 969.32, "t": "comentários. [música]"}, {"s": 969.32, "e": 970.28, "t": ">> Muito obrigado."}, {"s": 970.28, "e": 972.69, "t": ">> Obrigado, gente, por assistir até aqui"}, {"s": 974.16, "e": 975.96, "t": "E lembrem-se, se torne um membro porque"}, {"s": 975.96, "e": 978.36, "t": "assim vocês ajudam esse canal a"}, {"s": 978.36, "e": 979.52, "t": "continuar."}, {"s": 979.52, "e": 982.0, "t": "Beijo. Até o próximo episódio."}, {"s": 982.0, "e": 982.51, "t": ">> Tchau."}, {"s": 982.51, "e": 982.72, "t": ">> [música][limpando a garganta]"}, {"s": 982.72, "e": 984.0, "t": ">> Tchau."}, {"s": 984.0, "e": 986.28, "t": ">> Tem café? Tem café?"}, {"s": 986.28, "e": 986.8, "t": ">> Café?"}, {"s": 986.8, "e": 988.96, "t": ">> Quem quer café?"}, {"s": 988.96, "e": 990.44, "t": "Apareceu ali."}, {"s": 990.44, "e": 992.32, "t": ">> Eu senti um cheiro de café."}, {"s": 992.32, "e": 992.8, "t": ">> Tá ali."}, {"s": 992.8, "e": 993.64, "t": ">> Eu vou pegar."}, {"s": 993.64, "e": 995.92, "t": ">> Vai lá."}, {"s": 997.04, "e": 998.24, "t": "Ai."}, {"s": 998.24, "e": 998.48, "t": "Tá aqui."}, {"s": 998.48, "e": 1000.76, "t": ">> Gostaria de uma xícara de café."}, {"s": 1000.76, "e": 1002.82, "t": ">> Tá aqui mais."}, {"s": 1002.82, "e": 1004.84, "t": ">> [risadas]"}]