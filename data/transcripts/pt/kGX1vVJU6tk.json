[{"s": 0.0, "e": 1.84, "t": "Para quem está começando a aprender"}, {"s": 1.84, "e": 4.72, "t": "português, uma lista de verbos é"}, {"s": 4.72, "e": 6.28, "t": "essencial."}, {"s": 6.28, "e": 8.4, "t": "E nesse episódio, a gente vai fazer"}, {"s": 8.4, "e": 11.56, "t": "perguntas para as pessoas na rua com"}, {"s": 11.56, "e": 14.48, "t": "esses verbos. Curte o vídeo"}, {"s": 14.48, "e": 17.04, "t": "e vamos lá."}, {"s": 17.68, "e": 19.7, "t": ">> [música]"}, {"s": 21.8, "e": 23.68, "t": ">> Ser."}, {"s": 23.68, "e": 25.04, "t": "Eu sou."}, {"s": 25.04, "e": 27.72, "t": "Você é."}, {"s": 28.0, "e": 30.4, "t": ">> Ser."}, {"s": 31.72, "e": 34.0, "t": ">> Você é do Rio de Janeiro?"}, {"s": 34.0, "e": 35.6, "t": ">> Sou."}, {"s": 35.6, "e": 36.68, "t": "Sou do Rio de Janeiro."}, {"s": 36.68, "e": 37.72, "t": ">> De qual lugar?"}, {"s": 37.72, "e": 41.08, "t": ">> Sou de Niterói, uma cidade"}, {"s": 41.08, "e": 43.44, "t": "relativamente pequena, não é pequena,"}, {"s": 43.44, "e": 45.0, "t": "mas também não é grande,"}, {"s": 45.0, "e": 46.52, "t": "mas é uma uma boa metrópole para se"}, {"s": 46.52, "e": 47.52, "t": "morar."}, {"s": 47.52, "e": 48.96, "t": ">> Ter."}, {"s": 48.96, "e": 50.4, "t": "Eu tenho."}, {"s": 50.4, "e": 53.72, "t": "Você tem."}, {"s": 53.72, "e": 56.0, "t": ">> Ter."}, {"s": 56.0, "e": 57.76, "t": ">> Você tem filhos?"}, {"s": 57.76, "e": 60.48, "t": ">> Sim, eu tenho dois filhos,"}, {"s": 60.48, "e": 62.28, "t": "um menino e uma menina."}, {"s": 62.28, "e": 63.48, "t": ">> Muito bom."}, {"s": 63.48, "e": 65.6, "t": "Fazer."}, {"s": 65.6, "e": 67.4, "t": "Eu faço."}, {"s": 67.4, "e": 70.6, "t": "Você faz."}, {"s": 70.6, "e": 71.76, "t": ">> Fazer."}, {"s": 71.76, "e": 74.56, "t": "Fazer é o verbo."}, {"s": 74.56, "e": 77.92, "t": ">> Você faz academia?"}, {"s": 77.92, "e": 80.88, "t": ">> Eu não, mas eu faço muito exercício no"}, {"s": 80.88, "e": 82.72, "t": "trabalho, já que eu subo muita escada,"}, {"s": 82.72, "e": 84.44, "t": "subo e desço, então estou indo para lá e"}, {"s": 84.44, "e": 86.2, "t": "para cá, então meu cardio do dia está"}, {"s": 86.2, "e": 88.56, "t": "feito."}, {"s": 88.56, "e": 90.48, "t": ">> Gostar."}, {"s": 90.48, "e": 91.84, "t": "Eu gosto."}, {"s": 91.84, "e": 94.56, "t": "Você gosta."}, {"s": 94.56, "e": 96.56, "t": ">> Gostar."}, {"s": 96.56, "e": 99.44, "t": ">> Você gosta de doce?"}, {"s": 99.44, "e": 102.44, "t": ">> Eu gosto de doce, muito."}, {"s": 102.44, "e": 104.08, "t": ">> Quais doces? [roncando]"}, {"s": 104.08, "e": 106.48, "t": ">> Eu gosto de chocolate, eu gosto de"}, {"s": 106.48, "e": 107.88, "t": "pudim."}, {"s": 107.88, "e": 109.92, "t": ">> Estar."}, {"s": 109.92, "e": 111.64, "t": "Eu estou."}, {"s": 111.64, "e": 115.0, "t": "Você está."}, {"s": 115.16, "e": 117.6, "t": ">> Estar."}, {"s": 117.6, "e": 120.48, "t": ">> Você tá feliz?"}, {"s": 121.32, "e": 124.0, "t": ">> Então, é, eu queria tá num momento"}, {"s": 124.0, "e": 125.36, "t": "melhor da minha vida."}, {"s": 125.36, "e": 127.4, "t": "Eu tô vivendo bem, eu tô, minha empresa"}, {"s": 127.4, "e": 130.52, "t": "tá fluindo, mas eu, como eu tenho 30"}, {"s": 130.52, "e": 132.24, "t": "anos, eu queria já estar casado, com"}, {"s": 132.24, "e": 135.28, "t": "filho e ainda não não tive essa"}, {"s": 135.28, "e": 136.88, "t": "essa oportunidade. Então, acho que a"}, {"s": 136.88, "e": 139.64, "t": "felicidade tá um pouco, tá chegando, tá"}, {"s": 139.64, "e": 140.52, "t": "chegando."}, {"s": 140.52, "e": 142.12, "t": ">> Poder."}, {"s": 142.12, "e": 143.76, "t": "Eu posso."}, {"s": 143.76, "e": 147.28, "t": "Você pode."}, {"s": 147.28, "e": 149.84, "t": ">> Poder."}, {"s": 149.88, "e": 153.76, "t": ">> Você pode repetir?"}, {"s": 153.8, "e": 155.2, "t": ">> É,"}, {"s": 155.2, "e": 156.55, "t": "posso."}, {"s": 156.55, "e": 157.36, "t": ">> [risadas]"}, {"s": 157.36, "e": 158.48, "t": ">> Ótimo."}, {"s": 158.48, "e": 159.88, "t": "Querer."}, {"s": 159.88, "e": 161.48, "t": "Eu quero."}, {"s": 161.48, "e": 164.04, "t": "Você quer."}, {"s": 164.04, "e": 166.0, "t": ">> Querer."}, {"s": 166.0, "e": 168.2, "t": ">> Você quer almoçar?"}, {"s": 168.2, "e": 170.28, "t": ">> Eu quero. Tô louco pra chegar em casa e"}, {"s": 170.28, "e": 172.32, "t": "poder almoçar. Vou pro trabalho depois"}, {"s": 172.32, "e": 173.6, "t": "daqui."}, {"s": 173.6, "e": 175.52, "t": "Mas precisa comer antes, né? Porque"}, {"s": 175.52, "e": 176.8, "t": "senão não dá."}, {"s": 176.8, "e": 178.92, "t": ">> Saber."}, {"s": 178.92, "e": 180.68, "t": "Eu sei."}, {"s": 180.68, "e": 183.96, "t": "Você sabe."}, {"s": 184.4, "e": 187.0, "t": ">> Saber."}, {"s": 187.72, "e": 189.64, "t": ">> Você sabe"}, {"s": 189.64, "e": 192.76, "t": "como eu faço pra chegar até o MASP?"}, {"s": 192.76, "e": 194.24, "t": ">> Sei."}, {"s": 194.24, "e": 196.04, "t": ">> Como é?"}, {"s": 196.04, "e": 198.92, "t": ">> É, é só ir andando aqui até o final da"}, {"s": 198.92, "e": 200.48, "t": "avenida."}, {"s": 200.48, "e": 202.56, "t": ">> Conhecer."}, {"s": 202.56, "e": 204.48, "t": "Eu conheço."}, {"s": 204.48, "e": 208.32, "t": "Você conhece."}, {"s": 208.4, "e": 210.96, "t": ">> Conhecer."}, {"s": 211.28, "e": 213.44, "t": ">> Você me conhece?"}, {"s": 213.44, "e": 216.15, "t": ">> Eu não te conheço, mas conheci agora."}, {"s": 216.15, "e": 217.44, "t": ">> [risadas]"}, {"s": 217.44, "e": 219.0, "t": ">> Falar."}, {"s": 219.0, "e": 220.56, "t": "Eu falo."}, {"s": 220.56, "e": 223.36, "t": "Você fala."}, {"s": 223.36, "e": 225.8, "t": ">> Falar."}, {"s": 225.8, "e": 228.08, "t": ">> Você fala outro idioma além do"}, {"s": 228.08, "e": 229.44, "t": "português?"}, {"s": 229.44, "e": 231.22, "t": ">> I do speak English."}, {"s": 231.22, "e": 232.68, "t": ">> [risadas]"}, {"s": 232.68, "e": 234.92, "t": ">> E tô estudando"}, {"s": 234.92, "e": 236.24, "t": "um pouquinho de japonês também, porque"}, {"s": 236.24, "e": 237.48, "t": "eu tenho um amigo bem próximo que ele é"}, {"s": 237.48, "e": 239.56, "t": "japonês. Aí ele tá me ensinando umas"}, {"s": 239.56, "e": 242.16, "t": "coisinhas. Não vou dar exemplo de nada"}, {"s": 242.16, "e": 244.28, "t": "agora, porque eu tô aprendendo."}, {"s": 244.28, "e": 245.72, "t": "E"}, {"s": 245.72, "e": 246.88, "t": "Arigato gozaimasu."}, {"s": 246.88, "e": 248.48, "t": ">> Doitashimashite. [risadas]"}, {"s": 248.48, "e": 251.08, "t": ">> Otsukaresama."}, {"s": 251.08, "e": 253.44, "t": ">> Se você quiser praticar um pouco mais, a"}, {"s": 253.44, "e": 256.2, "t": "gente deixou um link na descrição com"}, {"s": 256.2, "e": 259.0, "t": "exercícios gratuitos de três episódios"}, {"s": 259.0, "e": 260.76, "t": "do Easy Portuguese."}, {"s": 260.76, "e": 263.96, "t": "Clica no link, entra na nossa plataforma"}, {"s": 263.96, "e": 266.4, "t": "e aproveita os exercícios."}, {"s": 266.4, "e": 267.68, "t": "Morar."}, {"s": 267.68, "e": 269.2, "t": "Eu moro."}, {"s": 269.2, "e": 272.52, "t": "Você mora."}, {"s": 272.6, "e": 275.0, "t": ">> Morar."}, {"s": 275.56, "e": 278.56, "t": ">> Ah, você mora nesse bairro?"}, {"s": 278.56, "e": 281.4, "t": ">> Não, eu moro lá no Tucuruvi."}, {"s": 281.4, "e": 283.84, "t": "É, daí eu tenho que pegar dois metrôs,"}, {"s": 283.84, "e": 285.88, "t": "mas é bem rapidinho andar de metrô aqui"}, {"s": 285.88, "e": 286.88, "t": "é"}, {"s": 286.88, "e": 288.4, "t": "é, não tem porque andar de carro, né?"}, {"s": 288.4, "e": 290.6, "t": "Porque São Paulo é um trânsito absurdo,"}, {"s": 290.6, "e": 292.24, "t": "então vale mais a pena andar de metrô do"}, {"s": 292.24, "e": 293.28, "t": "que de carro."}, {"s": 293.28, "e": 294.76, "t": ">> Dar."}, {"s": 294.76, "e": 296.44, "t": "Eu dou."}, {"s": 296.44, "e": 299.76, "t": "Você dá."}, {"s": 299.92, "e": 302.0, "t": ">> Dar."}, {"s": 302.0, "e": 304.84, "t": ">> Você dá presente para os seus amigos no"}, {"s": 304.84, "e": 306.68, "t": "aniversário?"}, {"s": 306.68, "e": 308.32, "t": ">> Só para aqueles que merecem, né? Tô"}, {"s": 308.32, "e": 309.16, "t": "brincando."}, {"s": 309.16, "e": 309.64, "t": ">> [risadas]"}, {"s": 309.64, "e": 311.36, "t": ">> Eu dou presente para os seus amigos no"}, {"s": 311.36, "e": 312.64, "t": "aniversário."}, {"s": 312.64, "e": 314.12, "t": ">> Receber."}, {"s": 314.12, "e": 315.8, "t": "Eu recebo."}, {"s": 315.8, "e": 319.36, "t": "Você recebe."}, {"s": 319.44, "e": 321.96, "t": ">> Receber."}, {"s": 321.96, "e": 324.88, "t": ">> Você recebe o pagamento que dia?"}, {"s": 324.88, "e": 327.44, "t": ">> Eu costumo receber todo dia 8, hoje,"}, {"s": 327.44, "e": 329.68, "t": "graças a Deus."}, {"s": 329.68, "e": 333.28, "t": "E recebo dia 8 e dia 27. Recebo dois"}, {"s": 333.28, "e": 335.64, "t": "dias no mês, graças a Deus."}, {"s": 335.64, "e": 337.36, "t": ">> Achar."}, {"s": 337.36, "e": 342.0, "t": "Eu acho. Você acha."}, {"s": 342.36, "e": 344.84, "t": ">> Achar."}, {"s": 346.24, "e": 349.56, "t": ">> Você acha que as pessoas em São Paulo"}, {"s": 349.56, "e": 352.12, "t": "andam muito rápido?"}, {"s": 352.12, "e": 353.8, "t": ">> Eu acho que tá todo mundo sempre muito"}, {"s": 353.8, "e": 355.64, "t": "atrasado. Eu, por exemplo, tô indo pro"}, {"s": 355.64, "e": 358.08, "t": "trabalho agora, mas achei uma folguinha"}, {"s": 358.08, "e": 360.25, "t": "pra responder vocês aqui."}, {"s": 360.25, "e": 360.68, "t": ">> [risadas]"}, {"s": 360.68, "e": 362.12, "t": ">> Obrigado."}, {"s": 362.12, "e": 364.16, "t": "Ir."}, {"s": 364.16, "e": 366.12, "t": "Eu vou."}, {"s": 366.12, "e": 369.4, "t": "Você vai."}, {"s": 369.56, "e": 371.88, "t": ">> Ir."}, {"s": 372.96, "e": 375.32, "t": ">> Você vai pro Rio de Janeiro quando?"}, {"s": 375.32, "e": 377.36, "t": ">> Eu volto pro Rio no domingo. Domingo eu"}, {"s": 377.36, "e": 379.32, "t": "vou curtir bastante a capital"}, {"s": 379.32, "e": 380.76, "t": "e domingo à noite tô retornando pro Rio"}, {"s": 380.76, "e": 382.28, "t": "de Janeiro."}, {"s": 382.28, "e": 384.52, "t": ">> Vir."}, {"s": 384.52, "e": 386.8, "t": "Eu venho."}, {"s": 386.8, "e": 387.92, "t": "Você"}, {"s": 387.92, "e": 390.32, "t": "vem."}, {"s": 390.8, "e": 393.0, "t": ">> Vir."}, {"s": 393.84, "e": 395.92, "t": ">> Você vem sempre aqui?"}, {"s": 395.92, "e": 397.8, "t": ">> Eu não venho sempre aqui."}, {"s": 397.8, "e": 401.4, "t": "Eu venho por conta da minha namorada."}, {"s": 401.4, "e": 403.36, "t": ">> Ver."}, {"s": 403.36, "e": 405.28, "t": "Eu vejo."}, {"s": 405.28, "e": 408.44, "t": "Você vê."}, {"s": 408.68, "e": 409.8, "t": ">> Ver."}, {"s": 409.8, "e": 411.24, "t": "O verbo é ver."}, {"s": 411.24, "e": 414.0, "t": ">> Você vê TV aberta ainda?"}, {"s": 414.0, "e": 416.48, "t": ">> Eu não vejo mais TV aberta há muitos"}, {"s": 416.48, "e": 418.28, "t": "anos, porque agora eu consumo mais"}, {"s": 418.28, "e": 420.16, "t": "conteúdos online."}, {"s": 420.16, "e": 421.8, "t": ">> Escutar."}, {"s": 421.8, "e": 423.32, "t": "Eu escuto."}, {"s": 423.32, "e": 426.36, "t": "Você escuta."}, {"s": 426.44, "e": 428.92, "t": ">> Escutar."}, {"s": 429.44, "e": 434.36, "t": ">> Você escuta o que os seus filhos dizem?"}, {"s": 434.36, "e": 436.23, "t": ">> Assim, na maioria das vezes sim."}, {"s": 436.23, "e": 436.96, "t": ">> [risadas]"}, {"s": 436.96, "e": 438.36, "t": ">> A gente aprende muito com eles,"}, {"s": 438.36, "e": 440.64, "t": "escutando os filhos."}, {"s": 440.64, "e": 442.16, "t": ">> Comer."}, {"s": 442.16, "e": 443.72, "t": "Eu como."}, {"s": 443.72, "e": 446.88, "t": "Você come."}, {"s": 446.88, "e": 448.68, "t": ">> Comer."}, {"s": 448.68, "e": 451.36, "t": ">> Você come carne?"}, {"s": 451.36, "e": 454.0, "t": ">> Eu como. Eu diminuí bastante o meu"}, {"s": 454.0, "e": 457.56, "t": "consumo de carne ao longo dos anos, mas"}, {"s": 457.56, "e": 458.84, "t": "eu ainda como."}, {"s": 458.84, "e": 460.72, "t": ">> Acordar."}, {"s": 460.72, "e": 462.4, "t": "Eu acordo."}, {"s": 462.4, "e": 465.68, "t": "Você acorda."}, {"s": 465.72, "e": 467.88, "t": ">> Acordar."}, {"s": 467.88, "e": 470.96, "t": ">> Você acorda de manhã que horas?"}, {"s": 470.96, "e": 473.92, "t": ">> Eu costumo acordar 6:00, 6:30 para eu"}, {"s": 473.92, "e": 475.84, "t": "fazer meu café da manhã, conseguir comer"}, {"s": 475.84, "e": 478.16, "t": "certinho, tomar meu banho e não me"}, {"s": 478.16, "e": 479.64, "t": "arrumar e não precisar me arrumar com"}, {"s": 479.64, "e": 481.44, "t": "pressa. Eu gosto de fazer as coisas no"}, {"s": 481.44, "e": 482.96, "t": "meu tempo."}, {"s": 482.96, "e": 484.92, "t": ">> Dormir."}, {"s": 484.92, "e": 486.52, "t": "Eu durmo."}, {"s": 486.52, "e": 489.08, "t": "Você dorme."}, {"s": 489.08, "e": 491.72, "t": ">> Dormir."}, {"s": 492.08, "e": 495.2, "t": ">> Você dorme quantas horas por noite?"}, {"s": 495.2, "e": 496.56, "t": ">> Ah, eu costumo dormir um pouco tarde,"}, {"s": 496.56, "e": 499.12, "t": "meia-noite e acordo um pouco mais cedo,"}, {"s": 499.12, "e": 500.64, "t": "7:30, 8:00, eu não consigo passar disso"}, {"s": 500.64, "e": 501.48, "t": "não."}, {"s": 501.48, "e": 503.28, "t": "Então, se for contar, mais 7:00 por"}, {"s": 503.28, "e": 505.12, "t": "noite é o ideal, né?"}, {"s": 505.12, "e": 507.04, "t": ">> Levantar."}, {"s": 507.04, "e": 509.08, "t": "Eu levanto."}, {"s": 509.08, "e": 510.52, "t": "Você"}, {"s": 510.52, "e": 513.2, "t": "levanta."}, {"s": 513.2, "e": 515.72, "t": ">> Levantar."}, {"s": 515.72, "e": 519.36, "t": ">> Você levanta a que horas de manhã?"}, {"s": 519.36, "e": 521.36, "t": ">> Em torno das 7:00 da manhã todos os"}, {"s": 521.36, "e": 522.28, "t": "dias."}, {"s": 522.28, "e": 524.28, "t": "Eu levanto às 7:00 da manhã todos os"}, {"s": 524.28, "e": 525.56, "t": "dias."}, {"s": 525.56, "e": 527.36, "t": ">> Trabalhar."}, {"s": 527.36, "e": 529.28, "t": "Eu trabalho."}, {"s": 529.28, "e": 533.04, "t": "Você trabalha."}, {"s": 533.04, "e": 535.12, "t": ">> Trabalhar."}, {"s": 535.12, "e": 537.56, "t": ">> Você trabalha com o quê?"}, {"s": 537.56, "e": 538.92, "t": ">> Eu e minha família, a gente tem uma"}, {"s": 538.92, "e": 541.96, "t": "empresa de transporte de cargas pesadas."}, {"s": 541.96, "e": 543.88, "t": "Então, eu trabalho na logística de"}, {"s": 543.88, "e": 546.24, "t": "empresa, contratando veículos"}, {"s": 546.24, "e": 548.96, "t": "terceirizados, caminhão, falando com as"}, {"s": 548.96, "e": 550.72, "t": "empresas para poder"}, {"s": 550.72, "e": 552.96, "t": "entregar clientes para nossa própria"}, {"s": 552.96, "e": 554.32, "t": "empresa."}, {"s": 554.32, "e": 556.12, "t": ">> Estudar."}, {"s": 556.12, "e": 557.72, "t": "Eu estudo."}, {"s": 557.72, "e": 561.24, "t": "Você estuda."}, {"s": 561.24, "e": 563.72, "t": ">> Estudar."}, {"s": 564.0, "e": 566.2, "t": ">> Você estuda todos os dias?"}, {"s": 566.2, "e": 568.16, "t": ">> Eu não estudo todos os dias, mas"}, {"s": 568.16, "e": 570.08, "t": "deveria."}, {"s": 570.08, "e": 572.72, "t": ">> Você está estudando alguma coisa agora?"}, {"s": 572.72, "e": 574.96, "t": ">> Sim. É, eu estudo Engenharia da"}, {"s": 574.96, "e": 576.32, "t": "Computação."}, {"s": 576.32, "e": 578.48, "t": ">> Pensar."}, {"s": 578.48, "e": 580.6, "t": "Eu penso."}, {"s": 580.6, "e": 582.08, "t": "Você"}, {"s": 582.08, "e": 584.68, "t": "pensa."}, {"s": 585.52, "e": 587.8, "t": ">> Pensar."}, {"s": 587.8, "e": 590.68, "t": ">> Você pensa muito?"}, {"s": 590.68, "e": 591.68, "t": ">> Penso."}, {"s": 591.68, "e": 593.2, "t": "Penso bastante."}, {"s": 593.2, "e": 595.12, "t": ">> Entender."}, {"s": 595.12, "e": 596.96, "t": "Eu entendo."}, {"s": 596.96, "e": 600.44, "t": "Você entende."}, {"s": 600.44, "e": 602.28, "t": ">> Entender."}, {"s": 602.28, "e": 604.68, "t": ">> Você entende português?"}, {"s": 604.68, "e": 607.72, "t": ">> Eu entendo. Eu, como eu nasci aqui, é"}, {"s": 607.72, "e": 610.52, "t": "uma é uma língua nativa, mas eu estudo"}, {"s": 610.52, "e": 612.72, "t": "inglês agora para conseguir"}, {"s": 612.72, "e": 613.88, "t": "ir para fora, que eu tenho bastante"}, {"s": 613.88, "e": 615.64, "t": "família lá fora."}, {"s": 615.64, "e": 618.6, "t": ">> E você? 