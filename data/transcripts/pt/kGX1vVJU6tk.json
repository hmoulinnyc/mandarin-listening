, "t": "serviço."}, {"s": 1080.64, "e": 1081.92, "t": ">> Você é eletricista?"}, {"s": 1081.92, "e": 1083.24, "t": ">> Sou eletricista."}, {"s": 1083.24, "e": 1086.84, "t": "Desde Desde Desde os 18 anos, há 9 anos,"}, {"s": 1086.84, "e": 1088.6, "t": "aí migrei para a área de tecnologia, mas"}, {"s": 1088.6, "e": 1090.0, "t": "depois eu não gostei muito da"}, {"s": 1090.0, "e": 1092.16, "t": "tecnologia, me formei, mas acabei"}, {"s": 1092.16, "e": 1093.96, "t": "voltando para elétrica."}, {"s": 1093.96, "e": 1095.56, "t": ">> Pagar."}, {"s": 1095.56, "e": 1097.28, "t": "Eu pago."}, {"s": 1097.28, "e": 1100.6, "t": "Você paga."}, {"s": 1101.0, "e": 1103.48, "t": ">> Pagar."}, {"s": 1103.96, "e": 1110.0, "t": ">> Você paga as suas contas com Pix?"}, {"s": 1110.0, "e": 1111.12, "t": ">> Eu"}, {"s": 1111.12, "e": 1112.86, "t": "É, pago com Pix."}, {"s": 1112.86, "e": 1114.04, "t": ">> [risadas]"}, {"s": 1114.04, "e": 1116.4, "t": ">> Precisar."}, {"s": 1116.4, "e": 1118.4, "t": "Eu preciso."}, {"s": 1118.4, "e": 1122.36, "t": "Você precisa."}, {"s": 1122.68, "e": 1125.24, "t": ">> Precisar."}, {"s": 1127.68, "e": 1130.64, "t": ">> Qual objeto que você precisa, ah, todos"}, {"s": 1130.64, "e": 1133.48, "t": "os dias? Vou repetir. Qual objeto você"}, {"s": 1133.48, "e": 1137.08, "t": "precisa todo dia?"}, {"s": 1137.56, "e": 1139.28, "t": ">> Não vou dizer que eu preciso todos os"}, {"s": 1139.28, "e": 1140.44, "t": "dias,"}, {"s": 1140.44, "e": 1143.12, "t": "mas eu procuro sempre estar com a minha"}, {"s": 1143.12, "e": 1145.6, "t": "câmera em mãos para fotografar o"}, {"s": 1145.6, "e": 1148.44, "t": "cotidiano e a vida ao meu redor."}, {"s": 1148.44, "e": 1150.28, "t": ">> Esperar."}, {"s": 1150.28, "e": 1151.72, "t": "Eu espero."}, {"s": 1151.72, "e": 1154.64, "t": "Você espera."}, {"s": 1154.72, "e": 1157.4, "t": ">> Esperar."}, {"s": 1158.32, "e": 1161.8, "t": ">> Você espera uma pessoa por quanto tempo"}, {"s": 1161.8, "e": 1164.4, "t": "quando ela tá atrasada?"}, {"s": 1164.4, "e": 1167.48, "t": ">> Eu espero no máximo uns 40 minutinhos"}, {"s": 1167.48, "e": 1169.04, "t": "ali, porque eu tenho mais que fazer"}, {"s": 1169.04, "e": 1169.84, "t": "também."}, {"s": 1169.84, "e": 1170.68, "t": ">> [risadas]"}, {"s": 1170.68, "e": 1173.04, "t": ">> 40 minutos é uma boa tolerância."}, {"s": 1173.04, "e": 1175.28, "t": ">> É uma ótima tolerância, uma ótima."}, {"s": 1175.28, "e": 1177.4, "t": ">> Mudar."}, {"s": 1177.4, "e": 1179.04, "t": "Eu mudo,"}, {"s": 1179.04, "e": 1182.08, "t": "você muda."}, {"s": 1182.08, "e": 1184.72, "t": ">> Mudar."}, {"s": 1184.8, "e": 1189.56, "t": ">> Você muda de ideia com frequência?"}, {"s": 1189.56, "e": 1192.44, "t": ">> Olha, eu acho que mudar de ideia,"}, {"s": 1192.44, "e": 1194.48, "t": "é, com frequência eu não diria, mas"}, {"s": 1194.48, "e": 1196.44, "t": "mudar às vezes de opinião é importante"}, {"s": 1196.44, "e": 1197.76, "t": "sim."}, {"s": 1197.76, "e": 1200.04, "t": ">> Tentar."}, {"s": 1200.04, "e": 1201.8, "t": "Eu tento,"}, {"s": 1201.8, "e": 1205.04, "t": "você tenta."}, {"s": 1205.04, "e": 1207.6, "t": ">> Tentar."}, {"s": 1208.4, "e": 1210.32, "t": ">> Você"}, {"s": 1210.32, "e": 1213.2, "t": "tenta as coisas mais de uma vez?"}, {"s": 1213.2, "e": 1215.6, "t": ">> Eu costumo tentar sim, eu acho que se"}, {"s": 1215.6, "e": 1218.52, "t": "você, se tem algo difícil que você tá"}, {"s": 1218.52, "e": 1220.04, "t": "tentando fazer e não tá conseguindo,"}, {"s": 1220.04, "e": 1222.16, "t": "quanto mais você tentar,"}, {"s": 1222.16, "e": 1223.44, "t": "uma hora você vai alcançar aquilo que"}, {"s": 1223.44, "e": 1224.64, "t": "você deseja."}, {"s": 1224.64, "e": 1226.4, "t": ">> Vai ganhando experiência."}, {"s": 1226.4, "e": 1227.04, "t": ">> Exatamente."}, {"s": 1227.04, "e": 1228.88, "t": "Uma hora vai dar certo."}, {"s": 1228.88, "e": 1231.88, "t": ">> Que bom que você tá aí até agora"}, {"s": 1231.88, "e": 1234.52, "t": "e eu desafio você a usar pelo menos"}, {"s": 1234.52, "e": 1236.8, "t": "cinco palavras que apareceram nesse"}, {"s": 1236.8, "e": 1239.96, "t": "episódio hoje."}, {"s": 1239.96, "e": 1241.72, "t": "E se lembre que se você se tornar um"}, {"s": 1241.72, "e": 1244.44, "t": "membro do Easy Portuguese, você ajuda"}, {"s": 1244.44, "e": 1247.52, "t": "esse canal a continuar fazendo vídeos"}, {"s": 1247.52, "e": 1249.16, "t": "pra você."}, {"s": 1249.16, "e": 1251.16, "t": "Um beijo."}, {"s": 1251.16, "e": 1255.04, "t": "Até o próximo episódio. Tchau."}, {"s": 1255.65, "e": 1257.67, "t": ">> [música]"}, {"s": 1270.84, "e": 1272.88, "t": ">> É."}]