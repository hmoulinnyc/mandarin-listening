[{"s": 0.0, "e": 1.32, "t": "Olá,"}, {"s": 1.32, "e": 4.2, "t": "bem-vindo ou bem-vinda ao Portuguese"}, {"s": 4.2, "e": 7.88, "t": "with Tune. Hoje, hoje, eu vou contar-te"}, {"s": 7.88, "e": 12.0, "t": "uma história escrita pelos irmãos Grimm."}, {"s": 12.0, "e": 14.84, "t": "É a história do lobo e da raposa. Vamos"}, {"s": 14.84, "e": 16.32, "t": "começar."}, {"s": 16.32, "e": 18.96, "t": "O lobo e a raposa."}, {"s": 18.96, "e": 22.12, "t": "O lobo estava com a raposa."}, {"s": 22.12, "e": 25.48, "t": "A raposa tinha de fazer o que o lobo"}, {"s": 25.48, "e": 26.44, "t": "queria,"}, {"s": 26.44, "e": 29.8, "t": "pois era mais fraca, mas queria"}, {"s": 29.8, "e": 32.96, "t": "livrar-se do seu amo, queria livrar-se"}, {"s": 32.96, "e": 37.28, "t": "do seu chefe. O lobo era o chefe da"}, {"s": 37.28, "e": 38.48, "t": "raposa."}, {"s": 38.48, "e": 41.84, "t": "Mas o lobo era muito,"}, {"s": 41.84, "e": 45.64, "t": "muito forte, era muito mais forte"}, {"s": 45.64, "e": 48.56, "t": "do que ela. O lobo era muito mais forte"}, {"s": 48.56, "e": 52.0, "t": "do que a raposa, ou seja, a raposa era"}, {"s": 52.0, "e": 55.12, "t": "mais fraca do que o lobo, não tinha"}, {"s": 55.12, "e": 58.8, "t": "tanta força. A raposa era mais fraca."}, {"s": 58.8, "e": 60.04, "t": "Uma vez,"}, {"s": 60.04, "e": 65.48, "t": "andavam pela floresta e o lobo disse:"}, {"s": 65.48, "e": 68.48, "t": "\"Raposa fulva, arranja-me algo para"}, {"s": 68.48, "e": 72.0, "t": "comer, se não como-te\"."}, {"s": 72.0, "e": 74.36, "t": "A raposa respondeu:"}, {"s": 74.36, "e": 77.2, "t": "\"Sei de uma quinta onde há um par de"}, {"s": 77.2, "e": 79.28, "t": "cordeirinhos jovens."}, {"s": 79.28, "e": 82.04, "t": "Se te apetecer, podemos ir buscar um"}, {"s": 82.04, "e": 83.32, "t": "deles\"."}, {"s": 83.32, "e": 85.32, "t": "Ou seja, o lobo"}, {"s": 85.32, "e": 90.8, "t": "tinha fome, o lobo queria comer e dizia"}, {"s": 90.8, "e": 95.32, "t": "à raposa: \"Traz-me comida, se não eu"}, {"s": 95.32, "e": 96.8, "t": "como-te"}, {"s": 96.8, "e": 98.0, "t": "a ti."}, {"s": 98.0, "e": 100.12, "t": "Raposa, traz-me"}, {"s": 100.12, "e": 102.52, "t": "alguma coisa para eu"}, {"s": 102.52, "e": 106.48, "t": "comer, se não trouxeres, eu como-te a"}, {"s": 106.48, "e": 108.28, "t": "ti\"."}, {"s": 108.28, "e": 109.36, "t": "Bem,"}, {"s": 109.36, "e": 111.6, "t": "a raposa respondeu:"}, {"s": 111.6, "e": 113.48, "t": "\"Sei de uma quinta onde há um par de"}, {"s": 113.48, "e": 115.84, "t": "cordeirinhos jovens. Se te apetecer,"}, {"s": 115.84, "e": 119.52, "t": "podemos ir buscar um deles."}, {"s": 119.52, "e": 121.88, "t": "O lobo disse que sim,"}, {"s": 121.88, "e": 125.92, "t": "foram lá e a raposa roubou o"}, {"s": 125.92, "e": 127.4, "t": "cordeirinho,"}, {"s": 127.4, "e": 130.96, "t": "deu ao lobo e"}, {"s": 130.96, "e": 132.16, "t": "foi se embora."}, {"s": 132.16, "e": 137.2, "t": "A raposa levou o lobo a uma quinta onde"}, {"s": 137.2, "e": 140.36, "t": "havia um cordeirinho bebê."}, {"s": 140.36, "e": 141.68, "t": "A raposa"}, {"s": 141.68, "e": 144.0, "t": "roubou o cordeirinho,"}, {"s": 144.0, "e": 148.88, "t": "deu-o ao lobo para o lobo comer e foi se"}, {"s": 148.88, "e": 151.56, "t": "embora dali."}, {"s": 151.56, "e": 155.4, "t": "O lobo comeu-o todo."}, {"s": 156.52, "e": 159.24, "t": "Ah, que delícia! Hum."}, {"s": 159.24, "e": 161.4, "t": "O lobo comeu-o todo,"}, {"s": 161.4, "e": 165.24, "t": "mas não ficou satisfeito."}, {"s": 165.24, "e": 168.44, "t": "E também quis comer o outro e foi"}, {"s": 168.44, "e": 170.28, "t": "apanhá-lo."}, {"s": 170.28, "e": 175.88, "t": "O lobo comeu um cordeirinho inteiro, mas"}, {"s": 175.88, "e": 178.92, "t": "não era suficiente porque o lobo tinha"}, {"s": 178.92, "e": 183.16, "t": "muita fome. Ah, ele tinha muita fome e"}, {"s": 183.16, "e": 186.12, "t": "queria comer mais."}, {"s": 186.12, "e": 189.72, "t": "Então, foi à quinta do cordeirinho, dos"}, {"s": 189.72, "e": 194.12, "t": "cordeirinhos e foi à procura de outro"}, {"s": 194.12, "e": 197.04, "t": "cordeirinho para comer"}, {"s": 197.04, "e": 199.68, "t": "a seguir."}, {"s": 200.16, "e": 202.4, "t": "O lobo comeu-o todo, mas não ficou"}, {"s": 202.4, "e": 205.32, "t": "satisfeito e também quis comer o outro e"}, {"s": 205.32, "e": 207.68, "t": "foi apanhá-lo."}, {"s": 207.68, "e": 210.88, "t": "Mas era tão desajeitado"}, {"s": 210.88, "e": 214.84, "t": "que a mãe do cordeirinho o viu e desatou"}, {"s": 214.84, "e": 219.6, "t": "a berrar e a balir desalmada mente e os"}, {"s": 219.6, "e": 223.0, "t": "camponeses apareceram a correr."}, {"s": 223.0, "e": 224.92, "t": "O lobo"}, {"s": 224.92, "e": 228.04, "t": "não tinha muito jeito para roubar"}, {"s": 228.04, "e": 229.6, "t": "cordeirinhos,"}, {"s": 229.6, "e": 231.92, "t": "não sabia bem como"}, {"s": 231.92, "e": 235.24, "t": "como é que se rouba o cordeirinho."}, {"s": 235.24, "e": 239.24, "t": "Então, a ovelha, a mãe dos cordeirinhos,"}, {"s": 239.24, "e": 244.72, "t": "a mãe ovelha, viu o lobo e começou a"}, {"s": 244.72, "e": 246.32, "t": "alertar"}, {"s": 246.32, "e": 249.96, "t": "os camponeses. Ela começou a berrar e a"}, {"s": 249.96, "e": 252.48, "t": "balir."}, {"s": 252.83, "e": 253.76, "t": ">> [risadas]"}, {"s": 253.76, "e": 257.6, "t": ">> Começou a fazer muito barulho."}, {"s": 257.6, "e": 260.88, "t": "Os camponeses ouviram-na e foram a"}, {"s": 260.88, "e": 263.44, "t": "correr ajudar a ovelha, ver o que se"}, {"s": 263.44, "e": 265.52, "t": "passava."}, {"s": 265.52, "e": 267.96, "t": "Ao verem o lobo,"}, {"s": 267.96, "e": 269.48, "t": "bateram-lhe,"}, {"s": 269.48, "e": 272.32, "t": "bateram ao lobo. Ao verem o lobo,"}, {"s": 272.32, "e": 275.72, "t": "bateram-lhe sem dó nem piedade"}, {"s": 275.72, "e": 281.0, "t": "e ele voltou para a raposa a coxear e a"}, {"s": 281.0, "e": 282.24, "t": "uivar."}, {"s": 282.24, "e": 283.88, "t": "Au!"}, {"s": 283.88, "e": 288.2, "t": "O lobo apanhou uma sova"}, {"s": 288.2, "e": 292.64, "t": "gigante. O lobo apanhou uma sova dos"}, {"s": 292.64, "e": 294.12, "t": "camponeses,"}, {"s": 294.12, "e": 298.08, "t": "fugiu, foi ter com a raposa e apareceu"}, {"s": 298.08, "e": 300.56, "t": "lá todo magoado"}, {"s": 300.56, "e": 304.0, "t": "a coxear e a uivar."}, {"s": 304.0, "e": 306.04, "t": "Au!"}, {"s": 306.04, "e": 307.88, "t": "Uiva."}, {"s": 307.88, "e": 310.68, "t": "\"Que lindo serviço\", disse-lhe."}, {"s": 310.68, "e": 313.8, "t": "\"Ia buscar o outro cordeiro, mas os"}, {"s": 313.8, "e": 318.04, "t": "camponeses apanharam-me e bateram-me até"}, {"s": 318.04, "e": 321.04, "t": "me deixarem em carne moída\"."}, {"s": 321.04, "e": 324.04, "t": "A raposa respondeu: \"Mas por que és tão"}, {"s": 324.04, "e": 326.2, "t": "glutão\"?"}, {"s": 326.2, "e": 328.6, "t": "A raposa perguntou: \"Mas por que é que"}, {"s": 328.6, "e": 330.16, "t": "querias comer outro cordeirinho? Já"}, {"s": 330.16, "e": 332.44, "t": "comeste um. Por que é que foste à"}, {"s": 332.44, "e": 334.68, "t": "procura do segundo\"?"}, {"s": 334.68, "e": 337.36, "t": "\"Comeste um cordeirinho, já chega, não"}, {"s": 337.36, "e": 340.04, "t": "é? Por que? Por que é que foste buscar"}, {"s": 340.04, "e": 343.48, "t": "mais outro, o segundo\"?"}, {"s": 343.6, "e": 346.8, "t": "Não faz sentido. No dia seguinte,"}, {"s": 346.8, "e": 350.48, "t": "tornaram a sair para o campo e o"}, {"s": 350.48, "e": 354.32, "t": "cobiçoso do lobo tornou a dizer."}, {"s": 354.32, "e": 357.4, "t": "Portanto, no dia seguinte, o lobo e a"}, {"s": 357.4, "e": 361.24, "t": "raposa foram novamente, não é, mais uma"}, {"s": 361.24, "e": 365.52, "t": "vez, para o campo à procura de algo para"}, {"s": 365.52, "e": 367.64, "t": "comer."}, {"s": 367.64, "e": 371.72, "t": "E o lobo disse outra vez, tornou a dizer"}, {"s": 371.72, "e": 373.08, "t": "à raposa:"}, {"s": 373.08, "e": 375.92, "t": "\"Raposa vermelha, arranja-me algo para"}, {"s": 375.92, "e": 379.84, "t": "comer, senão eu como-te a ti.\""}, {"s": 379.84, "e": 381.84, "t": "\"Arranja-me algo para comer, senão"}, {"s": 381.84, "e": 383.84, "t": "como-te.\""}, {"s": 383.84, "e": 386.44, "t": "A raposa respondeu:"}, {"s": 386.44, "e": 388.68, "t": "\"Sei de uma quinta"}, {"s": 388.68, "e": 392.04, "t": "cuja caseira vai fazer panquecas esta"}, {"s": 392.04, "e": 395.36, "t": "noite. Vamos lá buscar algumas.\""}, {"s": 395.36, "e": 398.04, "t": "Portanto, a raposa disse ao lobo: \"OK,"}, {"s": 398.04, "e": 402.48, "t": "há ali noutro sítio uma outra quinta"}, {"s": 402.48, "e": 405.88, "t": "onde a senhora, a a a mulher que lá"}, {"s": 405.88, "e": 407.88, "t": "trabalha, a caseira,"}, {"s": 407.88, "e": 411.56, "t": "vai fazer panquecas hoje à noite, mais"}, {"s": 411.56, "e": 414.16, "t": "logo, hoje à noite. Vamos lá"}, {"s": 414.16, "e": 417.24, "t": "e vamos roubar as panquecas.\" Foi essa a"}, {"s": 417.24, "e": 419.76, "t": "ideia da raposa."}, {"s": 419.76, "e": 421.32, "t": "Foram lá"}, {"s": 421.32, "e": 424.36, "t": "e a raposa surrateira,"}, {"s": 424.36, "e": 427.44, "t": "não é, isto é surrateira, a raposa é"}, {"s": 427.44, "e": 429.24, "t": "surrateira."}, {"s": 429.24, "e": 432.88, "t": "Foram lá e a raposa surrateira andou à"}, {"s": 432.88, "e": 438.48, "t": "volta da casa, espreitando,"}, {"s": 440.16, "e": 441.92, "t": "espreitando"}, {"s": 441.92, "e": 442.72, "t": "e"}, {"s": 442.72, "e": 445.68, "t": "farejando"}, {"s": 446.8, "e": 449.92, "t": "com o nariz, farejar."}, {"s": 449.92, "e": 453.12, "t": "Espreitando e farejando até descobrir"}, {"s": 453.12, "e": 456.8, "t": "onde estava a chave. A raposa,"}, {"s": 456.8, "e": 459.72, "t": "com os seus olhos e com o seu nariz,"}, {"s": 459.72, "e": 463.24, "t": "portanto, com a sua visão e com o seu"}, {"s": 463.24, "e": 467.08, "t": "olfato conseguiu encontrar a chave da"}, {"s": 467.08, "e": 468.28, "t": "casa."}, {"s": 468.28, "e": 471.16, "t": "Foram lá e a raposa surrateira andou à"}, {"s": 471.16, "e": 474.52, "t": "volta da casa espreitando e farejando"}, {"s": 474.52, 