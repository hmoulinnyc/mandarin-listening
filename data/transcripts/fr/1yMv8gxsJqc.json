[{"s": 4.24, "e": 8.4, "t": "Bonjour et bienvenue à Paris."}, {"s": 8.4, "e": 11.56, "t": "Aujourd'hui, c'est la journée des"}, {"s": 11.56, "e": 13.52, "t": "premières fois."}, {"s": 13.52, "e": 16.56, "t": "Donc, c'est la première fois que je"}, {"s": 16.56, "e": 20.36, "t": "filme un vlog en extérieur."}, {"s": 20.36, "e": 24.72, "t": "Et ce matin, c'était la première fois"}, {"s": 24.72, "e": 28.4, "t": "que j'avais un shooting photo."}, {"s": 28.4, "e": 31.2, "t": "Ça s'est super bien passé. Mais donc"}, {"s": 31.2, "e": 34.28, "t": "voilà, c'est la journée des nouveautés."}, {"s": 34.28, "e": 39.24, "t": "Là, je vais retrouver une amie"}, {"s": 39.24, "e": 43.28, "t": "que j'ai rencontrée aux Pays-Bas."}, {"s": 43.28, "e": 46.84, "t": "Et elle vient d'avoir un bébé. Donc,"}, {"s": 46.84, "e": 49.36, "t": "aujourd'hui, c'est la première fois. Bon"}, {"s": 49.36, "e": 52.0, "t": "ben voilà, une troisième première fois."}, {"s": 52.0, "e": 56.16, "t": "C'est la première fois que je vois, que"}, {"s": 56.16, "e": 61.57, "t": "je rencontre son bébé. J'ai trop hâte."}, {"s": 106.88, "e": 110.92, "t": "Ah oui, et j'ai oublié de préciser qu'il"}, {"s": 110.92, "e": 115.64, "t": "fait une chaleur monstre, mais monstre."}, {"s": 115.64, "e": 118.2, "t": "Euh, c'est-à-dire qu'il fait très"}, {"s": 118.2, "e": 119.72, "t": "Il fait"}, {"s": 119.72, "e": 121.48, "t": "40 degrés."}, {"s": 121.48, "e": 126.12, "t": "Et déjà ce matin à 7h30"}, {"s": 126.12, "e": 128.84, "t": "quand j'ai commencé le shooting photo,"}, {"s": 128.84, "e": 132.32, "t": "il faisait 30 degrés. Donc"}, {"s": 132.32, "e": 133.04, "t": "c'est"}, {"s": 133.04, "e": 136.64, "t": "étouffant vraiment la la chaleur l'air"}, {"s": 136.64, "e": 138.4, "t": "est étouffant."}, {"s": 138.4, "e": 142.04, "t": "Donc cet après-midi, je vais essayer"}, {"s": 142.04, "e": 143.6, "t": "de euh"}, {"s": 143.6, "e": 145.2, "t": "rester"}, {"s": 145.2, "e": 149.04, "t": "à l'intérieur au maximum"}, {"s": 149.04, "e": 153.04, "t": "dans des cafés, dans des musées."}, {"s": 153.04, "e": 157.0, "t": "Voilà, parce que à l'extérieur c'est euh"}, {"s": 157.0, "e": 160.16, "t": "c'est invivable."}, {"s": 161.68, "e": 162.8, "t": "Oui."}, {"s": 162.8, "e": 164.56, "t": "Est-ce que tu m'as donné le code ou ?"}, {"s": 164.56, "e": 167.0, "t": "Parce que je suis là."}, {"s": 167.0, "e": 168.2, "t": "!"}, {"s": 168.2, "e": 169.0, "t": "!"}, {"s": 169.0, "e": 169.64, "t": "Ça ?"}, {"s": 169.64, "e": 170.36, "t": "Ça va et ?"}, {"s": 170.36, "e": 171.16, "t": "Oui."}, {"s": 171.16, "e": 171.68, "t": "J'ai chaud."}, {"s": 171.68, "e": 173.2, "t": "Désolée hein, je suis vachement en"}, {"s": 173.2, "e": 175.54, "t": "retard."}, {"s": 188.24, "e": 191.32, "t": "Bon du coup, c'était très sympa avec ma"}, {"s": 191.32, "e": 194.92, "t": "copine et maintenant"}, {"s": 194.92, "e": 199.08, "t": "je vais rejoindre une autre copine"}, {"s": 199.08, "e": 201.64, "t": "aussi une copine que j'ai rencontrée aux"}, {"s": 201.64, "e": 203.6, "t": "Pays-Bas."}, {"s": 203.6, "e": 205.72, "t": "Mais j'ai loupé"}, {"s": 205.72, "e": 209.24, "t": "ma station de métro donc"}, {"s": 209.24, "e": 211.84, "t": "je vais marcher euh"}, {"s": 211.84, "e": 214.4, "t": "je sais pas, 10 minutes au lieu de 5,"}, {"s": 214.4, "e": 216.92, "t": "mais bon."}, {"s": 228.36, "e": 232.2, "t": "On va aller à Bourse de Commerce qui est"}, {"s": 232.2, "e": 235.92, "t": "un musée d'art contemporain à Paris,"}, {"s": 235.92, "e": 238.68, "t": "que euh je n'ai jamais fait. Donc voilà,"}, {"s": 238.68, "e": 242.44, "t": "c'est juste pour essayer."}, {"s": 252.24, "e": 254.48, "t": "Ça ? Ça fait trop trop longtemps. On est"}, {"s": 254.48, "e": 256.56, "t": "contentes."}, {"s": 256.56, "e": 258.44, "t": "Exotique. Moi, je vais prendre"}, {"s": 258.44, "e": 261.24, "t": "l'exotique mangue."}, {"s": 261.24, "e": 262.2, "t": "Oui."}, {"s": 262.2, "e": 263.8, "t": "Euh tu prends ?"}, {"s": 263.8, "e": 265.12, "t": "Moi, je vais vous prendre un exotique,"}, {"s": 265.12, "e": 265.68, "t": "s'il vous plaît."}, {"s": 265.68, "e": 266.56, "t": "Un exotique."}, {"s": 266.56, "e": 268.36, "t": "Et pour moi, une citronnade maison, s'il"}, {"s": 268.36, "e": 269.48, "t": "vous plaît."}, {"s": 269.48, "e": 269.92, "t": "Merci."}, {"s": 269.92, "e": 271.36, "t": "Merci. Et deux verres deux verres d'eau,"}, {"s": 271.36, "e": 272.48, "t": "s'il vous plaît."}, {"s": 272.96, "e": 274.12, "t": "Merci."}, {"s": 274.12, "e": 275.76, "t": "Merci."}, {"s": 275.76, "e": 276.76, "t": "Super, merci."}, {"s": 276.76, "e": 278.38, "t": "Merci."}, {"s": 278.64, "e": 280.0, "t": "Ils utilisent un autre outil là, qui"}, {"s": 280.0, "e": 281.4, "t": "pète un peu comme Canva."}, {"s": 281.4, "e": 282.64, "t": "Euh Product Designer, du coup."}, {"s": 282.64, "e": 283.24, "t": "OK."}, {"s": 283.24, "e": 285.68, "t": "Euh comment dire euh elle a changé de"}, {"s": 285.68, "e": 288.52, "t": "poste, mais tu sais, il y en a eu une."}, {"s": 293.08, "e": 295.32, "t": "C'est une glace. Il y a des morceaux de"}, {"s": 295.32, "e": 296.8, "t": "chocolat"}, {"s": 296.8, "e": 299.56, "t": "et des bouts de biscuits."}, {"s": 299.56, "e": 301.2, "t": "Ça fait penser un peu à de la"}, {"s": 301.2, "e": 303.92, "t": "stracciatella."}, {"s": 306.8, "e": 310.44, "t": "Bon, finalement, pas de musée parce que"}, {"s": 310.44, "e": 311.0, "t": "euh"}, {"s": 311.0, "e": 313.84, "t": "la plupart des musées sont fermés"}, {"s": 313.84, "e": 316.12, "t": "le mardi à Paris."}, {"s": 316.12, "e": 318.12, "t": "Je ne savais pas. Donc voilà, pas de"}, {"s": 318.12, "e": 320.0, "t": "musée aujourd'hui."}, {"s": 320.0, "e": 322.68, "t": "Et là, ma mission, c'est de trouver un"}, {"s": 322.68, "e": 326.0, "t": "Vélib. Un Vélib, ce sont les"}, {"s": 326.0, "e": 329.08, "t": "vélos en libre-service"}, {"s": 329.08, "e": 333.2, "t": "pour rentrer chez ma famille,"}, {"s": 333.2, "e": 335.36, "t": "chez qui je dors ce soir."}, {"s": 335.36, "e": 337.24, "t": "Donc là,"}, {"s": 337.24, "e": 339.2, "t": "je suis avec"}, {"s": 339.2, "e": 343.12, "t": "mon téléphone pour essayer de"}, {"s": 343.12, "e": 346.04, "t": "trouver un vélo."}, {"s": 392.48, "e": 394.76, "t": "Ça, c'est vraiment le bonheur de faire"}, {"s": 394.76, "e": 397.64, "t": "du vélo dans Paris, c'est"}, {"s": 397.64, "e": 399.32, "t": "Bon, il fait [musique] un tout petit peu"}, {"s": 399.32, "e": 401.56, "t": "trop chaud, mais sinon"}, {"s": 401.56, "e": 405.52, "t": "c'est un pur plaisir."}, {"s": 444.6, "e": 449.28, "t": "J'avais mis de la crème solaire, mais"}, {"s": 449.28, "e": 451.04, "t": "je sens"}, {"s": 451.04, "e": 453.64, "t": "que sur mes bras"}, {"s": 453.64, "e": 458.72, "t": "je vais avoir un coup de soleil."}, {"s": 464.52, "e": 465.68, "t": "Je"}, {"s": 465.68, "e": 468.88, "t": "dans un parc."}, {"s": 468.88, "e": 473.32, "t": "Je profite un peu du vent et du calme"}, {"s": 473.32, "e": 478.28, "t": "avant de rentrer chez ma famille pour le"}, {"s": 478.28, "e": 479.68, "t": "dîner."}, {"s": 479.68, "e": 483.6, "t": "C'est la fin de cette vidéo et j'espère"}, {"s": 483.6, "e": 488.24, "t": "t'avoir permis de t'évader un peu, de"}, {"s": 488.24, "e": 490.64, "t": "rêver de Paris. [grognement] N'oublie"}, {"s": 490.64, "e": 493.52, "t": "pas de t'abonner pour plus de contenu en"}, {"s": 493.52, "e": 496.76, "t": "français. À !"}]