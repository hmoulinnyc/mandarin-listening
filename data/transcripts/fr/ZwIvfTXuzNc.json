[{"s": 0.1, "e": 2.33, "t": "J'ai sélectionné douze mots"}, {"s": 2.4, "e": 4.0, "t": "en français très précis."}, {"s": 4.0, "e": 6.03, "t": "Si tu connais les quatre premiers,"}, {"s": 8.17, "e": 10.3, "t": "Si tu connais les quatre suivants,"}, {"s": 10.3, "e": 11.6, "t": "tu as probablement"}, {"s": 12.83, "e": 14.07, "t": "mais si tu connais"}, {"s": 14.07, "e": 15.43, "t": "les quatre derniers,"}, {"s": 15.43, "e": 17.63, "t": "alors ton vocabulaire est meilleur"}, {"s": 17.63, "e": 19.23, "t": "que 96 %"}, {"s": 19.23, "e": 20.53, "t": "des apprenants de français."}, {"s": 20.6, "e": 21.93, "t": "À la fin de la vidéo,"}, {"s": 21.93, "e": 24.4, "t": "tu auras simplement un score sur douze."}, {"s": 24.43, "e": 26.53, "t": "On va voir combien de bonnes réponses"}, {"s": 26.53, "e": 27.8, "t": "tu peux obtenir."}, {"s": 27.8, "e": 29.63, "t": "Le principe est très simple."}, {"s": 29.63, "e": 31.23, "t": "Je vais te montrer un mot"}, {"s": 31.23, "e": 33.67, "t": "avec trois définitions possibles."}, {"s": 33.67, "e": 34.23, "t": "Et toi,"}, {"s": 34.23, "e": 36.9, "t": "tu vas devoir choisir la bonne réponse"}, {"s": 36.9, "e": 38.8, "t": "avant la fin du compte à rebours."}, {"s": 38.83, "e": 40.53, "t": "On commence avec les mots"}, {"s": 40.53, "e": 42.2, "t": "de niveau intermédiaire."}, {"s": 42.23, "e": 43.63, "t": "Ensuite, les mots"}, {"s": 43.63, "e": 45.33, "t": "deviendront progressivement"}, {"s": 45.33, "e": 46.57, "t": "plus difficiles."}, {"s": 46.6, "e": 47.63, "t": "C'est parti !"}, {"s": 47.63, "e": 49.4, "t": "Premier mot : pourtant."}, {"s": 49.4, "e": 51.23, "t": "Est-ce que pourtant signifie"}, {"s": 51.23, "e": 53.43, "t": "peut-être, malgré cela,"}, {"s": 53.47, "e": 54.67, "t": "finalement ?"}, {"s": 54.73, "e": 55.6, "t": "Trois."}, {"s": 55.6, "e": 57.23, "t": "Deux. Un."}, {"s": 57.4, "e": 59.8, "t": "La bonne réponse, c'était B."}, {"s": 59.87, "e": 61.8, "t": "« Malgré cela », on utilise"}, {"s": 61.8, "e": 63.1, "t": "« pourtant » lorsqu'il"}, {"s": 63.13, "e": 66.0, "t": "y a une opposition entre deux idées."}, {"s": 66.03, "e": 68.1, "t": "Par exemple, il pleut beaucoup."}, {"s": 68.13, "e": 70.6, "t": "Pourtant, il sort sans parapluie."}, {"s": 70.63, "e": 72.5, "t": "Ensuite, le deuxième mot,"}, {"s": 72.5, "e": 74.2, "t": "c'est prévenir."}, {"s": 74.23, "e": 75.67, "t": "Et est-ce que prévenir"}, {"s": 75.67, "e": 77.2, "t": "signifie avertir"}, {"s": 77.2, "e": 78.7, "t": "quelqu'un à l'avance,"}, {"s": 78.73, "e": 80.3, "t": "interdire quelque chose"}, {"s": 80.3, "e": 81.5, "t": "ou répondre"}, {"s": 81.5, "e": 82.83, "t": "à une question ?"}, {"s": 82.83, "e": 85.33, "t": "Trois, deux, un."}, {"s": 85.43, "e": 87.6, "t": "La bonne réponse, c'était la"}, {"s": 87.6, "e": 90.13, "t": "A : avertir quelqu'un à l'avance."}, {"s": 90.13, "e": 91.93, "t": "Parce que prévenir quelqu'un,"}, {"s": 92.0, "e": 93.8, "t": "c'est l'informer avant"}, {"s": 93.8, "e": 95.4, "t": "qu'une situation arrive."}, {"s": 95.4, "e": 96.83, "t": "Par exemple, préviens-"}, {"s": 96.83, "e": 98.47, "t": "moi quand tu arrives à la gare."}, {"s": 98.47, "e": 100.33, "t": "Ensuite, le troisième mot,"}, {"s": 100.33, "e": 101.73, "t": "c'est parvenir."}, {"s": 101.73, "e": 103.87, "t": "Est-ce que parvenir signifie"}, {"s": 103.87, "e": 106.53, "t": "réussir à atteindre un objectif,"}, {"s": 106.6, "e": 108.53, "t": "revenir au point de départ"}, {"s": 108.53, "e": 110.03, "t": "ou alors comparer"}, {"s": 110.03, "e": 111.47, "t": "deux possibilités ?"}, {"s": 111.6, "e": 114.07, "t": "Trois, deux, un."}, {"s": 114.1, "e": 116.3, "t": "La bonne réponse, c'était la"}, {"s": 116.3, "e": 117.73, "t": "A : parvenir"}, {"s": 117.73, "e": 119.1, "t": "à faire quelque chose."}, {"s": 119.1, "e": 120.93, "t": "Ça veut dire réussir"}, {"s": 120.93, "e": 122.33, "t": "à faire quelque chose"}, {"s": 122.33, "e": 124.5, "t": "parfois après plusieurs efforts."}, {"s": 124.5, "e": 127.0, "t": "Par exemple, après plusieurs mois"}, {"s": 127.0, "e": 129.13, "t": "d'apprentissage intensif,"}, {"s": 129.13, "e": 131.67, "t": "elle est parvenue à parler français"}, {"s": 131.67, "e": 133.0, "t": "avec confiance."}, {"s": 133.0, "e": 134.53, "t": "On passe au quatrième"}, {"s": 134.53, "e": 136.03, "t": "mot : démarche."}, {"s": 136.03, "e": 137.23, "t": "Est-ce qu'une démarche,"}, {"s": 137.23, "e": 139.6, "t": "c'est une manière de procéder,"}, {"s": 139.63, "e": 142.27, "t": "une dépense inutile ou"}, {"s": 142.27, "e": 144.67, "t": "une promesse difficile à tenir ?"}, {"s": 144.67, "e": 146.87, "t": "Trois, deux, un."}, {"s": 147.07, "e": 149.4, "t": "La réponse, c'était la A :"}, {"s": 149.47, "e": 152.23, "t": "une manière de procéder, une démarche."}, {"s": 152.23, "e": 153.43, "t": "C'est une série"}, {"s": 153.43, "e": 154.93, "t": "d'actions réalisées"}, {"s": 154.93, "e": 156.8, "t": "pour atteindre un objectif."}, {"s": 156.8, "e": 159.73, "t": "Par exemple, pour obtenir ce document,"}, {"s": 159.73, "e": 161.13, "t": "tu dois effectuer"}, {"s": 161.13, "e": 162.53, "t": "plusieurs démarches"}, {"s": 162.53, "e": 163.73, "t": "administratives."}, {"s": 163.73, "e": 165.4, "t": "Si tu as obtenu"}, {"s": 165.4, "e": 166.7, "t": "quatre bonnes réponses"}, {"s": 166.7, "e": 168.8, "t": "sur quatre, c'est déjà très bien."}, {"s": 168.8, "e": 171.33, "t": "Maintenant, on passe au deuxième niveau."}, {"s": 171.33, "e": 173.63, "t": "Ces mots sont plus avancés."}, {"s": 173.63, "e": 176.3, "t": "Tu peux les entendre au travail,"}, {"s": 176.33, "e": 177.6, "t": "dans les médias,"}, {"s": 177.6, "e": 179.63, "t": "par exemple, à la télévision."}, {"s": 179.63, "e": 180.6, "t": "Enfin bref."}, {"s": 180.6, "e": 182.83, "t": "Cinquième mot : fastidieux."}, {"s": 182.83, "e": 185.07, "t": "Est-ce que fastidieux signifie"}, {"s": 185.07, "e": 186.27, "t": "très rapide"}, {"s": 186.3, "e": 187.73, "t": "ou alors long,"}, {"s": 187.73, "e": 189.83, "t": "répétitif et ennuyant,"}, {"s": 189.83, "e": 191.5, "t": "ou alors rapide"}, {"s": 191.5, "e": 192.7, "t": "et efficace ?"}, {"s": 192.73, "e": 195.27, "t": "Trois, deux, un."}, {"s": 195.47, "e": 197.63, "t": "La bonne réponse, c'était la B :"}, {"s": 197.67, "e": 200.33, "t": "long, répétitif et ennuyant."}, {"s": 200.33, "e": 202.93, "t": "En général, une tâche fastidieuse"}, {"s": 202.93, "e": 205.5, "t": "demande beaucoup de temps et n'est"}, {"s": 205.5, "e": 207.73, "t": "pas très agréable à réaliser."}, {"s": 207.73, "e": 209.3, "t": "Par exemple, classer"}, {"s": 209.3, "e": 211.43, "t": "tous ces documents à la main"}, {"s": 211.47, "e": 213.1, "t": "est vraiment fastidieux."}, {"s": 213.13, "e": 214.03, "t": "Enfin bref."}, {"s": 214.03, "e": 215.93, "t": "Sixième mot : pertinent."}, {"s": 215.93, "e": 217.23, "t": "Est-ce que pertinent"}, {"s": 217.23, "e": 218.93, "t": "signifie adapté"}, {"s": 218.93, "e": 220.5, "t": "à la situation,"}, {"s": 220.5, "e": 222.5, "t": "difficile à prononcer"}, {"s": 222.5, "e": 223.9, "t": "ou alors poli"}, {"s": 223.9, "e": 225.4, "t": "avec tout le monde ?"}, {"s": 225.47, "e": 228.2, "t": "Trois, deux, un."}, {"s": 228.5, "e": 230.5, "t": "La bonne réponse, c'était la"}, {"s": 230.5, "e": 233.07, "t": "A : adapté à la situation."}, {"s": 233.07, "e": 235.47, "t": "Une remarque pertinente, c'est"}, {"s": 235.47, "e": 237.93, "t": "une remarque qui est intelligente,"}, {"s": 237.93, "e": 239.3, "t": "qui est réfléchie,"}, {"s": 239.4, "e": 242.23, "t": "qui est aussi adaptée au sujet"}, {"s": 242.23, "e": 243.6, "t": "et qui est utile."}, {"s": 243.6, "e": 246.47, "t": "Par exemple, elle a posé une question"}, {"s": 246.47, "e": 248.83, "t": "très pertinente pendant la réunion."}, {"s": 248.83, "e": 250.3, "t": "On passe au septième"}, {"s": 250.3, "e": 251.5, "t": "mot : contraignant."}, {"s": 251.5, "e": 252.8, "t": "Est-ce que contraignant"}, {"s": 252.8, "e": 255.0, "t": "signifie très avantageux,"}, {"s": 255.03, "e": 256.5, "t": "impossible à comprendre,"}, {"s": 256.5, "e": 258.03, "t": "ou alors qui impose"}, {"s": 258.03, "e": 259.27, "t": "des obligations"}, {"s": 259.27, "e": 261.83, "t": "ou des limites ? Trois, deux,"}, {"s": 262.1, "e": 265.0, "t": "un. La bonne réponse est la C :"}, {"s": 265.03, "e": 267.67, "t": "qui impose des obligations ou des limites."}, {"s": 267.67, "e": 269.83, "t": "Quelque chose de contraignant"}, {"s": 269.83, "e": 271.73, "t": "limite ta liberté"}, {"s": 271.73, "e": 273.2, "t": "ou t'oblige à faire"}, {"s": 273.2, "e": 274.7, "t": "certains efforts que tu n'as"}, {"s": 274.73, "e": 276.53, "t": "pas forcément envie de faire."}, {"s": 276.53, "e": 278.23, "t": "Par exemple, ces horaires"}, {"s": 278.23, "e": 279.5, "t": "sont trop contraignants."}, {"s": 279.5, "e": 282.2, "t": "Pour moi, le mot pérenniser"}, {"s": 282.2, "e": 283.5, "t": "est-ce que pérenniser"}, {"s": 283.5, "e": 284.87, "t": "signifie rendre"}, {"s": 284.87, "e": 286.53, "t": "quelque chose durable,"}, {"s": 286.53, "e": 288.33, "t": "accélérer une décision"}, {"s": 288.33, "e": 289.83, "t": "ou alors supprimer"}, {"s": 289.83, "e": 291.43, "t": "un problème immédiatement ?"}, {"s": 291.43, "e": 293.63, "t": "Trois, deux, un."}, {"s": 293.87, "e": 295.87, "t": "La bonne réponse, c'était la"}, {"s": 295.87, "e": 298.4, "t": "A : rendre quelque chose durable."}, {"s": 298.4, "e": 300.27, "t": "Pérenniser un projet"}, {"s": 300.27, "e": 301.83, "t": "ou même une entreprise,"}, {"s": 301.83, "e": 303.23, "t": "c'est faire en sorte"}, {"s": 303.23, "e": 305.8, "t": "qu'il puisse exister pendant longtemps."}, {"s": 305.8, "e": 308.2, "t": "Par exemple, une entreprise peut dire :"}, {"s": 308.2, "e": 310.7, "t": "Nous devons trouver de nouveaux clients"}, {"s": 310.7, "e": 313.0, "t": "pour pérenniser notre activité."}, {"s": 313.03, "e": 315.4, "t": "Enfin bref, si tu es toujours à huit"}, {"s": 315.4, "e": 316.93, "t": "sur huit, bravo !"}, {"s": 316.93, "e": 318.47, "t": "On passe maintenant"}, {"s": 318.47, "e": 319.87, "t": "au niveau expert."}, {"s": 319.87, "e": 321.43, "t": "Ces quatre derniers mots"}, {"s": 321.43, "e": 323.6, "t": "sont nettement plus difficiles."}, {"s": 323.6, "e": 325.47, "t": "Beaucoup d'apprenants ne les connaissent"}, {"s": 325.47, "e": 326.7, "t": "même pas après"}, {"s": 326.73, "e": 328.5, "t": "plusieurs années de français."}, {"s": 328.5, "e": 329.9, "t": "Alors, laisse-moi te dire"}, {"s": 329.9, "e": 331.67, "t": "que ce n'est pas de la rigolade."}, {"s": 331.67, "e": 333.03, "t": "Mais avant de te les dire,"}, {"s": 333.03, "e": 334.23, "t": "petite pause :"}, {"s": 334.23, "e": 335.53, "t": "si tu veux apprendre"}, {"s": 335.53, "e": 337.03, "t": "le français encore plus"}, {"s": 337.03, "e": 338.23, "t": "vite, notamment"}, {"s": 338.23, "e": 339.47, "t": "apprendre à parler"}, {"s": 339.47, "e": 340.73, "t": "français, clique"}, {"s": 340.73, "e": 342.33, "t": "sur le lien en description,"}, {"s": 342.33, "e": 344.33, "t": "ça peut énormément t'intéresser."}, {"s": 344.4, "e": 346.87, "t": "Enfin bref, maintenant, voyons"}, {"s": 346.87, "e": 349.33, "t": "si tu peux obtenir un score parfait."}, {"s": 349.4, "e": 351.4, "t": "Neuvième mot : atténuer."}, {"s": 351.43, "e": 353.13, "t": "Est-ce qu'atténuer"}, {"s": 353.13, "e": 355.7, "t": "signifie aggraver une situation,"}, {"s": 355.7, "e": 358.1, "t": "ignorer complètement un problème"}, {"s": 358.1, "e": 360.43, "t": "ou alors réduire l'intensité"}, {"s": 360.43, "e": 361.63, "t": "de quelque chose ?"}, {"s": 361.73, "e": 364.43, "t": "Trois, deux, un."}, {"s": 364.7, "e": 366.9, "t": "La bonne réponse, c'était la C."}, {"s": 366.93, "e": 368.53, "t": "Atténuer quelque chose,"}, {"s": 368.53, "e": 370.93, "t": "c'est le fait de rendre la chose"}, {"s": 370.93, "e": 372.23, "t": "moins forte,"}, {"s": 372.23, "e": 374.07, "t": "moins grave et moins visible."}, {"s": 374.07, "e": 374.9, "t": "Par exemple,"}, {"s": 374.9, "e": 376.8, "t": "ces mesures devraient permettre"}, {"s": 376.8, "e": 379.47, "t": "d'atténuer les conséquences de la crise."}, {"s": 379.47, "e": 382.3, "t": "On passe au 10ᵉ mot qui est scruter."}, {"s": 382.3, "e": 384.47, "t": "Est-ce que scruter signifie"}, {"s": 384.47, "e": 386.03, "t": "observer quelque chose"}, {"s": 386.03, "e": 387.6, "t": "avec beaucoup d'attention ?"}, {"s": 387.6, "e": 390.13, "t": "résumer une idée en quelques mots"}, {"s": 390.13, "e": 391.67, "t": "ou alors refuser"}, {"s": 391.67, "e": 393.2, "t": "de donner son avis ?"}, {"s": 393.33, "e": 395.83, "t": "Trois, deux, un."}, {"s": 395.9, "e": 397.07, "t": "La bonne réponse"}, {"s": 397.07, "e": 399.67, "t": "c'est la A : observer quelque chose"}, {"s": 399.67, "e": 401.07, "t": "avec beaucoup d'attention."}, {"s": 401.07, "e": 404.0, "t": "Scruter, c'est regarder attentivement"}, {"s": 404.0, "e": 406.83, "t": "pour essayer de repérer tous les détails."}, {"s": 406.83, "e": 408.3, "t": "Par exemple, il scrute"}, {"s": 408.3, "e": 409.8, "t": "le ciel pour essayer"}, {"s": 409.8, "e": 412.03, "t": "d'apercevoir les premières étoiles."}, {"s": 412.03, "e": 414.83, "t": "Ensuite, un mot : implicite."}, {"s": 414.87, "e": 417.27, "t": "Est-ce qu'implicite signifie"}, {"s": 417.27, "e": 418.53, "t": "totalement faux,"}, {"s": 418.6, "e": 420.07, "t": "ou alors expliquer"}, {"s": 420.07, "e": 421.67, "t": "avec beaucoup de détails,"}, {"s": 421.67, "e": 423.03, "t": "ou alors compris"}, {"s": 423.03, "e": 425.27, "t": "sans être clairement exprimé ?"}, {"s": 425.33, "e": 427.9, "t": "Trois, deux, un."}, {"s": 428.1, "e": 429.33, "t": "La bonne réponse"}, {"s": 429.33, "e": 430.67, "t": "c'est la C."}, {"s": 430.73, "e": 432.9, "t": "Compris sans être clairement exprimé."}, {"s": 432.9, "e": 434.4, "t": "Une idée implicite n'est"}, {"s": 434.4, "e": 435.93, "t": "pas dite directement,"}, {"s": 435.93, "e": 437.63, "t": "mais elle peut être comprise"}, {"s": 437.63, "e": 438.8, "t": "grâce au contexte."}, {"s": 438.8, "e": 441.53, "t": "Par exemple, son refus était implicite,"}, {"s": 441.53, "e": 442.87, "t": "il n'a jamais dit non,"}, {"s": 442.87, "e": 444.8, "t": "mais son message était très clair."}, {"s": 444.8, "e": 447.27, "t": "Et maintenant, voici le 12ᵉ"}, {"s": 447.27, "e": 449.4, "t": "et dernier mot : équivoque."}, {"s": 449.4, "e": 451.03, "t": "Celui-là, il est, selon moi,"}, {"s": 451.03, "e": 452.6, "t": "encore plus dur que les autres."}, {"s": 452.6, "e": 455.5, "t": "Mais alors, est-ce qu'équivoque signifie"}, {"s": 455.5, "e": 457.1, "t": "qui peut être interprété"}, {"s": 457.1, "e": 458.33, "t": "de plusieurs manières,"}, {"s": 458.33, "e": 460.5, "t": "qui ne contient aucune erreur"}, {"s": 460.5, "e": 461.83, "t": "ou qui provoque"}, {"s": 461.83, "e": 463.5, "t": "une forte émotion ?"}, {"s": 463.6, "e": 466.13, "t": "Trois, deux, un."}, {"s": 466.23, "e": 467.43, "t": "La bonne réponse"}, {"s": 467.43, "e": 468.83, "t": "c'est la A."}, {"s": 468.93, "e": 470.53, "t": "Une phrase équivoque"}, {"s": 470.53, "e": 472.8, "t": "peut avoir plusieurs significations."}, {"s": 472.8, "e": 474.23, "t": "Elle manque de clarté"}, {"s": 474.23, "e": 476.23, "t": "et peut créer un malentendu."}, {"s": 476.27, "e": 479.1, "t": "Par exemple, sa réponse était équivoque :"}, {"s": 479.1, "e": 480.67, "t": "je ne sais toujours pas s'il"}, {"s": 480.67, "e": 482.73, "t": "accepte ou s'il refuse."}, {"s": 482.73, "e": 484.43, "t": "Alors, c'est quoi ton résultat ?"}, {"s": 484.43, "e": 486.2, "t": "Si tu as obtenu douze sur douze,"}, {"s": 486.2, "e": 489.0, "t": "ton vocabulaire est vraiment excellent"}, {"s": 489.0, "e": 490.2, "t": "et selon ce test"}, {"s": 490.2, "e": 491.47, "t": "créé par moi-même,"}, {"s": 491.47, "e": 492.33, "t": "tu fais partie"}, {"s": 492.33, "e": 494.07, "t": "des meilleurs apprenants de français."}, {"s": 494.07, "e": 495.0, "t": "Et évidemment,"}, {"s": 495.0, "e": 496.93, "t": "si tu as obtenu moins de huit"}, {"s": 496.93, "e": 498.83, "t": "bonnes réponses, ne t'inquiète pas,"}, {"s": 498.83, "e": 500.13, "t": "ça signifie juste que"}, {"s": 500.13, "e": 501.33, "t": "tu viens d'apprendre"}, {"s": 501.33, "e": 503.0, "t": "plein de nouveaux mots qui vont"}, {"s": 503.0, "e": 504.4, "t": "peut-être t'être utiles."}, {"s": 504.43, "e": 507.1, "t": "Écris ton score sur douze en commentaire"}, {"s": 507.1, "e": 509.0, "t": "et ne mens pas, ça ne sert à rien."}, {"s": 509.0, "e": 509.8, "t": "Et au passage,"}, {"s": 509.8, "e": 510.83, "t": "tu peux même écrire"}, {"s": 510.83, "e": 512.27, "t": "quels ont été les nouveaux mots"}, {"s": 512.27, "e": 514.13, "t": "que tu as appris dans cette vidéo."}, {"s": 514.13, "e": 515.47, "t": "Enfin bref, j'ai hâte"}, {"s": 515.47, "e": 516.9, "t": "de lire vos commentaires !"}, {"s": 516.9, "e": 519.5, "t": "Like la vidéo, abonne-toi et clique"}, {"s": 519.5, "e": 520.77, "t": "sur cette vidéo si tu veux"}, {"s": 520.77, "e": 522.13, "t": "en apprendre encore plus."}, {"s": 522.13, "e": 523.67, "t": "C'était Gaspard Français."}, {"s": 523.7, "e": 524.43, "t": "Allez !"}]