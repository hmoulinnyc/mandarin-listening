[{"s": 0.14, "e": 2.08, "t": "Dans les années 1950,"}, {"s": 2.16, "e": 4.06, "t": "une jeune Française devient"}, {"s": 4.14, "e": 4.92, "t": "l'une des femmes"}, {"s": 5.0, "e": 7.29, "t": "les plus célèbres du monde."}, {"s": 7.42, "e": 10.29, "t": "Elle s'appelle Brigitte Bardot."}, {"s": 10.38, "e": 11.97, "t": "À seulement vingt-deux ans,"}, {"s": 12.06, "e": 14.97, "t": "elle va provoquer un véritable scandale"}, {"s": 15.2, "e": 17.48, "t": "avec un film qui va changer sa vie."}, {"s": 17.56, "e": 18.56, "t": "Sa beauté,"}, {"s": 18.76, "e": 21.28, "t": "sa façon de s'habiller, de danser"}, {"s": 21.36, "e": 24.92, "t": "et de se comporter fascinent le public."}, {"s": 25.0, "e": 26.58, "t": "À une époque où les femmes doivent"}, {"s": 26.66, "e": 28.16, "t": "encore respecter de nombreuses"}, {"s": 28.24, "e": 30.94, "t": "conventions, Brigitte Bardot incarne"}, {"s": 31.02, "e": 32.73, "t": "une nouvelle liberté."}, {"s": 33.38, "e": 35.62, "t": "Mais derrière cette image de femme libre"}, {"s": 35.7, "e": 38.44, "t": "et heureuse, la réalité est beaucoup"}, {"s": 38.52, "e": 39.52, "t": "plus compliquée."}, {"s": 39.6, "e": 40.5, "t": "Brigitte Bardot est aussi"}, {"s": 40.58, "e": 42.3, "t": "une personnalité controversée,"}, {"s": 42.38, "e": 43.8, "t": "notamment à cause de certaines"}, {"s": 43.88, "e": 45.44, "t": "déclarations politiques."}, {"s": 45.52, "e": 46.54, "t": "Alors, qui est vraiment"}, {"s": 46.62, "e": 47.62, "t": "Brigitte Bardot ?"}, {"s": 47.7, "e": 48.76, "t": "Comment est-elle devenue"}, {"s": 48.84, "e": 50.56, "t": "une icône mondiale ?"}, {"s": 50.64, "e": 52.7, "t": "Et pourquoi continue-t-elle aujourd'hui"}, {"s": 52.78, "e": 54.3, "t": "à diviser les Français ?"}, {"s": 54.38, "e": 55.64, "t": "Aujourd'hui, je vous propose"}, {"s": 55.72, "e": 58.04, "t": "de pratiquer votre français"}, {"s": 58.12, "e": 60.12, "t": "grâce à son histoire."}, {"s": 60.2, "e": 61.44, "t": "Avant de commencer à vous raconter"}, {"s": 61.52, "e": 63.57, "t": "l'histoire fascinante de Brigitte"}, {"s": 63.72, "e": 65.42, "t": "Bardot, je veux prendre une petite"}, {"s": 65.5, "e": 67.66, "t": "minute pour vous parler de mon cours"}, {"s": 67.74, "e": 70.38, "t": "en ligne 360 French Immersion"}, {"s": 70.46, "e": 72.38, "t": "et de l'offre exceptionnelle que je vous"}, {"s": 72.46, "e": 75.08, "t": "propose à l'occasion du Black Friday."}, {"s": 75.16, "e": 76.9, "t": "Si vous voulez apprendre le français"}, {"s": 76.98, "e": 80.02, "t": "véritablement parlé par les Français"}, {"s": 80.1, "e": 81.86, "t": "au quotidien dans leur vie,"}, {"s": 81.94, "e": 84.06, "t": "alors ce cours est fait pour vous."}, {"s": 84.14, "e": 85.68, "t": "Sur base de dialogues de la vie de tous"}, {"s": 85.76, "e": 87.36, "t": "les jours, je vous propose de pratiquer"}, {"s": 87.44, "e": 89.29, "t": "toutes les compétences, donc aussi bien"}, {"s": 89.68, "e": 90.79, "t": "la compréhension"}, {"s": 91.26, "e": 94.73, "t": "orale que la lecture, que l'orthographe,"}, {"s": 95.28, "e": 96.59, "t": "la grammaire,"}, {"s": 97.04, "e": 99.72, "t": "mais aussi l'expression orale,"}, {"s": 99.8, "e": 102.25, "t": "car c'est souvent ce qui manque un peu"}, {"s": 102.42, "e": 103.68, "t": "dans les cours de français."}, {"s": 103.76, "e": 105.02, "t": "Donc, je voulais vraiment axer"}, {"s": 105.1, "e": 107.25, "t": "une partie importante sur ça."}, {"s": 107.6, "e": 108.1, "t": "Dans mon cours,"}, {"s": 108.18, "e": 110.45, "t": "vous pouvez parler avec Jean."}, {"s": 110.76, "e": 111.5, "t": "C'est ma grenouille,"}, {"s": 111.58, "e": 112.84, "t": "c'est mon assistant."}, {"s": 112.92, "e": 114.06, "t": "Et vous pouvez discuter avec lui,"}, {"s": 114.14, "e": 116.43, "t": "donc des dialogues, mais également"}, {"s": 116.52, "e": 118.46, "t": "d'autres sujets pour vous aider"}, {"s": 118.54, "e": 120.23, "t": "à pratiquer votre français."}, {"s": 120.5, "e": 122.64, "t": "Et Jean va vous corriger"}, {"s": 122.72, "e": 123.44, "t": "et vous indiquer"}, {"s": 123.52, "e": 125.47, "t": "des pistes d'amélioration."}, {"s": 125.74, "e": 127.04, "t": "Alors, qu'est-ce qui ne va pas ?"}, {"s": 127.12, "e": 128.93, "t": "J'ai mal mon"}, {"s": 129.5, "e": 130.32, "t": "jambe."}, {"s": 130.4, "e": 131.1, "t": "Presque."}, {"s": 131.18, "e": 132.99, "t": "On dit plutôt : j'ai mal aux jambes."}, {"s": 133.26, "e": 134.18, "t": "Vas-y, redis-le."}, {"s": 134.26, "e": 135.5, "t": "Dans ce cours, vous avez également"}, {"s": 135.58, "e": 137.1, "t": "des tables de conversation"}, {"s": 137.18, "e": 138.28, "t": "qui sont incluses."}, {"s": 138.36, "e": 140.23, "t": "Donc, vous pouvez discuter,"}, {"s": 140.48, "e": 142.36, "t": "échanger avec d'autres personnes qui,"}, {"s": 142.44, "e": 143.82, "t": "comme vous, veulent"}, {"s": 143.9, "e": 145.78, "t": "pratiquer leur français."}, {"s": 145.86, "e": 147.36, "t": "À l'occasion du Black Friday,"}, {"s": 147.44, "e": 148.56, "t": "je vous disais, il y a une offre"}, {"s": 148.64, "e": 149.2, "t": "exceptionnelle"}, {"s": 149.28, "e": 151.67, "t": "qui n'arrivera qu'une fois par an."}, {"s": 151.8, "e": 153.85, "t": "Vous allez avoir moins 20%"}, {"s": 154.18, "e": 156.3, "t": "sur mon abonnement annuel"}, {"s": 156.38, "e": 158.68, "t": "à 360 French Immersion."}, {"s": 158.76, "e": 160.82, "t": "Et en plus, je vous offre un accès"}, {"s": 160.9, "e": 163.26, "t": "à mes deux autres cours en ligne :"}, {"s": 163.34, "e": 164.98, "t": "The 90-day Fluency Habit"}, {"s": 165.06, "e": 166.68, "t": "et The France Travel Kit."}, {"s": 166.76, "e": 168.52, "t": "En plus de ça, vous avez sept jours"}, {"s": 168.6, "e": 170.78, "t": "d'essai offerts afin de voir"}, {"s": 170.86, "e": 172.99, "t": "si mes méthodes d'apprentissage vous"}, {"s": 173.1, "e": 174.4, "t": "conviennent, vous correspondent."}, {"s": 174.48, "e": 176.28, "t": "Donc Vous pouvez vous inscrire"}, {"s": 176.36, "e": 178.3, "t": "et tester gratuitement."}, {"s": 178.38, "e": 180.79, "t": "Donc Je vous ai mis toutes les infos"}, {"s": 180.96, "e": 183.06, "t": "dans la description de cette vidéo."}, {"s": 183.14, "e": 184.35, "t": "Et si vous avez des questions,"}, {"s": 184.52, "e": 185.42, "t": "n'hésitez pas à me les poser"}, {"s": 185.5, "e": 187.85, "t": "en commentaire ou à m'envoyer un email."}, {"s": 191.56, "e": 193.44, "t": "Brigitte Bardot est née le 28"}, {"s": 193.52, "e": 196.34, "t": "septembre 1934 à Paris."}, {"s": 196.42, "e": 198.25, "t": "Elle naît dans une famille aisée,"}, {"s": 198.44, "e": 199.14, "t": "c'est-à-dire une famille"}, {"s": 199.22, "e": 200.91, "t": "qui a plutôt de l'argent."}, {"s": 201.0, "e": 203.28, "t": "Son père est ingénieur et il travaille"}, {"s": 203.36, "e": 205.4, "t": "dans l'entreprise familiale."}, {"s": 205.48, "e": 207.16, "t": "Sa mère s'occupe de l'éducation de"}, {"s": 207.24, "e": 209.06, "t": "Brigitte et de sa petite sœur."}, {"s": 209.14, "e": 210.74, "t": "La famille mène une vie confortable,"}, {"s": 210.82, "e": 212.71, "t": "mais ses parents sont très stricts."}, {"s": 212.86, "e": 214.0, "t": "À la maison, il faut"}, {"s": 214.08, "e": 215.55, "t": "respecter les règles."}, {"s": 216.08, "e": 218.35, "t": "Il faut être poli, bien se tenir"}, {"s": 218.58, "e": 220.92, "t": "et ne pas faire de vagues,"}, {"s": 221.0, "e": 222.61, "t": "ne pas faire de bêtises,"}, {"s": 223.1, "e": 224.74, "t": "de choses qui sortent de l'ordinaire."}, {"s": 224.82, "e": 225.98, "t": "Pourtant, la petite Brigitte"}, {"s": 226.06, "e": 227.99, "t": "a un caractère bien affirmé."}, {"s": 228.42, "e": 230.2, "t": "Elle a beaucoup de personnalité."}, {"s": 230.28, "e": 231.48, "t": "Très jeune, elle se passionne"}, {"s": 231.56, "e": 232.76, "t": "pour la danse classique."}, {"s": 232.84, "e": 234.08, "t": "Elle travaille beaucoup et suit"}, {"s": 234.16, "e": 235.32, "t": "notamment des cours"}, {"s": 235.4, "e": 237.37, "t": "au Conservatoire de Paris."}, {"s": 237.5, "e": 239.28, "t": "À l'adolescence, son allure"}, {"s": 239.36, "e": 241.08, "t": "et sa silhouette attirent"}, {"s": 241.16, "e": 243.26, "t": "l'attention du monde de la mode."}, {"s": 243.34, "e": 243.96, "t": "Elle commence alors"}, {"s": 244.04, "e": 245.91, "t": "à poser comme mannequin."}, {"s": 246.0, "e": 248.42, "t": "En 1950, alors qu'elle n'a que quinze"}, {"s": 248.5, "e": 249.5, "t": "ans, elle apparaît même"}, {"s": 249.58, "e": 251.94, "t": "en couverture du magazine Elle."}, {"s": 252.02, "e": 253.71, "t": "Et c'est une étape importante."}, {"s": 253.8, "e": 255.52, "t": "Grâce à ces photographies, elle va"}, {"s": 255.6, "e": 256.44, "t": "se faire repérer"}, {"s": 256.52, "e": 258.38, "t": "par des professionnels du cinéma."}, {"s": 258.46, "e": 259.86, "t": "Et c'est justement à cette période"}, {"s": 259.94, "e": 261.24, "t": "qu'elle va rencontrer un homme,"}, {"s": 261.32, "e": 262.12, "t": "Roger Vadim,"}, {"s": 262.2, "e": 264.59, "t": "qui va complètement changer sa vie."}, {"s": 268.54, "e": 269.58, "t": "Roger Vadim travaille"}, {"s": 269.66, "e": 270.84, "t": "dans le monde du cinéma."}, {"s": 270.92, "e": 273.2, "t": "Il rêve de devenir réalisateur."}, {"s": 273.28, "e": 275.14, "t": "Lorsqu'il rencontre Brigitte Bardot,"}, {"s": 275.22, "e": 276.8, "t": "elle n'est alors qu'une adolescente,"}, {"s": 276.88, "e": 278.46, "t": "mais tous les deux tombent amoureux."}, {"s": 278.54, "e": 280.04, "t": "Leur relation ne plaît pas du tout"}, {"s": 280.12, "e": 281.32, "t": "aux parents de Brigitte."}, {"s": 281.4, "e": 283.08, "t": "Pour eux, leur fille est beaucoup trop"}, {"s": 283.16, "e": 285.26, "t": "jeune et Roger Vadim ne correspond"}, {"s": 285.34, "e": 287.12, "t": "pas vraiment au gendre idéal."}, {"s": 287.2, "e": 288.88, "t": "Il ne correspond pas à l'homme qu'ils"}, {"s": 288.96, "e": 290.44, "t": "avaient imaginé pour elle."}, {"s": 290.52, "e": 291.54, "t": "Mais Brigitte refuse"}, {"s": 291.62, "e": 293.26, "t": "de renoncer à cette histoire."}, {"s": 293.34, "e": 296.34, "t": "Finalement, en 1952, quelques jours"}, {"s": 296.42, "e": 297.54, "t": "après ses dix-huit ans,"}, {"s": 297.62, "e": 298.76, "t": "elle va l'épouser."}, {"s": 298.84, "e": 300.52, "t": "Cette même année, elle fait ses premiers"}, {"s": 300.6, "e": 302.76, "t": "pas au cinéma, notamment dans le film"}, {"s": 302.84, "e": 305.39, "t": "Le Trou normand aux côtés de Bourvil,"}, {"s": 305.62, "e": 307.34, "t": "qui est un immense acteur français."}, {"s": 307.42, "e": 308.62, "t": "Cependant, à cette époque,"}, {"s": 308.7, "e": 310.12, "t": "rien ne laisse penser qu'elle deviendra"}, {"s": 310.2, "e": 311.63, "t": "une star mondiale."}, {"s": 311.72, "e": 312.9, "t": "Elle joue dans plusieurs films,"}, {"s": 312.98, "e": 313.68, "t": "mais sa carrière"}, {"s": 313.76, "e": 315.04, "t": "ne décolle pas vraiment."}, {"s": 315.12, "e": 316.42, "t": "Il faudra attendre quatre"}, {"s": 316.5, "e": 318.69, "t": "ans pour que tout bascule."}, {"s": 322.42, "e": 324.54, "t": "Nous sommes en 1956."}, {"s": 324.62, "e": 326.24, "t": "Roger Vadim réalise son premier long"}, {"s": 326.32, "e": 329.58, "t": "métrage Et Dieu créa la femme, avec,"}, {"s": 329.66, "e": 330.66, "t": "vous vous en doutez,"}, {"s": 330.76, "e": 333.31, "t": "Brigitte Bardot dans le rôle principal."}, {"s": 333.4, "e": 335.23, "t": "L'histoire se déroule à Saint-Tropez,"}, {"s": 335.56, "e": 338.0, "t": "à l'époque un petit village de pêcheurs"}, {"s": 338.08, "e": 339.2, "t": "sur la Côte d'Azur."}, {"s": 339.28, "e": 341.59, "t": "Brigitte Bardot interprète Juliette,"}, {"s": 341.86, "e": 343.74, "t": "une femme qui refuse de se laisser"}, {"s": 343.82, "e": 345.1, "t": "dicter sa conduite."}, {"s": 345.18, "e": 346.3, "t": "Elle aime danser,"}, {"s": 346.38, "e": 348.5, "t": "séduire et profiter de la vie."}, {"s": 348.58, "e": 348.86, "t": "C'est toujours"}, {"s": 348.94, "e": 350.59, "t": "comme si j'allais mourir le lendemain."}, {"s": 351.16, "e": 352.64, "t": "Il y a quelque chose de trop fort en moi"}, {"s": 352.72, "e": 354.12, "t": "qui me pousse à faire des bêtises."}, {"s": 354.2, "e": 355.84, "t": "Elle ne se comporte pas vraiment"}, {"s": 355.92, "e": 357.54, "t": "comme les autres femmes sont censées"}, {"s": 357.62, "e": 359.36, "t": "se comporter à cette époque."}, {"s": 359.44, "e": 359.86, "t": "Donc il faut bien"}, {"s": 359.94, "e": 361.18, "t": "comprendre le contexte."}, {"s": 361.26, "e": 362.81, "t": "Dans la France des années 1950,"}, {"s": 363.18, "e": 364.18, "t": "la société est encore"}, {"s": 364.26, "e": 365.56, "t": "assez conservatrice."}, {"s": 365.64, "e": 366.54, "t": "Les femmes mariées ne peuvent"}, {"s": 366.62, "e": 368.54, "t": "pas exercer une profession ou ouvrir"}, {"s": 368.62, "e": 369.95, "t": "un compte bancaire seules"}, {"s": 370.16, "e": 371.35, "t": "sans l'accord de leur mari."}, {"s": 371.44, "e": 372.22, "t": "Ces restrictions ne seront"}, {"s": 372.3, "e": 373.63, "t": "levées qu'en 1965."}, {"s": 374.9, "e": 376.42, "t": "Alors voir une jeune femme aussi"}, {"s": 376.5, "e": 378.56, "t": "indépendante à l'écran qui assume"}, {"s": 378.64, "e": 380.32, "t": "ses désirs, se moque du regard"}, {"s": 380.4, "e": 381.92, "t": "des autres, eh bien c'est un peu"}, {"s": 382.0, "e": 383.52, "t": "un choc pour le public."}, {"s": 383.6, "e": 385.8, "t": "Le film fait énormément parler de lui"}, {"s": 385.88, "e": 387.64, "t": "en France, mais aussi à l'étranger."}, {"s": 387.72, "e": 389.95, "t": "Et notamment aux États-Unis, ce qui va"}, {"s": 390.26, "e": 392.82, "t": "contribuer à transformer Brigitte Bardot"}, {"s": 392.9, "e": 395.41, "t": "en véritable phénomène international."}, {"s": 395.54, "e": 397.44, "t": "On la surnomme désormais BB."}, {"s": 397.52, "e": 398.98, "t": "Du jour au lendemain, elle devient"}, {"s": 399.06, "e": 399.54, "t": "l'une des femmes"}, {"s": 399.62, "e": 401.32, "t": "les plus photographiées du monde."}, {"s": 401.4, "e": 402.77, "t": "Et ce n'est que le début."}, {"s": 406.52, "e": 410.36, "t": "À la fin des années 1950 et 1960, BB,"}, {"s": 410.44, "e": 412.39, "t": "Brigitte Bardot, est partout."}, {"s": 412.48, "e": 414.16, "t": "Au cinéma, dans les magazines,"}, {"s": 414.24, "e": 415.31, "t": "à la télévision."}, {"s": 415.42, "e": 416.48, "t": "Son style est copié"}, {"s": 416.56, "e": 417.89, "t": "dans le monde entier."}, {"s": 418.02, "e": 419.54, "t": "Elle porte des ballerines,"}, {"s": 419.62, "e": 421.34, "t": "des robes légères, des vêtements"}, {"s": 421.42, "e": 423.16, "t": "simples, parfois les cheveux attachés"}, {"s": 423.24, "e": 424.18, "t": "en chignon, parfois"}, {"s": 424.26, "e": 425.74, "t": "complètement détachés."}, {"s": 425.82, "e": 427.76, "t": "L'une de ses tenues les plus célèbres"}, {"s": 427.84, "e": 430.22, "t": "est une robe à carreaux rose et blanc"}, {"s": 430.3, "e": 431.56, "t": "qu'elle porte pour son mariage"}, {"s": 431.64, "e": 434.23, "t": "avec l'acteur Jacques Charrier en 1959."}, {"s": 434.94, "e": 436.18, "t": "À l'époque où les célébrités"}, {"s": 436.26, "e": 437.59, "t": "apparaissent très souvent"}, {"s": 437.8, "e": 439.56, "t": "très sophistiquées, Brigitte Bardot"}, {"s": 439.64, "e": 440.78, "t": "préfère une allure"}, {"s": 440.86, "e": 442.44, "t": "naturelle et décontractée."}, {"s": 442.52, "e": 443.4, "t": "Elle contribue aussi"}, {"s": 443.48, "e": 445.74, "t": "à populariser Saint-Tropez."}, {"s": 445.82, "e": 447.95, "t": "Aujourd'hui, c'est une ville assez chic."}, {"s": 448.04, "e": 450.64, "t": "Ce petit village méditerranéen devient"}, {"s": 450.72, "e": 452.88, "t": "peu à peu, progressivement, un lieu"}, {"s": 452.96, "e": 455.49, "t": "à la mode, fréquenté par les artistes,"}, {"s": 455.82, "e": 457.88, "t": "les acteurs et les célébrités."}, {"s": 457.96, "e": 459.02, "t": "Donc encore aujourd'hui, c'est un"}, {"s": 459.1, "e": 461.86, "t": "endroit assez branché, comme on dit."}, {"s": 461.94, "e": 462.8, "t": "Mais vous l'avez compris,"}, {"s": 462.88, "e": 464.1, "t": "Brigitte Bardot ne se contente"}, {"s": 464.18, "e": 466.3, "t": "pas d'être une icône de la mode."}, {"s": 466.38, "e": 467.04, "t": "Elle continue aussi"}, {"s": 467.12, "e": 468.26, "t": "sa carrière au cinéma."}, {"s": 468.34, "e": 469.34, "t": "En 1960,"}, {"s": 469.68, "e": 471.02, "t": "elle joue dans La Vérité"}, {"s": 471.1, "e": 472.24, "t": "d'Henri-Georges Clouzot."}, {"s": 472.32, "e": 473.57, "t": "Puis en 1963,"}, {"s": 474.18, "e": 475.98, "t": "elle apparaît dans Le Mépris de Jean-Luc"}, {"s": 476.06, "e": 478.02, "t": "Godard, qui est un des plus grands"}, {"s": 478.1, "e": 479.64, "t": "classiques du cinéma français."}, {"s": 479.72, "e": 480.66, "t": "Elle va travailler avec certains"}, {"s": 480.74, "e": 481.88, "t": "des plus grands réalisateurs"}, {"s": 481.96, "e": 482.84, "t": "de cette époque."}, {"s": 482.92, "e": 484.54, "t": "Et la musique occupe également une place"}, {"s": 484.62, "e": 485.88, "t": "importante dans sa vie."}, {"s": 485.96, "e": 488.02, "t": "Elle va d'ailleurs enregistrer plusieurs"}, {"s": 488.1, "e": 490.09, "t": "titres avec le chanteur"}, {"s": 490.2, "e": 491.56, "t": "Serge Gainsbourg."}, {"s": 491.64, "e": 492.46, "t": "D'ailleurs, peut-être que vous"}, {"s": 492.54, "e": 494.36, "t": "connaissez l'une de leurs collaborations"}, {"s": 494.44, "e": 497.21, "t": "les plus connues, qui est sortie en 1968"}, {"s": 498.18, "e": 499.56, "t": "Bonnie and Clyde."}, {"s": 499.64, "e": 501.04, "t": "Mais alors que sa carrière connaît"}, {"s": 501.12, "e": 503.03, "t": "un succès extraordinaire,"}, {"s": 503.62, "e": 504.8, "t": "du côté de sa vie personnelle,"}, {"s": 504.88, "e": 506.55, "t": "c'est un peu plus compliqué."}, {"s": 510.5, "e": 511.86, "t": "Être Brigitte Bardot, ce n'est pas"}, {"s": 511.94, "e": 514.36, "t": "seulement vivre dans le luxe, voyager,"}, {"s": 514.44, "e": 516.78, "t": "rencontrer des célébrités, c'est aussi"}, {"s": 516.86, "e": 518.32, "t": "ne presque jamais"}, {"s": 518.4, "e": 520.02, "t": "pouvoir être tranquille."}, {"s": 520.1, "e": 521.0, "t": "En français, on dit :"}, {"s": 521.08, "e": 523.52, "t": "c'est la rançon de la gloire."}, {"s": 523.6, "e": 524.94, "t": "C'est un peu l'envers du décor,"}, {"s": 525.02, "e": 527.02, "t": "le revers de la médaille."}, {"s": 527.1, "e": 528.51, "t": "Les photographes la suivent partout,"}, {"s": 528.94, "e": 530.13, "t": "les paparazzis."}, {"s": 530.24, "e": 531.56, "t": "Ils essayent de la prendre en photo"}, {"s": 531.64, "e": 533.12, "t": "quand elle marche dans la rue,"}, {"s": 533.2, "e": 534.68, "t": "pendant ses vacances et dans tous"}, {"s": 534.76, "e": 536.4, "t": "les recoins de sa vie privée."}, {"s": 536.48, "e": 538.18, "t": "Ses histoires d'amour, ses mariages,"}, {"s": 538.26, "e": 540.06, "t": "ses séparations font régulièrement"}, {"s": 540.14, "e": 540.98, "t": "la une des journaux."}, {"s": 541.06, "e": 542.02, "t": "Et d'ailleurs, Brigitte Bardot va"}, {"s": 542.1, "e": 543.22, "t": "se marier quatre fois"}, {"s": 543.3, "e": 544.32, "t": "au cours de sa vie."}, {"s": 544.4, "e": 545.4, "t": "En 1960,"}, {"s": 545.5, "e": 546.38, "t": "elle va donner naissance"}, {"s": 546.46, "e": 547.68, "t": "à son unique enfant."}, {"s": 547.76, "e": 548.42, "t": "C'est un garçon"}, {"s": 548.5, "e": 550.2, "t": "et il se prénomme Nicolas."}, {"s": 550.28, "e": 551.64, "t": "Il va naître de son mariage"}, {"s": 551.72, "e": 553.13, "t": "avec Jacques Charrier."}, {"s": 553.22, "e": 554.7, "t": "Mais la maternité est une expérience"}, {"s": 554.78, "e": 556.18, "t": "assez difficile pour elle."}, {"s": 556.26, "e": 557.28, "t": "Elle racontera d'ailleurs plus tard"}, {"s": 557.36, "e": 558.66, "t": "qu'elle ne se sentait pas vraiment"}, {"s": 558.74, "e": 559.74, "t": "faite pour être mère."}, {"s": 559.82, "e": 561.32, "t": "Après la séparation de ses parents,"}, {"s": 561.4, "e": 563.64, "t": "après leur divorce, Nicolas va vivre"}, {"s": 563.72, "e": 566.02, "t": "auprès de son père, avec son père."}, {"s": 566.1, "e": 567.06, "t": "Et d'ailleurs, les déclarations"}, {"s": 567.14, "e": 568.99, "t": "qu'elle a faites sur la maternité vont"}, {"s": 569.08, "e": 570.82, "t": "choquer une partie du public."}, {"s": 570.9, "e": 572.8, "t": "Derrière les photographies glamour,"}, {"s": 572.88, "e": 575.62, "t": "Brigitte Bardot traverse aussi de graves"}, {"s": 575.7, "e": 578.66, "t": "périodes de détresse psychologique."}, {"s": 578.74, "e": 579.34, "t": "L'année de la naissance"}, {"s": 579.42, "e": 580.83, "t": "de son fils, donc en 1960,"}, {"s": 581.86, "e": 582.68, "t": "elle va d'ailleurs faire"}, {"s": 582.76, "e": 584.44, "t": "une tentative de suicide."}, {"s": 584.52, "e": 586.26, "t": "La célébrité qui semblait tout lui avoir"}, {"s": 586.34, "e": 588.94, "t": "apporté devient alors petit à petit"}, {"s": 589.02, "e": 590.51, "t": "un véritable poids."}, {"s": 590.62, "e": 591.62, "t": "Et elle rêve de retourner"}, {"s": 591.7, "e": 592.81, "t": "à une vie plus simple."}, {"s": 592.92, "e": 594.59, "t": "Et surtout, elle commence"}, {"s": 595.14, "e": 596.75, "t": "peu à s'intéresser,"}, {"s": 597.2, "e": 600.21, "t": "de plus en plus, au sort des animaux."}, {"s": 603.64, "e": 604.69, "t": "En 1973,"}, {"s": 605.3, "e": 606.7, "t": "Brigitte Bardot est âgée"}, {"s": 606.78, "e": 607.96, "t": "de trente-huit ans."}, {"s": 608.04, "e": 609.12, "t": "Je vous le disais, elle est connue"}, {"s": 609.2, "e": 610.62, "t": "dans le monde entier et elle a tourné"}, {"s": 610.7, "e": 611.94, "t": "dans des dizaines de films."}, {"s": 612.02, "e": 613.62, "t": "Pourtant, alors qu'une carrière toute"}, {"s": 613.7, "e": 614.8, "t": "tracée s'offre à elle,"}, {"s": 614.88, "e": 616.2, "t": "elle annonce arrêter"}, {"s": 616.28, "e": 618.13, "t": "le cinéma, définitivement."}, {"s": 618.24, "e": 619.48, "t": "Elle ne veut plus jouer de rôle,"}, {"s": 619.56, "e": 621.8, "t": "être observée en permanence ou subir"}, {"s": 621.88, "e": 624.34, "t": "les exigences du monde du spectacle"}, {"s": 624.42, "e": 625.53, "t": "et du monde du cinéma."}, {"s": 625.68, "e": 627.12, "t": "Le dernier film dans lequel elle a joué"}, {"s": 627.2, "e": 628.16, "t": "est l'histoire très bonne"}, {"s": 628.24, "e": 629.52, "t": "et très joyeuse de Colinot"}, {"s": 629.6, "e": 631.2, "t": "trousse-chemise. À partir de ce"}, {"s": 631.28, "e": 633.32, "t": "moment-là, elle décide de consacrer tout"}, {"s": 633.4, "e": 635.2, "t": "son temps, tout son argent"}, {"s": 635.28, "e": 636.4, "t": "et sa notoriété"}, {"s": 636.48, "e": 638.26, "t": "à la protection des animaux."}, {"s": 638.34, "e": 640.17, "t": "C'est une décision assez étonnante,"}, {"s": 640.26, "e": 642.98, "t": "car en effet, peu de stars aussi connues"}, {"s": 643.06, "e": 644.23, "t": "à l'international"}, {"s": 644.7, "e": 646.78, "t": "décident volontairement d'arrêter,"}, {"s": 646.86, "e": 648.59, "t": "de mettre fin à leur carrière,"}, {"s": 648.7, "e": 649.22, "t": "surtout alors"}, {"s": 649.3, "e": 651.14, "t": "qu'elles sont toujours aussi célèbres."}, {"s": 651.22, "e": 652.16, "t": "Mais pour Brigitte Bardot,"}, {"s": 652.24, "e": 652.82, "t": "cette nouvelle vie"}, {"s": 652.9, "e": 654.26, "t": "a beaucoup plus de sens."}, {"s": 654.34, "e": 656.1, "t": "Elle s'installe à l'écart de l'agitation"}, {"s": 656.18, "e": 658.7, "t": "médiatique, notamment dans sa propriété"}, {"s": 658.78, "e": 659.64, "t": "à Saint-Tropez,"}, {"s": 659.72, "e": 661.55, "t": "qui s'appelle La Madrague."}, {"s": 661.66, "e": 662.64, "t": "Et quelques années plus tard,"}, {"s": 662.72, "e": 665.64, "t": "ce sont ses actions pour les animaux"}, {"s": 665.72, "e": 667.4, "t": "qui vont à nouveau attirer"}, {"s": 667.48, "e": 669.29, "t": "l'attention du monde entier."}, {"s": 672.72, "e": 673.72, "t": "En 1977,"}, {"s": 674.44, "e": 675.9, "t": "elle va se rendre au Canada"}, {"s": 675.98, "e": 677.56, "t": "pour dénoncer la chasse"}, {"s": 677.64, "e": 679.05, "t": "aux bébés phoques."}, {"s": 679.16, "e": 680.58, "t": "À cette époque, leur fourrure"}, {"s": 680.66, "e": 682.58, "t": "est recherchée par l'industrie de la"}, {"s": 682.66, "e": 684.42, "t": "mode pour faire des vêtements."}, {"s": 684.5, "e": 686.34, "t": "Les photographies de l'ancienne star"}, {"s": 686.42, "e": 689.04, "t": "de cinéma allongée sur la glace à côté"}, {"s": 689.12, "e": 690.06, "t": "d'un bébé phoque vont"}, {"s": 690.14, "e": 691.2, "t": "faire le tour du monde."}, {"s": 691.28, "e": 693.37, "t": "Elle devient alors l'un des symboles"}, {"s": 693.62, "e": 695.38, "t": "de la lutte contre cette chasse."}, {"s": 695.46, "e": 697.3, "t": "Et cette mobilisation contribue"}, {"s": 697.38, "e": 699.26, "t": "à sensibiliser l'opinion publique"}, {"s": 699.34, "e": 701.49, "t": "internationale sur cette thématique."}, {"s": 701.62, "e": 702.62, "t": "En 1983,"}, {"s": 703.32, "e": 705.16, "t": "la Communauté économique européenne va"}, {"s": 705.24, "e": 707.56, "t": "d'ailleurs interdire l'importation de"}, {"s": 707.64, "e": 709.28, "t": "certaines peaux de jeunes phoques."}, {"s": 709.36, "e": 711.1, "t": "Brigitte Bardot continue ensuite"}, {"s": 711.18, "e": 714.45, "t": "à multiplier les campagnes en faveur"}, {"s": 714.74, "e": 715.84, "t": "de la protection des animaux"}, {"s": 715.92, "e": 716.52, "t": "et de leur bien-être."}, {"s": 716.6, "e": 717.64, "t": "Elle dénonce les mauvais traitements"}, {"s": 717.72, "e": 720.02, "t": "infligés aux animaux dans les élevages,"}, {"s": 720.1, "e": 721.38, "t": "dans les abattoirs, dans les"}, {"s": 721.46, "e": 723.97, "t": "laboratoires ou encore dans les cirques."}, {"s": 724.06, "e": 726.78, "t": "En 1986, elle crée sa fondation,"}, {"s": 726.86, "e": 729.02, "t": "donc la Fondation Brigitte Bardot."}, {"s": 729.1, "e": 730.88, "t": "Pour financer son projet et permettre"}, {"s": 730.96, "e": 732.48, "t": "à la Fondation de se développer,"}, {"s": 732.56, "e": 734.22, "t": "elle organise notamment une grande vente"}, {"s": 734.3, "e": 737.4, "t": "aux enchères de ses objets personnels."}, {"s": 737.48, "e": 738.57, "t": "En 1987,"}, {"s": 738.98, "e": 739.82, "t": "donc dans le cadre de cette vente"}, {"s": 739.9, "e": 742.29, "t": "aux enchères, elle va vendre des bijoux,"}, {"s": 742.84, "e": 744.32, "t": "des vêtements, des souvenirs"}, {"s": 744.4, "e": 746.02, "t": "et des objets liés à sa carrière."}, {"s": 746.1, "e": 747.22, "t": "Les fonds récoltés vont permettre"}, {"s": 747.3, "e": 748.82, "t": "de renforcer les moyens"}, {"s": 748.9, "e": 749.78, "t": "de son organisation."}, {"s": 749.86, "e": 751.93, "t": "Et la Fondation devient officiellement"}, {"s": 752.08, "e": 755.22, "t": "reconnue d'utilité publique en 1992."}, {"s": 755.3, "e": 757.0, "t": "Pendant plusieurs décennies, la défense"}, {"s": 757.08, "e": 758.76, "t": "des animaux occupe vraiment une place"}, {"s": 758.84, "e": 760.76, "t": "centrale dans la vie de Brigitte Bardot."}, {"s": 760.84, "e": 763.14, "t": "Mais son engagement public ne se limite"}, {"s": 763.22, "e": 764.76, "t": "pas à cette cause et certaines"}, {"s": 764.84, "e": 767.29, "t": "de ses déclarations vont provoquer"}, {"s": 767.46, "e": 769.21, "t": "d'importantes polémiques."}, {"s": 772.9, "e": 774.46, "t": "Avec les années, Brigitte Bardot"}, {"s": 774.54, "e": 775.22, "t": "s'est rapprochée"}, {"s": 775.3, "e": 777.11, "t": "de l'extrême droite française."}, {"s": 780.28, "e": 781.6, "t": "Elle affiche notamment sa sympathie"}, {"s": 781.68, "e": 783.05, "t": "pour Jean-Marie Le Pen."}, {"s": 783.28, "e": 783.8, "t": "Donc, vous connaissez"}, {"s": 783.88, "e": 785.49, "t": "peut-être Marine Le Pen."}, {"s": 785.92, "e": 787.68, "t": "Eh bien, c'était son père"}, {"s": 787.76, "e": 789.52, "t": "et le fondateur du Parti"}, {"s": 789.6, "e": 790.82, "t": "d'extrême droite français."}, {"s": 790.9, "e": 791.92, "t": "Donc à l'époque, c'était le Front"}, {"s": 792.0, "e": 793.38, "t": "national qui est devenu aujourd'hui"}, {"s": 793.46, "e": 795.02, "t": "le Rassemblement national."}, {"s": 795.1, "e": 796.6, "t": "À plusieurs reprises, elle va également"}, {"s": 796.68, "e": 798.85, "t": "tenir des propos problématiques"}, {"s": 799.72, "e": 801.77, "t": "à l'encontre de certaines communautés,"}, {"s": 801.86, "e": 804.31, "t": "notamment la communauté musulmane."}, {"s": 806.94, "e": 809.28, "t": "Et Également les Réunionnais,"}, {"s": 809.36, "e": 811.24, "t": "les habitants de l'île française"}, {"s": 811.32, "e": 812.32, "t": "de La Réunion."}, {"s": 815.48, "e": 816.76, "t": "Certaines de ces déclarations vont être"}, {"s": 816.84, "e": 817.92, "t": "jugées racistes"}, {"s": 818.0, "e": 819.19, "t": "par la justice française."}, {"s": 819.28, "e": 820.96, "t": "Et dans ce cadre, elle va être condamnée"}, {"s": 821.04, "e": 823.62, "t": "à plusieurs reprises pour incitation"}, {"s": 823.7, "e": 825.24, "t": "à la haine raciale."}, {"s": 825.32, "e": 827.04, "t": "Naturellement, ces condamnations"}, {"s": 827.12, "e": 829.35, "t": "provoquent des réactions assez fortes"}, {"s": 829.56, "e": 830.78, "t": "auprès de l'opinion publique."}, {"s": 830.86, "e": 832.18, "t": "D'un côté, il y a toujours"}, {"s": 832.26, "e": 834.92, "t": "ses défenseurs pour qui Brigitte Bardot"}, {"s": 835.0, "e": 837.8, "t": "restera une immense star du cinéma"}, {"s": 837.88, "e": 839.68, "t": "et une militante qui a consacré toute"}, {"s": 839.76, "e": 840.82, "t": "sa vie aux animaux."}, {"s": 840.9, "e": 842.3, "t": "Et pour ses détracteurs,"}, {"s": 842.38, "e": 843.78, "t": "donc les personnes qui ne l'aiment pas"}, {"s": 843.86, "e": 845.68, "t": "beaucoup, ses prises de position"}, {"s": 845.76, "e": 848.51, "t": "et ses propos discriminatoires font"}, {"s": 848.64, "e": 850.46, "t": "malheureusement partie de son héritage,"}, {"s": 850.54, "e": 852.24, "t": "occupent une place importante"}, {"s": 852.32, "e": 853.8, "t": "dans son héritage et ne peuvent"}, {"s": 853.88, "e": 854.8, "t": "pas être ignorés."}, {"s": 854.88, "e": 856.28, "t": "Cette contradiction, ça rend"}, {"s": 856.36, "e": 858.47, "t": "son parcours assez complexe."}, {"s": 858.68, "e": 860.36, "t": "Donc c'est difficile d'avoir un avis"}, {"s": 860.44, "e": 860.88, "t": "tranché"}, {"s": 860.96, "e": 862.82, "t": "sur cette personnalité française."}, {"s": 862.9, "e": 864.14, "t": "Surtout que d'un côté,"}, {"s": 864.22, "e": 867.13, "t": "elle va représenter une femme libre,"}, {"s": 867.3, "e": 869.67, "t": "donc une forme de liberté féminine"}, {"s": 869.84, "e": 871.09, "t": "et d'un autre côté,"}, {"s": 871.36, "e": 872.87, "t": "eh bien, elle représente"}, {"s": 873.26, "e": 875.45, "t": "des valeurs très conservatrices."}, {"s": 878.78, "e": 879.78, "t": "Pendant les dernières décennies"}, {"s": 879.86, "e": 881.06, "t": "de sa vie, Brigitte Bardot a fait"}, {"s": 881.14, "e": 882.42, "t": "de moins en moins"}, {"s": 882.5, "e": 883.66, "t": "d'apparitions publiques."}, {"s": 883.74, "e": 885.22, "t": "Elle passait énormément de temps"}, {"s": 885.3, "e": 886.54, "t": "dans le sud de la France,"}, {"s": 886.62, "e": 887.66, "t": "entourée par ses animaux."}, {"s": 887.74, "e": 889.4, "t": "Elle continuait cependant à s'exprimer"}, {"s": 889.48, "e": 891.91, "t": "sur la cause animale et sur"}, {"s": 892.3, "e": 893.46, "t": "l'actualité politique."}, {"s": 893.54, "e": 896.45, "t": "Le 28 décembre 2025, donc il y a presque"}, {"s": 896.54, "e": 898.64, "t": "un an, sa fondation a annoncé son décès"}, {"s": 898.72, "e": 900.49, "t": "à l'âge de quatre-vingt-onze ans."}, {"s": 908.42, "e": 909.42, "t": "J'ai donné"}, {"s": 909.8, "e": 911.73, "t": "ma jeunesse et ma beauté aux hommes"}, {"s": 912.14, "e": 913.64, "t": "et que je donne ma sagesse"}, {"s": 913.72, "e": 916.0, "t": "et mon expérience maintenant"}, {"s": 916.08, "e": 918.53, "t": "et le meilleur de moi-même aux animaux."}, {"s": 920.64, "e": 922.2, "t": "Sa disparition a suscité de nombreux"}, {"s": 922.28, "e": 924.12, "t": "hommages en France comme à l'étranger."}, {"s": 924.2, "e": 925.02, "t": "Mais"}, {"s": 925.1, "e": 927.27, "t": "ces hommages ont également relancé"}, {"s": 927.4, "e": 929.08, "t": "le débat sur sa personnalité"}, {"s": 929.16, "e": 930.14, "t": "et ses convictions."}, {"s": 930.22, "e": 931.52, "t": "Aujourd'hui encore, son image reste"}, {"s": 931.6, "e": 933.5, "t": "associée à Saint-Tropez, au cinéma"}, {"s": 933.58, "e": 936.04, "t": "français des années 1960 et à une"}, {"s": 936.12, "e": 937.51, "t": "certaine idée de la liberté."}, {"s": 937.6, "e": 938.56, "t": "Ses films continuent à être"}, {"s": 938.64, "e": 939.8, "t": "regardés et étudiés."}, {"s": 939.88, "e": 940.92, "t": "Je vous les conseille d'ailleurs si vous"}, {"s": 941.0, "e": 941.88, "t": "n'en avez vu aucun."}, {"s": 941.96, "e": 943.96, "t": "Son style vestimentaire a marqué"}, {"s": 944.04, "e": 946.08, "t": "plusieurs générations et son engagement"}, {"s": 946.16, "e": 948.48, "t": "pour les animaux a aidé à faire évoluer"}, {"s": 948.56, "e": 950.3, "t": "les mentalités sur ce sujet."}, {"s": 950.38, "e": 951.84, "t": "Brigitte Bardot laisse donc un héritage"}, {"s": 951.92, "e": 953.0, "t": "à plusieurs facettes."}, {"s": 953.08, "e": 954.54, "t": "Voilà, vous connaissez maintenant"}, {"s": 954.62, "e": 956.08, "t": "l'histoire de Brigitte Bardot,"}, {"s": 956.16, "e": 958.08, "t": "l'une des personnalités françaises"}, {"s": 958.16, "e": 960.25, "t": "les plus connues du XXe siècle."}, {"s": 960.4, "e": 962.17, "t": "Si vous avez aimé cette vidéo,"}, {"s": 962.38, "e": 963.96, "t": "n'oubliez pas de mettre un j'aime."}, {"s": 964.04, "e": 965.96, "t": "Vous savez que ça m'aide beaucoup"}, {"s": 966.04, "e": 967.1, "t": "à faire ressortir"}, {"s": 967.18, "e": 968.71, "t": "mon travail dans YouTube."}, {"s": 968.94, "e": 970.28, "t": "Si vous êtes nouveau ou nouvelle"}, {"s": 970.36, "e": 972.48, "t": "par ici, n'oubliez pas de vous abonner"}, {"s": 972.56, "e": 975.14, "