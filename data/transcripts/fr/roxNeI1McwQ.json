[{"s": 0.52, "e": 5.24, "t": "Aujourd'hui, on va cuisiner ensemble. Je"}, {"s": 5.24, "e": 9.0, "t": "parle uniquement en français, mais je"}, {"s": 9.0, "e": 13.76, "t": "parle lentement. Tu vas tout comprendre."}, {"s": 19.2, "e": 22.12, "t": "Je mets mon tablier."}, {"s": 22.12, "e": 25.12, "t": "Hop."}, {"s": 26.04, "e": 27.2, "t": "Voilà."}, {"s": 27.2, "e": 31.08, "t": "Et je me lave les mains."}, {"s": 31.08, "e": 35.28, "t": "Je me lave les mains."}, {"s": 37.24, "e": 42.24, "t": "La première chose à faire, c'est"}, {"s": 42.24, "e": 45.68, "t": "préchauffer le four."}, {"s": 45.68, "e": 47.72, "t": "Préchauffer"}, {"s": 47.72, "e": 49.56, "t": "le four."}, {"s": 49.56, "e": 55.96, "t": "Je préchauffe le four à 180°."}, {"s": 56.36, "e": 59.36, "t": "180°."}, {"s": 61.2, "e": 67.32, "t": "Maintenant, je choisis les ingrédients."}, {"s": 74.52, "e": 77.6, "t": "Pour cette recette, j'ai besoin d'une"}, {"s": 77.6, "e": 79.36, "t": "courgette,"}, {"s": 79.36, "e": 81.56, "t": "d'un citron,"}, {"s": 81.56, "e": 84.72, "t": "d'un bloc de féta,"}, {"s": 84.72, "e": 87.0, "t": "de la crème fraîche,"}, {"s": 87.0, "e": 89.56, "t": "d'une pâte à tarte,"}, {"s": 89.56, "e": 93.48, "t": "d'un œuf, de l'huile,"}, {"s": 93.48, "e": 95.44, "t": "du poivre"}, {"s": 95.44, "e": 100.56, "t": "et du sel. Je commence par la courgette."}, {"s": 100.56, "e": 103.84, "t": "Je commence par couper"}, {"s": 103.84, "e": 106.68, "t": "les extrémités."}, {"s": 106.68, "e": 113.08, "t": "Je coupe les extrémités de la courgette."}, {"s": 117.16, "e": 121.8, "t": "Avec un couteau, je coupe en lamelle"}, {"s": 121.8, "e": 124.84, "t": "très fine,"}, {"s": 124.84, "e": 129.84, "t": "tu vois ? très fine."}, {"s": 139.08, "e": 144.08, "t": "J'ai mis les courgettes dans un bol."}, {"s": 144.08, "e": 146.8, "t": "Dans un bol. Et maintenant, on va"}, {"s": 146.8, "e": 152.0, "t": "préparer l'appareil à tarte. L'appareil"}, {"s": 152.0, "e": 156.76, "t": "à tarte, c'est la crème de feta. et de"}, {"s": 156.76, "e": 160.16, "t": "citron qu'on va mettre avec les"}, {"s": 160.16, "e": 161.92, "t": "courgettes."}, {"s": 161.92, "e": 165.8, "t": "Dans un saladier,"}, {"s": 165.8, "e": 174.12, "t": "je viens casser mon œuf. Casser mon œuf."}, {"s": 176.4, "e": 180.44, "t": "Attention aux coquilles."}, {"s": 180.44, "e": 182.28, "t": "J'ajoute"}, {"s": 182.28, "e": 188.32, "t": "la feta et j'ai miette la feta."}, {"s": 188.32, "e": 191.2, "t": "J'ai miette"}, {"s": 191.2, "e": 194.4, "t": "la feta."}, {"s": 196.2, "e": 201.84, "t": "Ensuite, j'ajoute une cuillère à soupe,"}, {"s": 201.84, "e": 204.72, "t": "une grosse cuillère"}, {"s": 204.72, "e": 208.28, "t": "de crème fraîche."}, {"s": 212.68, "e": 216.04, "t": "Ensuite, je vais râper"}, {"s": 216.04, "e": 220.52, "t": "le citron pour avoir du zeste."}, {"s": 220.52, "e": 225.48, "t": "Du zeste de citron. Et j'ai une petite"}, {"s": 225.48, "e": 227.0, "t": "rappe"}, {"s": 227.0, "e": 230.28, "t": "trop mignonne."}, {"s": 233.96, "e": 236.08, "t": "Tu vois, ça"}, {"s": 236.08, "e": 241.36, "t": "c'est le zeste du citron."}, {"s": 246.32, "e": 249.4, "t": "J'ajoute le jus"}, {"s": 249.4, "e": 251.56, "t": "du citron."}, {"s": 251.56, "e": 253.8, "t": "J'adore"}, {"s": 253.8, "e": 257.32, "t": "le citron dans les tartes."}, {"s": 257.32, "e": 259.48, "t": "J'ajoute"}, {"s": 259.48, "e": 262.0, "t": "un tout petit peu"}, {"s": 262.0, "e": 267.92, "t": "de sel, un peu de poivre,"}, {"s": 268.4, "e": 271.56, "t": "un tout petit peu"}, {"s": 271.56, "e": 274.96, "t": "d'huile d'olive"}, {"s": 277.28, "e": 282.72, "t": "et je mélange avec une fourchette."}, {"s": 282.72, "e": 288.0, "t": "Je mélange avec une fourchette."}, {"s": 297.76, "e": 303.64, "t": "Maintenant, je prends un moule à tarte."}, {"s": 303.64, "e": 308.64, "t": "Un moule à tarte."}, {"s": 309.88, "e": 314.16, "t": "Et je viens mettre"}, {"s": 314.16, "e": 317.52, "t": "ma pâte à tarte."}, {"s": 317.52, "e": 321.52, "t": "dans le moule"}, {"s": 322.6, "e": 327.84, "t": "et avec une fourchette, je viens piquer"}, {"s": 327.84, "e": 329.76, "t": "la tarte."}, {"s": 329.76, "e": 333.32, "t": "Je viens faire des petits trous avec la"}, {"s": 333.32, "e": 338.84, "t": "fourchette. Piquer la tarte."}, {"s": 340.6, "e": 345.68, "t": "Je commence par mettre un peu de crème"}, {"s": 345.68, "e": 349.32, "t": "au fond de la tarte."}, {"s": 349.32, "e": 354.2, "t": "J'en mets un petit peu."}, {"s": 354.48, "e": 356.24, "t": "Ensuite,"}, {"s": 356.24, "e": 358.2, "t": "j'ajoute"}, {"s": 358.2, "e": 361.52, "t": "des courgettes,"}, {"s": 361.6, "e": 366.92, "t": "une couche de courgett."}, {"s": 368.72, "e": 373.28, "t": "Je verse un peu"}, {"s": 373.28, "e": 375.8, "t": "de crème."}, {"s": 375.8, "e": 380.24, "t": "J'ajoute des courgettes"}, {"s": 382.64, "e": 387.04, "t": "et enfin je verse le reste"}, {"s": 387.04, "e": 393.24, "t": "de la crème sur les courgettes."}, {"s": 395.56, "e": 398.56, "t": "Et voilà, préparation"}, {"s": 398.56, "e": 403.64, "t": "terminée. La tarte est prête à aller au"}, {"s": 403.64, "e": 409.12, "t": "four pendant environ 40 minutes."}, {"s": 409.12, "e": 412.6, "t": "40 minutes."}, {"s": 416.84, "e": 419.96, "t": "La tarte est au four."}, {"s": 419.96, "e": 424.56, "t": "On se retrouve dans 40 minutes pour voir"}, {"s": 424.56, "e": 428.68, "t": "le résultat final."}, {"s": 436.4, "e": 440.76, "t": "Dis-moi en commentaire si tu vas essayer"}, {"s": 440.76, "e": 444.48, "t": "cette recette. N'oublie pas de t'abonner"}, {"s": 444.48, "e": 449.24, "t": "à la chaîne. à la semaine prochaine."}]