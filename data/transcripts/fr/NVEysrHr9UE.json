[{"s": 0.43, "e": 2.33, "t": "Aujourd'hui je vais manger"}, {"s": 2.77, "e": 5.0, "t": "dans un restaurant français."}, {"s": 6.43, "e": 8.3, "t": "Le restaurant s'appelle"}, {"s": 9.0, "e": 10.8, "t": "Le Petit Bistrot."}, {"s": 12.33, "e": 13.2, "t": "Un bistrot,"}, {"s": 13.67, "e": 14.8, "t": "c'est généralement"}, {"s": 15.33, "e": 16.33, "t": "un petit"}, {"s": 16.43, "e": 19.73, "t": "restaurant simple et convivial"}, {"s": 20.3, "e": 21.73, "t": "où l'on peut manger"}, {"s": 22.17, "e": 24.13, "t": "des plats traditionnels."}, {"s": 26.07, "e": 26.87, "t": "Pour le moment,"}, {"s": 27.4, "e": 29.6, "t": "il n'y a encore personne."}, {"s": 31.43, "e": 33.5, "t": "Toutes les tables sont libres"}, {"s": 33.97, "e": 37.3, "t": "et la salle est complètement calme."}, {"s": 38.9, "e": 41.7, "t": "Nous sommes les premiers clients."}, {"s": 43.5, "e": 46.07, "t": "La serveuse nous accueille."}, {"s": 47.9, "e": 50.4, "t": "Bonjour, bienvenue au Petit Bistrot."}, {"s": 50.67, "e": 51.47, "t": "Bonjour."}, {"s": 51.77, "e": 53.8, "t": "Vous préférez vous installer à l'intérieur"}, {"s": 53.9, "e": 54.8, "t": "ou à l'extérieur ?"}, {"s": 55.43, "e": 56.37, "t": "Euh, à l'extérieur,"}, {"s": 56.83, "e": 57.63, "t": "s'il vous plaît."}, {"s": 57.97, "e": 58.67, "t": "Très bien."}, {"s": 59.1, "e": 61.0, "t": "Installez-vous. Je vais vous préparer la table."}, {"s": 62.63, "e": 66.83, "t": "L'employée commence à préparer notre table."}, {"s": 68.27, "e": 72.33, "t": "D'abord, elle pose une nappe sur la table."}, {"s": 74.13, "e": 76.17, "t": "C'est une nappe orange"}, {"s": 76.8, "e": 79.07, "t": "et blanche à carreaux."}, {"s": 80.63, "e": 84.83, "t": "Au début, il y a quelques plis dans la nappe."}, {"s": 86.2, "e": 90.53, "t": "L'employée passe donc sa main dessus"}, {"s": 91.13, "e": 92.67, "t": "pour la lisser."}, {"s": 94.23, "e": 98.87, "t": "Elle lisse la nappe pour enlever les plis"}, {"s": 99.4, "e": 102.47, "t": "et pour qu'elle soit bien plate."}, {"s": 103.97, "e": 105.47, "t": "Ensuite, elle pose"}, {"s": 106.07, "e": 108.67, "t": "un petit vase sur la table."}, {"s": 109.73, "e": 113.13, "t": "Dans le vase, il y a quelques fleurs."}, {"s": 115.43, "e": 117.9, "t": "Une autre employée arrive"}, {"s": 118.7, "e": 121.53, "t": "pour poser un set de table."}, {"s": 123.5, "e": 125.83, "t": "Sur la table, il y a aussi"}, {"s": 126.53, "e": 132.63, "t": "une lampe et des couverts posés sur une serviette rouge."}, {"s": 134.67, "e": 137.87, "t": "Ça, c'est la carte du restaurant."}, {"s": 139.3, "e": 141.83, "t": "J'ouvre la carte pour regarder"}, {"s": 142.33, "e": 145.3, "t": "les plats et les boissons proposées."}, {"s": 146.27, "e": 148.1, "t": "Je tourne la page."}, {"s": 149.73, "e": 151.7, "t": "Au début de la carte,"}, {"s": 152.3, "e": 154.33, "t": "il y a les apéritifs."}, {"s": 155.6, "e": 158.73, "t": "Un apéritif, ou un apéro,"}, {"s": 159.17, "e": 161.23, "t": "c'est une boisson que l'on prend"}, {"s": 161.83, "e": 163.23, "t": "avant le repas."}, {"s": 164.43, "e": 165.23, "t": "Ensuite,"}, {"s": 165.47, "e": 170.5, "t": "il y a les plateaux de charcuterie et de fromage."}, {"s": 171.9, "e": 173.07, "t": "La charcuterie"}, {"s": 173.67, "e": 176.73, "t": "comprend différents produits préparés"}, {"s": 177.47, "e": 179.0, "t": "avec de la viande,"}, {"s": 179.77, "e": 181.47, "t": "comme le jambon"}, {"s": 182.27, "e": 183.87, "t": "ou le saucisson."}, {"s": 189.13, "e": 190.23, "t": "Des risottos,"}, {"s": 191.23, "e": 196.83, "t": "des plats de poisson et plusieurs plats principaux."}, {"s": 199.0, "e": 202.2, "t": "À la fin, on retrouve les desserts,"}, {"s": 203.2, "e": 205.6, "t": "un menu pour enfants,"}, {"s": 206.47, "e": 206.57, "t": "et des cocktails et différents vins."}, {"s": 212.27, "e": 214.53, "t": "Il y a beaucoup de choix,"}, {"s": 215.43, "e": 219.07, "t": "mais je sais déjà ce que je vais commander."}, {"s": 219.53, "e": 220.67, "t": "Vous avez choisi ?"}, {"s": 221.17, "e": 221.7, "t": "Oui,"}, {"s": 222.3, "e": 223.1, "t": "Pour commencer,"}, {"s": 223.67, "e": 226.5, "t": "je vais prendre le steak tartare,"}, {"s": 226.93, "e": 227.73, "t": "s'il vous plaît."}, {"s": 228.37, "e": 229.37, "t": "Très bien."}, {"s": 229.47, "e": 231.17, "t": "Et comme plat principal ?"}, {"s": 232.07, "e": 235.6, "t": "Ensuite, je prendrai le steak-frites"}, {"s": 236.23, "e": 238.67, "t": "avec la sauce aux champignons."}, {"s": 239.2, "e": 241.47, "t": "Quelle cuisson souhaitez-vous pour le steak ?"}, {"s": 242.2, "e": 243.03, "t": "à point,"}, {"s": 243.5, "e": 244.3, "t": "s'il vous plaît."}, {"s": 244.83, "e": 245.53, "t": "Très bien."}, {"s": 245.87, "e": 246.8, "t": "Ce sera tout ?"}, {"s": 247.37, "e": 249.7, "t": "Oui, ce sera tout, merci."}, {"s": 251.33, "e": 252.93, "t": "Quelques minutes plus tard,"}, {"s": 253.57, "e": 255.4, "t": "le premier plat arrive."}, {"s": 256.83, "e": 259.3, "t": "Voilà le steak tartare."}, {"s": 260.4, "e": 266.1, "t": "Le steak tartare est servi avec une portion de frites."}, {"s": 267.17, "e": 269.97, "t": "Je l'ai commandé comme entrée."}, {"s": 270.87, "e": 272.53, "t": "Un steak tartare"}, {"s": 273.13, "e": 275.37, "t": "n'est pas un steak classique."}, {"s": 276.43, "e": 278.73, "t": "La viande n'est pas cuite."}, {"s": 279.53, "e": 282.47, "t": "C'est de la viande de bœuf crue,"}, {"s": 283.53, "e": 286.57, "t": "généralement hachée ou coupée"}, {"s": 287.23, "e": 288.37, "t": "très finement."}, {"s": 289.53, "e": 294.87, "t": "Ici, la viande est présentée en forme de cercle."}, {"s": 296.4, "e": 300.4, "t": "Au centre, il y a un jaune d'œuf."}, {"s": 301.83, "e": 304.33, "t": "Alors, avant de goûter le tartare,"}, {"s": 305.03, "e": 306.7, "t": "on va l'assaisonner."}, {"s": 307.97, "e": 309.7, "t": "Assaisonner un plat,"}, {"s": 310.27, "e": 313.8, "t": "c'est ajouter des ingrédients pour lui donner"}, {"s": 314.37, "e": 315.77, "t": "plus de goût."}, {"s": 317.4, "e": 321.27, "t": "D'abord, on ajoute un peu de sel."}, {"s": 322.7, "e": 326.87, "t": "Puis, on ajoute quelques gouttes de Tabasco."}, {"s": 328.33, "e": 331.73, "t": "Le Tabasco, c'est une sauce piquante."}, {"s": 337.47, "e": 341.27, "t": "Puis, on ajoute un peu de moutarde."}, {"s": 346.83, "e": 347.47, "t": "Et maintenant,"}, {"s": 348.23, "e": 349.8, "t": "on va tout mélanger."}, {"s": 350.17, "e": 353.7, "t": "On commence par casser le jaune d'œuf"}, {"s": 354.47, "e": 357.33, "t": "avec la fourchette et le couteau."}, {"s": 359.8, "e": 362.57, "t": "Puis, on mélange le tout."}, {"s": 367.23, "e": 371.53, "t": "Au début, tous les ingrédients étaient séparés."}, {"s": 373.03, "e": 375.7, "t": "Maintenant, ils sont mélangés."}, {"s": 381.03, "e": 381.83, "t": "On goûte,"}, {"s": 384.8, "e": 387.83, "t": "et il manque un peu de poivre."}, {"s": 389.23, "e": 394.17, "t": "On ajoute donc un peu de poivre au plat."}, {"s": 395.97, "e": 398.73, "t": "Puis, on goûte de nouveau."}, {"s": 399.93, "e": 402.0, "t": "La viande est froide,"}, {"s": 402.9, "e": 405.4, "t": "crue et très tendre."}, {"s": 408.53, "e": 409.97, "t": "Le plat principal"}, {"s": 410.87, "e": 412.03, "t": "vient d'arriver."}, {"s": 414.23, "e": 416.2, "t": "C'est un steak-frites."}, {"s": 417.17, "e": 420.3, "t": "Il est bien grillé à l'extérieur"}, {"s": 421.13, "e": 422.87, "t": "et encore rosé"}, {"s": 423.67, "e": 424.47, "t": "à l'intérieur."}, {"s": 425.83, "e": 427.63, "t": "Une viande rosée,"}, {"s": 428.37, "e": 432.93, "t": "c'est une viande cuite qui reste légèrement rose"}, {"s": 433.83, "e": 434.63, "t": "au centre."}, {"s": 436.37, "e": 439.67, "t": "Avec une sauce aux champignons et des haricots verts."}, {"s": 448.03, "e": 450.3, "t": "Et ici, dans ce petit"}, {"s": 450.93, "e": 454.27, "t": "récipient qu'on appelle un ramequin,"}, {"s": 455.07, "e": 458.27, "t": "il y a la sauce aux champignons."}, {"s": 459.3, "e": 460.5, "t": "Je vais maintenant"}, {"s": 461.23, "e": 465.87, "t": "mettre la sauce aux champignons sur le steak."}, {"s": 466.67, "e": 467.47, "t": "Pour commencer,"}, {"s": 468.3, "e": 472.07, "t": "j'utilise la petite cuillère."}, {"s": 472.63, "e": 477.13, "t": "Je prends un peu de sauce avec la cuillère,"}, {"s": 478.23, "e": 480.03, "t": "puis je la verse"}, {"s": 480.63, "e": 481.53, "t": "sur la viande."}, {"s": 482.6, "e": 485.0, "t": "Puis, pour aller plus vite,"}, {"s": 486.0, "e": 490.3, "t": "je prends directement le ramequin dans ma main"}, {"s": 491.0, "e": 492.9, "t": "et je verse la sauce"}, {"s": 493.5, "e": 494.6, "t": "sur le steak."}, {"s": 496.07, "e": 498.93, "t": "Voilà, c'est beaucoup plus rapide."}, {"s": 500.27, "e": 503.33, "t": "Je prends une première bouchée,"}, {"s": 508.33, "e": 509.93, "t": "puis une deuxième."}, {"s": 511.83, "e": 513.13, "t": "Il est très bon."}, {"s": 514.3, "e": 516.3, "t": "La viande est tendre"}, {"s": 516.93, "e": 521.2, "t": "et la sauce aux champignons se marie très bien"}, {"s": 521.8, "e": 522.8, "t": "avec le steak."}]