[{"s": 0.0, "e": 2.6, "t": "Salut les amis, bienvenue dans un nouvel"}, {"s": 2.6, "e": 4.08, "t": "épisode d'Easy French."}, {"s": 4.08, "e": 5.96, "t": "Salut à tous, salut Hélène."}, {"s": 5.96, "e": 8.6, "t": "Aujourd'hui, nous allons parler de nos"}, {"s": 8.6, "e": 11.4, "t": "goûts, ce qu'on aime et ce qu'on aime"}, {"s": 11.4, "e": 13.84, "t": "pas. Par exemple, Axel,"}, {"s": 13.84, "e": 16.4, "t": "tu aimes enseigner le ?"}, {"s": 16.4, "e": 19.64, "t": "Oui, j'adore ça."}, {"s": 19.64, "e": 23.2, "t": "Moi aussi, j'adore ça. Alors, on y ?"}, {"s": 23.2, "e": 25.92, "t": "C'est parti."}, {"s": 34.2, "e": 37.44, "t": "Dis-moi, Axel, tu aimes les ?"}, {"s": 37.44, "e": 41.72, "t": "Oui, j'aime les pizzas. Et toi, tu aimes"}, {"s": 41.72, "e": 42.36, "t": "?"}, {"s": 42.36, "e": 46.2, "t": "J'aime beaucoup les pizzas, mais pas les"}, {"s": 46.2, "e": 48.08, "t": "pizzas aux champignons."}, {"s": 48.08, "e": 49.36, "t": "Ah ?"}, {"s": 49.36, "e": 51.0, "t": "Mais ?"}, {"s": 51.0, "e": 52.8, "t": "Ça me dégoûte."}, {"s": 52.8, "e": 56.84, "t": "Moi, j'aime les champignons, mais pas"}, {"s": 56.84, "e": 57.8, "t": "les olives."}, {"s": 57.8, "e": 59.08, "t": "Ah ?"}, {"s": 59.08, "e": 61.48, "t": "Moi, j'aime les olives."}, {"s": 61.48, "e": 64.88, "t": "Bon, j'imagine qu'on ne va pas partager"}, {"s": 64.88, "e": 66.12, "t": "de pizza."}, {"s": 66.12, "e": 68.48, "t": "Pour parler de nos goûts, on utilise le"}, {"s": 68.48, "e": 72.24, "t": "verbe aimer. Avec le verbe aimer, on"}, {"s": 72.24, "e": 75.56, "t": "utilise généralement le, la,"}, {"s": 75.56, "e": 79.56, "t": "l'apostrophe ou les. Pour remplacer un"}, {"s": 79.56, "e": 83.6, "t": "nom, on peut utiliser ça."}, {"s": 83.6, "e": 88.88, "t": "À la forme négative, on utilise ne pas."}, {"s": 88.88, "e": 93.0, "t": "J'aime le chocolat."}, {"s": 93.0, "e": 96.84, "t": "J'aime la musique."}, {"s": 96.84, "e": 100.96, "t": "J'aime les pizzas."}, {"s": 100.96, "e": 104.32, "t": "J'aime ça."}, {"s": 104.32, "e": 107.88, "t": "Je n'aime pas les olives."}, {"s": 107.88, "e": 112.28, "t": "Je n'aime pas les champignons."}, {"s": 112.28, "e": 115.72, "t": "Je n'aime pas le froid."}, {"s": 115.72, "e": 119.2, "t": "Et à l'oral, les Français disent aussi"}, {"s": 119.2, "e": 122.69, "t": "très souvent \"J'aime pas.\""}, {"s": 122.69, "e": 126.53, "t": "\"J'aime pas.\" ou \"Je n'aime pas.\""}, {"s": 126.53, "e": 129.73, "t": "Les deux peuvent s'entendre, mais"}, {"s": 129.73, "e": 134.01, "t": "\"J'aime pas.\" est plus informel."}, {"s": 134.01, "e": 137.25, "t": "Et pour demander à quelqu'un si il aime"}, {"s": 137.25, "e": 140.53, "t": "quelque chose, on dit tout simplement"}, {"s": 140.53, "e": 142.33, "t": "\"Tu ?\""}, {"s": 142.33, "e": 144.49, "t": "ou \"Vous ?\""}, {"s": 144.49, "e": 148.37, "t": "Tu aimes le ?"}, {"s": 148.65, "e": 152.73, "t": "Tu aimes les ?"}, {"s": 152.73, "e": 156.53, "t": "Vous aimez les ?"}, {"s": 156.53, "e": 159.33, "t": "Vous aimez ?"}, {"s": 159.33, "e": 161.85, "t": "Hélène, qu'est-ce que tu aimes faire le"}, {"s": 161.85, "e": 162.97, "t": "?"}, {"s": 162.97, "e": 165.49, "t": "J'adore faire du vélo."}, {"s": 165.49, "e": 167.69, "t": "Tu adores faire du ?"}, {"s": 167.69, "e": 170.25, "t": "Oui. J'adore ça."}, {"s": 170.25, "e": 173.09, "t": "Et j'adore aussi me promener."}, {"s": 173.09, "e": 173.93, "t": "Et ?"}, {"s": 173.93, "e": 176.89, "t": "Moi, j'adore dormir."}, {"s": 176.89, "e": 178.01, "t": "?"}, {"s": 178.01, "e": 182.41, "t": "Oui. J'adore dormir le dimanche matin."}, {"s": 182.41, "e": 185.69, "t": "Et tu aimes faire du ?"}, {"s": 185.69, "e": 189.85, "t": "Oui, j'aime bien faire du sport. Mais"}, {"s": 189.85, "e": 193.09, "t": "par contre, je déteste courir."}, {"s": 193.09, "e": 194.97, "t": "Tu détestes ?"}, {"s": 194.97, "e": 198.13, "t": "Oui. Je déteste ça."}, {"s": 198.13, "e": 199.29, "t": "!"}, {"s": 199.29, "e": 201.53, "t": "Moi, j'aime bien courir."}, {"s": 201.53, "e": 205.45, "t": "Mais je déteste me lever très tôt."}, {"s": 205.45, "e": 209.53, "t": "Ah ça, moi aussi. Je déteste me lever à"}, {"s": 209.53, "e": 210.69, "t": "6h."}, {"s": 210.69, "e": 213.97, "t": "En français, on peut exprimer nos goûts"}, {"s": 213.97, "e": 218.05, "t": "avec plusieurs expressions. Par exemple,"}, {"s": 218.05, "e": 220.57, "t": "quand on aime particulièrement quelque"}, {"s": 220.57, "e": 224.85, "t": "chose, on peut dire \"J'adore.\" ou"}, {"s": 224.85, "e": 226.81, "t": "\"J'aime beaucoup.\""}, {"s": 226.81, "e": 228.57, "t": "J'adore"}, {"s": 228.57, "e": 231.81, "t": "faire du vélo."}, {"s": 231.81, "e": 236.61, "t": "J'adore me promener."}, {"s": 236.61, "e": 238.13, "t": "J'adore"}, {"s": 238.13, "e": 239.65, "t": "dormir."}, {"s": 239.65, "e": 243.29, "t": "Pour quelque chose qu'on aime, on dit"}, {"s": 243.29, "e": 246.69, "t": "j'aime ou j'aime bien."}, {"s": 246.69, "e": 249.61, "t": "J'aime la musique."}, {"s": 249.61, "e": 252.57, "t": "J'aime bien cuisiner."}, {"s": 252.57, "e": 257.97, "t": "J'aime bien ne rien faire le dimanche."}, {"s": 257.97, "e": 260.89, "t": "Et si on aime vraiment pas quelque"}, {"s": 260.89, "e": 266.01, "t": "chose, on peut dire je déteste ou je"}, {"s": 266.01, "e": 268.05, "t": "n'aime pas du tout."}, {"s": 268.05, "e": 270.69, "t": "Je déteste"}, {"s": 270.69, "e": 273.45, "t": "courir."}, {"s": 273.45, "e": 279.33, "t": "Je n'aime pas du tout me lever tôt."}, {"s": 279.33, "e": 283.25, "t": "Après aimer détester"}, {"s": 283.25, "e": 288.05, "t": "ou adorer on peut aussi utiliser un"}, {"s": 288.05, "e": 290.73, "t": "verbe à l'infinitif."}, {"s": 290.73, "e": 293.65, "t": "J'aime danser."}, {"s": 293.65, "e": 296.93, "t": "J'adore dormir."}, {"s": 296.93, "e": 300.81, "t": "Je déteste attendre."}, {"s": 300.81, "e": 304.01, "t": "Quand on ajoute un adverbe d'intensité"}, {"s": 304.01, "e": 308.01, "t": "comme beaucoup ou du tout, on le place"}, {"s": 308.01, "e": 310.93, "t": "juste après le verbe aimer. J'aime"}, {"s": 310.93, "e": 313.49, "t": "beaucoup apprendre les langues"}, {"s": 313.49, "e": 317.17, "t": "étrangères, mais je n'aime pas du tout"}, {"s": 317.17, "e": 320.13, "t": "apprendre des tableaux de conjugaison"}, {"s": 320.13, "e": 322.41, "t": "par cœur. Et toi, ?"}, {"s": 322.41, "e": 326.61, "t": "Moi, j'aime bien apprendre par cœur. Et"}, {"s": 326.61, "e": 329.09, "t": "toi, ? Comment est-ce que tu aimes"}, {"s": 329.09, "e": 331.25, "t": "apprendre une ?"}, {"s": 331.25, "e": 334.89, "t": "J'aime répéter les mots que je trouve"}, {"s": 334.89, "e": 338.09, "t": "jolis ou drôles. Et d'ailleurs, si vous"}, {"s": 338.09, "e": 340.85, "t": "êtes débutants en français, je vous"}, {"s": 340.85, "e": 344.05, "t": "conseille de faire ça aussi."}, {"s": 344.05, "e": 346.21, "t": "Parce que quand on entend ou qu'on lit"}, {"s": 346.21, "e": 349.41, "t": "un mot une seule fois on ne peut pas le"}, {"s": 349.41, "e": 351.77, "t": "mémoriser tout de suite."}, {"s": 351.77, "e": 354.05, "t": "C'est pour cela qu'avec chacune de nos"}, {"s": 354.05, "e": 356.85, "t": "vidéos, nous proposons aux membres de la"}, {"s": 356.85, "e": 360.61, "t": "communauté une fiche de vocabulaire avec"}, {"s": 360.61, "e": 363.61, "t": "les mots les plus importants pour vous"}, {"s": 363.61, "e": 366.1, "t": "aider à les mémoriser."}, {"s": 366.1, "e": 368.69, "t": "Dans ces fiches, vous trouverez aussi"}, {"s": 368.69, "e": 371.1, "t": "des exercices pour vous aider à"}, {"s": 371.1, "e": 373.69, "t": "pratiquer ce vocabulaire"}, {"s": 373.69, "e": 376.25, "t": "ainsi que les structures que vous aurez"}, {"s": 376.25, "e": 379.38, "t": "entendues durant la vidéo."}, {"s": 379.38, "e": 382.21, "t": "Et vous pouvez tester cela gratuitement"}, {"s": 382.21, "e": 385.18, "t": "pendant 7 jours. Inscrivez-vous sur le"}, {"s": 385.18, "e": 388.62, "t": "lien dans la description de la vidéo."}, {"s": 388.62, "e": 390.81, "t": "Et nous, nous allons parler de nos"}, {"s": 390.81, "e": 393.69, "t": "préférences."}, {"s": 395.18, "e": 396.42, "t": "Axel,"}, {"s": 396.42, "e": 398.69, "t": "tu veux manger au restaurant ce ?"}, {"s": 398.69, "e": 401.57, "t": "Oui, c'est une bonne idée."}, {"s": 401.57, "e": 406.25, "t": "Tu préfères manger italien ou ?"}, {"s": 406.25, "e": 411.25, "t": "Hum, j'adore la cuisine italienne, mais"}, {"s": 411.25, "e": 414.33, "t": "je préfère la cuisine japonaise."}, {"s": 414.33, "e": 417.25, "t": "Ah ? Parce que moi, je préfère la"}, {"s": 417.25, "e": 418.69, "t": "cuisine italienne."}, {"s": 418.69, "e": 420.65, "t": "Tu préfères les pizzas"}, {"s": 420.65, "e": 421.5, "t": "ou les ?"}, {"s": 421.5, "e": 425.1, "t": "Je t'avoue que je préfère les pizzas."}, {"s": 425.1, "e": 428.3, "t": "Moi, je préfère les pâtes."}, {"s": 428.3, "e": 429.89, "t": "Bon,"}, {"s": 429.89, "e": 432.57, "t": "alors, tu préfères manger au restaurant"}, {"s": 432.57, "e": 434.06, "t": "ou à la ?"}, {"s": 434.06, "e": 437.86, "t": "Je préfère manger au restaurant."}, {"s": 437.86, "e": 438.94, "t": "!"}, {"s": 438.94, "e": 441.57, "t": "Parce que moi, je préfère manger à la"}, {"s": 441.57, "e": 442.5, "t": "maison."}, {"s": 442.5, "e": 446.1, "t": "Mais Axel, on aime jamais les mêmes"}, {"s": 446.1, "e": 446.94, "t": "choses."}, {"s": 446.94, "e": 450.18, "t": "Mais si, Hélène, on aime tous les deux"}, {"s": 450.18, "e": 451.21, "t": "manger."}, {"s": 451.21, "e": 454.45, "t": "Quand on aime deux choses, mais qu'on"}, {"s": 454.45, "e": 457.89, "t": "aime une chose plus que l'autre, on"}, {"s": 457.89, "e": 461.25, "t": "utilise le verbe préférer."}, {"s": 461.25, "e": 465.81, "t": "J'aime le thé et le café,"}, {"s": 465.81, "e": 470.42, "t": "mais je préfère le café. J'aime les"}, {"s": 470.42, "e": 475.06, "t": "chiens et les chats, mais je préfère les"}, {"s": 475.06, "e": 476.13, "t": "chats."}, {"s": 476.13, "e": 479.42, "t": "Pour poser une question, on peut dire"}, {"s": 479.42, "e": 483.06, "t": "\"Tu préfères ça ou ?\""}, {"s": 483.06, "e": 485.57, "t": "Tu préfères le thé"}, {"s": 485.57, "e": 487.86, "t": "ou le ?"}, {"s": 487.86, "e": 490.7, "t": "Tu préfères la mer"}, {"s": 490.7, "e": 492.62, "t": "ou la ?"}, {"s": 492.62, "e": 495.54, "t": "Tu préfères l'été"}, {"s": 495.54, "e": 497.02, "t": "ou ?"}, {"s": 497.02, "e": 501.22, "t": "On peut aussi utiliser préférer avec un"}, {"s": 501.22, "e": 503.86, "t": "verbe à l'infinitif."}, {"s": 503.86, "e": 509.06, "t": "Je préfère rester à la maison."}, {"s": 509.06, "e": 514.3, "t": "Je préfère sortir avec mes amis."}, {"s": 514.3, "e": 518.82, "t": "Je préfère ne rien faire le dimanche."}, {"s": 518.82, "e": 522.7, "t": "Bon Axel, on va faire un petit jeu."}, {"s": 522.7, "e": 525.34, "t": "Je vais te poser des questions sur tes"}, {"s": 525.34, "e": 526.42, "t": "goûts."}, {"s": 526.42, "e": 530.3, "t": "Et tu vas me poser des questions aussi."}, {"s": 530.3, "e": 531.14, "t": "?"}, {"s": 531.14, "e": 532.82, "t": "Hum d'accord."}, {"s": 532.82, "e": 534.22, "t": "Tu aimes les ?"}, {"s": 534.22, "e": 537.14, "t": "Oui, j'adore les frites. Et ?"}, {"s": 537.14, "e": 539.58, "t": "Moi, je n'aime pas ça."}, {"s": 539.58, "e": 543.78, "t": "Et tu préfères le froid ou la ?"}, {"s": 543.78, "e": 546.9, "t": "Je préfère la chaleur."}, {"s": 546.9, "e": 549.3, "t": "Ah, moi aussi j'aime la chaleur."}, {"s": 549.3, "e": 551.74, "t": "Enfin, on est d'accord."}, {"s": 551.74, "e": 553.14, "t": "Et"}, {"s": 553.14, "e": 555.82, "t": "est-ce que tu aimes les films ?"}, {"s": 555.82, "e": 557.3, "t": "Non."}, {"s": 557.3, "e": 560.22, "t": "Je déteste ça. Et ?"}, {"s": 560.22, "e": 563.02, "t": "Moi si, j'aime les films d'horreur."}, {"s": 563.02, "e": 565.1, "t": "Quelle faute de !"}, {"s": 565.1, "e": 566.98, "t": "Et tu aimes ?"}, {"s": 566.98, "e": 570.46, "t": "Oui, j'aime beaucoup chanter."}, {"s": 570.46, "e": 572.9, "t": "Ah, moi aussi j'adore chanter."}, {"s": 572.9, "e": 575.54, "t": "Alors, on chante ?"}, {"s": 575.54, "e": 579.1, "t": "Euh non, parce qu'en fait, je préfère"}, {"s": 579.1, "e": 580.66, "t": "écouter de la musique."}, {"s": 580.66, "e": 583.02, "t": "Bon, d'accord."}, {"s": 583.02, "e": 585.34, "t": "J'aime le chocolat."}, {"s": 585.34, "e": 587.06, "t": "Moi aussi."}, {"s": 587.06, "e": 590.38, "t": "J'adore les films d'horreur."}, {"s": 590.38, "e": 591.66, "t": "Moi non,"}, {"s": 591.66, "e": 595.14, "t": "pas moi. Moi, je n'aime pas ça."}, {"s": 595.14, "e": 598.06, "t": "Je n'aime pas me lever tôt."}, {"s": 598.06, "e": 600.14, "t": "Moi non plus."}, {"s": 600.14, "e": 602.5, "t": "Je n'aime pas les olives."}, {"s": 602.5, "e": 604.54, "t": "Moi si,"}, {"s": 604.54, "e": 607.02, "t": "j'adore ça."}, {"s": 607.02, "e": 609.94, "t": "Voilà, maintenant tu sais parler de tes"}, {"s": 609.94, "e": 611.54, "t": "goûts en français."}, {"s": 611.54, "e": 614.22, "t": "Tu peux dire ce que tu aimes, ce que tu"}, {"s": 614.22, "e": 617.82, "t": "n'aimes pas, ce que tu adores, ce que tu"}, {"s": 617.82, "e": 622.22, "t": "détestes et surtout ce que tu préfères."}, {"s": 622.22, "e": 625.22, "t": "Si tu as aimé cette vidéo"}, {"s": 625.22, "e": 626.98, "t": "ou si tu l'as adorée"}, {"s": 626.98, "e": 628.94, "t": "mets un petit like."}, {"s": 628.94, "e": 630.62, "t": "Et nous, on se dit à la semaine"}, {"s": 630.62, "e": 633.54, "t": "prochaine."}, {"s": 635.14, "e": 637.14, "t": "J'adore, pardon, je regardais la caméra."}, {"s": 637.14, "e": 639.74, "t": "Quel débile. Salut les amis, bienvenue"}, {"s": 639.74, "e": 643.22, "t": "dans une nouvelle vidéo Easy French."}, {"s": 643.22, "e": 644.5, "t": "C'est ?"}, {"s": 644.5, "e": 645.7, "t": "Non, tu dis pas un autre ?"}, {"s": 645.7, "e": 648.46, "t": "Ah oui, pardon, je dis juste \"Hi\"."}]