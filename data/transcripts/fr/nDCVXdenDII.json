[{"s": 0.0, "e": 2.96, "t": "Bonjour les amis et bienvenue dans un"}, {"s": 2.96, "e": 6.28, "t": "nouvel épisode de Super Easy French."}, {"s": 6.28, "e": 8.48, "t": "Aujourd'hui, nous avons un invité très"}, {"s": 8.48, "e": 11.08, "t": "spécial, Manuel de la chaîne Easy"}, {"s": 11.08, "e": 12.0, "t": "German."}, {"s": 12.0, "e": 14.4, "t": "Bonjour les amis."}, {"s": 14.4, "e": 16.6, "t": "Aujourd'hui, nous allons vous présenter"}, {"s": 16.6, "e": 19.12, "t": "10 choses qu'il ne faut surtout pas"}, {"s": 19.12, "e": 20.96, "t": "faire en France."}, {"s": 20.96, "e": 24.36, "t": "C'est parti, on y va."}, {"s": 24.76, "e": 27.51, "t": "Nous avons donné rendez-vous à Manuel"}, {"s": 28.36, "e": 31.96, "t": "dans un parc pour déjeuner. Nous allons"}, {"s": 31.96, "e": 34.06, "t": "pique-niquer. Je lui ai demandé"}, {"s": 36.52, "e": 39.6, "t": "de nous rejoindre."}, {"s": 43.32, "e": 44.8, "t": "Une baguette, s'il vous plaît."}, {"s": 44.8, "e": 47.81, "t": "Euh bonjour."}, {"s": 48.72, "e": 52.24, "t": "En France, on ne commence jamais une"}, {"s": 52.24, "e": 55.4, "t": "conversation sans dire bonjour."}, {"s": 55.4, "e": 57.56, "t": "On dit [grognement] bonjour tout le"}, {"s": 57.56, "e": 58.48, "t": "temps."}, {"s": 58.48, "e": 61.64, "t": "En entrant dans un commerce, en arrivant"}, {"s": 61.64, "e": 64.32, "t": "au bureau, même quand on croise son"}, {"s": 64.32, "e": 66.32, "t": "voisin dans l'ascenseur."}, {"s": 66.32, "e": 67.64, "t": "Bonjour."}, {"s": 67.64, "e": 69.2, "t": "Bonjour."}, {"s": 69.2, "e": 71.52, "t": "Qu'est-ce que je vous ?"}, {"s": 71.52, "e": 73.32, "t": "Je voudrais une baguette, s'il vous"}, {"s": 73.32, "e": 75.33, "t": "plaît."}, {"s": 79.68, "e": 81.36, "t": "Et voilà."}, {"s": 81.36, "e": 84.96, "t": "Ça vous fera 1 euro 20."}, {"s": 84.96, "e": 87.08, "t": "Je vais payer par carte."}, {"s": 87.08, "e": 88.68, "t": "Euh"}, {"s": 88.68, "e": 90.88, "t": "vous n'avez pas la ?"}, {"s": 90.88, "e": 93.68, "t": "En France, certains commerces"}, {"s": 93.68, "e": 96.56, "t": "n'acceptent la carte bleue qu'à partir"}, {"s": 96.56, "e": 99.32, "t": "d'une certaine somme. C'est de plus en"}, {"s": 99.32, "e": 101.28, "t": "plus rare, mais cela peut encore vous"}, {"s": 101.28, "e": 102.68, "t": "arriver."}, {"s": 102.68, "e": 105.28, "t": "Voilà votre baguette."}, {"s": 105.28, "e": 110.68, "t": "Ça vous fera 1 euro 20, s'il vous plaît."}, {"s": 110.68, "e": 112.08, "t": "Tenez."}, {"s": 112.08, "e": 115.92, "t": "Merci. Voilà votre monnaie."}, {"s": 115.92, "e": 118.12, "t": "Merci, au revoir, bonne journée."}, {"s": 118.12, "e": 120.52, "t": "Au revoir."}, {"s": 120.52, "e": 123.16, "t": "Il est midi 25 et nous avons rendez-vous"}, {"s": 123.16, "e": 125.36, "t": "avec Manuel dans 5 minutes pour"}, {"s": 125.36, "e": 127.8, "t": "pique-niquer. Mais il ne devrait pas"}, {"s": 127.8, "e": 130.32, "t": "arriver tout de suite. Alors, cela nous"}, {"s": 130.32, "e": 132.68, "t": "laisse un peu de temps pour vous donner"}, {"s": 132.68, "e": 134.93, "t": "quelques conseils pour progresser en"}, {"s": 136.0, "e": 137.76, "t": "Ce n'est peut-être pas évident, mais"}, {"s": 137.76, "e": 140.17, "t": "pour progresser en français à l'oral,"}, {"s": 142.84, "e": 144.32, "t": "Cette pratique du français dont tu"}, {"s": 144.32, "e": 146.4, "t": "parles, vous pouvez la faire avec nous"}, {"s": 146.4, "e": 148.64, "t": "et les professeurs de notre équipe. Nous"}, {"s": 148.64, "e": 151.08, "t": "proposons un cours de français chaque"}, {"s": 151.08, "e": 153.16, "t": "jour de la semaine. Ces cours sont"}, {"s": 153.16, "e": 155.4, "t": "l'occasion de prendre la parole et de"}, {"s": 155.4, "e": 158.16, "t": "recevoir du feedback professionnel."}, {"s": 158.16, "e": 160.68, "t": "Après plusieurs cours par semaine"}, {"s": 160.68, "e": 163.2, "t": "pendant plusieurs mois, vous commencerez"}, {"s": 163.2, "e": 165.84, "t": "à noter de réels progrès. Votre"}, {"s": 165.84, "e": 168.44, "t": "vocabulaire sera enrichi, votre"}, {"s": 168.44, "e": 171.44, "t": "compréhension sera améliorée et votre"}, {"s": 171.44, "e": 174.2, "t": "expression sera plus fluide."}, {"s": 174.2, "e": 176.44, "t": "Vous aurez aussi de moins en moins"}, {"s": 176.44, "e": 179.72, "t": "besoin de traduire. En bref, vous serez"}, {"s": 179.72, "e": 182.32, "t": "de plus en plus à l'aise avec votre"}, {"s": 182.32, "e": 183.48, "t": "français."}, {"s": 183.48, "e": 185.8, "t": "Et si vous hésitez encore, sachez que"}, {"s": 185.8, "e": 188.8, "t": "vous pouvez tester nos cours pendant 7"}, {"s": 188.8, "e": 191.76, "t": "jours gratuitement avant de vous lancer."}, {"s": 191.76, "e": 194.36, "t": "Pour cela, il suffit de devenir membre"}, {"s": 194.36, "e": 196.36, "t": "d'Easy French via le lien dans la"}, {"s": 196.36, "e": 199.24, "t": "description. Bon, Manuel ne devrait pas"}, {"s": 199.24, "e": 203.08, "t": "tarder. On installe le ?"}, {"s": 210.72, "e": 214.2, "t": "Il est midi et demi pile. Je suis là."}, {"s": 214.2, "e": 215.52, "t": "?"}, {"s": 215.52, "e": 216.56, "t": "Mais"}, {"s": 216.56, "e": 218.68, "t": "on a rien installé."}, {"s": 218.68, "e": 221.76, "t": "En France, surtout dans un contexte"}, {"s": 221.76, "e": 223.28, "t": "informel,"}, {"s": 223.28, "e": 226.44, "t": "il vaut mieux arriver 10 ou 15 minutes"}, {"s": 226.44, "e": 229.24, "t": "en retard à un rendez-vous pour laisser"}, {"s": 229.24, "e": 233.48, "t": "aux autres le temps de se préparer."}, {"s": 235.12, "e": 237.64, "t": "Je suis désolé pour le retard."}, {"s": 237.64, "e": 238.68, "t": "Mais"}, {"s": 238.68, "e": 240.08, "t": "Manuel,"}, {"s": 240.08, "e": 244.32, "t": "tu es parfaitement à l'heure."}, {"s": 249.16, "e": 253.8, "t": "! Manuel, pas la !"}, {"s": 253.8, "e": 255.84, "t": "Qu'est-ce que je ?"}, {"s": 255.84, "e": 258.76, "t": "En France, couper le fromage, c'est tout"}, {"s": 258.76, "e": 262.6, "t": "un art. Chaque fromage a sa découpe."}, {"s": 262.6, "e": 264.92, "t": "Pour les fromages en pointe, comme le"}, {"s": 264.92, "e": 265.92, "t": "brie,"}, {"s": 265.92, "e": 268.16, "t": "on coupe dans la longueur"}, {"s": 268.16, "e": 270.96, "t": "pour que tout le monde ait du cœur et de"}, {"s": 270.96, "e": 272.16, "t": "la croûte."}, {"s": 272.16, "e": 274.96, "t": "Couper juste la pointe d'un fromage,"}, {"s": 274.96, "e": 277.76, "t": "c'est garder le meilleur pour soi."}, {"s": 277.76, "e": 281.64, "t": "Et cela ne se fait pas du tout."}, {"s": 285.92, "e": 286.88, "t": "Comme ?"}, {"s": 286.88, "e": 292.13, "t": "! Tu es presque français maintenant."}, {"s": 299.44, "e": 302.4, "t": "Bonjour, une table pour trois personnes,"}, {"s": 302.4, "e": 303.2, "t": "s'il vous plaît."}, {"s": 303.2, "e": 305.72, "t": "Ça ne va pas être possible, la cuisine"}, {"s": 305.72, "e": 309.16, "t": "ouvre à 19h. Vous êtes un peu en avance."}, {"s": 309.16, "e": 311.04, "t": "En France, on dîne plus tard qu'en"}, {"s": 311.04, "e": 313.48, "t": "Allemagne ou dans d'autres pays."}, {"s": 313.48, "e": 316.04, "t": "À 18h, la plupart des restaurants ne"}, {"s": 316.04, "e": 319.36, "t": "servent pas encore à dîner, voire ne"}, {"s": 319.36, "e": 321.84, "t": "sont pas encore ouverts."}, {"s": 321.84, "e": 323.68, "t": "Le plus courant est d'aller dîner à"}, {"s": 323.68, "e": 327.0, "t": "partir de 19h30."}, {"s": 327.0, "e": 329.96, "t": "Bonjour, une table pour trois personnes,"}, {"s": 329.96, "e": 330.64, "t": "s'il vous plaît."}, {"s": 330.64, "e": 334.28, "t": "Oui, bien sûr, suivez-moi."}, {"s": 340.4, "e": 341.16, "t": "Bonjour, Manuel."}, {"s": 341.16, "e": 343.32, "t": "Bonjour, !"}, {"s": 343.32, "e": 344.6, "t": "Je te présente Axel."}, {"s": 344.6, "e": 348.0, "t": "Bonjour, !"}, {"s": 349.0, "e": 353.96, "t": "En France, on ne fait jamais de hug"}, {"s": 353.96, "e": 356.08, "t": "quand on retrouve quelqu'un, on lui fait"}, {"s": 356.08, "e": 359.36, "t": "la bise si c'est une personne proche et"}, {"s": 359.36, "e": 361.48, "t": "si on se rencontre pour la première"}, {"s": 361.48, "e": 364.72, "t": "fois, on peut serrer la main."}, {"s": 364.72, "e": 365.48, "t": "Bonjour Manuel."}, {"s": 365.48, "e": 367.52, "t": "Bonjour Judith."}, {"s": 367.52, "e": 369.32, "t": "Je te présente Axel."}, {"s": 369.32, "e": 370.08, "t": "Bonjour Axel."}, {"s": 370.08, "e": 372.92, "t": "Bonjour Manuel."}, {"s": 376.64, "e": 379.4, "t": "Qu'est-ce que je vous ?"}, {"s": 379.4, "e": 381.88, "t": "?"}, {"s": 383.76, "e": 386.72, "t": "Je parle pas anglais."}, {"s": 386.72, "e": 388.76, "t": "Aujourd'hui, beaucoup de Françaises et"}, {"s": 388.76, "e": 391.88, "t": "de Français parlent anglais mais pas"}, {"s": 391.88, "e": 393.08, "t": "tous."}, {"s": 393.08, "e": 396.32, "t": "Donc, c'est plus poli de commencer par"}, {"s": 396.32, "e": 398.72, "t": "le français même si c'est avec une"}, {"s": 398.72, "e": 401.24, "t": "petite phrase très basique."}, {"s": 401.24, "e": 404.44, "t": "Les Français apprécient généralement cet"}, {"s": 404.44, "e": 405.72, "t": "effort."}, {"s": 405.72, "e": 406.68, "t": "Qu'est-ce que je vous ?"}, {"s": 406.68, "e": 408.48, "t": "Parlez-vous ?"}, {"s": 408.48, "e": 411.52, "t": "Oui, un peu."}, {"s": 411.8, "e": 413.6, "t": "S'il vous plaît."}, {"s": 413.6, "e": 414.64, "t": "OK."}, {"s": 414.64, "e": 417.12, "t": "Merci."}, {"s": 429.32, "e": 430.8, "t": "Merci."}, {"s": 430.8, "e": 433.44, "t": "Bon appétit."}, {"s": 439.2, "e": 442.16, "t": "En France, avant de commencer à manger,"}, {"s": 442.16, "e": 446.08, "t": "on attend que tout le monde soit servi."}, {"s": 446.08, "e": 449.48, "t": "Ensuite, on se dit \"Bon appétit.\" et"}, {"s": 449.48, "e": 452.64, "t": "après ça seulement, on peut commencer à"}, {"s": 452.64, "e": 455.2, "t": "manger."}, {"s": 456.16, "e": 457.2, "t": "Merci beaucoup."}, {"s": 457.2, "e": 458.68, "t": "Merci."}, {"s": 458.68, "e": 459.48, "t": "Bon appétit."}, {"s": 459.48, "e": 462.32, "t": "Bon appétit Manuel."}, {"s": 470.12, "e": 472.08, "t": "Comment est ton ?"}, {"s": 472.08, "e": 474.0, "t": "Il est chaud, je vais demander des"}, {"s": 474.0, "e": 474.8, "t": "glaçons."}, {"s": 474.8, "e": 477.64, "t": "Non, surtout pas."}, {"s": 477.64, "e": 479.92, "t": "En France, beaucoup de gens considèrent"}, {"s": 479.92, "e": 483.24, "t": "que le vin doit être bu tel quel."}, {"s": 483.24, "e": 485.84, "t": "Mettre des glaçons dans un verre de vin"}, {"s": 485.84, "e": 487.76, "t": "quand on est invité chez quelqu'un ou"}, {"s": 487.76, "e": 490.12, "t": "quand on est au restaurant est très mal"}, {"s": 490.12, "e": 490.96, "t": "vu."}, {"s": 490.96, "e": 492.84, "t": "Il vaut mieux éviter."}, {"s": 492.84, "e": 495.52, "t": "Il est un peu chaud."}, {"s": 495.52, "e": 497.92, "t": "Ah il est très bon."}, {"s": 497.92, "e": 500.16, "t": "Merci les amis d'avoir regardé cet"}, {"s": 500.16, "e": 502.92, "t": "épisode et surtout merci à Manuel"}, {"s": 502.92, "e": 504.52, "t": "d'avoir participé."}, {"s": 504.52, "e": 506.08, "t": "Avec plaisir."}, {"s": 506.08, "e": 508.88, "t": "Si cet épisode vous a plu, mettez un"}, {"s": 508.88, "e": 509.72, "t": "like."}, {"s": 509.72, "e": 511.76, "t": "Et abonnez-vous."}, {"s": 511.76, "e": 513.48, "t": "Et nous, on se dit à la semaine"}, {"s": 513.48, "e": 514.72, "t": "prochaine."}, {"s": 514.72, "e": 517.84, "t": "Au revoir."}, {"s": 530.12, "e": 533.84, "t": "Merci. Bon appétit."}, {"s": 541.36, "e": 542.2, "t": "Bonjour Manuel."}, {"s": 542.2, "e": 544.72, "t": "Bonjour."}, {"s": 545.72, "e": 548.0, "t": "Merci les amis d'avoir regardé cet"}, {"s": 548.0, "e": 550.26, "t": "épisode. [musique]"}]