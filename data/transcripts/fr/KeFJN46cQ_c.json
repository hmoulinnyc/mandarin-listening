[{"s": 0.0, "e": 2.72, "t": "Bonjour les amis et bienvenue dans un"}, {"s": 2.72, "e": 6.72, "t": "nouvel épisode de Super Easy French."}, {"s": 6.72, "e": 8.96, "t": "Judith, ça ?"}, {"s": 8.96, "e": 10.52, "t": "Oui oui."}, {"s": 10.52, "e": 12.88, "t": "Tu marches très bizarrement."}, {"s": 12.88, "e": 15.0, "t": "J'ai mal au pied."}, {"s": 15.0, "e": 17.28, "t": "Mais qu'est-ce qui s'est ?"}, {"s": 17.28, "e": 20.04, "t": "Je me suis fait mal ce matin."}, {"s": 20.04, "e": 22.88, "t": "Eh bien écoute, ça tombe super bien"}, {"s": 22.88, "e": 25.28, "t": "puisque aujourd'hui nous allons parler"}, {"s": 25.28, "e": 26.68, "t": "des douleurs."}, {"s": 26.68, "e": 27.92, "t": "! [musique]"}, {"s": 27.92, "e": 30.56, "t": "C'est ?"}, {"s": 41.52, "e": 44.6, "t": "J'ai vraiment très mal à la tête"}, {"s": 44.6, "e": 45.44, "t": "aujourd'hui."}, {"s": 45.44, "e": 47.96, "t": "Mais qu'est-ce que tu as fait ?"}, {"s": 47.96, "e": 49.4, "t": "?"}, {"s": 49.4, "e": 52.4, "t": "Absolument rien. J'ai juste bu une"}, {"s": 52.4, "e": 55.28, "t": "grenadine avec des amis."}, {"s": 55.28, "e": 57.44, "t": "Juste une ?"}, {"s": 57.44, "e": 58.64, "t": "Bon."}, {"s": 58.64, "e": 61.88, "t": "Et peut-être quelques gin tonics."}, {"s": 61.88, "e": 64.92, "t": "Pour parler d'une douleur, l'expression"}, {"s": 64.92, "e": 69.48, "t": "la plus courante est avoir mal à."}, {"s": 69.48, "e": 72.28, "t": "Par exemple, aujourd'hui"}, {"s": 72.28, "e": 74.56, "t": "j'ai mal au pied."}, {"s": 74.56, "e": 77.6, "t": "Mais on peut avoir mal à beaucoup"}, {"s": 77.6, "e": 82.16, "t": "d'autres endroits. J'ai mal à la tête."}, {"s": 82.16, "e": 86.2, "t": "Axel a mal à la tête."}, {"s": 86.2, "e": 88.6, "t": "J'ai mal au pied."}, {"s": 88.6, "e": 92.2, "t": "Judith a mal au pied."}, {"s": 92.2, "e": 95.72, "t": "J'ai trop bu hier."}, {"s": 95.72, "e": 99.28, "t": "J'ai mal à la tête."}, {"s": 99.28, "e": 103.08, "t": "Il a fait du tennis ce matin."}, {"s": 103.08, "e": 105.72, "t": "Il a mal à l'épaule."}, {"s": 105.72, "e": 107.92, "t": "Tu as déménagé"}, {"s": 107.92, "e": 109.28, "t": "donc"}, {"s": 109.28, "e": 112.68, "t": "tu as mal au dos."}, {"s": 112.68, "e": 115.92, "t": "Elle a bu trop de café"}, {"s": 115.92, "e": 119.88, "t": "donc elle a mal au ventre."}, {"s": 119.88, "e": 122.84, "t": "Ils ont fait une randonnée,"}, {"s": 122.84, "e": 126.08, "t": "donc, ils ont mal aux jambes."}, {"s": 126.08, "e": 127.48, "t": "Attention,"}, {"s": 127.48, "e": 130.64, "t": "il y a une erreur que l'on fait souvent"}, {"s": 130.64, "e": 133.62, "t": "quand on apprend le français."}, {"s": 133.8, "e": 138.52, "t": "Ah, j'ai mal à le pied."}, {"s": 138.52, "e": 144.44, "t": "Quand il y a un A avec accent plus le,"}, {"s": 144.44, "e": 149.0, "t": "on remplace par O A U."}, {"s": 149.0, "e": 151.68, "t": "On appelle ça une contraction"}, {"s": 151.68, "e": 154.64, "t": "parce que ça sonne plus joli à"}, {"s": 154.64, "e": 155.96, "t": "l'oreille."}, {"s": 155.96, "e": 160.56, "t": "Ah, j'ai mal au pied."}, {"s": 160.56, "e": 165.16, "t": "Ah, j'ai mal à les jambes."}, {"s": 165.16, "e": 170.12, "t": "Quand il y a A accent plus les, on dit"}, {"s": 170.12, "e": 173.64, "t": "aux A U X."}, {"s": 173.64, "e": 177.64, "t": "Ah, j'ai mal aux jambes."}, {"s": 177.64, "e": 180.92, "t": "Mais quand le nom est féminin,"}, {"s": 180.92, "e": 184.24, "t": "on dit A plus la."}, {"s": 184.24, "e": 187.84, "t": "J'ai mal à la jambe."}, {"s": 187.84, "e": 192.2, "t": "J'ai mal à la tête."}, {"s": 192.2, "e": 194.88, "t": "Maintenant, vous savez dire où vous avez"}, {"s": 194.88, "e": 198.2, "t": "mal en français. Mais pour retenir tout"}, {"s": 198.2, "e": 200.48, "t": "ce vocabulaire, le mieux, c'est de"}, {"s": 200.48, "e": 202.64, "t": "continuer à pratiquer."}, {"s": 202.64, "e": 203.72, "t": "Et justement, [musique]"}, {"s": 203.72, "e": 206.48, "t": "avec Easy French, vous pouvez continuer"}, {"s": 206.48, "e": 208.6, "t": "à apprendre avec nous en dehors de"}, {"s": 208.6, "e": 209.44, "t": "YouTube."}, {"s": 209.44, "e": 211.64, "t": "Sur notre plateforme, vous aurez accès à"}, {"s": 211.64, "e": 214.12, "t": "nos vidéos avec des exercices pour"}, {"s": 214.12, "e": 216.44, "t": "tester votre compréhension, mais"}, {"s": 216.44, "e": 218.92, "t": "également à nos épisodes de podcast"}, {"s": 218.92, "e": 220.96, "t": "accompagnés d'une transcription"}, {"s": 220.96, "e": 223.6, "t": "interactive pour découvrir de nouveaux"}, {"s": 223.6, "e": 224.96, "t": "mots en contexte."}, {"s": 224.96, "e": 227.68, "t": "Et surtout, si vous avez envie de"}, {"s": 227.68, "e": 229.4, "t": "parler, vous pouvez nous [musique]"}, {"s": 229.4, "e": 232.36, "t": "retrouver tous les jours sur Zoom pour"}, {"s": 232.36, "e": 234.49, "t": "pratiquer en petit groupe avec nous"}, {"s": 236.36, "e": 237.76, "t": "communauté."}, {"s": 237.76, "e": 240.68, "t": "Bref, plein de façons de progresser en"}, {"s": 240.68, "e": 243.84, "t": "français et normalement sans douleur."}, {"s": 243.84, "e": 245.52, "t": "Pour nous rejoindre, vous trouverez"}, {"s": 245.52, "e": 247.28, "t": "toutes les infos dans le lien qui est"}, {"s": 247.28, "e": 251.2, "t": "dans la description de cette vidéo."}, {"s": 252.84, "e": 255.0, "t": "Ça ? Tu t'es fait ?"}, {"s": 255.0, "e": 257.32, "t": "Non, ça va."}, {"s": 257.32, "e": 261.8, "t": "Voilà une autre expression importante."}, {"s": 261.8, "e": 264.08, "t": "Se faire mal."}, {"s": 264.08, "e": 267.08, "t": "Se faire mal, c'est quand quelque chose"}, {"s": 267.08, "e": 269.36, "t": "provoque une douleur."}, {"s": 269.36, "e": 273.12, "t": "Je me suis fait mal à la tête."}, {"s": 273.12, "e": 278.04, "t": "Avoir mal, c'est ressentir une douleur."}, {"s": 278.04, "e": 281.36, "t": "J'ai mal à la tête."}, {"s": 281.36, "e": 285.0, "t": "Par exemple, Judith s'est fait mal au"}, {"s": 285.0, "e": 287.56, "t": "pied ce matin."}, {"s": 287.56, "e": 291.76, "t": "Quelque chose lui est arrivé. Judith a"}, {"s": 291.76, "e": 293.6, "t": "mal au pied,"}, {"s": 293.6, "e": 296.56, "t": "elle ressent une douleur."}, {"s": 296.56, "e": 299.36, "t": "Comment est-ce qu'on peut se faire ?"}, {"s": 299.36, "e": 302.28, "t": "Et bien, on peut par exemple tomber dans"}, {"s": 302.28, "e": 304.76, "t": "la rue"}, {"s": 304.76, "e": 308.44, "t": "ou dans les escaliers."}, {"s": 308.44, "e": 311.32, "t": "Mais tu ne crois pas qu'on peut aussi se"}, {"s": 311.32, "e": 313.88, "t": "?"}, {"s": 314.76, "e": 319.24, "t": "On peut aussi se couper."}, {"s": 321.76, "e": 323.88, "t": "Je me suis coupée."}, {"s": 323.88, "e": 326.24, "t": "Ou se brûler."}, {"s": 326.24, "e": 327.8, "t": "Ouais et puis euh"}, {"s": 327.8, "e": 328.56, "t": "C'est bon madame."}, {"s": 328.56, "e": 329.36, "t": "Puis moi j'ai regardé s'il y a une"}, {"s": 329.36, "e": 329.72, "t": "aubergine."}, {"s": 329.72, "e": 332.16, "t": "Merci. Ah, c'est !"}, {"s": 332.16, "e": 333.6, "t": "Tu t'es ?"}, {"s": 333.6, "e": 335.48, "t": "Non, ça va."}, {"s": 335.48, "e": 337.88, "t": "Tomber."}, {"s": 337.88, "e": 341.08, "t": "Se cogner."}, {"s": 341.08, "e": 344.4, "t": "Se couper."}, {"s": 344.4, "e": 347.04, "t": "Se brûler."}, {"s": 347.04, "e": 350.52, "t": "Je suis tombée."}, {"s": 350.52, "e": 354.28, "t": "Je me suis coupé."}, {"s": 354.28, "e": 356.08, "t": "Je me suis"}, {"s": 356.08, "e": 357.96, "t": "cogné."}, {"s": 357.96, "e": 362.2, "t": "Je me suis brûlé."}, {"s": 362.52, "e": 363.64, "t": "!"}, {"s": 363.64, "e": 365.6, "t": "Ça ? Tu as ?"}, {"s": 365.6, "e": 366.52, "t": "Oui."}, {"s": 366.52, "e": 367.4, "t": "Tu as mal ?"}, {"s": 367.4, "e": 369.36, "t": "Bah, à la main."}, {"s": 369.36, "e": 372.0, "t": "On peut dire \"Ça ?\""}, {"s": 372.0, "e": 373.92, "t": "\"Ça fait ?\""}, {"s": 373.92, "e": 375.56, "t": "\"Tu as ?\""}, {"s": 375.56, "e": 377.32, "t": "\"Tu as mal ?\""}, {"s": 377.32, "e": 378.64, "t": "\"Ça fait mal ?\""}, {"s": 378.64, "e": 379.32, "t": "Non."}, {"s": 379.32, "e": 379.84, "t": "\"Et ?\""}, {"s": 379.84, "e": 380.76, "t": "!"}, {"s": 380.76, "e": 382.4, "t": "Mais je n'ai presque rien fait."}, {"s": 382.4, "e": 386.04, "t": "Oui, mais ça fait très mal. Pour parler"}, {"s": 386.04, "e": 389.24, "t": "de l'intensité, on peut dire"}, {"s": 389.24, "e": 392.08, "t": "\"Ça ne fait pas mal.\""}, {"s": 392.08, "e": 395.72, "t": "\"Ça fait un peu mal.\""}, {"s": 395.72, "e": 399.6, "t": "\"Ça fait assez mal.\""}, {"s": 399.6, "e": 403.08, "t": "\"Ça fait très mal.\""}, {"s": 403.08, "e": 405.6, "t": "Ça ?"}, {"s": 405.6, "e": 409.28, "t": "Tu t'es fait ?"}, {"s": 409.28, "e": 412.44, "t": "Ça fait ?"}, {"s": 413.08, "e": 415.52, "t": "Tu as ?"}, {"s": 415.52, "e": 418.36, "t": "Tu as mal ?"}, {"s": 418.36, "e": 421.12, "t": "Quand on se fait mal, on dit souvent !\""}, {"s": 421.12, "e": 424.88, "t": "ou !\" Et les plus vulgaires disent même"}, {"s": 424.88, "e": 426.56, "t": "!\""}, {"s": 426.56, "e": 427.64, "t": "!"}, {"s": 427.64, "e": 429.64, "t": "Tu m'as fait mal."}, {"s": 429.64, "e": 432.24, "t": "!"}, {"s": 432.24, "e": 434.56, "t": "!"}, {"s": 434.56, "e": 437.36, "t": "Aïe aïe !"}, {"s": 437.36, "e": 439.88, "t": "Ouille ouille !"}, {"s": 439.88, "e": 442.2, "t": "Merci les amis d'avoir regardé cette"}, {"s": 442.2, "e": 445.68, "t": "vidéo. Désormais, vous saurez parler de"}, {"s": 445.68, "e": 447.72, "t": "la douleur en français."}, {"s": 447.72, "e": 449.33, "t": "Dites-nous en commentaire"}, {"s": 449.4, "e": 452.04, "t": "quelles expressions vous avez apprises"}, {"s": 452.04, "e": 453.44, "t": "aujourd'hui."}, {"s": 453.44, "e": 454.76, "t": "Et ?"}, {"s": 454.76, "e": 456.88, "t": "Et maintenant, je vais aller m'asseoir."}, {"s": 456.88, "e": 458.72, "t": "Mais ? Tu as mal au ?"}, {"s": 458.72, "e": 461.48, "t": "Non, je suis juste fatiguée."}, {"s": 461.48, "e": 463.84, "t": "OK. Et nous, on se dit à la semaine"}, {"s": 463.84, "e": 466.44, "t": "prochaine."}]