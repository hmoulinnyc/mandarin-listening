[{"s": 0.2, "e": 4.92, "t": "Hola, ¿estás empezando con el español?"}, {"s": 4.92, "e": 7.28, "t": "Pues este vídeo es [música] para ti."}, {"s": 7.28, "e": 11.08, "t": "Aquí tienes 50 frases perfectas para"}, {"s": 11.08, "e": 14.08, "t": "sobrevivir en tu primera conversación en"}, {"s": 14.08, "e": 18.24, "t": "español. Vamos."}, {"s": 18.24, "e": 21.48, "t": "Para empezar una conversación con una"}, {"s": 21.48, "e": 26.4, "t": "persona, puedes usar estas frases."}, {"s": 26.4, "e": 28.2, "t": "Hola,"}, {"s": 28.2, "e": 30.4, "t": "¿qué tal?"}, {"s": 30.4, "e": 33.08, "t": "¿Cómo estás?"}, {"s": 33.08, "e": 35.24, "t": "Muy bien,"}, {"s": 35.24, "e": 37.52, "t": "gracias."}, {"s": 37.52, "e": 39.6, "t": "¿Y tú?"}, {"s": 39.6, "e": 42.72, "t": "Hola, ¿qué tal? ¿Cómo estás?"}, {"s": 42.72, "e": 46.36, "t": "Muy bien, gracias. ¿Y tú?"}, {"s": 46.36, "e": 49.68, "t": "Si conoces a alguien por primera vez,"}, {"s": 49.68, "e": 52.48, "t": "estas frases son un poquito más"}, {"s": 52.48, "e": 54.12, "t": "formales."}, {"s": 54.12, "e": 56.16, "t": "Buenos días."}, {"s": 56.16, "e": 58.96, "t": "Buenas tardes."}, {"s": 58.96, "e": 61.16, "t": "Mucho gusto."}, {"s": 61.16, "e": 63.0, "t": "Encantado."}, {"s": 63.0, "e": 65.08, "t": "Encantada."}, {"s": 65.08, "e": 67.6, "t": "Igualmente."}, {"s": 67.6, "e": 69.2, "t": "Buenos días."}, {"s": 69.2, "e": 73.88, "t": "Buenos días o buenas tardes."}, {"s": 73.88, "e": 76.92, "t": "Buenas tardes. Encantada."}, {"s": 76.92, "e": 79.4, "t": "Encantado. Igualmente."}, {"s": 79.4, "e": 81.8, "t": "Mucho gusto."}, {"s": 81.8, "e": 84.2, "t": "Ahora para presentarte tienes muchas"}, {"s": 84.2, "e": 85.8, "t": "opciones."}, {"s": 85.8, "e": 89.2, "t": "Muchas conversaciones empiezan así."}, {"s": 89.2, "e": 91.6, "t": "¿Cómo te llamas?"}, {"s": 91.6, "e": 94.4, "t": "Soy David."}, {"s": 94.4, "e": 97.68, "t": "Mi nombre es Aida."}, {"s": 97.68, "e": 100.28, "t": "Me llamo Cami."}, {"s": 100.28, "e": 102.96, "t": "¿De dónde eres?"}, {"s": 102.96, "e": 105.44, "t": "Soy de"}, {"s": 105.44, "e": 108.12, "t": "soy de Colombia."}, {"s": 108.12, "e": 112.6, "t": "Hola, soy Cami. Soy de Colombia."}, {"s": 112.6, "e": 114.76, "t": "Me llamo David."}, {"s": 114.76, "e": 117.48, "t": "Yo me llamo Aida. Nosotros somos de"}, {"s": 117.48, "e": 120.4, "t": "aquí, de España."}, {"s": 120.4, "e": 123.32, "t": "¿Y qué idiomas hablas?"}, {"s": 123.32, "e": 127.48, "t": "Puedes usar frases como estas."}, {"s": 127.48, "e": 129.48, "t": "Hablo"}, {"s": 129.48, "e": 131.76, "t": "inglés."}, {"s": 131.76, "e": 134.2, "t": "español."}, {"s": 134.2, "e": 136.84, "t": "Francés,"}, {"s": 136.84, "e": 139.28, "t": "un poco,"}, {"s": 139.28, "e": 142.24, "t": "un poquito."}, {"s": 142.24, "e": 145.56, "t": "Estoy aprendiendo."}, {"s": 145.56, "e": 147.84, "t": "Hablas bien,"}, {"s": 147.84, "e": 151.32, "t": "Cami, ¿tú hablas inglés?"}, {"s": 151.32, "e": 156.64, "t": "Sí, hablo inglés, francés y español."}, {"s": 156.64, "e": 157.84, "t": "Claro."}, {"s": 157.84, "e": 162.92, "t": "Ah, yo también hablo un poco de francés."}, {"s": 162.92, "e": 164.56, "t": "Estoy aprendiendo."}, {"s": 164.56, "e": 166.44, "t": "¿Estás aprendiendo?"}, {"s": 166.44, "e": 167.68, "t": "Uy,"}, {"s": 167.68, "e": 170.4, "t": "hablas bien."}, {"s": 170.4, "e": 172.96, "t": "Y ahora algunas frases para esas"}, {"s": 172.96, "e": 175.88, "t": "situaciones un poquito complicadas."}, {"s": 175.88, "e": 177.52, "t": "Por ejemplo, si no hablas muy bien"}, {"s": 177.52, "e": 181.32, "t": "español o no entiendes una palabra."}, {"s": 181.32, "e": 184.16, "t": "¿Me entiendes?"}, {"s": 184.16, "e": 186.36, "t": "Perdón."}, {"s": 186.36, "e": 188.8, "t": "No te entiendo."}, {"s": 188.8, "e": 191.32, "t": "No te entiendo."}, {"s": 191.32, "e": 194.96, "t": "No te escucho bien."}, {"s": 194.96, "e": 198.16, "t": "¿Puedes repetir,"}, {"s": 198.16, "e": 200.84, "t": "por favor?"}, {"s": 200.84, "e": 203.6, "t": "No te entendí."}, {"s": 203.6, "e": 206.88, "t": "¿Qué significa?"}, {"s": 206.92, "e": 210.44, "t": "Y bueno, al final, bueno, por esto estoy"}, {"s": 210.44, "e": 212.8, "t": "harta, ¿me entiendes?"}, {"s": 212.8, "e": 215.72, "t": "¡Uf! Perdón, eh, no te entiendo. Eh,"}, {"s": 215.72, "e": 217.96, "t": "creo que no te escucho muy bien. ¿Puedes"}, {"s": 217.96, "e": 219.84, "t": "repetir, por favor?"}, {"s": 219.84, "e": 224.04, "t": "Ah, sí, que por esto estoy harta."}, {"s": 224.04, "e": 227.24, "t": "Harta, sí. ¿Qué significa harta? Esta"}, {"s": 227.24, "e": 229.0, "t": "palabra no entendí."}, {"s": 229.0, "e": 232.64, "t": "Mmm. Harta significa cansada."}, {"s": 232.64, "e": 235.6, "t": "Por ejemplo, como ahora que estoy"}, {"s": 235.6, "e": 238.52, "t": "cansada de repetirte todas las palabras,"}, {"s": 238.52, "e": 240.04, "t": "Harry."}, {"s": 240.04, "e": 242.08, "t": "Okay, ahora entiendo."}, {"s": 242.08, "e": 244.32, "t": "No pasa nada. [risas]"}, {"s": 244.32, "e": 247.76, "t": "Y aquí va un buen consejo."}, {"s": 247.76, "e": 250.84, "t": "Cuando no entiendas algo, usa estas"}, {"s": 250.84, "e": 254.48, "t": "frases para pedir exactamente qué no"}, {"s": 254.48, "e": 257.24, "t": "entiendes. En lugar de decir, \"Por"}, {"s": 257.24, "e": 259.68, "t": "favor, ¿puedes repetirlo?"}, {"s": 259.68, "e": 261.64, "t": "Esto te va a ayudar a solucionar tu"}, {"s": 261.64, "e": 264.64, "t": "problema.\""}, {"s": 267.68, "e": 270.92, "t": "Bueno, ahora tenemos muchas frases, pero"}, {"s": 270.92, "e": 274.88, "t": "¿qué falta? Practicar. Para eso son"}, {"s": 274.88, "e": 277.0, "t": "perfectas las sesiones de conversación"}, {"s": 277.0, "e": 279.48, "t": "de Easy Spanish que ofrecemos todos los"}, {"s": 279.48, "e": 282.64, "t": "días y especialmente el martes las"}, {"s": 282.64, "e": 285.16, "t": "enfocamos en principiantes, ¿verdad,"}, {"s": 285.16, "e": 286.2, "t": "Aida?"}, {"s": 286.2, "e": 289.08, "t": "Exacto. Las sesiones de los martes están"}, {"s": 289.08, "e": 292.32, "t": "diseñadas para principiantes. Allí"}, {"s": 292.32, "e": 296.24, "t": "hablamos lentamente y sobre temas más"}, {"s": 296.24, "e": 297.76, "t": "sencillos."}, {"s": 297.76, "e": 299.52, "t": "Si quieres más información sobre las"}, {"s": 299.52, "e": 301.96, "t": "sesiones, ve al link que hay en la"}, {"s": 303.16, "e": 307.6, "t": "Y ahora seguimos con el vídeo."}, {"s": 309.16, "e": 311.92, "t": "También es importante conocer algunas"}, {"s": 311.92, "e": 314.84, "t": "frases para cambiar el idioma de la"}, {"s": 314.84, "e": 320.12, "t": "conversación de manera educada."}, {"s": 320.12, "e": 324.4, "t": "No hablo español muy bien."}, {"s": 324.4, "e": 328.36, "t": "Podemos hablar en inglés."}, {"s": 328.36, "e": 331.12, "t": "Va bien,"}, {"s": 331.12, "e": 333.8, "t": "no hay problema,"}, {"s": 333.8, "e": 337.84, "t": "no pasa nada."}, {"s": 337.84, "e": 340.8, "t": "Perdón, perdón, no hablo español muy"}, {"s": 340.8, "e": 344.56, "t": "bien. ¿Podemos hablar en inglés o va"}, {"s": 344.56, "e": 347.44, "t": "bien si hablamos en otro idioma?"}, {"s": 347.44, "e": 350.6, "t": "Claro, no, no hay problema, no pasa"}, {"s": 350.6, "e": 352.32, "t": "nada."}, {"s": 352.32, "e": 354.76, "t": "Siempre suena más elegante pedir eso en"}, {"s": 354.76, "e": 356.72, "t": "español, ¿verdad?"}, {"s": 356.72, "e": 359.16, "t": "Y ahora acabamos con unas peticiones"}, {"s": 359.16, "e": 362.64, "t": "típicas que quizás te ayudarán en algún"}, {"s": 362.64, "e": 364.88, "t": "momento."}, {"s": 364.88, "e": 367.24, "t": "Quiero"}, {"s": 367.24, "e": 370.72, "t": "quiero un café, por favor."}, {"s": 370.72, "e": 372.44, "t": "Puedo"}, {"s": 372.44, "e": 375.96, "t": "puedo pagar con tarjeta."}, {"s": 375.96, "e": 378.56, "t": "Necesito"}, {"s": 378.56, "e": 381.92, "t": "necesito agua."}, {"s": 381.92, "e": 383.96, "t": "¿Dónde está?"}, {"s": 383.96, "e": 385.8, "t": "¿Dónde"}, {"s": 385.8, "e": 388.6, "t": "está el baño?"}, {"s": 388.6, "e": 391.56, "t": "¿Cómo se dice?"}, {"s": 391.56, "e": 396.12, "t": "¿Cómo se dice esto en español?"}, {"s": 396.12, "e": 397.96, "t": "Lo del otro día."}, {"s": 397.96, "e": 399.24, "t": "Buenos días."}, {"s": 399.24, "e": 403.28, "t": "Hola. Yo quiero un café con leche, por"}, {"s": 403.28, "e": 404.12, "t": "favor."}, {"s": 404.12, "e": 406.28, "t": "Claro. ¿Y para ti?"}, {"s": 406.28, "e": 408.52, "t": "¿Puedo pagar con tarjeta?"}, {"s": 408.52, "e": 411.72, "t": "Por supuesto. ¿Y qué quieres tomar?"}, {"s": 411.72, "e": 414.32, "t": "Necesito agua. Si es posible de la"}, {"s": 414.32, "e": 415.56, "t": "llave."}, {"s": 415.56, "e": 417.0, "t": "De la llave."}, {"s": 417.0, "e": 419.16, "t": "¿Cómo se dice de la llave? Aquí en"}, {"s": 419.16, "e": 424.08, "t": "España se dice del grifo. Ah, del grifo,"}, {"s": 424.08, "e": 425.28, "t": "porfa."}, {"s": 425.28, "e": 426.76, "t": "¿Algo más?"}, {"s": 426.76, "e": 430.04, "t": "Sí. ¿Dónde está el baño?"}, {"s": 430.04, "e": 434.68, "t": "El baño está al fondo, a la izquierda."}, {"s": 434.68, "e": 436.24, "t": "De acuerdo. Gracias."}, {"s": 436.24, "e": 439.92, "t": "De nada. a ti."}, {"s": 439.92, "e": 442.84, "t": "Ahora es tu turno. Escribe en los"}, {"s": 442.84, "e": 446.6, "t": "comentarios de dónde eres y por qué"}, {"s": 446.6, "e": 449.0, "t": "aprendes español."}, {"s": 449.0, "e": 451.76, "t": "Y ahora que estás preparado para tener"}, {"s": 451.76, "e": 454.4, "t": "tus primeras conversaciones en español,"}, {"s": 454.4, "e": 457.04, "t": "te recomiendo que veas la lista de"}, {"s": 457.04, "e": 460.4, "t": "reproducción de aquí, [música] donde hay"}, {"s": 460.4, "e": 463.48, "t": "muchas conversaciones en español muy"}, {"s": 463.48, "e": 465.08, "t": "lento, perfectas [música]"}, {"s": 465.08, "e": 467.08, "t": "para ti."}, {"s": 467.08, "e": 468.64, "t": "Hasta la próxima."}, {"s": 468.64, "e": 470.12, "t": "Hasta luego."}, {"s": 470.12, "e": 473.12, "t": "Adiós."}, {"s": 475.68, "e": 476.72, "t": "Vale, gracias."}, {"s": 476.72, "e": 478.6, "t": "Gracias."}, {"s": 478.6, "e": 481.88, "t": "Vale, algo más."}]