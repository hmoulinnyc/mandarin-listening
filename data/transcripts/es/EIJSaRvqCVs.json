[{"s": 0.0, "e": 3.84, "t": "Hola, hoy vamos a hablar sobre los"}, {"s": 3.84, "e": 7.92, "t": "recuerdos usando el pasado. Aida,"}, {"s": 7.92, "e": 8.96, "t": "¿dónde estabas?"}, {"s": 8.96, "e": 11.28, "t": "Perdón, estaba en el baño."}, {"s": 11.28, "e": 14.88, "t": "Mmm, decía que vamos a hablar sobre"}, {"s": 14.88, "e": 17.36, "t": "recuerdos usando el pasado."}, {"s": 17.36, "e": 20.24, "t": "Oh, es un gran tema para practicar el"}, {"s": 20.24, "e": 21.76, "t": "imperfecto."}, {"s": 21.76, "e": 22.64, "t": "¿Vamos?"}, {"s": 22.64, "e": 25.12, "t": "Vamos."}, {"s": 34.8, "e": 36.28, "t": "Bueno David, veo que sigues con las"}, {"s": 36.28, "e": 38.48, "t": "aplicaciones de las citas."}, {"s": 38.48, "e": 41.68, "t": "No, no, no, no, no. Aplicaciones de"}, {"s": 41.68, "e": 44.52, "t": "cita, un fracaso. Las borré."}, {"s": 44.52, "e": 46.08, "t": "Eh, es que pasa, lo que pasa es que"}, {"s": 46.08, "e": 49.0, "t": "tengo el móvil lleno de fotos y no tengo"}, {"s": 49.0, "e": 49.76, "t": "espacio."}, {"s": 49.76, "e": 50.64, "t": "Ah."}, {"s": 50.64, "e": 53.44, "t": "Entonces, lo que estoy haciendo, bueno,"}, {"s": 53.44, "e": 56.48, "t": "quiero borrar fotos para tener espacio"}, {"s": 56.48, "e": 57.92, "t": "para nuevas fotos."}, {"s": 57.92, "e": 60.32, "t": "Ah, ahora lo entiendo."}, {"s": 60.32, "e": 63.12, "t": "Y he encontrado"}, {"s": 63.12, "e": 66.8, "t": "muchas fotos super buenas."}, {"s": 66.8, "e": 68.48, "t": "Por ejemplo, mira,"}, {"s": 68.48, "e": 69.56, "t": "te enseño."}, {"s": 69.56, "e": 70.8, "t": "A ver."}, {"s": 70.8, "e": 73.4, "t": "Oh, ¿ese eras tú?"}, {"s": 73.4, "e": 75.64, "t": "Sí, muy bien."}, {"s": 75.64, "e": 78.0, "t": "¿Me has reconocido?"}, {"s": 78.0, "e": 79.76, "t": "Mmm, la verdad es que no, me imaginé que"}, {"s": 79.76, "e": 81.4, "t": "si tenías una foto de un niño en tu"}, {"s": 81.4, "e": 83.28, "t": "móvil es porque eras tú."}, {"s": 83.28, "e": 85.6, "t": "Sí, bueno, soy yo."}, {"s": 85.6, "e": 88.24, "t": "Eh, no sé, creo que era un poco"}, {"s": 88.24, "e": 89.68, "t": "diferente."}, {"s": 89.68, "e": 93.2, "t": "Tenía gafas, también"}, {"s": 93.2, "e": 95.64, "t": "bueno, era un poco más"}, {"s": 95.64, "e": 98.08, "t": "tímido, un poco gruñón también."}, {"s": 98.08, "e": 99.32, "t": "Ajá."}, {"s": 99.32, "e": 100.6, "t": "Sí."}, {"s": 100.6, "e": 101.8, "t": "Por ejemplo,"}, {"s": 101.8, "e": 106.12, "t": "cuando me enfadaba, yo, ah, golpeaba"}, {"s": 106.12, "e": 108.24, "t": "la cabeza contra la pared."}, {"s": 108.24, "e": 109.32, "t": "¡Wow!"}, {"s": 109.32, "e": 111.6, "t": "Entonces, tenía un humor un poco"}, {"s": 111.6, "e": 113.44, "t": "diferente a ahora."}, {"s": 113.44, "e": 115.76, "t": "Y, y ¿en qué tipo de situaciones te"}, {"s": 115.76, "e": 118.48, "t": "enfadabas y golpeabas tu cabeza contra"}, {"s": 118.48, "e": 119.52, "t": "la pared."}, {"s": 119.52, "e": 123.16, "t": "Bueno, supongo que cuando tenía que ir"}, {"s": 123.16, "e": 125.0, "t": "al colegio."}, {"s": 125.0, "e": 128.0, "t": "Wow, muy fácil de enfadarte, eh."}, {"s": 128.0, "e": 130.8, "t": "No me gustaba mucho la escuela."}, {"s": 130.8, "e": 134.16, "t": "Y también así, cuando"}, {"s": 134.16, "e": 137.32, "t": "cuando tenía que comer verdura."}, {"s": 137.32, "e": 139.6, "t": "No me gustaba la verdura."}, {"s": 139.6, "e": 142.92, "t": "Y entonces te ibas para la pared y bam,"}, {"s": 142.92, "e": 144.16, "t": "bam."}, {"s": 144.16, "e": 146.8, "t": "Sí, sí, sí. Estaba un poco loco."}, {"s": 146.8, "e": 149.48, "t": "Pero esta foto eh es muy divertida"}, {"s": 149.48, "e": 152.4, "t": "porque estaba en un parque"}, {"s": 152.4, "e": 155.68, "t": "y mi madre me dijo, \"Oh, estás muy"}, {"s": 155.68, "e": 159.08, "t": "guapo. Voy a hacerte una foto.\""}, {"s": 159.08, "e": 160.76, "t": "No estaba enfadado."}, {"s": 160.76, "e": 161.76, "t": "¿Okay?"}, {"s": 161.76, "e": 163.8, "t": "Y justo después"}, {"s": 163.8, "e": 165.12, "t": "había ninguna pared."}, {"s": 165.12, "e": 167.12, "t": "Exacto, exacto."}, {"s": 167.12, "e": 172.12, "t": "Pero justo después de la foto, yo me caí"}, {"s": 172.12, "e": 173.96, "t": "en ese lago"}, {"s": 173.96, "e": 176.84, "t": "y mis padres tuvieron que"}, {"s": 176.84, "e": 178.12, "t": "recogerme."}, {"s": 178.12, "e": 181.76, "t": "Y puedes ver que en esta foto yo llevaba"}, {"s": 181.76, "e": 184.68, "t": "manga larga, entonces hacía un poco de"}, {"s": 184.68, "e": 185.32, "t": "frío."}, {"s": 185.32, "e": 188.44, "t": "Ay, pobre, wow. Y cuántos años tenías en"}, {"s": 188.44, "e": 190.96, "t": "esta foto."}, {"s": 190.96, "e": 193.52, "t": "Yo creo que tenía"}, {"s": 193.52, "e": 197.12, "t": "unos tres o cuatro años. Era un niño."}, {"s": 197.12, "e": 198.2, "t": "Eras pequeñito, eh."}, {"s": 198.2, "e": 199.2, "t": "Sí."}, {"s": 199.2, "e": 202.2, "t": "¿Y tú, Aira? ¿Tú cómo eras cuando eras"}, {"s": 202.2, "e": 203.6, "t": "niña?"}, {"s": 203.6, "e": 206.12, "t": "Uf, yo a ver."}, {"s": 206.12, "e": 207.88, "t": "Yo era"}, {"s": 207.88, "e": 209.96, "t": "bastante"}, {"s": 209.96, "e": 212.56, "t": "movida, creo."}, {"s": 212.56, "e": 213.92, "t": "Creo que mis padres dirían que yo era"}, {"s": 213.92, "e": 215.68, "t": "bastante movida."}, {"s": 215.68, "e": 218.16, "t": "Ah, un poco payasa, bueno, como ahora,"}, {"s": 218.16, "e": 219.8, "t": "de hecho."}, {"s": 219.8, "e": 221.76, "t": "Am, sí."}, {"s": 221.76, "e": 223.32, "t": "Tengo alguna foto. ¿Quieres que te la"}, {"s": 223.32, "e": 223.84, "t": "muestre?"}, {"s": 223.84, "e": 224.88, "t": "Claro, a ver."}, {"s": 224.88, "e": 226.52, "t": "A ver."}, {"s": 226.52, "e": 228.72, "t": "Aquí, en esta foto"}, {"s": 228.72, "e": 230.6, "t": "estaba en el campo"}, {"s": 230.6, "e": 232.08, "t": "y"}, {"s": 232.08, "e": 234.4, "t": "bueno, mis abuelos tenían gallinas,"}, {"s": 234.4, "e": 235.44, "t": "muchas gallinas."}, {"s": 235.44, "e": 237.88, "t": "Ah, pensaba que era un gato."}, {"s": 237.88, "e": 240.96, "t": "Oh, no, era una gallina, una gallina."}, {"s": 240.96, "e": 242.24, "t": "Sí, sí, sí."}, {"s": 242.24, "e": 246.48, "t": "Y pues a mí me gustaba ir"}, {"s": 246.48, "e": 249.8, "t": "para allá y sinceramente jugaba con las"}, {"s": 249.8, "e": 251.16, "t": "gallinas"}, {"s": 251.16, "e": 252.88, "t": "y siempre"}, {"s": 252.88, "e": 255.16, "t": "jugaba en la arena, como en el suelo,"}, {"s": 255.16, "e": 258.8, "t": "simplemente y me ensuciaba y corría."}, {"s": 258.8, "e": 261.52, "t": "Bueno, eso era lo que me gustaba a mí."}, {"s": 261.52, "e": 262.92, "t": "Sí."}, {"s": 262.92, "e": 266.16, "t": "Estás muy mona, eras muy mona, creo."}, {"s": 266.16, "e": 270.2, "t": "Aquí tenía unos 6 años, imagino."}, {"s": 270.2, "e": 273.76, "t": "Y la gallina nunca te atacaba."}, {"s": 273.76, "e": 275.72, "t": "No, a mí no, yo me portaba bien con las"}, {"s": 275.72, "e": 278.6, "t": "gallinas, yo no jugaba con ellas, pero"}, {"s": 278.6, "e": 280.6, "t": "no les hacía nada."}, {"s": 280.6, "e": 282.24, "t": "Okay, okay, muy bien."}, {"s": 282.24, "e": 283.0, "t": "Sí, sí."}, {"s": 283.0, "e": 284.92, "t": "Y en esta foto"}, {"s": 284.92, "e": 287.28, "t": "¿qué estabas haciendo?"}, {"s": 287.28, "e": 290.28, "t": "Pues en esta foto estaba"}, {"s": 290.28, "e": 292.44, "t": "pobrecita gallina. Bueno, yo creo que"}, {"s": 292.44, "e": 294.68, "t": "estaba bien la gallina, la tenía en mis"}, {"s": 294.68, "e": 296.76, "t": "brazos y la estaba cuidando,"}, {"s": 296.76, "e": 298.76, "t": "acariciando."}, {"s": 298.76, "e": 302.28, "t": "Y nada, también vi un vídeo en el que yo"}, {"s": 302.28, "e": 303.84, "t": "hablaba con las gallinas, les decía,"}, {"s": 303.84, "e": 307.04, "t": "\"Oy, tú te has portado mal, ahora"}, {"s": 307.04, "e": 309.8, "t": "Enseñabas español a gallinas."}, {"s": 309.8, "e": 311.24, "t": "¿Te imaginas?"}, {"s": 311.24, "e": 314.08, "t": "No, no, por cierto, no llegué tan lejos."}, {"s": 314.08, "e": 315.28, "t": "Qué bueno."}, {"s": 315.28, "e": 316.16, "t": "Pues"}, {"s": 316.16,