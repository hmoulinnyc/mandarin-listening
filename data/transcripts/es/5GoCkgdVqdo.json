[{"s": 0.2, "e": 2.6, "t": "¿Quieres aprender el alfabeto en"}, {"s": 2.6, "e": 4.0, "t": "español?"}, {"s": 4.0, "e": 6.8, "t": "Hoy aprenderás todas las letras [música]"}, {"s": 6.8, "e": 10.4, "t": "y los sonidos particulares del español."}, {"s": 10.4, "e": 13.1, "t": "Vamos."}, {"s": 14.8, "e": 17.8, "t": "Empezamos con las vocales."}, {"s": 17.8, "e": 19.1, "t": "A"}, {"s": 19.1, "e": 20.5, "t": "animal"}, {"s": 20.5, "e": 23.2, "t": "o Aida."}, {"s": 23.2, "e": 24.3, "t": "E"}, {"s": 24.3, "e": 26.7, "t": "elefante."}, {"s": 26.7, "e": 28.1, "t": "I"}, {"s": 28.1, "e": 30.1, "t": "India."}, {"s": 30.1, "e": 31.6, "t": "O"}, {"s": 31.6, "e": 33.6, "t": "ocho."}, {"s": 33.6, "e": 34.6, "t": "U"}, {"s": 34.6, "e": 37.6, "t": "universidad."}, {"s": 38.2, "e": 41.5, "t": "Las vocales en español siempre suenan"}, {"s": 41.5, "e": 44.7, "t": "igual. No importa como estén combinadas"}, {"s": 44.7, "e": 47.6, "t": "entre ellas. Qué suerte."}, {"s": 47.6, "e": 50.1, "t": "Ahora vamos a continuar viendo el"}, {"s": 50.1, "e": 53.5, "t": "alfabeto entero."}, {"s": 53.6, "e": 55.0, "t": "A"}, {"s": 55.0, "e": 57.5, "t": "agua."}, {"s": 57.5, "e": 59.0, "t": "B"}, {"s": 59.0, "e": 61.7, "t": "banco."}, {"s": 61.7, "e": 63.4, "t": "C"}, {"s": 63.4, "e": 64.8, "t": "casa."}, {"s": 64.8, "e": 66.9, "t": "Camila."}, {"s": 66.9, "e": 70.2, "t": "¿Y qué pasa con la palabra cinco?"}, {"s": 70.2, "e": 72.8, "t": "Claro, depende de la vocal que hay"}, {"s": 72.8, "e": 76.0, "t": "después de la C. Por ejemplo, con la E y"}, {"s": 76.0, "e": 77.1, "t": "la I"}, {"s": 77.1, "e": 80.8, "t": "decimos ce ci. Cerveza,"}, {"s": 80.8, "e": 82.6, "t": "cielo."}, {"s": 82.6, "e": 85.9, "t": "Claro, y por eso también decimos carta,"}, {"s": 85.9, "e": 89.1, "t": "color y cumbia."}, {"s": 89.1, "e": 91.8, "t": "Pero recuerden que en Latinoamérica la C"}, {"s": 91.8, "e": 95.6, "t": "con la E y la C con la I es como una S."}, {"s": 95.6, "e": 97.8, "t": "Cinco, cielo,"}, {"s": 97.8, "e": 100.2, "t": "cerveza."}, {"s": 100.2, "e": 101.2, "t": "D"}, {"s": 101.2, "e": 102.8, "t": "diferente"}, {"s": 102.8, "e": 104.3, "t": "o David."}, {"s": 104.3, "e": 106.9, "t": "E elefante."}, {"s": 106.9, "e": 110.6, "t": "Y F familia."}, {"s": 110.6, "e": 112.2, "t": "G"}, {"s": 112.2, "e": 113.9, "t": "gol"}, {"s": 113.9, "e": 115.7, "t": "gel."}, {"s": 115.7, "e": 119.7, "t": "Atención, otra vez hay dos sonidos y"}, {"s": 119.7, "e": 122.19, "t": "depende de vocal que hay después. Por"}, {"s": 122.19, "e": 124.79, "t": "ejemplo,"}, {"s": 124.79, "e": 125.69, "t": "general."}, {"s": 125.69, "e": 129.29, "t": "general y gimnasio."}, {"s": 129.29, "e": 132.29, "t": "Claro. Y el resto siguen como la palabra"}, {"s": 132.29, "e": 133.59, "t": "gol."}, {"s": 133.59, "e": 138.59, "t": "Gato, gorila, guapo."}, {"s": 139.79, "e": 141.19, "t": "H."}, {"s": 141.19, "e": 143.59, "t": "Hospital."}, {"s": 143.59, "e": 147.99, "t": "La H en español no suena. Por eso,"}, {"s": 147.99, "e": 149.19, "t": "hola"}, {"s": 149.19, "e": 151.89, "t": "suena igual que hola."}, {"s": 151.89, "e": 155.89, "t": "Pero, ¿qué pasa con la CH?"}, {"s": 155.89, "e": 159.29, "t": "Atención. Hay una cosa cuando combinamos"}, {"s": 159.29, "e": 161.59, "t": "la C y la H. ¿Qué pasa, Aida?"}, {"s": 161.59, "e": 164.19, "t": "Suena como chocolate."}, {"s": 164.19, "e": 167.29, "t": "O chorizo."}, {"s": 167.69, "e": 169.19, "t": "I."}, {"s": 169.19, "e": 171.39, "t": "India."}, {"s": 171.39, "e": 173.09, "t": "J."}, {"s": 173.09, "e": 175.29, "t": "Jardín."}, {"s": 175.29, "e": 176.59, "t": "K."}, {"s": 176.59, "e": 178.79, "t": "Kilo."}, {"s": 178.79, "e": 180.39, "t": "L."}, {"s": 180.39, "e": 182.49, "t": "Limón."}, {"s": 182.49, "e": 186.39, "t": "Y, ¿qué pasa con dos Ls?"}, {"s": 186.39, "e": 190.79, "t": "Suena como lluvia, ella o paella."}, {"s": 190.79, "e": 194.59, "t": "Como la Y que vamos a ver después."}, {"s": 194.59, "e": 197.29, "t": "M. Música."}, {"s": 197.29, "e": 203.09, "t": "N. Natural. Y Ñ. Español."}, {"s": 203.09, "e": 206.99, "t": "Cuidado con la Ñ. La Ñ es una letra que"}, {"s": 206.99, "e": 210.19, "t": "solo existe en español. No es un acento."}, {"s": 210.19, "e": 213.39, "t": "No, no, no. Es una letra."}, {"s": 213.39, "e": 214.99, "t": "O."}, {"s": 214.99, "e": 216.79, "t": "Ocho."}, {"s": 216.79, "e": 218.39, "t": "P."}, {"s": 218.39, "e": 220.29, "t": "Padre."}, {"s": 220.29, "e": 221.69, "t": "Q."}, {"s": 221.69, "e": 223.89, "t": "Queso."}, {"s": 223.89, "e": 227.79, "t": "La Q suena como en qué o quién."}, {"s": 227.79, "e": 230.39, "t": "Y siempre después hay una U, pero no se"}, {"s": 230.39, "e": 232.89, "t": "pronuncia."}, {"s": 233.39, "e": 234.99, "t": "R."}, {"s": 234.99, "e": 237.29, "t": "Restaurante."}, {"s": 237.29, "e": 239.29, "t": "Cuidado con la R."}, {"s": 239.29, "e": 242.09, "t": "Si tenemos una R se pronuncia como en"}, {"s": 242.09, "e": 243.39, "t": "pero,"}, {"s": 243.39, "e": 245.59, "t": "y si tenemos dos erres, se pronuncia"}, {"s": 245.59, "e": 247.19, "t": "perro."}, {"s": 247.19, "e": 250.69, "t": "También, si una palabra empieza por R"}, {"s": 250.69, "e": 252.59, "t": "hacemos R"}, {"s": 252.59, "e": 255.59, "t": "como rosa."}, {"s": 255.99, "e": 257.79, "t": "S"}, {"s": 257.79, "e": 260.19, "t": "sopa"}, {"s": 260.19, "e": 261.69, "t": "T"}, {"s": 261.69, "e": 264.09, "t": "tráfico."}, {"s": 264.09, "e": 265.19, "t": "U"}, {"s": 265.19, "e": 266.99, "t": "uno"}, {"s": 266.99, "e": 268.49, "t": "V"}, {"s": 268.49, "e": 269.79, "t": "verde."}, {"s": 269.79, "e": 274.09, "t": "Es curioso, pero en español la V y la B"}, {"s": 274.09, "e": 278.39, "t": "suenan muy muy similares. Por ejemplo,"}, {"s": 278.39, "e": 281.89, "t": "tengo que votar en elecciones"}, {"s": 281.89, "e": 282.99, "t": "o"}, {"s": 282.99, "e": 286.39, "t": "tengo que votar la basura."}, {"s": 286.39, "e": 290.09, "t": "Y W o W"}, {"s": 290.09, "e": 292.39, "t": "web."}, {"s": 292.49, "e": 294.59, "t": "X"}, {"s": 294.59, "e": 296.69, "t": "taxi"}, {"s": 296.69, "e": 298.09, "t": "Y"}, {"s": 298.09, "e": 300.29, "t": "yogur."}, {"s": 300.29, "e": 303.19, "t": "Para nosotros esta letra tiene el mismo"}, {"s": 303.19, "e": 305.89, "t": "sonido que la doble L."}, {"s": 305.89, "e": 307.19, "t": "yo"}, {"s": 307.19, "e": 310.69, "t": "yema yate."}, {"s": 310.69, "e": 313.09, "t": "Pero en Latinoamérica tenemos dos"}, {"s": 313.09, "e": 315.99, "t": "sonidos para esta letra. En Colombia"}, {"s": 315.99, "e": 321.39, "t": "suena muy fuerte. Yo yema yate."}, {"s": 321.39, "e": 323.89, "t": "Y en Argentina y en Uruguay suena como"}, {"s": 323.89, "e": 324.99, "t": "un"}, {"s": 324.99, "e": 328.89, "t": "Yo yema yate."}, {"s": 328.89, "e": 330.39, "t": "Z"}, {"s": 330.39, "e": 332.89, "t": "zapato."}, {"s": 333.09, "e": 336.39, "t": "Como le escuchaste a Aida, la Z en"}, {"s": 336.39, "e": 339.89, "t": "España suena como la C, cielo."}, {"s": 339.89, "e": 343.59, "t": "Pero en el resto de Latinoamérica la Z"}, {"s": 343.59, "e": 345.89, "t": "suena como una S."}, {"s": 345.89, "e": 347.69, "t": "zapato"}, {"s": 347.69, "e": 349.29, "t": "zanahoria"}, {"s": 349.29, "e": 351.49, "t": "azul."}, {"s": 351.49, "e": 353.7, "t": "Cuando estás iniciando con tu español,"}, {"s": 356.69, "e": 358.99, "t": "son muy importantes, pero"}, {"s": 358.99, "e": 361.39, "t": "¿qué más necesitas realmente cuando"}, {"s": 361.39, "e": 363.29, "t": "estás iniciando con tu español?"}, {"s": 363.29, "e": 367.5, "t": "¿Aprender los pasados o más verbos?"}, {"s": 367.5, "e": 369.5, "t": "Quizás lo que necesitas es un paso a"}, {"s": 369.5, "e": 371.6, "t": "paso, un orden."}, {"s": 371.6, "e": 374.01, "t": "Por eso nuestro learning path de A 0"}, {"s": 376.6, "e": 378.6, "t": "Si le echas un vistazo a nuestra"}, {"s": 378.6, "e": 380.6, "t": "plataforma en el link que te dejamos en"}, {"s": 380.6, "e": 383.39, "t": "la descripción, puedes registrarte y"}, {"s": 383.39, "e": 385.19, "t": "hacer ejercicios gratis para que"}, {"s": 385.19, "e": 387.8, "t": "practiques y veas cómo es."}, {"s": 387.8, "e": 390.5, "t": "Así que te lo dejamos en la descripción"}, {"s": 390.5, "e": 394.0, "t": "y bueno, continuamos con el video."}, {"s": 394.0, "e": 397.5, "t": "Vale, ahora vamos a practicar."}, {"s": 397.5, "e": 401.5, "t": "Pronuncia la palabra antes que yo."}, {"s": 406.8, "e": 409.5, "t": "Jardín."}, {"s": 412.8, "e": 415.3, "t": "Cero."}, {"s": 417.69, "e": 420.5, "t": "Hospital."}, {"s": 423.8, "e": 426.4, "t": "Guapo."}, {"s": 429.39, "e": 432.29, "t": "Gimnasio."}, {"s": 433.69, "e": 436.69, "t": "Paella."}, {"s": 438.8, "e": 441.19, "t": "Caro."}, {"s": 443.69, "e": 445.89, "t": "Yogur."}, {"s": 445.89, "e": 448.19, "t": "Ahora que ya sabes el alfabeto, te"}, {"s": 448.19, "e": 450.1, "t": "dejamos esta playlist para"}, {"s": 450.1, "e": 451.3, "t": "principiantes. [música]"}, {"s": 451.3, "e": 455.69, "t": "Nos vemos en la próxima. Chao."}]