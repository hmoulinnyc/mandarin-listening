[{"s": 0.17, "e": 3.25, "t": "En este puzle hay"}, {"s": 3.46, "e": 6.46, "t": "una chica tumbada."}, {"s": 6.55, "e": 10.47, "t": "la chica tiene el pelo"}, {"s": 10.47, "e": 14.81, "t": "de color castaño y largo."}, {"s": 15.06, "e": 17.85, "t": "Tiene el pelo largo."}, {"s": 17.85, "e": 22.35, "t": "Yo tengo el pelo corto"}, {"s": 22.52, "e": 26.73, "t": "y lleva una chaqueta amarilla"}, {"s": 26.73, "e": 30.2, "t": "y una falda roja."}, {"s": 30.2, "e": 33.03, "t": "No lleva zapatos."}, {"s": 33.03, "e": 35.91, "t": "los zapatos están"}, {"s": 35.91, "e": 39.08, "t": "al borde de la manta."}, {"s": 39.16, "e": 42.17, "t": "Esto es el borde."}, {"s": 42.96, "e": 47.81, "t": "Encima de la manta hay un plato."}, {"s": 47.92, "e": 53.34, "t": "Esto es un plato con tres fresas."}, {"s": 53.34, "e": 57.6, "t": "Y también hay dos libros."}, {"s": 57.6, "e": 62.44, "t": "Un libro naranja y un libro azul."}, {"s": 62.44, "e": 67.27, "t": "Y la chica está leyendo un libro rosa."}, {"s": 67.28, "e": 71.7, "t": "También hay una cesta con flores."}, {"s": 72.16, "e": 75.16, "t": "Y las flores son blancas."}, {"s": 75.45, "e": 78.45, "t": "Al lado, al lado,"}, {"s": 78.58, "e": 83.29, "t": "Al lado de la chica, hay un perro."}, {"s": 83.33, "e": 85.96, "t": "Esto es un perro."}, {"s": 85.96, "e": 90.0, "t": "Un perro de color blanco"}, {"s": 90.05, "e": 93.68, "t": "y negro con la nariz..."}, {"s": 93.72, "e": 97.81, "t": "La nariz de color rosa."}, {"s": 97.81, "e": 102.69, "t": "En esta foto también hay un árbol."}, {"s": 102.69, "e": 106.64, "t": "Está a la izquierda."}, {"s": 106.73, "e": 109.19, "t": "Esta es la derecha"}, {"s": 109.19, "e": 112.07, "t": "y esta es la izquierda."}, {"s": 112.07, "e": 115.03, "t": "En la izquierda. Arriba."}, {"s": 115.03, "e": 116.37, "t": "No, abajo."}, {"s": 116.37, "e": 119.87, "t": "Arriba hay un árbol."}, {"s": 119.91, "e": 124.79, "t": "Este árbol tiene el tronco."}, {"s": 124.79, "e": 127.21, "t": "Esto es el tronco."}, {"s": 127.21, "e": 130.67, "t": "Tiene el tronco muy grueso."}, {"s": 130.8, "e": 132.84, "t": "No es finito."}, {"s": 132.84, "e": 135.0, "t": "Es grueso."}, {"s": 135.0, "e": 141.86, "t": "Y tiene una, dos, tres y cuatro ramas"}, {"s": 141.93, "e": 144.81, "t": "Esto son las ramas."}, {"s": 144.81, "e": 148.06, "t": "Y aquí tiene las hojas."}, {"s": 148.23, "e": 152.57, "t": "Este árbol parece un sauce."}, {"s": 152.9, "e": 155.45, "t": "Arriba a la derecha."}, {"s": 155.45, "e": 158.2, "t": "También hay otro sauce."}, {"s": 159.28, "e": 163.41, "t": "En la parte de arriba hay agua."}, {"s": 163.58, "e": 173.04, "t": "Y en el agua hay uno, dos, tres y cuatro patos."}, {"s": 173.13, "e": 175.84, "t": "Patos blancos."}, {"s": 175.84, "e": 178.9, "t": "En la orilla del estanque."}, {"s": 179.01, "e": 182.01, "t": "Esto es la orilla."}, {"s": 182.06, "e": 185.06, "t": "Hay juncos."}, {"s": 185.23, "e": 187.6, "t": "Esto son juncos."}, {"s": 187.6, "e": 191.82, "t": "Y aquí en el agua también"}, {"s": 191.86, "e": 199.12, "t": "hay uno, dos, tres, cuatro, cinco, seis y siete nenúfares."}, {"s": 199.16, "e": 202.41, "t": "Esto son nenúfares."}, {"s": 202.53, "e": 206.62, "t": "Os recomiendo probar a describir una imagen"}, {"s": 206.62, "e": 212.17, "t": "vosotros mismos, porque siempre lleva la misma estructura."}, {"s": 212.17, "e": 218.13, "t": "Podéis ir a trysprout.es y probar la fotocharla."}, {"s": 218.18, "e": 222.51, "t": "Ahí os damos una imagen y vocabulario útil"}, {"s": 222.51, "e": 227.77, "t": "para describir la imagen y practicar vuestro español."}, {"s": 227.98, "e": 233.78, "t": "En esta foto estamos dentro de una casa"}, {"s": 234.07, "e": 236.86, "t": "y por la ventana"}, {"s": 236.86, "e": 241.11, "t": "podemos ver que fuera, fuera,"}, {"s": 241.16, "e": 246.56, "t": "no dentro, fuera... está lloviendo."}, {"s": 246.56, "e": 253.13, "t": "Está lloviendo pero vemos el sol aquí atrás,"}, {"s": 253.17, "e": 258.63, "t": "detrás de las montañas está el sol."}, {"s": 258.68, "e": 261.8, "t": "Y gracias al sol y la lluvia"}, {"s": 262.26, "e": 266.35, "t": "se ha formado un arcoíris."}, {"s": 266.56, "e": 269.77, "t": "Esto es un arcoíris."}, {"s": 270.19, "e": 275.9, "t": "Fuera, en el jardín hay otra casa."}, {"s": 275.9, "e": 281.9, "t": "Y uno y dos ciervos."}, {"s": 282.03, "e": 284.74, "t": "Esto es un ciervo."}, {"s": 284.74, "e": 287.29, "t": "Y esto es un ciervo bebé."}, {"s": 287.29, "e": 289.04, "t": "Un cervatillo."}, {"s": 289.04, "e": 295.17, "t": "Dentro de la casa tenemos una mesa"}, {"s": 295.17, "e": 298.3, "t": "con un mantel azul."}, {"s": 298.34, "e": 301.34, "t": "Esto es un mantel."}, {"s": 301.68, "e": 306.18, "t": "Es un mantel a cuadros."}, {"s": 306.26, "e": 309.27, "t": "Encima del mantel"}, {"s": 309.48, "e": 313.4, "t": "hay una tetera azul"}, {"s": 313.44, "e": 317.52, "t": "con flores y está humeante."}, {"s": 317.69, "e": 320.53, "t": "Esto es humo."}, {"s": 320.53, "e": 324.66, "t": "Aquí hay un plato pequeño"}, {"s": 324.87, "e": 328.79, "t": "con una taza de café."}, {"s": 328.79, "e": 334.88, "t": "Y el café también está humeante."}, {"s": 334.96, "e": 338.51, "t": "Debajo de el café"}, {"s": 338.59, "e": 343.13, "t": "hay un plato con un huevo duro."}, {"s": 343.13, "e": 345.8, "t": "Esto es un huevo duro."}, {"s": 345.8, "e": 350.48, "t": "Y también hay una tarta con flores."}, {"s": 350.48, "e": 355.1, "t": "Al lado de la tarta hay otro huevo duro."}, {"s": 355.15, "e": 360.49, "t": "Y aquí hay una cucharita, una cuchara pequeña,"}, {"s": 360.53, "e": 362.56, "t": "una cucharita."}, {"s": 362.56, "e": 364.4, "t": "Un cuchillo"}, {"s": 364.4, "e": 367.74, "t": "y un plato con mantequilla."}, {"s": 367.87, "e": 370.42, "t": "Esto es mantequilla."}, {"s": 370.42, "e": 373.16, "t": "En la tabla de cortar."}, {"s": 373.16, "e": 375.83, "t": "Esta es la tabla de cortar."}, {"s": 375.83, "e": 381.59, "t": "Hay un trozo de pan con una rebanada de pan."}, {"s": 381.76, "e": 387.66, "t": "Y aquí hay una rebanada de pan con mermelada."}, {"s": 387.66, "e": 389.53, "t": "A los lados."}, {"s": 389.53, "e": 392.72, "t": "A los lados de la mesa"}, {"s": 392.73, "e": 396.54, "t": "hay una y dos sillas."}, {"s": 396.54, "e": 398.11, "t": "Y las cortinas."}, {"s": 398.11, "e": 401.57, "t": "(esto son las cortinas)"}, {"s": 401.57, "e": 404.49, "t": "son muy finitas,"}, {"s": 404.49, "e": 409.7, "t": "casi transparentes, como el cristal de la ventana."}, {"s": 410.08, "e": 412.87, "t": "El cristal no tiene"}, {"s": 412.87, "e": 415.83, "t": "color, es transparente"}, {"s": 415.96, "e": 420.46, "t": "y las cortinas son casi transparentes."}, {"s": 420.63, "e": 423.28, "t": "Son muy finas."}, {"s": 423.28, "e": 427.25, "t": "En el alféizar de la ventana."}, {"s": 427.38, "e": 431.01, "t": "Esto es el alféizar."}, {"s": 431.01, "e": 435.64, "t": "Hay un jarrón con flores,"}, {"s": 435.64, "e": 438.19, "t": "Dos libros"}, {"s": 438.19, "e": 443.07, "t": "y uno, dos y tres jacintos."}, {"s": 443.07, "e": 445.57, "t": "Esta flor es un jacinto."}, {"s": 445.57, "e": 451.24, "t": "Si queréis probar Sprout, podéis usar mi link trysprout.es"}, {"s": 451.28, "e": 455.37, "t": "para conseguir un 50% de descuento"}, {"s": 455.37, "e": 460.21, "t": "en el plan anual y una prueba gratuita de siete días."}]