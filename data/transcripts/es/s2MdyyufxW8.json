[{"s": 6.44, "e": 9.61, "t": "Esto es una planta."}, {"s": 9.61, "e": 13.18, "t": "Una planta."}, {"s": 13.18, "e": 15.21, "t": "Tiene polvo."}, {"s": 15.21, "e": 20.52, "t": "Vamos a limpiar el polvo."}, {"s": 29.09, "e": 34.4, "t": "El trapo."}, {"s": 45.68, "e": 48.98, "t": "Esta planta está sucia."}, {"s": 48.98, "e": 51.15, "t": "Tiene polvo."}, {"s": 51.15, "e": 52.79, "t": "¿Lo veis?"}, {"s": 52.79, "e": 57.72, "t": "Vamos a limpiar la planta"}, {"s": 57.72, "e": 61.49, "t": "con el trapo."}, {"s": 61.49, "e": 66.13, "t": "Quitamos el polvo"}, {"s": 66.13, "e": 69.2, "t": "de las hojas."}, {"s": 69.2, "e": 70.87, "t": "o mai god"}, {"s": 70.87, "e": 74.06, "t": "Está muy sucia."}, {"s": 74.06, "e": 76.06, "t": "!!!!!!!!!!"}, {"s": 78.11, "e": 81.08, "t": "No"}, {"s": 81.08, "e": 86.35, "t": "he roto la planta."}, {"s": 89.19, "e": 93.66, "t": "Si queréis limpiar el polvo"}, {"s": 93.66, "e": 95.66, "t": "de las hojas,"}, {"s": 95.66, "e": 98.97, "t": "hay que hacerlo con cuidado."}, {"s": 98.97, "e": 103.17, "t": "Con mucho cuidado."}, {"s": 103.17, "e": 108.44, "t": "Si no se rompen."}, {"s": 108.51, "e": 113.81, "t": "Esto es una planta limpia."}, {"s": 114.68, "e": 118.35, "t": "Las hojas no tienen polvo."}, {"s": 118.35, "e": 121.95, "t": "Está limpia. Y las plantas,"}, {"s": 121.95, "e": 124.32, "t": "igual que las personas-"}, {"s": 124.32, "e": 128.39, "t": "Yo soy una persona. Planta. Persona."}, {"s": 128.39, "e": 130.13, "t": "Planta. Persona."}, {"s": 130.13, "e": 136.54, "t": "Las plantas igual que las personas necesitan agua."}, {"s": 136.8, "e": 139.67, "t": "Agua. El agua."}, {"s": 139.67, "e": 142.64, "t": "Tiene un filtro."}, {"s": 142.64, "e": 145.91, "t": "Esto es un filtro de agua."}, {"s": 145.91, "e": 149.55, "t": "Y este agua no está filtrada."}, {"s": 149.55, "e": 154.85, "t": "Es agua del grifo."}, {"s": 156.32, "e": 161.46, "t": "Las personas como yo bebemos agua."}, {"s": 161.46, "e": 165.1, "t": "Necesitamos agua todos los días."}, {"s": 166.2, "e": 171.5, "t": "Y bebemos agua."}, {"s": 172.5, "e": 177.44, "t": "El agua es muy buena para las personas."}, {"s": 177.44, "e": 181.98, "t": "Las plantas también beben agua."}, {"s": 181.98, "e": 185.38, "t": "También necesitan agua."}, {"s": 185.38, "e": 190.69, "t": "Para saber si la planta necesita agua,"}, {"s": 191.02, "e": 193.13, "t": "hay que tocar-"}, {"s": 193.13, "e": 195.63, "t": "Hay que tocar la tierra."}, {"s": 195.63, "e": 197.96, "t": "Esto es la tierra."}, {"s": 197.96, "e": 201.87, "t": "Tocamos la tierra."}, {"s": 201.87, "e": 207.17, "t": "Y vemos si está seca o húmeda."}, {"s": 207.37, "e": 212.68, "t": "Si la planta está seca, necesita agua."}, {"s": 215.48, "e": 218.08, "t": "Si está húmeda,"}, {"s": 218.08, "e": 221.85, "t": "no necesita agua."}, {"s": 221.85, "e": 224.76, "t": "Esta está un poco."}, {"s": 224.76, "e": 226.89, "t": "Un poco húmeda."}, {"s": 226.89, "e": 232.63, "t": "Si la planta está seca, hay que regar la planta."}, {"s": 232.97, "e": 238.24, "t": "Y para regar la planta, necesitamos una regadera."}, {"s": 242.84, "e": 245.42, "t": "¿Regadera? No."}, {"s": 245.42, "e": 247.78, "t": "¿Regadera? No."}, {"s": 247.78, "e": 252.99, "t": "En el armario no hay regadera."}, {"s": 252.99, "e": 257.02, "t": "Así que vamos a usar otra cosa"}, {"s": 257.02, "e": 259.52, "t": "para regar la planta."}, {"s": 259.52, "e": 262.09, "t": "Para regar la planta,"}, {"s": 262.1, "e": 267.4, "t": "vamos a usar una botella de agua."}, {"s": 268.17, "e": 271.64, "t": "Abrimos la botella de agua,"}, {"s": 271.64, "e": 278.91, "t": "y regamos la planta con el agua de la botella."}, {"s": 280.11, "e": 284.08, "t": "Porque no tenemos regadera."}, {"s": 284.08, "e": 286.75, "t": "Regamos la planta."}, {"s": 286.75, "e": 290.36, "t": "Con la botella de agua."}, {"s": 290.36, "e": 295.66, "t": "Cuando terminemos de regar la planta,"}, {"s": 296.13, "e": 300.5, "t": "cerramos la botella de agua"}, {"s": 300.5, "e": 301.4, "t": "y ya está."}, {"s": 301.4, "e": 304.26, "t": "Podéis darle besitos, besos."}, {"s": 306.5, "e": 308.21, "t": "Guapa."}, {"s": 308.21, "e": 310.84, "t": "Decirle cosas bonitas."}, {"s": 310.84, "e": 312.21, "t": "Guapísima."}, {"s": 312.21, "e": 315.68, "t": "Ese verde te sienta de maravilla."}, {"s": 315.68, "e": 318.45, "t": "Increíble. Estás radiante."}, {"s": 318.45, "e": 320.25, "t": "Ya está, se acabó."}]