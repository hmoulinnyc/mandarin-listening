[{"s": 0.0, "e": 1.9, "t": "Tengo hambre."}, {"s": 1.9, "e": 4.59, "t": "Tengo mucha hambre."}, {"s": 4.59, "e": 10.52, "t": "Es la hora del desayuno. No el almuerzo. No le cena."}, {"s": 10.52, "e": 11.86, "t": "El desayuno."}, {"s": 11.86, "e": 18.28, "t": "Así que vamos a preparar un desayuno español."}, {"s": 18.36, "e": 19.98, "t": "Es muy fácil."}, {"s": 19.98, "e": 23.92, "t": "Una tostada con tomate y un colacao."}, {"s": 23.92, "e": 27.08, "t": "¿Vosotros qué soléis desayunar?"}, {"s": 27.08, "e": 31.22, "t": "Esto es lo que he preguntado en mi comunidad de español."}, {"s": 31.22, "e": 32.5, "t": "Ya hay más"}, {"s": 32.5, "e": 35.18, "t": "de 3000 personas en la comunidad"}, {"s": 35.18, "e": 39.2, "t": "hablando español y practicando todos los días."}, {"s": 39.2, "e": 45.0, "t": "Pero mientras te unes a la comunidad,  yo voy a preparar mi desayuno."}, {"s": 45.14, "e": 46.62, "t": "Necesitamos:"}, {"s": 46.62, "e": 54.84, "t": "Pan. Esto es pan, es pan de molde.  También puede ser otro tipo de pan."}, {"s": 54.84, "e": 59.32, "t": "Pan de barra, una baguette. Un tomate."}, {"s": 59.32, "e": 62.68, "t": "Esto es un tomate..."}, {"s": 62.68, "e": 65.56, "t": "Que huele muy poquito a tomate."}, {"s": 65.56, "e": 69.6, "t": "Porque no es temporada de tomate."}, {"s": 69.6, "e": 72.94, "t": "Es un tomate más verde."}, {"s": 72.94, "e": 76.88, "t": "Pero podéis usar un tomate rojo. Aceite."}, {"s": 76.88, "e": 80.22, "t": "Necesitáis aceite de oliva."}, {"s": 80.22, "e": 82.52, "t": "Sal. Muy importante."}, {"s": 82.52, "e": 83.74, "t": "La sal."}, {"s": 83.74, "e": 89.48, "t": "Una rallador. Este es el rallador perfecto."}, {"s": 89.48, "e": 93.49, "t": "Pero si tenéis prisa, no hace falta el rallador."}, {"s": 93.49, "e": 95.94, "t": "Con el cuchillo sirve."}, {"s": 95.94, "e": 99.46, "t": "Este cuchillo es de sierra."}, {"s": 99.46, "e": 103.58, "t": "Esto es la sierra. Corta muy bien."}, {"s": 103.58, "e": 104.74, "t": "Este cuchillo."}, {"s": 104.74, "e": 107.18, "t": "Este cuchillo no corta."}, {"s": 107.18, "e": 110.54, "t": "Es un cuchillo de mantequilla."}, {"s": 110.54, "e": 112.16, "t": "Un plato."}, {"s": 112.16, "e": 113.64, "t": "Una cucharita."}, {"s": 113.64, "e": 114.88, "t": "Una taza."}, {"s": 114.88, "e": 117.64, "t": "La leche. Y el colacao."}, {"s": 117.64, "e": 120.84, "t": "Empezamos por el pan."}, {"s": 120.84, "e": 123.86, "t": "Mi pan tiene muchas semillas."}, {"s": 123.86, "e": 128.3, "t": "Es un pan con semillas."}, {"s": 128.3, "e": 130.94, "t": "Tenemos que tostar el pan."}, {"s": 130.94, "e": 135.6, "t": "Vamos allá."}, {"s": 135.6, "e": 139.0, "t": "Mientras tostamos el pan,"}, {"s": 139.0, "e": 144.8, "t": "vamos a cortar el tomate con el cuchillo."}, {"s": 144.94, "e": 147.92, "t": "Vamos a cortar."}, {"s": 147.92, "e": 150.08, "t": "Una pegatina."}, {"s": 150.08, "e": 153.86, "t": "Tiene una pegatina el tomate."}, {"s": 153.86, "e": 158.4, "t": "Corto el tomate por la mitad."}, {"s": 158.4, "e": 166.26, "t": "Si tienes prisa, puedes cortar el tomate en rodajas."}, {"s": 166.26, "e": 170.9, "t": "Esto es una rodaja."}, {"s": 170.9, "e": 173.48, "t": "Una rodaja de tomate."}, {"s": 173.48, "e": 178.58, "t": "Puedes cortar el tomate en rodajas si tienes prisa."}, {"s": 178.58, "e": 184.16, "t": "Si no tienes prisa y tienes un rallador,"}, {"s": 184.16, "e": 187.71, "t": "vamos a rallar el tomate."}, {"s": 191.24, "e": 194.34, "t": "Rayamos el tomate"}, {"s": 194.34, "e": 196.1, "t": "con el rallador."}, {"s": 196.1, "e": 202.36, "t": "Una vez el pan está tostado y calentito"}, {"s": 202.36, "e": 206.64, "t": "(está caliente todavía) hay que actuar rápido."}, {"s": 206.64, "e": 208.96, "t": "No se puede enfriar."}, {"s": 208.96, "e": 213.68, "t": "Caliente ponemos aceite en el pan."}, {"s": 213.68, "e": 218.28, "t": "Aceite de oliva. Perfecto."}, {"s": 218.28, "e": 220.02, "t": "Un poco de aceite."}, {"s": 220.02, "e": 225.86, "t": "Y a continuación, si tenéis mucha, mucha, mucha, mucha, mucha prisa."}, {"s": 226.98, "e": 231.14, "t": "Podéis restregar el tomate en el pan. Así."}, {"s": 234.74, "e": 236.76, "t": "Pero a mí no me gusta así."}, {"s": 236.76, "e": 240.76, "t": "Así que vamos a poner el tomate rallado."}, {"s": 240.76, "e": 247.86, "t": "La piel del tomate no se usa, no se come, no. Se tira."}, {"s": 247.92, "e": 254.11, "t": "Vamos a poner el tomate rallado en la tostada."}, {"s": 255.86, "e": 261.66, "t": "Si tenéis solo tomate en rodajas, ponéis la rodaja encima."}, {"s": 261.68, "e": 265.64, "t": "Así."}, {"s": 265.64, "e": 270.44, "t": "Después echamos sal."}, {"s": 270.44, "e": 276.24, "t": "Y otra vez aceite de oliva."}, {"s": 276.76, "e": 279.38, "t": "Y ya está lista para comer."}, {"s": 279.38, "e": 280.84, "t": "Falta el colacao."}, {"s": 280.84, "e": 283.8, "t": "Cogemos la leche y el vaso."}, {"s": 283.8, "e": 289.08, "t": "Echamos leche en el vaso, en la taza."}, {"s": 289.08, "e": 290.08, "t": "Esto es una taza."}, {"s": 290.08, "e": 295.84, "t": "Una taza de cerámica, y a la leche le echamos colacao."}, {"s": 295.84, "e": 300.82, "t": "A mi me gusta echar tres cucharadas de estas."}, {"s": 300.82, "e": 302.82, "t": "Una. Dos."}, {"s": 302.82, "e": 304.7, "t": "Y tres."}, {"s": 304.7, "e": 308.68, "t": "Cogemos una cucharita pequeña."}, {"s": 308.68, "e": 311.65, "t": "No, una cuchara grande. No."}, {"s": 311.65, "e": 313.92, "t": "Una cucharita."}, {"s": 313.92, "e": 319.72, "t": "Y removemos."}, {"s": 319.78, "e": 321.76, "t": "Mierda."}, {"s": 321.76, "e": 324.66, "t": "Removemos con cuidado."}, {"s": 324.66, "e": 329.32, "t": "Jolín, siempre tengo accidentes con el colacao."}, {"s": 329.32, "e": 330.92, "t": "Siempre se me cae."}, {"s": 330.92, "e": 334.4, "t": "Y el colacao ya estaría listo."}, {"s": 334.4, "e": 338.26, "t": "A mí me gusta comerme el chocolate. Las burbujas. Así."}, {"s": 339.44, "e": 340.44, "t": "Y ya está."}, {"s": 340.44, "e": 343.68, "t": "Este es mi desayuno perfecto."}, {"s": 343.68, "e": 347.96, "t": "Una tostada con tomate y un colacao."}, {"s": 347.96, "e": 349.58, "t": "Uniros a la comunidad"}, {"s": 349.58, "e": 353.1, "t": "y dejad un comentario con vuestro desayuno favorito."}]