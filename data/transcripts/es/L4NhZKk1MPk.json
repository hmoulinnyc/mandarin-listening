[{"s": 21.8, "e": 22.8, "t": "Buen día, chicos."}, {"s": 22.8, "e": 23.4, "t": "Hola."}, {"s": 23.4, "e": 24.5, "t": "Buenos días."}, {"s": 24.5, "e": 25.8, "t": "Holi."}, {"s": 25.8, "e": 27.9, "t": "Hola."}, {"s": 27.9, "e": 33.9, "t": "Ay, chicos, hoy tenemos mucho trabajo."}, {"s": 35.3, "e": 39.4, "t": "No quiero trabajar hoy."}, {"s": 39.6, "e": 42.9, "t": "¿Qué hiciste anoche, Andrés?"}, {"s": 42.9, "e": 45.8, "t": "Sí, [música] ¿qué hiciste?"}, {"s": 45.8, "e": 48.8, "t": "No quiero hablar."}, {"s": 51.8, "e": 54.0, "t": "Esperen."}, {"s": 54.0, "e": 56.0, "t": "¿Y Shell?"}, {"s": 56.0, "e": 59.1, "t": "¿Dónde está Shell?"}, {"s": 62.1, "e": 65.3, "t": "Yo no la he visto."}, {"s": 65.3, "e": 69.0, "t": "Yo tampoco."}, {"s": 70.0, "e": 71.6, "t": "Qué raro."}, {"s": 71.6, "e": 75.6, "t": "¿Dónde está Shell sin"}, {"s": 78.0, "e": 80.56, "t": "Voy a llamarla."}, {"s": 89.6, "e": 92.5, "t": "No contesta."}, {"s": 93.0, "e": 97.0, "t": "Quizás está dormida."}, {"s": 97.3, "e": 100.8, "t": "Yo también quiero dormir."}, {"s": 101.9, "e": 104.7, "t": "Ay, no. Esperen, chicos."}, {"s": 104.7, "e": 108.8, "t": "¿Y si le pasó algo?"}, {"s": 112.1, "e": 113.5, "t": "¿Algo"}, {"s": 113.5, "e": 115.9, "t": "como [música] qué?"}, {"s": 115.9, "e": 117.7, "t": "No me asustes."}, {"s": 117.7, "e": 119.19, "t": "Quizá"}, {"s": 119.19, "e": 122.19, "t": "la secuestraron."}, {"s": 125.09, "e": 126.19, "t": "¿Qué?"}, {"s": 126.19, "e": 127.89, "t": "Era una broma."}, {"s": 127.89, "e": 130.49, "t": "Qué tensión."}, {"s": 130.49, "e": 131.59, "t": "Ya sé."}, {"s": 131.59, "e": 133.59, "t": "Vamos abajo."}, {"s": 133.59, "e": 137.19, "t": "Tal vez está en la cafetería."}, {"s": 163.39, "e": 166.99, "t": "En esta cafetería no está."}, {"s": 166.99, "e": 168.99, "t": "¿En la cafetería de allí?"}, {"s": 168.99, "e": 171.09, "t": "Tampoco."}, {"s": 171.09, "e": 172.69, "t": "¿Dónde está?"}, {"s": 172.69, "e": 173.89, "t": "A ver."}, {"s": 173.89, "e": 179.49, "t": "¿Cuándo vieron a S