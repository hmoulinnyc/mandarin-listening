[{"s": 0.1, "e": 4.2, "t": "Hola, chicos. Yo soy Shell y ahora estoy"}, {"s": 4.2, "e": 6.8, "t": "en Tokio, Japón."}, {"s": 6.8, "e": 11.6, "t": "Aquí yo soy una turista."}, {"s": 11.6, "e": 17.6, "t": "Y no quiero ser turista, no quiero verme"}, {"s": 17.6, "e": 22.0, "t": "turista, así que hoy me voy a convertir"}, {"s": 22.0, "e": 25.6, "t": "en una japonesa."}, {"s": 33.7, "e": 39.3, "t": "Ahora estoy en Asakusa. Esta zona es una"}, {"s": 39.3, "e": 42.4, "t": "zona muy antigua"}, {"s": 42.4, "e": 47.5, "t": "y muy famosa. Aquí hay muchos muchos"}, {"s": 47.5, "e": 49.1, "t": "turistas."}, {"s": 49.1, "e": 54.1, "t": "Y yo, bueno, soy otra turista, pero al"}, {"s": 54.1, "e": 56.8, "t": "final de este video"}, {"s": 56.8, "e": 60.3, "t": "ya no voy a ser turista."}, {"s": 60.3, "e": 65.0, "t": "Para convertirme en una japonesa, tengo"}, {"s": 65.0, "e": 68.5, "t": "que usar ropa japonesa."}, {"s": 68.5, "e": 73.3, "t": "Tengo que usar un kimono. Así que vamos"}, {"s": 73.3, "e": 78.6, "t": "a buscar un kimono para mí."}, {"s": 80.4, "e": 85.0, "t": "Ahora estoy en Basara, un lugar para"}, {"s": 85.0, "e": 88.7, "t": "rentar kimonos, para alquilar kimonos."}, {"s": 88.7, "e": 93.8, "t": "Tú pagas y recibes un kimono por"}, {"s": 93.8, "e": 95.7, "t": "un tiempo."}, {"s": 95.7, "e": 100.3, "t": "Me agendaron como Dreamin Spanish."}, {"s": 100.5, "e": 106.7, "t": "Estamos subiendo para ver los kimonos."}, {"s": 111.4, "e": 115.9, "t": "Aquí hay muchos kimonos de muchos"}, {"s": 115.9, "e": 119.1, "t": "colores. Hay rosado,"}, {"s": 119.1, "e": 125.69, "t": "blanco, azul y todos son muy bonitos."}, {"s": 125.69, "e": 128.59, "t": "Hoy me voy a poner"}, {"s": 128.59, "e": 135.09, "t": "un kimono, ah unos zapatos y quizá un"}, {"s": 135.09, "e": 138.79, "t": "bolso para ser completamente"}, {"s": 138.79, "e": 142.29, "t": "japonesa. Me gusta, me gusta"}, {"s": 142.29, "e": 144.69, "t": "este."}, {"s": 144.69, "e": 145.99, "t": "Ahora"}, {"s": 145.99, "e": 148.39, "t": "sigue la"}, {"s": 148.39, "e": 152.39, "t": "parte interior del kimono. Es otra"}, {"s": 152.39, "e": 156.29, "t": "prenda [música] que va por dentro. Sí, y"}, {"s": 156.29, "e": 158.59, "t": "a mí me gusta"}, {"s": 158.59, "e": 160.99, "t": "esta."}, {"s": 164.09, "e": 167.59, "t": "Este es muy bonito, es azul y tiene"}, {"s": 167.59, "e": 171.19, "t": "muchas flores, pero [música] el color"}, {"s": 171.19, "e": 172.39, "t": "azul"}, {"s": 172.39, "e": 174.79, "t": "no se me ve bien."}, {"s": 174.79, "e": 178.89, "t": "No sé, se me ve mejor, se ve"}, {"s": 178.89, "e": 180.89, "t": "mejor en mí"}, {"s": 180.89, "e": 183.49, "t": "el color rojo."}, {"s": 183.49, "e": 185.59, "t": "Yo creo."}, {"s": 185.59, "e": 190.19, "t": "Vale, okay, esto, esta parte va aquí"}, {"s": 190.19, "e": 196.09, "t": "debajo del moño cae y se ve muy bien."}, {"s": 196.09, "e": 200.69, "t": "Kawaii, sí, me gusta todo."}, {"s": 202.89, "e": 207.59, "t": "Sigue eh un accesorio que va en"}, {"s": 207.59, "e": 209.69, "t": "en el obi,"}, {"s": 209.69, "e": 212.09, "t": "que es como el cinturón"}, {"s": 212.09, "e": 213.49, "t": "y"}, {"s": 213.49, "e": 218.39, "t": "quiero perlas porque se ven costosas."}, {"s": 218.39, "e": 222.99, "t": "Ven, eh hay eh cinco accesorios"}, {"s": 222.99, "e": 225.19, "t": "en el kimono."}, {"s": 225.19, "e": 228.19, "t": "Es uno, dos,"}, {"s": 228.19, "e": 229.79, "t": "tres,"}, {"s": 229.79, "e": 232.79, "t": "cuatro y cinco."}, {"s": 232.79, "e": 237.29, "t": "Es mucho trabajo, ¿eh? Ya terminamos de"}, {"s": 237.29, "e": 241.89, "t": "elegir el kimono. Este es el diseño"}, {"s": 241.89, "e": 244.59, "t": "final."}, {"s": 248.69, "e": 252.69, "t": "Este es el look final."}, {"s": 252.69, "e": 258.59, "t": "Así es. Ahora, nadie sabrá que yo soy"}, {"s": 258.59, "e": 261.89, "t": "turista, pero mmm"}, {"s": 261.89, "e": 266.09, "t": "creo que falta una cosa más."}, {"s": 266.09, "e": 268.69, "t": "¿Qué será?"}, {"s": 268.69, "e": 272.19, "t": "Así es, el maquillaje. Necesito"}, {"s": 272.19, "e": 276.99, "t": "maquillaje japonés. Así que voy a hacer"}, {"s": 276.99, "e": 279.69, "t": "una transición mágica"}, {"s": 279.69, "e": 280.59, "t": "y"}, {"s": 280.59, "e": 284.89, "t": "estaré lista en 1 segundo."}, {"s": 284.99, "e": 290.29, "t": "Okay, am ya me puse maquillaje."}, {"s": 290.29, "e": 294.99, "t": "Esto es lo mejor que pude, ¿okay?"}, {"s": 294.99, "e": 298.59, "t": "¿Se ve bien o se ve mal?"}, {"s": 298.59, "e": 299.99, "t": "Ahora,"}, {"s": 300.89, "e": 306.59, "t": "nadie sabe que yo soy turista."}, {"s": 306.59, "e": 310.79, "t": "Nunca lo sabrán."}, {"s": 321.89, "e": 326.85, "t": "Tontos. Nadie sabe que soy colombiana."}, {"s": 327.89, "e": 330.89, "t": "Excelente."}, {"s": 336.69, "e": 340.29, "t": "Esa es Shell."}, {"s": 340.29, "e": 343.88, "t": "Rentó un kimono."}, {"s": 344.49, "e": 348.49, "t": "Eso hacen todos los turistas."}]